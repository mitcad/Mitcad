+//=======================================================================
+// function : BRepBlend_HermiteContact
+// purpose  : The contact on the surface of a surface/restriction blend at
+//            theParam, from the walked points about it that carry the
+//            contact's tangent (dU/dt, dV/dt along the guide): a cubic
+//            Hermite interpolation of its parameters (theU, theV). Its
+//            error is of the fourth order in the step, where the linear
+//            interpolation's (the chord's) is of the second: on a contact
+//            line curving round a wide circle the chord lies inside the
+//            arc by its sagitta. Points the approximation inserted carry
+//            no tangent and are passed over (they lie on the walked
+//            contact all the same). False where no such points are about
+//            theParam.
+//=======================================================================
+
+static bool BRepBlend_HermiteContact(const occ::handle<BRepBlend_Line>& theLine,
+                                     const double                       theParam,
+                                     const int                          theIndex,
+                                     double&                            theU,
+                                     double&                            theV)
+{
+  int aI1 = theIndex, aI2 = theIndex + 1;
+  while (aI1 >= 1 && theLine->Point(aI1).IsTangencyPoint())
+  {
+    aI1--;
+  }
+  while (aI2 <= theLine->NbPoints() && theLine->Point(aI2).IsTangencyPoint())
+  {
+    aI2++;
+  }
+  if (aI1 < 1 || aI2 > theLine->NbPoints())
+  {
+    return false;
+  }
+  const Blend_Point& aP1 = theLine->Point(aI1);
+  const Blend_Point& aP2 = theLine->Point(aI2);
+  const double       aT1 = aP1.Parameter(), aT2 = aP2.Parameter(), aH = aT2 - aT1;
+  if (!(aH > 0.) || theParam < aT1 || theParam > aT2)
+  {
+    return false;
+  }
+  double aU1 = 0., aV1 = 0., aU2 = 0., aV2 = 0.;
+  aP1.ParametersOnS(aU1, aV1);
+  aP2.ParametersOnS(aU2, aV2);
+  const gp_Vec2d aD1  = aP1.Tangent2dOnS1();
+  const gp_Vec2d aD2  = aP2.Tangent2dOnS1();
+  const double   aS   = (theParam - aT1) / aH;
+  const double   aS2  = aS * aS;
+  const double   aS3  = aS2 * aS;
+  const double   aH00 = 2. * aS3 - 3. * aS2 + 1.;
+  const double   aH10 = (aS3 - 2. * aS2 + aS) * aH;
+  const double   aH01 = -2. * aS3 + 3. * aS2;
+  const double   aH11 = (aS3 - aS2) * aH;
+  theU                = aH00 * aU1 + aH10 * aD1.X() + aH01 * aU2 + aH11 * aD2.X();
+  theV                = aH00 * aV1 + aH10 * aD1.Y() + aH01 * aV2 + aH11 * aD2.Y();
+  return true;
+}
