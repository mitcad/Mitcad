+bool ChFi3d_Builder::RideOnBlend(const occ::handle<ChFiDS_Stripe>& A,
+                                 const occ::handle<ChFiDS_Stripe>& B,
+                                 const TopoDS_Face&                F)
+{
+  TopOpeBRepDS_DataStructure&        DStr = myDS->ChangeDS();
+  const occ::handle<ChFiDS_FilSpine> aFsA = occ::down_cast<ChFiDS_FilSpine>(A->Spine());
+  const occ::handle<ChFiDS_FilSpine> aFsB = occ::down_cast<ChFiDS_FilSpine>(B->Spine());
+  if (aFsA.IsNull() || aFsB.IsNull() || !aFsA->IsConstant() || !aFsB->IsConstant())
+  {
+    return false;
+  }
+  ChFiDS_TypeOfConcavity aType[2] = {ChFiDS_Other, ChFiDS_Other};
+  for (int i = 0; i < 2; i++)
+  {
+    const TopoDS_Edge E = spineEdgeOf(i == 0 ? A->Spine() : B->Spine(), F);
+    if (E.IsNull() || !myEFMap.Contains(E) || myEFMap(E).Extent() != 2)
+    {
+      return false;
+    }
+    aType[i] = ChFi3d::DefineConnectType(E,
+                                         TopoDS::Face(myEFMap(E).First()),
+                                         TopoDS::Face(myEFMap(E).Last()),
+                                         1.e-6,
+                                         false);
+    if (aType[i] != ChFiDS_Convex && aType[i] != ChFiDS_Concave)
+    {
+      return false;
+    }
+  }
+  // (B's ball lies inside A's blend's circle where both are of a kind: it
+  // must be the smaller one; of the other kind it lies outside.)
+  if (aType[0] == aType[1] && aFsB->Radius() >= aFsA->Radius() * (1. - 1.e-3))
+  {
+    return false;
+  }
+  // (Each an open contour whose ends meet no other stripe: its corners there
+  // are the face at the end's alone. Rides ending at corners of more blends
+  // are not made so.)
+  for (const occ::handle<ChFiDS_Stripe>& S : {A, B})
+  {
+    const occ::handle<ChFiDS_Spine>& Sp = S->Spine();
+    if (Sp->IsPeriodic() || Sp->IsClosed())
+    {
+      return false;
+    }
+    for (const TopoDS_Vertex& V : {Sp->FirstVertex(), Sp->LastVertex()})
+    {
+      int aNb = 0;
+      for (int j = 1; j <= myVDataMap.Extent() && aNb == 0; j++)
+      {
+        aNb = myVDataMap.FindKey(j).IsSame(V) ? myVDataMap.FindFromIndex(j).Extent() : 0;
+      }
+      if (aNb != 1)
+      {
+        return false;
+      }
+    }
+  }
+  removeEntriesOf(A, myOverlapStripes, myOverlapFaces, myOverlapEdges);
+  removeEntriesOf(B, myOverlapStripes, myOverlapFaces, myOverlapEdges);
+  // A on the faces of its edge.
+  A->Reset();
+  A->Spine()->SetErrorStatus(ChFiDS_Ok);
+  try
+  {
+    OCC_CATCH_SIGNALS
+    occ::handle<ChFiDS_Stripe> aStripe = A;
+    PerformSetOfSurf(aStripe);
+  }
+  catch (Standard_Failure const& anException)
+  {
+    // (Only OCCT's reports that this cannot be computed fail this step, mitcad#1986.)
+    if (!ChFi3d_IsComputationFailure(anException))
+    {
+      throw;
+    }
+    return false;
+  }
+  if (A->Spine()->ErrorStatus() != ChFiDS_Ok)
+  {
+    return false;
+  }
+  occ::handle<ChFiDS_SurfData> SA;
+  int                          onA = 0;
+  if (!findRideSurfData(DStr, A, F, SA, onA) || SA->IsOnCurve(onA))
+  {
+    return false;
+  }
+  const occ::handle<Geom_Surface>& SS = DStr.Surface(SA->Surf()).Surface();
+  if (SS.IsNull())
+  {
+    return false;
+  }
+  // A's blend as a face, over the parameters of its contact lines.
+  double u1 = RealLast(), u2 = -RealLast(), v1 = RealLast(), v2 = -RealLast();
+  for (int k = 1; k <= 2; k++)
+  {
+    const ChFiDS_FaceInterference& FIk = SA->Interference(k);
+    if (FIk.PCurveOnSurf().IsNull())
+    {
+      return false;
+    }
+    for (int i = 0; i <= 10; i++)
+    {
+      const double   t  = FIk.FirstParameter() + (FIk.LastParameter() - FIk.FirstParameter()) * i / 10.;
+      const gp_Pnt2d uv = FIk.PCurveOnSurf()->Value(t);
+      u1                = std::min(u1, uv.X());
+      u2                = std::max(u2, uv.X());
+      v1                = std::min(v1, uv.Y());
+      v2                = std::max(v2, uv.Y());
+    }
+  }
+  // (Run on past A's ends along A's contact, within the surface's bounds:
+  // B's walk ends at its spine's ends, not at the support's boundary, where
+  // A's own end lies on the same section.)
+  {
+    const ChFiDS_FaceInterference& FIA0 = SA->Interference(onA);
+    const gp_Pnt2d a0 = FIA0.PCurveOnSurf()->Value(FIA0.FirstParameter());
+    const gp_Pnt2d a1 = FIA0.PCurveOnSurf()->Value(FIA0.LastParameter());
+    double         su1 = 0., su2 = 0., sv1 = 0., sv2 = 0.;
+    SS->Bounds(su1, su2, sv1, sv2);
+    if (std::abs(a1.Y() - a0.Y()) >= std::abs(a1.X() - a0.X()))
+    {
+      const double m = 0.25 * (v2 - v1);
+      v1             = SS->IsVPeriodic() ? v1 - m : std::max(sv1, v1 - m);
+      v2             = SS->IsVPeriodic() ? v2 + m : std::min(sv2, v2 + m);
+    }
+    else
+    {
+      const double m = 0.25 * (u2 - u1);
+      u1             = SS->IsUPeriodic() ? u1 - m : std::max(su1, u1 - m);
+      u2             = SS->IsUPeriodic() ? u2 + m : std::min(su2, u2 + m);
+    }
+  }
+  BRepLib_MakeFace aMakeFace(SS, u1, u2, v1, v2, Precision::Confusion());
+  if (!aMakeFace.IsDone())
+  {
+    return false;
+  }
+  TopoDS_Face Support = aMakeFace.Face();
+  // (Oriented as F where A's blend touches it: the blend continues F there.)
+  {
+    const ChFiDS_CommonPoint& CPA = SA->Vertex(true, onA);
+    gp_Dir                    aNF, aNS;
+    Support.Orientation(TopAbs_FORWARD);
+    if (!outwardNormalAt(F, CPA.Point(), aNF) || !outwardNormalAt(Support, CPA.Point(), aNS))
+    {
+      return false;
+    }
+    if (aNF.Dot(aNS) < 0.)
+    {
+      Support.Orientation(TopAbs_REVERSED);
+    }
+  }
+  myRideStripes.Append(B);
+  myRideOn.Append(A);
+  myRideFaces.Append(F);
+  myRideEdges.Append(TopoDS_Edge());
+  myRideSupports.Append(Support);
+  myTangentRides.Append(B);
+  B->Reset();
+  B->Spine()->SetErrorStatus(ChFiDS_Ok);
+  try
+  {
+    OCC_CATCH_SIGNALS
+    occ::handle<ChFiDS_Stripe> aStripe = B;
+    PerformSetOfSurf(aStripe);
+  }
+  catch (Standard_Failure const& anException)
+  {
+    // (Only OCCT's reports that this cannot be computed fail this step, mitcad#1986.)
+    if (!ChFi3d_IsComputationFailure(anException))
+    {
+      throw;
+    }
+    return false;
+  }
+  if (B->Spine()->ErrorStatus() != ChFiDS_Ok)
+  {
+    return false;
+  }
+  occ::handle<ChFiDS_SurfData> SB;
+  int                          onB = 0;
+  if (!findRideSurfData(DStr, B, Support, SB, onB) || A->SetOfSurfData()->Length() != 1
+      || B->SetOfSurfData()->Length() != 1)
+  {
+    return false;
+  }
+  ChFiDS_FaceInterference& FIB = SB->ChangeInterference(onB);
+  if (FIB.LineIndex() <= 0 || FIB.PCurveOnFace().IsNull() || FIB.PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve> CB = DStr.Curve(FIB.LineIndex()).Curve();
+  const double                  b1 = FIB.FirstParameter(), b2 = FIB.LastParameter();
+  if (CB.IsNull() || b2 - b1 <= Precision::PConfusion())
+  {
+    return false;
+  }
+  // (Whether B runs against A, its start at A's end: the spines of the two
+  // edges running opposite ways round the face between.)
+  const bool against = SB->Vertex(true, onB).Point().Distance(SA->Vertex(true, onA).Point())
+                       > SB->Vertex(true, onB).Point().Distance(SA->Vertex(false, onA).Point());
+  const occ::handle<Geom2d_Curve> PCF =
+    GeomProjLib::Curve2d(new Geom_TrimmedCurve(CB, b1, b2), b1, b2, BRep_Tool::Surface(F));
+  if (PCF.IsNull())
+  {
+    return false;
+  }
+  // B's side lies on F with its curve projected there (not on the support,
+  // a face of no solid), as a rider on A's contact line (RideOnOverlap): the
+  // corners at B's ends find their faces through it, and ApplyRides makes
+  // both blends meet on that curve once the corners are done, A cut by it.
+  const int                       iF   = DStr.AddShape(F);
+  const occ::handle<Geom2d_Curve> PCA  = FIB.PCurveOnFace(); // on A's surface
+  const TopAbs_Orientation        aTra = DStr.Shape(iF).Orientation() != Support.Orientation()
+                                           ? TopAbs::Reverse(FIB.Transition())
+                                           : FIB.Transition();
+  FIB.SetInterference(FIB.LineIndex(), aTra, PCF, FIB.PCurveOnSurf());
+  if (onB == 1)
+  {
+    SB->ChangeIndexOfS1(iF);
+  }
+  else
+  {
+    SB->ChangeIndexOfS2(iF);
+  }
+  // The ends: A's contact on F ends on an arc of F at each end; B's contact
+  // crosses the face beyond that arc (the face at the end, which cuts both
+  // blends there). The stripes' points there are mere points, the corners'
+  // common point of the two blends. (aEnd by B's ends.)
+  double aEnd[2] = {b1, b2};
+  for (int f = 0; f < 2; f++)
+  {
+    const ChFiDS_CommonPoint& CPA0 = SA->Vertex(f == 0, onA);
+    const int                 fb   = against ? 1 - f : f;
+    if (!CPA0.IsOnArc() || CPA0.IsVertex())
+    {
+      return false;
+    }
+    const TopoDS_Face Fe = otherFaceOf(myEFMap, CPA0.Arc(), F);
+    if (Fe.IsNull())
+    {
+      return false;
+    }
+    GeomAPI_IntCS anInter(CB, BRep_Tool::Surface(Fe));
+    if (!anInter.IsDone())
+    {
+      return false;
+    }
+    double aBest = RealLast();
+    for (int i = 1; i <= anInter.NbPoints(); i++)
+    {
+      double u = 0., v = 0., t = 0.;
+      anInter.Parameters(i, u, v, t);
+      const double d = anInter.Point(i).Distance(CPA0.Point());
+      if (t >= b1 - Precision::PConfusion() && t <= b2 + Precision::PConfusion() && d < aBest)
+      {
+        aBest    = d;
+        aEnd[fb] = t;
+      }
+    }
+    if (aBest == RealLast())
+    {
+      return false;
+    }
+  }
+  if (aEnd[1] - aEnd[0] <= Precision::PConfusion())
+  {
+    return false;
+  }
+  for (int f = 0; f < 2; f++)
+  {
+    ChFiDS_CommonPoint& CP = SB->ChangeVertex(f == 0, onB);
+    CP.Reset();
+    CP.SetPoint(CB->Value(aEnd[f]));
+    CP.SetParameter(aEnd[f]);
+  }
+  FIB.SetFirstParameter(aEnd[0]);
+  FIB.SetLastParameter(aEnd[1]);
+  // A's contact on F becomes B's contact on A's blend, between those ends:
+  // the corners cut both blends at the faces at the ends between those
+  // points and their points on the arcs of their other sides
+  // (PerformOneCorner), and ApplyRides makes their points there one. Where
+  // B runs against A, A holds that contact reversed, a curve of its own
+  // (B then rides against A's line, as on a line of 0016).
+  int                     iCA = FIB.LineIndex();
+  occ::handle<Geom_Curve> CA  = CB;
+  double                  a1 = aEnd[0], a2 = aEnd[1];
+  occ::handle<Geom2d_Curve> PCFA = PCF, PCAA = PCA;
+  if (against)
+  {
+    CA = CB->Reversed();
+    a1 = CB->ReversedParameter(aEnd[1]);
+    a2 = CB->ReversedParameter(aEnd[0]);
+    iCA = DStr.AddCurve(TopOpeBRepDS_Curve(CA, DStr.Curve(FIB.LineIndex()).Tolerance()));
+    PCFA = GeomProjLib::Curve2d(new Geom_TrimmedCurve(CA, a1, a2), a1, a2, BRep_Tool::Surface(F));
+    PCAA = GeomProjLib::Curve2d(new Geom_TrimmedCurve(CA, a1, a2), a1, a2, SS);
+    if (PCFA.IsNull() || PCAA.IsNull())
+    {
+      return false;
+    }
+  }
+  for (int f = 0; f < 2; f++)
+  {
+    const double        t  = f == 0 ? a1 : a2;
+    ChFiDS_CommonPoint& CP = SA->ChangeVertex(f == 0, onA);
+    CP.Reset();
+    CP.SetPoint(CA->Value(t));
+    CP.SetParameter(t);
+  }
+  ChFiDS_FaceInterference& FIA = SA->ChangeInterference(onA);
+  FIA.SetInterference(iCA, FIA.Transition(), PCFA, PCAA);
+  FIA.SetFirstParameter(a1);
+  FIA.SetLastParameter(a2);
+  return true;
+}
