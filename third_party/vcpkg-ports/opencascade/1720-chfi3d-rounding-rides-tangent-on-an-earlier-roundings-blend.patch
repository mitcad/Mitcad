+bool ChFi3d_Builder::IsTangentRide(const occ::handle<ChFiDS_Stripe>& S) const
+{
+  return myTangentRides.Contains(S);
+}
+
+bool ChFi3d_Builder::IsTangentRideOn(const occ::handle<ChFiDS_Stripe>& S) const
+{
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itS(myRideStripes), itO(myRideOn);
+  for (; itS.More(); itS.Next(), itO.Next())
+  {
+    if (itO.Value() == S && myTangentRides.Contains(itS.Value()))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Removes stripe S from the tangent rides (RideOnBlend).
+static void removeTangentRide(const occ::handle<ChFiDS_Stripe>&             S,
+                              NCollection_List<occ::handle<ChFiDS_Stripe>>& Rides)
+{
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator it(Rides); it.More();)
+  {
+    if (it.Value() == S)
+    {
+      Rides.Remove(it);
+    }
+    else
+    {
+      it.Next();
+    }
+  }
+}
+
+// The face of edge E other than F (null where E has not two faces).
+static TopoDS_Face otherFaceOf(const ChFiDS_Map& EFMap, const TopoDS_Edge& E, const TopoDS_Face& F)
+{
+  if (!EFMap.Contains(E))
+  {
+    return TopoDS_Face();
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More(); it.Next())
+  {
+    if (!it.Value().IsSame(F))
+    {
+      return TopoDS::Face(it.Value());
+    }
+  }
+  return TopoDS_Face();
+}
+
+// The outward normal of face F (its orientation taken into account) at the
+// point of its surface nearest P; false where it is not defined.
+static bool outwardNormalAt(const TopoDS_Face& F, const gp_Pnt& P, gp_Dir& N)
+{
+  const occ::handle<Geom_Surface> S = BRep_Tool::Surface(F);
+  if (S.IsNull())
+  {
+    return false;
+  }
+  GeomAPI_ProjectPointOnSurf aProj(P, S);
+  if (aProj.NbPoints() == 0)
+  {
+    return false;
+  }
+  double u = 0., v = 0.;
+  aProj.LowerDistanceParameters(u, v);
+  BRepAdaptor_Surface aS(F, false);
+  BRepLProp_SLProps   aProps(aS, u, v, 1, Precision::Confusion());
+  if (!aProps.IsNormalDefined())
+  {
+    return false;
+  }
+  N = aProps.Normal();
+  if (F.Orientation() == TopAbs_REVERSED)
+  {
+    N.Reverse();
+  }
+  return true;
+}
