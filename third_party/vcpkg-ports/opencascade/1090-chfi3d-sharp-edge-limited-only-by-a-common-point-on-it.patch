+// The parameter on the sharp edge E of the common point CP of a stripe beside
+// it, where CP lies on E: its parameter on its arc where that arc is E,
+// otherwise that of its point projected on E, within the point's tolerance
+// and between E's ends. A common point on another arc (one an OnSame end
+// moved onto the prolongation of E past the vertex, its arc and parameter
+// still those of the arc its contact ran to) has no parameter on E: its
+// parameter on its arc is not one of E's curve (mitcad#1005).
+static bool ParameterOnSharpEdge(const ChFiDS_CommonPoint& CP, const TopoDS_Edge& E, double& W)
+{
+  if (!CP.IsOnArc())
+  {
+    return false;
+  }
+  if (CP.Arc().IsSame(E))
+  {
+    W = CP.ParameterOnArc();
+    return true;
+  }
+  double                        f = 0., l = 0.;
+  const occ::handle<Geom_Curve> C = BRep_Tool::Curve(E, f, l);
+  if (C.IsNull())
+  {
+    return false;
+  }
+  GeomAPI_ProjectPointOnCurve aProj(CP.Point(), C, f, l);
+  if (aProj.NbPoints() == 0
+      || aProj.LowerDistance() > std::max(CP.Tolerance(), BRep_Tool::Tolerance(E)))
+  {
+    return false;
+  }
+  W = aProj.LowerDistanceParameter();
+  return true;
+}
