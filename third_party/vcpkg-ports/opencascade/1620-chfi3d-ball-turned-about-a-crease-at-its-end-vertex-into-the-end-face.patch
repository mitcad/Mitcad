+//=======================================================================
+// function : ChFi3d_CutLeavesFace
+// purpose  : Whether the cut of surface S by face F, a plane, from S's
+//            point A to its point B (both on F's plane) leaves F: points of
+//            that cut between them (from points of the chord, projected on
+//            S and on the plane in turn until they lie on both) outside F.
+//            False where the cut is not found.
+//=======================================================================
+
+static bool ChFi3d_CutLeavesFace(const occ::handle<Geom_Surface>& S,
+                                 const TopoDS_Face&               F,
+                                 const gp_Pnt&                    A,
+                                 const gp_Pnt&                    B,
+                                 const double                     Tol)
+{
+  BRepAdaptor_Surface aF(F, false);
+  const occ::handle<Geom_Surface> SF = BRep_Tool::Surface(F);
+  if (S.IsNull() || SF.IsNull() || aF.GetType() != GeomAbs_Plane)
+  {
+    return false;
+  }
+  const gp_Pln  aPl = aF.Plane();
+  const gp_Dir& aN  = aPl.Axis().Direction();
+  BRepClass_FaceClassifier aCl;
+  for (int q = 1; q <= 9; q++)
+  {
+    gp_Pnt X(A.XYZ() + (B.XYZ() - A.XYZ()) * (q / 10.));
+    bool   aOn = false;
+    for (int it = 0; it < 100 && !aOn; it++)
+    {
+      GeomAPI_ProjectPointOnSurf aPr(X, S);
+      if (aPr.NbPoints() == 0)
+      {
+        return false;
+      }
+      const gp_Pnt Y = aPr.NearestPoint();
+      const double d = gp_Vec(aPl.Location(), Y).Dot(gp_Vec(aN));
+      X              = gp_Pnt(Y.XYZ() - d * aN.XYZ());
+      aOn            = std::abs(d) <= 0.1 * Tol;
+    }
+    if (!aOn)
+    {
+      return false;
+    }
+    GeomAPI_ProjectPointOnSurf aPr(X, SF);
+    if (aPr.NbPoints() == 0)
+    {
+      return false;
+    }
+    double u = 0., v = 0.;
+    aPr.LowerDistanceParameters(u, v);
+    aCl.Perform(F, gp_Pnt2d(u, v), Tol);
+    if (aCl.State() == TopAbs_OUT)
+    {
+      return true;
+    }
+  }
+  return false;
+}
