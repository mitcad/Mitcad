+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aSeeds;
+  // (piece, its end 0 or 1) -> the tangency it joins at
+  NCollection_DataMap<TopoDS_Shape, int, TopTools_ShapeMapHasher> aJoinFirst, aJoinLast;
+  NCollection_Sequence<int>    aNbAlong;
+  NCollection_Sequence<double> aSideSum;
+  NCollection_Sequence<double> aJoinTol;
+  for (int k = 1; k <= aTangency.Length(); k++)
