+        {
+          aKept.Add(aE);
+          aGrown = true;
+          break;
+        }
+      }
+    }
+  }
+  // The pieces kept, the joined ends on the joints (the same curves, their
+  // curves on both offset faces too).
+  NCollection_List<TopoDS_Shape> aPieces;
+  for (int i = 1; i <= aAll.Length(); i++)
+  {
+    const TopoDS_Edge aE = aAll(i);
+    if (!aKept.Contains(aE))
+    {
+      continue;
+    }
+    TopoDS_Edge aPiece = aE;
+    if (aJoinFirst.IsBound(aE) || aJoinLast.IsBound(aE))
+    {
+      double aF, aL;
+      BRep_Tool::Range(aE, aF, aL);
+      const TopoDS_Vertex aV1 = TopoDS::Vertex(aEndKey(aE, 0));
+      const TopoDS_Vertex aV2 = TopoDS::Vertex(aEndKey(aE, 1));
+      if (aV1.IsNull() || aV2.IsNull())
+      {
+        return;
+      }
+      aPiece = aPart(aE, aF, aL, aV1, aV2);
+      if (aOnSeam)
+      {
+        return;
+      }
+    }
+    // Its kind: that of the crease's sample nearest to its middle.
+    BRepAdaptor_Curve aC(aPiece);
+    const gp_Pnt      aM = aC.Value(0.5 * (aC.FirstParameter() + aC.LastParameter()));
+    double            aBest = RealLast(), aBestTurn = 0.;
+    for (int k = 1; k <= aSample.Length(); k++)
+    {
+      const double aD = aM.SquareDistance(aSample(k));
+      if (aD < aBest)
+      {
+        aBest     = aD;
+        aBestTurn = aSampleTurn(k);
+      }
+    }
+    if ((aBestTurn > 0.) != (aRefTurn > 0.))
+    {
+      theOtherKind.Add(aPiece);
+    }
+    aPieces.Append(aPiece);
+  }
+  if (aPieces.IsEmpty())
+  {
+    return;
+  }
+  theJoined = aPieces;
+  if (TracingCrease())
+  {
+    NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aShown;
+    for (NCollection_List<TopoDS_Shape>::Iterator aIt(aPieces); aIt.More(); aIt.Next())
+    {
+      aShown.Add(aIt.Value());
+    }
+    std::fprintf(stderr, "offset crease: %d pieces dropped at the tangencies, %d of the other kind\n",
+                 aDropped.Extent(), theOtherKind.Extent());
+    TraceEdges("joined across the tangencies", aShown);
+  }
+}
