+    {
+      if (TracingCrease())
+      {
+        std::fprintf(stderr, "offset crease: %d pieces along the crease at the tangency %d (sides %g): not joined\n",
+                     aNbAlong(k), k, aSideSum(k));
+      }
+      return;
+    }
+  }
+  if (aDropped.IsEmpty())
+  {
+    return;
+  }
+  // The vertices joining the two pieces at each tangency.
+  NCollection_Sequence<TopoDS_Vertex> aJoint;
+  for (int k = 1; k <= aTangency.Length(); k++)
+  {
+    TopoDS_Vertex aV = BRepLib_MakeVertex(aTangency(k)).Vertex();
+    BRep_Builder().UpdateVertex(aV, std::max(1.01 * aJoinTol(k), Precision::Confusion()));
+    aJoint.Append(aV);
+  }
+  // The pieces connected to those joined (by their vertices, the joined
+  // ends by the joint).
+  const auto aEndKey = [&](const TopoDS_Edge& theE, const int theEnd) -> TopoDS_Shape {
+    const NCollection_DataMap<TopoDS_Shape, int, TopTools_ShapeMapHasher>& aJoins =
+      theEnd == 0 ? aJoinFirst : aJoinLast;
+    if (const int* pK = aJoins.Seek(theE))
+    {
