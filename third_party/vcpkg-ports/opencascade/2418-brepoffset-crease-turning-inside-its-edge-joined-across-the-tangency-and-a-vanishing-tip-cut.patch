 }
 
+//=======================================================================
+// function : JoinCreaseAcrossInnerTangency
+// purpose  : The intersection of the offsets of a crease's faces where the
+//            crease turns from concave to convex inside its edge, the faces
+//            tangent at a point between (a loft from a circle to a smaller
+//            one off its axis, a cylinder on each end: the rims are concave
+//            on one side and convex on the other; GitHub mitcad/Mitcad#641,
+//            mitcad#2418). The enlarged offsets are tangent at the offset of
+//            that point, and there their intersection is an X: the branch
+//            along the crease, on both sides of the point, and a second
+//            branch crossing it and running off to the enlarged faces'
+//            bounds, joined by pieces of a few microns, the branch along the
+//            crease not always connected across it. The pieces kept so far
+//            (CheckIntersFF's connected block, then the edge nearest to the
+//            edge's middle) were the crossing branch's alone, or the
+//            crease's on one side of the point: the offset of a face had no
+//            closed wire, and the thick solid failed.
+//            There the pieces of the crossing branch (an end at the point,
+//            its direction there across the crease's) and the pieces within
+//            the point's neighbourhood are dropped, the two pieces along the
+//            crease that end there share one vertex at the point, and the
+//            pieces connected to them are the intersection (theJoined).
+//            Past the point the crease is of the other kind than at the
+//            edge's middle, whose kind the analysis gave the edge: the
+//            pieces there are in theOtherKind (their orientation in the
+//            offset faces reversed). Where no such point is found, or the
+//            pieces at it are not one branch along the crease on each side
+//            and crossing ones, nothing changes (theJoined empty).
+//            With MITCAD_TRACE_OFFSET_CREASE set it says what it found.
+//=======================================================================
+static void JoinCreaseAcrossInnerTangency(
+  const TopoDS_Edge&                                                   RefEdge,
+  const TopoDS_Face&                                                   RefFace1,
+  const TopoDS_Face&                                                   RefFace2,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& AllEdges,
+  const TopoDS_Face&                                                   OffsetFace1,
+  const TopoDS_Face&                                                   OffsetFace2,
+  NCollection_List<TopoDS_Shape>&                                      theJoined,
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>&              theOtherKind)
+{
+  theJoined.Clear();
+  theOtherKind.Clear();
+  if (RefEdge.IsNull() || RefFace1.IsNull() || RefFace2.IsNull() || AllEdges.Extent() < 2
+      || BRep_Tool::Degenerated(RefEdge))
+  {
+    return;
+  }
+  // How far apart the projections of a point of the crease on both offsets
+  // may be where they are tangent.
+  const double aOnBoth = 1.e-2;
+  // The crease's edges: those common to both faces (the pair is
+  // intersected once for all of them), as oriented in RefFace1; not seams.
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aEdges2;
+  for (TopExp_Explorer aEx(RefFace2, TopAbs_EDGE); aEx.More(); aEx.Next())
+  {
+    aEdges2.Add(aEx.Current());
+  }
+  NCollection_Sequence<TopoDS_Edge>                      aCrease;
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aSeen;
+  for (TopExp_Explorer aEx(RefFace1, TopAbs_EDGE); aEx.More(); aEx.Next())
+  {
+    const TopoDS_Edge& aE = TopoDS::Edge(aEx.Current());
+    if (!aEdges2.Contains(aE) || BRep_Tool::Degenerated(aE) || BRepTools::IsReallyClosed(aE, RefFace1)
+        || BRepTools::IsReallyClosed(aE, RefFace2) || !aSeen.Add(aE))
+    {
+      continue;
+    }
+    aCrease.Append(aE);
+  }
+  if (aCrease.IsEmpty())
+  {
+    return;
+  }
+  // The crease's turn at a point of one of its edges: the sine of the angle
+  // between the faces' normals, signed by the side it turns to (along the
+  // edge as RefFace1's boundary runs: of one sign where the crease is
+  // convex, of the other where concave), 0 where not computed; its point
+  // and direction there (and in aDot the cosine of that angle).
+  const BRepAdaptor_Surface aS1(RefFace1, false);
+  const BRepAdaptor_Surface aS2(RefFace2, false);
+  double                    aDot  = 0.;
+  const auto                aTurn = [&](const TopoDS_Edge& theE, const double theT, gp_Pnt& theP, gp_Vec& theD) {
+    aDot = 0.;
+    gp_Vec aN[2];
+    for (int k = 0; k < 2; k++)
+    {
+      const TopoDS_Face&              aF = k == 0 ? RefFace1 : RefFace2;
+      double                          f2d, l2d;
+      const occ::handle<Geom2d_Curve> aPC = BRep_Tool::CurveOnSurface(theE, aF, f2d, l2d);
+      if (aPC.IsNull())
+      {
+        return 0.;
+      }
+      const gp_Pnt2d aUV = aPC->Value(theT);
+      gp_Pnt         aP;
+      gp_Vec         aDU, aDV;
+      (k == 0 ? aS1 : aS2).D1(aUV.X(), aUV.Y(), aP, aDU, aDV);
+      aN[k] = aDU.Crossed(aDV);
+      if (aN[k].Magnitude() <= gp::Resolution())
+      {
+        return 0.;
+      }
+      aN[k].Normalize();
+      if (aF.Orientation() == TopAbs_REVERSED)
+      {
+        aN[k].Reverse();
+      }
+    }
+    BRepAdaptor_Curve(theE).D1(theT, theP, theD);
+    if (theD.Magnitude() <= gp::Resolution())
+    {
+      return 0.;
+    }
+    theD.Normalize();
+    if (theE.Orientation() == TopAbs_REVERSED)
+    {
+      theD.Reverse();
+    }
+    aDot = aN[0].Dot(aN[1]);
+    return aN[0].Crossed(aN[1]).Dot(theD);
+  };
+  // The kind at the edge's middle, which the analysis gave it.
+  gp_Pnt aPMid;
+  gp_Vec aDMid;
+  double aRef1, aRef2;
+  BRep_Tool::Range(RefEdge, aRef1, aRef2);
+  TopoDS_Edge aRefInFace1 = RefEdge;
+  for (int i = 1; i <= aCrease.Length(); i++)
+  {
+    if (aCrease(i).IsSame(RefEdge))
+    {
+      aRefInFace1 = aCrease(i);
+    }
+  }
+  const double aRefTurn = aTurn(aRefInFace1, 0.5 * (aRef1 + aRef2), aPMid, aDMid);
+  if (aRefTurn == 0.)
+  {
+    return;
+  }
+  // The points where the crease turns, inside its edges (the offsets'
+  // tangencies: the point on both offsets), and the crease's direction
+  // there; and samples of the crease with its kind, which the pieces take.
+  const int                     aNbSamples = 64;
+  NCollection_Sequence<gp_Pnt>  aTangency;
+  NCollection_Sequence<gp_Vec>  aTangencyDir;
+  NCollection_Sequence<gp_Pnt>  aSample;
+  NCollection_Sequence<double>  aSampleTurn;
+  double                        aOffsetDist = RealLast();
+  for (int i = 1; i <= aCrease.Length(); i++)
+  {
+    const TopoDS_Edge& aE = aCrease(i);
+    double             aF, aL;
+    BRep_Tool::Range(aE, aF, aL);
+    double aPrevT = aF, aPrevTurn = 0.;
+    for (int k = 0; k <= aNbSamples; k++)
+    {
+      const double aT = aF + (aL - aF) * k / aNbSamples;
+      gp_Pnt       aP;
+      gp_Vec       aD;
+      const double aG = aTurn(aE, aT, aP, aD);
+      if (aG != 0.)
+      {
+        aSample.Append(aP);
+        aSampleTurn.Append(aG);
+      }
+      if (k > 0 && aG != 0. && aPrevTurn != 0. && (aG > 0.) != (aPrevTurn > 0.))
+      {
+        // The turn's root between the two samples, by bisection.
+        double aA = aPrevT, aB = aT, aGA = aPrevTurn;
+        for (int n = 0; n < 60 && aB - aA > Precision::PConfusion() * 1.e-3; n++)
+        {
+          const double aM  = 0.5 * (aA + aB);
+          const double aGM = aTurn(aE, aM, aP, aD);
+          if (aGM == 0.)
+          {
+            break;
+          }
+          if ((aGM > 0.) == (aGA > 0.))
+          {
+            aA  = aM;
+            aGA = aGM;
+          }
+          else
+          {
+            aB = aM;
+          }
+        }
+        const double aRoot = 0.5 * (aA + aB);
+        aTurn(aE, aRoot, aP, aD);
+        // (only where the faces are tangent, not where they fold back)
+        if (aRoot - aF > 1.e-3 * (aL - aF) && aL - aRoot > 1.e-3 * (aL - aF) && aDot > 0.)
+        {
+          GeomAPI_ProjectPointOnSurf aOn1(aP, BRep_Tool::Surface(OffsetFace1));
+          GeomAPI_ProjectPointOnSurf aOn2(aP, BRep_Tool::Surface(OffsetFace2));
+          if (!aOn1.IsDone() || aOn1.NbPoints() == 0 || !aOn2.IsDone() || aOn2.NbPoints() == 0
+              || aOn1.NearestPoint().Distance(aOn2.NearestPoint()) > aOnBoth)
+          {
+            if (TracingCrease())
+            {
+              std::fprintf(stderr, "offset crease: a turn at (%.6f %.6f %.6f) not on both offsets\n", aP.X(),
+                           aP.Y(), aP.Z());
+            }
+            return;
+          }
+          aTangency.Append(aOn1.NearestPoint());
+          aTangencyDir.Append(aD);
+          aOffsetDist = std::min(aOffsetDist, aP.Distance(aOn1.NearestPoint()));
+        }
+      }
+      if (aG != 0.)
+      {
+        aPrevT    = aT;
+        aPrevTurn = aG;
+      }
+    }
+  }
+  // Where the crease, one edge, flattens to tangency at both its ends (the
+  // crease between the sides of two lofts fading out at both ends, where
+  // both meet a cylinder; DropCrossingsPastTangentEnd takes a crease with
+  // one such end), the offsets are tangent at the offsets of both ends, and
+  // there the branch along the crease meets its continuation past the end
+  // and a branch crossing it. These are taken as the tangencies inside
+  // (after them in aTangency), but only the branch into the edge is kept at
+  // them, and nothing is joined.
+  const int aNbInner = aTangency.Length();
+  if (aCrease.Length() == 1)
+  {
+    const TopoDS_Edge& aE = aCrease(1);
+    TopoDS_Vertex      aEV1, aEV2;
+    TopExp::Vertices(aE, aEV1, aEV2);
+    double aF, aL;
+    BRep_Tool::Range(aE, aF, aL);
+    gp_Pnt       aP0, aP1, aPM;
+    gp_Vec       aD0, aD1, aDM;
+    const double aG0    = aTurn(aE, aF, aP0, aD0);
+    const double aDot0  = aDot;
+    const double aG1    = aTurn(aE, aL, aP1, aD1);
+    const double aDot1  = aDot;
+    const double aGM    = aTurn(aE, 0.5 * (aF + aL), aPM, aDM);
+    if (!aEV1.IsNull() && !aEV2.IsNull() && !aEV1.IsSame(aEV2) && aDot0 > 0. && aDot1 > 0.
+        && std::abs(aG0) <= 1.e-4 && std::abs(aG1) <= 1.e-4 && std::abs(aGM) > 1.e-4)
+    {
+      const BRepAdaptor_Curve aEC(aE);
+      for (int aEnd = 0; aEnd < 2; aEnd++)
+      {
+        gp_Pnt aP;
+        gp_Vec aIn;
+        aEC.D1(aEnd == 0 ? aF : aL, aP, aIn);
+        if (aIn.Magnitude() <= gp::Resolution())
+        {
+          return;
+        }
+        aIn.Normalize();
+        if (aEnd == 1)
+        {
+          aIn.Reverse();
+        }
+        GeomAPI_ProjectPointOnSurf aOn1(aP, BRep_Tool::Surface(OffsetFace1));
+        GeomAPI_ProjectPointOnSurf aOn2(aP, BRep_Tool::Surface(OffsetFace2));
+        if (!aOn1.IsDone() || aOn1.NbPoints() == 0 || !aOn2.IsDone() || aOn2.NbPoints() == 0
+            || aOn1.NearestPoint().Distance(aOn2.NearestPoint()) > aOnBoth)
+        {
+          return;
+        }
+        aTangency.Append(aOn1.NearestPoint());
+        aTangencyDir.Append(aIn);
+        aOffsetDist = std::min(aOffsetDist, aP.Distance(aOn1.NearestPoint()));
+      }
+    }
+  }
+  if (aTangency.IsEmpty())
+  {
+    return;
+  }
+  // The neighbourhood of the tangency on the offsets, where the pieces of
+  // the X end or the intersection turns from one branch into the other:
+  // some ten microns across (a tenth of a millimetre at most, a tenth of
+  // the offset for a thin one).
+  const double aNear = std::min(0.1, 0.1 * aOffsetDist);
+  if (TracingCrease())
+  {
+    for (int k = 1; k <= aTangency.Length(); k++)
+    {
+      std::fprintf(stderr, "offset crease: %s, the offsets tangent at (%.6f %.6f %.6f)\n",
+                   k <= aNbInner ? "turns inside the crease" : "tangent at its end", aTangency(k).X(),
+                   aTangency(k).Y(), aTangency(k).Z());
+    }
+  }
+  // An edge on a piece's curve between two of its parameters, with the
+  // given vertices and the piece's curves on both offset faces (null where
+  // the piece lies on a face's seam).
+  bool       aOnSeam = false;
+  const auto aPart   = [&](const TopoDS_Edge&   theE,
+                         const double         theT0,
+                         const double         theT1,
+                         const TopoDS_Vertex& theV0,
+                         const TopoDS_Vertex& theV1) {
+    TopoDS_Edge                   aNew;
+    double                        aF, aL;
+    const occ::handle<Geom_Curve> aCurve = BRep_Tool::Curve(theE, aF, aL);
+    if (aCurve.IsNull() || BRep_Tool::IsClosed(theE, OffsetFace1) || BRep_Tool::IsClosed(theE, OffsetFace2))
+    {
+      aOnSeam = true;
+      return aNew;
+    }
+    const double aTolE = std::max(BRep_Tool::Tolerance(theE), Precision::Confusion());
+    BRep_Builder aBB;
+    // (A curve of its own, the piece's run of the curve, of the same
+    // parameter: the pieces of one curve of intersection share it, and a
+    // vertex on two of them (the curve, closed, starting and ending there)
+    // has one parameter on it, that of the piece it was put on last.)
+    aBB.MakeEdge(aNew, new Geom_TrimmedCurve(aCurve, theT0, theT1), aTolE);
+    aBB.Add(aNew, theV0.Oriented(TopAbs_FORWARD));
+    aBB.Add(aNew, theV1.Oriented(TopAbs_REVERSED));
+    aBB.Range(aNew, theT0, theT1);
+    // (The vertices' parameters on it: where a vertex has none, its
+    // parameter is found by projection on the whole curve, which may run on
+    // past the piece along the crossing branch.)
+    aBB.UpdateVertex(theV0, theT0, aNew, BRep_Tool::Tolerance(theV0));
+    aBB.UpdateVertex(theV1, theT1, aNew, BRep_Tool::Tolerance(theV1));
+    for (int aSide = 0; aSide < 2; aSide++)
+    {
+      const TopoDS_Face&              aOF = aSide == 0 ? OffsetFace1 : OffsetFace2;
+      double                          aPF, aPL;
+      const occ::handle<Geom2d_Curve> aPC = BRep_Tool::CurveOnSurface(theE, aOF, aPF, aPL);
+      // (Only a curve of the same parameter as the edge's.)
+      if (!aPC.IsNull() && std::abs(aPF - aF) <= Precision::PConfusion()
+          && std::abs(aPL - aL) <= Precision::PConfusion())
+      {
+        aBB.UpdateEdge(aNew, aPC, aOF, aTolE);
+        aBB.Range(aNew, aOF, theT0, theT1);
+      }
+    }
+    return aNew;
+  };
+  // The pieces, those running through a tangency (from the crossing branch
+  // into the one along the crease) split there.
+  NCollection_Sequence<TopoDS_Edge> aAll;
+  for (int i = 1; i <= AllEdges.Extent(); i++)
+  {
+    const TopoDS_Edge aE = TopoDS::Edge(AllEdges(i).Oriented(TopAbs_FORWARD));
+    double            aF, aL;
+    const occ::handle<Geom_Curve> aCurve = BRep_Tool::Curve(aE, aF, aL);
+    if (aCurve.IsNull())
+    {
+      return;
+    }
+    NCollection_Sequence<double> aCuts;
+    for (int k = 1; k <= aTangency.Length(); k++)
+    {
+      if (aCurve->Value(aF).Distance(aTangency(k)) <= aNear || aCurve->Value(aL).Distance(aTangency(k)) <= aNear)
+      {
+        continue;
+      }
+      GeomAPI_ProjectPointOnCurve aOn(aTangency(k), aCurve, aF, aL);
+      if (TracingCrease() && aOn.NbPoints() > 0 && aOn.LowerDistance() <= 1.)
+      {
+        std::fprintf(stderr, "offset crease: a piece passes %.3g from the tangency %d at %.6g (its range %.6g..%.6g)\n",
+                     aOn.LowerDistance(), k, aOn.LowerDistanceParameter(), aF, aL);
+      }
+      if (aOn.NbPoints() > 0 && aOn.LowerDistance() <= aNear)
+      {
+        aCuts.Append(aOn.LowerDistanceParameter());
+      }
+    }
+    if (aCuts.IsEmpty())
+    {
+      aAll.Append(aE);
+      continue;
+    }
+    // (in their order along it; a piece may run through several)
+    for (int k = 1; k < aCuts.Length(); k++)
+    {
+      for (int n = aCuts.Length(); n > k; n--)
+      {
+        if (aCuts(n) < aCuts(n - 1))
+        {
+          aCuts.Exchange(n, n - 1);
+        }
+      }
+    }
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(aE, aV1, aV2);
+    double        aT0 = aF;
+    TopoDS_Vertex aW0 = aV1;
+    for (int k = 1; k <= aCuts.Length() + 1; k++)
+    {
+      const double  aT1 = k <= aCuts.Length() ? aCuts(k) : aL;
+      TopoDS_Vertex aW1 = aV2;
+      if (k <= aCuts.Length())
+      {
+        aW1 = BRepLib_MakeVertex(aCurve->Value(aT1)).Vertex();
+        BRep_Builder().UpdateVertex(aW1, std::max(BRep_Tool::Tolerance(aE), Precision::Confusion()));
+      }
+      const TopoDS_Edge aSplit = aPart(aE, aT0, aT1, aW0, aW1);
+      if (aOnSeam)
+      {
+        return;
+      }
+      aAll.Append(aSplit);
+      aT0 = aT1;
+      aW0 = aW1;
+    }
