+//=======================================================================
+// function : InsideChainOfPieces
+// purpose  : Whether thePiece of theImage (an edge's image in several
+//            pieces) is joined at both its ends to other pieces of it, and
+//            through them to a piece with vertices in theAsDes2d (where
+//            the image meets its neighbours): a piece in the middle of the
+//            chain, which nothing meets (the convex part of a crease that
+//            turns from concave to convex inside its edge, between the
+//            joints at the turns; mitcad#2418). Such a piece was removed
+//            as one without intersections with neighbours, and the chain
+//            and the offset of the face it bounds were left open.
+//=======================================================================
+static bool InsideChainOfPieces(const TopoDS_Edge&                 thePiece,
+                                const TopoDS_Shape&                theImage,
+                                const occ::handle<BRepAlgo_AsDes>& theAsDes2d)
+{
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aPieces;
+  TopExp::MapShapes(theImage, TopAbs_EDGE, aPieces);
+  if (aPieces.Extent() < 3)
+  {
+    return false;
+  }
+  const auto aJoined = [&](const TopoDS_Shape& theE, const TopoDS_Shape& theV) {
+    for (int i = 1; i <= aPieces.Extent(); ++i)
+    {
+      if (aPieces(i).IsSame(theE))
+      {
+        continue;
+      }
+      for (TopExp_Explorer aExpV(aPieces(i), TopAbs_VERTEX); aExpV.More(); aExpV.Next())
+      {
+        if (aExpV.Current().IsSame(theV))
+        {
+          return true;
+        }
+      }
+    }
+    return false;
+  };
+  TopoDS_Vertex aV1, aV2;
+  TopExp::Vertices(thePiece, aV1, aV2);
+  if (aV1.IsNull() || aV2.IsNull() || aV1.IsSame(aV2) || !aJoined(thePiece, aV1) || !aJoined(thePiece, aV2))
+  {
+    return false;
+  }
+  // through the joints to a piece the neighbours meet
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aReached;
+  aReached.Add(thePiece);
+  for (bool bGrown = true; bGrown;)
+  {
+    bGrown = false;
+    for (int i = 1; i <= aPieces.Extent(); ++i)
+    {
+      if (aReached.Contains(aPieces(i)))
+      {
+        continue;
+      }
+      bool bTouches = false;
+      for (TopExp_Explorer aExpV(aPieces(i), TopAbs_VERTEX); aExpV.More() && !bTouches; aExpV.Next())
+      {
+        for (NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>::Iterator itR(aReached); itR.More() && !bTouches;
+             itR.Next())
+        {
+          for (TopExp_Explorer aExpR(itR.Value(), TopAbs_VERTEX); aExpR.More() && !bTouches; aExpR.Next())
+          {
+            bTouches = aExpR.Current().IsSame(aExpV.Current());
+          }
+        }
+      }
+      if (bTouches)
+      {
+        if (!theAsDes2d->Descendant(aPieces(i)).IsEmpty())
+        {
+          return true;
+        }
+        aReached.Add(aPieces(i));
+        bGrown = true;
+      }
+    }
+  }
+  return false;
+}
