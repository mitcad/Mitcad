+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aReached;
+  for (NCollection_DataMap<TopoDS_Shape, int, TopTools_ShapeMapHasher>::Iterator aIt(aJoinFirst); aIt.More();
