+            NCollection_List<TopoDS_Shape> aL1, aL2;
+            aL1.Append(aCut.Oriented(aO1));
+            aL2.Append(aCut.Oriented(aO2));
+            Store(aNFD, aNG, aL1, aL2);
+            TopoDS_Compound aC;
+            B.MakeCompound(aC);
+            B.Add(aC, aCut);
+            Build.Bind(aED, aC);
+            break;
+          }
+          if (Build.IsBound(aED))
+          {
+            break;
+          }
+        }
+      }
+    }
+  }
 }
 
