+    aNbAlong.Append(0);
+    aSideSum.Append(0.);
+    aJoinTol.Append(0.);
+  }
+  for (int i = 1; i <= aAll.Length(); i++)
+  {
+    const TopoDS_Edge aE = aAll(i);
+    BRepAdaptor_Curve aC(aE);
+    const double      aT[2] = {aC.FirstParameter(), aC.LastParameter()};
+    int               aAt[2] = {0, 0};
+    for (int aEnd = 0; aEnd < 2; aEnd++)
+    {
+      const gp_Pnt aP = aC.Value(aT[aEnd]);
+      for (int k = 1; k <= aTangency.Length() && aAt[aEnd] == 0; k++)
+      {
+        if (aP.Distance(aTangency(k)) <= aNear)
