+// The face of the solid along an edge of the spine whose surface holds the
+// contact of Fd on side onS (its middle point within ten times Tol), as the
+// solid holds it; null where no face or more than one does.
+static TopoDS_Face ChFi3d_SpineFaceHoldingContact(const TopOpeBRepDS_DataStructure&   DStr,
+                                                  const int                           SolidIndex,
+                                                  const occ::handle<ChFiDS_Spine>&    Spine,
+                                                  const occ::handle<ChFiDS_SurfData>& Fd,
+                                                  const int                           onS,
+                                                  const double                        Tol)
+{
+  const ChFiDS_FaceInterference& FI = Fd->Interference(onS);
+  if (Spine.IsNull() || SolidIndex <= 0 || FI.LineIndex() <= 0)
+  {
+    return TopoDS_Face();
+  }
+  const occ::handle<Geom_Curve>& C = DStr.Curve(FI.LineIndex()).Curve();
+  if (C.IsNull())
+  {
+    return TopoDS_Face();
+  }
+  const gp_Pnt P = C->Value(0.5 * (FI.FirstParameter() + FI.LastParameter()));
+  TopoDS_Face  aFound;
+  int          aNb = 0;
+  for (TopExp_Explorer exF(DStr.Shape(SolidIndex), TopAbs_FACE); exF.More(); exF.Next())
+  {
+    const TopoDS_Face& F = TopoDS::Face(exF.Current());
+    if (!aFound.IsNull() && aFound.IsSame(F))
+    {
+      continue;
+    }
+    bool aOnSpine = false;
+    for (TopExp_Explorer exE(F, TopAbs_EDGE); exE.More() && !aOnSpine; exE.Next())
+    {
+      for (int ie = 1; ie <= Spine->NbEdges() && !aOnSpine; ie++)
+      {
+        aOnSpine = Spine->Edges(ie).IsSame(exE.Current());
+      }
+    }
+    if (!aOnSpine)
+    {
+      continue;
+    }
+    GeomAPI_ProjectPointOnSurf aPr(P, BRep_Tool::Surface(F));
+    if (aPr.NbPoints() > 0 && aPr.LowerDistance() <= 10. * Tol)
+    {
+      aFound = F;
+      aNb++;
+    }
+  }
+  return aNb == 1 ? aFound : TopoDS_Face();
+}
