+// Whether the spine is closed and each of its edges is an arc of the circle about Axis of
+// radius R: the spine goes once round that whole circle.
+static bool ChFi3d_SpineWholeCircle(const occ::handle<ChFiDS_Spine>& Spine, const gp_Ax1& Axis, const double R)
+{
+  if (Spine.IsNull() || !Spine->IsPeriodic())
+  {
+    return false;
+  }
+  const gp_Lin aAxis(Axis);
+  for (int ie = 1; ie <= Spine->NbEdges(); ie++)
+  {
+    const BRepAdaptor_Curve aC(Spine->Edges(ie));
+    if (aC.GetType() != GeomAbs_Circle)
+    {
+      return false;
+    }
+    const gp_Circ aCirc = aC.Circle();
+    if (!aCirc.Axis().IsParallel(Axis, Precision::Angular())
+        || aAxis.Distance(aCirc.Location()) > Precision::Confusion() || std::abs(aCirc.Radius() - R) > 1.e-6)
+    {
+      return false;
+    }
+  }
+  return true;
+}
