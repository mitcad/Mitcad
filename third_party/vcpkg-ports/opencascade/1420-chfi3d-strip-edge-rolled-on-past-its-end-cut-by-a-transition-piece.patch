+// Whether the blend of SD rolls on one side on an edge of a face W (its face
+// on that side) that holds vertex V and goes on tangentially from P's face B
+// on that side at the vertex A of the edge Er P rolls on, where P's contact
+// ends towards V (W a transition piece of the chamfer B belongs to), or
+// turns about A on Er itself.
+static bool ChFi3d_RollsOnEdgeOfFaceAt(const TopOpeBRepDS_DataStructure&   DStr,
+                                       const ChFiDS_Map&                   VFMap,
+                                       const ChFiDS_Map&                   EFMap,
+                                       const occ::handle<ChFiDS_SurfData>& SD,
+                                       const TopoDS_Vertex&                V,
+                                       const occ::handle<ChFiDS_SurfData>& P,
+                                       const bool                          isFirst,
+                                       const double                        Tol)
+{
+  if (SD.IsNull() || V.IsNull() || !VFMap.Contains(V) || P.IsNull())
+  {
+    return false;
+  }
+  // A and B: P's contact rolling on Er at its end towards V.
+  TopoDS_Vertex A;
+  TopoDS_Face   B;
+  for (int s = 1; s <= 2 && A.IsNull(); s++)
+  {
+    if (!P->IsOnCurve(s) || P->IndexOfC(s) <= 0 || P->Index(s) <= 0)
+    {
+      continue;
+    }
+    const TopoDS_Shape& Er = DStr.Shape(P->IndexOfC(s));
+    if (!EFMap.Contains(Er))
+    {
+      continue;
+    }
+    const gp_Pnt pA = P->Vertex(isFirst, s).Point();
+    for (TopExp_Explorer ex(Er, TopAbs_VERTEX); ex.More() && A.IsNull(); ex.Next())
+    {
+      if (BRep_Tool::Pnt(TopoDS::Vertex(ex.Current())).Distance(pA) <= Tol)
+      {
+        A = TopoDS::Vertex(ex.Current());
+      }
+    }
+    if (!A.IsNull())
+    {
+      B = TopoDS::Face(DStr.Shape(P->Index(s)));
+    }
+  }
+  if (A.IsNull() || B.IsNull())
+  {
+    return false;
+  }
+  // Whether W meets B tangentially at A: their outward normals there within
+  // a tenth of a radian (ChFi3d::IsTangentFaces' angle).
+  const gp_Pnt pA         = BRep_Tool::Pnt(A);
+  const auto   normalAtA  = [&](const TopoDS_Face& F, gp_Dir& theN) {
+    const occ::handle<Geom_Surface> S = BRep_Tool::Surface(F);
+    if (S.IsNull())
+    {
+      return false;
+    }
+    GeomAPI_ProjectPointOnSurf aPr(pA, S);
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > std::max(1.e-4, 2. * BRep_Tool::Tolerance(A)))
+    {
+      return false;
+    }
+    double u = 0., v = 0.;
+    aPr.LowerDistanceParameters(u, v);
+    GeomLProp_SLProps aProps(S, u, v, 1, Precision::Confusion());
+    if (!aProps.IsNormalDefined())
+    {
+      return false;
+    }
+    theN = aProps.Normal();
+    if (F.Orientation() == TopAbs_REVERSED)
+    {
+      theN.Reverse();
+    }
+    return true;
+  };
+  gp_Dir     nB;
+  const bool hasB       = normalAtA(B, nB);
+  const auto continuesB = [&](const TopoDS_Face& W) {
+    gp_Dir nW;
+    return hasB && normalAtA(W, nW) && nW.Angle(nB) < 0.1;
+  };
+  for (int s = 1; s <= 2; s++)
+  {
+    if (!SD->IsOnCurve(s) || SD->IndexOfC(s) <= 0 || SD->Index(s) <= 0)
+    {
+      continue;
+    }
+    // (A turn about A on Er itself.)
+    if (SD->IndexOfC(s) == P->IndexOfC(s) && SD->Index(s) == P->Index(s))
+    {
+      return true;
+    }
+    const TopoDS_Shape& W = DStr.Shape(SD->Index(s));
+    for (NCollection_List<TopoDS_Shape>::Iterator itV(VFMap.FindFromKey(V)); itV.More(); itV.Next())
+    {
+      if (itV.Value().IsSame(W) && continuesB(TopoDS::Face(W)))
+      {
+        return true;
+      }
+    }
+  }
+  return false;
+}
