+//=======================================================================
+// function : SectionsOfChamfersInOnePlane
+// purpose  : Whether every edge at a corner is chamfered (no sharp edge),
+//           each chamfer's surface data at the corner a plane that meets
+//           both its neighbours on the faces between them (theInters), and
+//           the chamfers' sections at the corner, each a straight segment
+//           between the points where its contact lines meet those of its
+//           neighbours, lie in one plane within theTol (mitcad#2306).
+//           theEnds gets the sections' end points, two for each chamfer.
+//=======================================================================
+
+static bool SectionsOfChamfersInOnePlane(
+  const TopOpeBRepDS_DataStructure&                     theDStr,
+  const NCollection_Array1<occ::handle<ChFiDS_Stripe>>& theCD,
+  const int                                             theNbEdges,
+  const bool                                            theInters,
+  const NCollection_Array1<bool>&                       theSharp,
+  const NCollection_Array1<int>&                        theJf,
+  const NCollection_Array2<int>&                        theI,
+  const NCollection_Array2<double>&                     theP,
+  const double                                          theTol,
+  NCollection_Sequence<gp_Pnt>&                         theEnds)
+{
+  theEnds.Clear();
+  if (!theInters || theNbEdges < 3)
+  {
+    return false;
+  }
+  for (int ic = 0; ic < theNbEdges; ic++)
+  {
+    int icplus = 0, icmoins = 0;
+    Indices(theNbEdges, ic, icplus, icmoins);
+    if (theSharp.Value(ic) || theCD.Value(ic).IsNull()
+        || occ::down_cast<ChFiDS_ChamfSpine>(theCD.Value(ic)->Spine()).IsNull()
+        || theI.Value(ic, icplus) != theI.Value(ic, icmoins))
+    {
+      return false;
+    }
+    const int           isurf = SurfIndex(theCD, ic, theI.Value(ic, icplus), ChFiSURFACE);
+    GeomAdaptor_Surface asurf(theDStr.Surface(isurf).Surface());
+    if (asurf.GetType() != GeomAbs_Plane)
+    {
+      return false;
+    }
+    gp_Pnt2d p2d1, p2d2;
+    Calcul_P2dOnSurf(theCD.Value(ic),
+                     3 - theJf.Value(ic),
+                     theI.Value(ic, icmoins),
+                     theP.Value(ic, icmoins),
+                     p2d1);
+    Calcul_P2dOnSurf(theCD.Value(ic),
+                     theJf.Value(ic),
+                     theI.Value(ic, icplus),
+                     theP.Value(ic, icplus),
+                     p2d2);
+    theEnds.Append(asurf.Value(p2d1.X(), p2d1.Y()));
+    theEnds.Append(asurf.Value(p2d2.X(), p2d2.Y()));
+  }
+  NCollection_Array1<gp_Pnt> aPnts(1, theEnds.Length());
+  for (int k = 1; k <= theEnds.Length(); k++)
+  {
+    aPnts.SetValue(k, theEnds.Value(k));
+  }
+  const bool aPlanar = GProp_PEquation(aPnts, theTol).IsPlanar();
+  if (!aPlanar)
+  {
+    theEnds.Clear();
+  }
+  return aPlanar;
+}
+
+//=======================================================================
+// function : CornerPlane
+// purpose  : The plane a plate built G0 to sections in one plane
+//           (SectionsOfChamfersInOnePlane) starts from, when it holds every
+//           end of the sections and the plate's curves on it end at them,
+//           all within theTol: the corner's surface, on which the plate's
+//           curves are the sections' curves (the plate is that plane and
+//           a correction, which is nothing there). Null otherwise
+//           (mitcad#2306).
+//=======================================================================
+
+static occ::handle<Geom_Plane> CornerPlane(const GeomPlate_BuildPlateSurface& thePlate,
+                                           const NCollection_Sequence<gp_Pnt>& theEnds,
+                                           const double                        theTol)
+{
+  occ::handle<Geom_Surface> aInit = thePlate.SurfInit();
+  const occ::handle<Geom_RectangularTrimmedSurface> aTrimmed =
+    occ::down_cast<Geom_RectangularTrimmedSurface>(aInit);
+  if (!aTrimmed.IsNull())
+  {
+    aInit = aTrimmed->BasisSurface();
+  }
+  const occ::handle<Geom_Plane> aPlane = occ::down_cast<Geom_Plane>(aInit);
+  if (aPlane.IsNull() || thePlate.G0Error() > theTol || thePlate.Curves2d().IsNull())
+  {
+    return occ::handle<Geom_Plane>();
+  }
+  const gp_Pln aPln = aPlane->Pln();
+  for (int k = 1; k <= theEnds.Length(); k++)
+  {
+    if (aPln.Distance(theEnds.Value(k)) > theTol)
+    {
+      return occ::handle<Geom_Plane>();
+    }
+  }
+  const occ::handle<NCollection_HArray1<occ::handle<Geom2d_Curve>>>& aCurves = thePlate.Curves2d();
+  for (int ic = aCurves->Lower(); ic <= aCurves->Upper(); ic++)
+  {
+    const occ::handle<Geom2d_Curve>& aC2d = aCurves->Value(ic);
+    for (int e = 0; e < 2; e++)
+    {
+      const gp_Pnt2d aUV = aC2d->Value(e == 0 ? aC2d->FirstParameter() : aC2d->LastParameter());
+      const gp_Pnt   aP  = aPlane->Value(aUV.X(), aUV.Y());
+      bool           aAtEnd = false;
+      for (int k = 1; k <= theEnds.Length() && !aAtEnd; k++)
+      {
+        aAtEnd = aP.Distance(theEnds.Value(k)) <= theTol;
+      }
+      if (!aAtEnd)
+      {
+        return occ::handle<Geom_Plane>();
+      }
+    }
+  }
+  return aPlane;
+}
