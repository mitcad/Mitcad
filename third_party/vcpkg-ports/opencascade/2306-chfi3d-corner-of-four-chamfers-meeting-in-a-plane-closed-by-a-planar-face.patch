+//=======================================================================
+// function : ForwardSolid
+// purpose  : A solid whose own orientation is reversed, as the same solid
+//           oriented forward holding its shells with that orientation
+//           composed into theirs (the faces' orientations within it, and
+//           so the side the material is on, are those of the solid given);
+//           any other shape as it is. The result of a blend is rebuilt in
+//           new solids, which took the input solid's shells without its
+//           own orientation: from a reversed solid around a shell facing
+//           in (BRepLib::OrientClosedSolid's result for such a shell),
+//           every face the blends did not make came out facing in,
+//           an invalid shape with the volume wrong (mitcad#2306).
+//=======================================================================
+
+static TopoDS_Shape ForwardSolid(const TopoDS_Shape& theShape)
+{
+  if (theShape.IsNull() || theShape.ShapeType() != TopAbs_SOLID
+      || theShape.Orientation() != TopAbs_REVERSED)
+  {
+    return theShape;
+  }
+  BRep_Builder aBuilder;
+  TopoDS_Solid aSolid;
+  aBuilder.MakeSolid(aSolid);
+  for (TopoDS_Iterator anIt(theShape); anIt.More(); anIt.Next())
+  {
+    aBuilder.Add(aSolid, anIt.Value());
+  }
+  aSolid.Closed(theShape.Closed());
+  return aSolid;
+}
