+      {
+        throw;
+      }
+      aComputed = false;
+    }
+    if (aComputed && st->Spine()->ErrorStatus() == ChFiDS_Ok)
+    {
+      badstripes.Remove(itBad);
+      continue;
+    }
+    for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itO(myOcctInverseStripes); itO.More();)
+    {
+      if (itO.Value() == st)
+      {
+        myOcctInverseStripes.Remove(itO);
+      }
+      else
+      {
+        itO.Next();
+      }
+    }
+    st->Spine()->SetErrorStatus(aStatus);
+    itBad.Next();
+  }
   done = (badstripes.IsEmpty());
