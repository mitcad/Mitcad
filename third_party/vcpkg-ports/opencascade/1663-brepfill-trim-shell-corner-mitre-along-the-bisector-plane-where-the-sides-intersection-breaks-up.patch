+//=======================================================================
+// Mitres cut along the bisector plane (mitcad#1559)
+//=======================================================================
+
+namespace
+{
+
+// The parameter in [theFirst, theLast] where thePoint (a point along a
+// curve) crosses the plane, of the crossings the one nearest to theNear,
+// and its point; false where it does not cross.
+template <class PointAt>
+bool CrossingNear(const PointAt& thePoint,
+                  const double   theFirst,
+                  const double   theLast,
+                  const gp_Pln&  thePlane,
+                  const gp_Pnt&  theNear,
+                  double&        theParam,
+                  gp_Pnt&        theCrossing)
+{
+  const gp_XYZ aN     = thePlane.Axis().Direction().XYZ();
+  const gp_XYZ aO     = thePlane.Location().XYZ();
+  const auto   aSide  = [&](const double theT) { return (thePoint(theT).XYZ() - aO).Dot(aN); };
+  const int    aNb    = 256;
+  bool         bFound = false;
+  double       aBest  = RealLast();
+  double       aTa    = theFirst;
+  double       aFa    = aSide(aTa);
+  for (int i = 1; i <= aNb; ++i)
+  {
+    const double aTb = theFirst + (theLast - theFirst) * i / aNb;
+    const double aFb = aSide(aTb);
+    if ((aFa < 0.) != (aFb < 0.))
+    {
+      double a = aTa, b = aTb, aFA = aFa;
+      for (int k = 0; k < 200 && std::abs(b - a) > 1.e-15 * (1. + std::abs(b)); ++k)
+      {
+        const double m   = 0.5 * (a + b);
+        const double aFm = aSide(m);
+        if ((aFm < 0.) == (aFA < 0.))
+        {
+          a   = m;
+          aFA = aFm;
+        }
+        else
+        {
+          b = m;
+        }
+      }
+      const double t = 0.5 * (a + b);
+      const gp_Pnt p = thePoint(t);
+      const double d = p.Distance(theNear);
+      if (d < aBest)
+      {
+        aBest       = d;
+        theParam    = t;
+        theCrossing = p;
+        bFound      = true;
+      }
+    }
+    aTa = aTb;
+    aFa = aFb;
+  }
+  return bFound;
+}
+
+// A swept face: its surface, whether its section runs along u (its U-edges
+// are iso-lines of u), its ranges along the section and the path, and the
+// section parameters at its first U-edge (From) and at the next (To).
+struct SweptFace
+{
+  TopoDS_Face               Face;
+  occ::handle<Geom_Surface> Surface;
+  bool                      SectionInU = true;
+  double                    S0 = 0., S1 = 0., T0 = 0., T1 = 0., From = 0., To = 0.;
+
+  gp_Pnt Value(const double theS, const double theT) const
+  {
+    return SectionInU ? Surface->Value(theS, theT) : Surface->Value(theT, theS);
+  }
+
+  gp_Pnt2d UV(const double theS, const double theT) const
+  {
+    return SectionInU ? gp_Pnt2d(theS, theT) : gp_Pnt2d(theT, theS);
+  }
+
+  double Section(const double theFrac) const { return From + (To - From) * theFrac; }
+
+  // The section parameter of the edge's curve on the face at its middle.
+  double SectionOf(const TopoDS_Edge& theEdge) const
+  {
+    double                          f = 0., l = 0.;
+    const occ::handle<Geom2d_Curve> aC = BRep_Tool::CurveOnSurface(theEdge, Face, f, l);
+    const gp_Pnt2d                  aP = aC->Value(0.5 * (f + l));
+    return SectionInU ? aP.X() : aP.Y();
+  }
+
+  bool Init(const TopoDS_Face& theFace, const TopoDS_Edge& theUEdge, const TopoDS_Edge& theNextUEdge)
+  {
+    Face    = TopoDS::Face(theFace.Oriented(TopAbs_FORWARD));
+    Surface = BRep_Tool::Surface(Face);
+    double                          f = 0., l = 0.;
+    const occ::handle<Geom2d_Curve> aC = BRep_Tool::CurveOnSurface(theUEdge, Face, f, l);
+    if (Surface.IsNull() || aC.IsNull())
+    {
+      return false;
+    }
+    const gp_Pnt2d a = aC->Value(f), b = aC->Value(l);
+    SectionInU       = std::abs(b.X() - a.X()) < std::abs(b.Y() - a.Y());
+    double u0 = 0., u1 = 0., v0 = 0., v1 = 0.;
+    BRepTools::UVBounds(Face, u0, u1, v0, v1);
+    S0 = SectionInU ? u0 : v0;
+    S1 = SectionInU ? u1 : v1;
+    T0 = SectionInU ? v0 : u0;
+    T1 = SectionInU ? v1 : u1;
+    // From the U-edge to the next (a closed section's one face: along its
+    // range).
+    bool bForward = true;
+    if (!theUEdge.IsSame(theNextUEdge))
+    {
+      const double aS = SectionOf(theUEdge);
+      bForward        = std::abs(aS - S0) <= std::abs(aS - S1);
+    }
+    From = bForward ? S0 : S1;
+    To   = bForward ? S1 : S0;
+    return true;
+  }
+};
+
+// Where one side's faces cross the plane: its rows' faces and, at kNb + 1
+// points of each row from its U-edge to the next, the path parameter and
+// the point of the crossing. A place on the cut is a row and a fraction of
+// it.
+struct SideCut
+{
+  static const int                 kNb = 64;
+  gp_Pln                           Plane;
+  std::vector<SweptFace>           Faces;
+  std::vector<std::vector<double>> T;
+  std::vector<std::vector<gp_Pnt>> P;
+
+  // The crossing at the fraction of the row, the one nearest to theNear.
+  bool At(const int theRow, const double theFrac, const gp_Pnt& theNear, double& theT, gp_Pnt& theP) const
+  {
+    const SweptFace& aF = Faces[static_cast<size_t>(theRow)];
+    const double     aS = aF.Section(theFrac);
+    const auto       aAt = [&aF, aS](const double theV) { return aF.Value(aS, theV); };
+    return CrossingNear(aAt, aF.T0, aF.T1, Plane, theNear, theT, theP);
+  }
+
+  bool Sample(const gp_Pnt& theStart)
+  {
+    gp_Pnt aNear = theStart;
+    T.assign(Faces.size(), std::vector<double>(kNb + 1, 0.));
+    P.assign(Faces.size(), std::vector<gp_Pnt>(kNb + 1));
+    for (size_t r = 0; r < Faces.size(); ++r)
+    {
+      for (int j = 0; j <= kNb; ++j)
+      {
+        if (!At(static_cast<int>(r), double(j) / kNb, aNear, T[r][j], P[r][j]))
+        {
+          return false;
+        }
+        aNear = P[r][j];
+      }
+    }
+    return true;
+  }
+
+  // The place on the cut nearest to thePoint, in theRow (any row when
+  // negative): the nearest sample, then a golden-section search about it.
+  bool Nearest(const gp_Pnt& thePoint, const int theRow, int& theFound, double& theFrac, double& theT, gp_Pnt& theP) const
+  {
+    double aBest = RealLast();
+    int    aJ    = 0;
+    theFound     = -1;
+    for (size_t r = 0; r < Faces.size(); ++r)
+    {
+      if (theRow >= 0 && static_cast<int>(r) != theRow)
+      {
+        continue;
+      }
+      for (int j = 0; j <= kNb; ++j)
+      {
+        const double d = P[r][j].Distance(thePoint);
+        if (d < aBest)
+        {
+          aBest    = d;
+          theFound = static_cast<int>(r);
+          aJ       = j;
+        }
+      }
+    }
+    if (theFound < 0)
+    {
+      return false;
+    }
+    const size_t aR    = static_cast<size_t>(theFound);
+    double       a     = std::max(0., double(aJ - 1) / kNb);
+    double       b     = std::min(1., double(aJ + 1) / kNb);
+    const double ratio = 0.5 * (std::sqrt(5.) - 1.);
+    const gp_Pnt aNear = P[aR][static_cast<size_t>(aJ)];
+    const auto   aDist = [&](const double theF) {
+      double t = 0.;
+      gp_Pnt p;
+      return At(theFound, theF, aNear, t, p) ? p.Distance(thePoint) : RealLast();
+    };
+    for (int k = 0; k < 100 && b - a > 1.e-13; ++k)
+    {
+      const double c = b - ratio * (b - a);
+      const double d = a + ratio * (b - a);
+      if (aDist(c) < aDist(d))
+      {
+        b = d;
+      }
+      else
+      {
+        a = c;
+      }
+    }
+    theFrac = 0.5 * (a + b);
+    return At(theFound, theFrac, aNear, theT, theP);
+  }
+};
+
+// A place on the loop round the section where an edge of the mitre ends:
+// where a U-edge of either side (or of both) crosses the plane. Lambda is
+// its place on the first side's cut (row + fraction).
+struct MitreBreak
+{
+  double        Lambda = 0.;
+  TopoDS_Vertex Vertex;
+  int           UEdge[2] = {-1, -1}; // the row of each side's U-edge ending here
+  double        UParam[2] = {0., 0.}; // the U-edge's parameter there
+};
+
+} // namespace
