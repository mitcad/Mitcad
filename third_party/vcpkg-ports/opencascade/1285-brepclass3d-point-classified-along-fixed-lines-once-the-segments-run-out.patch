+//=======================================================================
+// function : FixedLine
+// purpose  : Mitcad: the lines a point is classified along once the
+//            segments to the faces (SolidExplorer::Segment, OtherSegment)
+//            have run out, every one of them rejected (through an edge or a
+//            vertex, or ending on a face's boundary; a face whose surface
+//            holds the point gives none). Such a point counted as OUT: a
+//            point of one cavity in the plane of other cavities' faces,
+//            where they ran out, was found outside the solid of another
+//            cavity. The lines go from <theP> towards points spread over the
+//            box of <theShape> (a fixed sequence, the same on every call),
+//            each <thePar> long, past the box's farthest corner.
+//            <theIndex> counts the lines given (the box is computed with
+//            the first). False when the sequence has ended or the box is
+//            not finite.
+//=======================================================================
+static bool FixedLine(const TopoDS_Shape& theShape,
+                      const gp_Pnt&       theP,
+                      Bnd_Box&            theBox,
+                      int&                theIndex,
+                      gp_Lin&             theL,
+                      double&             thePar)
+{
+  constexpr int NB_FIXED_LINES = 32;
+  if (theIndex == 0)
+  {
+    BRepBndLib::Add(theShape, theBox, false);
+  }
+  if (theBox.IsVoid() || theBox.IsOpen())
+  {
+    return false;
+  }
+  double aXmin, aYmin, aZmin, aXmax, aYmax, aZmax;
+  theBox.Get(aXmin, aYmin, aZmin, aXmax, aYmax, aZmax);
+  double aFar = 0.0;
+  for (int aCorner = 0; aCorner < 8; ++aCorner)
+  {
+    const gp_Pnt aPnt((aCorner & 1) != 0 ? aXmax : aXmin,
+                      (aCorner & 2) != 0 ? aYmax : aYmin,
+                      (aCorner & 4) != 0 ? aZmax : aZmin);
+    aFar = std::max(aFar, theP.Distance(aPnt));
+  }
+  while (theIndex < NB_FIXED_LINES)
+  {
+    const double aK = static_cast<double>(theIndex);
+    ++theIndex;
+    // An additive sequence of three irrational steps (the first point the
+    // box's centre), kept off the box's sides.
+    const double aFx = 0.1 + 0.8 * std::fmod(0.5 + aK * 0.8191725133961645, 1.0);
+    const double aFy = 0.1 + 0.8 * std::fmod(0.5 + aK * 0.6710436067037893, 1.0);
+    const double aFz = 0.1 + 0.8 * std::fmod(0.5 + aK * 0.5497004779019703, 1.0);
+    const gp_Pnt aTarget(aXmin + aFx * (aXmax - aXmin),
+                         aYmin + aFy * (aYmax - aYmin),
+                         aZmin + aFz * (aZmax - aZmin));
+    const gp_Vec aV(theP, aTarget);
+    if (aV.Magnitude() <= Precision::Confusion())
+    {
+      continue;
+    }
+    theL   = gp_Lin(theP, gp_Dir(aV));
+    thePar = aFar + Precision::Confusion();
+    return true;
+  }
+  return false;
+}
+
