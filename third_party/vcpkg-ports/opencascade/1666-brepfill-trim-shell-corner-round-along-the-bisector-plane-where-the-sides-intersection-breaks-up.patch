+//=======================================================================
+// Rounded corners cut along the bisector plane (mitcad#1564)
+//=======================================================================
+
+namespace
+{
+
+// The parameter between theFrom and theTo (either way round) where
+// thePoint (a point along a curve) first crosses the plane going from
+// theFrom, and its point; false where it does not cross.
+template <class PointAt>
+bool FirstCrossing(const PointAt& thePoint,
+                   const double   theFrom,
+                   const double   theTo,
+                   const gp_Pln&  thePlane,
+                   double&        theParam,
+                   gp_Pnt&        theCrossing)
+{
+  const gp_XYZ aN    = thePlane.Axis().Direction().XYZ();
+  const gp_XYZ aO    = thePlane.Location().XYZ();
+  const auto   aSide = [&](const double theT) { return (thePoint(theT).XYZ() - aO).Dot(aN); };
+  const int    aNb   = 256;
+  double       aTa   = theFrom;
+  double       aFa   = aSide(aTa);
+  for (int i = 1; i <= aNb; ++i)
+  {
+    const double aTb = theFrom + (theTo - theFrom) * i / aNb;
+    const double aFb = aSide(aTb);
+    if ((aFa < 0.) != (aFb < 0.))
+    {
+      double a = aTa, b = aTb, aFA = aFa;
+      for (int k = 0; k < 200 && std::abs(b - a) > 1.e-15 * (1. + std::abs(b)); ++k)
+      {
+        const double m   = 0.5 * (a + b);
+        const double aFm = aSide(m);
+        if ((aFm < 0.) == (aFA < 0.))
+        {
+          a   = m;
+          aFA = aFm;
+        }
+        else
+        {
+          b = m;
+        }
+      }
+      theParam    = 0.5 * (a + b);
+      theCrossing = thePoint(theParam);
+      return true;
+    }
+    aTa = aTb;
+    aFa = aFb;
+  }
+  return false;
+}
