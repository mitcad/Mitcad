+// One side of a rounded corner: its rows' faces, their bounds at the
+// corner and each bound's path parameter on its face. Sign makes the
+// distance from the plane positive past it, into the other side. A place
+// on the side is a row and a fraction of it from its U-edge to the next;
+// the cut is where the side crosses the plane, which it does where its
+// bound lies past the plane, sampled at kNb + 1 places of each row.
+struct RoundSide
+{
+  static const int                 kNb = 64;
+  gp_Pln                           Plane;
+  double                           Sign = 1.;
+  std::vector<SweptFace>           Faces;
+  std::vector<TopoDS_Edge>         Bounds;
+  std::vector<double>              TB;
+  std::vector<std::vector<char>>   Has;
+  std::vector<std::vector<double>> T;
+  std::vector<std::vector<gp_Pnt>> P;
+
+  int NbRows() const { return static_cast<int>(Faces.size()); }
+
+  const SweptFace& Face(const int theRow) const { return Faces[static_cast<size_t>(theRow)]; }
+
+  double Bound(const int theRow) const { return TB[static_cast<size_t>(theRow)]; }
+
+  // The path parameter of the face's other end.
+  double Far(const int theRow) const
+  {
+    const SweptFace& aF = Face(theRow);
+    return std::abs(Bound(theRow) - aF.T0) < std::abs(Bound(theRow) - aF.T1) ? aF.T1 : aF.T0;
+  }
+
+  double Distance(const gp_Pnt& thePoint) const
+  {
+    return Sign * (thePoint.XYZ() - Plane.Location().XYZ()).Dot(Plane.Axis().Direction().XYZ());
+  }
+
+  gp_Pnt BoundPoint(const int theRow, const double theFrac) const
+  {
+    const SweptFace& aF = Face(theRow);
+    return aF.Value(aF.Section(theFrac), Bound(theRow));
+  }
+
+  // How far the bound lies past the plane at the place.
+  double Past(const int theRow, const double theFrac) const { return Distance(BoundPoint(theRow, theFrac)); }
+
+  // The side lies before the plane at the middle of each face's other end.
+  bool Behind() const
+  {
+    for (int r = 0; r < NbRows(); ++r)
+    {
+      const SweptFace& aF = Face(r);
+      if (Distance(aF.Value(aF.Section(0.5), Far(r))) >= 0.)
+      {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  // The cut at the place: the crossing nearest to the bound along the path.
+  bool Cut(const int theRow, const double theFrac, double& theT, gp_Pnt& theP) const
+  {
+    if (Past(theRow, theFrac) <= 0.)
+    {
+      return false;
+    }
+    const SweptFace& aF  = Face(theRow);
+    const double     aS  = aF.Section(theFrac);
+    const auto       aAt = [&aF, aS](const double theV) { return aF.Value(aS, theV); };
+    return FirstCrossing(aAt, Bound(theRow), Far(theRow), Plane, theT, theP);
+  }
+
+  void Sample()
+  {
+    const size_t aNbR = Faces.size();
+    Has.assign(aNbR, std::vector<char>(kNb + 1, 0));
+    T.assign(aNbR, std::vector<double>(kNb + 1, 0.));
+    P.assign(aNbR, std::vector<gp_Pnt>(kNb + 1));
+    for (size_t r = 0; r < aNbR; ++r)
+    {
+      for (int j = 0; j <= kNb; ++j)
+      {
+        const size_t i = static_cast<size_t>(j);
+        Has[r][i]      = static_cast<char>(Cut(static_cast<int>(r), double(j) / kNb, T[r][i], P[r][i]) ? 1 : 0);
+      }
+    }
+  }
+
+  // The places where the bound crosses the plane, in each row; false
+  // where one lies at a U-edge.
+  bool Roots(std::vector<std::pair<int, double>>& theRoots) const
+  {
+    for (int r = 0; r < NbRows(); ++r)
+    {
+      double aFa = 0.;
+      bool   bA  = Past(r, aFa) > 0.;
+      for (int j = 1; j <= kNb; ++j)
+      {
+        const double aFb = double(j) / kNb;
+        const bool   bB  = Past(r, aFb) > 0.;
+        if (bA != bB)
+        {
+          double a = aFa, b = aFb;
+          for (int k = 0; k < 100 && b - a > 1.e-15; ++k)
+          {
+            const double m = 0.5 * (a + b);
+            if ((Past(r, m) > 0.) == bA)
+            {
+              a = m;
+            }
+            else
+            {
+              b = m;
+            }
+          }
+          const double aRoot = 0.5 * (a + b);
+          if (aRoot < 1.e-6 || aRoot > 1. - 1.e-6)
+          {
+            return false;
+          }
+          theRoots.emplace_back(r, aRoot);
+        }
+        aFa = aFb;
+        bA  = bB;
+      }
+    }
+    return true;
+  }
+
+  // The bound's parameter at the place: at a row's end that end of the
+  // bound, elsewhere where its curve on the face reaches the place's
+  // section parameter.
+  bool BoundParam(const int theRow, const double theFrac, double& theU) const
+  {
+    const SweptFace&                aF = Face(theRow);
+    double                          f = 0., l = 0.;
+    const occ::handle<Geom2d_Curve> aC =
+      BRep_Tool::CurveOnSurface(Bounds[static_cast<size_t>(theRow)], aF.Face, f, l);
+    if (aC.IsNull())
+    {
+      return false;
+    }
+    const double aS   = aF.Section(theFrac);
+    const auto   aSOf = [&aC, &aF](const double theV) {
+      const gp_Pnt2d aP = aC->Value(theV);
+      return aF.SectionInU ? aP.X() : aP.Y();
+    };
+    const double aHf = aSOf(f) - aS;
+    const double aHl = aSOf(l) - aS;
+    if (theFrac <= 0. || theFrac >= 1. || (aHf < 0.) == (aHl < 0.))
+    {
+      theU = std::abs(aHf) <= std::abs(aHl) ? f : l;
+      return true;
+    }
+    double a = f, b = l;
+    for (int k = 0; k < 200 && std::abs(b - a) > 1.e-15 * (1. + std::abs(b)); ++k)
+    {
+      const double m = 0.5 * (a + b);
+      if ((aSOf(m) - aS < 0.) == (aHf < 0.))
+      {
+        a = m;
+      }
+      else
+      {
+        b = m;
+      }
+    }
+    theU = 0.5 * (a + b);
+    return true;
+  }
+
+  // The place on the cut nearest to thePoint, in theRow (any row when
+  // negative): the nearest sample, then a golden-section search about it.
+  bool Nearest(const gp_Pnt& thePoint,
+               const int     theRow,
+               int&          theFound,
+               double&       theFrac,
+               double&       theT,
+               gp_Pnt&       theP) const
+  {
+    double aBest = RealLast();
+    int    aJ    = 0;
+    theFound     = -1;
+    for (size_t r = 0; r < Faces.size(); ++r)
+    {
+      if (theRow >= 0 && static_cast<int>(r) != theRow)
+      {
+        continue;
+      }
+      for (int j = 0; j <= kNb; ++j)
+      {
+        const size_t i = static_cast<size_t>(j);
+        if (!Has[r][i])
+        {
+          continue;
+        }
+        const double d = P[r][i].Distance(thePoint);
+        if (d < aBest)
+        {
+          aBest    = d;
+          theFound = static_cast<int>(r);
+          aJ       = j;
+        }
+      }
+    }
+    if (theFound < 0)
+    {
+      return false;
+    }
+    double       a     = std::max(0., double(aJ - 1) / kNb);
+    double       b     = std::min(1., double(aJ + 1) / kNb);
+    const double ratio = 0.5 * (std::sqrt(5.) - 1.);
+    const int    aRow  = theFound;
+    const auto   aDist = [this, aRow, &thePoint](const double theF) {
+      double t = 0.;
+      gp_Pnt p;
+      return Cut(aRow, theF, t, p) ? p.Distance(thePoint) : RealLast();
+    };
+    for (int k = 0; k < 100 && b - a > 1.e-13; ++k)
+    {
+      const double c = b - ratio * (b - a);
+      const double d = a + ratio * (b - a);
+      if (aDist(c) < aDist(d))
+      {
+        b = d;
+      }
+      else
+      {
+        a = c;
+      }
+    }
+    for (const double aF : {0.5 * (a + b), a, b, double(aJ) / kNb})
+    {
+      if (Cut(aRow, aF, theT, theP))
+      {
+        theFrac = aF;
+        return true;
+      }
+    }
+    return false;
+  }
+};
+
+// A place on the loop round the section where an edge of the round's cut
+// ends: where the bounds cross the plane (Root), or where a U-edge of
+// either side (or of both) crosses it. Each side's row, fraction, path
+// parameter and point there; the first side's row and fraction are the
+// break's place along the loop.
+struct RoundBreak
+{
+  int           Row[2]    = {0, 0};
+  double        Frac[2]   = {0., 0.};
+  double        T[2]      = {0., 0.};
+  gp_Pnt        P[2];
+  int           UEdge[2]  = {-1, -1};
+  double        UParam[2] = {0., 0.};
+  bool          Root      = false;
+  TopoDS_Vertex Vertex;
+
+  double Lambda() const { return Row[0] + Frac[0]; }
+};
+
+// A place given by a row and a fraction, the fraction below 1.
+void NormalizePlace(const int theNbRows, int& theRow, double& theFrac)
+{
+  if (theFrac >= 1.)
+  {
+    theRow  = (theRow + 1) % theNbRows;
+    theFrac = 0.;
+  }
+}
+
+// The point of a swept face and its derivatives along the section and the
+// path.
+void SweptD1(const SweptFace& theF,
+             const double     theS,
+             const double     theT,
+             gp_Pnt&          theP,
+             gp_Vec&          theDS,
+             gp_Vec&          theDT)
+{
+  if (theF.SectionInU)
+  {
+    theF.Surface->D1(theS, theT, theP, theDS, theDT);
+  }
+  else
+  {
+    theF.Surface->D1(theT, theS, theP, theDT, theDS);
+  }
+}
+
+// Whether theV lies in [theA, theB] (either way round) within a slack.
+bool Within(const double theV, const double theA, const double theB)
+{
+  const double aSlack = 1.e-9 * (1. + std::abs(theB - theA));
+  return theV >= std::min(theA, theB) - aSlack && theV <= std::max(theA, theB) + aSlack;
+}
+
+// Where the line of theA at the section parameter theS (along the path)
+// meets theB's surface: Newton's method from theTA on theA and from
+// (theSB, theTB) on theB. False where it leaves either face's ranges,
+// where the two meet nearly tangentially, and where it does not converge.
+bool Meet(const SweptFace& theA,
+          const double     theS,
+          double&          theTA,
+          const SweptFace& theB,
+          double&          theSB,
+          double&          theTB,
+          gp_Pnt&          theP)
+{
+  double tA = theTA, sB = theSB, tB = theTB;
+  gp_Pnt aPA, aPB;
+  gp_Vec aDAs, aDAt, aDBs, aDBt;
+  for (int k = 0; k < 50; ++k)
+  {
+    SweptD1(theA, theS, tA, aPA, aDAs, aDAt);
+    SweptD1(theB, sB, tB, aPB, aDBs, aDBt);
+    // A(tA + x1) = B(sB + x2, tB + x3), to first order.
+    const gp_Vec aR(aPA, aPB);
+    if (aR.SquareMagnitude() <= 1.e-30)
+    {
+      break;
+    }
+    const gp_Vec aC1    = aDAt;
+    const gp_Vec aC2    = aDBs.Reversed();
+    const gp_Vec aC3    = aDBt.Reversed();
+    const double aDet   = aC1.Dot(aC2.Crossed(aC3));
+    const double aScale = aC1.Magnitude() * aC2.Magnitude() * aC3.Magnitude();
+    if (aScale <= 0. || std::abs(aDet) <= 1.e-6 * aScale)
+    {
+      return false;
+    }
+    const double x1 = aR.Dot(aC2.Crossed(aC3)) / aDet;
+    const double x2 = aC1.Dot(aR.Crossed(aC3)) / aDet;
+    const double x3 = aC1.Dot(aC2.Crossed(aR)) / aDet;
+    tA += x1;
+    sB += x2;
+    tB += x3;
+    if (!Within(tA, theA.T0, theA.T1) || !Within(sB, theB.S0, theB.S1) || !Within(tB, theB.T0, theB.T1))
+    {
+      return false;
+    }
+    if (std::abs(x1) <= 1.e-15 * (1. + std::abs(tA)) && std::abs(x2) <= 1.e-15 * (1. + std::abs(sB))
+        && std::abs(x3) <= 1.e-15 * (1. + std::abs(tB)))
+    {
+      break;
+    }
+  }
+  aPA = theA.Value(theS, tA);
+  aPB = theB.Value(sB, tB);
+  if (aPA.Distance(aPB) > 1.e-2 * Precision::Confusion())
+  {
+    return false;
+  }
+  theTA = tA;
+  theSB = sB;
+  theTB = tB;
+  theP  = gp_Pnt(0.5 * (aPA.XYZ() + aPB.XYZ()));
+  return true;
+}
+
+// The fraction of the face's row at its section parameter, within [0, 1].
+double FracOf(const SweptFace& theF, const double theS)
+{
+  return std::min(1., std::max(0., (theS - theF.From) / (theF.To - theF.From)));
+}
+
+// The parameter of the curve nearest to thePoint within a 256th of its
+// range of theT.
+double ParamNear(const BRepAdaptor_Curve& theC, const double theT, const gp_Pnt& thePoint)
+{
+  const double aF     = theC.FirstParameter();
+  const double aL     = theC.LastParameter();
+  const double aDelta = (aL - aF) / 256.;
+  double       a      = std::max(aF, theT - aDelta);
+  double       b      = std::min(aL, theT + aDelta);
+  const double ratio  = 0.5 * (std::sqrt(5.) - 1.);
+  for (int k = 0; k < 200 && b - a > 1.e-15 * (1. + std::abs(b)); ++k)
+  {
+    const double c = b - ratio * (b - a);
+    const double d = a + ratio * (b - a);
+    if (theC.Value(c).Distance(thePoint) < theC.Value(d).Distance(thePoint))
+    {
+      b = d;
+    }
+    else
+    {
+      a = c;
+    }
+  }
+  return 0.5 * (a + b);
+}
+
+} // namespace
+
+//=======================================================================
+// function : PerformRoundByBisectorPlane
+// purpose  : A rounded corner turns each side's bound about the corner
+//            where it does not reach the bisector plane; where it reaches
+//            past the plane the two sides overlap and are trimmed against
+//            each other. Their intersection there lies in the bisector
+//            plane where the pieces are straight near the corner (the
+//            sides are mirror images in it) and within the bend over the
+//            overlap's depth of it elsewhere. Each side is cut where it
+//            crosses the plane, the two cuts are joined along edges in
+//            their middle, and each bound is kept where it does not reach
+//            the plane. The bounds cross the plane on the axis the round
+//            turns about, into one vertex of both. Refused where the two
+//            cuts lie further apart than 5e-4 of the section's extent, for
+//            a section that is not closed, and where the bounds do not
+//            cross the plane.
+//=======================================================================
+bool BRepFill_TrimShellCorner::PerformRoundByBisectorPlane()
+{
+  // Where it is refused, by the line of this file (traced).
+  const auto aRefuse = [](const int theLine) {
+    if (TracePipeCorners())
+    {
+      std::cerr << "pipe corner: round's cut refused at BRepFill_TrimShellCorner.cxx:" << theLine << std::endl;
+    }
+    return false;
+  };
+  if (myFaces.IsNull() || myUEdges.IsNull() || myBounds.IsNull() || myVEdges.IsNull()
+      || myFaces->RowLength() != 2 || myUEdges->RowLength() != 2 || myBounds->RowLength() != 2
+      || myUEdges->ColLength() != myFaces->ColLength() + 1
+      || myBounds->ColLength() != myFaces->ColLength())
+  {
+    return aRefuse(__LINE__);
+  }
+  const gp_Pln aPlane(myAxeOfBisPlane.Location(), myAxeOfBisPlane.Direction());
+  const int    aRow0    = myFaces->LowerRow();
+  const int    aURow0   = myUEdges->LowerRow();
+  const int    aBRow0   = myBounds->LowerRow();
+  const int    aNbRows  = myFaces->ColLength();
+  const int    aCol[2]  = {myFaces->LowerCol(), myFaces->UpperCol()};
+  const int    aUCol[2] = {myUEdges->LowerCol(), myUEdges->UpperCol()};
+  const int    aBCol[2] = {myBounds->LowerCol(), myBounds->UpperCol()};
+  BRep_Builder aBB;
+  for (int c = 0; c < 2; ++c)
+  {
+    for (int k = 0; k <= aNbRows; ++k)
+    {
+      const TopoDS_Shape& aS = myUEdges->Value(aURow0 + k, aUCol[c]);
+      if (aS.IsNull() || aS.ShapeType() != TopAbs_EDGE)
+      {
+        return aRefuse(__LINE__);
+      }
+    }
+    if (!myUEdges->Value(aURow0, aUCol[c]).IsSame(myUEdges->Value(aURow0 + aNbRows, aUCol[c])))
+    {
+      return aRefuse(__LINE__);
+    }
+  }
+  const auto aUEdge = [&](const int theRow, const int theSide) {
+    return TopoDS::Edge(myUEdges->Value(aURow0 + (theRow % aNbRows), aUCol[theSide]));
+  };
+
+  // Each side: the first runs into the corner along the plane's normal,
+  // the second out of it.
+  RoundSide aSide[2];
+  for (int c = 0; c < 2; ++c)
+  {
+    RoundSide& aS = aSide[c];
+    aS.Plane      = aPlane;
+    aS.Sign       = c == 0 ? 1. : -1.;
+    for (int r = 0; r < aNbRows; ++r)
+    {
+      const TopoDS_Shape& aFace  = myFaces->Value(aRow0 + r, aCol[c]);
+      const TopoDS_Shape& aBound = myBounds->Value(aBRow0 + r, aBCol[c]);
+      SweptFace           aF;
+      if (aFace.IsNull() || aFace.ShapeType() != TopAbs_FACE || aBound.IsNull()
+          || aBound.ShapeType() != TopAbs_EDGE
+          || !aF.Init(TopoDS::Face(aFace), aUEdge(r, c), aUEdge(r + 1, c)))
+      {
+        return aRefuse(__LINE__);
+      }
+      double                          f = 0., l = 0.;
+      const occ::handle<Geom2d_Curve> aC = BRep_Tool::CurveOnSurface(TopoDS::Edge(aBound), aF.Face, f, l);
+      if (aC.IsNull())
+      {
+        return aRefuse(__LINE__);
+      }
+      const gp_Pnt2d aM = aC->Value(0.5 * (f + l));
+      aS.Faces.push_back(aF);
+      aS.Bounds.push_back(TopoDS::Edge(aBound));
+      aS.TB.push_back(aF.SectionInU ? aM.Y() : aM.X());
+    }
+    if (!aS.Behind())
+    {
+      return aRefuse(__LINE__);
+    }
+    aS.Sample();
+  }
+  Bnd_Box aBox;
+  for (int r = 0; r < aNbRows; ++r)
+  {
+    for (int j = 0; j <= RoundSide::kNb; ++j)
+    {
+      aBox.Add(aSide[0].BoundPoint(r, double(j) / RoundSide::kNb));
+    }
+  }
+  if (aBox.IsVoid())
+  {
+    return aRefuse(__LINE__);
+  }
+  const double aMaxGapAllowed = 5.e-4 * std::sqrt(aBox.SquareExtent());
+  double       aMaxGap        = 0.;
+
+  // Where the bounds cross the plane, as many times on both sides.
+  std::vector<std::pair<int, double>> aRoots[2];
+  for (int c = 0; c < 2; ++c)
+  {
+    if (!aSide[c].Roots(aRoots[c]))
+    {
+      return aRefuse(__LINE__);
+    }
+  }
+  if (aRoots[0].empty() || aRoots[0].size() != aRoots[1].size() || aRoots[0].size() % 2 != 0)
+  {
+    return aRefuse(__LINE__);
+  }
+  // Which U-edges reach past the plane.
+  std::vector<char> aInner[2];
+  for (int c = 0; c < 2; ++c)
+  {
+    for (int k = 0; k < aNbRows; ++k)
+    {
+      const bool bAfter  = aSide[c].Past(k, 0.) > 0.;
+      const bool bBefore = aSide[c].Past((k + aNbRows - 1) % aNbRows, 1.) > 0.;
+      if (bAfter != bBefore)
+      {
+        return aRefuse(__LINE__);
+      }
+      aInner[c].push_back(static_cast<char>(bAfter ? 1 : 0));
+    }
+  }
+
+  // The breaks where the bounds cross the plane: each of the first side's
+  // with the second side's nearest.
+  std::vector<RoundBreak> aBreaks;
+  std::vector<char>       aUsed(aRoots[1].size(), 0);
+  for (const std::pair<int, double>& aR : aRoots[0])
+  {
+    RoundBreak aB;
+    aB.Root      = true;
+    aB.Row[0]    = aR.first;
+    aB.Frac[0]   = aR.second;
+    aB.T[0]      = aSide[0].Bound(aR.first);
+    aB.P[0]      = aSide[0].BoundPoint(aR.first, aR.second);
+    size_t aBest = aRoots[1].size();
+    double aD    = RealLast();
+    for (size_t i = 0; i < aRoots[1].size(); ++i)
+    {
+      const double d = aSide[1].BoundPoint(aRoots[1][i].first, aRoots[1][i].second).Distance(aB.P[0]);
+      if (!aUsed[i] && d < aD)
+      {
+        aD    = d;
+        aBest = i;
+      }
+    }
+    if (aBest == aRoots[1].size() || aD > aMaxGapAllowed)
+    {
+      return aRefuse(__LINE__);
+    }
+    aUsed[aBest] = 1;
+    aB.Row[1]    = aRoots[1][aBest].first;
+    aB.Frac[1]   = aRoots[1][aBest].second;
+    aB.T[1]      = aSide[1].Bound(aB.Row[1]);
+    aB.P[1]      = aSide[1].BoundPoint(aB.Row[1], aB.Frac[1]);
+    aBreaks.push_back(aB);
+  }
+
+  // Where the U-edges that reach past the plane cross it, from their ends
+  // at the corner (the first side's U-edges end there, the second's start
+  // there).
+  std::vector<gp_Pnt> aUP[2];
+  std::vector<double> aUT[2];
+  for (int c = 0; c < 2; ++c)
+  {
+    aUP[c].assign(static_cast<size_t>(aNbRows), gp_Pnt());
+    aUT[c].assign(static_cast<size_t>(aNbRows), 0.);
+    for (int k = 0; k < aNbRows; ++k)
+    {
+      if (!aInner[c][static_cast<size_t>(k)])
+      {
+        continue;
+      }
+      const BRepAdaptor_Curve aC(aUEdge(k, c));
+      const auto              aAt     = [&aC](const double theT) { return aC.Value(theT); };
+      const double            aEnd    = c == 0 ? aC.LastParameter() : aC.FirstParameter();
+      const double            aOther  = c == 0 ? aC.FirstParameter() : aC.LastParameter();
+      const gp_Pnt            aCorner = aSide[c].BoundPoint(k, 0.);
+      if (aC.Value(aEnd).Distance(aCorner) > aC.Value(aOther).Distance(aCorner)
+          || !FirstCrossing(aAt,
+                            aEnd,
+                            aOther,
+                            aPlane,
+                            aUT[c][static_cast<size_t>(k)],
+                            aUP[c][static_cast<size_t>(k)]))
+      {
+        return aRefuse(__LINE__);
+      }
+    }
+  }
+  const size_t aNbRootBreaks = aBreaks.size();
+  for (int k = 0; k < aNbRows; ++k)
+  {
+    if (!aInner[0][static_cast<size_t>(k)])
+    {
+      continue;
+    }
+    RoundBreak aB;
+    aB.Row[0]    = k;
+    aB.Frac[0]   = 0.;
+    aB.UEdge[0]  = k;
+    aB.UParam[0] = aUT[0][static_cast<size_t>(k)];
+    aB.P[0]      = aUP[0][static_cast<size_t>(k)];
+    gp_Pnt aP;
+    if (!aSide[0].Cut(k, 0., aB.T[0], aP))
+    {
+      return aRefuse(__LINE__);
+    }
+    aBreaks.push_back(aB);
+  }
+  for (int k = 0; k < aNbRows; ++k)
+  {
+    if (!aInner[1][static_cast<size_t>(k)])
+    {
+      continue;
+    }
+    const gp_Pnt& aQ = aUP[1][static_cast<size_t>(k)];
+    double        aT = 0.;
+    gp_Pnt        aP;
+    if (!aSide[1].Cut(k, 0., aT, aP))
+    {
+      return aRefuse(__LINE__);
+    }
+    size_t aMet = aBreaks.size();
+    for (size_t i = aNbRootBreaks; i < aBreaks.size(); ++i)
+    {
+      const RoundBreak& aB = aBreaks[i];
+      if (aB.UEdge[0] >= 0 && aB.UEdge[1] < 0 && aB.P[0].Distance(aQ) <= aMaxGapAllowed)
+      {
+        aMet = i;
+        break;
+      }
+    }
+    if (aMet == aBreaks.size())
+    {
+      RoundBreak aB;
+      int        aRow = -1;
+      if (!aSide[0].Nearest(aQ, -1, aRow, aB.Frac[0], aB.T[0], aB.P[0]))
+      {
+        return aRefuse(__LINE__);
+      }
+      aB.Row[0] = aRow;
+      NormalizePlace(aNbRows, aB.Row[0], aB.Frac[0]);
+      aBreaks.push_back(aB);
+    }
+    RoundBreak& aB = aBreaks[aMet];
+    aB.Row[1]      = k;
+    aB.Frac[1]     = 0.;
+    aB.T[1]        = aT;
+    aB.P[1]        = aQ;
+    aB.UEdge[1]    = k;
+    aB.UParam[1]   = aUT[1][static_cast<size_t>(k)];
+  }
+  // The first side's U-edges that meet none of the second's: there on its
+  // cut.
+  for (RoundBreak& aB : aBreaks)
+  {
+    if (aB.Root || aB.UEdge[1] >= 0)
+    {
+      continue;
+    }
+    int aRow = -1;
+    if (!aSide[1].Nearest(aB.P[0], -1, aRow, aB.Frac[1], aB.T[1], aB.P[1]))
+    {
+      return aRefuse(__LINE__);
+    }
+    aB.Row[1] = aRow;
+    NormalizePlace(aNbRows, aB.Row[1], aB.Frac[1]);
+  }
+  // The U-edges' breaks moved from the plane to where each U-edge meets
+  // the other side: the two sides' intersection, which lies off the plane
+  // by the bend of the pieces over the overlap's depth. (Where that is not
+  // found, the break stays on the plane.)
+  for (RoundBreak& aB : aBreaks)
+  {
+    for (int c = 0; c < 2; ++c)
+    {
+      if (aB.UEdge[c] < 0)
+      {
+        continue;
+      }
+      const int        o   = 1 - c;
+      const SweptFace& aF  = aSide[c].Face(aB.Row[c]);
+      const SweptFace& aFo = aSide[o].Face(aB.Row[o]);
+      double           aT  = aB.T[c];
+      double           aSo = aFo.Section(aB.Frac[o]);
+      double           aTo = aB.T[o];
+      gp_Pnt           aP;
+      if (!Meet(aF, aF.Section(aB.Frac[c]), aT, aFo, aSo, aTo, aP)
+          || aP.Distance(aB.P[c]) > 10. * aB.P[c].Distance(aB.P[o]) + 10. * Precision::Confusion())
+      {
+        continue;
+      }
+      aB.T[c]      = aT;
+      aB.P[c]      = aP;
+      aB.UParam[c] = ParamNear(BRepAdaptor_Curve(aUEdge(aB.UEdge[c], c)), aB.UParam[c], aP);
+      if (aB.UEdge[o] < 0)
+      {
+        aB.Frac[o] = FracOf(aFo, aSo);
+        aB.T[o]    = aTo;
+        aB.P[o]    = aP;
+        NormalizePlace(aNbRows, aB.Row[o], aB.Frac[o]);
+      }
+    }
+  }
+  std::sort(aBreaks.begin(), aBreaks.end(), [](const RoundBreak& a, const RoundBreak& b) {
+    return a.Lambda() < b.Lambda();
+  });
+  const int aNbBreaks = static_cast<int>(aBreaks.size());
+  for (int b = 0; b < aNbBreaks; ++b)
+  {
+    const double aL0 = aBreaks[static_cast<size_t>(b)].Lambda();
+    double       aL1 = aBreaks[static_cast<size_t>((b + 1) % aNbBreaks)].Lambda();
+    if (aL1 <= aL0)
+    {
+      aL1 += aNbRows;
+    }
+    if (aL1 - aL0 < 1.e-9)
+    {
+      return aRefuse(__LINE__);
+    }
+  }
+
+  // Their vertices: in the middle of the two sides' points.
+  for (RoundBreak& aB : aBreaks)
+  {
+    const double aGap = aB.P[0].Distance(aB.P[1]);
+    aMaxGap           = std::max(aMaxGap, aGap);
+    aBB.MakeVertex(aB.Vertex,
+                   gp_Pnt(0.5 * (aB.P[0].XYZ() + aB.P[1].XYZ())),
+                   0.5 * aGap + Precision::Confusion());
+  }
+
+  // The edges between consecutive breaks where the bounds reach past the
+  // plane, each within one face of either side: through the middles of
+  // the two cuts.
+  struct RoundEdge
+  {
+    TopoDS_Edge Edge;
+    int         Row[2]     = {0, 0};
+    double      Frac[2][2] = {{0., 0.}, {0., 0.}}; // each side's fraction at its ends
+  };
+  std::vector<RoundEdge> aEdges;
+  const int              aNbS = 32;
+  for (int b = 0; b < aNbBreaks; ++b)
+  {
+    const RoundBreak& aB0 = aBreaks[static_cast<size_t>(b)];
+    const RoundBreak& aB1 = aBreaks[static_cast<size_t>((b + 1) % aNbBreaks)];
+    const double      aL0 = aB0.Lambda();
+    double            aL1 = aB1.Lambda();
+    if (aL1 <= aL0)
+    {
+      aL1 += aNbRows;
+    }
+    double aMid = 0.5 * (aL0 + aL1);
+    if (aMid >= aNbRows)
+    {
+      aMid -= aNbRows;
+    }
+    const int aMidRow = std::min(aNbRows - 1, static_cast<int>(std::floor(aMid)));
+    if (aSide[0].Past(aMidRow, aMid - aMidRow) <= 0.)
+    {
+      // The bounds turn about the corner here.
+      if (!aB0.Root || !aB1.Root)
+      {
+        return aRefuse(__LINE__);
+      }
+      continue;
+    }
+    RoundEdge aRE;
+    aRE.Row[0]       = aB0.Row[0];
+    const double aF0 = aB0.Frac[0];
+    if (aF0 + (aL1 - aL0) > 1. + 1.e-9)
+    {
+      return aRefuse(__LINE__);
+    }
+    const double aF1 = std::min(1., aF0 + (aL1 - aL0));
+    // The second side's face: the one nearest to the middle.
+    {
+      double aT = 0., aFrac = 0.;
+      gp_Pnt aP, aQ;
+      int    aRow = -1;
+      if (!aSide[0].Cut(aRE.Row[0], 0.5 * (aF0 + aF1), aT, aP) || !aSide[1].Nearest(aP, -1, aRow, aFrac, aT, aQ))
+      {
+        return aRefuse(__LINE__);
+      }
+      aRE.Row[1] = aRow;
+    }
+    occ::handle<NCollection_HArray1<gp_Pnt>>   aPoints = new NCollection_HArray1<gp_Pnt>(1, aNbS + 1);
+    occ::handle<NCollection_HArray1<double>>   aParams = new NCollection_HArray1<double>(1, aNbS + 1);
+    occ::handle<NCollection_HArray1<gp_Pnt2d>> aUV[2]  = {new NCollection_HArray1<gp_Pnt2d>(1, aNbS + 1),
+                                                          new NCollection_HArray1<gp_Pnt2d>(1, aNbS + 1)};
+    std::vector<double>                        aFrac[2], aT[2];
+    for (int j = 0; j <= aNbS; ++j)
+    {
+      double aFr[2] = {aF0 + (aF1 - aF0) * j / aNbS, 0.};
+      double aTj[2] = {0., 0.};
+      gp_Pnt aP[2];
+      if (j == 0 || j == aNbS)
+      {
+        const RoundBreak& aB = j == 0 ? aB0 : aB1;
+        aTj[0]               = aB.T[0];
+        aTj[1]               = aB.T[1];
+        aP[0]                = aB.P[0];
+        aP[1]                = aB.P[1];
+        if (aB.Row[1] == aRE.Row[1])
+        {
+          aFr[1] = aB.Frac[1];
+        }
+        else if (aB.Row[1] == (aRE.Row[1] + 1) % aNbRows && aB.Frac[1] == 0.)
+        {
+          aFr[1] = 1.;
+        }
+        else
+        {
+          return aRefuse(__LINE__);
+        }
+      }
+      else
+      {
+        int aRow = -1;
+        if (!aSide[0].Cut(aRE.Row[0], aFr[0], aTj[0], aP[0])
+            || !aSide[1].Nearest(aP[0], aRE.Row[1], aRow, aFr[1], aTj[1], aP[1]))
+        {
+          return aRefuse(__LINE__);
+        }
+        // From the plane to the two sides' intersection, along the first
+        // side's line there.
+        const SweptFace& aFace0 = aSide[0].Face(aRE.Row[0]);
+        const SweptFace& aFace1 = aSide[1].Face(aRE.Row[1]);
+        double           aT0   = aTj[0];
+        double           aS1   = aFace1.Section(aFr[1]);
+        double           aT1   = aTj[1];
+        const gp_Pnt     aMid0 = gp_Pnt(0.5 * (aP[0].XYZ() + aP[1].XYZ()));
+        gp_Pnt           aQ;
+        if (Meet(aFace0, aFace0.Section(aFr[0]), aT0, aFace1, aS1, aT1, aQ)
+            && aQ.Distance(aMid0) <= 10. * aP[0].Distance(aP[1]) + 10. * Precision::Confusion())
+        {
+          aTj[0] = aT0;
+          aTj[1] = aT1;
+          aFr[1] = FracOf(aFace1, aS1);
+          aP[0]  = aQ;
+          aP[1]  = aQ;
+        }
+      }
+      aMaxGap = std::max(aMaxGap, aP[0].Distance(aP[1]));
+      for (int c = 0; c < 2; ++c)
+      {
+        aFrac[c].push_back(aFr[c]);
+        aT[c].push_back(aTj[c]);
+      }
+      gp_Pnt aM(0.5 * (aP[0].XYZ() + aP[1].XYZ()));
+      if (j == 0)
+      {
+        aM = BRep_Tool::Pnt(aB0.Vertex);
+      }
+      else if (j == aNbS)
+      {
+        aM = BRep_Tool::Pnt(aB1.Vertex);
+      }
+      aPoints->SetValue(j + 1, aM);
+      aParams->SetValue(j + 1, double(j) / aNbS);
+    }
+    // An end on the seam of a closed section's face is at the side of the
+    // seam the edge comes from.
+    std::vector<double>& aF2 = aFrac[1];
+    for (const size_t i : {size_t(0), size_t(aNbS)})
+    {
+      const size_t aNext = i == 0 ? 1 : i - 1;
+      if ((aF2[i] == 0. || aF2[i] == 1.) && std::abs(aF2[i] - aF2[aNext]) > 0.5)
+      {
+        aF2[i] = 1. - aF2[i];
+      }
+    }
+    for (int c = 0; c < 2; ++c)
+    {
+      const SweptFace& aF = aSide[c].Face(aRE.Row[c]);
+      for (int j = 0; j <= aNbS; ++j)
+      {
+        const size_t i = static_cast<size_t>(j);
+        aUV[c]->SetValue(j + 1, aF.UV(aF.Section(aFrac[c][i]), aT[c][i]));
+      }
+      aRE.Frac[c][0] = aFrac[c].front();
+      aRE.Frac[c][1] = aFrac[c].back();
+    }
+    GeomAPI_Interpolate aI3d(aPoints, aParams, false, Precision::Confusion());
+    aI3d.Perform();
+    if (!aI3d.IsDone())
+    {
+      return aRefuse(__LINE__);
+    }
+    TopoDS_Edge aE;
+    aBB.MakeEdge(aE, occ::handle<Geom_Curve>(aI3d.Curve()), Precision::Confusion());
+    for (int c = 0; c < 2; ++c)
+    {
+      Geom2dAPI_Interpolate aI2d(aUV[c], aParams, false, Precision::PConfusion());
+      aI2d.Perform();
+      if (!aI2d.IsDone())
+      {
+        return aRefuse(__LINE__);
+      }
+      aBB.UpdateEdge(aE,
+                     occ::handle<Geom2d_Curve>(aI2d.Curve()),
+                     aSide[c].Face(aRE.Row[c]).Face,
+                     Precision::Confusion());
+    }
+    aBB.Range(aE, 0., 1.);
+    aBB.Add(aE, aB0.Vertex.Oriented(TopAbs_FORWARD));
+    aBB.Add(aE, aB1.Vertex.Oriented(TopAbs_REVERSED));
+    aBB.SameParameter(aE, false);
+    BRepLib::SameParameter(aE, Precision::Confusion(), true);
+    const double aTolE = BRep_Tool::Tolerance(aE);
+    for (const TopoDS_Vertex& aV : {aB0.Vertex, aB1.Vertex})
+    {
+      if (BRep_Tool::Tolerance(aV) < aTolE)
+      {
+        aBB.UpdateVertex(aV, aTolE);
+      }
+    }
+    aRE.Edge = aE;
+    aEdges.push_back(aRE);
+  }
+
+  // No cut, or the two cuts apart by more than allowed: the edges would
+  // not join them.
+  if (TracePipeCorners())
+  {
+    std::cerr << "pipe corner: round's cut: " << aRoots[0].size() << " crossing(s) of the bounds, "
+              << aNbBreaks << " break(s), " << aEdges.size() << " edge(s), the two sides " << aMaxGap
+              << " apart at most (" << aMaxGapAllowed << " allowed)" << std::endl;
+  }
+  if (aEdges.empty() || aMaxGap > aMaxGapAllowed)
+  {
+    return aRefuse(__LINE__);
+  }
+
+  // The U-edges up to the break (the first side) and from it (the second),
+  // as SplitUEdges makes them.
+  NCollection_Array2<TopoDS_Shape> aNewU(0, aNbRows - 1, 0, 1);
+  for (const RoundBreak& aB : aBreaks)
+  {
+    for (int c = 0; c < 2; ++c)
+    {
+      if (aB.UEdge[c] < 0)
+      {
+        continue;
+      }
+      const TopoDS_Edge& aE = aUEdge(aB.UEdge[c], c);
+      TopoDS_Vertex      aV1, aV2;
+      TopExp::Vertices(aE, aV1, aV2);
+      double f = 0., l = 0.;
+      BRep_Tool::Range(aE, f, l);
+      TopoDS_Edge aNew = TopoDS::Edge(aE.EmptyCopied());
+      aNew.Orientation(TopAbs_FORWARD);
+      if (c == 0)
+      {
+        aBB.Add(aNew, aV1.Oriented(TopAbs_FORWARD));
+        aBB.Add(aNew, aB.Vertex.Oriented(TopAbs_REVERSED));
+        aBB.Range(aNew, f, aB.UParam[0]);
+      }
+      else
+      {
+        aBB.Add(aNew, aB.Vertex.Oriented(TopAbs_FORWARD));
+        aBB.Add(aNew, aV2.Oriented(TopAbs_REVERSED));
+        aBB.Range(aNew, aB.UParam[1], l);
+      }
+      // The break's vertex covers the U-edge's end there.
+      const double d = BRepAdaptor_Curve(aE).Value(aB.UParam[c]).Distance(BRep_Tool::Pnt(aB.Vertex));
+      if (d > BRep_Tool::Tolerance(aB.Vertex))
+      {
+        aBB.UpdateVertex(aB.Vertex, d);
+      }
+      aNewU(aB.UEdge[c], c) = aNew;
+    }
+  }
+
+  // Each face whose bound reaches the plane: its bound replaced by the
+  // wire of the bound's pieces before the plane and the edges of the cut,
+  // running the way the bound runs, and its U-edges by the new ones. The
+  // round turns the pieces, which keep the bound's curve.
+  for (int c = 0; c < 2; ++c)
+  {
+    for (int r = 0; r < aNbRows; ++r)
+    {
+      std::vector<std::pair<double, TopoDS_Shape>> aOwn;
+      for (const RoundEdge& aRE : aEdges)
+      {
+        if (aRE.Row[c] != r)
+        {
+          continue;
+        }
+        double aU0 = 0., aU1 = 0.;
+        if (!aSide[c].BoundParam(r, aRE.Frac[c][0], aU0) || !aSide[c].BoundParam(r, aRE.Frac[c][1], aU1))
+        {
+          return aRefuse(__LINE__);
+        }
+        aOwn.emplace_back(std::min(aU0, aU1), aRE.Edge.Oriented(aU0 <= aU1 ? TopAbs_FORWARD : TopAbs_REVERSED));
+      }
+      // The places along the row where the bound crosses the plane.
+      std::vector<std::pair<double, int>> aAlong;
+      for (int i = 0; i < aNbBreaks; ++i)
+      {
+        const RoundBreak& aB = aBreaks[static_cast<size_t>(i)];
+        if (aB.Root && aB.Row[c] == r)
+        {
+          aAlong.emplace_back(aB.Frac[c], i);
+        }
+      }
+      if (aOwn.empty() && aAlong.empty() && aNewU(r, c).IsNull() && aNewU((r + 1) % aNbRows, c).IsNull())
+      {
+        continue;
+      }
+      aAlong.emplace_back(0., -1);
+      aAlong.emplace_back(1., -1);
+      std::sort(aAlong.begin(), aAlong.end());
+      const TopoDS_Edge&      aBound = aSide[c].Bounds[static_cast<size_t>(r)];
+      const BRepAdaptor_Curve aBoundCurve(aBound);
+      TopoDS_Vertex           aBV1, aBV2;
+      TopExp::Vertices(aBound, aBV1, aBV2);
+      double aBf = 0., aBl = 0.;
+      BRep_Tool::Range(aBound, aBf, aBl);
+      for (size_t i = 0; i + 1 < aAlong.size(); ++i)
+      {
+        const double aFa = aAlong[i].first, aFb = aAlong[i + 1].first;
+        if (aFb - aFa <= 0. || aSide[c].Past(r, 0.5 * (aFa + aFb)) > 0.)
+        {
+          continue;
+        }
+        double        aU[2] = {0., 0.};
+        TopoDS_Vertex aV[2];
+        for (int e = 0; e < 2; ++e)
+        {
+          const std::pair<double, int>& aEnd = aAlong[i + static_cast<size_t>(e)];
+          if (!aSide[c].BoundParam(r, aEnd.first, aU[e]))
+          {
+            return aRefuse(__LINE__);
+          }
+          if (aEnd.second >= 0)
+          {
+            aV[e] = aBreaks[static_cast<size_t>(aEnd.second)].Vertex;
+            // The vertex covers the bound's end there.
+            const double d = aBoundCurve.Value(aU[e]).Distance(BRep_Tool::Pnt(aV[e]));
+            if (d > BRep_Tool::Tolerance(aV[e]))
+            {
+              aBB.UpdateVertex(aV[e], d);
+            }
+          }
+          else
+          {
+            aV[e] = std::abs(aU[e] - aBf) <= std::abs(aU[e] - aBl) ? aBV1 : aBV2;
+          }
+        }
+        if (aU[0] > aU[1])
+        {
+          std::swap(aU[0], aU[1]);
+          std::swap(aV[0], aV[1]);
+        }
+        TopoDS_Edge aPiece = TopoDS::Edge(aBound.Oriented(TopAbs_FORWARD).EmptyCopied());
+        aPiece.Orientation(TopAbs_FORWARD);
+        aBB.Add(aPiece, aV[0].Oriented(TopAbs_FORWARD));
+        aBB.Add(aPiece, aV[1].Oriented(TopAbs_REVERSED));
+        aBB.Range(aPiece, aU[0], aU[1]);
+        aOwn.emplace_back(aU[0], aPiece);
+      }
+      if (aOwn.empty())
+      {
+        return aRefuse(__LINE__);
+      }
+      std::sort(aOwn.begin(),
+                aOwn.end(),
+                [](const std::pair<double, TopoDS_Shape>& a, const std::pair<double, TopoDS_Shape>& b) {
+                  return a.first < b.first;
+                });
+      TopoDS_Wire aW;
+      aBB.MakeWire(aW);
+      for (const std::pair<double, TopoDS_Shape>& aE : aOwn)
+      {
+        aBB.Add(aW, aE.second);
+      }
+
+      occ::handle<BRepTools_ReShape> aSubstitutor = new BRepTools_ReShape();
+      aSubstitutor->Replace(aBound.Oriented(TopAbs_FORWARD), aW);
+      for (const int k : {r, (r + 1) % aNbRows})
+      {
+        if (!aNewU(k, c).IsNull())
+        {
+          aSubstitutor->Replace(aUEdge(k, c).Oriented(TopAbs_FORWARD), aNewU(k, c).Oriented(TopAbs_FORWARD));
+        }
+      }
+      const TopoDS_Shape& aFace    = myFaces->Value(aRow0 + r, aCol[c]);
+      TopoDS_Shape        aNewFace = aSubstitutor->Apply(aFace);
+      aNewFace.Orientation(aFace.Orientation());
+      NCollection_List<TopoDS_Shape> aL;
+      aL.Append(aNewFace);
+      myHistMap.Bind(aFace, aL);
+      for (TopExp_Explorer anExpE(aFace, TopAbs_EDGE); anExpE.More(); anExpE.Next())
+      {
+        const TopoDS_Shape aNewValue = aSubstitutor->Value(anExpE.Current());
+        if (aNewValue.IsNull() || aNewValue.IsSame(anExpE.Current()) || myHistMap.IsBound(anExpE.Current()))
+        {
+          continue;
+        }
+        NCollection_List<TopoDS_Shape> aLE;
+        for (TopExp_Explorer anExpE2(aNewValue, TopAbs_EDGE); anExpE2.More(); anExpE2.Next())
+        {
+          aLE.Append(anExpE2.Current());
+        }
+        myHistMap.Bind(anExpE.Current(), aLE);
+      }
+    }
+  }
+
+  // The corner's V-edges: the edges of the second side's cut.
+  for (int r = 0; r < aNbRows; ++r)
+  {
+    const TopoDS_Shape& aV = myVEdges->Value(aRow0 + r);
+    if (aV.IsNull() || myHistMap.IsBound(aV))
+    {
+      continue;
+    }
+    NCollection_List<TopoDS_Shape> aL;
+    for (const RoundEdge& aRE : aEdges)
+    {
+      if (aRE.Row[1] == r)
+      {
+        aL.Append(aRE.Edge);
+      }
+    }
+    if (!aL.IsEmpty())
+    {
+      myHistMap.Bind(aV, aL);
+    }
+  }
+  return true;
+}
