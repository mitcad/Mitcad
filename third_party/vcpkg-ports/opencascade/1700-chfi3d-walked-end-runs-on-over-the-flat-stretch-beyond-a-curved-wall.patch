+// (Here, not with the file's other headers: the port's later patches add
+// theirs there.)
+#include <Geom_BezierCurve.hxx>
+#include <GeomConvert_BSplineCurveToBezierCurve.hxx>
+
+//=======================================================================
+// function : ChFi3d_RunOnSurface
+// purpose  : The surface a walk runs on over past the edges of face N
+//            (WalkedCutToEnd: N's surface unbounded) where N is an
+//            extrusion whose basis curve ends at an edge J of N across
+//            which a plane N2 (neither Fo nor B) goes on tangentially to N:
+//            a side wall bending into a flat stretch along the spine (N2
+//            checked to hold J's tangent line, within Tol). The basis
+//            curve is continued past J by the polynomial of its span at J,
+//            N's parameters kept on N: the curved wall's own surface run on
+//            past J, which bends in from N2's plane as the curve went on
+//            bending, as the bodies stored in reported designs run such a
+//            rounding on (mitcad#1987; N2's plane, 1700 at first, left
+//            the rounding up to 0.45 mm out at the stretch's far end). The
+//            continuation is a span of its own, its domain open (the walk
+//            stops at N's natural bounds), as long as its tangent stays
+//            within 45 degrees of J's. Null where N is not so.
+//=======================================================================
+
+static occ::handle<Geom_Surface> ChFi3d_RunOnSurface(const TopoDS_Face& N,
+                                                     const TopoDS_Face& Fo,
+                                                     const TopoDS_Face& B,
+                                                     const ChFiDS_Map&  EFMap,
+                                                     const double       Length,
+                                                     const double       Tol,
+                                                     TopoDS_Face&       Flat)
+{
+  occ::handle<Geom_Surface> S = BRep_Tool::Surface(N);
+  if (S.IsNull())
+  {
+    return nullptr;
+  }
+  const occ::handle<Geom_RectangularTrimmedSurface> aTrimmed = occ::down_cast<Geom_RectangularTrimmedSurface>(S);
+  if (!aTrimmed.IsNull())
+  {
+    S = aTrimmed->BasisSurface();
+  }
+  const occ::handle<Geom_SurfaceOfLinearExtrusion> anExt = occ::down_cast<Geom_SurfaceOfLinearExtrusion>(S);
+  if (anExt.IsNull() || anExt->BasisCurve().IsNull())
+  {
+    return nullptr;
+  }
+  const occ::handle<Geom_BSplineCurve> C = GeomConvert::CurveToBSplineCurve(anExt->BasisCurve());
+  if (C.IsNull() || C->IsPeriodic() || C->IsRational())
+  {
+    return nullptr;
+  }
+  TopoDS_Face NF = N;
+  NF.Orientation(TopAbs_FORWARD);
+  for (TopExp_Explorer ex(NF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& J = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(J) || !EFMap.Contains(J))
+    {
+      continue;
+    }
+    TopoDS_Face N2;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(J)); it.More(); it.Next())
+    {
+      if (!it.Value().IsSame(N))
+      {
+        N2 = TopoDS::Face(it.Value());
+      }
+    }
+    if (N2.IsNull() || N2.IsSame(Fo) || N2.IsSame(B) || !ChFi3d::IsTangentFaces(J, N, N2))
+    {
+      continue;
+    }
+    const BRepAdaptor_Surface aPlane(N2, false);
+    if (aPlane.GetType() != GeomAbs_Plane)
+    {
+      continue;
+    }
+    // J runs along the extrusion at one end of the basis curve on N.
+    double                          f = 0., l = 0.;
+    const occ::handle<Geom2d_Curve> pc = BRep_Tool::CurveOnSurface(J, NF, f, l);
+    if (pc.IsNull())
+    {
+      continue;
+    }
+    const double uJ = pc->Value(f).X();
+    if (std::abs(pc->Value(l).X() - uJ) > Precision::PConfusion())
+    {
+      continue;
+    }
+    const double u0 = C->FirstParameter(), u1 = C->LastParameter();
+    if (uJ < u0 - Precision::PConfusion() || uJ > u1 + Precision::PConfusion())
+    {
+      continue;
+    }
+    const bool after = uJ - u0 > u1 - uJ;
+    occ::handle<Geom_BSplineCurve> Cs = occ::down_cast<Geom_BSplineCurve>(C->Copy());
+    if (after ? uJ < u1 - Precision::PConfusion() : uJ > u0 + Precision::PConfusion())
+    {
+      Cs->Segment(after ? u0 : uJ, after ? uJ : u1);
+    }
+    const int    p  = Cs->Degree();
+    const double uE = after ? Cs->LastParameter() : Cs->FirstParameter();
+    gp_Pnt       PJ;
+    gp_Vec       DJ;
+    Cs->D1(uE, PJ, DJ);
+    if (DJ.Magnitude() <= gp::Resolution())
+    {
+      continue;
+    }
+    // (N2's plane holds J's tangent line: the stretch goes on flat past J.)
+    const gp_Pln   aPln = aPlane.Plane();
+    const gp_Dir   aDir = anExt->Direction();
+    const gp_Pnt   PJ1  = PJ.Translated(gp_Vec(aDir));
+    const gp_Vec   aTJ  = DJ.Normalized() * (after ? 1. : -1.);
+    bool           onN2 = aPln.Distance(PJ) <= Tol && aPln.Distance(PJ1) <= Tol;
+    for (int i = 1; i <= 4 && onN2; i++)
+    {
+      const gp_Vec aStep = aTJ * (Length * i / 4.);
+      onN2 = aPln.Distance(PJ.Translated(aStep)) <= Tol && aPln.Distance(PJ1.Translated(aStep)) <= Tol;
+    }
+    if (!onN2)
+    {
+      continue;
+    }
+    // Cs's span at J (aSpanLength long) as a Bezier curve on [0, 1],
+    // continued by its polynomial over dU past J: as long as its tangent
+    // stays within 45 degrees of J's and away from zero, at most Length long.
+    GeomConvert_BSplineCurveToBezierCurve aToArcs(Cs);
+    const int                             nArcs = aToArcs.NbArcs();
+    if (nArcs < 1)
+    {
+      continue;
+    }
+    NCollection_Array1<double> anArcKnots(1, nArcs + 1);
+    aToArcs.Knots(anArcKnots);
+    const occ::handle<Geom_BezierCurve> aSpan = aToArcs.Arc(after ? nArcs : 1);
+    const double aSpanLength = after ? anArcKnots(nArcs + 1) - anArcKnots(nArcs) : anArcKnots(2) - anArcKnots(1);
+    if (aSpan.IsNull() || aSpan->Degree() != p || aSpan->IsRational() || aSpanLength <= Precision::PConfusion())
+    {
+      continue;
+    }
+    // (On the segment's [0, 1] the derivative is the curve's times dU.)
+    occ::handle<Geom_BezierCurve> aMore;
+    double                        dU = Length / DJ.Magnitude();
+    for (int k = 0; k < 40; k++)
+    {
+      const occ::handle<Geom_BezierCurve> aTry = occ::down_cast<Geom_BezierCurve>(aSpan->Copy());
+      const double                        aS   = dU / aSpanLength;
+      aTry->Segment(after ? 1. : -aS, after ? 1. + aS : 0.);
+      bool aTurns = false;
+      for (int i = 0; i <= 8 && !aTurns; i++)
+      {
+        const gp_Vec aT = aTry->DN(i / 8., 1);
+        aTurns          = aT.Magnitude() < 0.1 * DJ.Magnitude() * dU || aT.Angle(DJ) > M_PI / 4.;
+      }
+      if (!aTurns)
+      {
+        aMore = aTry;
+        break;
+      }
+      dU *= 0.8;
+    }
+    if (aMore.IsNull())
+    {
+      continue;
+    }
+    const int                  nPoles = Cs->NbPoles();
+    const int                  nKnots = Cs->NbKnots();
+    NCollection_Array1<gp_Pnt> aPoles(1, nPoles + p);
+    NCollection_Array1<double> aKnots(1, nKnots + 1);
+    NCollection_Array1<int>    aMults(1, nKnots + 1);
+    if (after)
+    {
+      for (int i = 1; i <= nPoles; i++)
+      {
+        aPoles(i) = Cs->Pole(i);
+      }
+      for (int i = 1; i <= p; i++)
+      {
+        aPoles(nPoles + i) = aMore->Pole(i + 1);
+      }
+      for (int i = 1; i <= nKnots; i++)
+      {
+        aKnots(i) = Cs->Knot(i);
+        aMults(i) = Cs->Multiplicity(i);
+      }
+      aMults(nKnots)     = p;
+      aKnots(nKnots + 1) = uE + dU;
+      aMults(nKnots + 1) = p + 1;
+    }
+    else
+    {
+      for (int i = 1; i <= p; i++)
+      {
+        aPoles(i) = aMore->Pole(i);
+      }
+      for (int i = 1; i <= nPoles; i++)
+      {
+        aPoles(p + i) = Cs->Pole(i);
+      }
+      aKnots(1) = uE - dU;
+      aMults(1) = p + 1;
+      for (int i = 1; i <= nKnots; i++)
+      {
+        aKnots(i + 1) = Cs->Knot(i);
+        aMults(i + 1) = Cs->Multiplicity(i);
+      }
+      aMults(2) = p;
+    }
+    occ::handle<Geom_BSplineCurve> aLonger;
+    try
+    {
+      OCC_CATCH_SIGNALS
+      aLonger = new Geom_BSplineCurve(aPoles, aKnots, aMults, p);
+    }
+    catch (Standard_Failure const& anException)
+    {
+      // (Only OCCT's reports that this cannot be computed fail this step, mitcad#1986.)
+      if (!ChFi3d_IsComputationFailure(anException))
+      {
+        throw;
+      }
+      continue;
+    }
+    // (J's knot gone where it can be: the span at J and its continuation are
+    // one polynomial.)
+    aLonger->RemoveKnot(after ? nKnots : 2, 0, Precision::Confusion());
+    const occ::handle<Geom_Surface> aRun = new Geom_SurfaceOfLinearExtrusion(aLonger, aDir);
+    // (On N as N is, and past J the span's polynomial.)
+    const double uM = 0.5 * (Cs->FirstParameter() + Cs->LastParameter());
+    const double uX = after ? uE + 0.5 * dU : uE - 0.5 * dU;
+    if (aRun->Value(uM, 0.).Distance(anExt->Value(uM, 0.)) > Tol
+        || aRun->Value(uX, 0.).Distance(aMore->Value(0.5)) > Tol)
+    {
+      continue;
+    }
+    Flat = N2;
+    return aRun;
+  }
+  return nullptr;
+}
