+//=======================================================================
+// function : ChFi3d_RunOnSurface
+// purpose  : The surface a walk runs on over past the edges of face N
+//            (WalkedCutToEnd: N's surface unbounded) where N is an
+//            extrusion whose basis curve ends at an edge J of N across
+//            which a plane N2 (neither Fo nor B) goes on tangentially to N:
+//            a side wall bending into a flat stretch along the spine. The
+//            basis curve is continued past J by its tangent line, N's
+//            parameters kept on N, so that past J the surface is N2's plane
+//            (checked within Tol) and not the curve's polynomial
+//            extrapolation, which bends away from N2. Null where N is not
+//            so.
+//=======================================================================
+
+static occ::handle<Geom_Surface> ChFi3d_RunOnSurface(const TopoDS_Face& N,
+                                                     const TopoDS_Face& Fo,
+                                                     const TopoDS_Face& B,
+                                                     const ChFiDS_Map&  EFMap,
+                                                     const double       Length,
+                                                     const double       Tol,
+                                                     TopoDS_Face&       Flat)
+{
+  occ::handle<Geom_Surface> S = BRep_Tool::Surface(N);
+  if (S.IsNull())
+  {
+    return nullptr;
+  }
+  const occ::handle<Geom_RectangularTrimmedSurface> aTrimmed = occ::down_cast<Geom_RectangularTrimmedSurface>(S);
+  if (!aTrimmed.IsNull())
+  {
+    S = aTrimmed->BasisSurface();
+  }
+  const occ::handle<Geom_SurfaceOfLinearExtrusion> anExt = occ::down_cast<Geom_SurfaceOfLinearExtrusion>(S);
+  if (anExt.IsNull() || anExt->BasisCurve().IsNull())
+  {
+    return nullptr;
+  }
+  const occ::handle<Geom_BSplineCurve> C = GeomConvert::CurveToBSplineCurve(anExt->BasisCurve());
+  if (C.IsNull() || C->IsPeriodic() || C->IsRational())
+  {
+    return nullptr;
+  }
+  TopoDS_Face NF = N;
+  NF.Orientation(TopAbs_FORWARD);
+  for (TopExp_Explorer ex(NF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& J = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(J) || !EFMap.Contains(J))
+    {
+      continue;
+    }
+    TopoDS_Face N2;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(J)); it.More(); it.Next())
+    {
+      if (!it.Value().IsSame(N))
+      {
+        N2 = TopoDS::Face(it.Value());
+      }
+    }
+    if (N2.IsNull() || N2.IsSame(Fo) || N2.IsSame(B) || !ChFi3d::IsTangentFaces(J, N, N2))
+    {
+      continue;
+    }
+    const BRepAdaptor_Surface aPlane(N2, false);
+    if (aPlane.GetType() != GeomAbs_Plane)
+    {
+      continue;
+    }
+    // J runs along the extrusion at one end of the basis curve on N.
+    double                          f = 0., l = 0.;
+    const occ::handle<Geom2d_Curve> pc = BRep_Tool::CurveOnSurface(J, NF, f, l);
+    if (pc.IsNull())
+    {
+      continue;
+    }
+    const double uJ = pc->Value(f).X();
+    if (std::abs(pc->Value(l).X() - uJ) > Precision::PConfusion())
+    {
+      continue;
+    }
+    const double u0 = C->FirstParameter(), u1 = C->LastParameter();
+    if (uJ < u0 - Precision::PConfusion() || uJ > u1 + Precision::PConfusion())
+    {
+      continue;
+    }
+    const bool after = uJ - u0 > u1 - uJ;
+    occ::handle<Geom_BSplineCurve> Cs = occ::down_cast<Geom_BSplineCurve>(C->Copy());
+    if (after ? uJ < u1 - Precision::PConfusion() : uJ > u0 + Precision::PConfusion())
+    {
+      Cs->Segment(after ? u0 : uJ, after ? uJ : u1);
+    }
+    // The tangent line past J, as a span of the same degree with its poles
+    // evenly along the line (the line exactly, C1 at J), the curve's own
+    // spans unchanged (J's knot of multiplicity p).
+    const int    p  = Cs->Degree();
+    const double uE = after ? Cs->LastParameter() : Cs->FirstParameter();
+    gp_Pnt       PJ;
+    gp_Vec       DJ;
+    Cs->D1(uE, PJ, DJ);
+    if (DJ.Magnitude() <= gp::Resolution())
+    {
+      continue;
+    }
+    const double dU     = Length / DJ.Magnitude();
+    const int    nPoles = Cs->NbPoles();
+    const int    nKnots = Cs->NbKnots();
+    NCollection_Array1<gp_Pnt> aPoles(1, nPoles + p);
+    NCollection_Array1<double> aKnots(1, nKnots + 1);
+    NCollection_Array1<int>    aMults(1, nKnots + 1);
+    if (after)
+    {
+      for (int i = 1; i <= nPoles; i++)
+      {
+        aPoles(i) = Cs->Pole(i);
+      }
+      for (int i = 1; i <= p; i++)
+      {
+        aPoles(nPoles + i) = PJ.Translated(DJ * (dU * i / p));
+      }
+      for (int i = 1; i <= nKnots; i++)
+      {
+        aKnots(i) = Cs->Knot(i);
+        aMults(i) = Cs->Multiplicity(i);
+      }
+      aMults(nKnots)     = p;
+      aKnots(nKnots + 1) = uE + dU;
+      aMults(nKnots + 1) = p + 1;
+    }
+    else
+    {
+      for (int i = 1; i <= p; i++)
+      {
+        aPoles(i) = PJ.Translated(DJ * (-dU * (p + 1 - i) / p));
+      }
+      for (int i = 1; i <= nPoles; i++)
+      {
+        aPoles(p + i) = Cs->Pole(i);
+      }
+      aKnots(1) = uE - dU;
+      aMults(1) = p + 1;
+      for (int i = 1; i <= nKnots; i++)
+      {
+        aKnots(i + 1) = Cs->Knot(i);
+        aMults(i + 1) = Cs->Multiplicity(i);
+      }
+      aMults(2) = p;
+    }
+    occ::handle<Geom_BSplineCurve> aLonger;
+    try
+    {
+      OCC_CATCH_SIGNALS
+      aLonger = new Geom_BSplineCurve(aPoles, aKnots, aMults, p);
+    }
+    catch (Standard_Failure const&)
+    {
+      continue;
+    }
+    const occ::handle<Geom_Surface> aRun = new Geom_SurfaceOfLinearExtrusion(aLonger, anExt->Direction());
+    // (Past J on N2's plane, and on N as N is.)
+    const gp_Pln aPln  = aPlane.Plane();
+    bool         onN2  = true;
+    for (int i = 1; i <= 4 && onN2; i++)
+    {
+      const double u = after ? uE + dU * i / 4. : uE - dU * i / 4.;
+      onN2           = aPln.Distance(aRun->Value(u, 0.)) <= Tol && aPln.Distance(aRun->Value(u, 1.)) <= Tol;
+    }
+    const double uM = 0.5 * (Cs->FirstParameter() + Cs->LastParameter());
+    if (!onN2 || aRun->Value(uM, 0.).Distance(anExt->Value(uM, 0.)) > Tol)
+    {
+      continue;
+    }
+    Flat = N2;
+    return aRun;
+  }
+  return nullptr;
+}
