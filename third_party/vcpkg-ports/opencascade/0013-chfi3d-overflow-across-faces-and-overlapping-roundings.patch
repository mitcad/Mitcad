+NCollection_List<occ::handle<ChFiDS_Stripe>> ChFi3d_Builder::OverlappingStripes()
+{
+  NCollection_List<occ::handle<ChFiDS_Stripe>> again;
+  const TopOpeBRepDS_DataStructure&            DStr = myDS->DS();
+  const double                                 tol  = 10. * tolapp3d;
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itA(myListStripe); itA.More();
+       itA.Next())
+  {
+    const occ::handle<ChFiDS_Stripe>& A = itA.Value();
+    NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itB = itA;
+    for (itB.Next(); itB.More(); itB.Next())
+    {
+      const occ::handle<ChFiDS_Stripe>& B = itB.Value();
+      if (A->SetOfSurfData().IsNull() || B->SetOfSurfData().IsNull())
+      {
+        continue;
+      }
+      bool found = false;
+      for (int i = 1; i <= A->SetOfSurfData()->Length() && !found; i++)
+      {
+        const occ::handle<ChFiDS_SurfData>& a = A->SetOfSurfData()->Value(i);
+        for (int j = 1; j <= B->SetOfSurfData()->Length() && !found; j++)
+        {
+          const occ::handle<ChFiDS_SurfData>& b = B->SetOfSurfData()->Value(j);
+          for (int ka = 1; ka <= 2 && !found; ka++)
+          {
+            for (int kb = 1; kb <= 2 && !found; kb++)
+            {
+              if (a->Index(ka) <= 0 || a->Index(ka) != b->Index(kb)
+                  || a->IsOnCurve(ka) || b->IsOnCurve(kb))
+              {
+                continue;
+              }
+              const TopoDS_Face F  = TopoDS::Face(DStr.Shape(a->Index(ka)));
+              const TopoDS_Edge EA = spineEdgeOf(A->Spine(), F);
+              const TopoDS_Edge EB = spineEdgeOf(B->Spine(), F);
+              if (EA.IsNull() || EB.IsNull() || EA.IsSame(EB))
+              {
+                continue;
+              }
+              if (contactBeyond(DStr, a, ka, b, kb, EB, tol)
+                  && contactBeyond(DStr, b, kb, a, ka, EA, tol))
+              {
+                found = true;
+                myOverlapStripes.Append(A);
+                myOverlapFaces.Append(F);
+                myOverlapEdges.Append(EB);
+                myOverlapStripes.Append(B);
+                myOverlapFaces.Append(F);
+                myOverlapEdges.Append(EA);
+              }
+            }
+          }
+        }
+      }
+      if (found)
+      {
+        if (!again.Contains(A))
+        {
+          again.Append(A);
+        }
+        if (!again.Contains(B))
+        {
+          again.Append(B);
+        }
+      }
+    }
+  }
+  return again;
+}
+
+TopoDS_Edge ChFi3d_Builder::OverlapEdge(const occ::handle<ChFiDS_Stripe>& S,
+                                        const TopoDS_Face&                F) const
+{
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itS(myOverlapStripes);
+  NCollection_List<TopoDS_Shape>::Iterator               itF(myOverlapFaces);
+  NCollection_List<TopoDS_Shape>::Iterator               itE(myOverlapEdges);
+  for (; itS.More(); itS.Next(), itF.Next(), itE.Next())
+  {
+    if (itS.Value() == S && itF.Value().IsSame(F))
+    {
+      return TopoDS::Edge(itE.Value());
+    }
+  }
+  return TopoDS_Edge();
+}
