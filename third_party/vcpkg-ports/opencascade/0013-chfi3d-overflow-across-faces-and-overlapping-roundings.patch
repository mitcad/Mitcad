+// The parameter of point P projected on curve C, and its distance.
+static double projectOn(const occ::handle<Geom_Curve>& C, const gp_Pnt& P, double& Dist)
+{
+  GeomAPI_ProjectPointOnCurve proj(P, C);
+  if (proj.NbPoints() == 0)
+  {
+    Dist = RealLast();
+    return 0.;
+  }
+  Dist = proj.LowerDistance();
+  return proj.LowerDistanceParameter();
+}
+
+// Whether the contact of SurfData B on its side onB lies on the contact of
+// SurfData A on its side onA: B's contact curve, sampled between its end
+// points, lies on A's curve between A's end points (within Tol).
+static bool sameContact(const TopOpeBRepDS_DataStructure&   DStr,
+                        const occ::handle<ChFiDS_SurfData>& A,
+                        const int                           onA,
+                        const occ::handle<ChFiDS_SurfData>& B,
+                        const int                           onB,
+                        const double                        Tol)
+{
+  const ChFiDS_FaceInterference& IA = onA == 1 ? A->InterferenceOnS1() : A->InterferenceOnS2();
+  const ChFiDS_FaceInterference& IB = onB == 1 ? B->InterferenceOnS1() : B->InterferenceOnS2();
+  if (IA.LineIndex() <= 0 || IB.LineIndex() <= 0)
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve>& CA = DStr.Curve(IA.LineIndex()).Curve();
+  const occ::handle<Geom_Curve>& CB = DStr.Curve(IB.LineIndex()).Curve();
+  if (CA.IsNull() || CB.IsNull())
+  {
+    return false;
+  }
+  double       d1 = 0., d2 = 0., d3 = 0., d4 = 0.;
+  const double ua1 = projectOn(CA, A->Vertex(true, onA).Point(), d1);
+  const double ua2 = projectOn(CA, A->Vertex(false, onA).Point(), d2);
+  const double ub1 = projectOn(CB, B->Vertex(true, onB).Point(), d3);
+  const double ub2 = projectOn(CB, B->Vertex(false, onB).Point(), d4);
+  if (std::max(std::max(d1, d2), std::max(d3, d4)) > Tol)
+  {
+    return false;
+  }
+  const double lo = std::min(ua1, ua2), hi = std::max(ua1, ua2);
+  const double slack = 1.e-6 * (hi - lo) + Precision::PConfusion();
+  for (int i = 0; i <= 4; i++)
+  {
+    const gp_Pnt P = CB->Value(ub1 + (ub2 - ub1) * i / 4.);
+    double       d = 0.;
+    const double u = projectOn(CA, P, d);
+    if (d > Tol || u < lo - slack || u > hi + slack)
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Whether SurfData B is a part of SurfData A: the same two faces, its
+// contact curves on those of A.
+static bool coincidentSurfData(const TopOpeBRepDS_DataStructure&   DStr,
+                               const occ::handle<ChFiDS_SurfData>& A,
+                               const occ::handle<ChFiDS_SurfData>& B,
+                               const double                        Tol)
+{
+  if (A->IndexOfS1() == B->IndexOfS1() && A->IndexOfS2() == B->IndexOfS2())
+  {
+    return sameContact(DStr, A, 1, B, 1, Tol) && sameContact(DStr, A, 2, B, 2, Tol);
+  }
+  if (A->IndexOfS1() == B->IndexOfS2() && A->IndexOfS2() == B->IndexOfS1())
+  {
+    return sameContact(DStr, A, 1, B, 2, Tol) && sameContact(DStr, A, 2, B, 1, Tol);
+  }
+  return false;
+}
+
+// The distance of point P from edge E, when its projection falls on the
+// edge; RealLast otherwise.
+static double distanceToEdge(const gp_Pnt& P, const TopoDS_Edge& E)
+{
+  double                         f = 0., l = 0.;
+  const occ::handle<Geom_Curve>& C = BRep_Tool::Curve(E, f, l);
+  if (C.IsNull())
+  {
+    return RealLast();
+  }
+  GeomAPI_ProjectPointOnCurve proj(P, C, f, l);
+  if (proj.NbPoints() == 0)
+  {
+    return RealLast();
+  }
+  return proj.LowerDistance();
+}
+
+// The edge of spine Sp that bounds face F, or a null edge.
+static TopoDS_Edge spineEdgeOf(const occ::handle<ChFiDS_Spine>& Sp, const TopoDS_Face& F)
+{
+  for (int i = 1; i <= Sp->NbEdges(); i++)
+  {
+    for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(Sp->Edges(i)))
+      {
+        return Sp->Edges(i);
+      }
+    }
+  }
+  return TopoDS_Edge();
+}
+
+// Whether the contact of SurfData A on its side onA lies beyond the
+// contact of SurfData B on its side onB, seen from B's edge EB (both on
+// the same face): nearer to EB than B's contact, at points all along.
+static bool contactBeyond(const TopOpeBRepDS_DataStructure&   DStr,
+                          const occ::handle<ChFiDS_SurfData>& A,
+                          const int                           onA,
+                          const occ::handle<ChFiDS_SurfData>& B,
+                          const int                           onB,
+                          const TopoDS_Edge&                  EB,
+                          const double                        Tol)
+{
+  const ChFiDS_FaceInterference& IA = onA == 1 ? A->InterferenceOnS1() : A->InterferenceOnS2();
+  const ChFiDS_FaceInterference& IB = onB == 1 ? B->InterferenceOnS1() : B->InterferenceOnS2();
+  if (IA.LineIndex() <= 0 || IB.LineIndex() <= 0)
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve>& CA = DStr.Curve(IA.LineIndex()).Curve();
+  const occ::handle<Geom_Curve>& CB = DStr.Curve(IB.LineIndex()).Curve();
+  if (CA.IsNull() || CB.IsNull())
+  {
+    return false;
+  }
+  double       d1 = 0., d2 = 0.;
+  const double ua1 = projectOn(CA, A->Vertex(true, onA).Point(), d1);
+  const double ua2 = projectOn(CA, A->Vertex(false, onA).Point(), d2);
+  if (std::max(d1, d2) > Tol)
+  {
+    return false;
+  }
+  for (int i = 1; i <= 3; i++)
+  {
+    const gp_Pnt Pa = CA->Value(ua1 + (ua2 - ua1) * i / 4.);
+    double       dq = 0.;
+    const double uq = projectOn(CB, Pa, dq);
+    if (dq == RealLast())
+    {
+      return false;
+    }
+    const double dA = distanceToEdge(Pa, EB);
+    const double dB = distanceToEdge(CB->Value(uq), EB);
+    if (dA == RealLast() || dB == RealLast() || dA > dB - Tol)
+    {
+      return false;
+    }
+  }
+  return true;
+}
