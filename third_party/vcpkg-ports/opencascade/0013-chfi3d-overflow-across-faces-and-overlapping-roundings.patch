+static bool hasVertex(const TopoDS_Shape& S, const TopoDS_Shape& V)
+{
+  for (TopExp_Explorer ex(S, TopAbs_VERTEX); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(V))
+    {
+      return true;
+    }
+  }
+  return false;
