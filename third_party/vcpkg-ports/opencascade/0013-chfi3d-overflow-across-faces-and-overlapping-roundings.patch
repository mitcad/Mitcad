+void ChFi3d_Builder::RemoveCoincidentStripes()
+{
+  TopOpeBRepDS_DataStructure&  DStr = myDS->ChangeDS();
+  NCollection_List<occ::handle<ChFiDS_Stripe>> kept;
+  bool                                         removed = false;
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itB(myListStripe); itB.More();
+       itB.Next())
+  {
+    const occ::handle<ChFiDS_Stripe>& B = itB.Value();
+    bool                              redundant = false;
+    for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itA(kept);
+         itA.More() && !redundant;
+         itA.Next())
+    {
+      const occ::handle<ChFiDS_Stripe>& A = itA.Value();
+      if (A->SetOfSurfData().IsNull() || B->SetOfSurfData().IsNull()
+          || B->SetOfSurfData()->IsEmpty())
+      {
+        continue;
+      }
+      redundant = true;
+      for (int j = 1; j <= B->SetOfSurfData()->Length() && redundant; j++)
+      {
+        bool found = false;
+        for (int i = 1; i <= A->SetOfSurfData()->Length() && !found; i++)
+        {
+          found = coincidentSurfData(DStr,
+                                     A->SetOfSurfData()->Value(i),
+                                     B->SetOfSurfData()->Value(j),
+                                     10. * tolapp3d);
+        }
+        redundant = found;
+      }
+    }
+    if (redundant)
+    {
+      removed = true;
+      myDroppedStripes.Append(B);
+      continue;
+    }
+    kept.Append(B);
+  }
+  if (!removed)
+  {
+    return;
+  }
+  // (The dropped stripes stay contours of the builder.)
+  // The corners of the stripes kept.
+  myVDataMap.Clear();
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itel(kept); itel.More();
+       itel.Next())
+  {
+    if (itel.Value()->Spine()->FirstStatus() <= ChFiDS_BreakPoint)
+    {
+      myVDataMap.Add(itel.Value()->Spine()->FirstVertex(), itel.Value());
+    }
+    if (itel.Value()->Spine()->LastStatus() <= ChFiDS_BreakPoint)
+    {
+      myVDataMap.Add(itel.Value()->Spine()->LastVertex(), itel.Value());
     }
   }
 }
