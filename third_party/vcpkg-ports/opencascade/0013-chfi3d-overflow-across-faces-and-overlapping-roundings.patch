+// null edge when F is no such strip.
+static TopoDS_Edge oppositeEdge(const TopoDS_Face& F, const TopoDS_Edge& Near)
+{
+  TopoDS_Edge aFar;
+  for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+    if (E.IsSame(Near) || BRep_Tool::Degenerated(E))
+    {
+      continue;
+    }
+    bool touches = false;
+    for (TopExp_Explorer exv(E, TopAbs_VERTEX); exv.More() && !touches; exv.Next())
+    {
+      touches = hasVertex(Near, exv.Current());
+    }
+    if (touches)
+    {
+      continue;
+    }
+    if (!aFar.IsNull() && !aFar.IsSame(E))
+    {
+      return TopoDS_Edge();
+    }
+    aFar = E;
+  }
+  if (aFar.IsNull())
+  {
+    return aFar;
+  }
+  for (TopExp_Explorer ex(F, TopAbs_VERTEX); ex.More(); ex.Next())
+  {
+    if (!hasVertex(Near, ex.Current()) && !hasVertex(aFar, ex.Current()))
+    {
+      return TopoDS_Edge();
+    }
+  }
+  return aFar;
+}
+
+// The edges of face F other than Near that end at vertex V are cut there.
+static void cutEdgesAt(TopOpeBRepDS_DataStructure& DStr,
+                       const TopoDS_Face&          F,
+                       const TopoDS_Edge&          Near,
+                       const TopoDS_Vertex&        V)
+{
+  const int   IV = DStr.AddShape(V);
+  TopoDS_Face aF = F;
+  aF.Orientation(TopAbs_FORWARD);
+  for (TopExp_Explorer ex(aF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    TopoDS_Edge E = TopoDS::Edge(ex.Current());
+    if (E.IsSame(Near) || BRep_Tool::Degenerated(E))
+    {
+      continue;
+    }
+    E.Orientation(TopAbs_FORWARD);
+    for (TopExp_Explorer exv(E, TopAbs_VERTEX); exv.More(); exv.Next())
+    {
+      const TopoDS_Vertex& vv = TopoDS::Vertex(exv.Current());
+      if (!vv.IsSame(V))
+      {
+        continue;
+      }
+      const int IE = DStr.AddShape(E);
+      QueryAddVertexInEdge(DStr.ChangeShapeInterferences(IE),
+                           IE,
+                           IV,
+                           BRep_Tool::Parameter(vv, E),
+                           TopAbs::Reverse(vv.Orientation()));
+    }
+  }
+}
