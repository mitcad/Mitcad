+//=======================================================================
+// function : AcrossToCap
+// purpose  : The kept face across faces whose offset vanishes from the edge
+//           theE of the removed face theCap (theAcross: face A, its edge,
+//           face B, its edge, as BRepOffset_MakeOffset finds them), and its
+//           edge to them; a null face where there is none (mitcad#2433).
+//=======================================================================
+static TopoDS_Face AcrossToCap(const NCollection_List<TopoDS_Shape>* theAcross,
+                               const TopoDS_Face&                    theCap,
+                               const TopoDS_Shape&                   theE,
+                               TopoDS_Edge&                          theEdge)
+{
+  theEdge.Nullify();
+  if (!theAcross || theE.ShapeType() != TopAbs_EDGE)
+  {
+    return TopoDS_Face();
+  }
+  NCollection_List<TopoDS_Shape>::Iterator it(*theAcross);
+  while (it.More())
+  {
+    TopoDS_Shape aF[2], aE[2];
+    for (int k = 0; k < 2 && it.More(); ++k)
+    {
+      aF[k] = it.Value();
+      it.Next();
+      if (!it.More())
+      {
+        return TopoDS_Face();
+      }
+      aE[k] = it.Value();
+      it.Next();
+    }
+    for (int k = 0; k < 2; ++k)
+    {
+      if (aF[k].IsSame(theCap) && aE[k].IsSame(theE) && !aF[1 - k].IsSame(theCap))
+      {
+        theEdge = TopoDS::Edge(aE[1 - k]);
+        return TopoDS::Face(aF[1 - k]);
+      }
+    }
+  }
+  return TopoDS_Face();
+}
+
+//=======================================================================
+// function : SectionInsideCap
+// purpose  : Whether the section of a kept face's offset with the removed
+//           face theCap, across faces whose offset vanishes from theCap's
+//           edge theE, runs inside theCap there: its point nearest to the
+//           middle of theE is inside theCap. Where it runs past theE (over
+//           the vanishing faces, outside the body: a wall no thicker than
+//           they are wide where theCap turns towards them) the offset
+//           cannot be closed by theCap (mitcad#2433).
+//=======================================================================
+static bool SectionInsideCap(const NCollection_List<TopoDS_Shape>& theSection,
+                             const TopoDS_Face&                    theCap,
+                             const TopoDS_Edge&                    theE)
+{
+  double                         aF, aL;
+  const occ::handle<Geom_Curve>& aCE = BRep_Tool::Curve(theE, aF, aL);
+  if (aCE.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt aPE = aCE->Value(0.5 * (aF + aL));
+  gp_Pnt       aBest;
+  double       aBestDist = -1.;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(theSection); it.More(); it.Next())
+  {
+    double                         aF1, aL1;
+    const occ::handle<Geom_Curve>& aC = BRep_Tool::Curve(TopoDS::Edge(it.Value()), aF1, aL1);
+    if (aC.IsNull())
+    {
+      continue;
+    }
+    GeomAPI_ProjectPointOnCurve aProj(aPE, aC, aF1, aL1);
+    if (aProj.NbPoints() > 0 && (aBestDist < 0. || aProj.LowerDistance() < aBestDist))
+    {
+      aBestDist = aProj.LowerDistance();
+      aBest     = aProj.NearestPoint();
+    }
+  }
+  if (aBestDist < 0.)
+  {
+    return false;
+  }
+  BRepClass_FaceClassifier aClassifier(theCap, aBest, Precision::Confusion());
+  return aClassifier.State() == TopAbs_IN;
+}
