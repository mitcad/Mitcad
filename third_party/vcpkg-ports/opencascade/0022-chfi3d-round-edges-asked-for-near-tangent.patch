+//=======================================================================
+// function : MinNormalAngle
+// purpose  : The smallest angle between the normals of the two faces of
+//            an edge, sampled along it; -1 when it cannot be evaluated.
+//=======================================================================
+
+static double MinNormalAngle(const TopoDS_Edge& theEdge,
+                             const TopoDS_Face& theFace1,
+                             const TopoDS_Face& theFace2)
+{
+  double                    aFirst = 0., aLast = 0.;
+  occ::handle<Geom2d_Curve> aC1 = BRep_Tool::CurveOnSurface(theEdge, theFace1, aFirst, aLast);
+  occ::handle<Geom2d_Curve> aC2 = BRep_Tool::CurveOnSurface(theEdge, theFace2, aFirst, aLast);
+  if (aC1.IsNull() || aC2.IsNull())
+  {
+    return -1.;
+  }
+  BRepAdaptor_Surface aS1(theFace1, false), aS2(theFace2, false);
+  double              aMin = -1.;
+  const int           aNb  = 5;
+  for (int i = 0; i < aNb; ++i)
+  {
+    const double aT  = aFirst + (aLast - aFirst) * (i + 0.5) / aNb;
+    gp_Pnt2d     aP1 = aC1->Value(aT), aP2 = aC2->Value(aT);
+    gp_Pnt       aP;
+    gp_Vec       aDU, aDV;
+    aS1.D1(aP1.X(), aP1.Y(), aP, aDU, aDV);
+    gp_Vec aN1 = aDU.Crossed(aDV);
+    aS2.D1(aP2.X(), aP2.Y(), aP, aDU, aDV);
+    gp_Vec aN2 = aDU.Crossed(aDV);
+    if (aN1.SquareMagnitude() < 1.e-24 || aN2.SquareMagnitude() < 1.e-24)
+    {
+      continue;
+    }
+    if (theFace1.Orientation() == TopAbs_REVERSED)
+    {
+      aN1.Reverse();
+    }
+    if (theFace2.Orientation() == TopAbs_REVERSED)
+    {
+      aN2.Reverse();
+    }
+    const double anAngle = aN1.Angle(aN2);
+    if (aMin < 0. || anAngle < aMin)
+    {
+      aMin = anAngle;
+    }
+  }
+  return aMin;
+}
+
