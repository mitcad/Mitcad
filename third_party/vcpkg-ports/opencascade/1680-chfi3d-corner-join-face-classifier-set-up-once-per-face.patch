+// The states of 3D points on a face, as BRepClass_FaceClassifier(F, P, Tol)
+// gives them, with what that sets up for each point done once for the face:
+// the face's parameter bounds, the projection's setup on its surface (for a
+// B-spline surface, the grid of its samples) and the explorer of its edges.
+// Each point is projected on the surface within the bounds and its nearest
+// projection classified against the face's edges, as there.
+class gapFaceStates
+{
+public:
+  gapFaceStates(const TopoDS_Face& F, const double Tol)
+      : mySurf(F, false),
+        myExp(F),
+        myTol(Tol)
+  {
+    double aU1 = 0., aU2 = 0., aV1 = 0., aV2 = 0.;
+    BRepTools::UVBounds(F, aU1, aU2, aV1, aV2);
+    myExt.Initialize(mySurf, aU1, aU2, aV1, aV2, Tol, Tol);
+  }
+
+  gapFaceStates(const gapFaceStates&)            = delete;
+  gapFaceStates& operator=(const gapFaceStates&) = delete;
+
+  TopAbs_State State(const gp_Pnt& P)
+  {
+    myExt.Perform(P);
+    if (!myExt.IsDone() || myExt.NbExt() == 0)
+    {
+      return TopAbs_OUT;
+    }
+    double aMin = RealLast();
+    int    aBest = 0;
+    for (int i = 1; i <= myExt.NbExt(); ++i)
+    {
+      const double aD = myExt.SquareDistance(i);
+      if (aD < aMin)
+      {
+        aMin  = aD;
+        aBest = i;
+      }
+    }
+    if (aBest == 0)
+    {
+      return TopAbs_OUT;
+    }
+    double aU = 0., aV = 0.;
+    myExt.Point(aBest).Parameter(aU, aV);
+    return BRepClass_FaceClassifier(myExp, gp_Pnt2d(aU, aV), myTol).State();
+  }
+
+private:
+  BRepAdaptor_Surface    mySurf;
+  Extrema_ExtPS          myExt;
+  BRepClass_FaceExplorer myExp;
+  double                 myTol;
+};
 } // namespace
 
