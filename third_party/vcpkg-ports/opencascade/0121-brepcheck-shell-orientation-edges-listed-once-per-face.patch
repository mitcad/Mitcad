+namespace
+{
+// The orientations of the edges of a shell's faces, in the order an explorer of each face
+// (oriented as in the shell) meets them, found once for a face of many edges: searching such a
+// face for each of its edges made the orientation check quadratic in the edges of a face (a
+// face of 23 000 edges, a plate with thousands of holes, took seconds). Faces of few edges are
+// searched as before.
+class EdgeOrientationsOfFaces
+{
+public:
+  //! The orientation of the occurrence theRank (0 for the first) of theEdge in theFace, oriented
+  //! as in the shell; false when there is none or theFace has few edges (the caller then
+  //! searches the face as before).
+  bool Find(const TopoDS_Face&  theFace,
+            const TopoDS_Shape& theEdge,
+            const int           theRank,
+            TopAbs_Orientation& theOrientation)
+  {
+    const occ::handle<Edges>* aKept = myFaces.Seek(theFace);
+    if (aKept == nullptr)
+    {
+      occ::handle<Edges> aNew;
+      int                aCount = 0;
+      for (TopExp_Explorer anExp(theFace, TopAbs_EDGE); anExp.More(); anExp.Next())
+      {
+        ++aCount;
+      }
+      if (aCount >= THE_MANY_EDGES)
+      {
+        aNew = new Edges();
+        for (TopExp_Explorer anExp(theFace, TopAbs_EDGE); anExp.More(); anExp.Next())
+        {
+          Occurrences* anOcc = aNew->ChangeSeek(anExp.Current());
+          if (anOcc == nullptr)
+          {
+            anOcc = aNew->Bound(anExp.Current(), Occurrences());
+          }
+          if (anOcc->Count < 2)
+          {
+            anOcc->Orientations[anOcc->Count] = anExp.Current().Orientation();
+          }
+          ++anOcc->Count;
+        }
+      }
+      aKept = myFaces.Bound(theFace, aNew);
+    }
+    if (aKept->IsNull())
+    {
+      return false;
+    }
+    // The callers ask for the first or the second occurrence only.
+    const Occurrences* anOcc = (*aKept)->Seek(theEdge);
+    if (anOcc == nullptr || theRank > 1 || theRank >= anOcc->Count)
+    {
+      return false;
+    }
+    theOrientation = anOcc->Orientations[theRank];
+    return true;
+  }
+
+private:
+  static constexpr int THE_MANY_EDGES = 64;
+
+  //! The orientations of an edge's first two occurrences in a face, and how often it occurs.
+  struct Occurrences
+  {
+    TopAbs_Orientation Orientations[2] = {TopAbs_FORWARD, TopAbs_FORWARD};
+    int                Count           = 0;
+  };
+
+  using Edges =
+    NCollection_Shared<NCollection_DataMap<TopoDS_Shape, Occurrences, TopTools_ShapeMapHasher>>;
+  NCollection_DataMap<TopoDS_Shape, occ::handle<Edges>, TopTools_ShapeMapHasher> myFaces;
+};
+} // namespace
