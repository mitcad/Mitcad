+    }
+    const TopoDS_Face F   = TopoDS::Face(DStr.Shape(iF));
+    // (B's other face's surface, unbounded: where the patch rises above
+    // the face's edge with F, B's contact there runs on past that edge.)
+    const TopoDS_Face aTopF = TopoDS::Face(DStr.Shape(SB->Index(3 - onB)));
+    TopoDS_Face       Top   = BRepLib_MakeFace(BRep_Tool::Surface(aTopF), Precision::Confusion());
+    Top.Orientation(aTopF.Orientation());
+    const ChFiDS_FaceInterference& FB = SB->Interference(onB);
+    const ChFiDS_FaceInterference& FK = coin->Interference(onK);
+    if (FB.PCurveOnFace().IsNull() || FK.PCurveOnFace().IsNull() || FB.LineIndex() <= 0 || FK.LineIndex() <= 0)
+    {
+      continue;
+    }
+    // Where B's contact on F crosses the patch's: once, inside both.
+    const double bLo = std::min(FB.FirstParameter(), FB.LastParameter());
+    const double bHi = std::max(FB.FirstParameter(), FB.LastParameter());
+    const double kLo = std::min(FK.FirstParameter(), FK.LastParameter());
+    const double kHi = std::max(FK.FirstParameter(), FK.LastParameter());
