+    const double tJ1 = r1Q ? FR1.LastParameter() : FR1.FirstParameter();
+    const double tJ2 = r2J ? FS2.FirstParameter() : FS2.LastParameter();
+    // P_top: where R2's contact on the top crosses the face at the end.
