+bool ChFi3d_Builder::PerformRideOnCornerAtEnd(const int Index)
+{
+  const TopoDS_Vertex&        Vtx  = myVDataMap.FindKey(Index);
+  TopOpeBRepDS_DataStructure& DStr = myDS->ChangeDS();
+  if (myVDataMap(Index).Extent() != 2)
+  {
+    return false;
+  }
+  occ::handle<ChFiDS_Stripe> aS[2];
+  {
+    NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator It(myVDataMap(Index));
+    aS[0] = It.Value();
+    It.Next();
+    aS[1] = It.Value();
+  }
+  if (aS[0] == aS[1])
+  {
+    return false;
+  }
+  for (int r = 0; r < 2; r++)
+  {
+    const occ::handle<ChFiDS_Stripe>& B = aS[r];
+    const occ::handle<ChFiDS_Stripe>& C = aS[1 - r];
+    const occ::handle<ChFiDS_FilSpine> aFsB = occ::down_cast<ChFiDS_FilSpine>(B->Spine());
+    const occ::handle<ChFiDS_FilSpine> aFsC = occ::down_cast<ChFiDS_FilSpine>(C->Spine());
+    if (aFsB.IsNull() || aFsC.IsNull() || !aFsB->IsConstant() || C->SetOfSurfData().IsNull()
+        || B->SetOfSurfData().IsNull() || C->SetOfSurfData()->Length() != 1 || myRideStripes.Contains(B)
+        || myRideOn.Contains(B) || myRideStripes.Contains(C) || myRideOn.Contains(C))
+    {
+      continue;
+    }
+    int  iB = 0, iC = 0;
+    bool fB = false, fC = false;
+    const occ::handle<ChFiDS_SurfData> SB = endDataAt(Vtx, B, iB, fB);
+    const occ::handle<ChFiDS_SurfData> SC = endDataAt(Vtx, C, iC, fC);
+    if (SB.IsNull() || SC.IsNull())
+    {
+      continue;
+    }
+    // C's other end: a corner of three blends, whose stripe K ends on C's
+    // curve there.
+    const int                  aOtherCurve = C->Curve(!fC);
+    occ::handle<ChFiDS_Stripe> K;
+    bool                       kFirst = false;
+    for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itK(myListStripe); itK.More() && aOtherCurve > 0;
+         itK.Next())
+    {
+      const occ::handle<ChFiDS_Stripe>& S = itK.Value();
+      if (!S->Spine().IsNull() || S->SetOfSurfData().IsNull() || S->SetOfSurfData()->Length() != 1)
+      continue;
+      if (S->Curve(true) == aOtherCurve || S->Curve(false) == aOtherCurve)
+      {
+        K      = S;
+        kFirst = S->Curve(true) == aOtherCurve;
+      }
+    }
+    if (K.IsNull())
+    {
+      continue;
+    }
+    const occ::handle<ChFiDS_SurfData> coin = K->SetOfSurfData()->Value(1);
+    // The face between: the face of the corner's patch, B and C on it.
+    int onK = 0, onB = 0, onC = 0;
+    for (int k = 1; k <= 2; k++)
+    {
+      onK = onK == 0 && coin->Index(k) > 0 && !coin->IsOnCurve(k) ? k : onK;
