+// The SurfData at vertex Vtx of stripe S: its index and whether it is S's
+// first end there. Null where S has none.
+static occ::handle<ChFiDS_SurfData> endDataAt(const TopoDS_Vertex&              Vtx,
+                                              const occ::handle<ChFiDS_Stripe>& S,
+                                              int&                              theIndex,
+                                              bool&                             theFirst)
+{
+  int aSens = 0;
+  theIndex  = ChFi3d_IndexOfSurfData(Vtx, S, aSens);
+  theFirst  = aSens == 1;
+  if (S->SetOfSurfData().IsNull() || theIndex < 1 || theIndex > S->SetOfSurfData()->Length())
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  return S->SetOfSurfData()->Value(theIndex);
+}
+
+// SurfData SD's surface as a face over the parameters of its two lines, run
+// on across them by their width on either side, and along them by a quarter
+// of their length at the ends not marked exact (AtFirst, AtLast: the ends of
+// SD's line on side OnS), oriented as face F at point P: a support a ball
+// rolls on, bounded where the SurfData ends (PerformRideOnCornerAtEnd).
+static TopoDS_Face cornerRideSupport(const TopOpeBRepDS_DataStructure&   DStr,
+                                     const occ::handle<ChFiDS_SurfData>& SD,
+                                     const int                           OnS,
+                                     const bool                          ExactFirst,
+                                     const bool                          ExactLast,
+                                     const TopoDS_Face&                  F,
+                                     const gp_Pnt&                       P,
+                                     const bool                          ExactOther = false)
+{
+  const occ::handle<Geom_Surface>& SS = DStr.Surface(SD->Surf()).Surface();
+  if (SS.IsNull())
+  {
+    return TopoDS_Face();
+  }
+  double u1 = RealLast(), u2 = -RealLast(), v1 = RealLast(), v2 = -RealLast();
+  for (int k = 1; k <= 2; k++)
+  {
+    const ChFiDS_FaceInterference& FIk = SD->Interference(k);
+    if (FIk.PCurveOnSurf().IsNull())
+    {
+      return TopoDS_Face();
+    }
+    for (int i = 0; i <= 10; i++)
+    {
+      const double   t  = FIk.FirstParameter() + (FIk.LastParameter() - FIk.FirstParameter()) * i / 10.;
+      const gp_Pnt2d uv = FIk.PCurveOnSurf()->Value(t);
+      u1                = std::min(u1, uv.X());
+      u2                = std::max(u2, uv.X());
+      v1                = std::min(v1, uv.Y());
+      v2                = std::max(v2, uv.Y());
+    }
+  }
+  const ChFiDS_FaceInterference& FI = SD->Interference(OnS);
+  const gp_Pnt2d a0 = FI.PCurveOnSurf()->Value(FI.FirstParameter());
+  const gp_Pnt2d a1 = FI.PCurveOnSurf()->Value(FI.LastParameter());
+  double         su1 = 0., su2 = 0., sv1 = 0., sv2 = 0.;
+  SS->Bounds(su1, su2, sv1, sv2);
+  const bool alongV = std::abs(a1.Y() - a0.Y()) >= std::abs(a1.X() - a0.X());
+  // (Along: the bound at the line's first end is the lower one where the
+  // line runs up its coordinate.)
+  const bool   up  = alongV ? a1.Y() > a0.Y() : a1.X() > a0.X();
+  const bool   exLo = up ? ExactFirst : ExactLast, exHi = up ? ExactLast : ExactFirst;
+  const double mA   = 0.25 * (alongV ? v2 - v1 : u2 - u1);
+  const double mC   = alongV ? u2 - u1 : v2 - v1;
+  double&      aLo = alongV ? v1 : u1;
+  double&      aHi = alongV ? v2 : u2;
+  double&      cLo = alongV ? u1 : v1;
+  double&      cHi = alongV ? u2 : v2;
+  const bool   pA  = alongV ? SS->IsVPeriodic() : SS->IsUPeriodic();
+  const bool   pC  = alongV ? SS->IsUPeriodic() : SS->IsVPeriodic();
+  const double sAlo = alongV ? sv1 : su1, sAhi = alongV ? sv2 : su2;
+  const double sClo = alongV ? su1 : sv1, sChi = alongV ? su2 : sv2;
+  if (!exLo)
+  {
+    aLo = pA ? aLo - mA : std::max(sAlo, aLo - mA);
+  }
+  if (!exHi)
+  {
+    aHi = pA ? aHi + mA : std::min(sAhi, aHi + mA);
+  }
+  // (Across, not past the line on the other side where ExactOther: the
+  // ball leaves the support there.)
+  const ChFiDS_FaceInterference& FO = SD->Interference(3 - OnS);
+  const gp_Pnt2d oM = FO.PCurveOnSurf()->Value(0.5 * (FO.FirstParameter() + FO.LastParameter()));
+  const double   oC = alongV ? oM.X() : oM.Y();
+  const bool     oLo = std::abs(oC - cLo) < std::abs(oC - cHi);
+  if (!(ExactOther && oLo))
+  {
+    cLo = pC ? cLo - mC : std::max(sClo, cLo - mC);
+  }
+  if (!(ExactOther && !oLo))
+  {
+    cHi = pC ? cHi + mC : std::min(sChi, cHi + mC);
+  }
+  BRepLib_MakeFace aMakeFace(SS, u1, u2, v1, v2, Precision::Confusion());
+  if (!aMakeFace.IsDone())
+  {
+    return TopoDS_Face();
+  }
+  TopoDS_Face Support = aMakeFace.Face();
+  gp_Dir      aNF, aNS;
+  Support.Orientation(TopAbs_FORWARD);
+  if (!outwardNormalAt(F, P, aNF) || !outwardNormalAt(Support, P, aNS))
+  {
+    return TopoDS_Face();
+  }
+  if (aNF.Dot(aNS) < 0.)
+  {
+    Support.Orientation(TopAbs_REVERSED);
+  }
+  return Support;
+}
