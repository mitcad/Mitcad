+bool ChFi3d_Builder::RideOnCornerWalk(occ::handle<ChFiDS_SurfData>&      Data,
+                                      const occ::handle<ChFiDS_Stripe>&  B,
+                                      const occ::handle<ChFiDS_ElSpine>& Guide,
+                                      const TopoDS_Face&                 Support,
+                                      const TopoDS_Face&                 Other,
+                                      const int                          OnSupport,
+                                      const double                       W,
+                                      const double                       WEnd,
+                                      const gp_Pnt&                      POnSupport,
+                                      const gp_Pnt&                      POnOther,
+                                      bool                               StopOnSupport,
+                                      double&                            Last)
+{
+  const occ::handle<ChFiDS_FilSpine> aFs = occ::down_cast<ChFiDS_FilSpine>(B->Spine());
+  if (aFs.IsNull() || !aFs->IsConstant())
+  {
+    return false;
+  }
+  const TopoDS_Face& F1 = OnSupport == 1 ? Support : Other;
+  const TopoDS_Face& F2 = OnSupport == 1 ? Other : Support;
+  occ::handle<BRepAdaptor_Surface> S1 = new BRepAdaptor_Surface(F1, false);
+  occ::handle<BRepAdaptor_Surface> S2 = new BRepAdaptor_Surface(F2, false);
+  occ::handle<Adaptor3d_TopolTool> I1 = new BRepTopAdaptor_TopolTool(S1);
+  occ::handle<Adaptor3d_TopolTool> I2 = new BRepTopAdaptor_TopolTool(S2);
+  math_Vector Sol(1, 4);
+  double      u = 0., v = 0.;
+  if (!uvOn(F1, OnSupport == 1 ? POnSupport : POnOther, u, v))
+  {
+    return false;
+  }
+  Sol(1) = u;
+  Sol(2) = v;
+  if (!uvOn(F2, OnSupport == 1 ? POnOther : POnSupport, u, v))
+  {
+    return false;
+  }
+  Sol(3) = u;
+  Sol(4) = v;
+  TopAbs_Orientation o1 = F1.Orientation(), o2 = F2.Orientation();
+  const int Choix = ChFi3d::NextSide(o1, o2, B->OrientationOnFace1(), B->OrientationOnFace2(), B->Choix());
+  BRepBlend_ConstRad    func(S1, S2, Guide);
+  BRepBlend_ConstRadInv finv(S1, S2, Guide);
+  func.Set(aFs->Radius(), Choix);
+  finv.Set(aFs->Radius(), Choix);
+  const bool   aForward = WEnd > W;
+  const double aMaxStep = 0.05 * std::abs(WEnd - W);
+  const double aTolG    = Guide->Resolution(tolapp3d);
+  occ::handle<ChFiDS_Spine>   aNullSpine;
+  occ::handle<BRepBlend_Line> aLin;
+  double aFirst = aForward ? W : WEnd, aLast = WEnd;
+  // (To WEnd, or where the walk leaves the support: a walk back takes its
+  // target from Last and checks its end against First.)
+  int    intf = 0, intl = 0;
+  bool   Gd1 = false, Gd2 = false, Gf1 = false, Gf2 = false;
+  bool   aDone = false;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    aDone = ComputeData(Data, Guide, aNullSpine, aLin, S1, I1, S2, I2, func, finv, W, aMaxStep, fleche, aTolG,
+                        aFirst, aLast, false, false, aForward, Sol, intf, intl, Gd1, Gd2, Gf1, Gf2,
+                        StopOnSupport && OnSupport == 1, StopOnSupport && OnSupport == 2);
+    if (aDone)
+    {
+      aDone = CompleteData(Data, func, aLin, S1, S2, o1, Gd1, Gd2, Gf1, Gf2);
+    }
+  }
+  catch (Standard_Failure const& anException)
+  {
+    // (Only OCCT's reports that this cannot be computed fail this step, mitcad#1986.)
+    if (!ChFi3d_IsComputationFailure(anException))
+    {
+      throw;
+    }
+    aDone = false;
+  }
+  Last = aForward ? aLast : aFirst;
+  return aDone;
+}
