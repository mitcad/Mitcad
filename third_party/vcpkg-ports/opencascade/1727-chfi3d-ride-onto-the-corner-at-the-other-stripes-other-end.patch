+// The parameters of the point of face F's surface nearest P (in the period
+// of F's bounds on a periodic surface). False where it is not found.
+static bool uvOn(const TopoDS_Face& F, const gp_Pnt& P, double& U, double& V)
+{
+  GeomAPI_ProjectPointOnSurf aProj(P, BRep_Tool::Surface(F));
+  if (aProj.NbPoints() == 0)
+  {
+    return false;
+  }
+  aProj.LowerDistanceParameters(U, V);
+  double aU1 = 0., aU2 = 0., aV1 = 0., aV2 = 0.;
+  BRepTools::UVBounds(F, aU1, aU2, aV1, aV2);
+  const occ::handle<Geom_Surface> aSS = BRep_Tool::Surface(F);
+  if (aSS->IsUPeriodic())
+  {
+    U = ElCLib::InPeriod(U, aU1 - Precision::PConfusion(), aU1 - Precision::PConfusion() + aSS->UPeriod());
+  }
+  if (aSS->IsVPeriodic())
+  {
+    V = ElCLib::InPeriod(V, aV1 - Precision::PConfusion(), aV1 - Precision::PConfusion() + aSS->VPeriod());
+  }
+  return true;
+}
