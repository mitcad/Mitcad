+// The edge of face F1 at vertex V that face F2 shares. Null where none.
+static TopoDS_Edge edgeAtVertex(const TopoDS_Face& F1, const TopoDS_Face& F2, const TopoDS_Vertex& V)
+{
+  for (TopExp_Explorer ex1(F1, TopAbs_EDGE); ex1.More(); ex1.Next())
+  {
+    bool atV = false;
+    for (TopExp_Explorer exv(ex1.Current(), TopAbs_VERTEX); exv.More() && !atV; exv.Next())
+    {
+      atV = exv.Current().IsSame(V);
+    }
+    if (!atV)
+    {
+      continue;
+    }
+    for (TopExp_Explorer ex2(F2, TopAbs_EDGE); ex2.More(); ex2.Next())
+    {
+      if (ex2.Current().IsSame(ex1.Current()))
+      {
+        return TopoDS::Edge(ex1.Current());
+      }
+    }
+  }
+  return TopoDS_Edge();
+}
+
+// The point From of face F's parameters moved by Eps to the side of F's
+// edge E where F lies (the left of E's p-curve as the face holds it, the
+// face taken forward), E's direction taken at its vertex V.
+static gp_Pnt2d insideNear(const TopoDS_Face&   F,
+                           const TopoDS_Edge&   E,
+                           const TopoDS_Vertex& V,
+                           const gp_Pnt2d&      From,
+                           const double         Eps)
+{
+  TopoDS_Face FF = F;
+  FF.Orientation(TopAbs_FORWARD);
+  for (TopExp_Explorer ex(FF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    if (!ex.Current().IsSame(E))
+    {
+      continue;
+    }
+    const TopoDS_Edge&              EF = TopoDS::Edge(ex.Current());
+    double                          f = 0., l = 0.;
+    const occ::handle<Geom2d_Curve> PC = BRep_Tool::CurveOnSurface(EF, FF, f, l);
+    if (PC.IsNull())
+    {
+      break;
+    }
+    gp_Pnt2d p;
+    gp_Vec2d d;
+    PC->D1(BRep_Tool::Parameter(V, EF), p, d);
+    if (EF.Orientation() == TopAbs_REVERSED)
+    {
+      d.Reverse();
+    }
+    if (d.Magnitude() <= gp::Resolution())
+    {
+      break;
+    }
+    return From.Translated(gp_Vec2d(-d.Y(), d.X()).Normalized() * Eps);
+  }
+  return From;
+}
