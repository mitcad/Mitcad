+// The parameter of spine Sp whose section (the plane normal to the spine)
+// passes through P, found from W by Newton's steps, within the spine.
+static double sectionParam(const occ::handle<ChFiDS_Spine>& Sp, const gp_Pnt& P, const double W)
+{
+  double w = W;
+  for (int i = 0; i < 50; i++)
+  {
+    gp_Pnt S;
+    gp_Vec T;
+    Sp->D1(w, S, T);
+    const double t2 = T.SquareMagnitude();
+    if (t2 <= gp::Resolution())
+    {
+      break;
+    }
+    const double dw = gp_Vec(S, P).Dot(T) / t2;
+    w               = std::max(Sp->FirstParameter(), std::min(Sp->LastParameter(), w + dw));
+    if (std::abs(dw) <= Precision::PConfusion())
+    {
+      break;
+    }
+  }
+  return w;
+}
+
+// A guide along spine Sp from parameter W1 to W2, run on a tenth past
+// both, its parameter the spine's (the elementary spines a stripe was
+// computed on may not cover a piece its blend was made on directly).
+static occ::handle<ChFiDS_ElSpine> guideAlong(const occ::handle<ChFiDS_Spine>& Sp, const double W1, const double W2)
+{
+  const double a = std::min(W1, W2) - 0.1 * std::abs(W2 - W1), b = std::max(W1, W2) + 0.1 * std::abs(W2 - W1);
+  const int    n = 16;
+  occ::handle<NCollection_HArray1<gp_Pnt>> aP = new NCollection_HArray1<gp_Pnt>(1, n + 1);
+  occ::handle<NCollection_HArray1<double>> aT = new NCollection_HArray1<double>(1, n + 1);
+  for (int i = 0; i <= n; i++)
+  {
+    const double w = a + (b - a) * i / n;
+    // (Past the spine's ends, straight on along its tangent there.)
+    const double we = std::max(Sp->FirstParameter(), std::min(Sp->LastParameter(), w));
+    gp_Pnt       P;
+    gp_Vec       V;
+    Sp->D1(we, P, V);
+    if (V.Magnitude() <= gp::Resolution())
+    {
+      return occ::handle<ChFiDS_ElSpine>();
+    }
+    aP->SetValue(i + 1, P.Translated(V.Normalized() * (w - we)));
+    aT->SetValue(i + 1, w);
+  }
+  GeomAPI_Interpolate anInterp(aP, aT, false, Precision::Confusion());
+  try
+  {
+    OCC_CATCH_SIGNALS
+    anInterp.Perform();
+  }
+  catch (Standard_Failure const& anException)
+  {
+    // (Only OCCT's reports that this cannot be computed fail this step, mitcad#1986.)
+    if (!ChFi3d_IsComputationFailure(anException))
+    {
+      throw;
+    }
+    return occ::handle<ChFiDS_ElSpine>();
+  }
+  if (!anInterp.IsDone())
+  {
+    return occ::handle<ChFiDS_ElSpine>();
+  }
+  occ::handle<ChFiDS_ElSpine> HG = new ChFiDS_ElSpine();
+  HG->SetCurve(anInterp.Curve());
+  HG->FirstParameter(a);
+  HG->LastParameter(b);
+  return HG;
+}
