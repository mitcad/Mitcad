   // peigne ne change pas d orientation.
-  double ll = 1. / 12., pmix = 0;
+  // (Where the field vanishes, at a corner where the patch comes to a
+  // point, its orientation is only numerical noise and is not compared:
+  // a mixed product below 1e-9 of the largest one along the boundary.)
+  const double ll = 1. / 12.;
+  double       aMix[13];
+  double       aMax = 0.;
   for (int iu = 0; iu < 13; iu++)
   {
     double uu = iu * ll;
