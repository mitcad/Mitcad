+// Whether stripe A, of one SurfData, rolls on the whole of edge E: a side
+// of it on curve E whose ends are E's two vertices, within tolerance Tol.
+static bool rollsOnWholeEdge(const TopOpeBRepDS_DataStructure& DStr,
+                             const occ::handle<ChFiDS_Stripe>& A,
+                             const TopoDS_Edge&                E,
+                             const double                      Tol)
+{
+  if (A->SetOfSurfData().IsNull() || A->SetOfSurfData()->Length() != 1)
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_SurfData>& D = A->SetOfSurfData()->Value(1);
+  TopoDS_Vertex                       V1, V2;
+  TopExp::Vertices(E, V1, V2);
+  if (V1.IsNull() || V2.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt P1 = BRep_Tool::Pnt(V1), P2 = BRep_Tool::Pnt(V2);
+  for (int k = 1; k <= 2; k++)
+  {
+    if (!D->IsOnCurve(k) || D->IndexOfC(k) <= 0 || !DStr.Shape(D->IndexOfC(k)).IsSame(E))
+    {
+      continue;
+    }
+    const gp_Pnt Q1 = D->Vertex(true, k).Point(), Q2 = D->Vertex(false, k).Point();
+    if ((Q1.Distance(P1) <= Tol && Q2.Distance(P2) <= Tol)
+        || (Q1.Distance(P2) <= Tol && Q2.Distance(P1) <= Tol))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
 // Whether the contact of SurfData A on its side onA lies beyond the
 // contact of SurfData B on its side onB, seen from B's edge EB (both on
 // the same face): nearer to EB than B's contact, at points all along.
@@ -4115,6 +4150,82 @@ void ChFi3d_Builder::Compute()
     // (One blend over a face narrower than both roundings computed whole by
     // one of the two stripes: the other is dropped.)
     DropOverlapsRunOutByOther();
+    // A rounding of an edge another rounding rolls on all along, over the
+    // face between their edges (the face narrower than the other's contact
+    // distance, 0011): riding on the other's contact line on that face
+    // (0016), which is that edge itself, its ball touches its other face on
+    // the edge, a section of no width. It takes nothing away; it is
+    // dropped with its corners.
+    {
+      bool aDropped = false;
+      for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itB(myListStripe); itB.More(); itB.Next())
+      {
+        const occ::handle<ChFiDS_Stripe>& B = itB.Value();
+        if (myDroppedStripes.Contains(B) || myRideStripes.Contains(B) || myRideOn.Contains(B)
+            || B->Spine()->NbEdges() != 1 || B->Spine()->IsPeriodic() || B->Spine()->IsClosed())
+        {
+          continue;
+        }
+        const TopoDS_Edge& EB = B->Spine()->Edges(1);
+        if (!myEFMap.Contains(EB) || myEFMap(EB).Extent() != 2)
+        {
+          continue;
+        }
+        const ChFiDS_TypeOfConcavity aTypeB = ChFi3d::DefineConnectType(EB,
+                                                                        TopoDS::Face(myEFMap(EB).First()),
+                                                                        TopoDS::Face(myEFMap(EB).Last()),
+                                                                        1.e-6,
+                                                                        false);
+        for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itA(myListStripe); itA.More(); itA.Next())
+        {
+          const occ::handle<ChFiDS_Stripe>& A = itA.Value();
+          if (A == B || myDroppedStripes.Contains(A) || !rollsOnWholeEdge(DStr, A, EB, 10. * tolapp3d))
+          {
+            continue;
+          }
+          // (The face of EB between the two edges, and both edges of a kind.)
+          TopoDS_Edge EA;
+          for (NCollection_List<TopoDS_Shape>::Iterator itF(myEFMap(EB)); itF.More() && EA.IsNull();
+               itF.Next())
+          {
+            EA = spineEdgeOf(A->Spine(), TopoDS::Face(itF.Value()));
+          }
+          if (EA.IsNull() || !myEFMap.Contains(EA) || myEFMap(EA).Extent() != 2
+              || ChFi3d::DefineConnectType(EA,
+                                           TopoDS::Face(myEFMap(EA).First()),
+                                           TopoDS::Face(myEFMap(EA).Last()),
+                                           1.e-6,
+                                           false)
+                   != aTypeB
+              || (aTypeB != ChFiDS_Convex && aTypeB != ChFiDS_Concave))
+          {
+            continue;
+          }
+          myDroppedStripes.Append(B);
+          aDropped = true;
+          break;
+        }
+      }
+      if (aDropped)
+      {
+        myVDataMap.Clear();
+        for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator it(myListStripe); it.More(); it.Next())
+        {
+          if (myDroppedStripes.Contains(it.Value()))
+          {
+            continue;
+          }
+          if (it.Value()->Spine()->FirstStatus() <= ChFiDS_BreakPoint)
+          {
+            myVDataMap.Add(it.Value()->Spine()->FirstVertex(), it.Value());
+          }
+          if (it.Value()->Spine()->LastStatus() <= ChFiDS_BreakPoint)
+          {
+            myVDataMap.Add(it.Value()->Spine()->LastVertex(), it.Value());
+          }
+        }
+      }
+    }
