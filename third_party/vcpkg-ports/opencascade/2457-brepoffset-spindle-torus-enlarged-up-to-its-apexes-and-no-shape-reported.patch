+//! True for a spindle torus (its major radius smaller than its minor one),
+//! also given as an offset surface of a torus: it meets itself at two
+//! apexes on its axis, where R + r cos(v) = 0, at v = +-theApexV, theMinor
+//! being r (the offset's included, on the part of the torus outside the
+//! apexes, where its normal points out of the tube) (mitcad#2457).
+static bool IsSpindleTorus(const occ::handle<Geom_Surface>& theSurf,
+                           double&                          theApexV,
+                           double&                          theMajor,
+                           double&                          theMinor)
+{
+  occ::handle<Geom_Surface> aBasis  = theSurf;
+  double                    aOffset = 0.;
+  if (const occ::handle<Geom_OffsetSurface> aOS = occ::down_cast<Geom_OffsetSurface>(theSurf))
+  {
+    aBasis  = aOS->BasisSurface();
+    aOffset = aOS->Offset();
+  }
+  if (const occ::handle<Geom_RectangularTrimmedSurface> aRT =
+        occ::down_cast<Geom_RectangularTrimmedSurface>(aBasis))
+  {
+    aBasis = aRT->BasisSurface();
+  }
+  const occ::handle<Geom_ToroidalSurface> aTorusS = occ::down_cast<Geom_ToroidalSurface>(aBasis);
+  if (aTorusS.IsNull())
+  {
+    return false;
+  }
+  const gp_Torus aTorus = aTorusS->Torus();
+  theMajor              = aTorus.MajorRadius();
+  theMinor = aTorus.MinorRadius() + (aTorus.Position().Direct() ? aOffset : -aOffset);
+  if (!(theMajor < theMinor - Precision::Confusion()))
+  {
+    return false;
+  }
+  theApexV = std::acos(-theMajor / theMinor);
+  return true;
+}
