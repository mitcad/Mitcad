+  double aSpindleV = 0., aSpindleR = 0., aSpindler = 0.;
+  if (IsSpindleTorus(theSurf, aSpindleV, aSpindleR, aSpindler))
+  {
+    const double aTwoPi = 2. * M_PI;
+    const double aMid   = 0.5 * (VF1 + VF2);
+    const double aK     = std::floor((aMid + M_PI) / aTwoPi) * aTwoPi;
+    const double aM     = aMid - aK; // in [-pi, pi)
+    double       aLo    = aK - aSpindleV;
+    double       aHi    = aK + aSpindleV;
+    if (aM >= aSpindleV)
+    {
+      // the inner part, round v = pi
+      aLo = aK + aSpindleV;
+      aHi = aK + aTwoPi - aSpindleV;
+    }
+    else if (aM <= -aSpindleV)
+    {
+      // the inner part, round v = -pi
+      aLo = aK - aTwoPi + aSpindleV;
+      aHi = aK - aSpindleV;
+    }
+    constexpr double aTolV = Precision::PConfusion();
+    if (VF1 >= aLo - aTolV && VF2 <= aHi + aTolV)
+    {
+      VV1 = std::max(VV1, aLo);
+      VV2 = std::min(VV2, aHi);
