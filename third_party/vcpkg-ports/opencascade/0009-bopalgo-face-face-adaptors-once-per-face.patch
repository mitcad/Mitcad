+++ b/src/ModelingAlgorithms/TKBO/IntTools/IntTools_Context.cxx
@@ -340,6 +340,25 @@ BRepAdaptor_Surface& IntTools_Context::SurfaceAdaptor(const TopoDS_Face& theFace
 
 //=================================================================================================
 
+void IntTools_Context::SetSurfaceAdaptor(const TopoDS_Face&         theFace,
+                                         const BRepAdaptor_Surface& theAdaptor)
+{
+  if (mySurfAdaptorMap.IsBound(theFace))
+  {
+    return;
+  }
+  const occ::handle<BRepAdaptor_Surface> aCopy =
+    occ::down_cast<BRepAdaptor_Surface>(theAdaptor.ShallowCopy());
+  //
+  BRepAdaptor_Surface* pBAS =
+    (BRepAdaptor_Surface*)myAllocator->Allocate(sizeof(BRepAdaptor_Surface));
+  new (pBAS) BRepAdaptor_Surface(*aCopy);
+  //
+  mySurfAdaptorMap.Bind(theFace, pBAS);
+}
+
