--- a/src/ModelingAlgorithms/TKBO/BOPAlgo/BOPAlgo_PaveFiller_6.cxx
+++ b/src/ModelingAlgorithms/TKBO/BOPAlgo/BOPAlgo_PaveFiller_6.cxx
@@ -361,6 +361,11 @@ void BOPAlgo_PaveFiller::PerformFF(const Message_ProgressRange& theRange)
 
   // Prepare the pairs of faces for intersection
   BOPAlgo_VectorOfFaceFace aVFaceFace;
+  // Each pair is intersected in a context of its own. The surface adaptors of
+  // the faces (restricted to their UV bounds, which go through all edges of a
+  // face) are built once per face here and copied into the contexts of its
+  // pairs, instead of once per pair: never evaluated, only copied.
+  NCollection_DataMap<int, occ::handle<BRepAdaptor_Surface>> aMFaceAdaptor;
   myIterator->Initialize(TopAbs_FACE, TopAbs_FACE);
   for (; myIterator->More(); myIterator->Next())
   {
@@ -505,6 +510,25 @@ void BOPAlgo_PaveFiller::PerformFF(const Message_ProgressRange& theRange)
       //
       aFaceFace.SetParameters(bApprox, bCompC2D1, bCompC2D2, anApproxTol);
       aFaceFace.SetFuzzyValue(myFuzzyValue);
+      //
+      // The pair's own context, with the adaptors of its faces (a face moved
+      // above gets its adaptor built there, as before).
+      occ::handle<IntTools_Context> aPairContext = new IntTools_Context;
+      for (const int nF : {nF1, nF2})
+      {
+        const TopoDS_Face& aF = (*(TopoDS_Face*)(&myDS->Shape(nF)));
+        if (!(nF == nF1 ? aFShifted1 : aFShifted2).IsEqual(aF))
+        {
+          continue;
+        }
+        occ::handle<BRepAdaptor_Surface>* pAdaptor = aMFaceAdaptor.ChangeSeek(nF);
+        if (pAdaptor == nullptr)
+        {
+          pAdaptor = aMFaceAdaptor.Bound(nF, new BRepAdaptor_Surface(aF, true));
+        }
+        aPairContext->SetSurfaceAdaptor(aF, **pAdaptor);
+      }
+      aFaceFace.SetContext(aPairContext);
     }
     else
     {
