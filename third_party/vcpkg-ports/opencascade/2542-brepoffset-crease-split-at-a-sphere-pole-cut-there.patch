+//=======================================================================
+// function : AlongAPiece
+// purpose  : Whether the piece theNE (of an intersection of two offset
+//            faces) runs where the edges of theC do, beside the original
+//            edge theE: each of its points across from theE's ends and
+//            middle lies on one of those edges (the same branch, also
+//            where it came in several pieces before) (mitcad#2542).
+//=======================================================================
+static bool AlongAPiece(const TopoDS_Edge& theNE, const TopoDS_Shape& theC, const TopoDS_Edge& theE)
+{
+  double                         aF = 0., aL = 0.;
+  const occ::handle<Geom_Curve>& aC = BRep_Tool::Curve(theNE, aF, aL);
+  BRepAdaptor_Curve              aOC(theE);
+  if (aC.IsNull())
+  {
+    return false;
+  }
+  // The piece's points across from the edge's.
+  gp_Pnt aP[3];
+  for (int k = 0; k < 3; ++k)
+  {
+    const double                aT = aOC.FirstParameter() + (aOC.LastParameter() - aOC.FirstParameter()) * k / 2.;
+    GeomAPI_ProjectPointOnCurve aProj(aOC.Value(aT), aC, aF, aL);
+    if (aProj.NbPoints() == 0)
+    {
+      return false;
+    }
+    aP[k] = aProj.NearestPoint();
+  }
+  for (int k = 0; k < 3; ++k)
+  {
+    bool bOn = false;
+    for (TopExp_Explorer aExp(theC, TopAbs_EDGE); aExp.More() && !bOn; aExp.Next())
+    {
+      const TopoDS_Edge&             aE  = TopoDS::Edge(aExp.Current());
+      double                         aF2 = 0., aL2 = 0.;
+      const occ::handle<Geom_Curve>& aC2 = BRep_Tool::Curve(aE, aF2, aL2);
+      if (aC2.IsNull())
+      {
+        continue;
+      }
+      const double aTol  = 1.e-4 + BRep_Tool::Tolerance(aE) + BRep_Tool::Tolerance(theNE);
+      double       aDist = std::min(aP[k].Distance(aC2->Value(aF2)), aP[k].Distance(aC2->Value(aL2)));
+      GeomAPI_ProjectPointOnCurve aProj(aP[k], aC2, aF2, aL2);
+      if (aProj.NbPoints() > 0)
+      {
+        aDist = std::min(aDist, aProj.LowerDistance());
+      }
+      bOn = aDist <= aTol;
+    }
+    if (!bOn)
+    {
+      return false;
+    }
+  }
+  return true;
+}
