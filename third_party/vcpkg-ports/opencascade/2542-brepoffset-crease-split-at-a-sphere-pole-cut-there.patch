+//=======================================================================
+// function : CreaseRunsOn
+// purpose  : Whether theE1 and theE2 (consecutive edges of theF at theV)
+//            are one crease split at theV: both between theF and one
+//            other face, and no other edge but degenerated ones at theV,
+//            as the edge where a flat face meets a sphere whose pole lies
+//            on it, split at the pole (mitcad#2542).
+//=======================================================================
+static bool CreaseRunsOn(const TopoDS_Face&        theF,
+                         const TopoDS_Edge&        theE1,
+                         const TopoDS_Edge&        theE2,
+                         const TopoDS_Vertex&      theV,
+                         const BRepOffset_Analyse& theAnalyse)
+{
+  if (theE1.IsSame(theE2) || !theAnalyse.HasAncestor(theV) || !theAnalyse.HasAncestor(theE1)
+      || !theAnalyse.HasAncestor(theE2))
+  {
+    return false;
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(theAnalyse.Ancestors(theV)); it.More(); it.Next())
+  {
+    const TopoDS_Edge& aE = TopoDS::Edge(it.Value());
+    if (!aE.IsSame(theE1) && !aE.IsSame(theE2) && !BRep_Tool::Degenerated(aE))
+    {
+      return false;
+    }
+  }
+  // The other face of each.
+  TopoDS_Shape aOther[2];
+  for (int k = 0; k < 2; ++k)
+  {
+    const NCollection_List<TopoDS_Shape>& aLF = theAnalyse.Ancestors(k == 0 ? theE1 : theE2);
+    if (aLF.Extent() != 2)
+    {
+      return false;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator it(aLF); it.More(); it.Next())
+    {
+      if (!it.Value().IsSame(theF))
+      {
+        aOther[k] = it.Value();
+      }
+    }
+  }
+  return !aOther[0].IsNull() && aOther[0].IsSame(aOther[1]);
+}
+
+//=======================================================================
+// function : MeetOnOneCurve
+// purpose  : Where the images theNE1 and theNE2 of one crease split at
+//            theV (CreaseRunsOn) are two edges on one curve (copies of
+//            the faces' intersection, BRepOffset_Inter3d::ConnexIntByInt
+//            gives each edge a piece of its own), puts on both the vertex
+//            where the one runs on into the other: the point of the curve
+//            nearest to theV, with the orientations theOr1 and theOr2. Their
+//            intersection there is no point but the whole curve, so before
+//            nothing cut them at theV, and each kept the other's arc too
+//            (the full circle where a flat face's offset meets a sphere's,
+//            its pole on the edge: the face's offset a disc, mitcad#2542).
+//            False, and nothing done, where they are not on one curve.
+//=======================================================================
+static bool MeetOnOneCurve(
+  const TopoDS_Edge&                 theNE1,
+  const TopoDS_Edge&                 theNE2,
+  const TopAbs_Orientation           theOr1,
+  const TopAbs_Orientation           theOr2,
+  const TopoDS_Vertex&               theV,
+  const occ::handle<BRepAlgo_AsDes>& theAsDes2d,
+  const double                       theTol,
+  BRepAlgo_Image&                    theImageVV,
+  NCollection_IndexedDataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher>&
+    theDMVV)
+{
+  if (theNE1.IsSame(theNE2) || BRep_Tool::Degenerated(theNE1) || BRep_Tool::Degenerated(theNE2))
+  {
+    return false;
+  }
+  double                        aF[2], aL[2];
+  const occ::handle<Geom_Curve> aC1 = BRep_Tool::Curve(theNE1, aF[0], aL[0]);
+  const occ::handle<Geom_Curve> aC2 = BRep_Tool::Curve(theNE2, aF[1], aL[1]);
+  if (aC1.IsNull() || aC2.IsNull())
+  {
+    return false;
+  }
+  const double aTolE = std::max(theTol, BRep_Tool::Tolerance(theNE1) + BRep_Tool::Tolerance(theNE2));
+  // On one curve: the second's points (its ends and three inside) on the
+  // first's curve, and the other way round.
+  if (aC1 != aC2)
+  {
+    for (int k = 0; k < 2; ++k)
+    {
+      const occ::handle<Geom_Curve>& aFrom = k == 0 ? aC2 : aC1;
+      GeomAPI_ProjectPointOnCurve    aProj;
+      aProj.Init(k == 0 ? aC1 : aC2, k == 0 ? aF[0] : aF[1], k == 0 ? aL[0] : aL[1]);
+      for (int i = 0; i <= 4; ++i)
+      {
+        const double aT = (k == 0 ? aF[1] : aF[0]) + ((k == 0 ? aL[1] : aL[0]) - (k == 0 ? aF[1] : aF[0])) * i / 4.0;
+        aProj.Perform(aFrom->Value(aT));
+        if (aProj.NbPoints() == 0 || aProj.LowerDistance() > aTolE)
+        {
+          return false;
+        }
+      }
+    }
+  }
+  // The point of the curve nearest to the vertex, and its parameter on each.
+  const gp_Pnt aPV = BRep_Tool::Pnt(theV);
+  double       aT[2];
+  gp_Pnt       aP;
+  for (int k = 0; k < 2; ++k)
+  {
+    GeomAPI_ProjectPointOnCurve aProj(aPV, k == 0 ? aC1 : aC2, aF[k], aL[k]);
+    if (aProj.NbPoints() == 0)
+    {
+      return false;
+    }
+    aT[k] = aProj.LowerDistanceParameter();
+    if (k == 0)
+    {
+      aP = aProj.NearestPoint();
+    }
+  }
+  BRep_Builder  aB;
+  TopoDS_Vertex aNewV = BRepLib_MakeVertex(aP);
+  aNewV.Orientation(TopAbs_INTERNAL);
+  aB.UpdateVertex(aNewV, aT[0], theNE1, aTolE);
+  aB.UpdateVertex(aNewV, aT[1], theNE2, aTolE);
+  aB.UpdateVertex(aNewV, std::max(aTolE, aP.Distance(aC2->Value(aT[1]))));
+  NCollection_List<TopoDS_Shape> aLV1, aLV2;
+  aLV1.Append(aNewV.Oriented(theOr1));
+  aLV2.Append(aNewV.Oriented(theOr2));
+  if (theImageVV.HasImage(theV))
+  {
+    theImageVV.Add(theV.Oriented(TopAbs_FORWARD), aNewV.Oriented(TopAbs_FORWARD));
+  }
+  else
+  {
+    theImageVV.Bind(theV.Oriented(TopAbs_FORWARD), aNewV.Oriented(TopAbs_FORWARD));
+  }
+  Store(theNE1, theNE2, aLV1, aLV2, aTolE, theAsDes2d, theDMVV);
+  return true;
+}
