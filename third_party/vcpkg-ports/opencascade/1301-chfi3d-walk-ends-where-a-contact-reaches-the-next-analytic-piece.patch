+// Whether the piece theSD, at its end (theFirst: at its start), has a contact
+// within theTol of the point on the same side where the analytic piece
+// theNext after the guide starts (theFirst: where the one before it ends).
+// Across a slight kink of the spine the walked guide's sections lean against
+// that piece's: one contact reaches the piece's face, at its first point,
+// while the other is still a few micrometres short of it.
+static bool ChFi3d_ReachedAnalyticPiece(const occ::handle<ChFiDS_SurfData>& theSD,
+                                        const occ::handle<ChFiDS_SurfData>& theNext,
+                                        const bool                          theFirst,
+                                        const double                        theTol)
+{
+  if (theSD.IsNull() || theNext.IsNull() || theSD == theNext)
+  {
+    return false;
+  }
+  for (int k = 1; k <= 2; k++)
+  {
+    if (theSD->Vertex(theFirst, k).Point().Distance(theNext->Vertex(!theFirst, k).Point()) <= theTol)
+    {
+      return true;
+    }
+  }
+  return false;
+}
