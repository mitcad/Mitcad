+//! The removed faces (theCaps) that the shape meets only tangentially, each
+//! of their edges bounding one kept face tangent to them there whose offset
+//! does not vanish: the kept faces' offsets run under such a face, parallel
+//! to it at its edges, and never meet it (a top whose edges are all rounded,
+//! the wall no thicker than the rounding). The wall ends there at the
+//! edges' offsets (mitcad#2462).
+static void FindCapsMetTangentially(
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& theCaps,
+  const BRepOffset_Analyse&                                            theAnalyse,
+  const NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>&        theVanished,
+  NCollection_List<TopoDS_Shape>&                                      theFound)
+{
+  for (int i = 1; i <= theCaps.Extent(); ++i)
+  {
+    const TopoDS_Face& aCap    = TopoDS::Face(theCaps(i));
+    bool               bAll    = true;
+    int                aNbEdge = 0;
+    for (TopExp_Explorer aExp(aCap, TopAbs_EDGE); aExp.More() && bAll; aExp.Next())
+    {
+      const TopoDS_Edge& aE = TopoDS::Edge(aExp.Current());
+      if (BRep_Tool::Degenerated(aE))
+      {
+        continue;
+      }
+      if (!theAnalyse.HasAncestor(aE) || theAnalyse.Ancestors(aE).Extent() != 1)
+      {
+        // an edge to another removed face, or a seam
+        bAll = false;
+        break;
+      }
+      const TopoDS_Face& aF = TopoDS::Face(theAnalyse.Ancestors(aE).First());
+      if (theVanished.Contains(aF))
+      {
+        bAll = false;
+        break;
+      }
+      if (BRep_Tool::Continuity(aE, aF, aCap) == GeomAbs_C0 && !ChFi3d::IsTangentFaces(aE, aF, aCap))
+      {
+        bAll = false;
+        break;
+      }
+      ++aNbEdge;
+    }
+    if (bAll && aNbEdge > 0)
+    {
+      theFound.Append(aCap);
+    }
+  }
+}
