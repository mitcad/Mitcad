+//=======================================================================
+// function : DropBranchesAtTangentEnd
+// purpose  : Where the faces of RefEdge are tangent to each other at an end
+//            of it (two roundings mitred at a corner, both tangent there to
+//            a face that is removed or to a common neighbour; mitcad#2462),
+//            their offsets touch at that end's offset point, and the
+//            intersection of the enlarged offsets is two curves crossing
+//            there: the branch along the edge and three more leaving the
+//            point (the other curve, and the run past the end). All are
+//            connected, CheckIntersFF keeps them all, and the offset faces
+//            got no loop from them where no other offset trims them there
+//            (at the edges of a removed face met tangentially). The offset of
+//            the edge ends at that point: of the edges meeting there only the
+//            one that leaves it back along the edge is kept, with the edges
+//            connected to the rest of the branch other than through the
+//            point. Only where the faces are tangent at the end and not at
+//            the edge's middle, and the branch along the edge reaches the
+//            point; elsewhere nothing changes.
+//=======================================================================
+static void DropBranchesAtTangentEnd(const TopoDS_Edge&                                             RefEdge,
+                                     const TopoDS_Face&                                             RefFace1,
+                                     const TopoDS_Face&                                             RefFace2,
+                                     const TopoDS_Face&                                             OffsetFace1,
+                                     NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& TrueEdges)
+{
+  if (RefEdge.IsNull() || RefFace1.IsNull() || RefFace2.IsNull() || TrueEdges.Extent() < 2
+      || BRep_Tool::Degenerated(RefEdge))
+  {
+    return;
+  }
+  const double aTolAngle = 1.e-4;
+  // The sine of the angle between the faces' normals at a parameter of the
+  // edge, -1 where not computed.
+  const auto aSine = [&](const double theT, gp_Vec& theN) {
+    gp_Vec aN[2];
+    for (int k = 0; k < 2; k++)
+    {
+      const TopoDS_Face&              aF = k == 0 ? RefFace1 : RefFace2;
+      double                          f2d, l2d;
+      const occ::handle<Geom2d_Curve> aPC = BRep_Tool::CurveOnSurface(RefEdge, aF, f2d, l2d);
+      if (aPC.IsNull())
+      {
+        return -1.;
+      }
+      const gp_Pnt2d      aUV = aPC->Value(theT);
+      BRepAdaptor_Surface aS(aF, false);
+      gp_Pnt              aP;
+      gp_Vec              aDU, aDV;
+      aS.D1(aUV.X(), aUV.Y(), aP, aDU, aDV);
+      aN[k] = aDU.Crossed(aDV);
+      if (aN[k].Magnitude() <= gp::Resolution())
+      {
+        return -1.;
+      }
+    }
+    theN = aN[0];
+    return aN[0].Crossed(aN[1]).Magnitude() / (aN[0].Magnitude() * aN[1].Magnitude());
+  };
+  double                         aT1, aT2;
+  const occ::handle<Geom_Curve>& aC = BRep_Tool::Curve(RefEdge, aT1, aT2);
+  if (aC.IsNull())
+  {
+    return;
+  }
+  gp_Vec       aNDummy;
+  const double aSinMid = aSine(0.5 * (aT1 + aT2), aNDummy);
+  if (aSinMid <= aTolAngle)
+  {
+    return;
+  }
+  for (int aEnd = 0; aEnd < 2 && TrueEdges.Extent() > 1; aEnd++)
+  {
+    const double aT = aEnd == 0 ? aT1 : aT2;
+    gp_Vec       aN;
+    const double aSinEnd = aSine(aT, aN);
+    if (aSinEnd < 0. || aSinEnd > aTolAngle)
+    {
+      continue;
+    }
+    // The direction into the edge at that end.
+    gp_Pnt aPEnd;
+    gp_Vec aIn;
+    aC->D1(aT, aPEnd, aIn);
+    if (aEnd == 1)
+    {
+      aIn.Reverse();
+    }
+    if (aIn.Magnitude() <= gp::Resolution())
+    {
+      continue;
+    }
+    aIn.Normalize();
+    // The point where the offsets touch: the end's nearest point on the
+    // offset surface (along the common normal).
+    GeomAPI_ProjectPointOnSurf aOnOffset(aPEnd, BRep_Tool::Surface(OffsetFace1));
+    if (!aOnOffset.IsDone() || aOnOffset.NbPoints() == 0)
+    {
+      continue;
+    }
+    const gp_Pnt aPQ   = aOnOffset.NearestPoint();
+    const double aNear = std::max(1.e-4, 1.e-3 * aOnOffset.LowerDistance());
+    // The edges with a vertex at that point, and whether each leaves it
+    // back along the edge (its middle on the inner side of the point).
+    NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aAtPoint, aDrop;
+    for (int i = 1; i <= TrueEdges.Extent(); i++)
+    {
+      const TopoDS_Edge& aE = TopoDS::Edge(TrueEdges(i));
+      bool               bAt = false;
+      for (TopExp_Explorer aV(aE, TopAbs_VERTEX); aV.More() && !bAt; aV.Next())
+      {
+        bAt = BRep_Tool::Pnt(TopoDS::Vertex(aV.Current())).Distance(aPQ) <= aNear;
+      }
+      if (!bAt)
+      {
+        continue;
+      }
+      aAtPoint.Add(aE);
+      BRepAdaptor_Curve aEC(aE);
+      const gp_Vec      aToMid(aPQ, aEC.Value(0.5 * (aEC.FirstParameter() + aEC.LastParameter())));
+      if (aToMid.Magnitude() <= aNear || aToMid.Dot(aIn) < 0.25 * aToMid.Magnitude())
+      {
+        aDrop.Add(aE);
+      }
+    }
+    // Only where the branch along the edge reaches the point and others
+    // leave it.
+    if (aDrop.IsEmpty() || aDrop.Extent() == aAtPoint.Extent())
+    {
+      continue;
+    }
+    // The edges connected to the kept ones other than through the point.
+    NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher> aKept;
+    for (NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>::Iterator aIt(aAtPoint); aIt.More(); aIt.Next())
+    {
+      if (!aDrop.Contains(aIt.Value()))
+      {
+        aKept.Add(aIt.Value());
+      }
+    }
+    for (int iK = 1; iK <= aKept.Extent(); iK++)
+    {
+      for (TopExp_Explorer aVK(aKept(iK), TopAbs_VERTEX); aVK.More(); aVK.Next())
+      {
+        const TopoDS_Shape& aV = aVK.Current();
+        if (BRep_Tool::Pnt(TopoDS::Vertex(aV)).Distance(aPQ) <= aNear)
+        {
+          continue;
+        }
+        for (int i = 1; i <= TrueEdges.Extent(); i++)
+        {
+          if (aKept.Contains(TrueEdges(i)) || aDrop.Contains(TrueEdges(i)))
+          {
+            continue;
+          }
+          for (TopExp_Explorer aV2(TrueEdges(i), TopAbs_VERTEX); aV2.More(); aV2.Next())
+          {
+            if (aV2.Current().IsSame(aV))
+            {
+              aKept.Add(TrueEdges(i));
+              break;
+            }
+          }
+        }
+      }
+    }
+    if (TracingCrease())
+    {
+      std::fprintf(stderr,
+                   "offset crease: faces tangent at an end, the offsets touching at (%.6f %.6f %.6f): %d of %d "
+                   "edges kept\n",
+                   aPQ.X(), aPQ.Y(), aPQ.Z(), aKept.Extent(), TrueEdges.Extent());
+    }
+    TrueEdges = aKept;
+  }
+}
