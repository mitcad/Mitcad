+// The range of curve Ic of the data structure: its own, or that of the
+// points at its ends (its first and its last).
+static bool curveRange(const TopOpeBRepDS_DataStructure& DStr, const int Ic, double& F, double& L)
+{
+  if (DStr.Curve(Ic).Range(F, L))
+  {
+    return true;
+  }
+  bool aF = false, aL = false;
+  for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator it(DStr.CurveInterferences(Ic));
+       it.More();
+       it.Next())
+  {
+    const occ::handle<TopOpeBRepDS_CurvePointInterference> I =
+      occ::down_cast<TopOpeBRepDS_CurvePointInterference>(it.Value());
+    if (I.IsNull())
+    {
+      continue;
+    }
+    if (I->Transition().Orientation(TopAbs_IN) == TopAbs_FORWARD && !aF)
+    {
+      F  = I->Parameter();
+      aF = true;
+    }
+    else if (I->Transition().Orientation(TopAbs_IN) == TopAbs_REVERSED && !aL)
+    {
+      L  = I->Parameter();
+      aL = true;
+    }
+  }
+  return aF && aL && L > F;
+}
+
+// Whether curves Ic1 and Ic2 of the data structure are one within Tol: the
+// ends of Ic1 those of Ic2, points of Ic1 between them on Ic2; theSameWay
+// where their starts meet. Their ranges in F1, L1 and F2, L2.
+static bool sameCurve(const TopOpeBRepDS_DataStructure& DStr,
+                      const int                         Ic1,
+                      const int                         Ic2,
+                      const double                      Tol,
+                      bool&                             theSameWay,
+                      double&                           f1,
+                      double&                           l1,
+                      double&                           f2,
+                      double&                           l2)
+{
+  const occ::handle<Geom_Curve>& C1 = DStr.Curve(Ic1).Curve();
+  const occ::handle<Geom_Curve>& C2 = DStr.Curve(Ic2).Curve();
+  if (C1.IsNull() || C2.IsNull() || !curveRange(DStr, Ic1, f1, l1) || !curveRange(DStr, Ic2, f2, l2))
+  {
+    return false;
+  }
+  const gp_Pnt a1 = C1->Value(f1), b1 = C1->Value(l1), a2 = C2->Value(f2), b2 = C2->Value(l2);
+  theSameWay      = a1.Distance(a2) <= Tol && b1.Distance(b2) <= Tol;
+  if (!theSameWay && (a1.Distance(b2) > Tol || b1.Distance(a2) > Tol))
+  {
+    return false;
+  }
+  for (int i = 1; i < 8; i++)
+  {
+    GeomAPI_ProjectPointOnCurve aProj(C1->Value(f1 + (l1 - f1) * i / 8.), C2, f2, l2);
+    if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Removes the interferences on geometry I of kind T from list L.
+static void removeInterferences(NCollection_List<occ::handle<TopOpeBRepDS_Interference>>& L,
+                                const TopOpeBRepDS_Kind                                   T,
+                                const int                                                 I)
+{
+  for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator it(L); it.More();)
+  {
+    if (it.Value()->GeometryType() == T && it.Value()->Geometry() == I)
+    {
+      L.Remove(it);
+    }
+    else
+    {
+      it.Next();
+    }
+  }
+}
