+// Stripes the corners at both their ends cut down to nothing: one SurfData
+// whose contacts are points, its end curves one curve twice (a short edge
+// rounded between the sphere of the corner at one end and the corner of
+// riders at the other, which cuts it where its contacts meet the lines the
+// riders ride on, at the sphere's section). Its surface would make a face of
+// no area between the corners: it is dropped, and the corner at one end
+// takes the curve of the corner at the other end instead of its own (their
+// points are one already: the riders' points at the lines' ends are those
+// of the stripes ridden on, ApplyRides).
+static void dropStripesCutToNothing(TopOpeBRepDS_DataStructure&                         DStr,
+                                    const NCollection_List<occ::handle<ChFiDS_Stripe>>& Stripes,
+                                    const NCollection_List<occ::handle<ChFiDS_Stripe>>& Dropped,
+                                    const double                                        Tol)
+{
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itS(Stripes); itS.More(); itS.Next())
+  {
+    const occ::handle<ChFiDS_Stripe>& S = itS.Value();
+    if (Dropped.Contains(S) || S->SetOfSurfData().IsNull() || S->SetOfSurfData()->Length() != 1)
+    {
+      continue;
+    }
+    const occ::handle<ChFiDS_SurfData>& Fd  = S->SetOfSurfData()->Value(1);
+    const int                           Ic1 = S->Curve(true), Ic2 = S->Curve(false);
+    if (Ic1 <= 0 || Ic2 <= 0 || Ic1 == Ic2)
+    {
+      continue;
+    }
+    bool aPoints = true;
+    for (int k = 1; k <= 2 && aPoints; k++)
+    {
+      aPoints = Fd->Vertex(true, k).Point().Distance(Fd->Vertex(false, k).Point()) <= Tol;
+    }
+    bool   aSameWay = true;
+    double f[2] = {0., 0.}, l[2] = {0., 0.};
+    if (!aPoints || !sameCurve(DStr, Ic1, Ic2, Tol, aSameWay, f[0], l[0], f[1], l[1]))
+    {
+      continue;
+    }
+    const int Isurf = Fd->Surf();
+    // The other surfaces on one of the two curves take the other one, with
+    // p-curves of their own along it (the first end's curve kept, or else,
+    // where a p-curve along it is not found, the last end's).
+    NCollection_List<std::pair<int, occ::handle<TopOpeBRepDS_Interference>>> aNew;
+    int                                                                       aGone = 0;
+    for (int k = 0; k < 2 && aGone == 0; k++)
+    {
+      const int aKeep = k == 0 ? Ic1 : Ic2, aDrop = k == 0 ? Ic2 : Ic1;
+      bool      aDone = true;
+      aNew.Clear();
+      // (Nothing is changed before both curves' users are known: a failure
+      // here leaves the stripe as it is.)
+      try
+      {
+        OCC_CATCH_SIGNALS
+        const occ::handle<Geom_Curve> CK = new Geom_TrimmedCurve(DStr.Curve(aKeep).Curve(), f[k], l[k]);
+        for (int js = 1; js <= DStr.NbSurfaces() && aDone; js++)
+        {
+          if (js == Isurf)
+          {
+            continue;
+          }
+          for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator it(
+                 DStr.SurfaceInterferences(js));
+               it.More() && aDone;
+               it.Next())
+          {
+            if (it.Value()->GeometryType() != TopOpeBRepDS_CURVE || it.Value()->Geometry() != aDrop)
+            {
+              continue;
+            }
+            const occ::handle<Geom2d_Curve> aPC =
+              GeomProjLib::Curve2d(CK, f[k], l[k], DStr.Surface(js).Surface());
+            aDone = !aPC.IsNull();
+            if (aDone)
+            {
+              const TopAbs_Orientation anO = it.Value()->Transition().Orientation(TopAbs_IN);
+              aNew.Append(std::make_pair(js,
+                                         occ::handle<TopOpeBRepDS_Interference>(ChFi3d_FilCurveInDS(
+                                           aKeep, js, aPC, aSameWay ? anO : TopAbs::Reverse(anO)))));
+            }
+          }
+        }
+      }
+      catch (Standard_Failure const&)
+      {
+        aDone = false;
+      }
+      if (aDone && !aNew.IsEmpty())
+      {
+        aGone = aDrop;
+      }
+    }
+    if (aGone == 0)
+    {
+      continue;
+    }
+    for (int js = 1; js <= DStr.NbSurfaces(); js++)
+    {
+      removeInterferences(DStr.ChangeSurfaceInterferences(js), TopOpeBRepDS_CURVE, aGone);
+    }
+    for (NCollection_List<std::pair<int, occ::handle<TopOpeBRepDS_Interference>>>::Iterator it(aNew);
+         it.More();
+         it.Next())
+    {
+      DStr.ChangeSurfaceInterferences(it.Value().first).Append(it.Value().second);
+    }
+    DStr.ChangeCurveInterferences(aGone).Clear();
+    // The stripe's surface goes, and its contacts (points) with it.
+    DStr.ChangeSurfaceInterferences(Isurf).Clear();
+    removeInterferences(DStr.ChangeShapeInterferences(S->SolidIndex()), TopOpeBRepDS_SURFACE, Isurf);
+    for (int k = 1; k <= 2; k++)
+    {
+      const int Ic = Fd->Interference(k).LineIndex();
+      if (Ic <= 0)
+      {
+        continue;
+      }
+      DStr.ChangeCurveInterferences(Ic).Clear();
+      if (Fd->Index(k) > 0)
+      {
+        removeInterferences(DStr.ChangeShapeInterferences(Fd->Index(k)), TopOpeBRepDS_CURVE, Ic);
+      }
+    }
+  }
+}
