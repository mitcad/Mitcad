+    size_t                               myNbOutOfMemory;
     std::atomic<int>                     myUsageCounter;
     bool                                 myIsStarted;
     bool                                 myToCatchFpe;
diff --git a/src/FoundationClasses/TKernel/Standard/Standard_OutOfMemory.cxx b/src/FoundationClasses/TKernel/Standard/Standard_OutOfMemory.cxx
index eb61baf..d88a08e 100644
--- a/src/FoundationClasses/TKernel/Standard/Standard_OutOfMemory.cxx
+++ b/src/FoundationClasses/TKernel/Standard/Standard_OutOfMemory.cxx
@@ -24,6 +24,8 @@ namespace
 {
 //! Instances constructed in the process (copies not counted).
 std::atomic<size_t> THE_NB_RAISED{0};
+//! Those of this thread and of the jobs it had other threads run.
+thread_local size_t THE_NB_RAISED_IN_THREAD = 0;
 } // namespace
 
 //=================================================================================================
@@ -31,6 +33,7 @@ std::atomic<size_t> THE_NB_RAISED{0};
 Standard_OutOfMemory::Standard_OutOfMemory(const char* const theMessage)
 {
   THE_NB_RAISED.fetch_add(1, std::memory_order_relaxed);
+  ++THE_NB_RAISED_IN_THREAD;
   myBuffer[0] = '\0';
   // call explicitly own method (non-virtual call)
   Standard_OutOfMemory::SetMessageString(theMessage);
@@ -45,6 +48,20 @@ size_t Standard_OutOfMemory::NbRaised() noexcept
 
 //=================================================================================================
 
+size_t Standard_OutOfMemory::NbRaisedInThread() noexcept
+{
+  return THE_NB_RAISED_IN_THREAD;
+}
+
+//=================================================================================================
+
+void Standard_OutOfMemory::AddRaisedInThread(const size_t theNb) noexcept
+{
+  THE_NB_RAISED_IN_THREAD += theNb;
+}
+
+//=================================================================================================
+
 const char* Standard_OutOfMemory::what() const noexcept
 {
   return myBuffer;
diff --git a/src/FoundationClasses/TKernel/Standard/Standard_OutOfMemory.hxx b/src/FoundationClasses/TKernel/Standard/Standard_OutOfMemory.hxx
index 21ec2ad..f962aa1 100644
--- a/src/FoundationClasses/TKernel/Standard/Standard_OutOfMemory.hxx
+++ b/src/FoundationClasses/TKernel/Standard/Standard_OutOfMemory.hxx
@@ -63,6 +63,16 @@ public:
   //! out inside it, on any thread.
   Standard_EXPORT static size_t NbRaised() noexcept;
 
+  //! Returns how many of these exceptions this thread has constructed, with
+  //! those of the thread pool's jobs it launched and waited for
+  //! (OSD_ThreadPool::Launcher hands them over): the allocations that failed
+  //! under this thread's calls, not under another thread's.
+  Standard_EXPORT static size_t NbRaisedInThread() noexcept;
+
+  //! Adds failed allocations to this thread's count (NbRaisedInThread()):
+  //! those of jobs that other threads ran for it.
+  Standard_EXPORT static void AddRaisedInThread(const size_t theNb) noexcept;
+
 private:
   char myBuffer[1024];
 };
