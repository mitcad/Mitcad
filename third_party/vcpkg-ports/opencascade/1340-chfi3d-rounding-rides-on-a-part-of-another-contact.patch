+// Whether the contact of SurfData P on its side onP, both of whose ends lie
+// inside its face (or on its seam), lies along a part of the contact of
+// SurfData L on its side onL (a closed contact, or a longer one) within Tol:
+// the parameters of that part on L's line, in increasing order (U1 < U2),
+// within L's range; with theWhole, the whole of it too. Not where the part
+// runs over the start of a closed line.
+static bool partOfContact(const TopOpeBRepDS_DataStructure&   DStr,
+                          const occ::handle<ChFiDS_SurfData>& L,
+                          const int                           onL,
+                          const occ::handle<ChFiDS_SurfData>& P,
+                          const int                           onP,
+                          const double                        Tol,
+                          double&                             U1,
+                          double&                             U2,
+                          const bool                          theWhole = false)
+{
+  const ChFiDS_FaceInterference& IL = L->Interference(onL);
+  const ChFiDS_FaceInterference& IP = P->Interference(onP);
+  if (IL.LineIndex() <= 0 || IP.LineIndex() <= 0 || P->Index(onP) <= 0)
+  {
+    return false;
+  }
+  const TopoDS_Shape& aFace = DStr.Shape(P->Index(onP));
+  for (const bool f : {true, false})
+  {
+    const ChFiDS_CommonPoint& CP = P->Vertex(f, onP);
+    if (CP.IsOnArc()
+        && (CP.IsVertex() || aFace.ShapeType() != TopAbs_FACE
+            || !BRep_Tool::IsClosed(CP.Arc(), TopoDS::Face(aFace))))
+    {
+      return false;
+    }
+  }
+  const occ::handle<Geom_Curve>& CL = DStr.Curve(IL.LineIndex()).Curve();
+  const occ::handle<Geom_Curve>& CP = DStr.Curve(IP.LineIndex()).Curve();
+  if (CL.IsNull() || CP.IsNull())
+  {
+    return false;
+  }
+  const double l1 = std::min(IL.FirstParameter(), IL.LastParameter());
+  const double l2 = std::max(IL.FirstParameter(), IL.LastParameter());
+  // (P's contact between its ends: an analytic blend cut at its ends keeps
+  // its line's whole range.)
+  double       aD1 = 0., aD2 = 0.;
+  const double i1 = std::min(IP.FirstParameter(), IP.LastParameter());
+  const double i2 = std::max(IP.FirstParameter(), IP.LastParameter());
+  GeomAPI_ProjectPointOnCurve aEnd1(P->Vertex(true, onP).Point(), CP, i1, i2);
+  GeomAPI_ProjectPointOnCurve aEnd2(P->Vertex(false, onP).Point(), CP, i1, i2);
+  if (aEnd1.NbPoints() == 0 || aEnd2.NbPoints() == 0)
+  {
+    return false;
+  }
+  aD1             = aEnd1.LowerDistance();
+  aD2             = aEnd2.LowerDistance();
+  const double p1 = aEnd1.LowerDistanceParameter(), p2 = aEnd2.LowerDistanceParameter();
+  if (std::max(aD1, aD2) > Tol || l2 - l1 <= Precision::PConfusion()
+      || std::abs(p2 - p1) <= Precision::PConfusion())
+  {
+    return false;
+  }
+  // The points of P's contact along L's line, its ends at both ends of the
+  // samples: their parameters increasing or decreasing all the way.
+  const int aNb = 8;
+  double    u[aNb + 1];
+  for (int i = 0; i <= aNb; i++)
+  {
+    const gp_Pnt aP = i == 0     ? P->Vertex(true, onP).Point()
+                      : i == aNb ? P->Vertex(false, onP).Point()
+                                 : CP->Value(p1 + (p2 - p1) * i / aNb);
+    GeomAPI_ProjectPointOnCurve aProj(aP, CL, l1, l2);
+    if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+    {
+      return false;
+    }
+    u[i] = aProj.LowerDistanceParameter();
+  }
+  // (An end at the start of a closed line may project on either end of
+  // its range: the one beside the samples.)
+  const double aPeriod = l2 - l1;
+  const bool   aClosed = CL->Value(l1).Distance(CL->Value(l2)) <= Tol;
+  for (const int e : {0, aNb})
+  {
+    const double aNear = u[e == 0 ? 1 : aNb - 1];
+    if (aClosed && std::abs(u[e] - aNear) > 0.5 * aPeriod)
+    {
+      u[e] += u[e] < aNear ? aPeriod : -aPeriod;
+    }
+  }
+  const bool anUp = u[aNb] > u[0];
+  for (int i = 1; i <= aNb; i++)
+  {
+    if ((u[i] > u[i - 1]) != anUp)
+    {
+      return false;
+    }
+  }
+  U1 = std::min(u[0], u[aNb]);
+  U2 = std::max(u[0], u[aNb]);
+  const double aSlack = 1.e-9 * aPeriod + Precision::PConfusion();
+  // (A part, not the whole: some of L's line lies past it.)
+  return U1 >= l1 - aSlack && U2 <= l2 + aSlack && (theWhole || U1 > l1 + Tol || U2 < l2 - Tol)
+         && U2 - U1 > Precision::PConfusion();
+}
