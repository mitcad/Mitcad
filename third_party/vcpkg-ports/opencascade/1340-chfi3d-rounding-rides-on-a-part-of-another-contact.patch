+// The surface data of stripe S with a side on face F, in S's order, and
+// those sides; their number.
+static int surfDatasOn(const TopOpeBRepDS_DataStructure&                   DStr,
+                       const occ::handle<ChFiDS_Stripe>&                   S,
+                       const TopoDS_Shape&                                 F,
+                       NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& SDs,
+                       NCollection_Sequence<int>&                          OnS)
+{
+  SDs.Clear();
+  OnS.Clear();
+  if (S->SetOfSurfData().IsNull())
+  {
+    return 0;
+  }
+  for (int i = 1; i <= S->SetOfSurfData()->Length(); i++)
+  {
+    const occ::handle<ChFiDS_SurfData>& aSD = S->SetOfSurfData()->Value(i);
+    for (int k = 1; k <= 2; k++)
+    {
+      if (aSD->Index(k) > 0 && DStr.Shape(aSD->Index(k)).IsSame(F))
+      {
+        SDs.Append(aSD);
+        OnS.Append(k);
+      }
+    }
+  }
+  return SDs.Length();
+}
