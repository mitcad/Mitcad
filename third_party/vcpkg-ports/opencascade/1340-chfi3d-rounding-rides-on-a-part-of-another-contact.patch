+// SurfData I of stripe S split where its line on side onS reaches U1 and U2
+// (U1 < U2, parameters of that line; not at its ends), so that one piece's
+// contact runs from U1 to U2: that piece, null where a split fails (S as
+// it was). The pieces follow each other in S.
+static occ::handle<ChFiDS_SurfData> splitForPart(TopOpeBRepDS_DataStructure&       DStr,
+                                                 const occ::handle<ChFiDS_Stripe>& S,
+                                                 const int                         I,
+                                                 const int                         onS,
+                                                 const double                      U1,
+                                                 const double                      U2)
+{
+  const occ::handle<ChFiDS_SurfData> Fd = S->SetOfSurfData()->Value(I);
+  const ChFiDS_FaceInterference&     FI = Fd->Interference(onS);
+  const double                       t1 = FI.FirstParameter(), t2 = FI.LastParameter();
+  const bool                         forward = t1 <= t2;
+  const double lo = std::min(t1, t2), hi = std::max(t1, t2), aTol = 1.e-7 * (hi - lo);
+  // The cuts in the line's direction. (An array of their own: the elements
+  // of a braced list chosen by ?: would be a temporary gone by the loop.)
+  double       aCuts[2];
+  int          aNb         = 0;
+  const double aInOrder[2] = {forward ? U1 : U2, forward ? U2 : U1};
+  for (const double u : aInOrder)
+  {
+    if (u > lo + aTol && u < hi - aTol)
+    {
+      aCuts[aNb++] = u;
+    }
+  }
+  if (aNb == 0)
+  {
+    return occ::handle<ChFiDS_SurfData>();
+  }
+  // (Copies: undone where a later split fails.)
+  occ::handle<ChFiDS_SurfData> aFirst = new ChFiDS_SurfData();
+  aFirst->Copy(Fd);
+  occ::handle<ChFiDS_SurfData> aPieces[3] = {aFirst, nullptr, nullptr};
+  for (int c = 0; c < aNb; c++)
+  {
+    aPieces[c + 1] = splitSurfDataAt(DStr, aPieces[c], onS, aCuts[c]);
+    if (aPieces[c + 1].IsNull())
+    {
+      return occ::handle<ChFiDS_SurfData>();
+    }
+  }
+  // The part from U1 to U2: the middle of three, or of two the one away
+  // from the end of the line where the part reaches.
+  int aPart = 1;
+  if (aNb == 1)
+  {
+    const bool atStart = forward ? U1 <= lo + aTol : U2 >= hi - aTol;
+    aPart              = atStart ? 0 : 1;
+  }
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq = S->ChangeSetOfSurfData()->ChangeSequence();
+  aSeq.SetValue(I, aPieces[0]);
+  for (int c = aNb; c >= 1; c--)
+  {
+    aSeq.InsertAfter(I, aPieces[c]);
+  }
+  return aPieces[aPart];
+}
