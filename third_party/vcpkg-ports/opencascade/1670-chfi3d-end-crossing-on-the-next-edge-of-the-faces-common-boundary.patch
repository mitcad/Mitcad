+//=======================================================================
+// function : ChFi3d_CrossingOnCommonBoundary
+// purpose  : The blend HGs crosses the curve of E, an edge of the common
+//            boundary of the faces Fa and Fb, past E's end vertex V, where
+//            that boundary goes on in other edges of both faces (a straight
+//            boundary split at a vertex where an edge of a third face ends):
+//            the edge of the chain from V that the blend crosses within its
+//            range (Enext), the crossing's parameter on it (Wnext) and point
+//            on the blend (UVnext), and the edges passed on the way, E first,
+//            each with its vertex towards the crossing (PassedE, PassedV):
+//            they lie under the blend, in the corner it removes. False where
+//            the boundary does not go on at V, or the blend crosses none of a
+//            few edges of the chain.
+//=======================================================================
+
+static bool ChFi3d_CrossingOnCommonBoundary(const TopoDS_Edge&                      E,
+                                            const TopoDS_Vertex&                    V,
+                                            const TopoDS_Face&                      Fa,
+                                            const TopoDS_Face&                      Fb,
+                                            const occ::handle<GeomAdaptor_Surface>& HGs,
+                                            TopoDS_Edge&                            Enext,
+                                            double&                                 Wnext,
+                                            gp_Pnt2d&                               UVnext,
+                                            NCollection_List<TopoDS_Shape>&         PassedE,
+                                            NCollection_List<TopoDS_Shape>&         PassedV)
+{
+  PassedE.Clear();
+  PassedV.Clear();
+  TopoDS_Edge   aCur  = E;
+  TopoDS_Vertex aVCur = V;
+  for (int aStep = 0; aStep < 8; aStep++)
+  {
+    PassedE.Append(aCur);
+    PassedV.Append(aVCur);
+    // The edge of both faces that goes on from aVCur.
+    TopoDS_Edge aNext;
+    for (TopExp_Explorer anExp(Fa, TopAbs_EDGE); anExp.More() && aNext.IsNull(); anExp.Next())
+    {
+      const TopoDS_Edge& anE = TopoDS::Edge(anExp.Current());
+      if (anE.IsSame(aCur) || BRep_Tool::Degenerated(anE) || !containE(Fb, anE))
+      {
+        continue;
+      }
+      TopoDS_Vertex aV1, aV2;
+      TopExp::Vertices(anE, aV1, aV2);
+      if (aV1.IsSame(aVCur) || aV2.IsSame(aVCur))
+      {
+        aNext = anE;
+      }
+    }
+    if (aNext.IsNull())
+    {
+      return false;
+    }
+    double                        aF = 0., aL = 0.;
+    const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(aNext, aF, aL);
+    if (aC.IsNull())
+    {
+      return false;
+    }
+    occ::handle<GeomAdaptor_Curve> aHC = new GeomAdaptor_Curve(aC, aF, aL);
+    IntCurveSurface_HInter         anInters;
+    anInters.Perform(aHC, HGs);
+    if (!anInters.IsDone())
+    {
+      return false;
+    }
+    const double aTolW = std::max(aHC->Resolution(BRep_Tool::Tolerance(aNext)), Precision::PConfusion());
+    const gp_Pnt aPV   = BRep_Tool::Pnt(aVCur);
+    int          aBest = 0;
+    double       aDist = RealLast();
+    for (int i = 1; i <= anInters.NbPoints(); i++)
+    {
+      const double aW = anInters.Point(i).W();
+      if (aW < aF - aTolW || aW > aL + aTolW)
+      {
+        continue;
+      }
+      const double aD = anInters.Point(i).Pnt().Distance(aPV);
+      if (aD < aDist)
+      {
+        aDist = aD;
+        aBest = i;
+      }
+    }
+    if (aBest > 0)
+    {
+      Enext  = aNext;
+      Wnext  = std::min(std::max(anInters.Point(aBest).W(), aF), aL);
+      UVnext = gp_Pnt2d(anInters.Point(aBest).U(), anInters.Point(aBest).V());
+      return true;
+    }
+    // On to the next edge, from aNext's other end.
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(aNext, aV1, aV2);
+    aVCur = aV1.IsSame(aVCur) ? aV2 : aV1;
+    aCur  = aNext;
+  }
+  return false;
+}
