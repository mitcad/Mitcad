+//=======================================================================
+// function : ChFi3d_CutRunOnExtension
+// purpose  : ChFi3d_CutSingularExtension for an end whose blend ran on
+//            past both contacts' edges (mitcad#1425): the faces at the end
+//            cut it beyond those edges, up to where the blend leaves the
+//            body, which may lie close to the singular section. The line
+//            is kept past the last of the edges (theKeep) while its
+//            contacts run at most eight times as fast along the guide as at
+//            the spine's end, measured along the guide's own length (its
+//            extension past the spine need not be parametrised by length:
+//            twice as fast per unit of its parameter stopped the walk round
+//            the reported corner a third of the way to its end). Returns
+//            true where it was cut.
+//=======================================================================
+
+static bool ChFi3d_CutRunOnExtension(occ::handle<BRepBlend_Line>&       Lin,
+                                     const occ::handle<ChFiDS_Spine>&   Spine,
+                                     const occ::handle<ChFiDS_ElSpine>& HGuide,
+                                     const bool                         atEnd,
+                                     const double                       theKeep)
+{
+  if (Lin.IsNull() || Spine.IsNull() || HGuide.IsNull() || Spine->IsPeriodic() || Lin->NbPoints() < 4)
+  {
+    return false;
+  }
+  const auto aSpeed = [&](const Blend_Point& P) {
+    gp_Pnt       aG;
+    gp_Vec       aT;
+    HGuide->D1(P.Parameter(), aG, aT);
+    const double aV = ChFi3d_ContactSpeed(P);
+    return aV >= RealLast() || aT.Magnitude() <= gp::Resolution() ? RealLast() : aV / aT.Magnitude();
+  };
+  const int    nb  = Lin->NbPoints();
+  const double SpF = Spine->FirstParameter(1);
+  const double SpL = Spine->LastParameter(Spine->NbEdges());
+  int          i0  = 0;
+  if (atEnd)
+  {
+    for (int i = 1; i <= nb && Lin->Point(i).Parameter() <= SpL; i++)
+    {
+      i0 = i;
+    }
+  }
+  else
+  {
+    for (int i = nb; i >= 1 && Lin->Point(i).Parameter() >= SpF; i--)
+    {
+      i0 = i;
+    }
+  }
+  if (i0 == 0 || (atEnd ? i0 >= nb : i0 <= 1))
+  {
+    return false;
+  }
+  const double v0 = aSpeed(Lin->Point(i0));
+  if (v0 >= RealLast())
+  {
+    return false;
+  }
+  const int step = atEnd ? 1 : -1;
+  for (int i = i0 + step; i >= 1 && i <= nb; i += step)
+  {
+    const double w = Lin->Point(i).Parameter();
+    if ((atEnd ? w <= theKeep : w >= theKeep) || aSpeed(Lin->Point(i)) <= 8. * v0)
+    {
+      continue;
+    }
+    if (atEnd)
+    {
+      Lin->Remove(i, nb);
+      UpdateLine(Lin, false);
+    }
+    else
+    {
+      Lin->Remove(1, i);
+      UpdateLine(Lin, true);
+    }
+    return true;
+  }
+  return false;
+}
