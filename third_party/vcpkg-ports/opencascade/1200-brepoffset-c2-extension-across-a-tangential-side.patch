+//=======================================================================
+// function : ContinuityAcrossTangentialSides
+// purpose  : The continuity to extend theF's B-spline or Bezier surface at
+//            before its first and after its last U when it is enlarged: 2
+//            on a side that is the iso-line of a tangential edge, 1 (the
+//            default) otherwise. The offset of a surface extended at C1 has
+//            a crease along the junction (its normal turns there); on a
+//            side across a tangential edge the curves where other faces'
+//            offsets cut it end on that edge's offset, just at the crease,
+//            and their approximations running across it came out up to
+//            1e-3 mm off there (mitcad#1202). At C2 the offset is smooth
+//            across the junction.
+//=======================================================================
+static void ContinuityAcrossTangentialSides(const TopoDS_Face&        theF,
+                                            const BRepOffset_Analyse& theAnalyse,
+                                            int&                      theContUfirst,
+                                            int&                      theContUlast)
+{
+  theContUfirst = 1;
+  theContUlast  = 1;
+  occ::handle<Geom_Surface> aS = BRep_Tool::Surface(theF);
+  if (aS->DynamicType() == STANDARD_TYPE(Geom_RectangularTrimmedSurface))
+  {
+    aS = occ::down_cast<Geom_RectangularTrimmedSurface>(aS)->BasisSurface();
+  }
+  if (aS->DynamicType() != STANDARD_TYPE(Geom_BSplineSurface)
+      && aS->DynamicType() != STANDARD_TYPE(Geom_BezierSurface))
+  {
+    return;
+  }
+  double aU1, aU2, aV1, aV2;
+  BRepTools::UVBounds(theF, aU1, aU2, aV1, aV2);
+  for (TopExp_Explorer anExp(theF, TopAbs_EDGE); anExp.More(); anExp.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(anExp.Current());
+    if (BRep_Tool::Degenerated(anE) || !theAnalyse.HasAncestor(anE))
+    {
+      continue;
+    }
+    const NCollection_List<BRepOffset_Interval>& aLI = theAnalyse.Type(anE);
+    if (aLI.Extent() != 1 || aLI.First().Type() != ChFiDS_Tangential)
+    {
+      continue;
+    }
+    double                    aF, aL;
+    occ::handle<Geom2d_Curve> aC = BRep_Tool::CurveOnSurface(anE, theF, aF, aL);
+    if (!aC.IsNull() && aC->DynamicType() == STANDARD_TYPE(Geom2d_TrimmedCurve))
+    {
+      aC = occ::down_cast<Geom2d_TrimmedCurve>(aC)->BasisCurve();
+    }
+    occ::handle<Geom2d_Line> aLine = occ::down_cast<Geom2d_Line>(aC);
+    if (aLine.IsNull() || !aLine->Direction().IsParallel(gp::DY2d(), Precision::Angular()))
+    {
+      continue;
+    }
+    const double aU = aLine->Location().X();
+    if (std::abs(aU - aU1) <= Precision::PConfusion())
+    {
+      theContUfirst = 2;
+    }
+    else if (std::abs(aU - aU2) <= Precision::PConfusion())
+    {
+      theContUlast = 2;
+    }
+  }
+}
