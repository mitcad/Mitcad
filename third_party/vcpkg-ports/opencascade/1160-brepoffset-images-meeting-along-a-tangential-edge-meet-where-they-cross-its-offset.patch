+//=======================================================================
+// function : MeetAlongTangentEdge
+// purpose  : Whether the offsets of the faces beyond theE1 and theE2
+//            (consecutive edges of theF at theV) meet along a tangential
+//            edge ending at theV: theV is a vertex of three edges, theE1,
+//            theE2 and an edge whose two faces are tangent all along it,
+//            the faces beyond theE1 and theE2 (a face of a loft split by
+//            the seam of a circle; mitcad#1199). The offsets of those two
+//            faces share the offset of that edge, so the images of theE1
+//            and theE2 on the offset of theF (where those faces' offsets
+//            cut it) are tangent where they meet.
+//=======================================================================
+static bool MeetAlongTangentEdge(const TopoDS_Face&        theF,
+                                 const TopoDS_Edge&        theE1,
+                                 const TopoDS_Edge&        theE2,
+                                 const TopoDS_Vertex&      theV,
+                                 const BRepOffset_Analyse& theAnalyse)
+{
+  if (!theAnalyse.HasAncestor(theV) || !theAnalyse.HasAncestor(theE1)
+      || !theAnalyse.HasAncestor(theE2))
+  {
+    return false;
+  }
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aVEdges;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(theAnalyse.Ancestors(theV)); it.More(); it.Next())
+  {
+    if (!BRep_Tool::Degenerated(TopoDS::Edge(it.Value())))
+    {
+      aVEdges.Add(it.Value());
+    }
+  }
+  if (aVEdges.Extent() != 3 || !aVEdges.Contains(theE1) || !aVEdges.Contains(theE2))
+  {
+    return false;
+  }
+  // The faces beyond theE1 and theE2.
+  TopoDS_Shape aF[2];
+  for (int k = 0; k < 2; k++)
+  {
+    int aNb = 0;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(theAnalyse.Ancestors(k == 0 ? theE1 : theE2));
+         it.More();
+         it.Next())
+    {
+      if (!it.Value().IsSame(theF))
+      {
+        aF[k] = it.Value();
+        aNb++;
+      }
+    }
+    if (aNb != 1)
+    {
+      return false;
+    }
+  }
+  if (aF[0].IsSame(aF[1]))
+  {
+    return false;
+  }
+  for (NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>::Iterator it(aVEdges); it.More(); it.Next())
+  {
+    const TopoDS_Edge& aE = TopoDS::Edge(it.Key());
+    if (aE.IsSame(theE1) || aE.IsSame(theE2))
+    {
+      continue;
+    }
+    const NCollection_List<BRepOffset_Interval>& aLI = theAnalyse.Type(aE);
+    if (aLI.Extent() != 1 || aLI.First().Type() != ChFiDS_Tangential || !theAnalyse.HasAncestor(aE))
+    {
+      return false;
+    }
+    const NCollection_List<TopoDS_Shape>& aLF = theAnalyse.Ancestors(aE);
+    if (aLF.Extent() != 2)
+    {
+      return false;
+    }
+    return (aLF.First().IsSame(aF[0]) && aLF.Last().IsSame(aF[1]))
+           || (aLF.First().IsSame(aF[1]) && aLF.Last().IsSame(aF[0]));
+  }
+  return false;
+}
+
+//=======================================================================
+// function : IsAnalyticOn
+// purpose  : Whether the curve of theE on theF is a line or a conic,
+//            whose intersections the 2D intersector computes exactly,
+//            also where they are tangent (mitcad#1199).
+//=======================================================================
+static bool IsAnalyticOn(const TopoDS_Edge& theE, const TopoDS_Face& theF)
+{
+  double                          aF, aL;
+  const occ::handle<Geom2d_Curve> aC = BRep_Tool::CurveOnSurface(theE, theF, aF, aL);
+  if (aC.IsNull())
+  {
+    return false;
+  }
+  const GeomAbs_CurveType aType = Geom2dAdaptor_Curve(aC).GetType();
+  return aType == GeomAbs_Line || aType == GeomAbs_Circle || aType == GeomAbs_Ellipse
+         || aType == GeomAbs_Hyperbola || aType == GeomAbs_Parabola;
+}
+
