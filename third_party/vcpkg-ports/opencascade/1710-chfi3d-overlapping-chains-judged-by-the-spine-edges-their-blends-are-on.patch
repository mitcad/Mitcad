+// The edge of spine Sp that bounds face F where surfdata D lies (its side
+// OnS on F): where several edges of the spine bound F (a chain running
+// along F, as round a U-shaped face), the one at D's middle spine
+// parameter when it bounds F, else the one nearest D's contact on F;
+// spineEdgeOf where one edge or none bounds F.
+static TopoDS_Edge spineEdgeOfData(const occ::handle<ChFiDS_Spine>&    Sp,
+                                   const TopoDS_Face&                  F,
+                                   const occ::handle<ChFiDS_SurfData>& D,
+                                   const int                           OnS)
+{
+  NCollection_List<TopoDS_Shape> onF;
+  for (int i = 1; i <= Sp->NbEdges(); i++)
+  {
+    for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(Sp->Edges(i)))
+      {
+        onF.Append(Sp->Edges(i));
+        break;
+      }
+    }
+  }
+  if (onF.Extent() < 2 || D.IsNull())
+  {
+    return onF.IsEmpty() ? TopoDS_Edge() : TopoDS::Edge(onF.First());
+  }
+  const int iE = Sp->Index(0.5 * (D->FirstSpineParam() + D->LastSpineParam()));
+  if (iE >= 1 && iE <= Sp->NbEdges())
+  {
+    for (NCollection_List<TopoDS_Shape>::Iterator it(onF); it.More(); it.Next())
+    {
+      if (it.Value().IsSame(Sp->Edges(iE)))
+      {
+        return TopoDS::Edge(it.Value());
+      }
+    }
+  }
+  const gp_Pnt P = D->Vertex(true, OnS).Point().Translated(
+    0.5 * gp_Vec(D->Vertex(true, OnS).Point(), D->Vertex(false, OnS).Point()));
+  TopoDS_Edge aBest;
+  double      aBestD = RealLast();
+  for (NCollection_List<TopoDS_Shape>::Iterator it(onF); it.More(); it.Next())
+  {
+    const double d = distanceToEdge(P, TopoDS::Edge(it.Value()));
+    if (d < aBestD)
+    {
+      aBestD = d;
+      aBest  = TopoDS::Edge(it.Value());
+    }
+  }
+  return aBest.IsNull() ? TopoDS::Edge(onF.First()) : aBest;
+}
