@@ -2573,6 +2628,10 @@ bool ChFi3d_Builder::KeepFaceAcrossTangentEdge(const occ::handle<ChFiDS_Stripe>&
   NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq = St->ChangeSetOfSurfData()->ChangeSequence();
   const occ::handle<ChFiDS_SurfData> Di = aSeq.Value(i);
   const occ::handle<ChFiDS_SurfData> Dj = aSeq.Value(j);
+  // (The stripe's end curves, already made on the first and last pieces'
+  // surfaces, follow those pieces when the run replaces them.)
+  const bool                         aRunsFromFirst = i == 1;
