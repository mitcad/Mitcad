+//=======================================================================
+// function : endPCurveOnPiece
+// purpose  : The stripe's curve at its first (or last) end lies on the
+//            surface of its first (last) piece: its parameter curve there
+//            made again on that piece's surface, from the piece's contacts
+//            at that end (ChFi3d_MakeExtremities' line between them), for a
+//            piece whose surface replaced the one the curve was made on. The
+//            curve's tolerance covers the new parameter curve. False where
+//            the stripe has no curve at that end or it has no 3D curve.
+//=======================================================================
+
+static bool endPCurveOnPiece(const occ::handle<ChFiDS_Stripe>& St,
+                             const bool                        theFirst,
+                             TopOpeBRepDS_DataStructure&       DStr,
+                             const double                      theTol3d)
+{
+  const int anIc = St->Curve(theFirst);
+  if (anIc == 0)
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve>& aC3d = DStr.Curve(anIc).Curve();
+  if (aC3d.IsNull())
+  {
+    return false;
+  }
+  const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq = St->SetOfSurfData()->Sequence();
+  const occ::handle<ChFiDS_SurfData>& aPiece = theFirst ? aSeq.First() : aSeq.Last();
+  const ChFiDS_FaceInterference&      aFi1   = aPiece->InterferenceOnS1();
+  const ChFiDS_FaceInterference&      aFi2   = aPiece->InterferenceOnS2();
+  if (aFi1.PCurveOnSurf().IsNull() || aFi2.PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d aUV1 =
+    aFi1.PCurveOnSurf()->Value(theFirst ? aFi1.FirstParameter() : aFi1.LastParameter());
+  const gp_Pnt2d aUV2 =
+    aFi2.PCurveOnSurf()->Value(theFirst ? aFi2.FirstParameter() : aFi2.LastParameter());
+  double aPardeb = 0., aParfin = 0.;
+  St->Parameters(theFirst, aPardeb, aParfin);
+  double aTolReached = 0.;
+  ChFi3d_ComputePCurv(aC3d,
+                      aUV1,
+                      aUV2,
+                      St->ChangePCurve(theFirst),
+                      DStr.Surface(aPiece->Surf()).Surface(),
+                      aPardeb,
+                      aParfin,
+                      theTol3d,
+                      aTolReached);
+  TopOpeBRepDS_Curve& aCurve = DStr.ChangeCurve(anIc);
+  aCurve.Tolerance(std::max(aCurve.Tolerance(), aTolReached));
+  return true;
+}
+
