 //=======================================================================
+// function : IndexOfSurfDataAtEnd
+// purpose  : Index of the surface data at the end <theSens> (1: first,
+//           -1: last) of a stripe. A contour closed by a sharp corner has
+//           both its ends at the corner's vertex, which
+//           ChFi3d_IndexOfSurfData cannot tell apart: the corner keeps the
+//           end it found for each of its edges.
+//=======================================================================
+
+static int IndexOfSurfDataAtEnd(const occ::handle<ChFiDS_Stripe>& theStripe, const int theSens)
+{
+  return theSens == 1 ? 1 : theStripe->SetOfSurfData()->Length();
+}
