+//=======================================================================
+// function : ChFi3d_EndStoppedShort
+// purpose  : Whether a stripe's end at a vertex where the face at the end
+//            cuts it (AllSame, OnDiff) stopped at the end of the spine's
+//            extension with a contact still inside its face: the other on
+//            an edge of the vertex, or both inside (mitcad#1256).
+//=======================================================================
+static bool ChFi3d_EndStoppedShort(const occ::handle<ChFiDS_Stripe>& theStripe,
+                                   const bool                        isFirst,
+                                   const double                      theTol)
+{
+  const occ::handle<ChFiDS_Spine>& aSp    = theStripe->Spine();
+  const ChFiDS_State               aState = isFirst ? aSp->FirstStatus() : aSp->LastStatus();
+  if ((aState != ChFiDS_AllSame && aState != ChFiDS_OnDiff) || theStripe->SetOfSurfData().IsNull()
+      || theStripe->SetOfSurfData()->IsEmpty())
+  {
+    return false;
+  }
+  // (The spine prolonged at that end, the walk up to the prolongation's end.)
+  const double aW0 = isFirst ? 0. : aSp->LastParameter(aSp->NbEdges());
+  const double aW1 = isFirst ? aSp->FirstParameter() : aSp->LastParameter();
+  const occ::handle<ChFiDS_SurfData>& SD =
+    isFirst ? theStripe->SetOfSurfData()->First() : theStripe->SetOfSurfData()->Last();
+  const double aWs = isFirst ? SD->FirstSpineParam() : SD->LastSpineParam();
+  if (std::abs(aW1 - aW0) <= theTol || (isFirst ? aWs > aW1 + theTol : aWs < aW1 - theTol))
+  {
+    return false;
+  }
+  const TopoDS_Vertex&      aV  = isFirst ? aSp->FirstVertex() : aSp->LastVertex();
+  const ChFiDS_CommonPoint& CP1 = SD->Vertex(isFirst, 1);
+  const ChFiDS_CommonPoint& CP2 = SD->Vertex(isFirst, 2);
+  if (CP1.IsOnArc() && CP2.IsOnArc())
+  {
+    return false;
+  }
+  if (!CP1.IsOnArc() && !CP2.IsOnArc())
+  {
+    // (Both still inside their faces.)
+    return true;
+  }
+  const ChFiDS_CommonPoint& aOn = CP1.IsOnArc() ? CP1 : CP2;
+  for (TopExp_Explorer anEx(aOn.Arc(), TopAbs_VERTEX); anEx.More(); anEx.Next())
+  {
+    if (anEx.Current().IsSame(aV))
+    {
+      return true;
+    }
+  }
+  return false;
+}
