+static occ::handle<Geom_Surface> ChFi3d_WideSurface(const TopoDS_Face& F);
+
+//=======================================================================
+// function : ChFi3d_CutBySections
+// purpose  : The cut of a walked blend's surface S by face B's surface,
+//            from uv1 to uv2 on S, found section by section: on each
+//            isoline of S's coordinate along the spine (Coord: 1 for u, 2
+//            for v) between theirs, the point where the section crosses
+//            B's surface (unbounded, ChFi3d_WideSurface). Where the cut
+//            starts at the point where the blend's contact crosses onto B
+//            across a tangent edge, B bending towards the ball more sharply
+//            than the ball (mitcad#1413), the surfaces meet tangentially
+//            there and GeomInt_IntSS's line stops short of it (by 0.006 mm
+//            there); section by section the cut reaches it: on each
+//            section the first crossing from the other contact's side (its
+//            coordinate across aOther; near the contact crossing onto B the
+//            surfaces are nearly tangent), with its foot on B. Cc runs from
+//            uv1's point to uv2's (uvB1 and uvB2 on B), with Ps its p-curve
+//            on S and Pc its p-curve on B's surface through the feet.
+//=======================================================================
+
+static bool ChFi3d_CutBySections(const occ::handle<Geom_Surface>& S,
+                                 const TopoDS_Face&               B,
+                                 const gp_Pnt2d&                  uv1,
+                                 const gp_Pnt2d&                  uvB1,
+                                 const gp_Pnt2d&                  uv2,
+                                 const gp_Pnt2d&                  uvB2,
+                                 const int                        Coord,
+                                 const double                     aOther,
+                                 const double                     tol3d,
+                                 occ::handle<Geom_Curve>&         Cc,
+                                 occ::handle<Geom2d_Curve>&       Ps,
+                                 occ::handle<Geom2d_Curve>&       Pc,
+                                 double&                          tolreached)
+{
+  TopoDS_Face BF = B;
+  BF.Orientation(TopAbs_FORWARD);
+  const occ::handle<Geom_Surface> SB = BRep_Tool::Surface(BF);
+  const occ::handle<Geom_Surface> SW = ChFi3d_WideSurface(BF);
+  if (S.IsNull() || SB.IsNull() || SW.IsNull())
+  {
+    return false;
+  }
+  double su1 = 0., su2 = 0., sv1 = 0., sv2 = 0.;
+  S->Bounds(su1, su2, sv1, sv2);
+  // (The coordinate across the spine runs from one contact to the other.)
+  const double aLo = Coord == 1 ? sv1 : su1, aHi = Coord == 1 ? sv2 : su2;
+  const double c1 = Coord == 1 ? uv1.X() : uv1.Y(), c2 = Coord == 1 ? uv2.X() : uv2.Y();
+  const double a1 = Coord == 1 ? uv1.Y() : uv1.X(), a2 = Coord == 1 ? uv2.Y() : uv2.X();
+  if (std::abs(c2 - c1) <= Precision::PConfusion() || Precision::IsInfinite(aLo) || Precision::IsInfinite(aHi)
+      || aHi - aLo <= Precision::PConfusion())
+  {
+    return false;
+  }
+  const auto pointAt = [&](const double a, const double c) { return Coord == 1 ? S->Value(c, a) : S->Value(a, c); };
+  // (The signed distance of a point of S from B's surface, and its foot
+  // there: found from the last one, the points moving little from one to
+  // the next.)
+  GeomAdaptor_Surface    aGW(SW);
+  Extrema_GenLocateExtPS aLoc(aGW, Precision::PConfusion(), Precision::PConfusion());
+  bool                   aSeeded = false;
+  double                 uSeed = 0., vSeed = 0.;
+  const auto             distanceAt = [&](const double a, const double c, double& d) {
+    const gp_Pnt P = pointAt(a, c);
+    double       u = 0., v = 0.;
+    bool         located = false;
+    if (aSeeded)
+    {
+      aLoc.Perform(P, uSeed, vSeed);
+      if (aLoc.IsDone())
+      {
+        aLoc.Point().Parameter(u, v);
+        located = true;
+      }
+    }
+    if (!located)
+    {
+      GeomAPI_ProjectPointOnSurf aPr(P, SW);
+      if (aPr.NbPoints() == 0)
+      {
+        return false;
+      }
+      aPr.LowerDistanceParameters(u, v);
+    }
+    gp_Pnt Q;
+    gp_Vec DU, DV;
+    SW->D1(u, v, Q, DU, DV);
+    const gp_Vec aN = DU.Crossed(DV);
+    if (aN.Magnitude() <= gp::Resolution())
+    {
+      return false;
+    }
+    aSeeded = true;
+    uSeed   = u;
+    vSeed   = v;
+    d       = gp_Vec(Q, P).Dot(aN.Normalized());
+    return true;
+  };
+  // The sections, closer together towards the ends (where the cut may leave
+  // a contact tangentially): on each the first crossing from the other
+  // contact's side, refined, and its foot on B.
+  const bool                     fromHi = std::abs(aOther - aHi) <= std::abs(aOther - aLo);
+  const int                      n = 48, nbs = 200;
+  NCollection_Sequence<double>   aA, aC;
+  NCollection_Sequence<gp_Pnt2d> aF;
+  aA.Append(a1);
+  aC.Append(c1);
+  aF.Append(uvB1);
+  for (int i = 1; i < n; i++)
+  {
+    const double c       = c1 + (c2 - c1) * 0.5 * (1. - std::cos(M_PI * i / n));
+    double       dPrev   = 0., aPrevS = 0.;
+    bool         hasPrev = false, found = false;
+    double       aRoot   = 0.;
+    // (The section's first foot found anew.)
+    aSeeded = false;
+    for (int k = 0; k <= nbs && !found; k++)
+    {
+      const double a = fromHi ? aHi - (aHi - aLo) * k / nbs : aLo + (aHi - aLo) * k / nbs;
+      double       d = 0.;
+      if (!distanceAt(a, c, d))
+      {
+        hasPrev = false;
+        continue;
+      }
+      if (hasPrev && (d == 0. || (d > 0.) != (dPrev > 0.)))
+      {
+        double lo = aPrevS, hi = a, dlo = dPrev;
+        for (int it = 0; it < 60; it++)
+        {
+          const double m  = 0.5 * (lo + hi);
+          double       dm = 0.;
+          if (!distanceAt(m, c, dm))
+          {
+            break;
+          }
+          if ((dm > 0.) == (dlo > 0.))
+          {
+            lo  = m;
+            dlo = dm;
+          }
+          else
+          {
+            hi = m;
+          }
+        }
+        aRoot = 0.5 * (lo + hi);
+        double d0 = 0.;
+        found = distanceAt(aRoot, c, d0);
+      }
+      dPrev   = d;
+      aPrevS  = a;
+      hasPrev = true;
+    }
+    if (found)
+    {
+      aA.Append(aRoot);
+      aC.Append(c);
+      aF.Append(gp_Pnt2d(uSeed, vSeed));
+    }
+  }
+  aA.Append(a2);
+  aC.Append(c2);
+  aF.Append(uvB2);
+  if (aA.Length() < n / 2)
+  {
+    return false;
+  }
+  // Through the points, by their chord lengths, on S and on B.
+  const int                                  np      = aA.Length();
+  occ::handle<NCollection_HArray1<gp_Pnt2d>> aPnts   = new NCollection_HArray1<gp_Pnt2d>(1, np);
+  occ::handle<NCollection_HArray1<gp_Pnt2d>> aFeet   = new NCollection_HArray1<gp_Pnt2d>(1, np);
+  occ::handle<NCollection_HArray1<double>>   aParams = new NCollection_HArray1<double>(1, np);
+  double                                     aLen    = 0.;
+  for (int i = 1; i <= np; i++)
+  {
+    const double a = aA.Value(i), c = aC.Value(i);
+    aPnts->SetValue(i, Coord == 1 ? gp_Pnt2d(c, a) : gp_Pnt2d(a, c));
+    aFeet->SetValue(i, aF.Value(i));
+    if (i > 1)
+    {
+      const double d = pointAt(a, c).Distance(pointAt(aA.Value(i - 1), aC.Value(i - 1)));
+      if (d <= Precision::Confusion())
+      {
+        return false;
+      }
+      aLen += d;
+    }
+    aParams->SetValue(i, aLen);
+  }
+  Geom2dAPI_Interpolate anInterpS(aPnts, aParams, false, Precision::PConfusion());
+  anInterpS.Perform();
+  Geom2dAPI_Interpolate anInterpB(aFeet, aParams, false, Precision::PConfusion());
+  anInterpB.Perform();
+  if (!anInterpS.IsDone() || !anInterpB.IsDone())
+  {
+    return false;
+  }
+  Ps = anInterpS.Curve();
+  Pc = anInterpB.Curve();
+  occ::handle<Geom2dAdaptor_Curve> aHPs = new Geom2dAdaptor_Curve(Ps, 0., aLen);
+  occ::handle<GeomAdaptor_Surface> aHS  = new GeomAdaptor_Surface(S);
+  Adaptor3d_CurveOnSurface         aCOS(aHPs, aHS);
+  double                           aMaxDev = 0., anAvDev = 0.;
+  GeomLib::BuildCurve3d(Precision::Confusion(), aCOS, 0., aLen, Cc, aMaxDev, anAvDev);
+  if (Cc.IsNull())
+  {
+    return false;
+  }
+  // (The tolerance covers the curve's distance from both p-curves.)
+  double aDev = aMaxDev;
+  for (int i = 0; i <= 200; i++)
+  {
+    const double   t = aLen * i / 200.;
+    const gp_Pnt2d p = Pc->Value(t);
+    aDev             = std::max(aDev, SB->Value(p.X(), p.Y()).Distance(Cc->Value(t)));
+  }
+  tolreached = std::max(tol3d, 1.5 * aDev);
+  return true;
+}
