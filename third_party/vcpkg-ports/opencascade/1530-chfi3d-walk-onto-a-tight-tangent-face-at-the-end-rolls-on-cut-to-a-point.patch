+// Whether the contact of SD's end (its start with isFirst) on side ons left
+// its face F across a tangent edge onto a face B that holds the spine's end
+// vertex the walk heads for and borders an edge of the spine, F bordering
+// none, where the ball of the rounding's constant radius cannot touch B (it
+// bends towards the ball more sharply than the ball, ballCannotTouch): an
+// earlier rounding of a hole's rim, tighter than the ball, where the hole
+// meets the face of the other contact tangentially at the spine's end
+// vertex (mitcad#1413). The ball rolls on over F's surface past that edge
+// and B cuts the blend (WalkedCutToEnd). B is given back.
+static bool ChFi3d_TightTangentFaceAtEnd(const TopOpeBRepDS_DataStructure&   DStr,
+                                         const occ::handle<ChFiDS_Spine>&    Spine,
+                                         const occ::handle<ChFiDS_SurfData>& SD,
+                                         const bool                          isFirst,
+                                         const int                           ons,
+                                         const ChFiDS_Map&                   EFMap,
+                                         const ChFiDS_Map&                   VFMap,
+                                         TopoDS_Face&                        B)
+{
+  const occ::handle<ChFiDS_FilSpine> fsp = occ::down_cast<ChFiDS_FilSpine>(Spine);
+  if (SD.IsNull() || fsp.IsNull() || !fsp->IsConstant() || Spine->IsPeriodic() || SD->Index(ons) <= 0
+      || SD->Index(3 - ons) <= 0 || SD->IsOnCurve(1) || SD->IsOnCurve(2))
+  {
+    return false;
+  }
+  const ChFiDS_CommonPoint& CP = SD->Vertex(isFirst, ons);
+  const TopoDS_Vertex       V  = isFirst ? Spine->FirstVertex() : Spine->LastVertex();
+  if (!CP.IsOnArc() || CP.IsVertex() || !EFMap.Contains(CP.Arc()) || V.IsNull() || !VFMap.Contains(V))
+  {
+    return false;
+  }
+  const TopoDS_Edge E  = TopoDS::Edge(CP.Arc());
+  const TopoDS_Face F  = TopoDS::Face(DStr.Shape(SD->Index(ons)));
+  TopoDS_Face       Fb = otherFace(EFMap, E, F);
+  if (Fb.IsNull() || Fb.IsSame(F) || !containsSameShape(VFMap(V), Fb) || !faceAlongSpine(Spine, Fb, EFMap)
+      || faceAlongSpine(Spine, F, EFMap) || !ChFi3d::IsTangentFaces(E, F, Fb))
+  {
+    return false;
+  }
+  Fb.Orientation(TopAbs_FORWARD);
+  const occ::handle<Geom2d_Curve> aPC = getCurveOnSurface(edgeInFace(E, Fb), Fb);
+  if (aPC.IsNull()
+      || !ballCannotTouch(F, CP.Point(), SD->Vertex(isFirst, 3 - ons).Point(), Fb, aPC->Value(CP.ParameterOnArc()),
+                          fsp->Radius()))
+  {
+    return false;
+  }
+  B = Fb;
+  return true;
+}
