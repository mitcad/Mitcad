+//=======================================================================
+// function : WalkOverVertex
+// purpose  : A sharp edge E of a corner at V1, between the faces Fa and
+//            Fb, whose other vertex V2 the corner's set-back passes: at V2
+//            E goes on tangentially into the edge E2 of Fa, and Fb goes on
+//            tangentially across the edge Eg into the face Fc of E2 (the
+//            three edges at V2). Then the set-back walks over V2: the
+//            plate's point lies on E2, and its border on the side of Fb
+//            crosses Eg into Fc.
+//=======================================================================
+
+static bool WalkOverVertex(const TopoDS_Vertex& V1,
+                           const TopoDS_Edge&   E,
+                           const TopoDS_Face&   Fa,
+                           const TopoDS_Face&   Fb,
+                           const ChFiDS_Map&    VEMap,
+                           const ChFiDS_Map&    EFMap,
+                           TopoDS_Vertex&       V2,
+                           TopoDS_Edge&         E2,
+                           TopoDS_Edge&         Eg,
+                           TopoDS_Face&         Fc)
+{
+  if (BRep_Tool::Degenerated(E) || Fa.IsSame(Fb))
+  {
+    return false;
+  }
+  const TopoDS_Vertex Vf = TopExp::FirstVertex(E), Vl = TopExp::LastVertex(E);
+  if (Vf.IsNull() || Vl.IsNull() || Vf.IsSame(Vl))
+  {
+    return false;
+  }
+  V2 = Vf.IsSame(V1) ? Vl : Vf;
+  if (!VEMap.Contains(V2))
+  {
+    return false;
+  }
+  // The edges at V2 besides E: exactly two.
+  NCollection_List<TopoDS_Shape> anOthers;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(VEMap(V2)); it.More(); it.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(it.Value());
+    if (anE.IsSame(E) || BRep_Tool::Degenerated(anE))
+    {
+      continue;
+    }
+    bool aKnown = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator itO(anOthers); itO.More() && !aKnown; itO.Next())
+    {
+      aKnown = itO.Value().IsSame(anE);
+    }
+    if (!aKnown)
+    {
+      anOthers.Append(anE);
+    }
+  }
+  if (anOthers.Extent() != 2)
+  {
+    return false;
+  }
+  E2.Nullify();
+  Eg.Nullify();
+  for (NCollection_List<TopoDS_Shape>::Iterator it(anOthers); it.More(); it.Next())
+  {
+    const TopoDS_Edge& anE = TopoDS::Edge(it.Value());
+    if (!EFMap.Contains(anE) || EFMap(anE).Extent() != 2)
+    {
+      return false;
+    }
+    const TopoDS_Face& aF1 = TopoDS::Face(EFMap(anE).First());
+    const TopoDS_Face& aF2 = TopoDS::Face(EFMap(anE).Last());
+    if (aF1.IsSame(Fa) || aF2.IsSame(Fa))
+    {
+      E2 = anE;
+      Fc = aF1.IsSame(Fa) ? aF2 : aF1;
+    }
+    else if (aF1.IsSame(Fb) || aF2.IsSame(Fb))
+    {
+      Eg = anE;
+    }
+  }
+  if (E2.IsNull() || Eg.IsNull() || Fc.IsSame(Fb) || Fc.IsSame(Fa))
+  {
+    return false;
+  }
+  // Eg lies between Fb and Fc, tangentially; E2 goes on along E.
+  const TopoDS_Face& aG1 = TopoDS::Face(EFMap(Eg).First());
+  const TopoDS_Face& aG2 = TopoDS::Face(EFMap(Eg).Last());
+  if (!((aG1.IsSame(Fb) && aG2.IsSame(Fc)) || (aG1.IsSame(Fc) && aG2.IsSame(Fb))))
+  {
+    return false;
+  }
+  if (!ChFi3d::IsTangentFaces(Eg, Fb, Fc))
+  {
+    return false;
+  }
+  return std::abs(std::abs(ChFi3d_AngleEdge(V2, E, E2)) - M_PI) < 0.01;
+}
