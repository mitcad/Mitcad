+//=======================================================================
+// function : ExtendAlong
+// purpose  : The B-spline surface S extended by L beyond its first or
+//            last iso-line across the path (the path along U when InU),
+//            straight along T: the end section moved along T (rows of
+//            poles translated, with the end row's weights), so that the
+//            extensions of a corner's two sides are the prisms of their
+//            end sections. Other surfaces as GeomLib::ExtendSurfByLength
+//            extends them.
+//=======================================================================
+static void ExtendAlong(occ::handle<Geom_BoundedSurface>& S,
+                        const double                      L,
+                        const bool                        InU,
+                        const bool                        After,
+                        const gp_Vec&                     T)
+{
+  occ::handle<Geom_BSplineSurface> B = occ::down_cast<Geom_BSplineSurface>(S);
+  if (B.IsNull() || T.Magnitude() < gp::Resolution())
+  {
+    GeomLib::ExtendSurfByLength(S, L, 1, InU, After);
+    return;
+  }
+  B = occ::down_cast<Geom_BSplineSurface>(B->Copy());
+  if (InU)
+  {
+    B->ExchangeUV();
+  }
+  if (B->IsVPeriodic())
+  {
+    GeomLib::ExtendSurfByLength(S, L, 1, InU, After);
+    return;
+  }
+  const gp_Dir D(T);
+  const int    q   = B->VDegree();
+  const int    nu  = B->NbUPoles();
+  const int    nv  = B->NbVPoles();
+  const int    nvk = B->NbVKnots();
+  double       u0, u1, v0, v1;
+  B->Bounds(u0, u1, v0, v1);
+  gp_Pnt P;
+  gp_Vec Du, Dv;
+  B->D1((u0 + u1) / 2., After ? v1 : v0, P, Du, Dv);
+  const double speed = Dv.Magnitude() > gp::Resolution() ? Dv.Magnitude() : 1.;
+  const double delta = L / speed;
+  NCollection_Array1<double> vk(1, nvk + 1);
+  NCollection_Array1<int>    vm(1, nvk + 1);
+  NCollection_Array2<gp_Pnt> poles(1, nu, 1, nv + q);
+  NCollection_Array2<double> weights(1, nu, 1, nv + q);
+  const int                  shift = After ? 0 : q;
+  for (int k = 1; k <= nvk; ++k)
+  {
+    vk(k + (After ? 0 : 1)) = B->VKnot(k);
+    vm(k + (After ? 0 : 1)) = B->VMultiplicity(k);
+  }
+  if (After)
+  {
+    vm(nvk)     = q;
+    vk(nvk + 1) = v1 + delta;
+    vm(nvk + 1) = q + 1;
+  }
+  else
+  {
+    vm(2) = q;
+    vk(1) = v0 - delta;
+    vm(1) = q + 1;
+  }
+  for (int i = 1; i <= nu; ++i)
+  {
+    for (int j = 1; j <= nv; ++j)
+    {
+      poles(i, j + shift)   = B->Pole(i, j);
+      weights(i, j + shift) = B->Weight(i, j);
+    }
+    for (int j = 1; j <= q; ++j)
+    {
+      const double f = L * j / q;
+      if (After)
+      {
+        poles(i, nv + j)   = B->Pole(i, nv).Translated(gp_Vec(D) * f);
+        weights(i, nv + j) = B->Weight(i, nv);
+      }
+      else
+      {
+        poles(i, q + 1 - j)   = B->Pole(i, 1).Translated(gp_Vec(D) * -f);
+        weights(i, q + 1 - j) = B->Weight(i, 1);
+      }
+    }
+  }
+  const NCollection_Array1<double>& uk = B->UKnots();
+  const NCollection_Array1<int>&    um = B->UMultiplicities();
+  occ::handle<Geom_BSplineSurface>  E = new Geom_BSplineSurface(poles,
+                                                              weights,
+                                                              uk,
+                                                              vk,
+                                                              um,
+                                                              vm,
+                                                              B->UDegree(),
+                                                              q,
+                                                              B->IsUPeriodic(),
+                                                              false);
+  if (InU)
+  {
+    E->ExchangeUV();
+  }
+  S = occ::handle<Geom_BoundedSurface>(E);
+}
