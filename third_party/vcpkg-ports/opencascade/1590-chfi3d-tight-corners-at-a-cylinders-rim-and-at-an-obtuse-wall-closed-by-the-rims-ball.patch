+//=======================================================================
+// function : ExtendAtTightObtuseCorners
+// purpose  : See the header.
+//=======================================================================
+
+void ChFi3d_Builder::ExtendAtTightObtuseCorners()
+{
+  const double tol = std::max(10. * tolapp3d, 1.e-5);
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator it(myListStripe); it.More(); it.Next())
+  {
+    const occ::handle<ChFiDS_FilSpine> sp = it.Value()->Spine().IsNull()
+                                              ? occ::handle<ChFiDS_FilSpine>()
+                                              : occ::down_cast<ChFiDS_FilSpine>(it.Value()->Spine());
+    if (sp.IsNull() || !sp->IsConstant() || sp->IsPeriodic() || sp->GetTypeOfConcavity() == ChFiDS_Concave)
+    {
+      continue;
+    }
+    const double R   = sp->Radius();
+    const double ext = 2. * R;
+    for (const bool isfirst : {true, false})
+    {
+      if ((isfirst ? sp->FirstStatus() : sp->LastStatus()) != ChFiDS_Tangent)
+      {
+        continue;
+      }
+      const TopoDS_Vertex Vx = isfirst ? sp->FirstVertex() : sp->LastVertex();
+      const TopoDS_Edge   Ex = sp->Edges(isfirst ? 1 : sp->NbEdges());
+      if (!myVEMap.Contains(Vx))
+      {
+        continue;
+      }
+      // An obtuse tight arc at Vx between Ex and the end edge of a stripe
+      // of the same radius ending at its other vertex.
+      bool aObtuse = false;
+      for (NCollection_List<TopoDS_Shape>::Iterator itE(myVEMap(Vx)); itE.More() && !aObtuse; itE.Next())
+      {
+        const TopoDS_Edge& E = TopoDS::Edge(itE.Value());
+        if (E.IsSame(Ex) || BRep_Tool::Degenerated(E))
+        {
+          continue;
+        }
+        TopoDS_Vertex v1, v2;
+        TopExp::Vertices(E, v1, v2);
+        const TopoDS_Vertex Vo = v1.IsSame(Vx) ? v2 : v1;
+        for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itT(myListStripe); itT.More() && !aObtuse;
+             itT.Next())
+        {
+          const occ::handle<ChFiDS_FilSpine> sp2 = itT.Value()->Spine().IsNull()
+                                                     ? occ::handle<ChFiDS_FilSpine>()
+                                                     : occ::down_cast<ChFiDS_FilSpine>(itT.Value()->Spine());
+          if (sp2.IsNull() || !sp2->IsConstant() || std::abs(sp2->Radius() - R) > tol)
+          {
+            continue;
+          }
+          for (const bool f2 : {true, false})
+          {
+            if ((f2 ? sp2->FirstStatus() : sp2->LastStatus()) != ChFiDS_Tangent
+                || !(f2 ? sp2->FirstVertex() : sp2->LastVertex()).IsSame(Vo)
+                || (itT.Value() == it.Value() && f2 == isfirst))
+            {
+              continue;
+            }
+            ChFi3d_TightArcData D;
+            if (ChFi3d_TightArc(E, Ex, sp2->Edges(f2 ? 1 : sp2->NbEdges()), myEFMap, R, tol, D) && D.Obtuse)
+            {
+              aObtuse = true;
+              break;
+            }
+          }
+        }
+      }
+      if (!aObtuse)
+      {
+        continue;
+      }
+      if (isfirst && sp->FirstParameter() > -ext)
+      {
+        sp->SetFirstParameter(-ext);
+        sp->SetFirstTgt(0.);
+      }
+      const double dU = sp->LastParameter(sp->NbEdges());
+      if (!isfirst && sp->LastParameter() < dU + ext)
+      {
+        sp->SetLastParameter(dU + ext);
+        sp->SetLastTgt(dU);
+      }
+    }
+  }
+}
