+//=======================================================================
+// function : PerformTightObtuseCorner
+// purpose  : See the header. The corner of tcBuildCorner with the balls
+//            inside the material: K is the ball of its radius rolling
+//            between Wp and Wo; it rolls on between Wo and Wp's blend (the
+//            strip, from K's section where Wp's blend's contact on Wp
+//            reaches K) and then between the two blends (the triangle),
+//            down to where the contacts on U meet. The heights are taken
+//            along U's inward normal.
+//=======================================================================
+
+bool ChFi3d_Builder::PerformTightObtuseCorner(const occ::handle<ChFiDS_Stripe>&             SP,
+                                              const bool                                    FirstP,
+                                              const occ::handle<ChFiDS_Stripe>&             SO,
+                                              const bool                                    FirstO,
+                                              const TopoDS_Edge&                            Ek,
+                                              const TopoDS_Face&                            U,
+                                              const TopoDS_Face&                            K,
+                                              const TopoDS_Face&                            Wp,
+                                              const TopoDS_Face&                            Wo,
+                                              NCollection_List<occ::handle<ChFiDS_Stripe>>& Corners)
+{
+  TCArc D;
+  D.U  = U;
+  D.K  = K;
+  D.Fa = Wp;
+  D.Fb = Wo;
+  const BRepAdaptor_Surface aK(K, false);
+  if (aK.GetType() == GeomAbs_Torus)
+  {
+    D.rk = aK.Torus().MinorRadius();
+  }
+  else if (aK.GetType() == GeomAbs_Cylinder)
+  {
+    D.rk = aK.Cylinder().Radius();
+  }
+  else
+  {
+    return false;
+  }
+  // U's outward normal: the heights are taken against it.
+  const BRepAdaptor_Surface aU(U, false);
+  if (aU.GetType() != GeomAbs_Plane)
+  {
+    return false;
+  }
+  const gp_Pln aPl = aU.Plane();
+  gp_Dir       n   = aPl.Axis().Direction();
+  if (!aPl.Position().Direct())
+  {
+    n.Reverse();
+  }
+  if (U.Orientation() == TopAbs_REVERSED)
+  {
+    n.Reverse();
+  }
+  D.Axis = gp_Ax1(aPl.Location(), n.Reversed());
+  // K's edges with Wp and Wo through the arc's vertices.
+  TopoDS_Vertex v1, v2;
+  TopExp::Vertices(Ek, v1, v2);
+  for (TopExp_Explorer ex(K, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(E) || E.IsSame(Ek))
+    {
+      continue;
+    }
+    TopoDS_Vertex e1, e2;
+    TopExp::Vertices(E, e1, e2);
+    const bool aAtArc = e1.IsSame(v1) || e1.IsSame(v2) || e2.IsSame(v1) || e2.IsSame(v2);
+    if (!aAtArc)
+    {
+      continue;
+    }
+    if (D.Ka.IsNull() && tcHasFace(myEFMap, E, Wp))
+    {
+      D.Ka = E;
+    }
+    else if (D.Kb.IsNull() && tcHasFace(myEFMap, E, Wo))
+    {
+      D.Kb = E;
+    }
+  }
+  if (D.Ka.IsNull() || D.Kb.IsNull())
+  {
+    return false;
+  }
+  return tcBuildCorner(myDS->ChangeDS(), tolapp3d, myRegul, myEVIMap, SP, FirstP, SO, FirstO, Ek, D, -1., Corners);
+}
