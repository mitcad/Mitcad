+//! The same at parameter w of edge E whatever its curve: seen along the
+//! edge there (a torus's seam, a circle with both ends on U, mitcad#1426).
+TopAbs_Orientation tcKeptAboveAt(const TopoDS_Edge& E, const double w, const gp_Dir& a)
+{
+  if (BRepAdaptor_Curve(E).GetType() == GeomAbs_Line)
+  {
+    return tcKeptAbove(E, a);
+  }
+  double                        f = 0., l = 0.;
+  const occ::handle<Geom_Curve> C = BRep_Tool::Curve(TopoDS::Edge(E.Oriented(TopAbs_FORWARD)), f, l);
+  gp_Pnt                        P;
+  gp_Vec                        T;
+  C->D1(w, P, T);
+  return T.Dot(gp_Vec(a)) < 0. ? TopAbs_REVERSED : TopAbs_FORWARD;
+}
+
+//! The distance from X to edge E's curve and the point there (Pe).
+double tcToEdge(const TopoDS_Edge& E, const gp_Pnt& X, gp_Pnt& Pe)
+{
+  const BRepAdaptor_Curve aE(E);
+  if (aE.GetType() == GeomAbs_Line)
+  {
+    const gp_Lin Lin = aE.Line();
+    Pe               = ElCLib::Value(ElCLib::Parameter(Lin, X), Lin);
+    return Pe.Distance(X);
+  }
+  double                        f = 0., l = 0.;
+  const occ::handle<Geom_Curve> C = BRep_Tool::Curve(TopoDS::Edge(E.Oriented(TopAbs_FORWARD)), f, l);
+  if (C.IsNull())
+  {
+    return RealLast();
+  }
+  double t = 0., d = 0.;
+  tcOnCurve(C, f, l, X, t, d);
+  Pe = C->Value(t);
+  return d;
+}
+
+//! The parameter on curve C over [F, L] where it comes nearest edge E (a
+//! line: tcNearestToLine), the distance, and the point on E there.
+void tcNearestToEdge(const occ::handle<Geom_Curve>& C,
+                     const double                   F,
+                     const double                   L,
+                     const TopoDS_Edge&             E,
+                     double&                        t,
+                     double&                        d,
+                     gp_Pnt&                        Pe)
+{
+  const BRepAdaptor_Curve aE(E);
+  if (aE.GetType() == GeomAbs_Line)
+  {
+    const gp_Lin Lin = aE.Line();
+    tcNearestToLine(C, F, L, Lin, t, d);
+    Pe = ElCLib::Value(ElCLib::Parameter(Lin, C->Value(t)), Lin);
+    return;
+  }
+  const int n    = 200;
+  int       best = 0;
+  d              = RealLast();
+  gp_Pnt P;
+  for (int i = 0; i <= n; i++)
+  {
+    const double di = tcToEdge(E, C->Value(F + (L - F) * i / n), P);
+    if (di < d)
+    {
+      d    = di;
+      best = i;
+    }
+  }
+  double       a = F + (L - F) * std::max(0, best - 1) / n;
+  double       b = F + (L - F) * std::min(n, best + 1) / n;
+  const double g = 0.5 * (std::sqrt(5.) - 1.);
+  for (int it = 0; it < 100 && std::abs(b - a) > 1.e-15 * (1. + std::abs(b)); it++)
+  {
+    const double c1 = b - g * (b - a);
+    const double c2 = a + g * (b - a);
+    if (tcToEdge(E, C->Value(c1), P) < tcToEdge(E, C->Value(c2), P))
+    {
+      b = c2;
+    }
+    else
+    {
+      a = c1;
+    }
+  }
+  t = 0.5 * (a + b);
+  d = tcToEdge(E, C->Value(t), Pe);
+}
