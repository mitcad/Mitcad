+// (ChFi3d_Builder_C1.cxx.)
+void ChFi3d_SeamRunOnAlongEdge(TopOpeBRepDS_DataStructure& DStr,
+                               const TopoDS_Face&          F,
+                               const int                   IF,
+                               const TopoDS_Edge&          E,
+                               const double                W,
+                               const TopoDS_Vertex&        V,
+                               const int                   Ip,
+                               const double                Tol);
+
+//=======================================================================
+// function : ChFi3d_SeamRunOnAtPointEnd
+// purpose  : A lone stripe ending in a point Ip on an edge E at the vertex
+//            V, cut from E by the face at the end (ChFi3d_KPartCutToEnd:
+//            the blend's contact ran into that face before V, its other
+//            contact meets E short of V): where a face of E has a seam that
+//            ends at V along E's line, that face goes on across the line
+//            from V to the cut, as at an OnSame end whose opposite contact
+//            ends on the prolonged edge (PerformOneCorner): the seam runs on
+//            from V to the cut and stays.
+//=======================================================================
+
+static void ChFi3d_SeamRunOnAtPointEnd(TopOpeBRepDS_DataStructure&                               DStr,
+                                       const ChFiDS_Map&                                         EFMap,
+                                       const occ::handle<ChFiDS_Stripe>&                         Stripe,
+                                       const occ::handle<ChFiDS_SurfData>&                       Fd,
+                                       const bool                                                isFirst,
+                                       const TopoDS_Vertex&                                      V,
+                                       const double                                              Tol)
+{
+  const ChFiDS_CommonPoint& CP1 = Fd->Vertex(isFirst, 1);
+  const ChFiDS_CommonPoint& CP2 = Fd->Vertex(isFirst, 2);
+  if (!CP1.IsOnArc() || !CP2.IsOnArc() || !CP1.Arc().IsSame(CP2.Arc()) || !EFMap.Contains(CP1.Arc()))
+  {
+    return;
+  }
+  const TopoDS_Edge& E = TopoDS::Edge(CP1.Arc());
+  TopoDS_Vertex      V1, V2;
+  TopExp::Vertices(E, V1, V2);
+  const int Ip = Stripe->IndexPoint(isFirst, 1);
+  if ((!V.IsSame(V1) && !V.IsSame(V2)) || Ip <= 0)
+  {
+    return;
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More(); it.Next())
+  {
+    const TopoDS_Face& F = TopoDS::Face(it.Value());
+    ChFi3d_SeamRunOnAlongEdge(DStr, F, DStr.AddShape(F), E, CP1.ParameterOnArc(), V, Ip, Tol);
+  }
+}
