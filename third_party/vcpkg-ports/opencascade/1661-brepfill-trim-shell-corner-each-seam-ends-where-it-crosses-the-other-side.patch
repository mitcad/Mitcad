+//=======================================================================
+// function : FindHitNearBisector
+// purpose  : The vertex the intersection put on the edge (where it
+//            crosses the other side's faces) nearest to the bisector
+//            plane, and its parameter on the edge.
+//=======================================================================
+bool FindHitNearBisector(const BOPDS_PDS& theDS,
+                         const int        theEIndex,
+                         const gp_Ax2&    theAxeOfBisPlane,
+                         TopoDS_Vertex&   theVertex,
+                         double&          theParam)
+{
+  if (theEIndex < 0 || !theDS->HasPaveBlocks(theEIndex))
+  {
+    return false;
+  }
+  const gp_Pln aBisPlane(theAxeOfBisPlane.Location(), theAxeOfBisPlane.Direction());
+  double       aBest  = RealLast();
+  bool         bFound = false;
+  NCollection_List<occ::handle<BOPDS_PaveBlock>>::Iterator aItPB(theDS->PaveBlocks(theEIndex));
+  for (; aItPB.More(); aItPB.Next())
+  {
+    for (int i = 0; i < 2; ++i)
+    {
+      const BOPDS_Pave aPave = (i == 0) ? aItPB.Value()->Pave1() : aItPB.Value()->Pave2();
+      if (!theDS->IsNewShape(aPave.Index()))
+      {
+        continue;
+      }
+      const TopoDS_Vertex& aV = TopoDS::Vertex(theDS->Shape(aPave.Index()));
+      const double         aD = aBisPlane.Distance(BRep_Tool::Pnt(aV));
+      if (aD < aBest)
+      {
+        aBest     = aD;
+        theVertex = aV;
+        theParam  = aPave.Parameter();
+        bFound    = true;
+      }
+    }
+  }
+  return bFound;
+}
