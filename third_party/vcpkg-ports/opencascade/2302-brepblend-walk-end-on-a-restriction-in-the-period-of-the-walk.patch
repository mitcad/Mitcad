+//=======================================================================
+// function : BRepBlend_IntoPeriodOf
+// purpose  : The parameters (theU, theV) of a contact on theSurf where the
+//            walk reached a restriction, moved by whole periods of a
+//            periodic surface next to those of the walk's point before
+//            (theRef) on that surface (theOnS1: its first). The reframing
+//            onto the restriction may give them in another period than the
+//            walk's: a walk that crossed the seam of a loft's periodic face
+//            ran on in the next period, and its end on the arcs came out a
+//            period below (u -79.20 after 780.67, the period 869.72); the
+//            approximation's start for the sections between the two, the
+//            chord in the parameters, lay on the far side of the surface,
+//            and its sections landed on balls 100 mm off (mitcad#2390). The
+//            point in space is the same.
+//=======================================================================
+static void BRepBlend_IntoPeriodOf(const occ::handle<Adaptor3d_Surface>& theSurf,
+                                   const Blend_Point&                    theRef,
+                                   const bool                            theOnS1,
+                                   double&                               theU,
+                                   double&                               theV)
+{
+  if (theSurf.IsNull() || !(theSurf->IsUPeriodic() || theSurf->IsVPeriodic()))
+  {
+    return;
+  }
+  double aRefU = 0., aRefV = 0.;
+  if (theOnS1)
+  {
+    theRef.ParametersOnS1(aRefU, aRefV);
+  }
+  else
+  {
+    theRef.ParametersOnS2(aRefU, aRefV);
+  }
+  RecadreIfPeriodic(theU,
+                    theV,
+                    aRefU,
+                    aRefV,
+                    theSurf->IsUPeriodic() ? theSurf->UPeriod() : 0.,
+                    theSurf->IsVPeriodic() ? theSurf->VPeriod() : 0.);
+}
+
 static void evalpinit(math_Vector&       parinit,
                       const Blend_Point& previousP,
                       const double       parprec,
@@ -2773,6 +2815,14 @@ void BRepBlend_Walking::InternalPerform(Blend_Function& Func,
         {
           State = Blend_OK;
         }
+        // The contacts on a restriction in the period of the walk's points
+        // (mitcad#2390, BRepBlend_IntoPeriodOf; after the classification
