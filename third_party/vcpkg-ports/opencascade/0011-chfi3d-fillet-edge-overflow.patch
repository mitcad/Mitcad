+bool ChFi3d_ArcEndsSpine(const ChFiDS_CommonPoint& CP,
+                         const TopoDS_Face&        F,
+                         const TopoDS_Vertex&      Bout,
+                         const ChFiDS_Map&         EFMap,
+                         const ChFiDS_Map&         VFMap)
+{
+  if (!CP.IsOnArc() || Bout.IsNull() || !EFMap.Contains(CP.Arc()) || !VFMap.Contains(Bout))
+  {
+    return true;
+  }
+  for (TopExp_Explorer ex(CP.Arc(), TopAbs_VERTEX); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(Bout))
+    {
+      return true;
+    }
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator itF(EFMap(CP.Arc())); itF.More(); itF.Next())
+  {
+    if (itF.Value().IsSame(F))
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator itV(VFMap(Bout)); itV.More(); itV.Next())
+    {
+      if (itV.Value().IsSame(itF.Value()))
+      {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+//=======================================================================
+// function : ChFi3d_CutConsumedFaces
+// purpose  : A SurfData rolling on an obstacle edge (side ons) keeps the
+//            face beyond that edge (IndexOfS) and shares the edge with it;
+//            the face on the other side of the obstacle edge, between it
+//            and the spine, is consumed by the blend. When that face is a
+//            strip between the spine and the obstacle edge (all its vertices
+//            on them) and the blend ends at the vertices of the obstacle
+//            edge, its other edges at those vertices are cut there, so that
+//            the builder drops the face with them.
+//=======================================================================
+
+void ChFi3d_CutConsumedFaces(TopOpeBRepDS_DataStructure&       DStr,
+                             const occ::handle<ChFiDS_Stripe>& CorDat,
+                             const ChFiDS_Map&                 EFMap)
+{
+  const occ::handle<ChFiDS_Spine>& aSpine = CorDat->Spine();
+  if (aSpine.IsNull())
+  {
+    return;
+  }
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aSpineVertices;
+  for (int ie = 1; ie <= aSpine->NbEdges(); ie++)
+  {
+    for (TopExp_Explorer ex(aSpine->Edges(ie), TopAbs_VERTEX); ex.More(); ex.Next())
+    {
+      aSpineVertices.Add(ex.Current());
+    }
+  }
+  const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& SeqFil =
+    CorDat->SetOfSurfData()->Sequence();
+  for (int j = 1; j <= SeqFil.Length(); j++)
+  {
+    const occ::handle<ChFiDS_SurfData>& Fd = SeqFil(j);
+    for (int ons = 1; ons <= 2; ons++)
+    {
+      if (!Fd->IsOnCurve(ons) || Fd->Index(ons) <= 0)
+      {
+        continue;
+      }
+      const TopoDS_Shape& anObst = DStr.Shape(Fd->IndexOfC(ons));
+      const TopoDS_Shape& aFace  = DStr.Shape(Fd->Index(ons));
+      if (!EFMap.Contains(anObst))
+      {
+        continue;
+      }
+      TopoDS_Face aLeft;
+      for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(anObst)); it.More(); it.Next())
+      {
+        if (!it.Value().IsSame(aFace))
+        {
+          aLeft = TopoDS::Face(it.Value());
+        }
+      }
+      if (aLeft.IsNull())
+      {
+        continue;
+      }
+      // The consumed face must be a strip between the spine and the
+      // obstacle edge.
+      bool isStrip = true;
+      for (TopExp_Explorer ex(aLeft, TopAbs_VERTEX); ex.More() && isStrip; ex.Next())
+      {
+        bool onObst = false;
+        for (TopExp_Explorer exo(anObst, TopAbs_VERTEX); exo.More() && !onObst; exo.Next())
+        {
+          onObst = exo.Current().IsSame(ex.Current());
+        }
+        isStrip = onObst || aSpineVertices.Contains(ex.Current());
+      }
+      if (!isStrip)
+      {
+        continue;
+      }
+      // Its other edges at the ends of the blend.
+      for (int f = 0; f < 2; f++)
+      {
+        const ChFiDS_CommonPoint& CP = Fd->Vertex(f == 0, ons);
+        if (!CP.IsVertex())
+        {
+          continue;
+        }
+        const TopoDS_Vertex& V      = CP.Vertex();
+        const int            IV     = DStr.AddShape(V);
+        TopoDS_Face          aLeftF = aLeft;
+        aLeftF.Orientation(TopAbs_FORWARD);
+        for (TopExp_Explorer ex(aLeftF, TopAbs_EDGE); ex.More(); ex.Next())
+        {
+          TopoDS_Edge E = TopoDS::Edge(ex.Current());
+          if (E.IsSame(anObst) || BRep_Tool::Degenerated(E))
+          {
+            continue;
+          }
+          E.Orientation(TopAbs_FORWARD);
+          for (TopExp_Explorer exv(E, TopAbs_VERTEX); exv.More(); exv.Next())
+          {
+            const TopoDS_Vertex& vv = TopoDS::Vertex(exv.Current());
+            if (!vv.IsSame(V))
+            {
+              continue;
+            }
+            const int IE = DStr.AddShape(E);
+            QueryAddVertexInEdge(DStr.ChangeShapeInterferences(IE),
+                                 IE,
+                                 IV,
+                                 BRep_Tool::Parameter(vv, E),
+                                 TopAbs::Reverse(vv.Orientation()));
+          }
+        }
+      }
+    }
+  }
+}
