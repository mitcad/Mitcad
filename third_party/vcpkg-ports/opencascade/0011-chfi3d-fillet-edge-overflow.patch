+//=======================================================================
+// function : ChFi3d_ExtendAtSpineEnds
+// purpose  : A blend rolling on an obstacle edge (surface/restriction
+//            line <lin>, the surface on face FS) that ends where its
+//            contact on FS reaches the face at an end of the spine is
+//            extended past it, so that the face at the end cuts it there
+//            (as blends between two faces are at the ends of the spine).
+//=======================================================================
+
+static void ChFi3d_ExtendAtSpineEnds(const occ::handle<ChFiDS_SurfData>& Data,
+                                     const occ::handle<BRepBlend_Line>&  lin,
+                                     const occ::handle<ChFiDS_Spine>&    Spine,
+                                     const occ::handle<ChFiDS_ElSpine>&  HGuide,
+                                     const TopoDS_Face&                  FS,
+                                     const ChFiDS_Map&                   EFMap,
+                                     const ChFiDS_Map&                   VFMap)
+{
+  if (Spine->IsPeriodic() || lin->NbPoints() < 2)
+  {
+    return;
+  }
+  const double aRab = 0.03 * (HGuide->LastParameter() - HGuide->FirstParameter());
+  for (int f = 0; f < 2; f++)
+  {
+    const BRepBlend_Extremity& anExt = f == 0 ? lin->StartPointOnFirst() : lin->EndPointOnFirst();
+    if (anExt.NbPointOnRst() == 0)
+    {
+      continue;
+    }
+    const occ::handle<BRepAdaptor_Curve2d> anArc =
+      occ::down_cast<BRepAdaptor_Curve2d>(anExt.PointOnRst(1).Arc());
+    if (anArc.IsNull())
+    {
+      continue;
+    }
+    ChFiDS_CommonPoint aCP;
+    aCP.SetArc(Precision::Confusion(),
+               anArc->Edge(),
+               anExt.PointOnRst(1).ParameterOnArc(),
+               TopAbs_FORWARD);
+    const TopoDS_Vertex aBout = f == 0 ? Spine->FirstVertex() : Spine->LastVertex();
+    // Only an arc between FS and a face at the end of the spine.
+    bool atEnd = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator itF(EFMap(aCP.Arc())); itF.More() && !atEnd;
+         itF.Next())
+    {
+      atEnd = !itF.Value().IsSame(FS) && VFMap.Contains(aBout);
+    }
+    if (atEnd && ChFi3d_ArcEndsSpine(aCP, FS, aBout, EFMap, VFMap))
+    {
+      if (f == 0)
+      {
+        Data->FirstExtensionValue(aRab);
+      }
+      else
+      {
+        Data->LastExtensionValue(aRab);
+      }
+    }
+  }
+}
