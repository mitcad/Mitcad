+// The distance of a point from the segment [A, B].
+static double distanceToSegment(const gp_Pnt& P, const gp_Pnt& A, const gp_Pnt& B)
+{
+  const gp_Vec AB(A, B);
+  const double L2 = AB.SquareMagnitude();
+  if (L2 < gp::Resolution())
+  {
+    return P.Distance(A);
+  }
+  double t = gp_Vec(A, P).Dot(AB) / L2;
+  t        = std::min(1., std::max(0., t));
+  return P.Distance(A.Translated(t * AB));
+}
+
+// Whether a circle tangent to surface S1 at (U1, V1) and to S2 at (U2, V2)
+// exists: the normal lines through both points meet at a point as far from
+// both. Rejects the false roots a section solver may stop at.
+static bool isTangentCircle(const Adaptor3d_Surface& S1,
+                            const double             U1,
+                            const double             V1,
+                            const Adaptor3d_Surface& S2,
+                            const double             U2,
+                            const double             V2,
+                            const double             Tol)
+{
+  gp_Pnt P1, P2;
+  gp_Vec D1U, D1V, D2U, D2V;
+  S1.D1(U1, V1, P1, D1U, D1V);
+  S2.D1(U2, V2, P2, D2U, D2V);
+  gp_Vec N1 = D1U.Crossed(D1V), N2 = D2U.Crossed(D2V);
+  if (N1.Magnitude() < gp::Resolution() || N2.Magnitude() < gp::Resolution())
+  {
+    return false;
+  }
+  N1.Normalize();
+  N2.Normalize();
+  // The closest points of the lines P1 + a N1 and P2 + b N2.
+  const gp_Vec W0(P2, P1);
+  const double b = N1.Dot(N2), d = N1.Dot(W0), e = N2.Dot(W0);
+  const double den = 1. - b * b;
+  if (den < 1.e-12)
+  {
+    return false; // parallel normals: no circle touches both
+  }
+  const double a  = (b * e - d) / den;
+  const double c  = (e - b * d) / den;
+  const gp_Pnt C1 = P1.Translated(a * N1);
+  const gp_Pnt C2 = P2.Translated(c * N2);
+  return C1.Distance(C2) < Tol && std::abs(std::abs(a) - std::abs(c)) < Tol;
+}
+
+// The occurrence of edge E in face F (taken FORWARD), or a null edge.
+static TopoDS_Edge edgeInFace(const TopoDS_Edge& E, const TopoDS_Face& F)
+{
+  TopoDS_Face aF = F;
+  aF.Orientation(TopAbs_FORWARD);
+  for (TopExp_Explorer ex(aF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(E))
+    {
+      return TopoDS::Edge(ex.Current());
+    }
+  }
+  return TopoDS_Edge();
+}
+
+//=================================================================================================
+
+bool ChFi3d_Builder::ObstacleAtSpineEnd(const occ::handle<ChFiDS_SurfData>& SD,
+                                        const bool                          isFirst,
+                                        const int                           ons,
+                                        const TopoDS_Vertex&                Bout) const
+{
+  if (SD.IsNull() || Bout.IsNull() || SD->Index(ons) <= 0)
+  {
+    return false;
+  }
+  const ChFiDS_CommonPoint& CP = SD->Vertex(isFirst, ons);
+  if (!CP.IsOnArc() || !myEFMap.Contains(CP.Arc()) || !myVFMap.Contains(Bout))
+  {
+    return false;
+  }
+  const TopoDS_Face F = TopoDS::Face(myDS->DS().Shape(SD->Index(ons)));
+  return ChFi3d_ArcEndsSpine(CP, F, Bout, myEFMap, myVFMap);
+}
+
+//=================================================================================================
+
+int ChFi3d_Builder::StartSolOverflow(const occ::handle<ChFiDS_Stripe>&      Stripe,
+                                     const occ::handle<ChFiDS_ElSpine>&     HGuide,
+                                     occ::handle<BRepAdaptor_Surface>&      HS1,
+                                     occ::handle<BRepAdaptor_Surface>&      HS2,
+                                     occ::handle<BRepTopAdaptor_TopolTool>& I1,
+                                     occ::handle<BRepTopAdaptor_TopolTool>& I2,
+                                     gp_Pnt2d&                              P1,
+                                     gp_Pnt2d&                              P2,
+                                     double&                                First,
+                                     occ::handle<BRepAdaptor_Curve2d>&      HC,
+                                     occ::handle<BRepAdaptor_Surface>&      HSref,
+                                     occ::handle<BRepAdaptor_Curve2d>&      HCref,
+                                     double&                                W) const
+{
+  const occ::handle<ChFiDS_Spine>& Spine      = Stripe->Spine();
+  ChFiDS_ElSpine&                  els        = *HGuide;
+  const int                        nbed       = Spine->NbEdges();
+  const int                        nbessaimax = std::max(3 * nbed, 10);
+  const double wf = 0.9981 * Spine->FirstParameter(1) + 0.0019 * Spine->LastParameter(1);
+  const double wl = 0.9973 * Spine->LastParameter(nbed) + 0.0027 * Spine->FirstParameter(nbed);
+  const int    RC = Stripe->Choix();
+  const bool   isFillet = !occ::down_cast<ChFiDS_FilSpine>(Spine).IsNull();
+  if (!isFillet)
+  {
+    return -1; // chamfers do not roll over edges
+  }
+
+  Extrema_ExtPC PExt;
+  PExt.Initialize(els,
+                  Spine->FirstParameter(1),
+                  Spine->LastParameter(nbed),
+                  Precision::Confusion());
+  math_Vector SolDep(1, 4);
+  for (int nbessai = 0; nbessai <= nbessaimax; nbessai++)
+  {
+    const double t     = double(nbessai) / nbessaimax;
+    double       w     = wf * (1. - t) + wl * t;
+    const int    iedge = Spine->Index(w);
+    TopoDS_Edge  cured = Spine->Edges(iedge);
+    ConexFaces(Spine, iedge, HS1, HS2);
+    const TopoDS_Face f1 = HS1->Face();
+    const TopoDS_Face f2 = HS2->Face();
+    if (f1.IsSame(f2))
+    {
+      continue;
+    }
+    double woned;
+    Spine->Parameter(iedge, w, woned, true);
+    const BRepAdaptor_Curve& Ced = Spine->CurrentElementarySpine(iedge);
+    const gp_Pnt             pnt = Ced.Value(woned);
+    if (!Projection(PExt, pnt, els, w, tolapp3d))
+    {
+      continue;
+    }
+    TopoDS_Face f1forward = f1, f2forward = f2;
+    f1forward.Orientation(TopAbs_FORWARD);
+    f2forward.Orientation(TopAbs_FORWARD);
+    cured.Orientation(TopAbs_FORWARD);
+    const occ::handle<Geom2d_Curve> PC1 = getCurveOnSurface(cured, f1forward);
+    const occ::handle<Geom2d_Curve> PC2 = getCurveOnSurface(cured, f2forward);
+    if (PC1.IsNull() || PC2.IsNull())
+    {
+      continue;
+    }
+    P1 = PC1->Value(woned);
+    P2 = PC2->Value(woned);
+
+    // The section on the surfaces of both faces, not bounded by them.
+    occ::handle<BRepAdaptor_Surface> U1 = new BRepAdaptor_Surface(f1, false);
+    occ::handle<BRepAdaptor_Surface> U2 = new BRepAdaptor_Surface(f2, false);
+    I1->Initialize((const occ::handle<Adaptor3d_Surface>&)U1);
+    I2->Initialize((const occ::handle<Adaptor3d_Surface>&)U2);
+    TopAbs_Orientation Or1   = f1.Orientation();
+    TopAbs_Orientation Or2   = f2.Orientation();
+    const int          Choix = ChFi3d::NextSide(Or1,
+                                       Or2,
+                                       Stripe->OrientationOnFace1(),
+                                       Stripe->OrientationOnFace2(),
+                                       RC);
+    SolDep(1) = P1.X();
+    SolDep(2) = P1.Y();
+    SolDep(3) = P2.X();
+    SolDep(4) = P2.Y();
+    TopAbs_State Pos1 = TopAbs_UNKNOWN, Pos2 = TopAbs_UNKNOWN;
+    PerformFirstSection(Spine, HGuide, Choix, U1, U2, I1, I2, w, SolDep, Pos1, Pos2);
+    int ons = 0;
+    if (Pos1 == TopAbs_OUT && (Pos2 == TopAbs_IN || Pos2 == TopAbs_ON))
+    {
+      ons = 1;
+    }
+    else if (Pos2 == TopAbs_OUT && (Pos1 == TopAbs_IN || Pos1 == TopAbs_ON))
+    {
+      ons = 2;
+    }
+    if (ons == 0)
+    {
+      continue;
+    }
+    const TopoDS_Face& Fk = ons == 1 ? f1 : f2;
+    const gp_Pnt Pc = ons == 1 ? U1->Value(SolDep(1), SolDep(2)) : U2->Value(SolDep(3), SolDep(4));
+
+    // The boundary edge of Fk the section crosses between the spine and
+    // the contact point.
+    gp_Pnt P;
+    gp_Vec V;
+    HGuide->D1(w, P, V);
+    occ::handle<GeomAdaptor_Surface> plane =
+      new GeomAdaptor_Surface(new Geom_Plane(P, gp_Dir(V)));
+    TopoDS_Edge arc;
+    double      warc = 0., best = RealLast();
+    for (TopExp_Explorer ex(Fk, TopAbs_EDGE); ex.More(); ex.Next())
+    {
+      const TopoDS_Edge& ecur = TopoDS::Edge(ex.Current());
+      if (ecur.IsSame(cured) || BRep_Tool::Degenerated(ecur))
+      {
+        continue;
+      }
+      occ::handle<BRepAdaptor_Curve> hc = new BRepAdaptor_Curve(ecur);
+      IntCurveSurface_HInter         inter;
+      inter.Perform(hc, plane);
+      if (!inter.IsDone())
+      {
+        continue;
+      }
+      const double tolc = hc->Resolution(tolapp3d);
+      for (int ip = 1; ip <= inter.NbPoints(); ip++)
+      {
+        const double cw = inter.Point(ip).W();
+        if (cw < hc->FirstParameter() - tolc || cw > hc->LastParameter() + tolc)
+        {
+          continue;
+        }
+        const double d = distanceToSegment(inter.Point(ip).Pnt(), P, Pc);
+        if (d < best)
+        {
+          best = d;
+          arc  = ecur;
+          warc = cw;
+        }
+      }
+    }
+    if (arc.IsNull())
+    {
+      continue;
+    }
+    TopoDS_Face Fn;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(myEFMap(arc)); it.More(); it.Next())
