+        Fn = TopoDS::Face(it.Value());
+      }
+    }
+    if (Fn.IsNull())
+    {
+      continue;
+    }
+    // Beyond a tangent edge the blend can only run onto the next face.
+    const bool isTangent = ChFi3d::IsTangentFaces(arc, Fk, Fn);
+    const TopoDS_Edge arcOnFk = edgeInFace(arc, Fk);
+    const TopoDS_Edge arcOnFn = edgeInFace(arc, Fn);
+    if (arcOnFk.IsNull() || arcOnFn.IsNull())
+    {
+      continue;
+    }
+    const occ::handle<Geom2d_Curve> pcFn = getCurveOnSurface(arcOnFn, Fn);
+    if (pcFn.IsNull())
+    {
+      continue;
+    }
+
+    // The blend touching the next face.
+    {
+      occ::handle<BRepAdaptor_Surface> Hn = new BRepAdaptor_Surface(Fn);
+      occ::handle<BRepAdaptor_Surface> Ho = ons == 1 ? HS2 : HS1;
+      math_Vector                      SolN(1, 4);
+      const gp_Pnt2d                   pn = pcFn->Value(warc);
+      if (ons == 1)
+      {
+        SolN(1) = pn.X();
+        SolN(2) = pn.Y();
+        SolN(3) = SolDep(3);
+        SolN(4) = SolDep(4);
+        I1->Initialize((const occ::handle<Adaptor3d_Surface>&)Hn);
+        I2->Initialize((const occ::handle<Adaptor3d_Surface>&)Ho);
+      }
+      else
+      {
+        SolN(1) = SolDep(1);
+        SolN(2) = SolDep(2);
+        SolN(3) = pn.X();
+        SolN(4) = pn.Y();
+        I1->Initialize((const occ::handle<Adaptor3d_Surface>&)Ho);
+        I2->Initialize((const occ::handle<Adaptor3d_Surface>&)Hn);
+      }
+      occ::handle<BRepAdaptor_Surface> S1 = ons == 1 ? Hn : Ho;
+      occ::handle<BRepAdaptor_Surface> S2 = ons == 1 ? Ho : Hn;
+      TopAbs_Orientation OrN1   = S1->Face().Orientation();
+      TopAbs_Orientation OrN2   = S2->Face().Orientation();
+      const int          ChoixN = ChFi3d::NextSide(OrN1,
+                                          OrN2,
+                                          Stripe->OrientationOnFace1(),
+                                          Stripe->OrientationOnFace2(),
+                                          RC);
+      TopAbs_State N1 = TopAbs_UNKNOWN, N2 = TopAbs_UNKNOWN;
+      bool         onNext =
+        PerformFirstSection(Spine, HGuide, ChoixN, S1, S2, I1, I2, w, SolN, N1, N2);
+      if (onNext
+          && !isTangentCircle(*S1, SolN(1), SolN(2), *S2, SolN(3), SolN(4), 10. * tolapp3d))
+      {
+        onNext = false;
+      }
+      if (onNext)
+      {
+        HS1 = S1;
+        HS2 = S2;
+        P1.SetCoord(SolN(1), SolN(2));
+        P2.SetCoord(SolN(3), SolN(4));
+        First = w;
+        return 0;
+      }
+    }
+
+    if (isTangent)
+    {
+      continue;
+    }
+    // The blend rolling on the boundary edge: an obstacle as StartSol sets
+    // it up when a walking meets one.
+    HSref = new BRepAdaptor_Surface(Fk);
+    HCref = new BRepAdaptor_Curve2d(arcOnFk, Fk);
+    HC    = new BRepAdaptor_Curve2d(arcOnFn, Fn);
+    W     = warc;
+    if (ons == 1)
+    {
+      HS1->Initialize(Fn);
+      HS2->Initialize(f2);
+      P1 = HC->Value(W);
+      P2.SetCoord(SolDep(3), SolDep(4));
+    }
+    else
+    {
+      HS1->Initialize(f1);
+      HS2->Initialize(Fn);
+      P1.SetCoord(SolDep(1), SolDep(2));
+      P2 = HC->Value(W);
+    }
+    I1->Initialize((const occ::handle<Adaptor3d_Surface>&)HS1);
+    I2->Initialize((const occ::handle<Adaptor3d_Surface>&)HS2);
+    First = w;
+    return ons;
+  }
+  return -1;
+}
