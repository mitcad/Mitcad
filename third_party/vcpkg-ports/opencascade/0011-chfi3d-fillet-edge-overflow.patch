+//=======================================================================
+// function : ChFi3d_ObstacleEndOnFace
+// purpose  : The end point of a SurfData on its obstacle side (a blend
+//            rolling on an edge) is a vertex of that edge, with that edge
+//            as arc. For the face at the end, the point is given the edge
+//            of the vertex that bounds a face which also bounds the arc of
+//            the point of the other side (Favoid excepted). Returns true
+//            when such an edge is found and set.
+//=======================================================================
+
+// The orientation of edge E in face F (taken FORWARD); FORWARD if absent.
+static TopAbs_Orientation ChFi3d_OrientationInFace(const TopoDS_Shape& E, const TopoDS_Face& F)
+{
+  for (TopExp_Explorer ex(F.Oriented(TopAbs_FORWARD), TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    if (ex.Current().IsSame(E))
+    {
+      return ex.Current().Orientation();
+    }
+  }
+  return TopAbs_FORWARD;
+}
+
+static bool ChFi3d_ObstacleEndOnFace(const TopOpeBRepDS_DataStructure&   DStr,
+                                     const occ::handle<ChFiDS_SurfData>& Fd,
+                                     ChFiDS_CommonPoint&                 CV1,
+                                     ChFiDS_CommonPoint&                 CV2,
+                                     const TopoDS_Face&                  Favoid,
+                                     const ChFiDS_Map&                   VEMap,
+                                     const ChFiDS_Map&                   EFMap)
+{
+  for (int ons = 1; ons <= 2; ons++)
+  {
+    ChFiDS_CommonPoint&       CV    = ons == 1 ? CV1 : CV2;
+    const ChFiDS_CommonPoint& Other = ons == 1 ? CV2 : CV1;
+    if (!Fd->IsOnCurve(ons) || !CV.IsOnArc() || !Other.IsOnArc())
+    {
+      continue;
+    }
+    TopoDS_Vertex V;
+    if (CV.IsVertex())
+    {
+      V = CV.Vertex();
+    }
+    else
+    {
+      // The other side of the blend reached the face at the end a little
+      // before the obstacle edge ends there (a section across the spine
+      // is not in the face at the end): the blend ends at the vertex of
+      // the obstacle edge.
+      const double aWidth = CV.Point().Distance(Other.Point());
+      double       aBest  = 0.5 * aWidth;
+      for (TopExp_Explorer ex(CV.Arc(), TopAbs_VERTEX); ex.More(); ex.Next())
+      {
+        const TopoDS_Vertex& aV = TopoDS::Vertex(ex.Current());
+        const double         d  = BRep_Tool::Pnt(aV).Distance(CV.Point());
+        if (d < aBest)
+        {
+          aBest = d;
+          V     = aV;
+        }
+      }
+      if (V.IsNull())
+      {
+        continue;
+      }
+    }
+    const TopoDS_Face& Fn = TopoDS::Face(DStr.Shape(Fd->Index(ons)));
+    if (!VEMap.Contains(V) || !EFMap.Contains(Other.Arc()))
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator itE(VEMap(V)); itE.More(); itE.Next())
+    {
+      const TopoDS_Edge& E = TopoDS::Edge(itE.Value());
+      if (E.IsSame(CV.Arc()) || BRep_Tool::Degenerated(E) || !EFMap.Contains(E))
+      {
+        continue;
+      }
+      // E must bound the face the blend touches and the face at the end.
+      bool onFn = false;
+      for (NCollection_List<TopoDS_Shape>::Iterator itF(EFMap(E)); itF.More(); itF.Next())
+      {
+        onFn = onFn || itF.Value().IsSame(Fn);
+      }
+      if (!onFn)
+      {
+        continue;
+      }
+      for (NCollection_List<TopoDS_Shape>::Iterator itF(EFMap(E)); itF.More(); itF.Next())
+      {
+        if (itF.Value().IsSame(Favoid) || itF.Value().IsSame(Fn))
+        {
+          continue;
+        }
+        for (NCollection_List<TopoDS_Shape>::Iterator itO(EFMap(Other.Arc())); itO.More();
+             itO.Next())
+        {
+          if (itO.Value().IsSame(itF.Value()))
+          {
+            // The transition of the contact line on the face is the same
+            // through both arcs: only the orientation of the arc changes.
+            TopAbs_Orientation Tr = CV.TransitionOnArc();
+            if (ChFi3d_OrientationInFace(CV.Arc(), Fn) != ChFi3d_OrientationInFace(E, Fn))
+            {
+              Tr = TopAbs::Reverse(Tr);
+            }
+            if (!CV.IsVertex())
+            {
+              CV.SetVertex(V);
+              CV.SetPoint(BRep_Tool::Pnt(V));
+            }
+            CV.SetArc(CV.Tolerance(), E, BRep_Tool::Parameter(V, E), Tr);
+            return true;
+          }
+        }
+      }
+    }
+  }
+  return false;
+}
