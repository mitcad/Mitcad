+bool IsSameCopy(const gp_Pnt2d& theP1,
+                const gp_Pnt2d& theP2,
+                const double    theUPeriod,
+                const double    theVPeriod)
+{
+  // Whether two points of one vertex in the face's parameters are one
+  // point, not a period apart (they are either).
+  if (theUPeriod > 0. && fabs(theP1.X() - theP2.X()) > 0.5 * theUPeriod)
+  {
+    return false;
+  }
+  if (theVPeriod > 0. && fabs(theP1.Y() - theP2.Y()) > 0.5 * theVPeriod)
+  {
+    return false;
+  }
+  return true;
+}
