+// Whether face F is a tube of radius R about a curve through C: a cylinder
+// of radius R whose axis passes through C, or a torus of minor radius R
+// whose centre circle does (the ball of radius R about C then touches F
+// along a whole circle and stays put there).
+bool stillTubeAt(const TopoDS_Face& F, const gp_Pnt& C, const double R, const double Tol)
+{
+  BRepAdaptor_Surface S(F, false);
+  if (S.GetType() == GeomAbs_Cylinder)
+  {
+    const gp_Cylinder K = S.Cylinder();
+    return std::abs(K.Radius() - R) <= Tol && gp_Lin(K.Axis()).Distance(C) <= Tol;
+  }
+  if (S.GetType() == GeomAbs_Torus)
+  {
+    const gp_Torus T = S.Torus();
+    if (std::abs(T.MinorRadius() - R) > Tol)
+    {
+      return false;
+    }
+    const gp_Ax1 A = T.Axis();
+    const gp_Vec v(A.Location(), C);
+    const double h = v.Dot(gp_Vec(A.Direction()));
+    const double r = (v - h * gp_Vec(A.Direction())).Magnitude();
+    return std::abs(h) <= Tol && std::abs(r - T.MajorRadius()) <= Tol;
+  }
+  return false;
+}
+
+// The line of a contact of a piece, where it and its p-curves are unbounded
+// lines (a piece of a cylinder between two planes, which can be run on).
+bool contactLine(const TopOpeBRepDS_DataStructure& DStr, const ChFiDS_FaceInterference& FI, gp_Lin& L)
+{
+  if (FI.LineIndex() <= 0)
+  {
+    return false;
+  }
+  const occ::handle<Geom_Line> GL = occ::down_cast<Geom_Line>(DStr.Curve(FI.LineIndex()).Curve());
+  if (GL.IsNull() || occ::down_cast<Geom2d_Line>(FI.PCurveOnFace()).IsNull()
+      || occ::down_cast<Geom2d_Line>(FI.PCurveOnSurf()).IsNull())
+  {
+    return false;
+  }
+  L = GL->Lin();
+  return true;
+}
