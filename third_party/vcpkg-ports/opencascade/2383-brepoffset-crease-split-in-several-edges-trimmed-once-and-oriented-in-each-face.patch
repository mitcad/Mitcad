+//=======================================================================
+// function : AddJointsOfPieces
+// purpose  : The image of an edge in several pieces, a chain of edges
+//            (a curve of intersection that comes in branches meeting at a
+//            vertex, such as a cone's offset cut by a cylinder's beside
+//            the apex of their intersection): each piece is trimmed
+//            between the vertices on it, and where a piece runs on into
+//            the next one of the chain, the vertex they share is an end of
+//            it as well as the vertices its neighbours put on it. Without
+//            it, a piece with one neighbour's vertex was not trimmed at all
+//            and the offset of the face it bounds was left open
+//            (mitcad#2383). The shared vertices of thePiece with the other
+//            edges of theImage are added to its vertices in theAsDes2d.
+//=======================================================================
+static void AddJointsOfPieces(const TopoDS_Edge&                 thePiece,
+                              const TopoDS_Shape&                theImage,
+                              const occ::handle<BRepAlgo_AsDes>& theAsDes2d)
+{
+  TopoDS_Vertex aV[2];
+  TopExp::Vertices(thePiece, aV[0], aV[1], true);
+  for (int k = 0; k < 2; ++k)
+  {
+    if (aV[k].IsNull() || (k == 1 && aV[1].IsSame(aV[0])))
+    {
+      continue;
+    }
+    bool bJoint = false;
+    for (TopExp_Explorer aExp(theImage, TopAbs_EDGE); aExp.More() && !bJoint; aExp.Next())
+    {
+      if (aExp.Current().IsSame(thePiece))
+      {
+        continue;
+      }
+      for (TopExp_Explorer aExpV(aExp.Current(), TopAbs_VERTEX); aExpV.More() && !bJoint; aExpV.Next())
+      {
+        bJoint = aExpV.Current().IsSame(aV[k]);
+      }
+    }
+    if (!bJoint)
+    {
+      continue;
+    }
+    bool bThere = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator aIt(theAsDes2d->Descendant(thePiece)); aIt.More() && !bThere;
+         aIt.Next())
+    {
+      bThere = aIt.Value().IsSame(aV[k]);
+    }
+    if (!bThere)
+    {
+      theAsDes2d->Add(thePiece, aV[k].Oriented(k == 0 ? TopAbs_FORWARD : TopAbs_REVERSED));
+    }
+  }
+}
