+//=======================================================================
+// function : OrientationIn
+// purpose  : The orientation of the edge among the descendants of the
+//            face (the offset face it bounds), or theDefault where it is
+//            not among them (mitcad#2383).
+//=======================================================================
+static TopAbs_Orientation OrientationIn(const occ::handle<BRepAlgo_AsDes>& theAsDes,
+                                        const TopoDS_Shape&                theFace,
+                                        const TopoDS_Shape&                theEdge,
+                                        const TopAbs_Orientation           theDefault)
+{
+  if (!theAsDes->HasDescendant(theFace))
+  {
+    return theDefault;
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(theAsDes->Descendant(theFace)); anIt.More(); anIt.Next())
+  {
+    if (anIt.Value().IsSame(theEdge))
+    {
+      return anIt.Value().Orientation();
+    }
+  }
+  return theDefault;
+}
