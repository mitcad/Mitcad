+//=======================================================================
+// function : ChFi3d_FoldRatio
+// purpose  : How far the contact line of a rounding of radius R on face
+//            F folds where edge E is at parameter T (F's other face at
+//            the edge G): the edge's bending towards F's inside times the
+//            distance R tan(a / 2) from the edge at which the ball touches
+//            F (a the angle between the faces' outward normals). Above 1
+//            the contact line, the edge moved that far into F, runs
+//            backwards there (mitcad#2228). False where it cannot be told
+//            (no normal, a degenerate tangent, faces tangent or folded
+//            flat).
+//=======================================================================
+static bool ChFi3d_FoldRatio(const TopoDS_Edge&       E,
+                             const BRepAdaptor_Curve& C,
+                             const TopoDS_Face&       F,
+                             const TopAbs_Orientation OnF,
+                             const TopoDS_Face&       G,
+                             const double             R,
+                             const double             T,
+                             double&                  Ratio)
+{
+  const auto anOutward = [&](const TopoDS_Face& aFace, gp_Dir& aN) {
+    const BRepAdaptor_Curve2d aPC(E, aFace);
+    const gp_Pnt2d            aUV = aPC.Value(T);
+    const BRepAdaptor_Surface aS(aFace, false);
+    BRepLProp_SLProps         aProps(aS, aUV.X(), aUV.Y(), 1, 1.e-9);
+    if (!aProps.IsNormalDefined())
+    {
+      return false;
+    }
+    aN = aProps.Normal();
+    if (aFace.Orientation() == TopAbs_REVERSED)
+    {
+      aN.Reverse();
+    }
+    return true;
+  };
+  gp_Pnt aP;
+  gp_Vec aD1, aD2;
+  C.D2(T, aP, aD1, aD2);
+  const double aSpeed = aD1.Magnitude();
+  gp_Dir       aNF, aNG;
+  if (aSpeed < gp::Resolution() || !anOutward(F, aNF) || !anOutward(G, aNG))
+  {
+    return false;
+  }
+  const gp_Vec aT = aD1 / aSpeed;
+  // The curvature vector: towards the centre of the bending, 1 / radius
+  // long.
+  const gp_Vec aK     = (aD2 - aT * aD2.Dot(aT)) / (aSpeed * aSpeed);
+  const gp_Vec aAlong = OnF == TopAbs_FORWARD ? aT : -aT;
+  // Into F from the edge: its outward normal across the edge as F's
+  // boundary runs (F lies to the left of its boundary seen from outside).
+  const gp_Vec anInto = gp_Vec(aNF).Crossed(aAlong);
+  const double anAngle = aNF.Angle(aNG);
+  if (anInto.Magnitude() < gp::Resolution() || anAngle < 1.e-3 || anAngle > M_PI - 1.e-3)
+  {
+    return false;
+  }
+  Ratio = aK.Dot(anInto.Normalized()) * R * std::tan(anAngle / 2.);
+  return true;
+}
+
+//=======================================================================
+// function : ChFi3d_FoldsOfContact
+// purpose  : The stretches of edge IE of Spine (as spine parameters,
+//            appended to Starts and Ends) where the contact line of a
+//            rounding of radius R on one of its faces F1 and F2 folds over
+//            itself (ChFi3d_FoldRatio above 1, mitcad#2228): the crest of
+//            a wave-shaped wall bending with 2.77 mm, its top edge rounded
+//            with 3. The walk across such a stretch runs its contact
+//            backwards there and is twisted. Most:
+//            each face's largest fold ratio along the edge (-RealLast()
+//            where none was told); Folds: each face's number of stretches.
+//=======================================================================
+static void ChFi3d_FoldsOfContact(const occ::handle<ChFiDS_Spine>& Spine,
+                                  const int                        IE,
+                                  const TopoDS_Face&               F1,
+                                  const TopoDS_Face&               F2,
+                                  const double                     R,
+                                  NCollection_Sequence<double>&    Starts,
+                                  NCollection_Sequence<double>&    Ends,
+                                  double                           Most[2],
+                                  int                              Folds[2])
+{
+  Most[0] = Most[1] = -RealLast();
+  Folds[0] = Folds[1] = 0;
+  const TopoDS_Edge& E = Spine->Edges(IE);
+  if (E.IsNull() || BRep_Tool::Degenerated(E) || F1.IsNull() || F2.IsNull() || F1.IsSame(F2) || !(R > 0.))
+  {
+    return;
+  }
+  const BRepAdaptor_Curve C(E);
+  const double            aFirst = C.FirstParameter(), aLast = C.LastParameter();
+  const double            aLength = GCPnts_AbscissaPoint::Length(C);
+  const int aN = std::min(4000, std::max(64, int(aLength / (0.05 * R)) + 1));
+  for (int aSide = 0; aSide < 2; aSide++)
+  {
+    const TopoDS_Face& F = aSide == 0 ? F1 : F2;
+    const TopoDS_Face& G = aSide == 0 ? F2 : F1;
+    // The edge's orientation in F as its boundary runs (not a seam).
+    int                aSeen = 0;
+    TopAbs_Orientation anOn  = TopAbs_FORWARD;
+    for (TopExp_Explorer anEx(F, TopAbs_EDGE); anEx.More(); anEx.Next())
+    {
+      if (anEx.Current().IsSame(E))
+      {
+        anOn = anEx.Current().Orientation();
+        aSeen++;
+      }
+    }
+    if (aSeen != 1 || (anOn != TopAbs_FORWARD && anOn != TopAbs_REVERSED))
+    {
+      continue;
+    }
+    const auto aFolds = [&](const double T) {
+      double aRatio = 0.;
+      return ChFi3d_FoldRatio(E, C, F, anOn, G, R, T, aRatio) && aRatio > 1. + 1.e-6;
+    };
+    // (Just inside the edge's ends.)
+    const auto aParam = [&](const int K) {
+      return aFirst + (aLast - aFirst) * (0.001 + 0.998 * double(K) / double(aN));
+    };
+    // Where the fold starts or ends between two samples, by halving.
+    const auto aBorder = [&](double aA, double aB) {
+      const bool aFoldA = aFolds(aA);
+      for (int k = 0; k < 40; k++)
+      {
+        const double aM = 0.5 * (aA + aB);
+        if (aFolds(aM) == aFoldA)
+        {
+          aA = aM;
+        }
+        else
+        {
+          aB = aM;
+        }
+      }
+      return 0.5 * (aA + aB);
+    };
+    // Each sample's ratio once: whether it folds there, and the largest.
+    std::vector<char> aFoldsAt(size_t(aN) + 1, 0);
+    double            aMost = -RealLast();
+    for (int k = 0; k <= aN; k++)
+    {
+      double aRatio = 0.;
+      if (ChFi3d_FoldRatio(E, C, F, anOn, G, R, aParam(k), aRatio))
+      {
+        aMost       = std::max(aMost, aRatio);
+        aFoldsAt[k] = aRatio > 1. + 1.e-6 ? 1 : 0;
+      }
+    }
+    Most[aSide] = aMost;
+    if (ChFi3d_TracingWalkOnSpine())
+    {
+      std::fprintf(stderr,
+                   "fillet walk: edge %d, face %d: fold ratio at most %.6g (%d points; the contact line folds "
+                   "above 1)\n",
+                   IE, aSide + 1, aMost, aN + 1);
+    }
+    const int aStretchesBefore = Starts.Length();
+    bool      aIn              = aFoldsAt[0] != 0;
+    double    aStart           = aIn ? aParam(0) : 0.;
+    for (int k = 1; k <= aN; k++)
+    {
+      const bool aNow = aFoldsAt[k] != 0;
+      if (aNow == aIn)
+      {
+        continue;
+      }
+      const double aAt = aBorder(aParam(k - 1), aParam(k));
+      if (aNow)
+      {
+        aStart = aAt;
+      }
+      else
+      {
+        const double aW0 = Spine->Absc(aStart, IE), aW1 = Spine->Absc(aAt, IE);
+        Starts.Append(std::min(aW0, aW1));
+        Ends.Append(std::max(aW0, aW1));
+      }
+      aIn = aNow;
+    }
+    if (aIn)
+    {
+      const double aW0 = Spine->Absc(aStart, IE), aW1 = Spine->Absc(aParam(aN), IE);
+      Starts.Append(std::min(aW0, aW1));
+      Ends.Append(std::max(aW0, aW1));
+    }
+    Folds[aSide] = Starts.Length() - aStretchesBefore;
+    if (ChFi3d_TracingWalkOnSpine())
+    {
+      for (int i = aStretchesBefore + 1; i <= Starts.Length(); i++)
+      {
+        std::fprintf(stderr, "fillet walk: edge %d, face %d: the contact line folds from w %.9g to %.9g\n", IE,
+                     aSide + 1, Starts(i), Ends(i));
+      }
+    }
+  }
+}
+
+//=======================================================================
+// function : ChFi3d_FoldCuts
+// purpose  : Where the guides of Spine are split around the stretches
+//            where a contact line folds (Starts, Ends: spine parameters,
+//            mitcad#2228), in increasing order: a little before and after
+//            each stretch, a tenth of its length (at least 10 Tol) outside
+//            it; stretches whose margins meet are one; a stretch reaching
+//            within its margin of the spine's ends has no neighbour there
+//            and is not split off.
+//=======================================================================
+static std::vector<double> ChFi3d_FoldCuts(const occ::handle<ChFiDS_Spine>&    Spine,
+                                           const NCollection_Sequence<double>& Starts,
+                                           const NCollection_Sequence<double>& Ends,
+                                           const double                        Tol)
+{
+  std::vector<std::pair<double, double>> aFolds;
+  for (int i = 1; i <= Starts.Length(); i++)
+  {
+    const double aMargin = std::max(10. * Tol, 0.1 * (Ends(i) - Starts(i)));
+    aFolds.emplace_back(Starts(i) - aMargin, Ends(i) + aMargin);
+  }
+  std::sort(aFolds.begin(), aFolds.end());
+  std::vector<std::pair<double, double>> aMerged;
+  for (const std::pair<double, double>& aFold : aFolds)
+  {
+    if (!aMerged.empty() && aFold.first <= aMerged.back().second)
+    {
+      aMerged.back().second = std::max(aMerged.back().second, aFold.second);
+    }
+    else
+    {
+      aMerged.push_back(aFold);
+    }
+  }
+  const double        aW0 = Spine->FirstParameter(1), aW1 = Spine->LastParameter(Spine->NbEdges());
+  std::vector<double> aCuts;
+  for (const std::pair<double, double>& aFold : aMerged)
+  {
+    if (aFold.first > aW0 + 10. * Tol && aFold.second < aW1 - 10. * Tol)
+    {
+      aCuts.push_back(aFold.first);
+      aCuts.push_back(aFold.second);
+    }
+    else if (ChFi3d_TracingWalkOnSpine())
+    {
+      std::fprintf(stderr,
+                   "fillet walk: fold from w %.9g to %.9g (with its margins) not split off: it reaches the "
+                   "spine's end (%.9g to %.9g)\n",
+                   aFold.first, aFold.second, aW0, aW1);
+    }
+  }
+  return aCuts;
+}
+
+//=======================================================================
+// The edges, per spine, along which a contact line of the rounding folds
+// over itself on its face (ChFi3d_FoldCutsOf, mitcad#2228): the edge's two
+// faces, the stretches (spine parameters) and which face's contact does
+// not fold (0, 1 or 2 for none, the first or the second face). Only a walk
+// between those faces whose guide runs across such a stretch is a walk
+// across a fold (ChFi3d_FoldWalkOf), with its own rules (BRepBlend_Walking
+// and the rest); every other walk is OCCT's as it was. Kept per thread, as
+// the builder's other walk settings.
+//=======================================================================
+namespace
+{
+//! Whether the stripe under way is computed with its guides split around
+//! the folds of its contact lines and the walks across them twisted
+//! (ChFi3d_Builder::Compute's second pass, for a stripe that failed
+//! without: mitcad#2228). Off, no fold is looked for.
+bool& ChFi3d_FoldStripesFlag()
+{
+  static thread_local bool aFlag = false;
+  return aFlag;
+}
+
+struct ChFi3d_FoldedEdge
+{
+  const ChFiDS_Spine*                    Spine;
+  TopoDS_Face                            F1;
+  TopoDS_Face                            F2;
+  int                                    FoldFree;
+  std::vector<std::pair<double, double>> Stretches;
+};
+
+std::vector<ChFi3d_FoldedEdge>& ChFi3d_FoldedEdges()
+{
+  static thread_local std::vector<ChFi3d_FoldedEdge> anEdges;
+  return anEdges;
+}
+} // namespace
+
+//=======================================================================
+// function : ChFi3d_FoldWalkOf
+// purpose  : Whether the walk of Spine between F1 and F2 along the guide's
+//            First to Last runs across a stretch where a contact line
+//            folds (ChFi3d_FoldCutsOf); OnContact: 1 or 2 where the
+//            contact on F1 or on F2 does not fold there and holds the
+//            sections in the guide's normal plane
+//            (BlendFunc_ConstRad::SetSectionOnContact), 0 (the contacts'
+//            mid-point) otherwise. (Used by ChFi3d_FilBuilder, mitcad#2228.)
+//=======================================================================
+bool ChFi3d_FoldWalkOf(const occ::handle<ChFiDS_Spine>& Spine,
+                       const TopoDS_Face&               F1,
+                       const TopoDS_Face&               F2,
+                       const double                     First,
+                       const double                     Last,
+                       int&                             OnContact)
+{
+  OnContact = 0;
+  if (Spine.IsNull() || !ChFi3d_FoldStripesFlag())
+  {
+    return false;
+  }
+  const double aLow = std::min(First, Last), aHigh = std::max(First, Last);
+  for (const ChFi3d_FoldedEdge& anEdge : ChFi3d_FoldedEdges())
+  {
+    if (anEdge.Spine != Spine.get())
+    {
+      continue;
+    }
+    const bool aSame    = anEdge.F1.IsSame(F1) && anEdge.F2.IsSame(F2);
+    const bool aSwapped = anEdge.F1.IsSame(F2) && anEdge.F2.IsSame(F1);
+    if (!aSame && !aSwapped)
+    {
+      continue;
+    }
+    for (const std::pair<double, double>& aStretch : anEdge.Stretches)
+    {
+      if (aStretch.first < aHigh && aStretch.second > aLow)
+      {
+        OnContact = anEdge.FoldFree == 0 ? 0 : (aSame ? anEdge.FoldFree : 3 - anEdge.FoldFree);
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+//=======================================================================
+// function : ChFi3d_FoldCutsOf
+// purpose  : ChFi3d_FoldCuts of a fillet of constant radius along Spine
+//            (not closed), the faces of its edge IE given by Faces (the
+//            builder's ConexFaces); none for another spine. Notes each
+//            edge whose contact line folds, its faces and stretches, and
+//            the face whose contact does not fold where the other's does
+//            (no stretch and a largest fold ratio below 0.9 on the one):
+//            ChFi3d_FoldWalkOf.
+//=======================================================================
+static std::vector<double> ChFi3d_FoldCutsOf(
+  const occ::handle<ChFiDS_Spine>&                                     Spine,
+  const std::function<void(const int, TopoDS_Face&, TopoDS_Face&)>& Faces,
+  const double                                                         Tol)
+{
+  std::vector<ChFi3d_FoldedEdge>& aFolded = ChFi3d_FoldedEdges();
+  aFolded.erase(std::remove_if(aFolded.begin(),
+                               aFolded.end(),
+                               [&](const ChFi3d_FoldedEdge& anEdge) { return anEdge.Spine == Spine.get(); }),
+                aFolded.end());
+  const occ::handle<ChFiDS_FilSpine> aFil = occ::down_cast<ChFiDS_FilSpine>(Spine);
+  if (!ChFi3d_FoldStripesFlag() || aFil.IsNull() || !aFil->IsConstant() || Spine->IsPeriodic())
+  {
+    return {};
+  }
+  NCollection_Sequence<double> aStarts, aEnds;
+  for (int iedge = 1; iedge <= Spine->NbEdges(); iedge++)
+  {
+    TopoDS_Face aF1, aF2;
+    Faces(iedge, aF1, aF2);
+    double    aMost[2];
+    int       aFolds[2];
+    const int aBefore = aStarts.Length();
+    ChFi3d_FoldsOfContact(Spine, iedge, aF1, aF2, aFil->Radius(), aStarts, aEnds, aMost, aFolds);
+    if (aStarts.Length() == aBefore)
+    {
+      continue;
+    }
+    ChFi3d_FoldedEdge anEdge{Spine.get(), aF1, aF2, 0, {}};
+    for (int i = aBefore + 1; i <= aStarts.Length(); i++)
+    {
+      anEdge.Stretches.emplace_back(aStarts(i), aEnds(i));
+    }
+    for (int aSide = 0; aSide < 2; aSide++)
+    {
+      const double aFree = aMost[aSide];
+      if (aFolds[aSide] == 0 && aFolds[1 - aSide] > 0 && aFree > -RealLast() && aFree < 0.9)
+      {
+        anEdge.FoldFree = aSide + 1;
+        if (ChFi3d_TracingWalkOnSpine())
+        {
+          std::fprintf(stderr,
+                       "fillet walk: edge %d: the contact on face %d (fold ratio at most %.6g) holds the "
+                       "sections, the one on face %d folds\n",
+                       iedge, aSide + 1, aFree, 2 - aSide);
+        }
+      }
+    }
+    aFolded.push_back(anEdge);
+  }
+  if (aStarts.IsEmpty())
+  {
+    return {};
+  }
+  return ChFi3d_FoldCuts(Spine, aStarts, aEnds, Tol);
+}
+
+//=======================================================================
+// function : ChFi3d_IsFoldCut
+// purpose  : Whether W is one of Cuts (ChFi3d_FoldCuts) within Tol.
+//=======================================================================
+static bool ChFi3d_IsFoldCut(const std::vector<double>& Cuts, const double W, const double Tol)
+{
+  for (const double aCut : Cuts)
+  {
+    if (std::abs(aCut - W) <= Tol)
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+//=======================================================================
+// function : ChFi3d_SetFoldStripes
+// purpose  : Switches the fold stripes' mode (ChFi3d_FoldStripesFlag) on
+//            or off; returns how it was. (Used by ChFi3d_Builder::Compute,
+//            mitcad#2228.)
+//=======================================================================
+bool ChFi3d_SetFoldStripes(const bool On)
+{
+  const bool aBefore        = ChFi3d_FoldStripesFlag();
+  ChFi3d_FoldStripesFlag() = On;
+  return aBefore;
+}
+
+//=======================================================================
+// function : ChFi3d_ContactLineFolds
+// purpose  : Whether a contact line of the rounding along Spine folds over
+//            itself on a face of its edges (ChFi3d_FoldsOfContact; the
+//            faces of each edge given by Faces): a stripe that failed so
+//            is computed again with its guides split around the folds
+//            (ChFi3d_Builder::Compute, mitcad#2228).
+//=======================================================================
+bool ChFi3d_ContactLineFolds(
+  const occ::handle<ChFiDS_Spine>&                                     Spine,
+  const std::function<void(const int, TopoDS_Face&, TopoDS_Face&)>& Faces,
+  const double                                                         Tol)
+{
+  const bool aBefore = ChFi3d_SetFoldStripes(true);
+  ChFi3d_FoldCutsOf(Spine, Faces, Tol);
+  ChFi3d_SetFoldStripes(aBefore);
+  for (const ChFi3d_FoldedEdge& anEdge : ChFi3d_FoldedEdges())
+  {
+    if (anEdge.Spine == Spine.get())
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+//=======================================================================
+// function : ChFi3d_SplitGuidesAtFolds
+// purpose  : The guides of Spine split at Cuts (ChFi3d_FoldCuts,
+//            mitcad#2228), so that the walk across each stretch where a
+//            contact line folds is a piece of its own, twisted, between
+//            untwisted pieces: PerformSetOfKGen fills a twisted piece
+//            between its neighbours, cut where their contact lines cross
+//            (the corner of the contact line where its swallowtail is cut
+//            away). The pieces after the first in a guide get the piece
+//            walked before them when they are walked (PerformSetOfKGen).
+//=======================================================================
+static void ChFi3d_SplitGuidesAtFolds(const occ::handle<ChFiDS_Spine>& Spine,
+                                      const std::vector<double>&       aCuts,
+                                      const double                     Tol)
+{
+  if (aCuts.empty())
+  {
+    return;
+  }
+  NCollection_List<occ::handle<ChFiDS_ElSpine>>& aGuides = Spine->ChangeElSpines();
+  NCollection_List<occ::handle<ChFiDS_ElSpine>>  aSplit;
+  for (NCollection_List<occ::handle<ChFiDS_ElSpine>>::Iterator anIt(aGuides); anIt.More(); anIt.Next())
+  {
+    occ::handle<ChFiDS_ElSpine> aCurrent = anIt.Value();
+    if (aCurrent->IsPeriodic())
+    {
+      aSplit.Append(aCurrent);
+      continue;
+    }
+    for (const double aCut : aCuts)
+    {
+      if (aCut <= aCurrent->FirstParameter() + 10. * Tol || aCut >= aCurrent->LastParameter() - 10. * Tol)
+      {
+        continue;
+      }
+      gp_Pnt aP, aLastP;
+      gp_Vec aT, aLastT;
+      Spine->D1(aCut, aP, aT);
+      aCurrent->LastPointAndTgt(aLastP, aLastT);
+      occ::handle<ChFiDS_ElSpine> aNext = new ChFiDS_ElSpine();
+      aNext->FirstParameter(aCut);
+      aNext->SetFirstPointAndTgt(aP, aT);
+      aNext->LastParameter(aCurrent->LastParameter());
+      aNext->SetLastPointAndTgt(aLastP, aLastT);
+      aNext->ChangeNext() = aCurrent->Next();
+      aCurrent->LastParameter(aCut);
+      aCurrent->SetLastPointAndTgt(aP, aT);
+      aCurrent->ChangeNext().Nullify();
+      if (ChFi3d_TracingWalkOnSpine())
+      {
+        std::fprintf(stderr, "fillet walk: guide split at %.9g where a contact line folds\n", aCut);
+      }
+      aSplit.Append(aCurrent);
+      aCurrent = aNext;
+    }
+    aSplit.Append(aCurrent);
+  }
+  aGuides = aSplit;
+}
