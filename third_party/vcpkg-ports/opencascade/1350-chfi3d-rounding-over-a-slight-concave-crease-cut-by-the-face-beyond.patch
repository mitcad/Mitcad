+namespace
+{
+// A rounding's transition over a slight concave crease E between faces B
+// and C (RoundingOverSlightCreases): the analytic blend A of the edge
+// before C, the pieces over C and on E between them (dropped), and the
+// walked piece W on B; side r is on C (in A on the face before C) and on
+// B (in W), the other side on T (W's other face) and on the face A's other
+// contact reaches T from.
+struct ChFi3d_SlightCrease
+{
+  int         iA = 0, iW = 0;
+  int         r  = 0;
+  TopoDS_Edge E;
+  TopoDS_Face B, C, T;
+  // (Made from them.)
+  occ::handle<ChFiDS_SurfData> RunOn; // A run on past its end, cut by T and C
+  occ::handle<ChFiDS_SurfData> Cut;   // W from the crossing on E to K, cut by C
+  double                       tP = 0., tK = 0.;
+  TopoDS_Vertex                VQ, VK;
+};
+} // namespace
+
+// The angle between the outward normals of faces F1 and F2 (as they lie
+// in the solid) at the middle of their edge E.
+static bool ChFi3d_CreaseAngle(const TopoDS_Edge& E, const TopoDS_Face& F1, const TopoDS_Face& F2, double& theAngle)
+{
+  gp_Dir aN[2];
+  int    k = 0;
+  for (const TopoDS_Face& F : {F1, F2})
+  {
+    double                          f = 0., l = 0.;
+    const occ::handle<Geom2d_Curve> aPC = BRep_Tool::CurveOnSurface(E, F, f, l);
+    if (aPC.IsNull())
+    {
+      return false;
+    }
+    const gp_Pnt2d      uv = aPC->Value(0.5 * (f + l));
+    BRepAdaptor_Surface aS(F, false);
+    BRepLProp_SLProps   aP(aS, uv.X(), uv.Y(), 1, 1.e-9);
+    if (!aP.IsNormalDefined())
+    {
+      return false;
+    }
+    gp_Dir aD = aP.Normal();
+    if (F.Orientation() == TopAbs_REVERSED)
+    {
+      aD.Reverse();
+    }
+    aN[k++] = aD;
+  }
+  theAngle = aN[0].Angle(aN[1]);
+  return true;
+}
