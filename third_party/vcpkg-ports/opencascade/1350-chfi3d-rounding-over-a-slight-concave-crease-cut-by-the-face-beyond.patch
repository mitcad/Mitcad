+//=======================================================================
+// function : ChFi3d_PCurveByPoints
+// purpose  : The p-curve of curve C (from f to l) on surface S through the
+//            projections of points along it, each within Tol of S, with
+//            C's parameters; null where a point lies off S. (Where
+//            GeomProjLib cannot project a curve ending on the boundary of
+//            a walked blend's surface, a cut from a point of its end
+//            section.)
+//=======================================================================
+
+static occ::handle<Geom2d_Curve> ChFi3d_PCurveByPoints(const occ::handle<Geom_Curve>&   C,
+                                                       const double                     f,
+                                                       const double                     l,
+                                                       const occ::handle<Geom_Surface>& S,
+                                                       const double                     Tol)
+{
+  const int                    nb = 40;
+  NCollection_Array1<gp_Pnt2d> aUV(1, nb + 1);
+  NCollection_Array1<double>   aPar(1, nb + 1);
+  // (The surface's bounds widened a little, so that a point on a boundary
+  // is found as a projection: past them a B-spline runs on along its end
+  // spans' polynomials.)
+  double u1 = 0., u2 = 0., v1 = 0., v2 = 0.;
+  S->Bounds(u1, u2, v1, v2);
+  if (!S->IsUPeriodic() && !Precision::IsInfinite(u1) && !Precision::IsInfinite(u2))
+  {
+    const double du = 0.05 * (u2 - u1);
+    u1 -= du;
+    u2 += du;
+  }
+  if (!S->IsVPeriodic() && !Precision::IsInfinite(v1) && !Precision::IsInfinite(v2))
+  {
+    const double dv = 0.05 * (v2 - v1);
+    v1 -= dv;
+    v2 += dv;
+  }
+  GeomAPI_ProjectPointOnSurf aPr;
+  aPr.Init(S, u1, u2, v1, v2, Precision::Confusion());
+  for (int k = 0; k <= nb; k++)
+  {
+    const double t = f + (l - f) * k / nb;
+    aPr.Perform(C->Value(t));
+    if (!aPr.IsDone() || aPr.NbPoints() == 0 || aPr.LowerDistance() > Tol)
+    {
+      return occ::handle<Geom2d_Curve>();
+    }
+    double u = 0., v = 0.;
+    aPr.LowerDistanceParameters(u, v);
+    if (k > 0)
+    {
+      // (Periodic parameters kept next to the previous point's.)
+      const gp_Pnt2d& p = aUV.Value(k);
+      if (S->IsUPeriodic())
+      {
+        u = ElCLib::InPeriod(u, p.X() - 0.5 * S->UPeriod(), p.X() + 0.5 * S->UPeriod());
+      }
+      if (S->IsVPeriodic())
+      {
+        v = ElCLib::InPeriod(v, p.Y() - 0.5 * S->VPeriod(), p.Y() + 0.5 * S->VPeriod());
+      }
+    }
+    aUV.SetValue(k + 1, gp_Pnt2d(u, v));
+    aPar.SetValue(k + 1, t);
+  }
+  try
+  {
+    OCC_CATCH_SIGNALS
+    Geom2dAPI_PointsToBSpline anApp(aUV, aPar, 3, 8, GeomAbs_C2, 1.e-9);
+    if (!anApp.IsDone())
+    {
+      return occ::handle<Geom2d_Curve>();
+    }
+    return occ::handle<Geom2d_Curve>(anApp.Curve());
+  }
+  catch (Standard_Failure const&)
+  {
+    return occ::handle<Geom2d_Curve>();
+  }
+}
