           }
         }
       }
+      {
+        // A contact going on inside F past the ends of an edge of F that it
+        // runs along (F as wide as the contact distance there only): the
+        // SurfData is split at those ends, the part along the edge then
+        // along a whole edge, the others inside F up to its vertices, so
+        // that F keeps no strip of no width along the edge.
+        double              tV = 0.;
+        const TopoDS_Vertex aV = edgeEndOnContact(C, T1, T2, F, aSpine, 0.1 * Tol3d, tV);
+        if (!aV.IsNull())
+        {
+          const occ::handle<ChFiDS_SurfData> aNext = ChFi3d_SplitAtVertexOnLine(DStr, aSpine, Fd, ons, tV, aV, F);
+          if (!aNext.IsNull())
+          {
