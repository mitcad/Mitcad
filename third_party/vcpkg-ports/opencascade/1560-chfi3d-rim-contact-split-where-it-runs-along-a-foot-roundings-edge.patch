+// The vertex of face F nearest to the start of the contact curve C on
+// [T1, T2] where an edge of F along C ends and C goes on inside F: a vertex
+// V of F strictly inside the contact, on C within Tol, of whose edges in F
+// (not edges of the spine) exactly one lies wholly on C, its other vertex
+// on C within the contact too, and the contact past V away from that edge,
+// halfway to the contact's end or the next such vertex, inside F. (A face
+// whose rest beside a blend is as wide as the blend's contact distance
+// along a part of the contact only: a boss's side between a rim rounded
+// down to the foot's earlier rounding where the foot has one, and wider
+// where it has none.) Its parameter on C in tV.
+static TopoDS_Vertex edgeEndOnContact(const occ::handle<Geom_Curve>&   C,
+                                      const double                     T1,
+                                      const double                     T2,
+                                      const TopoDS_Face&               F,
+                                      const occ::handle<ChFiDS_Spine>& Spine,
+                                      const double                     Tol,
+                                      double&                          tV)
+{
+  const double tmin = std::min(T1, T2), tmax = std::max(T1, T2);
+  // The parameter on C of point P, inside the contact, or none.
+  const auto onC = [&](const gp_Pnt& P, const double aTol, double& t) {
+    GeomAPI_ProjectPointOnCurve aProj(P, C, tmin, tmax);
+    if (aProj.NbPoints() == 0 || aProj.LowerDistance() > aTol)
+    {
+      return false;
+    }
+    t = aProj.LowerDistanceParameter();
+    return true;
+  };
+  // Whether edge E lies on C on its whole curve.
+  const auto along = [&](const TopoDS_Edge& E) {
+    double                        f = 0., l = 0.;
+    const occ::handle<Geom_Curve> aCE = BRep_Tool::Curve(E, f, l);
+    if (aCE.IsNull())
+    {
+      return false;
+    }
+    for (int i = 0; i <= 8; i++)
+    {
+      double t = 0.;
+      if (!onC(aCE->Value(f + (l - f) * i / 8.), Tol, t))
+      {
+        return false;
+      }
+    }
+    return true;
+  };
+  const occ::handle<Geom_Surface> S = BRep_Tool::Surface(F);
+  // Whether the point of C at t lies inside F.
+  const auto inF = [&](const double t) {
+    GeomAPI_ProjectPointOnSurf aProj(C->Value(t), S);
+    if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+    {
+      return false;
+    }
+    double u = 0., v = 0.;
+    aProj.LowerDistanceParameters(u, v);
+    BRepClass_FaceClassifier aCl(F, gp_Pnt2d(u, v), Precision::PConfusion());
+    return aCl.State() == TopAbs_IN;
+  };
+  NCollection_IndexedDataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher> aVE;
+  TopExp::MapShapesAndAncestors(F, TopAbs_VERTEX, TopAbs_EDGE, aVE);
+  // The vertices inside the contact, with their parameters and the side
+  // their edge along C lies on (+1 toward tmax, -1 toward tmin).
+  struct Cand
+  {
+    TopoDS_Vertex V;
+    double        t;
+    int           side;
+  };
+  std::vector<Cand> aCands;
+  std::vector<double> anInner; // (every vertex of F inside the contact on C)
+  for (int iv = 1; iv <= aVE.Extent(); iv++)
+  {
+    const TopoDS_Vertex& V = TopoDS::Vertex(aVE.FindKey(iv));
+    double               t = 0.;
+    if (!onC(BRep_Tool::Pnt(V), Tol + BRep_Tool::Tolerance(V), t))
+    {
+      continue;
+    }
+    if (t <= tmin + Precision::PConfusion() || t >= tmax - Precision::PConfusion())
+    {
+      continue;
+    }
+    anInner.push_back(t);
+    NCollection_List<TopoDS_Shape> anEdges;
+    bool                           onSpine = false;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(aVE(iv)); it.More() && !onSpine; it.Next())
+    {
+      onSpine = BRep_Tool::Degenerated(TopoDS::Edge(it.Value()));
+      for (int ie = 1; ie <= Spine->NbEdges() && !onSpine; ie++)
+      {
+        onSpine = Spine->Edges(ie).IsSame(it.Value());
+      }
+      if (!containsSame(anEdges, it.Value()))
+      {
+        anEdges.Append(it.Value());
+      }
+    }
+    if (onSpine || anEdges.Extent() < 2)
+    {
+      continue;
+    }
+    int         aNbAlong = 0;
+    TopoDS_Edge anAlong;
+    for (NCollection_List<TopoDS_Shape>::Iterator it(anEdges); it.More(); it.Next())
+    {
+      if (along(TopoDS::Edge(it.Value())))
+      {
+        aNbAlong++;
+        anAlong = TopoDS::Edge(it.Value());
+      }
+    }
+    if (aNbAlong != 1 || BRep_Tool::IsClosed(anAlong, F))
+    {
+      continue;
+    }
+    // The edge's other vertex, inside the contact too.
+    TopoDS_Vertex V1, V2;
+    TopExp::Vertices(anAlong, V1, V2);
+    const TopoDS_Vertex& Vo = V1.IsSame(V) ? V2 : V1;
+    double               to = 0.;
+    if (Vo.IsNull() || Vo.IsSame(V) || !onC(BRep_Tool::Pnt(Vo), Tol + BRep_Tool::Tolerance(Vo), to)
+        || std::abs(to - t) <= Precision::PConfusion())
+    {
+      continue;
+    }
+    aCands.push_back({V, t, to > t ? 1 : -1});
+  }
+  TopoDS_Vertex aBest;
+  double        aBestDist = RealLast();
+  for (const Cand& c : aCands)
+  {
+    // The contact past V away from the edge: up to its end or the next
+    // vertex of F on it.
+    double aFar = c.side > 0 ? tmin : tmax;
+    for (const double t : anInner)
+    {
+      if ((c.side > 0 && t < c.t - Precision::PConfusion() && t > aFar)
+          || (c.side < 0 && t > c.t + Precision::PConfusion() && t < aFar))
+      {
+        aFar = t;
+      }
+    }
+    if (!inF(0.5 * (c.t + aFar)))
+    {
+      continue;
+    }
+    const double aDist = std::abs(c.t - T1);
+    if (aDist < aBestDist)
+    {
+      aBestDist = aDist;
+      aBest     = c.V;
+      tV        = c.t;
+    }
+  }
+  return aBest;
+}
