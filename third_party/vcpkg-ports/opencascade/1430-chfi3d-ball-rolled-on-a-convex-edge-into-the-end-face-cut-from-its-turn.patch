+//=======================================================================
+// function : ChFi3d_RolledOnEndEdgeCutAtTurn
+// purpose  : An end (isFirst) of a stripe whose end piece P rolls, on side
+//            ons, on an edge E of the face B at the spine's end vertex V (E
+//            holds V), its other contact, on face Fo, ending at Q on the
+//            edge Eq between Fo and B at V. Along E the ball's contact runs
+//            towards V and turns back at T before P's end: P is split at
+//            T's section; the part from T to Q is cut by B from T to Q and
+//            ends in a point at Q, the part before T rolls on E. The stripe
+//            ends at Q, with no corner at V.
+//=======================================================================
+
+static bool ChFi3d_RolledOnEndEdgeCutAtTurn(TopOpeBRepDS_DataStructure&       DStr,
+                                            const occ::handle<ChFiDS_Stripe>& Stripe,
+                                            const bool                        isFirst,
+                                            const ChFiDS_Map&                 VFMap,
+                                            const double                      tol3d)
+{
+  const occ::handle<ChFiDS_Spine>& Spine = Stripe->Spine();
+  if (Spine.IsNull() || Spine->IsPeriodic() || Stripe->SetOfSurfData().IsNull()
+      || Stripe->SetOfSurfData()->IsEmpty())
+  {
+    return false;
+  }
+  if ((isFirst ? Spine->FirstStatus() : Spine->LastStatus()) > ChFiDS_BreakPoint)
+  {
+    return false;
+  }
+  const TopoDS_Vertex V = isFirst ? Spine->FirstVertex() : Spine->LastVertex();
+  if (V.IsNull() || !VFMap.Contains(V))
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_SurfData> P = isFirst ? Stripe->SetOfSurfData()->Sequence().First()
+                                                 : Stripe->SetOfSurfData()->Sequence().Last();
+  int ons = 0;
+  for (int s = 1; s <= 2; s++)
+  {
+    if (P->IsOnCurve(s) && !P->IsOnCurve(3 - s))
+    {
+      ons = s;
+    }
+  }
+  if (ons == 0)
+  {
+    return false;
+  }
+  const int opp = 3 - ons;
+  if (P->Index(ons) <= 0 || P->Index(opp) <= 0 || P->IndexOfC(ons) <= 0
+      || DStr.Shape(P->IndexOfC(ons)).ShapeType() != TopAbs_EDGE)
+  {
+    return false;
+  }
+  const TopoDS_Edge E  = TopoDS::Edge(DStr.Shape(P->IndexOfC(ons)));
+  const TopoDS_Face B  = TopoDS::Face(DStr.Shape(P->Index(ons)));
+  const TopoDS_Face Fo = TopoDS::Face(DStr.Shape(P->Index(opp)));
+  const auto        hasV = [&V](const TopoDS_Shape& S) {
+    for (TopExp_Explorer ex(S, TopAbs_VERTEX); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(V))
+      {
+        return true;
+      }
+    }
+    return false;
+  };
+  const auto hasEdge = [](const TopoDS_Shape& F, const TopoDS_Shape& Ed) {
+    for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+    {
+      if (ex.Current().IsSame(Ed))
+      {
+        return true;
+      }
+    }
+    return false;
+  };
+  bool aBAtV = false;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(VFMap.FindFromKey(V)); it.More(); it.Next())
+  {
+    aBAtV = aBAtV || it.Value().IsSame(B);
+  }
+  if (!aBAtV || !hasV(E) || !hasEdge(B, E) || BRep_Tool::Degenerated(E))
+  {
+    return false;
+  }
+  // Q: the other contact's end on the edge Eq of Fo and B at V.
+  const ChFiDS_CommonPoint& CPq = P->Vertex(isFirst, opp);
+  if (!CPq.IsOnArc() || CPq.IsVertex())
+  {
+    return false;
+  }
+  const TopoDS_Edge Eq = CPq.Arc();
+  if (Eq.IsSame(E) || !hasV(Eq) || !hasEdge(B, Eq) || !hasEdge(Fo, Eq))
+  {
+    return false;
+  }
+  // The contact's line on E, and the point T where it comes nearest V.
+  const ChFiDS_FaceInterference& FN = P->Interference(ons);
+  const ChFiDS_FaceInterference& FO = P->Interference(opp);
+  if (FN.LineIndex() <= 0 || FO.LineIndex() <= 0 || FN.PCurveOnSurf().IsNull() || FO.PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve>& CN = DStr.Curve(FN.LineIndex()).Curve();
+  double                          fE = 0., lE = 0.;
+  const occ::handle<Geom_Curve>   CE = BRep_Tool::Curve(E, fE, lE);
+  if (CN.IsNull() || CE.IsNull())
+  {
+    return false;
+  }
+  const double wV = BRep_Tool::Parameter(V, E);
+  // (The lines may run on past Q, the walk's end: Q's parameter on the
+  // other contact's line is P's end.)
+  double t0 = FN.FirstParameter(), t1 = FN.LastParameter();
+  {
+    const occ::handle<Geom_Curve>& CO = DStr.Curve(FO.LineIndex()).Curve();
+    if (CO.IsNull())
+    {
+      return false;
+    }
+    GeomAPI_ProjectPointOnCurve aPr(CPq.Point(), CO, t0, t1);
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 10. * tol3d)
+    {
+      return false;
+    }
+    (isFirst ? t0 : t1) = aPr.LowerDistanceParameter();
+  }
+  if (t1 - t0 <= Precision::PConfusion())
+  {
+    return false;
+  }
+  // (The contact's distance from V along E at line parameter t.)
+  const auto alongE = [&](const double t, double& w) {
+    GeomAPI_ProjectPointOnCurve aPr(CN->Value(t), CE, fE, lE);
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 10. * tol3d)
+    {
+      return false;
+    }
+    w = aPr.LowerDistanceParameter();
+    return true;
+  };
+  const int n    = 200;
+  int       iMin = -1;
+  double    dMin = RealLast();
+  for (int i = 0; i <= n; i++)
+  {
+    double w = 0.;
+    if (!alongE(t0 + (t1 - t0) * i / n, w))
+    {
+      return false;
+    }
+    if (std::abs(w - wV) < dMin)
+    {
+      dMin = std::abs(w - wV);
+      iMin = i;
+    }
+  }
+  // (A turn: the line's ends both farther from V.)
+  if (iMin <= 0 || iMin >= n)
+  {
+    return false;
+  }
+  double a = t0 + (t1 - t0) * (iMin - 1) / n, b = t0 + (t1 - t0) * (iMin + 1) / n;
+  for (int k = 0; k < 60 && b - a > Precision::PConfusion() * 1.e-2; k++)
+  {
+    const double m1 = a + (b - a) * 0.381966, m2 = a + (b - a) * 0.618034;
+    double       w1 = 0., w2 = 0.;
+    if (!alongE(m1, w1) || !alongE(m2, w2))
+    {
+      return false;
+    }
+    if (std::abs(w1 - wV) < std::abs(w2 - wV))
+    {
+      b = m2;
+    }
+    else
+    {
+      a = m1;
+    }
+  }
+  const double tT = 0.5 * (a + b);
+  double       wT = 0.;
+  if (!alongE(tT, wT))
+  {
+    return false;
+  }
+  double wEnd = 0., wJ = 0.;
+  if (!alongE(isFirst ? t0 : t1, wEnd) || !alongE(isFirst ? t1 : t0, wJ)
+      || std::abs(wEnd - wV) - std::abs(wT - wV) <= 10. * tol3d || std::abs(wJ - wV) - std::abs(wT - wV) <= 10. * tol3d)
+  {
+    return false;
+  }
+  // The common points at T: on E (with the transition the contact has on
+  // it at P's other end), and the other contact's point.
+  const ChFiDS_CommonPoint& CPj = P->Vertex(!isFirst, ons);
+  if (!CPj.IsOnArc() || !CPj.Arc().IsSame(E))
+  {
+    return false;
+  }
+  ChFiDS_CommonPoint CPTn, CPTo;
+  {
+    gp_Pnt PT;
+    gp_Vec VT;
+    CN->D1(tT, PT, VT);
+    CPTn.Reset();
+    CPTn.SetPoint(CE->Value(wT));
+    CPTn.SetVector(VT);
+    CPTn.SetArc(tol3d, E, wT, CPj.TransitionOnArc());
+    const occ::handle<Geom_Curve>& CO = DStr.Curve(FO.LineIndex()).Curve();
+    gp_Pnt                          PO;
+    gp_Vec                          VO;
+    CO->D1(tT, PO, VO);
+    CPTo.Reset();
+    CPTo.SetPoint(PO);
+    CPTo.SetVector(VO);
+    CPTo.SetTolerance(DStr.Curve(FO.LineIndex()).Tolerance());
+  }
+  // The part before T, rolling on E.
+  occ::handle<ChFiDS_SurfData> X1 = isFirst ? ChFi3d_TrimWalkedPiece(DStr, P, tT, t1, P->Surf())
+                                            : ChFi3d_TrimWalkedPiece(DStr, P, t0, tT, P->Surf());
+  if (X1.IsNull())
+  {
+    return false;
+  }
+  if (ons == 1)
+  {
+    X1->SetIndexOfC1(P->IndexOfC1());
+  }
+  else
+  {
+    X1->SetIndexOfC2(P->IndexOfC2());
+  }
+  X1->ChangeVertex(isFirst, ons) = CPTn;
+  X1->ChangeVertex(isFirst, opp) = CPTo;
+  // The part past T, cut by B from T to Q, on a surface of its own (a face
+  // of its own).
+  const int aSurf2 = DStr.AddSurface(
+    TopOpeBRepDS_Surface(occ::down_cast<Geom_Surface>(DStr.Surface(P->Surf()).Surface()->Copy()),
+                         DStr.Surface(P->Surf()).Tolerance()));
+  occ::handle<ChFiDS_SurfData> X2;
+  try
+  {
+    OCC_CATCH_SIGNALS
+    X2 = ChFi3d_NarrowCutPiece(DStr,
+                               P,
+                               ons,
+                               B,
+                               isFirst ? t0 : tT,
+                               isFirst ? tT : t1,
+                               isFirst,
+                               CPq.Point(),
+                               Eq,
+                               CPq.ParameterOnArc(),
+                               CPq.TransitionOnArc(),
+                               TopoDS_Vertex(),
+                               CPTn.Point(),
+                               aSurf2,
+                               tol3d,
+                               &CPTn,
+                               &CPTo);
+  }
+  catch (Standard_Failure const&)
+  {
+    X2.Nullify();
+  }
+  if (X2.IsNull())
+  {
+    return false;
+  }
+  NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq = Stripe->ChangeSetOfSurfData()->ChangeSequence();
+  if (isFirst)
+  {
+    aSeq.Remove(1);
+    aSeq.Prepend(X1);
+    aSeq.Prepend(X2);
+    Spine->SetFirstStatus(ChFiDS_FreeBoundary);
+  }
+  else
+  {
+    aSeq.Remove(aSeq.Length());
+    aSeq.Append(X1);
+    aSeq.Append(X2);
+    Spine->SetLastStatus(ChFiDS_FreeBoundary);
+  }
+  return true;
+}
+
+//=======================================================================
+// function : ChFi3d_WalkedOnPastEndEdge
+// purpose  : Whether an end (isFirst) of a stripe was walked on past a
+//            convex edge E into a face B at the end (the contact on a face
+//            N of a piece near the end reached E, which holds the spine's
+//            end vertex V, B the face beyond E holding V), over N's surface,
+//            and the walk does not close on B: the other contact ran on
+//            from its face Fo onto another face before it reached the edge
+//            Eq between Fo and B at V.
+//=======================================================================
+
+static bool ChFi3d_WalkedOnPastEndEdge(const TopOpeBRepDS_DataStructure& DStr,
+                                       const occ::handle<ChFiDS_Stripe>& Stripe,
+                                       const bool                        isFirst,
+                                       const ChFiDS_Map&                 EFMap,
+                                       const ChFiDS_Map&                 VFMap)
+{
+  const occ::handle<ChFiDS_Spine>& Spine = Stripe->Spine();
+  if (Spine.IsNull() || Spine->IsPeriodic() || Stripe->SetOfSurfData().IsNull()
+      || Stripe->SetOfSurfData()->IsEmpty())
+  {
+    return false;
+  }
+  const TopoDS_Vertex V = isFirst ? Spine->FirstVertex() : Spine->LastVertex();
+  if (V.IsNull() || !VFMap.Contains(V))
+  {
+    return false;
+  }
+  const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq = Stripe->SetOfSurfData()->Sequence();
+  const int                                                 n    = aSeq.Length();
+  const occ::handle<ChFiDS_SurfData>&                       aEnd = isFirst ? aSeq.First() : aSeq.Last();
+  for (int k = 0; k < std::min(3, n); k++)
+  {
+    const occ::handle<ChFiDS_SurfData>& SD = aSeq(isFirst ? 1 + k : n - k);
+    for (int s = 1; s <= 2; s++)
+    {
+      const ChFiDS_CommonPoint& CP = SD->Vertex(isFirst, s);
+      if (SD->IsOnCurve(s) || SD->IsOnCurve(3 - s) || SD->Index(s) <= 0 || SD->Index(3 - s) <= 0
+          || !CP.IsOnArc() || CP.IsVertex())
+      {
+        continue;
+      }
+      const TopoDS_Face N = TopoDS::Face(DStr.Shape(SD->Index(s)));
+      TopoDS_Face       B;
+      if (!ChFi3d_ConvexEdgeIntoEndFace(CP.Arc(), N, V, CP.ParameterOnArc(), EFMap, VFMap, B))
+      {
+        continue;
+      }
+      // (Not closed on B: the end piece's other contact ran on from that
+      // piece's other face Fo onto another face, short of B's edge with Fo
+      // at V.)
+      if (aEnd->Index(3 - s) <= 0 || aEnd->Index(3 - s) == SD->Index(3 - s))
+      {
+        return false;
+      }
+      const TopoDS_Face Fo = TopoDS::Face(DStr.Shape(SD->Index(3 - s)));
+      for (TopExp_Explorer ex(B, TopAbs_EDGE); ex.More(); ex.Next())
+      {
+        const TopoDS_Edge& Eq = TopoDS::Edge(ex.Current());
+        if ((TopExp::FirstVertex(Eq).IsSame(V) || TopExp::LastVertex(Eq).IsSame(V)) && EFMap.Contains(Eq))
+        {
+          for (const TopoDS_Shape& aFace : EFMap.FindFromKey(Eq))
+          {
+            if (aFace.IsSame(Fo))
+            {
+              return true;
+            }
+          }
+        }
+      }
+      return false;
+    }
+  }
+  return false;
+}
