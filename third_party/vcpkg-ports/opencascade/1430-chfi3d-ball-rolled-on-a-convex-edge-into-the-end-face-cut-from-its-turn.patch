+//=======================================================================
+// function : ChFi3d_RollsOnEndEdge
+// purpose  : A contact that left its face F across a convex edge E more
+//            than Tol before the spine's end, where E holds the end vertex
+//            Vend and the face beyond E is a face at the end
+//            (ChFi3d_ConvexEdgeIntoEndFace): the ball may roll on E up to
+//            that face (ChFi3d_ObstacleBeforeEnd's case, at the end).
+//=======================================================================
+
+bool ChFi3d_RollsOnEndEdge(const ChFiDS_CommonPoint& CP,
+                           const TopoDS_Face&        F,
+                           const TopoDS_Vertex&      Vend,
+                           const double              W,
+                           const double              WEnd,
+                           const bool                AtFirst,
+                           const double              Tol,
+                           const ChFiDS_Map&         EFMap,
+                           const ChFiDS_Map&         VFMap)
+{
+  if (!CP.IsOnArc() || CP.IsVertex() || (AtFirst ? W - WEnd : WEnd - W) <= Tol)
+  {
+    return false;
+  }
+  TopoDS_Face Fbeyond;
+  return ChFi3d_ConvexEdgeIntoEndFace(CP.Arc(), F, Vend, CP.ParameterOnArc(), EFMap, VFMap, Fbeyond);
+}
