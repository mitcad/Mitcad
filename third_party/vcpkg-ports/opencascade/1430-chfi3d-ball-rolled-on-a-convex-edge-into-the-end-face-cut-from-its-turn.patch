+//=======================================================================
+// function : ChFi3d_ConvexEdgeIntoEndFace
+// purpose  : Edge E of face F holds the spine's end vertex Vend, and the
+//            face beyond E (Fbeyond, the only other face of E) holds Vend
+//            too: a face at the end. E is convex between them at its
+//            parameter W.
+//=======================================================================
+
+bool ChFi3d_ConvexEdgeIntoEndFace(const TopoDS_Edge&   E,
+                                  const TopoDS_Face&   F,
+                                  const TopoDS_Vertex& Vend,
+                                  const double         W,
+                                  const ChFiDS_Map&    EFMap,
+                                  const ChFiDS_Map&    VFMap,
+                                  TopoDS_Face&         Fbeyond)
+{
+  Fbeyond.Nullify();
+  if (E.IsNull() || F.IsNull() || Vend.IsNull() || BRep_Tool::Degenerated(E) || !EFMap.Contains(E)
+      || !VFMap.Contains(Vend))
+  {
+    return false;
+  }
+  if (!TopExp::FirstVertex(E).IsSame(Vend) && !TopExp::LastVertex(E).IsSame(Vend))
+  {
+    return false;
+  }
+  TopoDS_Face Fin;
+  for (const TopoDS_Shape& aFace : EFMap.FindFromKey(E))
+  {
+    if (aFace.IsSame(F))
+    {
+      Fin = TopoDS::Face(aFace);
+      continue;
+    }
+    if (!Fbeyond.IsNull() && !Fbeyond.IsSame(aFace))
+    {
+      Fbeyond.Nullify();
+      return false;
+    }
+    Fbeyond = TopoDS::Face(aFace);
+  }
+  if (Fin.IsNull() || Fbeyond.IsNull())
+  {
+    Fbeyond.Nullify();
+    return false;
+  }
+  bool atEnd = false;
+  for (const TopoDS_Shape& aFaceAtEnd : VFMap.FindFromKey(Vend))
+  {
+    atEnd = atEnd || aFaceAtEnd.IsSame(Fbeyond);
+  }
+  if (!atEnd || !ChFi3d_ConvexEdgeAt(E, Fin, Fbeyond, W))
+  {
+    Fbeyond.Nullify();
+    return false;
+  }
+  return true;
+}
