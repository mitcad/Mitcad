+// Removes the entries of stripe S from parallel lists of stripes and shapes.
+static void removeEntriesOf(const occ::handle<ChFiDS_Stripe>&             S,
+                            NCollection_List<occ::handle<ChFiDS_Stripe>>& Stripes,
+                            NCollection_List<TopoDS_Shape>&               L1,
+                            NCollection_List<TopoDS_Shape>&               L2)
+{
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itS(Stripes);
+  NCollection_List<TopoDS_Shape>::Iterator               it1(L1), it2(L2);
+  while (itS.More())
+  {
+    if (itS.Value() == S)
+    {
+      Stripes.Remove(itS);
+      L1.Remove(it1);
+      L2.Remove(it2);
+    }
+    else
+    {
+      itS.Next();
+      it1.Next();
+      it2.Next();
+    }
+  }
+}
+
+// The surface data of stripe S with a side (not on an edge) on face F,
+// when there is one only.
+static bool findRideSurfData(const TopOpeBRepDS_DataStructure& DStr,
+                             const occ::handle<ChFiDS_Stripe>& S,
+                             const TopoDS_Shape&               F,
+                             occ::handle<ChFiDS_SurfData>&     SD,
+                             int&                              OnS)
+{
+  SD.Nullify();
+  OnS = 0;
+  if (S->SetOfSurfData().IsNull())
+  {
+    return false;
+  }
+  for (int i = 1; i <= S->SetOfSurfData()->Length(); i++)
+  {
+    const occ::handle<ChFiDS_SurfData>& aSD = S->SetOfSurfData()->Value(i);
+    for (int k = 1; k <= 2; k++)
+    {
+      if (aSD->Index(k) > 0 && DStr.Shape(aSD->Index(k)).IsSame(F))
+      {
+        if (!SD.IsNull())
+        {
+          return false;
+        }
+        SD  = aSD;
+        OnS = k;
+      }
+    }
+  }
+  return !SD.IsNull();
+}
+
+bool ChFi3d_Builder::RideOf(const occ::handle<ChFiDS_Stripe>& S,
+                            TopoDS_Face&                      F,
+                            TopoDS_Edge&                      E,
+                            TopoDS_Face&                      Support) const
+{
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itS(myRideStripes);
+  NCollection_List<TopoDS_Shape>::Iterator               itF(myRideFaces);
+  NCollection_List<TopoDS_Shape>::Iterator               itE(myRideEdges);
+  NCollection_List<TopoDS_Shape>::Iterator               itA(myRideSupports);
+  for (; itS.More(); itS.Next(), itF.Next(), itE.Next(), itA.Next())
+  {
+    if (itS.Value() == S)
+    {
+      F       = TopoDS::Face(itF.Value());
+      E       = TopoDS::Edge(itE.Value());
+      Support = TopoDS::Face(itA.Value());
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ChFi3d_Builder::RideOnOverlap(const occ::handle<ChFiDS_Stripe>& A,
+                                   const occ::handle<ChFiDS_Stripe>& B,
+                                   const TopoDS_Face&                F)
+{
+  TopOpeBRepDS_DataStructure& DStr = myDS->ChangeDS();
+  // (Only roundings of the same kind, both convex or both concave: the
+  // later ball then passes through the earlier one's contact line.)
+  ChFiDS_TypeOfConcavity aType[2] = {ChFiDS_Other, ChFiDS_Other};
+  for (int i = 0; i < 2; i++)
+  {
+    const TopoDS_Edge E = spineEdgeOf(i == 0 ? A->Spine() : B->Spine(), F);
+    if (E.IsNull() || !myEFMap.Contains(E) || myEFMap(E).Extent() != 2)
+    {
+      return false;
+    }
+    aType[i] = ChFi3d::DefineConnectType(E,
+                                         TopoDS::Face(myEFMap(E).First()),
+                                         TopoDS::Face(myEFMap(E).Last()),
+                                         1.e-6,
+                                         false);
+  }
+  if (aType[0] != aType[1] || (aType[0] != ChFiDS_Convex && aType[0] != ChFiDS_Concave))
+  {
+    return false;
+  }
+  removeEntriesOf(A, myOverlapStripes, myOverlapFaces, myOverlapEdges);
+  removeEntriesOf(B, myOverlapStripes, myOverlapFaces, myOverlapEdges);
+  // A on the faces of its edge.
+  A->Reset();
+  A->Spine()->SetErrorStatus(ChFiDS_Ok);
+  try
+  {
+    OCC_CATCH_SIGNALS
+    occ::handle<ChFiDS_Stripe> aStripe = A;
+    PerformSetOfSurf(aStripe);
+  }
+  catch (Standard_Failure const&)
+  {
+    return false;
+  }
+  // A's contact line on F (one surface data).
+  const int                    iF = DStr.AddShape(F);
+  occ::handle<ChFiDS_SurfData> SA;
+  int                          onA = 0;
+  for (int i = 1; i <= A->SetOfSurfData()->Length(); i++)
+  {
+    const occ::handle<ChFiDS_SurfData>& SD = A->SetOfSurfData()->Value(i);
+    for (int k = 1; k <= 2; k++)
+    {
+      if (SD->Index(k) == iF && !SD->IsOnCurve(k))
+      {
+        if (!SA.IsNull())
+        {
+          return false;
+        }
+        SA  = SD;
+        onA = k;
+      }
+    }
+  }
+  if (SA.IsNull())
+  {
+    return false;
+  }
+  const ChFiDS_FaceInterference& FI = SA->Interference(onA);
+  if (FI.LineIndex() <= 0 || FI.PCurveOnFace().IsNull() || FI.PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve>&   C  = DStr.Curve(FI.LineIndex()).Curve();
+  const occ::handle<Geom_Surface>& SS = DStr.Surface(SA->Surf()).Surface();
+  const double                     t1 = FI.FirstParameter(), t2 = FI.LastParameter();
+  if (C.IsNull() || SS.IsNull() || t2 - t1 <= Precision::PConfusion())
+  {
+    return false;
+  }
+  // A's blend as a face, over the parameters of its contact lines.
+  double u1 = RealLast(), u2 = -RealLast(), v1 = RealLast(), v2 = -RealLast();
+  for (int k = 1; k <= 2; k++)
+  {
+    const ChFiDS_FaceInterference& FIk = SA->Interference(k);
+    if (FIk.PCurveOnSurf().IsNull())
+    {
+      return false;
+    }
+    for (int i = 0; i <= 10; i++)
+    {
+      const double   t  = FIk.FirstParameter() + (FIk.LastParameter() - FIk.FirstParameter()) * i / 10.;
+      const gp_Pnt2d uv = FIk.PCurveOnSurf()->Value(t);
+      u1                = std::min(u1, uv.X());
+      u2                = std::max(u2, uv.X());
+      v1                = std::min(v1, uv.Y());
+      v2                = std::max(v2, uv.Y());
+    }
+  }
+  BRepLib_MakeFace aMakeFace(SS, u1, u2, v1, v2, Precision::Confusion());
+  if (!aMakeFace.IsDone())
+  {
+    return false;
+  }
+  TopoDS_Face Support = aMakeFace.Face();
+  Support.Orientation(SA->Orientation());
+  // The contact line as an edge, with its p-curves on F and on the blend.
+  BRepLib_MakeEdge aMakeEdge(C, t1, t2);
+  if (!aMakeEdge.IsDone())
+  {
+    return false;
+  }
+  TopoDS_Edge  E = aMakeEdge.Edge();
+  BRep_Builder aBuilder;
+  const double aTol = std::max(DStr.Curve(FI.LineIndex()).Tolerance(), Precision::Confusion());
+  aBuilder.UpdateEdge(E, FI.PCurveOnFace(), F, aTol);
+  aBuilder.UpdateEdge(E, FI.PCurveOnSurf(), Support, aTol);
+  myRideStripes.Append(B);
+  myRideOn.Append(A);
+  myRideFaces.Append(F);
+  myRideEdges.Append(E);
+  myRideSupports.Append(Support);
+  B->Reset();
+  B->Spine()->SetErrorStatus(ChFiDS_Ok);
+  try
+  {
+    OCC_CATCH_SIGNALS
+    occ::handle<ChFiDS_Stripe> aStripe = B;
+    PerformSetOfSurf(aStripe);
+  }
+  catch (Standard_Failure const& anException)
+  {
+    (void)anException;
+    return false;
+  }
+  // B's side on the line: its common points at the ends are on the arcs
+  // A's contact line ends on (the line's direction there is B's, opposite
+  // to A's as the two blends see it), or mere points at the start of a
+  // closed line, not the vertex of the line's edge.
+  occ::handle<ChFiDS_SurfData> SB;
+  int                          onB = 0;
+  if (!findRideSurfData(DStr, B, Support, SB, onB))
+  {
+    return false;
+  }
+  for (int f = 0; f < 2; f++)
+  {
+    ChFiDS_CommonPoint& CPB  = SB->ChangeVertex(f == 0, onB);
+    const gp_Pnt        aP   = CPB.Point();
+    const double        aPar = CPB.Parameter();
+    CPB.Reset();
+    CPB.SetPoint(aP);
+    CPB.SetParameter(aPar);
+    for (int g = 0; g < 2; g++)
+    {
+      const ChFiDS_CommonPoint& CPA = SA->Vertex(g == 0, onA);
+      if (CPA.IsOnArc() && !CPA.IsVertex() && CPA.Point().Distance(aP) <= 10. * tolapp3d)
+      {
+        CPB.SetArc(CPA.Tolerance(),
+                   CPA.Arc(),
+                   CPA.ParameterOnArc(),
+                   TopAbs::Reverse(CPA.TransitionOnArc()));
+        break;
+      }
+    }
+  }
+  return true;
+}
+
+void ChFi3d_Builder::ApplyRides()
+{
+  TopOpeBRepDS_DataStructure&                            DStr = myDS->ChangeDS();
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itB(myRideStripes), itA(myRideOn);
+  NCollection_List<TopoDS_Shape>::Iterator               itF(myRideFaces), itS(myRideSupports);
+  for (; itB.More(); itB.Next(), itA.Next(), itF.Next(), itS.Next())
+  {
+    const occ::handle<ChFiDS_Stripe>& A = itA.Value();
+    const occ::handle<ChFiDS_Stripe>& B = itB.Value();
+    occ::handle<ChFiDS_SurfData>      SA, SB;
+    int                               onA = 0, onB = 0;
+    if (!findRideSurfData(DStr, A, itF.Value(), SA, onA)
+        || !findRideSurfData(DStr, B, itS.Value(), SB, onB))
+    {
+      continue;
+    }
+    const ChFiDS_FaceInterference& FI = SA->Interference(onA);
+    if (FI.LineIndex() <= 0)
+    {
+      continue;
+    }
+    const occ::handle<Geom_Curve>& C  = DStr.Curve(FI.LineIndex()).Curve();
+    const double                   t1 = FI.FirstParameter(), t2 = FI.LastParameter();
+    // (B's start at A's start: the line runs the same way for both.)
+    if (C.IsNull() || t2 - t1 <= Precision::PConfusion()
+        || SB->Vertex(true, onB).Point().Distance(SA->Vertex(true, onA).Point()) > 10. * tolapp3d)
+    {
+      continue;
+    }
+    // The two blends meet on A's contact line: both sides hold that line,
+    // each on its own surface, and lie on no face (F, between the line and
+    // B's edge, has no contact line left and vanishes).
+    const occ::handle<Geom2d_Curve> PCB = GeomProjLib::Curve2d(new Geom_TrimmedCurve(C, t1, t2),
+                                                               t1,
+                                                               t2,
+                                                               DStr.Surface(SB->Surf()).Surface());
+    if (PCB.IsNull())
+    {
+      continue;
+    }
+    ChFiDS_FaceInterference& aFIB = SB->ChangeInterference(onB);
+    aFIB.SetInterference(FI.LineIndex(), aFIB.Transition(), PCB, PCB);
+    aFIB.SetFirstParameter(t1);
+    aFIB.SetLastParameter(t2);
+    if (onA == 1)
+    {
+      SA->ChangeIndexOfS1(0);
+    }
+    else
+    {
+      SA->ChangeIndexOfS2(0);
+    }
+    if (onB == 1)
+    {
+      SB->ChangeIndexOfS1(0);
+      SB->SetIndexOfC1(0);
+    }
+    else
+    {
+      SB->ChangeIndexOfS2(0);
+      SB->SetIndexOfC2(0);
+    }
+    // At the ends of the line the two blends meet on an arc between F and
+    // the face at the end: that arc, from A's edge to B's, lies on F's side
+    // of both blends and vanishes with F (as the edges of a face that a
+    // blend rolling on an edge consumes, ChFi3d_CutConsumedFaces): it is cut
+    // at its vertices, and the blends' points on it are mere points.
+    for (int f = 0; f < 2; f++)
+    {
+      for (int s = 0; s < 2; s++)
+      {
+        ChFiDS_CommonPoint& CP =
+          s == 0 ? SA->ChangeVertex(f == 0, onA) : SB->ChangeVertex(f == 0, onB);
+        if (!CP.IsOnArc() || CP.IsVertex())
+        {
+          continue;
+        }
+        TopoDS_Edge  anArc = CP.Arc();
+        const gp_Pnt aP    = CP.Point();
+        const double aPar  = CP.Parameter();
+        CP.Reset();
+        CP.SetPoint(aP);
+        CP.SetParameter(aPar);
+        if (s == 1)
+        {
+          continue;
+        }
+        const int Iarc = DStr.AddShape(anArc);
+        anArc.Orientation(TopAbs_FORWARD);
+        for (TopExp_Explorer exv(anArc, TopAbs_VERTEX); exv.More(); exv.Next())
+        {
+          const TopoDS_Vertex& vv = TopoDS::Vertex(exv.Current());
+          DStr.ChangeShapeInterferences(Iarc).Append(
+            ChFi3d_FilVertexInDS(TopAbs::Reverse(vv.Orientation()),
+                                 Iarc,
+                                 DStr.AddShape(vv),
+                                 BRep_Tool::Parameter(vv, anArc)));
+        }
+      }
+    }
+    // B's points on the line are A's.
+    for (int f = 0; f < 2; f++)
+    {
+      if (A->IndexPoint(f == 0, onA) > 0)
+      {
+        B->SetIndexPoint(A->IndexPoint(f == 0, onA), f == 0, onB);
+      }
+    }
+  }
+}
