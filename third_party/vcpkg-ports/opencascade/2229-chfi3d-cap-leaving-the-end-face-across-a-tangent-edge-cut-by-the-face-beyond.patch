+//=======================================================================
+// function : ChFi3d_CapLeavesAcrossTangentEdge
+// purpose  : Whether the cap of a blend's end on the face at the end Fv
+//            (its curve Pc on Fv from Udeb to Ufin, which ends on Fv's
+//            arcs ArcS1 and ArcS2) leaves Fv across one other edge Ea of
+//            Fv and comes back across Ea, the face beyond Ea (Fg) tangent
+//            to Fv along it: a flat face of a rounded body that ends in
+//            the rounding, smaller than the blend's section there. Ea,
+//            Fg, the cap's parameters at the two crossings (T1 < T2) and
+//            Ea's there (W1, W2). False elsewhere: no crossing, a crossing
+//            of another edge, more than two, one at an end of the cap, an
+//            overlap, or a face beyond that is not tangent to Fv.
+//=======================================================================
+
+static bool ChFi3d_CapLeavesAcrossTangentEdge(const ChFiDS_Map&                EFMap,
+                                              const TopoDS_Face&               Fv,
+                                              const occ::handle<Geom2d_Curve>& Pc,
+                                              const double                     Udeb,
+                                              const double                     Ufin,
+                                              const TopoDS_Edge&               ArcS1,
+                                              const TopoDS_Edge&               ArcS2,
+                                              const double                     Tol2d,
+                                              TopoDS_Edge&                     Ea,
+                                              TopoDS_Face&                     Fg,
+                                              double&                          T1,
+                                              double&                          T2,
+                                              double&                          W1,
+                                              double&                          W2)
+{
+  if (Pc.IsNull() || !(Ufin > Udeb))
+  {
+    return false;
+  }
+  TopoDS_Face FvF = Fv;
+  FvF.Orientation(TopAbs_FORWARD);
+  const occ::handle<Geom2d_Curve> aCap  = new Geom2d_TrimmedCurve(Pc, Udeb, Ufin);
+  const double                    aNear = 1.e-3 * (Ufin - Udeb);
+  for (TopExp_Explorer ex(FvF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(E) || E.IsSame(ArcS1) || E.IsSame(ArcS2))
+    {
+      continue;
+    }
+    double                          f = 0., l = 0.;
+    const occ::handle<Geom2d_Curve> aE2d = BRep_Tool::CurveOnSurface(E, FvF, f, l);
+    if (aE2d.IsNull())
+    {
+      return false;
+    }
+    Geom2dAPI_InterCurveCurve aInter(aCap, new Geom2d_TrimmedCurve(aE2d, f, l), Tol2d);
+    const Geom2dInt_GInter&   aI = aInter.Intersector();
+    if (!aI.IsDone() || aI.NbSegments() > 0)
+    {
+      return false;
+    }
+    if (aI.NbPoints() == 0)
+    {
+      continue;
+    }
+    if (aI.NbPoints() != 2 || !Ea.IsNull())
+    {
+      return false;
+    }
+    double t[2], w[2];
+    for (int i = 0; i < 2; i++)
+    {
+      t[i] = aI.Point(i + 1).ParamOnFirst();
+      w[i] = aI.Point(i + 1).ParamOnSecond();
+      if (t[i] <= Udeb + aNear || t[i] >= Ufin - aNear)
+      {
+        return false;
+      }
+    }
+    const int k = t[0] < t[1] ? 0 : 1;
+    Ea          = E;
+    T1          = t[k];
+    W1          = w[k];
+    T2          = t[1 - k];
+    W2          = w[1 - k];
+  }
+  if (Ea.IsNull() || !(T2 - T1 > aNear))
+  {
+    return false;
+  }
+  // Between the crossings the cap lies outside Fv.
+  BRepClass_FaceClassifier aCl(Fv, Pc->Value(0.5 * (T1 + T2)), Tol2d);
+  if (aCl.State() != TopAbs_OUT || !EFMap.Contains(Ea))
+  {
+    return false;
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator It(EFMap(Ea)); It.More(); It.Next())
+  {
+    if (!It.Value().IsSame(Fv))
+    {
+      Fg = TopoDS::Face(It.Value());
+    }
+  }
+  return !Fg.IsNull() && ChFi3d::IsTangentFaces(Ea, Fv, Fg);
+}
+
+//=======================================================================
+// function : ChFi3d_CapWhollyAcrossTangentEdge
+// purpose  : Whether the cap of a blend's end on the face at the end Fv
+//            (its curve Pc on Fv from Udeb to Ufin) runs from one vertex
+//            of an edge Ea of Fv to its other (the cap's ends CP1 and
+//            CP2, at those vertices) outside Fv, the face beyond Ea (Fg)
+//            tangent to Fv along it: the blend as wide as Fv reaches from
+//            its edge at Ea's ends, taking Fv away, the cap on Fg alone
+//            (ChFi3d_CapLeavesAcrossTangentEdge's crossings at the cap's
+//            ends). Ea and Fg; false elsewhere.
+//=======================================================================
+
+static bool ChFi3d_CapWhollyAcrossTangentEdge(const ChFiDS_Map&                EFMap,
+                                              const TopoDS_Face&               Fv,
+                                              const occ::handle<Geom2d_Curve>& Pc,
+                                              const double                     Udeb,
+                                              const double                     Ufin,
+                                              const ChFiDS_CommonPoint&        CP1,
+                                              const ChFiDS_CommonPoint&        CP2,
+                                              const double                     Tol2d,
+                                              TopoDS_Edge&                     Ea,
+                                              TopoDS_Face&                     Fg)
+{
+  if (Pc.IsNull() || !(Ufin > Udeb) || !CP1.IsVertex() || !CP2.IsVertex() || CP1.Vertex().IsSame(CP2.Vertex()))
+  {
+    return false;
+  }
+  TopoDS_Face FvF = Fv;
+  FvF.Orientation(TopAbs_FORWARD);
+  for (TopExp_Explorer ex(FvF, TopAbs_EDGE); ex.More() && Ea.IsNull(); ex.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(E))
+    {
+      continue;
+    }
+    TopoDS_Vertex V1, V2;
+    TopExp::Vertices(E, V1, V2);
+    if ((V1.IsSame(CP1.Vertex()) && V2.IsSame(CP2.Vertex())) || (V1.IsSame(CP2.Vertex()) && V2.IsSame(CP1.Vertex())))
+    {
+      Ea = E;
+    }
+  }
+  if (Ea.IsNull() || !EFMap.Contains(Ea))
+  {
+    return false;
+  }
+  // The cap's inside lies outside Fv.
+  for (const double s : {0.25, 0.5, 0.75})
+  {
+    BRepClass_FaceClassifier aCl(Fv, Pc->Value(Udeb + s * (Ufin - Udeb)), Tol2d);
+    if (aCl.State() != TopAbs_OUT)
+    {
+      return false;
+    }
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator It(EFMap(Ea)); It.More(); It.Next())
+  {
+    if (!It.Value().IsSame(Fv))
+    {
+      Fg = TopoDS::Face(It.Value());
+    }
+  }
+  return !Fg.IsNull() && ChFi3d::IsTangentFaces(Ea, Fv, Fg);
+}
