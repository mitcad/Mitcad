+//=======================================================================
+// function : ChFi3d_IsKnifeEdge
+// purpose  : Whether the two faces of the edge meet tangentially all along
+//            it with opposite normals (mitcad#1988).
+//=======================================================================
+
+bool ChFi3d_IsKnifeEdge(const TopoDS_Edge& E, const ChFiDS_Map& EFMap)
+{
+  TopoDS_Face F1, F2;
+  ChFi3d_conexfaces(E, F1, F2, EFMap);
+  if (F1.IsNull() || F2.IsNull() || F1.IsSame(F2) || BRep_Tool::Degenerated(E))
+  {
+    return false;
+  }
+  double                    aFirst = 0., aLast = 0.;
+  occ::handle<Geom2d_Curve> aC1 = BRep_Tool::CurveOnSurface(E, F1, aFirst, aLast);
+  occ::handle<Geom2d_Curve> aC2 = BRep_Tool::CurveOnSurface(E, F2, aFirst, aLast);
+  if (aC1.IsNull() || aC2.IsNull())
+  {
+    return false;
+  }
+  BRepAdaptor_Surface aS1(F1, false), aS2(F2, false);
+  const int           aNb = 5;
+  for (int i = 0; i < aNb; ++i)
+  {
+    const double aT  = aFirst + (aLast - aFirst) * (i + 0.5) / aNb;
+    gp_Pnt2d     aP1 = aC1->Value(aT), aP2 = aC2->Value(aT);
+    gp_Pnt       aP;
+    gp_Vec       aDU, aDV;
+    aS1.D1(aP1.X(), aP1.Y(), aP, aDU, aDV);
+    gp_Vec aN1 = aDU.Crossed(aDV);
+    aS2.D1(aP2.X(), aP2.Y(), aP, aDU, aDV);
+    gp_Vec aN2 = aDU.Crossed(aDV);
+    if (aN1.SquareMagnitude() < 1.e-24 || aN2.SquareMagnitude() < 1.e-24)
+    {
+      return false;
+    }
+    if (F1.Orientation() == TopAbs_REVERSED)
+    {
+      aN1.Reverse();
+    }
+    if (F2.Orientation() == TopAbs_REVERSED)
+    {
+      aN2.Reverse();
+    }
+    if (aN1.Angle(aN2) <= M_PI - 1.e-3)
+    {
+      return false;
+    }
+  }
+  return true;
+}
