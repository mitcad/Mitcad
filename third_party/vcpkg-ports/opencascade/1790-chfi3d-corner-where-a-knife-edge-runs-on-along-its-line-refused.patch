+//=======================================================================
+// function : RefuseKnifeEndsOnLine
+// purpose  : See the header (mitcad#1988).
+//=======================================================================
+
+void ChFi3d_Builder::RefuseKnifeEndsOnLine(const int Index) const
+{
+  const NCollection_List<occ::handle<ChFiDS_Stripe>>& aStripes = myVDataMap(Index);
+  if (aStripes.Extent() != 2 || aStripes.First() == aStripes.Last())
+  {
+    return;
+  }
+  const TopoDS_Vertex&       aVtx = myVDataMap.FindKey(Index);
+  occ::handle<ChFiDS_Stripe> aStr[2] = {aStripes.First(), aStripes.Last()};
+  TopoDS_Edge                anEdge[2];
+  gp_Vec                     anAway[2];
+  for (int k = 0; k < 2; ++k)
+  {
+    const occ::handle<ChFiDS_Spine>& aSp = aStr[k]->Spine();
+    if (aSp.IsNull() || aSp->IsPeriodic() || aSp->FirstVertex().IsSame(aSp->LastVertex()))
+    {
+      return;
+    }
+    int aSens = 0;
+    ChFi3d_IndexOfSurfData(aVtx, aStr[k], aSens);
+    const bool aFirst = (aSens == 1);
+    if (!(aFirst ? aSp->FirstVertex() : aSp->LastVertex()).IsSame(aVtx))
+    {
+      return;
+    }
+    anEdge[k] = aFirst ? aSp->Edges(1) : aSp->Edges(aSp->NbEdges());
+    // The edge's tangent at the vertex, away from it.
+    BRepAdaptor_Curve aC(anEdge[k]);
+    const bool        anAtFirst = TopExp::FirstVertex(anEdge[k]).IsSame(aVtx);
+    if (!anAtFirst && !TopExp::LastVertex(anEdge[k]).IsSame(aVtx))
+    {
+      return;
+    }
+    gp_Pnt aP;
+    aC.D1(anAtFirst ? aC.FirstParameter() : aC.LastParameter(), aP, anAway[k]);
+    if (anAway[k].Magnitude() <= gp::Resolution())
+    {
+      return;
+    }
+    if (!anAtFirst)
+    {
+      anAway[k].Reverse();
+    }
+  }
+  // On one line: the one goes on where the other ends.
+  if (anAway[0].Angle(anAway[1].Reversed()) > angular)
+  {
+    return;
+  }
+  // One knife edge.
+  if (ChFi3d_IsKnifeEdge(anEdge[0], myEFMap) == ChFi3d_IsKnifeEdge(anEdge[1], myEFMap))
+  {
+    return;
+  }
+  // One face in common.
+  TopoDS_Face aF[2][2];
+  ChFi3d_conexfaces(anEdge[0], aF[0][0], aF[0][1], myEFMap);
+  ChFi3d_conexfaces(anEdge[1], aF[1][0], aF[1][1], myEFMap);
+  int aCommon = 0;
+  for (int a = 0; a < 2; ++a)
+  {
+    for (int b = 0; b < 2; ++b)
+    {
+      if (!aF[0][a].IsNull() && aF[0][a].IsSame(aF[1][b]))
+      {
+        ++aCommon;
+      }
+    }
+  }
+  if (aCommon != 1)
+  {
+    return;
+  }
+  throw Standard_Failure("a knife edge running on along its line into an edge whose faces meet at an "
+                         "angle: the ball jumps at the vertex between them");
+}
