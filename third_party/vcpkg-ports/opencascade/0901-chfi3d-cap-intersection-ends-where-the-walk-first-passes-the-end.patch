@@ -5854,6 +5854,88 @@ bool ChFi3d_ComputeCurves(const occ::handle<Adaptor3d_Surface>& S1,
         indd = nbp - indd + 1;
         indf = nbp - indf + 1;
       }
+      // Where an end is a point at which the surfaces touch (a blend
+      // tangent to the face at the end where its contact meets that face's
+      // tangent edge), the walk passes through it onto the intersection's
+      // other branch, wanders and may come back near it: the line ends where
+      // it first passes the end, not where it last comes back to it. The
+      // line passes the end at a point nearest to it within a step of the
+      // line, or inside a step where the end's foot on the step lies between
+      // its points, no further from it than the step is long: near such an
+      // end the walk may step back and forth across it, its first point past
+      // the end farther from it than one it steps back to.
+      {
+        const auto aDist = [&](const int k, const gp_Pnt& P) {
+          return L2S->Value(k).Value().Distance(P);
+        };
+        const auto aStep = [&](const int k) {
+          double s = 0.;
+          if (k > 1)
+          {
+            s = std::max(s, L2S->Value(k).Value().Distance(L2S->Value(k - 1).Value()));
+          }
+          if (k < nbp)
+          {
+            s = std::max(s, L2S->Value(k).Value().Distance(L2S->Value(k + 1).Value()));
+          }
+          return s;
+        };
+        // Where the line passes P inside its step from point a to point b,
+        // the nearer of the two points to P; 0 where it does not.
+        const auto aPassInside = [&](const int a, const int b, const gp_Pnt& P) {
+          const gp_XYZ A  = L2S->Value(a).Value().XYZ();
+          const gp_XYZ AB = L2S->Value(b).Value().XYZ() - A;
+          const double l2 = AB.SquareModulus();
+          if (l2 <= 0.)
+          {
+            return 0;
+          }
+          const double t = (P.XYZ() - A).Dot(AB) / l2;
+          if (t <= 0. || t >= 1. || (P.XYZ() - (A + t * AB)).SquareModulus() > l2)
+          {
+            return 0;
+          }
+          return aDist(a, P) <= aDist(b, P) ? a : b;
+        };
+        for (i = indd + 1; i < indf; i++)
+        {
+          int k = aPassInside(i - 1, i, pntf);
+          if (k == indd)
+          {
+            k = i;
+          }
+          const double d = aDist(i, pntf);
+          if (k == 0 && d <= aDist(i - 1, pntf) && d <= aDist(i + 1, pntf) && d <= aStep(i))
+          {
+            k = i;
+          }
+          if (k != 0)
+          {
+            dfin = aDist(k, pntf);
+            indf = k;
+            break;
+          }
+        }
+        for (i = indf - 1; i > indd; i--)
+        {
+          int k = aPassInside(i + 1, i, pntd);
+          if (k == indf)
+          {
+            k = i;
+          }
+          const double d = aDist(i, pntd);
+          if (k == 0 && d <= aDist(i - 1, pntd) && d <= aDist(i + 1, pntd) && d <= aStep(i))
+          {
+            k = i;
+          }
+          if (k != 0)
+          {
+            ddeb = aDist(k, pntd);
+            indd = k;
+            break;
+          }
+        }
+      }
       for (i = 1; i < indd; i++)
       {
         L2S->RemovePoint(1);
