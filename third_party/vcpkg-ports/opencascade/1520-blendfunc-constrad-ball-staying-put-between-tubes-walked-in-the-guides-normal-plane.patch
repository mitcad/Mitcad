+
+namespace
+{
+// A ball that stays put (mitcad#1412). Where both supports are tubes of the ball's radius whose
+// axes run through its centre, as two earlier roundings of that radius meeting in a mitre, the
+// centre seen from either contact does not depend on the contact's place round its tube's
+// section: the walk's conditions leave the section one freedom, and the solver's choice drifts
+// with its start, its contacts running out of their faces or standing still. Every section of
+// such a ball is an arc of its sphere; the walk takes the one whose contacts both lie in the
+// guide's normal plane (BlendFunc_ConstRad::StillSection), which keeps the mid-point's
+// condition, is the rounding's own section where it arrives at the ball, and vanishes where the
+// mitre ends.
+
+//! Where the ball of Func at the section From, at the guide's parameter W, stays put: in Sol
+//! its section at the guide's parameter Param in the guide's normal plane. False elsewhere.
+bool stillSection(Blend_Function&    Func,
+                  const double       W,
+                  const math_Vector& From,
+                  const double       Param,
+                  math_Vector&       Sol)
+{
+  BlendFunc_ConstRad* aFunc = dynamic_cast<BlendFunc_ConstRad*>(&Func);
+  return aFunc != nullptr && aFunc->StillSection(W, From, Param, Sol);
+}
+
+//! The parameter of the arc A nearest to P, from t.
+double arcParameter(const occ::handle<Adaptor2d_Curve2d>& A, const gp_Pnt2d& P, double t)
+{
+  const double aFirst = A->FirstParameter();
+  const double aLast  = A->LastParameter();
+  for (int i = 0; i < 30; ++i)
+  {
+    gp_Pnt2d Q;
+    gp_Vec2d D1, D2;
+    A->D2(t, Q, D1, D2);
+    const gp_Vec2d d(P, Q);
+    const double   f  = d.Dot(D1);
+    const double   df = D1.Dot(D1) + d.Dot(D2);
+    if (std::abs(df) < 1.e-14)
+    {
+      break;
+    }
+    const double dt = f / df;
+    t               = std::min(std::max(t - dt, aFirst), aLast);
+    if (std::abs(dt) < 1.e-12)
+    {
+      break;
+    }
+  }
+  return t;
+}
