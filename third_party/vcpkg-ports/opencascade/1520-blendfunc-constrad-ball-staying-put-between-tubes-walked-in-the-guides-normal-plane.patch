index 351eb1cd..0aa48c2f 100644
--- a/src/ModelingAlgorithms/TKFillet/BlendFunc/BlendFunc_ConstRad.cxx
+++ b/src/ModelingAlgorithms/TKFillet/BlendFunc/BlendFunc_ConstRad.cxx
@@ -150,6 +150,169 @@ gp_Vec CentreDirection(const gp_Vec& nsurf)
   const double norm = nsurf.Magnitude();
   return norm > Eps ? -nsurf / norm : -nsurf;
 }
+
+// A ball that stays put (mitcad#1412): where both surfaces are tubes of the ball's radius about
+// curves through its centre (two earlier roundings of that radius meeting in a mitre), the
+// centre seen from either contact does not depend on the contact's place round its tube's
+// section, and the conditions leave the section one freedom (their Jacobian is singular). The
+// walk then takes the section whose contacts both lie in the guide's normal plane (which keeps
+// the mid-point's condition); its derivatives by the guide's parameter are those of that
+// section, each contact running round its tube's section.
+
+//! The parameter of S (1: U, 2: V) along which the centre of the ball of radius R touching S at
+//! (U, V) on the side of C does not move (S is there a tube of the ball's radius); 0 if none.
+int StillDirection(const occ::handle<Adaptor3d_Surface>& S,
+                   const double                          U,
+                   const double                          V,
+                   const gp_Pnt&                         C,
+                   const double                          R)
+{
+  gp_Pnt P;
+  gp_Vec Su, Sv, Suu, Svv, Suv;
+  S->D2(U, V, P, Su, Sv, Suu, Svv, Suv);
+  const gp_Vec N     = Su.Crossed(Sv);
+  const double aNorm = N.Magnitude();
+  if (aNorm < gp::Resolution() || Su.Magnitude() < gp::Resolution()
+      || Sv.Magnitude() < gp::Resolution())
+  {
+    return 0;
+  }
+  const gp_Vec n   = N / aNorm;
+  const double sgn = n.Dot(gp_Vec(P, C)) < 0. ? -R : R;
+  const gp_Vec Nu  = Suu.Crossed(Sv) + Su.Crossed(Suv);
+  const gp_Vec Nv  = Suv.Crossed(Sv) + Su.Crossed(Svv);
+  const gp_Vec cu  = Su + (Nu - n * n.Dot(Nu)) * (sgn / aNorm);
+  const gp_Vec cv  = Sv + (Nv - n * n.Dot(Nv)) * (sgn / aNorm);
+  // The centre's speed along each parameter against the contact's.
+  const double     ru     = cu.Magnitude() / Su.Magnitude();
+  const double     rv     = cv.Magnitude() / Sv.Magnitude();
+  constexpr double aStill = 1.e-3;
+  if (ru < aStill && rv > 10. * aStill)
+  {
+    return 1;
+  }
+  if (rv < aStill && ru > 10. * aStill)
+  {
+    return 2;
+  }
+  return 0;
+}
+
+//! The first and second derivatives by the guide's parameter W of the parameter Dir of S at the
+//! contact X (U, V), held in the guide's normal plane while it runs round its tube's section.
+bool StillContactDerivatives(const occ::handle<Adaptor3d_Surface>& S,
+                             const int                             Dir,
+                             const double                          U,
+                             const double                          V,
+                             const gp_Pnt&                         G,
+                             const gp_Vec&                         G1,
+                             const gp_Vec&                         G2,
+                             const gp_Vec&                         T,
+                             const gp_Vec&                         dT,
+                             const gp_Vec&                         d2T,
+                             double&                               D1,
+                             double&                               D2)
+{
+  gp_Pnt P;
+  gp_Vec Su, Sv, Suu, Svv, Suv;
+  S->D2(U, V, P, Su, Sv, Suu, Svv, Suv);
+  const gp_Vec& St  = Dir == 1 ? Su : Sv;
+  const gp_Vec& Stt = Dir == 1 ? Suu : Svv;
+  const double  ft  = St.Dot(T);
+  if (std::abs(ft) < 1.e-9 * St.Magnitude())
+  {
+    return false;
+  }
+  const gp_Vec GP(G, P);
+  const double fw  = -G1.Dot(T) + GP.Dot(dT);
+  const double ftt = Stt.Dot(T);
+  const double fwt = St.Dot(dT);
+  const double fww = -G2.Dot(T) - 2. * G1.Dot(dT) + GP.Dot(d2T);
+  D1               = -fw / ft;
+  D2               = -(fww + 2. * fwt * D1 + ftt * D1 * D1) / ft;
+  return true;
+}
+
+//! Moves the contact (U, V) on S along its parameter Dir (1: U, 2: V), round its tube's section,
+//! into the plane through G square to the unit vector T. False where it does not get there.
+bool StillContact(const occ::handle<Adaptor3d_Surface>& S,
+                  const int                             Dir,
+                  double&                               U,
+                  double&                               V,
+                  const gp_Pnt&                         G,
+                  const gp_Vec&                         T)
+{
+  double& t = Dir == 1 ? U : V;
+  for (int i = 0; i < 30; ++i)
+  {
+    gp_Pnt P;
+    gp_Vec Su, Sv;
+    S->D1(U, V, P, Su, Sv);
+    const double f = gp_Vec(G, P).Dot(T);
+    if (std::abs(f) < 1.e-12)
+    {
+      return true;
+    }
+    const double df = (Dir == 1 ? Su : Sv).Dot(T);
+    if (std::abs(df) < 1.e-12)
+    {
+      return std::abs(f) < 1.e-9;
+    }
+    t -= f / df;
+  }
+  gp_Pnt P = S->Value(U, V);
+  return std::abs(gp_Vec(G, P).Dot(T)) < 1.e-9;
+}
+
+//! Where the ball of radius R centred at C, touching S1 and S2 at X for the parameter W of the
+//! guide Guide, stays put: the first and second derivatives of X by W of the section whose
+//! contacts lie in the guide's normal plane. False elsewhere.
+bool StillBall(const occ::handle<Adaptor3d_Surface>& S1,
+               const occ::handle<Adaptor3d_Surface>& S2,
+               const occ::handle<Adaptor3d_Curve>&   Guide,
+               const math_Vector&                    X,
+               const double                          W,
+               const gp_Pnt&                         C,
+               const double                          R,
+               math_Vector&                          D1,
+               math_Vector&                          D2)
+{
+  const int aDir1 = StillDirection(S1, X(1), X(2), C, R);
+  const int aDir2 = aDir1 == 0 ? 0 : StillDirection(S2, X(3), X(4), C, R);
+  if (aDir1 == 0 || aDir2 == 0)
+  {
+    return false;
+  }
+  gp_Pnt G;
+  gp_Vec G1, G2, G3;
+  Guide->D3(W, G, G1, G2, G3);
+  const double aSpeed = G1.Magnitude();
+  if (aSpeed < gp::Resolution())
+  {
+    return false;
+  }
+  // The unit tangent and its derivatives, as ComputeValues takes them for the normal plane.
+  const double invn  = 1. / aSpeed;
+  const gp_Vec T     = G1 * invn;
+  gp_Vec       dT    = (G2 - T * T.Dot(G2)) * invn;
+  const double dinvn = -T.Dot(G2) * invn * invn;
+  gp_Vec       d2T   = G3 * invn + G2 * dinvn;
+  const double aux   = dinvn * T.Dot(G2) + invn * (dT.Dot(G2) + T.Dot(G3));
+  d2T                = d2T - dT * (invn * T.Dot(G2)) - T * aux;
+  double a1, a2, b1, b2;
+  if (!StillContactDerivatives(S1, aDir1, X(1), X(2), G, G1, G2, T, dT, d2T, a1, a2)
+      || !StillContactDerivatives(S2, aDir2, X(3), X(4), G, G1, G2, T, dT, d2T, b1, b2))
+  {
+    return false;
+  }
+  D1.Init(0.);
+  D2.Init(0.);
+  D1(aDir1)     = a1;
+  D2(aDir1)     = a2;
+  D1(2 + aDir2) = b1;
+  D2(2 + aDir2) = b2;
+  return true;
+}
 } // namespace
 
