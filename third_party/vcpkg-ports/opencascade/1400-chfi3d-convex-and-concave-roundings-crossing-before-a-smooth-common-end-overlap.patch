+// Whether open stripes A and B, one rounding a convex edge and the other a
+// concave one, end at a common vertex where every other edge is smooth, and
+// have contacts on a face of both their edges that cross each other there
+// (as contactsCross finds them): the concave rounding's ball, rolling on
+// that face, reaches the convex rounding's blend before the vertex, and no
+// sharp edge at the vertex bounds a corner between the two, so that the
+// corners there cannot join the two blends (one takes material away below
+// the face, the other adds it above). They are to be built one after the
+// other, the concave one on the convex one's result.
+static bool convexConcaveCrossBeforeEnd(const occ::handle<ChFiDS_Stripe>& A,
+                                        const occ::handle<ChFiDS_Stripe>& B,
+                                        const ChFiDS_Map&                 EFMap,
+                                        const ChFiDS_Map&                 VEMap,
+                                        const TopOpeBRepDS_DataStructure& DStr,
+                                        const double                      tol2d)
+{
+  const occ::handle<ChFiDS_Spine>& SA = A->Spine();
+  const occ::handle<ChFiDS_Spine>& SB = B->Spine();
+  if (SA.IsNull() || SB.IsNull() || SA->IsClosed() || SB->IsClosed() || A->SetOfSurfData().IsNull()
+      || B->SetOfSurfData().IsNull())
+  {
+    return false;
+  }
+  // A common end vertex where every other edge is smooth (its faces
+  // tangent, or one face across its seam): the faces the two blends end on
+  // go on into each other tangentially there. (Where a sharp edge goes on
+  // from the vertex, the corner there joins the two blends, bounded on it.)
+  const auto smoothElsewhere = [&](const TopoDS_Vertex& V) {
+    if (!VEMap.Contains(V))
+    {
+      return false;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator itE(VEMap(V)); itE.More(); itE.Next())
+    {
+      const TopoDS_Edge& E = TopoDS::Edge(itE.Value());
+      if (SA->Index(E) != 0 || SB->Index(E) != 0 || BRep_Tool::Degenerated(E))
+      {
+        continue;
+      }
+      if (!EFMap.Contains(E) || EFMap(E).Extent() > 2 || EFMap(E).IsEmpty())
+      {
+        return false;
+      }
+      if (EFMap(E).Extent() == 1)
+      {
+        if (!BRep_Tool::IsClosed(E, TopoDS::Face(EFMap(E).First())))
+        {
+          return false;
+        }
+        continue;
+      }
+      const TopoDS_Face F1 = TopoDS::Face(EFMap(E).First());
+      const TopoDS_Face F2 = TopoDS::Face(EFMap(E).Last());
+      if (!F1.IsSame(F2) && ChFi3d::DefineConnectType(E, F1, F2, 1.e-6, false) != ChFiDS_Tangential)
+      {
+        return false;
+      }
+    }
+    return true;
+  };
+  bool aCommon = false;
+  for (const TopoDS_Vertex& VA : {SA->FirstVertex(), SA->LastVertex()})
+  {
+    aCommon = aCommon
+              || ((VA.IsSame(SB->FirstVertex()) || VA.IsSame(SB->LastVertex())) && smoothElsewhere(VA));
+  }
+  if (!aCommon)
+  {
+    return false;
+  }
+  // The type of the edge of a spine on face F.
+  const auto typeOn = [&EFMap](const occ::handle<ChFiDS_Spine>& Sp, const TopoDS_Face& F) {
+    const TopoDS_Edge E = spineEdgeOf(Sp, F);
+    if (E.IsNull() || !EFMap.Contains(E) || EFMap(E).Extent() != 2)
+    {
+      return ChFiDS_Other;
+    }
+    return ChFi3d::DefineConnectType(E,
+                                     TopoDS::Face(EFMap(E).First()),
+                                     TopoDS::Face(EFMap(E).Last()),
+                                     1.e-6,
+                                     false);
+  };
+  for (int ia = 1; ia <= A->SetOfSurfData()->Length(); ia++)
+  {
+    const occ::handle<ChFiDS_SurfData>& a = A->SetOfSurfData()->Value(ia);
+    for (int ib = 1; ib <= B->SetOfSurfData()->Length(); ib++)
+    {
+      const occ::handle<ChFiDS_SurfData>& b = B->SetOfSurfData()->Value(ib);
+      for (int ka = 1; ka <= 2; ka++)
+      {
+        for (int kb = 1; kb <= 2; kb++)
+        {
+          if (a->Index(ka) <= 0 || a->Index(ka) != b->Index(kb) || a->IsOnCurve(ka)
+              || b->IsOnCurve(kb))
+          {
+            continue;
+          }
+          const TopoDS_Face            F     = TopoDS::Face(DStr.Shape(a->Index(ka)));
+          const ChFiDS_TypeOfConcavity aTypeA = typeOn(SA, F);
+          const ChFiDS_TypeOfConcavity aTypeB = typeOn(SB, F);
+          if (!((aTypeA == ChFiDS_Convex && aTypeB == ChFiDS_Concave)
+                || (aTypeA == ChFiDS_Concave && aTypeB == ChFiDS_Convex)))
+          {
+            continue;
+          }
+          const ChFiDS_FaceInterference& FA = a->Interference(ka);
+          const ChFiDS_FaceInterference& FB = b->Interference(kb);
+          if (IsEqual(FA.FirstParameter(), FA.LastParameter())
+              || IsEqual(FB.FirstParameter(), FB.LastParameter()) || FA.PCurveOnFace().IsNull()
+              || FB.PCurveOnFace().IsNull())
+          {
+            continue;
+          }
+          Geom2dAdaptor_Curve aCA(FA.PCurveOnFace(),
+                                  std::min(FA.FirstParameter(), FA.LastParameter()),
+                                  std::max(FA.FirstParameter(), FA.LastParameter()));
+          Geom2dAdaptor_Curve aCB(FB.PCurveOnFace(),
+                                  std::min(FB.FirstParameter(), FB.LastParameter()),
+                                  std::max(FB.FirstParameter(), FB.LastParameter()));
+          Geom2dInt_GInter    anInter(aCA, aCB, tol2d, Precision::PConfusion());
+          if (!anInter.IsDone())
+          {
+            continue;
+          }
+          // (A crossing inside both contacts, not where one ends.)
+          const double aTolA = 1.e-6 * (aCA.LastParameter() - aCA.FirstParameter());
+          const double aTolB = 1.e-6 * (aCB.LastParameter() - aCB.FirstParameter());
+          for (int ip = 1; ip <= anInter.NbPoints(); ip++)
+          {
+            const IntRes2d_IntersectionPoint& aP    = anInter.Point(ip);
+            const IntRes2d_TypeTrans          aType = aP.TransitionOfFirst().TransitionType();
+            if ((aType == IntRes2d_In || aType == IntRes2d_Out)
+                && aP.ParamOnFirst() > aCA.FirstParameter() + aTolA
+                && aP.ParamOnFirst() < aCA.LastParameter() - aTolA
+                && aP.ParamOnSecond() > aCB.FirstParameter() + aTolB
+                && aP.ParamOnSecond() < aCB.LastParameter() - aTolB)
+            {
+              return true;
+            }
+          }
+        }
+      }
+    }
+  }
+  return false;
+}
