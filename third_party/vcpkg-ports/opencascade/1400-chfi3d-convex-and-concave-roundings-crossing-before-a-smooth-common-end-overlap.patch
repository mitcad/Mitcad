+        {
+          if (!badstripes.Contains(S))
+          {
+            badstripes.Append(S);
+            S->Spine()->SetErrorStatus(ChFiDS_Error);
+            noteFailure(S, Failure_Overlap);
+          }
+        }
+      }
+    }
+    done = badstripes.IsEmpty();
+  }
   if (!done && !badstripes.IsEmpty())
   {
     myFailedStripe = badstripes.First();
