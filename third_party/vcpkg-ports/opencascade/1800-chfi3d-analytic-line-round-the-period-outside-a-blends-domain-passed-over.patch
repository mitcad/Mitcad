+//=======================================================================
+// function : ChFi3d_LeavesPeriodicDomain
+// purpose  : Whether the pcurve Pc of a line of the intersection, between
+//            Uf and Ul, leaves the domain of S in a periodic direction of
+//            S (a line that goes round the period the other way, outside
+//            the domain, between two ends on its boundary): a point inside
+//            the line, brought into the period that starts at the domain's
+//            start, lies past the domain's end by more than a hundredth of
+//            the period.
+//=======================================================================
+
+static bool ChFi3d_LeavesPeriodicDomain(const occ::handle<Adaptor3d_Surface>& S,
+                                        const occ::handle<Geom2d_Curve>&      Pc,
+                                        const double                          Uf,
+                                        const double                          Ul)
+{
+  const bool isUPer = S->IsUPeriodic(), isVPer = S->IsVPeriodic();
+  if ((!isUPer && !isVPer) || Pc.IsNull())
+  {
+    return false;
+  }
+  const auto isOutside = [](const double theX, const double theA, const double theB, const double theT) {
+    if (theB - theA >= theT * (1. - 1.e-2))
+    {
+      return false;
+    }
+    const double aTol = 1.e-2 * theT;
+    double       aX   = std::fmod(theX - theA, theT);
+    if (aX < 0.)
+    {
+      aX += theT;
+    }
+    return aX > theB - theA + aTol && aX < theT - aTol;
+  };
+  const int aNb = 10;
+  for (int i = 1; i < aNb; i++)
+  {
+    const gp_Pnt2d aP = Pc->Value(Uf + (Ul - Uf) * i / aNb);
+    if (isUPer && isOutside(aP.X(), S->FirstUParameter(), S->LastUParameter(), S->UPeriod()))
+    {
+      return true;
+    }
+    if (isVPer && isOutside(aP.Y(), S->FirstVParameter(), S->LastVParameter(), S->VPeriod()))
+    {
+      return true;
+    }
+  }
+  return false;
+}
