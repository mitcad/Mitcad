@@ -15063,6 +15063,43 @@ bool ChFi3d_Builder::ChamferCutByFacesBeyond(const occ::handle<ChFiDS_Stripe>& S
     occ::handle<ChFiDS_Stripe> aSt = Stripe;
     ChFi3d_SingularExtremity(aSt, DStr, TopoDS_Vertex(), tolapp3d, tol2d, 2);
   }
+  // The parts' pieces as faces generated by the spine's edges they run
+  // along (myEVIMap, which PerformSetOfSurf fills for the pieces it
+  // walks): the pieces cut here, and in the parts after the first those of
+  // a surface of their own, are not in it, and Generated() would leave
+  // their faces out.
+  for (int p = 1; p <= nParts; p++)
+  {
+    for (int k = 1; k <= aParts.Value(p).Length(); k++)
+    {
+      const occ::handle<ChFiDS_SurfData>& SD = aParts.Value(p).Value(k);
+      const double                        fp = SD->FirstSpineParam(), lp = SD->LastSpineParam();
+      for (int ie = 1; ie <= Spine->NbEdges(); ie++)
+      {
+        if (lp < Spine->FirstParameter(ie) - tolesp || fp > Spine->LastParameter(ie) + tolesp
+            || (lp - fp > tolesp
+                && (lp < Spine->FirstParameter(ie) + tolesp || fp > Spine->LastParameter(ie) - tolesp)))
+        {
+          continue;
+        }
+        const TopoDS_Edge& Ej = Spine->Edges(ie);
+        if (!myEVIMap.IsBound(Ej))
+        {
+          myEVIMap.Bind(Ej, NCollection_List<int>());
+        }
+        NCollection_List<int>& aList = myEVIMap.ChangeFind(Ej);
+        bool                    seen  = false;
+        for (NCollection_List<int>::Iterator it(aList); it.More() && !seen; it.Next())
+        {
+          seen = it.Value() == SD->Surf();
+        }
+        if (!seen)
+        {
+          aList.Append(SD->Surf());
+        }
+      }
+    }
+  }
