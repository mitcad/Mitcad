+//=======================================================================
+// function : RunsToOneStop
+// purpose  : A kept face across faces whose offset vanishes beside a
+//           removed face (mitcad#2535): where its edges to them are a
+//           chain (a rounding whose side other faces cut into many edges),
+//           the face extended to the removed face meets it in one section,
+//           which each of those edges cannot be bounded on alone (their
+//           sections are the same curve, so their common vertices have no
+//           image on it). Each run of two or more consecutive edges of the
+//           wire theW of theF that are in theRunEdges and are to be
+//           extended to the same face (theToBuild) is replaced in theNewW
+//           by one edge from the run's first vertex to its last, a straight
+//           segment in 3D and in theF's parameters (only its ends are
+//           used). theRuns: that edge -> the run's edges as oriented in the
+//           wire, in their order; theRefs: that edge -> the run's middle
+//           edge (the reference of the intersection). False where there is
+//           no such run; the wire is then unchanged.
+//=======================================================================
+static bool RunsToOneStop(
+  const TopoDS_Wire&                                                         theW,
+  const TopoDS_Face&                                                         theF,
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher>&  theToBuild,
+  const NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher>& theConst,
+  const NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>&             theRunEdges,
+  TopoDS_Wire&                                                               theNewW,
+  NCollection_DataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher>& theRuns,
+  NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher>& theRefs)
+{
+  // the edges in their order along the wire, as oriented in it
+  NCollection_Sequence<TopoDS_Edge> aEdges;
+  const TopoDS_Wire                 aWF = TopoDS::Wire(theW.Oriented(TopAbs_FORWARD));
+  BRepTools_WireExplorer aWExp(aWF, TopoDS::Face(theF.Oriented(TopAbs_FORWARD)));
+  for (; aWExp.More(); aWExp.Next())
+  {
+    aEdges.Append(aWExp.Current());
+  }
+  int aNbInWire = 0;
+  for (TopoDS_Iterator aIt(aWF); aIt.More(); aIt.Next())
+  {
+    ++aNbInWire;
+  }
+  const int aNb = aEdges.Length();
+  if (aNb < 3 || aNb != aNbInWire)
+  {
+    return false;
+  }
+  // the face each edge is to be extended to, where it may join a run
+  NCollection_Array1<TopoDS_Shape> aStop(1, aNb);
+  for (int i = 1; i <= aNb; ++i)
+  {
+    const TopoDS_Edge& aE = aEdges(i);
+    if (theRunEdges.Contains(aE) && theToBuild.IsBound(aE) && !theConst.IsBound(aE)
+        && !BRep_Tool::Degenerated(aE))
+    {
+      aStop(i) = theToBuild(aE);
+    }
+  }
+  auto inSameRun = [&](const int i, const int j) {
+    return !aStop(i).IsNull() && !aStop(j).IsNull() && aStop(i).IsSame(aStop(j));
+  };
+  // a start outside any run (none where the whole wire is one run)
+  int aStart = 0;
+  for (int i = 1; i <= aNb && aStart == 0; ++i)
+  {
+    if (!inSameRun(i, i == 1 ? aNb : i - 1))
+    {
+      aStart = i;
+    }
+  }
+  if (aStart == 0)
+  {
+    return false;
+  }
+  BRep_Builder                    aB;
+  NCollection_Sequence<TopoDS_Shape> aNewEdges;
+  for (int k = 0; k < aNb;)
+  {
+    const int                         i0 = (aStart - 1 + k) % aNb + 1;
+    NCollection_Sequence<TopoDS_Edge> aRun;
+    aRun.Append(aEdges(i0));
+    ++k;
+    while (k < aNb)
+    {
+      const int i = (aStart - 1 + k) % aNb + 1;
+      if (!inSameRun(i, i == 1 ? aNb : i - 1))
+      {
+        break;
+      }
+      aRun.Append(aEdges(i));
+      ++k;
+    }
+    TopoDS_Edge aRunEdge;
+    if (aRun.Length() >= 2 && !aStop(i0).IsNull())
+    {
+      const TopoDS_Edge&  aFirst = aRun.First();
+      const TopoDS_Edge&  aLast  = aRun.Last();
+      const TopoDS_Vertex aVS    = TopExp::FirstVertex(aFirst, true);
+      const TopoDS_Vertex aVE    = TopExp::LastVertex(aLast, true);
+      double              aF1, aL1, aF2, aL2;
+      const occ::handle<Geom2d_Curve> aC1 = BRep_Tool::CurveOnSurface(aFirst, theF, aF1, aL1);
+      const occ::handle<Geom2d_Curve> aC2 = BRep_Tool::CurveOnSurface(aLast, theF, aF2, aL2);
+      if (!aVS.IsNull() && !aVE.IsNull() && !aVS.IsSame(aVE) && !aC1.IsNull() && !aC2.IsNull())
+      {
+        const gp_Pnt   aPS = BRep_Tool::Pnt(aVS);
+        const gp_Pnt   aPE = BRep_Tool::Pnt(aVE);
+        const gp_Pnt2d aUVS =
+          aC1->Value(aFirst.Orientation() == TopAbs_REVERSED ? aL1 : aF1);
+        const gp_Pnt2d aUVE = aC2->Value(aLast.Orientation() == TopAbs_REVERSED ? aF2 : aL2);
+        if (aPS.Distance(aPE) > Precision::Confusion()
+            && aUVS.Distance(aUVE) > Precision::PConfusion())
+        {
+          NCollection_Array1<double> aKnots(1, 2);
+          NCollection_Array1<int>    aMults(1, 2);
+          aKnots(1) = 0.;
+          aKnots(2) = 1.;
+          aMults(1) = 2;
+          aMults(2) = 2;
+          NCollection_Array1<gp_Pnt> aPoles(1, 2);
+          aPoles(1) = aPS;
+          aPoles(2) = aPE;
+          NCollection_Array1<gp_Pnt2d> aPoles2d(1, 2);
+          aPoles2d(1)        = aUVS;
+          aPoles2d(2)        = aUVE;
+          const double aTol = std::max(BRep_Tool::Tolerance(aFirst), BRep_Tool::Tolerance(aLast));
+          aB.MakeEdge(aRunEdge, new Geom_BSplineCurve(aPoles, aKnots, aMults, 1), aTol);
+          aB.UpdateEdge(aRunEdge, new Geom2d_BSplineCurve(aPoles2d, aKnots, aMults, 1), theF, aTol);
+          aB.Add(aRunEdge, aVS.Oriented(TopAbs_FORWARD));
+          aB.Add(aRunEdge, aVE.Oriented(TopAbs_REVERSED));
+          aB.Range(aRunEdge, 0., 1.);
+          NCollection_List<TopoDS_Shape> aL;
+          for (int j = 1; j <= aRun.Length(); ++j)
+          {
+            aL.Append(aRun(j));
+          }
+          theRuns.Bind(aRunEdge, aL);
+          theRefs.Bind(aRunEdge, aRun((aRun.Length() + 1) / 2));
+          theToBuild.Bind(aRunEdge, aStop(i0));
+          aNewEdges.Append(aRunEdge.Oriented(TopAbs_FORWARD));
+        }
+      }
+    }
+    if (aRunEdge.IsNull())
+    {
+      for (int j = 1; j <= aRun.Length(); ++j)
+      {
+        aNewEdges.Append(aRun(j));
+      }
+    }
+  }
+  if (theRuns.IsEmpty())
+  {
+    return false;
+  }
+  aB.MakeWire(theNewW);
+  for (int j = 1; j <= aNewEdges.Length(); ++j)
+  {
+    aB.Add(theNewW, aNewEdges(j));
+  }
+  theNewW.Closed(theW.Closed());
+  theNewW.Orientation(theW.Orientation());
+  return true;
+}
+
