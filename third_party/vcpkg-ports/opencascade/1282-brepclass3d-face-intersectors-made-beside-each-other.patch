 // function : FindAPointInTheFace
@@ -917,12 +920,30 @@ void BRepClass3d_SolidExplorer::InitShape(const TopoDS_Shape& S)
 
   myReject = true; //-- case of infinite solid (without any face)
 
-  TopExp_Explorer Expl;
+  // The faces' intersectors are made beside each other and bound in the
+  // faces' order, as they were made one by one: each samples its face's
+  // surface, which took most of the loading of a solid of thousands of
+  // faces (mitcad#1279).
+  NCollection_DynamicArray<TopoDS_Face> aFaces;
+  TopExp_Explorer                       Expl;
   for (Expl.Init(S, TopAbs_FACE); Expl.More(); Expl.Next())
   {
-    const TopoDS_Face Face = TopoDS::Face(Expl.Current());
-    void* ptr = (void*)(new IntCurvesFace_Intersector(Face, Precision::Confusion(), true, false));
-    myMapOfInter.Bind(Face, ptr);
+    aFaces.Append(TopoDS::Face(Expl.Current()));
+  }
+  const int                                       aNbFaces = aFaces.Length();
+  NCollection_Array1<IntCurvesFace_Intersector*> anIntersectors(0, aNbFaces - 1);
+  anIntersectors.Init(nullptr);
+  OSD_Parallel::For(
+    0,
+    aNbFaces,
+    [&](const int theIndex) {
+      anIntersectors(theIndex) =
+        new IntCurvesFace_Intersector(aFaces.Value(theIndex), Precision::Confusion(), true, false);
+    },
+    aNbFaces < 64);
+  for (int i = 0; i < aNbFaces; ++i)
+  {
+    myMapOfInter.Bind(aFaces.Value(i), (void*)anIntersectors(i));
     myReject = false; //-- at least one face in the solid
   }
 
