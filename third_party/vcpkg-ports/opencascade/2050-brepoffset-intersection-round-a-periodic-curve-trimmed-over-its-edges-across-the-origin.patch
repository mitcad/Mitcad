+//=======================================================================
+// function : SeamRunsOnFromTangentEdge
+// purpose  : Whether, of theE1 and theE2 (consecutive edges of theF at
+//            theV, neither with an image of its own), one is a seam of theF
+//            and the other an edge where theF meets a face tangentially,
+//            the seam running on from it, and another edge of theF at theV
+//            has an image (mitcad#2050: a cylinder continuing a plate's
+//            rounded corner, its seam starting where the cylinder meets the
+//            plate's side; the offset of the concave edge round its foot
+//            has an image). The offsets of the two lie on one line, and
+//            their common vertex (the offset of theV) is not where they
+//            meet in the offset: that is where the image of the other edge
+//            crosses that line, which the walks round the faces find.
+//=======================================================================
+static bool SeamRunsOnFromTangentEdge(
+  const TopoDS_Face&                                                              theF,
+  const TopoDS_Edge&                                                              theE1,
+  const TopoDS_Edge&                                                              theE2,
+  const TopoDS_Vertex&                                                            theV,
+  const BRepOffset_Analyse&                                                       theAnalyse,
+  const NCollection_DataMap<TopoDS_Shape, TopoDS_Shape, TopTools_ShapeMapHasher>& theBuild,
+  const NCollection_DataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher>&
+    theMVE)
+{
+  if (theV.IsNull() || theE1.IsSame(theE2))
+  {
+    return false;
+  }
+  const bool bSeam1 = BRep_Tool::IsClosed(theE1, theF);
+  const bool bSeam2 = BRep_Tool::IsClosed(theE2, theF);
+  if (bSeam1 == bSeam2)
+  {
+    return false;
+  }
+  const TopoDS_Edge& aE = bSeam1 ? theE2 : theE1;
+  if (!theAnalyse.HasAncestor(aE))
+  {
+    return false;
+  }
+  const NCollection_List<BRepOffset_Interval>& aLI = theAnalyse.Type(aE);
+  if (aLI.Extent() != 1 || aLI.First().Type() != ChFiDS_Tangential)
+  {
+    return false;
+  }
+  const NCollection_List<TopoDS_Shape>* pLE = theMVE.Seek(theV);
+  if (pLE == nullptr)
+  {
+    return false;
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(*pLE); it.More(); it.Next())
+  {
+    if (!it.Value().IsSame(theE1) && !it.Value().IsSame(theE2) && theBuild.IsBound(it.Value()))
+    {
+      return true;
+    }
+  }
+  return false;
+}
