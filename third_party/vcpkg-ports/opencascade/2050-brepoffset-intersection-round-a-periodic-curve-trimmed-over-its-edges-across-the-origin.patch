+//=======================================================================
+// function : IsOverOrigins
+// purpose  : Whether the point projects onto the curve of one of the
+//            edges theOrigins inside that edge's range (mitcad#2050).
+//=======================================================================
+static bool IsOverOrigins(const gp_Pnt& thePnt, const NCollection_List<TopoDS_Shape>& theOrigins)
+{
+  for (NCollection_List<TopoDS_Shape>::Iterator it(theOrigins); it.More(); it.Next())
+  {
+    const TopoDS_Edge& aE = TopoDS::Edge(it.Value());
+    if (BRep_Tool::Degenerated(aE))
+    {
+      continue;
+    }
+    double                        aF = 0., aL = 0.;
+    const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(aE, aF, aL);
+    if (aC.IsNull() || aL - aF < Precision::PConfusion())
+    {
+      continue;
+    }
+    GeomAPI_ProjectPointOnCurve aProj(thePnt, aC);
+    if (aProj.NbPoints() == 0)
+    {
+      continue;
+    }
+    double aU = aProj.LowerDistanceParameter();
+    if (aC->IsPeriodic())
+    {
+      aU = ElCLib::InPeriod(aU, aF, aF + aC->Period());
+    }
+    const double aMargin = 1.e-6 * (aL - aF);
+    if (aU > aF + aMargin && aU < aL - aMargin)
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+//=======================================================================
+// function : TrimOverOrigins
+// purpose  : For an edge running all round a periodic curve (the
+//            intersection of two offsets cut along a whole circle, as a
+//            plane cuts a cylinder), the range between its vertices
+//            (theParams, any order) that lies over the edges it is the
+//            image of: the vertices split the curve into arcs, and those
+//            whose middles project inside the range of one of those edges
+//            are kept, where they make one run round the curve and not all
+//            of it. That run may cross the curve's origin, which the range
+//            from the smallest to the largest parameter cannot: an arc of
+//            three quarters of a circle round a cylinder's foot came out as
+//            the quarter left over (mitcad#2050). Where the run crosses the
+//            origin, theV0 is the vertex there (null where there is none).
+//            False where the arcs kept are not one such run.
+//=======================================================================
+static bool TrimOverOrigins(const TopoDS_Edge&                                theNE,
+                            const NCollection_List<TopoDS_Shape>&             theOrigins,
+                            std::vector<std::pair<double, TopoDS_Vertex>>&    theParams,
+                            double&                                           theUMin,
+                            double&                                           theUMax,
+                            TopoDS_Vertex&                                    theV1,
+                            TopoDS_Vertex&                                    theV2,
+                            TopoDS_Vertex&                                    theV0)
+{
+  double                        aF = 0., aL = 0.;
+  const occ::handle<Geom_Curve> aC = BRep_Tool::Curve(theNE, aF, aL);
+  if (aC.IsNull() || !aC->IsPeriodic() || theParams.size() < 2)
+  {
+    return false;
+  }
+  const double aPeriod = aC->Period();
+  for (std::pair<double, TopoDS_Vertex>& aP : theParams)
+  {
+    aP.first = ElCLib::InPeriod(aP.first, aF, aF + aPeriod);
+  }
+  std::sort(theParams.begin(),
+            theParams.end(),
+            [](const std::pair<double, TopoDS_Vertex>& theA,
+               const std::pair<double, TopoDS_Vertex>& theB) { return theA.first < theB.first; });
+  // Vertices at one parameter count once.
+  std::vector<std::pair<double, TopoDS_Vertex>> aParams;
+  for (const std::pair<double, TopoDS_Vertex>& aP : theParams)
+  {
+    if (aParams.empty() || aP.first - aParams.back().first > Precision::PConfusion())
+    {
+      aParams.push_back(aP);
+    }
+  }
+  if (aParams.size() > 1
+      && aParams.back().first - aParams.front().first > aPeriod - Precision::PConfusion())
+  {
+    aParams.pop_back();
+  }
+  const size_t aNb = aParams.size();
+  if (aNb < 2)
+  {
+    return false;
+  }
+  // The arc i runs from aParams[i] to the next one round the curve.
+  std::vector<bool> aKept(aNb, false);
+  size_t            aNbKept = 0;
+  for (size_t i = 0; i < aNb; ++i)
+  {
+    const double aU1 = aParams[i].first;
+    const double aU2 = i + 1 < aNb ? aParams[i + 1].first : aParams[0].first + aPeriod;
+    aKept[i]         = IsOverOrigins(aC->Value(0.5 * (aU1 + aU2)), theOrigins);
+    aNbKept += aKept[i] ? 1 : 0;
+  }
+  if (aNbKept == 0 || aNbKept == aNb)
+  {
+    return false;
+  }
+  size_t aStart = aNb, aNbStarts = 0;
+  for (size_t i = 0; i < aNb; ++i)
+  {
+    if (aKept[i] && !aKept[(i + aNb - 1) % aNb])
+    {
+      aStart = i;
+      ++aNbStarts;
+    }
+  }
+  if (aNbStarts != 1)
+  {
+    return false;
