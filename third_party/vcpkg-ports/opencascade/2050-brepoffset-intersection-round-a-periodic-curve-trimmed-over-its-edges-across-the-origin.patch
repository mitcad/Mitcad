+//=======================================================================
+// function : LeaveInOneDirection
+// purpose  : Whether theE1 and theE2 leave their common vertex theV in
+//            the same direction (within 1e-3 rad): the face they bound
+//            ends at theV in a point of no angle, as the top of a plate
+//            where a cylinder standing on it continues a rounded corner's
+//            side meets the plate's straight side (mitcad#2050).
+//=======================================================================
+static bool LeaveInOneDirection(const TopoDS_Edge&   theE1,
+                                const TopoDS_Edge&   theE2,
+                                const TopoDS_Vertex& theV)
+{
+  gp_Vec aD[2];
+  for (int k = 0; k < 2; k++)
+  {
+    const TopoDS_Edge& aE = k == 0 ? theE1 : theE2;
+    if (BRep_Tool::Degenerated(aE))
+    {
+      return false;
+    }
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(aE, aV1, aV2);
+    if (aV1.IsNull() || aV2.IsNull() || aV1.IsSame(aV2))
+    {
+      return false;
+    }
+    const bool bAtStart = aV1.IsSame(theV);
+    if (!bAtStart && !aV2.IsSame(theV))
+    {
+      return false;
+    }
+    const BRepAdaptor_Curve aC(aE);
+    gp_Pnt                  aP;
+    gp_Vec                  aD1;
+    aC.D1(bAtStart ? aC.FirstParameter() : aC.LastParameter(), aP, aD1);
+    if (aD1.Magnitude() < gp::Resolution())
+    {
+      return false;
+    }
+    aD[k] = bAtStart ? aD1 : aD1.Reversed();
+  }
+  return aD[0].Angle(aD[1]) < 1.e-3;
+}
