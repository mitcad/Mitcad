+void BRepOffsetAPI_MakePipeShell::SetTransitionMode(const BRepBuilderAPI_TransitionMode Mode,
+                                                    const double                        theAngleMin)
+{
+  // A corner from a turn of the spine's tangent of theAngleMin on (MitCad's
+  // pipes ask for 1e-4 rad for mitred corners, mitcad#1559): through a
+  // smaller turn the section keeps its frame and leans by the turn.
+  myPipe->SetTransition((BRepFill_TransitionStyle)Mode, theAngleMin);
+}
