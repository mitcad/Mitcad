+// A curve on the surface of face F, put into the surface's period where it
+// passes through vertex V at parameter W: the curves of an intersection of
+// two faces' surfaces (GeomInt_IntSS) lie in the periods the intersection
+// chose, which need not be the face's.
+static void ChFi3d_PCurveIntoVertexPeriod(occ::handle<Geom2d_Curve>& C,
+                                          const double              W,
+                                          const TopoDS_Face&        F,
+                                          const TopoDS_Vertex&      V)
+{
+  if (C.IsNull())
+  {
+    return;
+  }
+  const occ::handle<Geom_Surface> S    = BRep_Tool::Surface(F);
+  const gp_Pnt2d                  aOn  = C->Value(W);
+  const gp_Pnt2d                  aAtV = BRep_Tool::Parameters(V, F);
+  double                          aDU = 0., aDV = 0.;
+  if (S->IsUPeriodic())
+  {
+    aDU = S->UPeriod() * std::round((aAtV.X() - aOn.X()) / S->UPeriod());
+  }
+  if (S->IsVPeriodic())
+  {
+    aDV = S->VPeriod() * std::round((aAtV.Y() - aOn.Y()) / S->VPeriod());
+  }
+  if (aDU != 0. || aDV != 0.)
+  {
+    C = occ::down_cast<Geom2d_Curve>(C->Translated(gp_Vec2d(aDU, aDV)));
+  }
+}
