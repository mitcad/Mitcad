+// Whether a piece's line on the narrow face (side Ons) runs along the
+// spine: a walked piece, its lines' parameters those of the spine up to the
+// guide's own tolerance (ChamferCutByFacesBeyond).
+static bool ChFi3d_NarrowPieceWalked(const occ::handle<ChFiDS_SurfData>& SD, const int Ons)
+{
+  const ChFiDS_FaceInterference& FI = SD->Interference(Ons);
+  const double aTolW = std::max(1.e-3 * (SD->LastSpineParam() - SD->FirstSpineParam()), Precision::PConfusion());
+  return std::abs(FI.FirstParameter() - SD->FirstSpineParam()) <= aTolW
+         && std::abs(FI.LastParameter() - SD->LastSpineParam()) <= aTolW;
+}
+
+// Whether the analytic pieces of a stripe computed again over the narrow
+// face B's surface unbounded (ChamferOverNarrowFace, before the rest of it
+// is walked) already refuse its cut by the faces beyond B: a piece within
+// the spine, not walked, whose contact on B (side Ons, its line on WideB,
+// the unbounded face) leaves B or comes back into it at
+// ChamferCutByFacesBeyond's samples. That cut takes such a crossing on a
+// walked piece only (its step 1), and the walk leaves the analytic pieces
+// as they are, so the cut is refused after the walk as well.
+static bool ChFi3d_NarrowCutRefusedByAnalyticPieces(const occ::handle<ChFiDS_Stripe>& Stripe,
+                                                    const int                         Ons,
+                                                    const TopoDS_Face&                B,
+                                                    const TopoDS_Face&                WideB,
+                                                    const TopOpeBRepDS_DataStructure& DStr)
+{
+  if (Stripe->SetOfSurfData().IsNull())
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_Spine>& Spine = Stripe->Spine();
+  const double                     WEnd  = Spine->LastParameter(Spine->NbEdges());
+  TopoDS_Face                      BF    = B;
+  BF.Orientation(TopAbs_FORWARD);
+  BRepTopAdaptor_FClass2d aClass(BF, Precision::PConfusion());
+  const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& Seq = Stripe->SetOfSurfData()->Sequence();
+  for (int i = 1; i <= Seq.Length(); i++)
+  {
+    const occ::handle<ChFiDS_SurfData>& SD = Seq.Value(i);
+    const ChFiDS_FaceInterference&      FI = SD->Interference(Ons);
+    const double                        W0 = SD->FirstSpineParam(), W1 = SD->LastSpineParam();
+    if (W1 <= Precision::PConfusion() || W0 >= WEnd - Precision::PConfusion() || SD->Index(Ons) <= 0
+        || !DStr.Shape(SD->Index(Ons)).IsSame(WideB) || FI.PCurveOnFace().IsNull() || FI.LineIndex() <= 0
+        || ChFi3d_NarrowPieceWalked(SD, Ons))
+    {
+      continue;
+    }
+    // (The samples of the cut's step 1.)
+    const int nbs = 200;
+    bool      in  = true;
+    for (int k = 0; k <= nbs; k++)
+    {
+      const double t   = FI.FirstParameter() + (FI.LastParameter() - FI.FirstParameter()) * k / nbs;
+      const bool   sIn = aClass.Perform(FI.PCurveOnFace()->Value(t)) != TopAbs_OUT;
+      if (k > 0 && sIn != in)
+      {
+        return true;
+      }
+      in = sIn;
+    }
+  }
+  return false;
+}
