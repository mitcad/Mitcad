-  // The three curves, from where each pair's contacts meet to P.
+  // The three curves, between where each pair's contacts meet and P. Both
+  // blends of a pair touch their common face there, so that their
+  // intersection leaves it tangent to both contacts; its p-curves, marched
+  // from there or from P, may cross a contact's p-curve near that point (at
+  // the slab's far end with 1.1, the blend's wire then crossing itself): the
+  // way whose p-curves stay on P's side of both contacts is taken, or the
+  // one crossing them least.
+  // (How far p-curve thePc crosses the contact's p-curve theCo, over
+  // [theF, theL], to the side away from theIn; sampled.)
+  const auto crosses = [](const occ::handle<Geom2d_Curve>& thePc,
+                          const occ::handle<Geom2d_Curve>& theCo,
+                          const double                     theF,
+                          const double                     theL,
+                          const gp_Pnt2d&                  theIn) {
+    if (thePc.IsNull() || theCo.IsNull())
+    {
+      return 0.;
+    }
+    const double aLo = std::min(theF, theL), aHi = std::max(theF, theL);
+    // (The side of the contact P lies on, at P's foot on it.)
+    const auto sideOf = [&](const gp_Pnt2d& theP, double& theDist) {
+      Geom2dAPI_ProjectPointOnCurve aProj(theP, theCo, aLo, aHi);
+      if (aProj.NbPoints() == 0)
+      {
+        theDist = 0.;
+        return 0;
+      }
+      gp_Pnt2d aQ;
+      gp_Vec2d aD;
+      theCo->D1(aProj.LowerDistanceParameter(), aQ, aD);
+      const double aCross = aD.Crossed(gp_Vec2d(aQ, theP));
+      theDist             = aProj.LowerDistance();
+      return aCross > 0. ? 1 : (aCross < 0. ? -1 : 0);
+    };
+    double    aIgnored = 0.;
+    const int aSideIn  = sideOf(theIn, aIgnored);
+    double    aMax     = 0.;
+    const int aNb      = 40;
+    for (int is = 1; is < aNb; is++)
+    {
+      const double w =
+        thePc->FirstParameter() + (thePc->LastParameter() - thePc->FirstParameter()) * is / aNb;
+      double aDist = 0.;
+      const int aSide = sideOf(thePc->Value(w), aDist);
+      if (aSideIn != 0 && aSide == -aSideIn)
+      {
+        aMax = std::max(aMax, aDist);
+      }
+    }
+    return aMax;
+  };
