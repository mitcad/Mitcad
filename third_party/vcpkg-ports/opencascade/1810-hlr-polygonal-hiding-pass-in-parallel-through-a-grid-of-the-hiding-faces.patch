+void HLRAlgo_PolyAlgo::makeGrid()
+{
+  // Each cell lists the hiding faces whose cells include it, in the order
+  // of the faces (shell by shell, a shell's hiding faces in order).
+  myCellStart.Clear();
+  myCellStart.Resize(THE_GRID_SIZE * THE_GRID_SIZE + 1, 0);
+  for (const HidingFace& aFace : myFaces)
+  {
+    for (int aCellY = aFace.CellY1; aCellY <= aFace.CellY2; ++aCellY)
+    {
+      for (int aCellX = aFace.CellX1; aCellX <= aFace.CellX2; ++aCellX)
+      {
+        ++myCellStart(aCellY * THE_GRID_SIZE + aCellX + 1);
+      }
+    }
+  }
+  for (size_t aCell = 1; aCell < myCellStart.Size(); ++aCell)
+  {
+    myCellStart(aCell) += myCellStart(aCell - 1);
+  }
+  myCellFaces.Clear();
+  myCellFaces.Resize(static_cast<size_t>(myCellStart.Last()), 0);
+  NCollection_LinearVector<int> aFill(myCellStart);
+  for (size_t aFaceIter = 0; aFaceIter < myFaces.Size(); ++aFaceIter)
+  {
+    const HidingFace& aFace = myFaces(aFaceIter);
+    for (int aCellY = aFace.CellY1; aCellY <= aFace.CellY2; ++aCellY)
+    {
+      for (int aCellX = aFace.CellX1; aCellX <= aFace.CellX2; ++aCellX)
+      {
+        myCellFaces(static_cast<size_t>(aFill(aCellY * THE_GRID_SIZE + aCellX)++)) =
+          static_cast<int>(aFaceIter);
+      }
+    }
+  }
 }
 
