+static bool ToricCorner(const TopoDS_Face& F, const double rd, const double rf, const gp_Vec& v)
+{
+  if (std::abs(rd - rf) > Precision::Confusion())
+  {
+    return false;
+  }
+  return ToricLayout(F, v);
+}
+
+//=======================================================================
+// Torus corner with unequal side radii.
+//
+// The corner of a torus layout (ToricLayout) whose two sides have
+// different radii is the torus of the larger radius round the pivot, as
+// for equal radii; the stripe of the smaller radius does not end at the
+// torus's section, as the stripe of the larger one does, but where its
+// blend and the torus cross. Past its section the torus runs on (the
+// tail) into the face the smaller stripe shares with the pivot (W), which
+// cuts it, and up to the crossing, which runs from the smaller stripe's
+// contact on the corner's face (point P3, where the torus's contact on it
+// meets the stripe's) to its contact on W (P2). The tail is a corner
+// piece of its own, on a copy of the torus, between the crossing and the
+// torus's section; the smaller stripe ends at the crossing.
+//=======================================================================
+
+namespace
+{
+struct ChFi3d_UnequalTail
+{
+  occ::handle<ChFiDS_SurfData> Tail;
+  occ::handle<Geom_Curve>      Cut;       // the crossing, either way between P3 and P2
+  occ::handle<Geom2d_Curve>    CutOnTail; // the crossing on the torus
+  occ::handle<Geom2d_Curve>    CutOnArm;  // the crossing on the smaller stripe's blend
+  double                       CutFirst = 0.;
+  double                       CutLast  = 0.;
+  bool                         CutFromP3 = true; // the crossing runs from P3 to P2
+  double                       ArmOnFac  = 0.;   // the smaller stripe's parameter at P3
+  double                       ArmOnW    = 0.;   // and at P2
+  double                       Tol       = 0.;
+};
+} // namespace
+
+// The curve itself where C is a trimmed one.
+static occ::handle<Geom2d_Curve> unequalBasis(const occ::handle<Geom2d_Curve>& C)
+{
+  occ::handle<Geom2d_TrimmedCurve> aT = occ::down_cast<Geom2d_TrimmedCurve>(C);
+  return aT.IsNull() ? C : aT->BasisCurve();
+}
+
+static occ::handle<Geom_Curve> unequalBasis(const occ::handle<Geom_Curve>& C)
+{
+  occ::handle<Geom_TrimmedCurve> aT = occ::down_cast<Geom_TrimmedCurve>(C);
+  return aT.IsNull() ? C : aT->BasisCurve();
+}
+
+// The window of S round the parameters A and B: in a periodic direction a
+// period less a margin, centred between them; in another one their span
+// widened by L, within the surface's bounds.
+static occ::handle<Geom_Surface> unequalWindow(const occ::handle<Geom_Surface>& S,
+                                               const gp_Pnt2d&                  A,
+                                               const gp_Pnt2d&                  B,
+                                               const double                     L)
+{
+  double u0, u1, v0, v1;
+  S->Bounds(u0, u1, v0, v1);
+  const auto range = [&](const bool   periodic,
+                         const double period,
+                         const double a,
+                         double       b,
+                         const double lo,
+                         const double hi,
+                         double&      r0,
+                         double&      r1) {
+      if (periodic)
+      {
+        b              = ElCLib::InPeriod(b, a - 0.5 * period, a + 0.5 * period);
+        const double m = 0.5 * (a + b);
+        r0             = m - 0.5 * period + 0.05;
+        r1             = m + 0.5 * period - 0.05;
+      }
+      else
+      {
+        r0 = std::max(lo, std::min(a, b) - L);
+        r1 = std::min(hi, std::max(a, b) + L);
+      }
+    };
+  double ua, ub, va, vb;
+  range(S->IsUPeriodic(), S->IsUPeriodic() ? S->UPeriod() : 0., A.X(), B.X(), u0, u1, ua, ub);
+  range(S->IsVPeriodic(), S->IsVPeriodic() ? S->VPeriod() : 0., A.Y(), B.Y(), v0, v1, va, vb);
+  return new Geom_RectangularTrimmedSurface(S, ua, ub, va, vb);
+}
+
+// C moved by whole periods of S so that its point at t is the nearest to
+// Near (the intersection's curves come in a period of their own).
+static occ::handle<Geom2d_Curve> unequalNear(const occ::handle<Geom2d_Curve>& C,
+                                             const double                     t,
+                                             const gp_Pnt2d&                  Near,
+                                             const occ::handle<Geom_Surface>& S)
+{
+  const gp_Pnt2d aP  = C->Value(t);
+  double         aDU = 0., aDV = 0.;
+  if (S->IsUPeriodic())
+  {
+    aDU = S->UPeriod() * std::floor((Near.X() - aP.X()) / S->UPeriod() + 0.5);
+  }
+  if (S->IsVPeriodic())
+  {
+    aDV = S->VPeriod() * std::floor((Near.Y() - aP.Y()) / S->VPeriod() + 0.5);
+  }
+  if (aDU == 0. && aDV == 0.)
+  {
+    return C;
+  }
+  occ::handle<Geom2d_Curve> aC = occ::down_cast<Geom2d_Curve>(C->Copy());
+  aC->Translate(gp_Vec2d(aDU, aDV));
+  return aC;
+}
+
+// The parameter on C of its point nearest to P, its ends included, and
+// the distance.
+static double unequalParam(const occ::handle<Geom_Curve>& C, const gp_Pnt& P, double& theDist)
+{
+  const double f = C->FirstParameter(), l = C->LastParameter();
+  double       t = f;
+  theDist        = P.Distance(C->Value(f));
+  if (P.Distance(C->Value(l)) < theDist)
+  {
+    t       = l;
+    theDist = P.Distance(C->Value(l));
+  }
+  GeomAPI_ProjectPointOnCurve aPr(P, C, f, l);
+  if (aPr.NbPoints() > 0 && aPr.LowerDistance() < theDist)
+  {
+    theDist = aPr.LowerDistance();
+    t       = aPr.LowerDistanceParameter();
+  }
+  return t;
+}
+
+// The tail of the corner Coin (made with the larger radius) at its end
+// AtFirst, and the crossing; false where the corner is not of this kind:
+// no crossing between the smaller stripe's contacts beyond its section,
+// on the faces, within a quarter turn of the torus.
+//   Arm, SideFac, SideW: the smaller stripe's SurfData at the corner and
+//   its sides on the corner's face Fac and on W; PFac and PW its parameters
+//   on them at the torus's section, SensArm its direction there (1: the
+//   corner is at its first end).
+static bool unequalTail(TopOpeBRepDS_DataStructure&         DStr,
+                        const occ::handle<ChFiDS_SurfData>& Coin,
+                        const bool                          AtFirst,
+                        const occ::handle<ChFiDS_SurfData>& Arm,
+                        const int                           SideFac,
+                        const int                           SideW,
+                        const double                        PFac,
+                        const double                        PW,
+                        const int                           SensArm,
+                        const TopoDS_Face&                  Fac,
+                        const TopoDS_Face&                  W,
+                        const double                        Tol3d,
+                        ChFi3d_UnequalTail&                 theTail)
+{
+  const occ::handle<Geom_Surface> aTor = DStr.Surface(Coin->Surf()).Surface();
+  if (GeomAdaptor_Surface(aTor).GetType() != GeomAbs_Torus || Arm->Index(SideFac) <= 0
+      || Arm->Index(SideW) <= 0)
+  {
+    return false;
+  }
+  const ChFiDS_FaceInterference& aFi1 = Coin->InterferenceOnS1();
+  const ChFiDS_FaceInterference& aFi2 = Coin->InterferenceOnS2();
+  occ::handle<Geom_Curve> aOnFac3d;
+  if (aFi1.LineIndex() > 0)
+  {
+    aOnFac3d = unequalBasis(DStr.Curve(aFi1.LineIndex()).Curve());
+  }
+  const occ::handle<Geom2d_Curve> aOnFac = unequalBasis(aFi1.PCurveOnFace());
+  const occ::handle<Geom2d_Curve> aOnTor = unequalBasis(aFi1.PCurveOnSurf());
+  if (aOnFac3d.IsNull() || aOnFac.IsNull() || aOnTor.IsNull() || !aOnFac->IsPeriodic())
+  {
+    return false;
+  }
+  // The torus's section at the smaller stripe: its points on Fac (A) and
+  // on the pivot, which lies on W (Q).
+  const double   tS1   = AtFirst ? aFi1.FirstParameter() : aFi1.LastParameter();
+  const double   tS2   = AtFirst ? aFi2.FirstParameter() : aFi2.LastParameter();
+  const gp_Pnt2d aUVA  = aOnTor->Value(tS1);
+  const gp_Pnt2d aUVQ  = aFi2.PCurveOnSurf()->Value(tS2);
+  const gp_Pnt   aQ    = aTor->Value(aUVQ.X(), aUVQ.Y());
+  const double   aSpan = 10. * aTor->Value(aUVA.X(), aUVA.Y()).Distance(aQ);
+
+  // P3: where the smaller stripe's contact on Fac meets the torus's,
+  // beyond the section on both.
+  const ChFiDS_FaceInterference& aArmFac = Arm->Interference(SideFac);
+  const ChFiDS_FaceInterference& aArmW   = Arm->Interference(SideW);
+  const double aArmLo = std::min(aArmFac.FirstParameter(), aArmFac.LastParameter());
+  const double aArmHi = std::max(aArmFac.FirstParameter(), aArmFac.LastParameter());
+  Geom2dAPI_InterCurveCurve aX3(aArmFac.PCurveOnFace(), aOnFac, Precision::PConfusion());
+  bool   aHas3 = false;
+  double tArm3 = 0., tTor3 = 0., aBest3 = 0.;
+  for (int k = 1; k <= aX3.NbPoints(); k++)
+  {
+    const double ta = aX3.Intersector().Point(k).ParamOnFirst();
+    const double tc =
+      ElCLib::InPeriod(aX3.Intersector().Point(k).ParamOnSecond(), tS1 - M_PI, tS1 + M_PI);
+    const double aBeyond = AtFirst ? tS1 - tc : tc - tS1;
+    if (aBeyond <= Precision::PConfusion() || aBeyond >= 0.5 * M_PI
+        || (ta - PFac) * SensArm <= Precision::PConfusion() || ta < aArmLo - Precision::PConfusion()
+        || ta > aArmHi + Precision::PConfusion())
+    {
+      continue;
+    }
+    if (!aHas3 || aBeyond < aBest3)
+    {
+      aHas3  = true;
+      aBest3 = aBeyond;
+      tArm3 = ta;
+      tTor3 = tc;
+    }
+  }
+  if (!aHas3)
+  {
+    return false;
+  }
+  const occ::handle<Geom_Surface> aFacS = BRep_Tool::Surface(Fac);
+  const gp_Pnt2d                  aUV3  = aArmFac.PCurveOnFace()->Value(tArm3);
+  const gp_Pnt                    aP3   = aFacS->Value(aUV3.X(), aUV3.Y());
+  if (BRepTopAdaptor_FClass2d(Fac, Precision::PConfusion()).Perform(aUV3) != TopAbs_IN)
+  {
+    return false;
+  }
+
+  // The torus cut by W, from Q.
+  const occ::handle<Geom_Surface> aWS = BRep_Tool::Surface(W);
+  GeomAPI_ProjectPointOnSurf      aPrQ(aQ, aWS);
+  if (aPrQ.NbPoints() == 0 || aPrQ.LowerDistance() > Tol3d)
+  {
+    return false;
+  }
+  double uq, vq;
+  aPrQ.LowerDistanceParameters(uq, vq);
+  const occ::handle<Geom_Surface> aTorWin = unequalWindow(aTor, aUVA, aUVQ, aSpan);
+  GeomInt_IntSS                   aIW;
+  aIW.Perform(aTorWin,
+              unequalWindow(aWS, gp_Pnt2d(uq, vq), gp_Pnt2d(uq, vq), aSpan),
+              Tol3d,
+              true,
+              true,
+              true);
+  if (!aIW.IsDone())
+  {
+    return false;
+  }
+  const double aTolW = std::max(10. * Tol3d, 10. * aIW.TolReached3d());
+  // P2: where the smaller stripe's contact on W meets the cut, beyond the
+  // section, nearest to Q along the cut.
+  int    iW = 0;
+  double tWQ = 0., tW2 = 0., tArm2 = 0.;
+  for (int k = 1; k <= aIW.NbLines(); k++)
+  {
+    if (!aIW.HasLineOnS2(k))
+    {
+      continue;
+    }
+    double       dq;
+    const double tq = unequalParam(aIW.Line(k), aQ, dq);
+    if (dq > aTolW)
+    {
+      continue;
+    }
+    Geom2dAPI_InterCurveCurve aX2(aArmW.PCurveOnFace(), aIW.LineOnS2(k), Precision::PConfusion());
+    for (int n = 1; n <= aX2.NbPoints(); n++)
+    {
+      const double ta = aX2.Intersector().Point(n).ParamOnFirst();
+      const double tw = aX2.Intersector().Point(n).ParamOnSecond();
+      if ((ta - PW) * SensArm <= Precision::PConfusion()
+          || ta < std::min(aArmW.FirstParameter(), aArmW.LastParameter()) - Precision::PConfusion()
+          || ta > std::max(aArmW.FirstParameter(), aArmW.LastParameter()) + Precision::PConfusion())
+      {
+        continue;
+      }
+      if (iW == 0 || std::abs(tw - tq) < std::abs(tW2 - tWQ))
+      {
+        iW    = k;
+        tWQ   = tq;
+        tW2   = tw;
+        tArm2 = ta;
+      }
+    }
+  }
+  if (iW == 0)
+  {
+    return false;
+  }
+  const gp_Pnt2d aUV2 = aArmW.PCurveOnFace()->Value(tArm2);
+  const gp_Pnt   aP2  = aWS->Value(aUV2.X(), aUV2.Y());
+  if (BRepTopAdaptor_FClass2d(W, Precision::PConfusion()).Perform(aUV2) != TopAbs_IN)
+  {
+    return false;
+  }
+
+  // The crossing of the smaller stripe's blend with the torus, from P3 to
+  // P2.
+  const occ::handle<Geom_Surface> aArmS = DStr.Surface(Arm->Surf()).Surface();
+  GeomInt_IntSS                    aIC;
+  aIC.Perform(unequalWindow(aArmS,
+                            aArmFac.PCurveOnSurf()->Value(tArm3),
+                            aArmW.PCurveOnSurf()->Value(tArm2),
+                            aSpan),
+              aTorWin,
+              Tol3d,
+              true,
+              true,
+              true);
+  if (!aIC.IsDone())
+  {
+    return false;
+  }
+  const double aTolC = std::max(10. * Tol3d, 10. * aIC.TolReached3d());
+  int          iC    = 0;
+  double       tC3 = 0., tC2 = 0.;
+  for (int k = 1; k <= aIC.NbLines() && iC == 0; k++)
+  {
+    if (!aIC.HasLineOnS1(k) || !aIC.HasLineOnS2(k))
+    {
+      continue;
+    }
+    double       d3, d2;
+    const double t3 = unequalParam(aIC.Line(k), aP3, d3);
+    const double t2 = unequalParam(aIC.Line(k), aP2, d2);
+    if (d3 <= aTolC && d2 <= aTolC && std::abs(t3 - t2) > Precision::PConfusion())
+    {
+      iC  = k;
+      tC3 = t3;
+      tC2 = t2;
+    }
+  }
+  if (iC == 0)
+  {
+    return false;
+  }
+
+  // The tail's cut by W, from P2 to Q where the tail runs from the
+  // crossing to the section (AtFirst), else from Q to P2: the cut's
+  // curves turned where they run the other way.
+  occ::handle<Geom_Curve>   aW3d   = aIW.Line(iW);
+  occ::handle<Geom2d_Curve> aWOnT  = unequalNear(aIW.LineOnS1(iW), tWQ, aUVQ, aTor);
+  occ::handle<Geom2d_Curve> aWOnW  = aIW.LineOnS2(iW);
+  double                    tWFrom = AtFirst ? tW2 : tWQ;
+  double                    tWTo   = AtFirst ? tWQ : tW2;
+  if (tWFrom > tWTo)
+  {
+    const double f = aW3d->FirstParameter(), l = aW3d->LastParameter();
+    if (std::abs(aWOnT->FirstParameter() - f) > Precision::PConfusion()
+        || std::abs(aWOnT->LastParameter() - l) > Precision::PConfusion()
+        || std::abs(aWOnW->FirstParameter() - f) > Precision::PConfusion()
+        || std::abs(aWOnW->LastParameter() - l) > Precision::PConfusion())
+    {
+      return false;
+    }
+    aW3d   = aW3d->Reversed();
+    aWOnT  = aWOnT->Reversed();
+    aWOnW  = aWOnW->Reversed();
+    tWFrom = f + l - tWFrom;
+    tWTo   = f + l - tWTo;
+  }
+
+  // The tail: a copy of the torus, its contact on Fac from P3 to the
+  // section (the torus's own contact run on), its cut by W.
+  const bool aTailAway = !AtFirst;
+  const bool aArmAway  = SensArm == 1;
+  const auto aTrans    = [&](const TopAbs_Orientation T) {
+    return aTailAway == aArmAway ? T : TopAbs::Reverse(T);
+  };
+  occ::handle<ChFiDS_SurfData> aTail = new ChFiDS_SurfData();
+  const double                 aTorTol = DStr.Surface(Coin->Surf()).Tolerance();
+  aTail->ChangeSurf(DStr.AddSurface(
+    TopOpeBRepDS_Surface(occ::down_cast<Geom_Surface>(aTor->Copy()), aTorTol)));
+  aTail->ChangeOrientation() = Coin->Orientation();
+  aTail->ChangeIndexOfS1(DStr.AddShape(Fac));
+  aTail->ChangeIndexOfS2(DStr.AddShape(W));
+  const int aIFac = DStr.AddCurve(TopOpeBRepDS_Curve(occ::down_cast<Geom_Curve>(aOnFac3d->Copy()),
+                                                    DStr.Curve(aFi1.LineIndex()).Tolerance()));
+  aTail->ChangeInterferenceOnS1().SetInterference(aIFac,
+                                                  aTrans(aArmFac.Transition()),
+                                                  occ::down_cast<Geom2d_Curve>(aOnFac->Copy()),
+                                                  occ::down_cast<Geom2d_Curve>(aOnTor->Copy()));
+  aTail->ChangeInterferenceOnS1().SetFirstParameter(AtFirst ? tTor3 : tS1);
