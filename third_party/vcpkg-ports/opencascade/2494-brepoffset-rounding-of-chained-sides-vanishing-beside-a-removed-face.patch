+
+//! The angle by which the boundary of a face turns from the edge theE1 to
+//! the next edge theE2 of its wire (both as oriented in the wire), at their
+//! common vertex; -1 where it cannot be computed.
+static double TurnBetween(const TopoDS_Edge& theE1, const TopoDS_Edge& theE2)
+{
+  gp_Vec aT[2];
+  for (int k = 0; k < 2; ++k)
+  {
+    const TopoDS_Edge& aE = k == 0 ? theE1 : theE2;
+    if (BRep_Tool::Degenerated(aE))
+    {
+      return -1.;
+    }
+    const BRepAdaptor_Curve aC(aE);
+    // the end of theE1 and the start of theE2, as oriented
+    const bool bLast = (k == 0) == (aE.Orientation() != TopAbs_REVERSED);
+    gp_Pnt     aP;
+    aC.D1(bLast ? aC.LastParameter() : aC.FirstParameter(), aP, aT[k]);
+    if (aE.Orientation() == TopAbs_REVERSED)
+    {
+      aT[k].Reverse();
+    }
+    if (aT[k].Magnitude() < gp::Resolution())
+    {
+      return -1.;
+    }
+  }
+  return aT[0].Angle(aT[1]);
+}
+
+//! The four sides of a face of more than four edges whose boundary turns
+//! sharply at four vertices only (by more than 30 degrees; elsewhere its
+//! edges join smoothly): the chains of edges between those corners, in the
+//! order of the wire. False where there are not four such corners
+//! (mitcad#2494: a rounding whose boundary was split into many edges, where
+//! other faces cut it).
+static bool FourSides(const NCollection_Sequence<TopoDS_Edge>& theEdges,
+                      NCollection_Sequence<TopoDS_Edge>        theSides[4])
+{
+  const int                 aNb = theEdges.Length();
+  NCollection_Sequence<int> aCorners; // a corner after the edge of that index
+  for (int i = 1; i <= aNb; ++i)
+  {
+    const double aTurn = TurnBetween(theEdges(i), theEdges(i % aNb + 1));
+    if (aTurn < 0.)
+    {
+      return false;
+    }
+    if (aTurn > M_PI / 6.)
+    {
+      aCorners.Append(i);
+    }
+  }
+  if (aCorners.Length() != 4)
+  {
+    return false;
+  }
+  for (int k = 1; k <= 4; ++k)
+  {
+    const int aLast = aCorners(k % 4 + 1);
+    for (int i = aCorners(k) % aNb + 1;; i = i % aNb + 1)
+    {
+      theSides[k - 1].Append(theEdges(i));
+      if (i == aLast)
+      {
+        break;
+      }
+    }
+  }
+  return true;
+}
+
+//! As VanishesBetween, between two opposite sides of the face that are
+//! chains of edges (FourSides): at stations along each edge of both sides,
+//! with the nearest point of the other side. Where it vanishes at every
+//! station (1), thePairs gets the pairs of edges, one of theA and one of
+//! theB, that a station and its nearest point lie on (mitcad#2494).
+static int VanishesBetweenSides(
+  const TopoDS_Face&                                                                   theF,
+  const NCollection_Sequence<TopoDS_Edge>&                                             theA,
+  const NCollection_Sequence<TopoDS_Edge>&                                             theB,
+  const BRepOffset_Analyse&                                                            theAnalyse,
+  const GeomAbs_JoinType                                                               theJoin,
+  NCollection_DataMap<TopoDS_Shape, occ::handle<Geom_Surface>, TopTools_ShapeMapHasher>& theOffsetSurfaces,
+  const NCollection_DataMap<TopoDS_Shape, double, TopTools_ShapeMapHasher>& theFaceOffset,
+  const double                                                              theOffset,
+  NCollection_List<TopoDS_Shape>&                                           thePairs)
+{
+  const double   aDF         = std::abs(FaceOffsetValue(theF, theFaceOffset, theOffset));
+  const int      aNbStations = 3;
+  int            aNbVanished = 0, aNbKept = 0;
+  NCollection_List<TopoDS_Shape> aPairs;
+  for (int s = 0; s < 2; ++s)
+  {
+    const NCollection_Sequence<TopoDS_Edge>& aFrom = s == 0 ? theA : theB;
+    const NCollection_Sequence<TopoDS_Edge>& aTo   = s == 0 ? theB : theA;
+    for (int i = 1; i <= aFrom.Length(); ++i)
+    {
+      const TopoDS_Edge&             aE = aFrom(i);
+      double                         aF, aL;
+      const occ::handle<Geom_Curve>& aC = BRep_Tool::Curve(aE, aF, aL);
+      if (aC.IsNull())
+      {
+        return -1;
+      }
+      for (int iS = 0; iS < aNbStations; ++iS)
+      {
+        const double aT = aF + (aL - aF) * (iS + 0.5) / aNbStations;
+        gp_Pnt       aP, aIm;
+        if (!ImageOnOffsetBoundary(aE,
+                                   theF,
+                                   aT,
+                                   theAnalyse,
+                                   theJoin,
+                                   theOffsetSurfaces,
+                                   theFaceOffset,
+                                   theOffset,
+                                   aP,
+                                   aIm))
+        {
+          return -1;
+        }
+        // the nearest point of the other side (inside an edge or at an end)
+        int    aJ    = 0;
+        double aTO   = 0.;
+        double aDist = RealLast();
+        for (int j = 1; j <= aTo.Length(); ++j)
+        {
+          double                         aFO, aLO;
+          const occ::handle<Geom_Curve>& aCO = BRep_Tool::Curve(aTo(j), aFO, aLO);
+          if (aCO.IsNull())
+          {
+            return -1;
+          }
+          for (const double aTEnd : {aFO, aLO})
+          {
+            const double aD = aP.Distance(aCO->Value(aTEnd));
+            if (aD < aDist)
+            {
+              aDist = aD;
+              aJ    = j;
+              aTO   = aTEnd;
+            }
+          }
+          GeomAPI_ProjectPointOnCurve aProj(aP, aCO, aFO, aLO);
+          if (aProj.NbPoints() > 0 && aProj.LowerDistance() < aDist)
+          {
+            aDist = aProj.LowerDistance();
+            aJ    = j;
+            aTO   = aProj.LowerDistanceParameter();
+          }
+        }
+        if (aJ == 0)
+        {
+          return -1;
+        }
+        // too wide a face to vanish at this offset
+        if (aDist > 10. * aDF)
+        {
+          return 0;
+        }
+        gp_Pnt aPO, aImO;
+        if (!ImageOnOffsetBoundary(aTo(aJ),
+                                   theF,
+                                   aTO,
+                                   theAnalyse,
+                                   theJoin,
+                                   theOffsetSurfaces,
+                                   theFaceOffset,
+                                   theOffset,
+                                   aPO,
+                                   aImO))
+        {
+          return -1;
+        }
+        const gp_Vec aW(aP, aPO);
+        const gp_Vec aWI(aIm, aImO);
+        if (aWI.Magnitude() < Precision::Confusion() || aWI.Dot(aW) < 0.)
+        {
+          ++aNbVanished;
+        }
+        else
+        {
+          ++aNbKept;
+        }
+        const TopoDS_Edge& aEA = s == 0 ? aE : aTo(aJ);
+        const TopoDS_Edge& aEB = s == 0 ? aTo(aJ) : aE;
+        bool               bKnown = false;
+        for (NCollection_List<TopoDS_Shape>::Iterator aIt(aPairs); aIt.More() && !bKnown; aIt.Next())
+        {
+          const TopoDS_Shape& aPA = aIt.Value();
+          aIt.Next();
+          bKnown = aPA.IsSame(aEA) && aIt.Value().IsSame(aEB);
+        }
+        if (!bKnown)
+        {
+          aPairs.Append(aEA);
+          aPairs.Append(aEB);
+        }
+      }
+    }
+  }
+  if (aNbKept == 0 && aNbVanished > 0)
+  {
+    thePairs.Append(aPairs);
+    return 1;
+  }
+  return aNbVanished == 0 ? 0 : -1;
+}
