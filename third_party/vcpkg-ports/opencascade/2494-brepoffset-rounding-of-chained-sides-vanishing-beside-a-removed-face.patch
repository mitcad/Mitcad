+//=======================================================================
+// function : JoinRunAcrossSeams
+// purpose  : The section of a face extended to a cap (ExtentFace) may come
+//           in a run of pieces sharing their ends (the offset of a slot's
+//           round end cut by the periodic surface of a loft whose top is
+//           removed: three pieces, split where the section crosses the
+//           extended face's seam and where its curve was computed in two).
+//           SelectEdge keeps one piece, which may stop short of an end of
+//           the edge to extend: the extended face then found no vertex there
+//           and got no wire. The pieces running on from the one selected
+//           through their common vertices, a simple run (two free ends, no
+//           branch, not closed), are glued into one edge with its curves on
+//           both faces (mitcad#2494); the pieces of a section lie in both
+//           faces, so a run of them is one section. Unchanged where there is
+//           no such run or it cannot be glued.
+//=======================================================================
+static void JoinRunAcrossSeams(const NCollection_List<TopoDS_Shape>& theAll,
+                               const TopoDS_Face&                    theF1,
+                               const TopoDS_Face&                    theF2,
+                               const TopAbs_State                    theSide,
+                               NCollection_List<TopoDS_Shape>&       theSelected)
+{
+  if (theAll.Extent() < 2 || theSelected.Extent() != 1)
+  {
+    return;
+  }
+  // the run, grown from the selected piece at both its free ends, one piece
+  // at a time, through the vertices it shares with one other piece
+  NCollection_DataMap<TopoDS_Shape, NCollection_List<TopoDS_Shape>, TopTools_ShapeMapHasher> aPiecesAt;
+  for (NCollection_List<TopoDS_Shape>::Iterator aIt(theAll); aIt.More(); aIt.Next())
+  {
+    TopoDS_Vertex aV1, aV2;
+    TopExp::Vertices(TopoDS::Edge(aIt.Value()), aV1, aV2);
+    for (const TopoDS_Vertex& aV : {aV1, aV2})
+    {
+      if (aV.IsNull())
+      {
+        return;
+      }
+      if (NCollection_List<TopoDS_Shape>* pL = aPiecesAt.ChangeSeek(aV))
+      {
+        pL->Append(aIt.Value());
+      }
+      else
+      {
+        NCollection_List<TopoDS_Shape> aL;
+        aL.Append(aIt.Value());
+        aPiecesAt.Bind(aV, aL);
+      }
+    }
+  }
+  NCollection_Sequence<TopoDS_Shape> aRun;
+  aRun.Append(theSelected.First());
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aUsed;
+  aUsed.Add(theSelected.First());
+  TopoDS_Vertex aEnds[2];
+  TopExp::Vertices(TopoDS::Edge(theSelected.First()), aEnds[0], aEnds[1]);
+  if (aEnds[0].IsNull() || aEnds[0].IsSame(aEnds[1]))
+  {
+    return; // a closed piece
+  }
+  for (int aSide = 0; aSide < 2; ++aSide)
+  {
+    for (int aGuard = 0; aGuard < theAll.Extent(); ++aGuard)
+    {
+      const TopoDS_Edge  aEnd = TopoDS::Edge(aSide == 0 ? aRun.First() : aRun.Last());
+      const TopoDS_Shape aV   = aEnds[aSide];
+      const NCollection_List<TopoDS_Shape>* pL = aPiecesAt.Seek(aV);
+      if (pL == nullptr)
+      {
+        break;
+      }
+      TopoDS_Shape                          aNext;
+      int                                   aNbNext = 0;
+      for (NCollection_List<TopoDS_Shape>::Iterator aIt(*pL); aIt.More(); aIt.Next())
+      {
+        if (!aIt.Value().IsSame(aEnd))
+        {
+          aNext = aIt.Value();
+          ++aNbNext;
+        }
+      }
+      if (aNbNext == 0)
+      {
+        break;
+      }
+      if (aNbNext > 1 || aUsed.Contains(aNext))
+      {
+        return; // a branch, or a closed run
+      }
+      if (aSide == 0)
+      {
+        aRun.Prepend(aNext);
+      }
+      else
+      {
+        aRun.Append(aNext);
+      }
+      aUsed.Add(aNext);
+      TopoDS_Vertex aV1, aV2;
+      TopExp::Vertices(TopoDS::Edge(aNext), aV1, aV2);
+      if (aV1.IsNull() || aV1.IsSame(aV2))
+      {
+        return;
+      }
+      aEnds[aSide] = aV1.IsSame(aV) ? aV2 : aV1;
+      if (aEnds[aSide].IsSame(aEnds[1 - aSide]))
+      {
+        return; // a closed run
+      }
+    }
+  }
+  if (aRun.Length() < 2)
+  {
+    return;
+  }
+  bool addPCurve[2] = {true, true};
+  for (int k = 0; k < 2; ++k)
+  {
+    occ::handle<Geom_Surface> aS = BRep_Tool::Surface(k == 0 ? theF1 : theF2);
+    if (aS->IsInstance(STANDARD_TYPE(Geom_RectangularTrimmedSurface)))
+    {
+      aS = occ::down_cast<Geom_RectangularTrimmedSurface>(aS)->BasisSurface();
+    }
+    addPCurve[k] = !aS->IsInstance(STANDARD_TYPE(Geom_Plane));
+  }
+  TopoDS_Edge aCur = TopoDS::Edge(aRun.First());
+  for (int j = 2; j <= aRun.Length(); ++j)
+  {
+    const TopoDS_Edge aE = TopoDS::Edge(aRun(j));
