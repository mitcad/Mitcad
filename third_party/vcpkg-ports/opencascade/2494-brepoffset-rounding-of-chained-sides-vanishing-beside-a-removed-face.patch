+    if (!TopExp::CommonVertex(aCur, aE, aCV))
+    {
+      return;
+    }
+    TopExp::Vertices(aCur, aV11, aV12);
+    TopExp::Vertices(aE, aV21, aV22);
+    if (aV11.IsSame(aV12) || aV21.IsSame(aV22))
+    {
+      return;
+    }
+    if (aV11.IsSame(aCV) && aV21.IsSame(aCV))
+    {
+      aVfirst = aV22;
+      aVlast  = aV12;
+    }
+    else if (aV11.IsSame(aCV) && aV22.IsSame(aCV))
+    {
+      aVfirst = aV21;
+      aVlast  = aV12;
+    }
+    else if (aV12.IsSame(aCV) && aV21.IsSame(aCV))
+    {
+      aVfirst = aV11;
+      aVlast  = aV22;
+    }
+    else
+    {
+      aVfirst = aV11;
+      aVlast  = aV21;
+    }
+    const double aGlueTol = std::max(BRep_Tool::Tolerance(aCV), Precision::Confusion());
+    const TopoDS_Edge aNew =
+      Glue(aCur, aE, aVfirst, aVlast, false, theF1, addPCurve[0], theF2, addPCurve[1], aGlueTol);
+    if (aNew.IsNull())
+    {
+      return;
+    }
+    aCur = aNew;
+  }
+  BRepLib::SameParameter(aCur, Precision::Confusion(), true);
+  if (BRep_Tool::Tolerance(aCur) >= 1.e-4)
+  {
+    ReconstructPCurves(aCur);
+    BRepLib::SameParameter(aCur, Precision::Confusion(), true);
+  }
+  if (BRep_Tool::Tolerance(aCur) > 1.e-2)
+  {
+    return;
+  }
+  TopAbs_Orientation aO1, aO2;
+  BRepOffset_Tool::OrientSection(aCur, theF1, theF2, aO1, aO2);
+  if (theSide == TopAbs_OUT)
+  {
+    aO1 = TopAbs::Reverse(aO1);
+  }
+  theSelected.Clear();
+  theSelected.Append(aCur.Oriented(aO1));
+}
