+        vmax           = std::max(vmax, w);
+      }
+      const double lf = GeomInt_LineTool::FirstParameter(L), ll = GeomInt_LineTool::LastParameter(L);
+      const auto   inBoth = [&](const double w) {
+        gp_Pnt P;
+        GLinePoint(typl, GLine, w, P);
+        Parameters(myHS1, myHS2, P, u1, v1, u2, v2);
+        AdjustPeriodic(myHS1, myHS2, u1, v1, u2, v2);
