+//=======================================================================
+// function : ProlongOnSameEdge
+// purpose  : In the OnSame state the contact point on the face running on
+//           past the vertex lies beyond the vertex on the prolongation of
+//           the face's edge <theEdge> at the vertex (parameter <thePar>,
+//           point <theIndPoint>). The piece of the edge's curve from the
+//           vertex to that point bounds both faces of the edge, in the
+//           edge's orientation in each, as in PerformOneCorner's OnSame
+//           case, and the spine's edge is cut at the vertex. Returns false
+//           (nothing done) when the point lies on the edge.
+//=======================================================================
+
+static bool ProlongOnSameEdge(TopOpeBRepDS_DataStructure& DStr,
+                              const TopoDS_Edge&          theEdge,
+                              const TopoDS_Face&          theFace1,
+                              const TopoDS_Face&          theFace2,
+                              const TopoDS_Vertex&        theVtx,
+                              const TopoDS_Edge&          theSpineEdge,
+                              const double                thePar,
+                              const int                   theIndPoint,
+                              const double                theTol)
+{
+  double                  aFirst, aLast;
+  occ::handle<Geom_Curve> aCurve = BRep_Tool::Curve(theEdge, aFirst, aLast);
+  if (aCurve.IsNull()
+      || (thePar >= aFirst - Precision::PConfusion() && thePar <= aLast + Precision::PConfusion()))
+  {
+    return false;
+  }
+  const double parVtx   = BRep_Tool::Parameter(theVtx, theEdge);
+  const double par1     = std::min(parVtx, thePar);
+  const double par2     = std::max(parVtx, thePar);
+  const bool   isVtxLow = parVtx < thePar;
+  const int    IVtx     = DStr.AddShape(theVtx);
+  const int    indcurv  = DStr.AddCurve(
+    TopOpeBRepDS_Curve(new Geom_TrimmedCurve(aCurve, par1, par2), theTol));
+  DStr.ChangeCurveInterferences(indcurv).Append(
+    ChFi3d_FilPointInDS(TopAbs_FORWARD, indcurv, isVtxLow ? IVtx : theIndPoint, par1, isVtxLow));
+  DStr.ChangeCurveInterferences(indcurv).Append(
+    ChFi3d_FilPointInDS(TopAbs_REVERSED, indcurv, isVtxLow ? theIndPoint : IVtx, par2, !isVtxLow));
+  const TopoDS_Face aFaces[2] = {theFace1, theFace2};
+  for (int iF = 0; iF < 2; iF++)
+  {
+    TopAbs_Orientation anOri = TopAbs_FORWARD;
+    for (TopExp_Explorer anExp(aFaces[iF].Oriented(TopAbs_FORWARD), TopAbs_EDGE); anExp.More();
+         anExp.Next())
+    {
+      if (anExp.Current().IsSame(theEdge))
+      {
+        anOri = anExp.Current().Orientation();
+      }
+    }
+    double                    aU1, aU2;
+    occ::handle<Geom2d_Curve> aPCurve = BRep_Tool::CurveOnSurface(theEdge, aFaces[iF], aU1, aU2);
+    const int                 anIF    = DStr.AddShape(aFaces[iF]);
+    DStr.ChangeShapeInterferences(anIF).Append(ChFi3d_FilCurveInDS(indcurv, anIF, aPCurve, anOri));
+  }
+  const int          IArcspine = DStr.AddShape(theSpineEdge);
+  TopAbs_Orientation OVtx      = TopAbs_FORWARD;
+  for (TopExp_Explorer anExp(theSpineEdge.Oriented(TopAbs_FORWARD), TopAbs_VERTEX); anExp.More();
+       anExp.Next())
+  {
+    if (theVtx.IsSame(anExp.Current()))
+    {
+      OVtx = anExp.Current().Orientation();
+      break;
+    }
+  }
+  DStr.ChangeShapeInterferences(IArcspine).Append(
+    ChFi3d_FilVertexInDS(TopAbs::Reverse(OVtx),
+                         IArcspine,
+                         IVtx,
+                         BRep_Tool::Parameter(theVtx, theSpineEdge)));
+  return true;
+}
