+//=======================================================================
+// function : AddFacesJoinedByArc
+// purpose  : The faces the arc join gives the offset of <theFace>
+//            (mitcad#2488): those meeting it tangentially, those a tube
+//            joins to it (along edges of the type <theRT>) where the tube
+//            cannot join different offsets, and those around a corner
+//            (a vertex all of whose edges are of the type <theRT>) that
+//            cannot join different offsets (BRepOffset_Offset::
+//            JoinsOffsets); and so on from them.
+//=======================================================================
+
+static void AddFacesJoinedByArc(const BRepOffset_Analyse&                               theAnalyse,
+                                const TopoDS_Face&                                      theFace,
+                                const ChFiDS_TypeOfConcavity                            theRT,
+                                TopoDS_Compound&                                        theCo,
+                                NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher>& theMap)
+{
+  BRep_Builder                   aBB;
+  NCollection_List<TopoDS_Shape> aQueue;
+  theMap.Add(theFace);
+  aQueue.Append(theFace);
+  const auto anAdd = [&](const TopoDS_Shape& theF) {
+    if (theMap.Add(theF))
+    {
+      aBB.Add(theCo, theF);
+      aQueue.Append(theF);
+    }
+  };
+  NCollection_Map<TopoDS_Shape, TopTools_ShapeMapHasher> aCorners;
+  while (!aQueue.IsEmpty())
+  {
+    const TopoDS_Face aF = TopoDS::Face(aQueue.First());
+    aQueue.RemoveFirst();
+    const NCollection_List<TopoDS_Shape>* pLE = theAnalyse.Descendants(aF);
+    if (pLE == nullptr)
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt(*pLE); anIt.More(); anIt.Next())
+    {
+      const TopoDS_Edge&                           anE = TopoDS::Edge(anIt.Value());
+      const NCollection_List<BRepOffset_Interval>& aLI = theAnalyse.Type(anE);
+      const NCollection_List<TopoDS_Shape>&        aLA = theAnalyse.Ancestors(anE);
+      if (aLI.IsEmpty() || aLA.Extent() != 2)
+      {
+        continue;
+      }
+      const ChFiDS_TypeOfConcavity aType = aLI.First().Type();
+      if (aType == ChFiDS_Tangential
+          || (aType == theRT
+              && !BRepOffset_Offset::JoinsOffsets(anE,
+                                                  TopoDS::Face(aLA.First()),
+                                                  TopoDS::Face(aLA.Last()))))
+      {
+        anAdd(aLA.First().IsSame(aF) ? aLA.Last() : aLA.First());
+      }
+    }
+    for (TopExp_Explorer anExpV(aF, TopAbs_VERTEX); anExpV.More(); anExpV.Next())
+    {
+      const TopoDS_Shape& aV = anExpV.Current();
+      if (!aCorners.Add(aV) || !theAnalyse.HasAncestor(aV))
+      {
+        continue;
+      }
+      NCollection_List<TopoDS_Shape> aLE;
+      theAnalyse.Edges(TopoDS::Vertex(aV), theRT, aLE);
+      if (aLE.Extent() < 3 || aLE.Extent() != theAnalyse.Ancestors(aV).Extent())
+      {
+        continue;
+      }
+      NCollection_List<TopoDS_Shape> aLF;
+      for (NCollection_List<TopoDS_Shape>::Iterator anItE(aLE); anItE.More(); anItE.Next())
+      {
+        for (NCollection_List<TopoDS_Shape>::Iterator anItF(theAnalyse.Ancestors(anItE.Value()));
+             anItF.More();
+             anItF.Next())
+        {
+          aLF.Append(anItF.Value());
+        }
+      }
+      if (!BRepOffset_Offset::JoinsOffsets(TopoDS::Vertex(aV), aLF))
+      {
+        for (NCollection_List<TopoDS_Shape>::Iterator anItF(aLF); anItF.More(); anItF.Next())
+        {
+          anAdd(anItF.Value());
+        }
+      }
+    }
+  }
+}
