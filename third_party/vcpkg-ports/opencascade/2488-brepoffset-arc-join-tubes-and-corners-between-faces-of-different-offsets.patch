+//=======================================================================
+// function : IsoCurve3d
+// purpose  : The 3d curve of an end edge of a tube on a given surface
+//            (mitcad#2488) that ComputeCurve3d has not given one: the
+//            iso-curve its pcurve <Curve> runs on (along u or along v).
+//=======================================================================
+
+static void IsoCurve3d(const TopoDS_Edge&               Edge,
+                       const occ::handle<Geom2d_Line>&  Curve,
+                       const occ::handle<Geom_Surface>& Surf,
+                       const double                     Tol)
+{
+  TopLoc_Location Loc;
+  double          f = 0.0, l = 0.0;
+  if (Surf.IsNull() || !BRep_Tool::Curve(Edge, Loc, f, l).IsNull())
+  {
+    return;
+  }
+  if (Curve->Direction().IsEqual(gp::DX2d(), Precision::Angular()))
+  {
+    UpdateEdge(Edge, Surf->VIso(Curve->Location().Y()), TopLoc_Location(), Tol);
+  }
+  else if (Curve->Direction().IsEqual(gp::DY2d(), Precision::Angular()))
+  {
+    UpdateEdge(Edge, Surf->UIso(Curve->Location().X()), TopLoc_Location(), Tol);
+  }
+}
