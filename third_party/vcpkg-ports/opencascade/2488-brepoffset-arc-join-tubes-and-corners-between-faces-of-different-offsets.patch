+//=================================================================================================
+// Tubes and corners between offsets of their own (mitcad#2488)
+//=================================================================================================
+
+namespace
+{
+// The angle within which normals are taken for the same direction.
+constexpr double THE_JOIN_ANGLE = 1.0e-7;
+
+// The normal of <theFace> out of its material at the point of <theEdge> at
+// <theT>.
+bool normalAlongEdge(const TopoDS_Edge& theEdge,
+                     const TopoDS_Face& theFace,
+                     const double       theT,
+                     gp_Dir&            theNormal)
+{
+  double                    aFirst = 0.0, aLast = 0.0;
+  occ::handle<Geom2d_Curve> aPCurve = BRep_Tool::CurveOnSurface(theEdge, theFace, aFirst, aLast);
+  if (aPCurve.IsNull())
+  {
+    return false;
+  }
+  const gp_Pnt2d      aUV = aPCurve->Value(theT);
+  BRepAdaptor_Surface aSurf(theFace, false);
+  gp_Pnt              aP;
+  gp_Vec              aDU, aDV;
+  aSurf.D1(aUV.X(), aUV.Y(), aP, aDU, aDV);
+  const gp_Vec aN = aDU.Crossed(aDV);
+  if (aN.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  theNormal = gp_Dir(aN);
+  if (theFace.Orientation() == TopAbs_REVERSED)
+  {
+    theNormal.Reverse();
+  }
+  return true;
+}
+
+// The normal of <theFace> out of its material at <theVertex>.
+bool normalAtVertex(const TopoDS_Vertex& theVertex, const TopoDS_Face& theFace, gp_Dir& theNormal)
+{
+  const gp_Pnt2d      aUV = BRep_Tool::Parameters(theVertex, theFace);
+  BRepAdaptor_Surface aSurf(theFace, false);
+  gp_Pnt              aP;
+  gp_Vec              aDU, aDV;
+  aSurf.D1(aUV.X(), aUV.Y(), aP, aDU, aDV);
+  const gp_Vec aN = aDU.Crossed(aDV);
+  if (aN.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  theNormal = gp_Dir(aN);
+  if (theFace.Orientation() == TopAbs_REVERSED)
+  {
+    theNormal.Reverse();
+  }
+  return true;
+}
+
+// The section of the tube at the point <theP> of its path between the
+// offset <theD1> of a face of normal <theN1> and <theD2> of a face of normal
+// <theN2>: the conic from theP + theD1 theN1 to theP + theD2 theN2, tangent
+// to both offsets there, the affine image of the circle of the tube of one
+// offset (a rational quadratic arc whose middle pole is where the two
+// tangents meet, weighted as the circle's). Null for faces meeting
+// tangentially.
+occ::handle<Geom_BSplineCurve> tubeSection(const gp_Pnt& theP,
+                                           const gp_Dir& theN1,
+                                           const gp_Dir& theN2,
+                                           const double  theD1,
+                                           const double  theD2)
+{
+  const double aCos  = theN1.Dot(theN2);
+  const double aSin2 = 1.0 - aCos * aCos;
+  if (aSin2 <= THE_JOIN_ANGLE)
+  {
+    return occ::handle<Geom_BSplineCurve>();
+  }
+  const double               aA = (theD1 - aCos * theD2) / aSin2;
+  const double               aB = (theD2 - aCos * theD1) / aSin2;
+  NCollection_Array1<gp_Pnt> aPoles(1, 3);
+  aPoles(1) = theP.Translated(gp_Vec(theN1) * theD1);
+  aPoles(2) = theP.Translated(gp_Vec(theN1) * aA + gp_Vec(theN2) * aB);
+  aPoles(3) = theP.Translated(gp_Vec(theN2) * theD2);
+  NCollection_Array1<double> aWeights(1, 3);
+  aWeights(1) = 1.0;
+  aWeights(2) = std::sqrt(std::max(0.0, (1.0 + aCos) * 0.5));
+  aWeights(3) = 1.0;
+  NCollection_Array1<double> aKnots(1, 2);
+  aKnots(1) = 0.0;
+  aKnots(2) = 1.0;
+  NCollection_Array1<int> aMults(1, 2);
+  aMults(1) = 3;
+  aMults(2) = 3;
+  return new Geom_BSplineCurve(aPoles, aWeights, aKnots, aMults, 2);
+}
+
+// The surface of the tube along <thePath> from the offset <theD1> of
+// <theFace1> to <theD2> of <theFace2>: one parameter along the section (0 on
+// the offset of theFace1, 1 on that of theFace2), the other the parameter of
+// the path. Where the path is a line along which neither face turns, the
+// section extruded along the line (u along the section, v along the path);
+// where it is a circle about whose axis both faces turn, the section
+// revolved about the axis (u the angle, the path's parameter; v along the
+// section). Null elsewhere.
+occ::handle<Geom_Surface> tubeSurface(const TopoDS_Edge& thePath,
+                                      const TopoDS_Face& theFace1,
+                                      const TopoDS_Face& theFace2,
+                                      const double       theD1,
+                                      const double       theD2)
+{
+  TopLoc_Location         aLoc;
+  double                  aFirst = 0.0, aLast = 0.0;
+  occ::handle<Geom_Curve> aCurve = BRep_Tool::Curve(thePath, aLoc, aFirst, aLast);
+  if (aCurve.IsNull() || BRep_Tool::Degenerated(thePath))
+  {
+    return occ::handle<Geom_Surface>();
+  }
+  aCurve = occ::down_cast<Geom_Curve>(aCurve->Transformed(aLoc.Transformation()));
+  const GeomAdaptor_Curve aPath(aCurve, aFirst, aLast);
+  const bool              isLine = aPath.GetType() == GeomAbs_Line;
+  if (!isLine && aPath.GetType() != GeomAbs_Circle)
+  {
+    return occ::handle<Geom_Surface>();
+  }
+  // The normals at the start of the path's parameter (0), checked to be
+  // the same all along it (on a circle, turned about its axis).
+  gp_Ax1 anAxis;
+  if (!isLine)
+  {
+    anAxis = aPath.Circle().Axis();
+  }
+  const auto atZero = [&](const gp_Dir& theN, const double theT) {
+    return isLine ? theN : theN.Rotated(anAxis, -theT);
+  };
+  gp_Dir    aN1, aN2;
+  const int aNbSamples = 5;
+  for (int i = 0; i < aNbSamples; ++i)
+  {
+    const double aT = aFirst + (aLast - aFirst) * i / (aNbSamples - 1);
+    gp_Dir       aS1, aS2;
+    if (!normalAlongEdge(thePath, theFace1, aT, aS1) || !normalAlongEdge(thePath, theFace2, aT, aS2))
+    {
+      return occ::handle<Geom_Surface>();
+    }
+    aS1 = atZero(aS1, aT);
+    aS2 = atZero(aS2, aT);
+    if (i == 0)
+    {
+      aN1 = aS1;
+      aN2 = aS2;
+    }
+    else if (aS1.Angle(aN1) > THE_JOIN_ANGLE || aS2.Angle(aN2) > THE_JOIN_ANGLE)
+    {
+      return occ::handle<Geom_Surface>();
+    }
+  }
+  if (isLine)
+  {
+    const gp_Lin                   aLin     = aPath.Line();
+    occ::handle<Geom_BSplineCurve> aSection = tubeSection(aLin.Location(), aN1, aN2, theD1, theD2);
+    if (aSection.IsNull())
+    {
+      return occ::handle<Geom_Surface>();
+    }
+    return new Geom_RectangularTrimmedSurface(new Geom_SurfaceOfLinearExtrusion(aSection, aLin.Direction()),
+                                              0.0,
+                                              1.0,
+                                              aFirst,
+                                              aLast);
+  }
+  const gp_Circ                  aCirc    = aPath.Circle();
+  occ::handle<Geom_BSplineCurve> aSection = tubeSection(ElCLib::Value(0.0, aCirc), aN1, aN2, theD1, theD2);
+  if (aSection.IsNull())
+  {
+    return occ::handle<Geom_Surface>();
+  }
+  return new Geom_RectangularTrimmedSurface(new Geom_SurfaceOfRevolution(aSection, anAxis),
+                                            aFirst,
+                                            aLast,
+                                            0.0,
+                                            1.0);
+}
+
+// The faces of <theFaces> once each, with their normals at <theVertex>,
+// where they are three square to each other there.
+bool squareCorner(const TopoDS_Vertex&                  theVertex,
+                  const NCollection_List<TopoDS_Shape>& theFaces,
+                  NCollection_List<TopoDS_Shape>&       theOnce,
+                  gp_Dir                                theNormals[3])
+{
+  theOnce.Clear();
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(theFaces); anIt.More(); anIt.Next())
+  {
+    bool isNew = true;
+    for (NCollection_List<TopoDS_Shape>::Iterator anIt2(theOnce); anIt2.More() && isNew; anIt2.Next())
+    {
+      isNew = !anIt2.Value().IsSame(anIt.Value());
+    }
+    if (isNew)
+    {
+      theOnce.Append(anIt.Value());
+    }
+  }
+  if (theOnce.Extent() != 3)
+  {
+    return false;
+  }
+  int i = 0;
+  for (NCollection_List<TopoDS_Shape>::Iterator anIt(theOnce); anIt.More(); anIt.Next(), ++i)
+  {
+    if (!normalAtVertex(theVertex, TopoDS::Face(anIt.Value()), theNormals[i]))
+    {
+      return false;
+    }
+  }
+  for (i = 0; i < 3; ++i)
+  {
+    if (std::abs(theNormals[i].Dot(theNormals[(i + 1) % 3])) > THE_JOIN_ANGLE)
+    {
+      return false;
+    }
+  }
+  return true;
+}
+} // namespace
+
+//=================================================================================================
+
+bool BRepOffset_Offset::JoinsOffsets(const TopoDS_Edge& Path,
+                                     const TopoDS_Face& Face1,
+                                     const TopoDS_Face& Face2)
+{
+  return !tubeSurface(Path, Face1, Face2, 1.0, 2.0).IsNull();
+}
+
+//=================================================================================================
+
+bool BRepOffset_Offset::JoinsOffsets(const TopoDS_Vertex&                  Vertex,
+                                     const NCollection_List<TopoDS_Shape>& Faces)
+{
+  NCollection_List<TopoDS_Shape> aOnce;
+  gp_Dir                         aNormals[3];
+  return squareCorner(Vertex, Faces, aOnce, aNormals);
+}
+
+//=================================================================================================
+
+void BRepOffset_Offset::Init(const TopoDS_Edge& Path,
+                             const TopoDS_Edge& Edge1,
+                             const TopoDS_Edge& Edge2,
+                             const TopoDS_Face& Face1,
+                             const TopoDS_Face& Face2,
+                             const double       Offset1,
+                             const double       Offset2,
+                             const TopoDS_Edge& FirstEdge,
+                             const TopoDS_Edge& LastEdge)
+{
+  if (Offset1 * Offset2 <= 0.0)
+  {
+    throw Standard_ConstructionError("BRepOffset_Offset: a tube between offsets on both sides");
+  }
+  const occ::handle<Geom_Surface> aTube = tubeSurface(Path, Face1, Face2, Offset1, Offset2);
+  if (aTube.IsNull())
+  {
+    throw Standard_ConstructionError("BRepOffset_Offset: no tube between these offsets");
+  }
+  initTube(Path, Edge1, Edge2, Offset1, FirstEdge, LastEdge, false, 1.0e-4, GeomAbs_C1, aTube);
+}
+
+//=================================================================================================
+
+void BRepOffset_Offset::Init(const TopoDS_Vertex&                  Vertex,
+                             const NCollection_List<TopoDS_Shape>& LEdge,
+                             const NCollection_List<TopoDS_Shape>& Faces,
+                             const NCollection_List<double>&       Offsets)
+{
+  if (Faces.Extent() != Offsets.Extent())
+  {
+    throw Standard_ConstructionError("BRepOffset_Offset: a corner's faces without their offsets");
+  }
+  NCollection_List<TopoDS_Shape> aOnce;
+  gp_Dir                         aNormals[3];
+  if (!squareCorner(Vertex, Faces, aOnce, aNormals))
+  {
+    throw Standard_ConstructionError("BRepOffset_Offset: no corner between these offsets");
+  }
+  // The offset of each of the three faces.
+  double aD[3] = {0.0, 0.0, 0.0};
+  int    i     = 0;
+  for (NCollection_List<TopoDS_Shape>::Iterator anOnce(aOnce); anOnce.More(); anOnce.Next(), ++i)
+  {
+    NCollection_List<double>::Iterator anOff(Offsets);
+    for (NCollection_List<TopoDS_Shape>::Iterator aF(Faces); aF.More(); aF.Next(), anOff.Next())
+    {
+      if (aF.Value().IsSame(anOnce.Value()))
+      {
+        aD[i] = anOff.Value();
+      }
+    }
+  }
+  const double aSign = aD[0] > 0.0 ? 1.0 : -1.0;
+  for (i = 0; i < 3; ++i)
+  {
+    if (aD[i] * aSign <= 0.0)
+    {
+      throw Standard_ConstructionError("BRepOffset_Offset: a corner between offsets on both sides");
+    }
+  }
+  // The unit sphere about the vertex, around the eighth of it the corner
+  // takes (along the normals on the side of the offsets; its axis, as the
+  // sphere of the vertex's, away from it), stretched along each normal to
+  // the offset of its face: an ellipsoid through the ends of the tubes,
+  // tangent there to the offsets, as a rational surface (exactly).
+  const gp_Pnt anOrigin = BRep_Tool::Pnt(Vertex);
+  const gp_Vec aMiddle  = (gp_Vec(aNormals[0]) + gp_Vec(aNormals[1]) + gp_Vec(aNormals[2])) * aSign;
+  const gp_Dir aXDir(aMiddle.Reversed());
+  const gp_Dir aZDir(gp_Vec(aXDir).Crossed(gp_Vec(aNormals[0])));
+  occ::handle<Geom_SphericalSurface> aSphere = new Geom_SphericalSurface(gp_Ax3(anOrigin, aZDir, aXDir), 1.0);
+  // The eighth lies within 55 degrees of the middle (u = pi, v = 0).
+  const double aHalf = 1.2;
+  occ::handle<Geom_RectangularTrimmedSurface> aPart =
+    new Geom_RectangularTrimmedSurface(aSphere, M_PI - aHalf, M_PI + aHalf, -aHalf, aHalf);
+  occ::handle<Geom_BSplineSurface> aCorner = GeomConvert::SurfaceToBSplineSurface(aPart);
+  for (int aU = 1; aU <= aCorner->NbUPoles(); ++aU)
+  {
+    for (int aV = 1; aV <= aCorner->NbVPoles(); ++aV)
+    {
+      const gp_Vec aR(anOrigin, aCorner->Pole(aU, aV));
+      gp_Vec       aStretched(0.0, 0.0, 0.0);
+      for (i = 0; i < 3; ++i)
+      {
+        aStretched += gp_Vec(aNormals[i]) * (std::abs(aD[i]) * aR.Dot(gp_Vec(aNormals[i])));
+      }
+      aCorner->SetPole(aU, aV, anOrigin.Translated(aStretched));
+    }
+  }
+  initCorner(Vertex, LEdge, aSign, false, 1.0e-4, GeomAbs_C1, aCorner);
+}
