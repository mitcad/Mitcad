+// At the end of stripe S at vertex Vtx, cut by the face at the end (a
+// corner of one stripe): where the end's SurfData D no longer lies on a
+// face F of the spine's edge at Vtx, its contact having crossed from F
+// onto a face X beside it before the end (the face between narrowing to
+// nothing under the blend, as where a concave rounding rides on over a
+// convex one's blend), F's edge E with the face at the end, from Vtx to a
+// vertex of X, lies under the blend all along and goes: E is cut at both
+// its vertices. (The corner put no point on E, as its contact never
+// reaches F there; E would be left in the face at the end, its wire not
+// closed.)
+static void dropEdgeOfFaceGoneBeforeEnd(TopOpeBRepDS_DataStructure&       DStr,
+                                        const ChFiDS_Map&                 EFMap,
+                                        const ChFiDS_Map&                 VEMap,
+                                        const occ::handle<ChFiDS_Stripe>& S,
+                                        const occ::handle<ChFiDS_SurfData>& D,
+                                        const bool                        isFirst,
+                                        const TopoDS_Vertex&              Vtx)
+{
+  const occ::handle<ChFiDS_Spine>& Sp = S->Spine();
+  if (Sp.IsNull() || D.IsNull() || !VEMap.Contains(Vtx))
+  {
+    return;
+  }
+  const TopoDS_Edge& Es = isFirst ? Sp->Edges(1) : Sp->Edges(Sp->NbEdges());
+  if (!EFMap.Contains(Es) || EFMap(Es).Extent() != 2)
+  {
+    return;
+  }
+  // D's faces (on no curve).
+  TopoDS_Face aDF[2];
+  for (int k = 1; k <= 2; k++)
+  {
+    if (D->Index(k) <= 0 || D->IsOnCurve(k) || DStr.Shape(D->Index(k)).ShapeType() != TopAbs_FACE)
+    {
+      return;
+    }
+    aDF[k - 1] = TopoDS::Face(DStr.Shape(D->Index(k)));
+  }
+  const TopoDS_Face aSF[2] = {TopoDS::Face(EFMap(Es).First()), TopoDS::Face(EFMap(Es).Last())};
+  for (int i = 0; i < 2; i++)
+  {
+    const TopoDS_Face& F = aSF[i];
+    if (F.IsSame(aSF[1 - i]) || F.IsSame(aDF[0]) || F.IsSame(aDF[1]))
+    {
+      continue;
+    }
+    // X: D's face that is not a face of the spine's edge.
+    TopoDS_Face X;
+    for (int k = 0; k < 2; k++)
+    {
+      if (!aDF[k].IsSame(aSF[0]) && !aDF[k].IsSame(aSF[1]))
+      {
+        X = X.IsNull() ? aDF[k] : TopoDS_Face();
+      }
+    }
+    if (X.IsNull())
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator itE(VEMap(Vtx)); itE.More(); itE.Next())
+    {
+      const TopoDS_Edge& E = TopoDS::Edge(itE.Value());
+      if (E.IsSame(Es) || BRep_Tool::Degenerated(E) || !EFMap.Contains(E) || EFMap(E).Extent() != 2)
+      {
+        continue;
+      }
+      const TopoDS_Face F1 = TopoDS::Face(EFMap(E).First());
+      const TopoDS_Face F2 = TopoDS::Face(EFMap(E).Last());
+      if (!(F1.IsSame(F) || F2.IsSame(F)) || F1.IsSame(F2))
+      {
+        continue;
+      }
+      const TopoDS_Face Fe = F1.IsSame(F) ? F2 : F1;
+      if (Fe.IsSame(aSF[1 - i]) || Fe.IsSame(X))
+      {
+        continue;
+      }
+      TopoDS_Vertex V1, V2;
+      TopExp::Vertices(E, V1, V2);
+      const TopoDS_Vertex Vo = V1.IsSame(Vtx) ? V2 : V1;
+      if (Vo.IsNull() || Vo.IsSame(Vtx))
+      {
+        continue;
+      }
+      bool aOnX = false;
+      for (TopExp_Explorer exv(X, TopAbs_VERTEX); exv.More() && !aOnX; exv.Next())
+      {
+        aOnX = exv.Current().IsSame(Vo);
+      }
+      // (And Vo a vertex of the face at the end as well: F, X and Fe meet
+      // there.)
+      bool aOnFe = false;
+      for (TopExp_Explorer exv(Fe, TopAbs_VERTEX); exv.More() && !aOnFe; exv.Next())
+      {
+        aOnFe = exv.Current().IsSame(Vo);
+      }
+      if (!aOnX || !aOnFe)
+      {
+        continue;
+      }
+      const int   IE = DStr.AddShape(E);
+      if (!DStr.ShapeInterferences(IE).IsEmpty())
+      {
+        continue;
+      }
+      TopoDS_Edge anE = E;
+      anE.Orientation(TopAbs_FORWARD);
+      for (TopExp_Explorer exv(anE, TopAbs_VERTEX); exv.More(); exv.Next())
+      {
+        const TopoDS_Vertex& vv = TopoDS::Vertex(exv.Current());
+        DStr.ChangeShapeInterferences(IE).Append(ChFi3d_FilVertexInDS(TopAbs::Reverse(vv.Orientation()),
+                                                                      IE,
+                                                                      DStr.AddShape(vv),
+                                                                      BRep_Tool::Parameter(vv, anE)));
+      }
+    }
+  }
+}
