+// Whether open stripes A and B, one rounding a convex edge and the other a
+// concave one on a face F of both their edges, end at the two vertices of
+// one sharp edge E of F that neither rounds, each the only stripe ending at
+// its vertex, and have contacts on F that cross each other there (inside
+// both): F narrows to E between the two edges, and the concave rounding's
+// ball, rolling on F, reaches the convex rounding's blend before E (a
+// block's side rounded where it stands on a plate and along its sloping
+// top, its front face square to both edges, lower than the two roundings
+// together). The two blends cannot be cut by each other there (they are
+// both tangent to F, on its two sides) and no corner joins them, the ends
+// being apart: they are to be built one after the other, the concave one
+// on the convex one's result, as convexConcaveCrossBeforeEnd's are. The
+// crossing lies within the larger radius of E: the two balls reach each
+// other between the crossing and E. OneStripeAt tells whether a vertex is
+// the end of one stripe only.
+template <typename OneStripeAt>
+static bool convexConcaveCrossBeforeLinkedEnds(const occ::handle<ChFiDS_Stripe>& A,
+                                               const occ::handle<ChFiDS_Stripe>& B,
+                                               const ChFiDS_Map&                 EFMap,
+                                               const ChFiDS_Map&                 VEMap,
+                                               const TopOpeBRepDS_DataStructure& DStr,
+                                               const double                      tol2d,
+                                               const OneStripeAt&                oneStripeAt)
+{
+  const occ::handle<ChFiDS_Spine>& SA = A->Spine();
+  const occ::handle<ChFiDS_Spine>& SB = B->Spine();
+  if (SA.IsNull() || SB.IsNull() || SA->IsClosed() || SB->IsClosed() || SA->IsPeriodic()
+      || SB->IsPeriodic() || A->SetOfSurfData().IsNull() || B->SetOfSurfData().IsNull())
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_FilSpine> aFsA = occ::down_cast<ChFiDS_FilSpine>(SA);
+  const occ::handle<ChFiDS_FilSpine> aFsB = occ::down_cast<ChFiDS_FilSpine>(SB);
+  if (aFsA.IsNull() || aFsB.IsNull() || !aFsA->IsConstant() || !aFsB->IsConstant())
+  {
+    return false;
+  }
+  const double aReach = std::max(aFsA->Radius(), aFsB->Radius());
+  // The type of the edge of a spine on face F.
+  const auto typeOn = [&EFMap](const occ::handle<ChFiDS_Spine>& Sp, const TopoDS_Face& F) {
+    const TopoDS_Edge E = spineEdgeOf(Sp, F);
+    if (E.IsNull() || !EFMap.Contains(E) || EFMap(E).Extent() != 2)
+    {
+      return ChFiDS_Other;
+    }
+    return ChFi3d::DefineConnectType(E,
+                                     TopoDS::Face(EFMap(E).First()),
+                                     TopoDS::Face(EFMap(E).Last()),
+                                     1.e-6,
+                                     false);
+  };
+  // The faces holding a sharp edge that joins an end of A's spine to an end
+  // of B's, neither spine holding it, each end the only stripe's there, and
+  // those edges.
+  NCollection_List<TopoDS_Shape> aFaces, aLinks;
+  for (const TopoDS_Vertex& VA : {SA->FirstVertex(), SA->LastVertex()})
+  {
+    if (!VEMap.Contains(VA) || !oneStripeAt(VA))
+    {
+      continue;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator itE(VEMap(VA)); itE.More(); itE.Next())
+    {
+      const TopoDS_Edge& E = TopoDS::Edge(itE.Value());
+      if (SA->Index(E) != 0 || SB->Index(E) != 0 || BRep_Tool::Degenerated(E) || !EFMap.Contains(E)
+          || EFMap(E).Extent() != 2)
+      {
+        continue;
+      }
+      TopoDS_Vertex V1, V2;
+      TopExp::Vertices(E, V1, V2);
+      const TopoDS_Vertex VO = V1.IsSame(VA) ? V2 : V1;
+      if (VO.IsNull() || VO.IsSame(VA) || !(VO.IsSame(SB->FirstVertex()) || VO.IsSame(SB->LastVertex()))
+          || !oneStripeAt(VO))
+      {
+        continue;
+      }
+      const TopoDS_Face F1 = TopoDS::Face(EFMap(E).First());
+      const TopoDS_Face F2 = TopoDS::Face(EFMap(E).Last());
+      if (F1.IsSame(F2) || ChFi3d::DefineConnectType(E, F1, F2, 1.e-6, false) == ChFiDS_Tangential)
+      {
+        continue;
+      }
+      for (const TopoDS_Face& F : {F1, F2})
+      {
+        const ChFiDS_TypeOfConcavity aTypeA = typeOn(SA, F);
+        const ChFiDS_TypeOfConcavity aTypeB = typeOn(SB, F);
+        if ((aTypeA == ChFiDS_Convex && aTypeB == ChFiDS_Concave)
+            || (aTypeA == ChFiDS_Concave && aTypeB == ChFiDS_Convex))
+        {
+          aFaces.Append(F);
+          aLinks.Append(E);
+        }
+      }
+    }
+  }
+  if (aFaces.IsEmpty())
+  {
+    return false;
+  }
+  for (int ia = 1; ia <= A->SetOfSurfData()->Length(); ia++)
+  {
+    const occ::handle<ChFiDS_SurfData>& a = A->SetOfSurfData()->Value(ia);
+    for (int ib = 1; ib <= B->SetOfSurfData()->Length(); ib++)
+    {
+      const occ::handle<ChFiDS_SurfData>& b = B->SetOfSurfData()->Value(ib);
+      for (int ka = 1; ka <= 2; ka++)
+      {
+        for (int kb = 1; kb <= 2; kb++)
+        {
+          if (a->Index(ka) <= 0 || a->Index(ka) != b->Index(kb) || a->IsOnCurve(ka)
+              || b->IsOnCurve(kb))
+          {
+            continue;
+          }
+          const TopoDS_Shape& F = DStr.Shape(a->Index(ka));
+          // (The joining edges on F.)
+          NCollection_List<TopoDS_Shape> aLinksOnF;
+          {
+            NCollection_List<TopoDS_Shape>::Iterator itL(aLinks);
+            for (NCollection_List<TopoDS_Shape>::Iterator itF(aFaces); itF.More(); itF.Next(), itL.Next())
+            {
+              if (itF.Value().IsSame(F))
+              {
+                aLinksOnF.Append(itL.Value());
+              }
+            }
+          }
+          if (aLinksOnF.IsEmpty())
+          {
+            continue;
+          }
+          const ChFiDS_FaceInterference& FA = a->Interference(ka);
+          const ChFiDS_FaceInterference& FB = b->Interference(kb);
+          if (IsEqual(FA.FirstParameter(), FA.LastParameter())
+              || IsEqual(FB.FirstParameter(), FB.LastParameter()) || FA.PCurveOnFace().IsNull()
+              || FB.PCurveOnFace().IsNull())
+          {
+            continue;
+          }
+          Geom2dAdaptor_Curve aCA(FA.PCurveOnFace(),
+                                  std::min(FA.FirstParameter(), FA.LastParameter()),
+                                  std::max(FA.FirstParameter(), FA.LastParameter()));
+          Geom2dAdaptor_Curve aCB(FB.PCurveOnFace(),
+                                  std::min(FB.FirstParameter(), FB.LastParameter()),
+                                  std::max(FB.FirstParameter(), FB.LastParameter()));
+          Geom2dInt_GInter    anInter(aCA, aCB, tol2d, Precision::PConfusion());
+          if (!anInter.IsDone())
+          {
+            continue;
+          }
+          // (A crossing inside both contacts, not where one ends.)
+          const double aTolA = 1.e-6 * (aCA.LastParameter() - aCA.FirstParameter());
+          const double aTolB = 1.e-6 * (aCB.LastParameter() - aCB.FirstParameter());
+          for (int ip = 1; ip <= anInter.NbPoints(); ip++)
+          {
+            const IntRes2d_IntersectionPoint& aP    = anInter.Point(ip);
+            const IntRes2d_TypeTrans          aType = aP.TransitionOfFirst().TransitionType();
+            if ((aType == IntRes2d_In || aType == IntRes2d_Out)
+                && aP.ParamOnFirst() > aCA.FirstParameter() + aTolA
+                && aP.ParamOnFirst() < aCA.LastParameter() - aTolA
+                && aP.ParamOnSecond() > aCB.FirstParameter() + aTolB
+                && aP.ParamOnSecond() < aCB.LastParameter() - aTolB)
+            {
+              const gp_Pnt PA = BRep_Tool::Surface(TopoDS::Face(F))->Value(aP.Value().X(), aP.Value().Y());
+              // (Its distance from the nearest such edge, or from that
+              // edge's nearer vertex where its foot lies beyond the edge.)
+              double aFromE = RealLast();
+              for (NCollection_List<TopoDS_Shape>::Iterator itL(aLinksOnF); itL.More(); itL.Next())
+              {
+                const TopoDS_Edge& E = TopoDS::Edge(itL.Value());
+                aFromE               = std::min(aFromE, distanceToEdge(PA, E));
+                for (TopExp_Explorer exv(E, TopAbs_VERTEX); exv.More(); exv.Next())
+                {
+                  aFromE = std::min(aFromE, PA.Distance(BRep_Tool::Pnt(TopoDS::Vertex(exv.Current()))));
+                }
+              }
+              if (aFromE < aReach)
+              {
+                return true;
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+  return false;
+}
