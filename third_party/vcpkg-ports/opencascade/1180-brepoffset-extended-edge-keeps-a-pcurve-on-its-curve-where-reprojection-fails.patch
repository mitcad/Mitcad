   return true;
 }
 
+//=======================================================================
+// function : PCurveFollowsCurve
+// purpose  : Whether thePC on theS lies on theC within theTol from theF to
+//            theL at the same parameters (an edge's curves), sampled
+//            (mitcad#1201).
+//=======================================================================
+static bool PCurveFollowsCurve(const occ::handle<Geom2d_Curve>& thePC,
+                               const occ::handle<Geom_Surface>& theS,
+                               const occ::handle<Geom_Curve>&   theC,
+                               const double                     theF,
+                               const double                     theL,
+                               const double                     theTol)
+{
+  if (thePC.IsNull() || theS.IsNull() || theC.IsNull() || !(theF < theL))
+  {
+    return false;
+  }
+  const int aNb = 32;
+  for (int i = 0; i <= aNb; i++)
+  {
+    const double   aT  = theF + (theL - theF) * i / aNb;
+    const gp_Pnt2d aUV = thePC->Value(aT);
+    if (theS->Value(aUV.X(), aUV.Y()).Distance(theC->Value(aT)) > theTol)
+    {
+      return false;
+    }
+  }
+  return true;
+}
