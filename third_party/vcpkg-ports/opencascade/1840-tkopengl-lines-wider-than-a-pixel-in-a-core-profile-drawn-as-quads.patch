+//! Return the number of vertices the geometry shader takes in for the given program bits:
+//! 2 (a line segment) for wide lines, 3 (a triangle) for mesh edges, 0 without a geometry stage.
+static int geomInputVerts(int theBits)
+{
+  if ((theBits & Graphic3d_ShaderFlags_WideLine) != 0)
+  {
+    return 2;
+  }
+  return (theBits & Graphic3d_ShaderFlags_NeedsGeomShader) != 0 ? 3 : 0;
+}
+
+//! Prepare GLSL source passing the outputs of the vertex stage, which the fragment stage reads,
+//! through the geometry stage for the given input vertex.
+static TCollection_AsciiString passStageInOutsSrc(
+  const Graphic3d_ShaderObject::ShaderVariableList& theStageInOuts,
+  const TCollection_AsciiString&                    theVertIndex)
+{
+  TCollection_AsciiString aSrc;
+  for (Graphic3d_ShaderObject::ShaderVariableList::Iterator aVarListIter(theStageInOuts);
+       aVarListIter.More();
+       aVarListIter.Next())
+  {
+    if (aVarListIter.Value().Stages == (Graphic3d_TOS_VERTEX | Graphic3d_TOS_FRAGMENT))
+    {
+      const TCollection_AsciiString aVarName = aVarListIter.Value().Name.Token(" ", 2);
+      // an array is copied whole
+      const TCollection_AsciiString aVarName2 =
+        aVarName.Value(aVarName.Length()) == ']' ? aVarName.Token("[", 1) : aVarName;
+      aSrc += TCollection_AsciiString() + EOL "  geomOut." + aVarName2 + " = geomIn["
+              + theVertIndex + "]." + aVarName2 + ";";
+    }
+  }
+  return aSrc;
+}
+
+//! Prepare GLSL source of the geometry shader drawing a line segment occLineWidth pixels wide,
+//! for a context whose rasterizer draws lines only 1 pixel wide (an OpenGL core profile).
+//! The segment, clipped by the near plane, becomes a screen-space quad of that width, extended
+//! by half the width at each end so that the segments of a polyline join without gaps. The quad
+//! keeps the depth of the segment along its middle (its z and w are the segment's), faces the
+//! viewer, and passes on the stage outputs of the segment's ends; the fragment stage of the
+//! line program (colour, stipple pattern from gl_FragCoord, clipping) runs on it unchanged.
+static TCollection_AsciiString prepareWideLineGeomSrc(
+  Graphic3d_ShaderObject::ShaderVariableList&       theUnifoms,
+  const Graphic3d_ShaderObject::ShaderVariableList& theStageInOuts)
+{
+  theUnifoms.Append(
+    Graphic3d_ShaderObject::ShaderVariable("vec4 occViewport", Graphic3d_TOS_GEOMETRY));
+  theUnifoms.Append(
+    Graphic3d_ShaderObject::ShaderVariable("float occLineWidth", Graphic3d_TOS_GEOMETRY));
+
+  TCollection_AsciiString aSrc =
+    EOL "void main()" EOL "{" EOL "  vec4 aPos0 = gl_in[0].gl_Position;" EOL
+        "  vec4 aPos1 = gl_in[1].gl_Position;"
+    // distances to the near clipping plane (z = -w); a point behind it has no window position
+    EOL "  float aNear0 = aPos0.z + aPos0.w;" EOL "  float aNear1 = aPos1.z + aPos1.w;" EOL
+        "  if (aNear0 < 0.0 && aNear1 < 0.0)" EOL "  {" EOL "    return;" EOL "  }" EOL
+        "  if (aNear0 < 0.0)" EOL "  {" EOL
+        "    aPos0 = mix (aPos0, aPos1, aNear0 / (aNear0 - aNear1));" EOL "  }" EOL
+        "  else if (aNear1 < 0.0)" EOL "  {" EOL
+        "    aPos1 = mix (aPos1, aPos0, aNear1 / (aNear1 - aNear0));" EOL "  }"
+    // the direction in window pixels; half the width along and across it in NDC units
+    EOL "  vec2 aHalfView = 0.5 * occViewport.zw;" EOL
+        "  vec2 aDir = (aPos1.xy / aPos1.w - aPos0.xy / aPos0.w) * aHalfView;" EOL
+        "  float aLen = length (aDir);" EOL
+        "  aDir = aLen > 0.0 ? aDir / aLen : vec2 (1.0, 0.0);" EOL
+        "  vec2 anAlong  = aDir * (0.5 * occLineWidth) / aHalfView;" EOL
+        "  vec2 anAcross = vec2 (-aDir.y, aDir.x) * (0.5 * occLineWidth) / aHalfView;";
+  // counter-clockwise in window coordinates: the left side of the start first
+  const char* const aCorners[4] = {
+    "  gl_Position = aPos0 + vec4 ((anAcross - anAlong) * aPos0.w, 0.0, 0.0);",
+    "  gl_Position = aPos0 - vec4 ((anAcross + anAlong) * aPos0.w, 0.0, 0.0);",
+    "  gl_Position = aPos1 + vec4 ((anAcross + anAlong) * aPos1.w, 0.0, 0.0);",
+    "  gl_Position = aPos1 - vec4 ((anAcross - anAlong) * aPos1.w, 0.0, 0.0);"};
+  for (int aCornerIter = 0; aCornerIter < 4; ++aCornerIter)
+  {
+    const TCollection_AsciiString aVertIndex(aCornerIter / 2);
+    aSrc += passStageInOutsSrc(theStageInOuts, aVertIndex);
+    aSrc += TCollection_AsciiString() + EOL + aCorners[aCornerIter] + EOL "  EmitVertex();";
+  }
+  aSrc += EOL "  EndPrimitive();" EOL "}";
+  return aSrc;
+}
