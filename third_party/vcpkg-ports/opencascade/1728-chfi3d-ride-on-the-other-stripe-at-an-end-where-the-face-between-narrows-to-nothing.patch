+    // and their faces by the orientation found against the support's face
+    // (StoreData), the opposite of the one their curves so need.)
+    R1->ChangeOrientation() = TopAbs::Reverse(R1->Orientation());
+    R2->ChangeOrientation() = TopAbs::Reverse(R2->Orientation());
