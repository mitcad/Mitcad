+// The exact last section of a ride whose contact on its support comes
+// down to the support's line CO on face Fp (the other stripe's contact
+// with the face at the end), the support tangent to Fp along it: a fold
+// of the walk, the contact running to CO like a square root of the guide's
+// parameter, so that the walk stops short of it (by D with D^2 about
+// 2 (R1 - R) e over a blend of radius R1, the ball e above Fp). The
+// ball of radius R tangent to the top ST and to Fp at a point Foot of CO
+// (parameters T1 to T2, from T0), on the sides of both the walk's ball
+// (centre C0) is on: its centre Foot +- R n (n Fp's outward normal) at R
+// from ST. W: the
+// guide's parameter of its section (from W0). False where no
+// such point is found within MaxGap of Foot0, the walk's last contact.
+static bool rideFoldEnd(const occ::handle<Geom_Curve>&     CO,
+                        const double                       T1,
+                        const double                       T2,
+                        const double                       T0,
+                        const TopoDS_Face&                 Fp,
+                        const occ::handle<Geom_Surface>&   ST,
+                        const gp_Pnt&                      C0,
+                        const gp_Pnt&                      Foot0,
+                        const double                       R,
+                        const occ::handle<ChFiDS_ElSpine>& Guide,
+                        const double                       W0,
+                        const double                       MaxGap,
+                        double&                            T,
+                        gp_Pnt&                            Foot,
+                        gp_Pnt&                            OnTop,
+                        gp_Pnt2d&                          UVTop,
+                        double&                            W)
+{
+  // The ball's centre over CO(t), and its signed distance from ST less R
+  // (the side of C0).
+  double     aSide = 0.;
+  // (The ball on the side of Fp its centre C0 is: inside the solid for a
+  // convex rider.)
+  gp_Dir aN0;
+  if (!outwardNormalAt(Fp, Foot0, aN0))
+  {
+    return false;
+  }
+  const double aSideP = gp_Vec(Foot0, C0).Dot(gp_Vec(aN0)) >= 0. ? 1. : -1.;
+  const auto offTop = [&](const gp_Pnt& C, gp_Pnt& Q, double& u, double& v, double& d) {
+    GeomAPI_ProjectPointOnSurf aPr(C, ST);
+    if (aPr.NbPoints() == 0)
+    {
+      return false;
+    }
+    aPr.LowerDistanceParameters(u, v);
+    gp_Vec du, dv;
+    ST->D1(u, v, Q, du, dv);
+    const gp_Vec n = du.Crossed(dv);
+    if (n.Magnitude() <= gp::Resolution())
+    {
+      return false;
+    }
+    d = gp_Vec(Q, C).Dot(n.Normalized());
+    return true;
+  };
+  const auto centreAt = [&](const double t, gp_Pnt& C) {
+    const gp_Pnt F = CO->Value(t);
+    gp_Dir       n;
+    if (!outwardNormalAt(Fp, F, n))
+    {
+      return false;
+    }
+    C = F.Translated(gp_Vec(n) * (aSideP * R));
+    return true;
+  };
+  {
+    gp_Pnt Q;
+    double u = 0., v = 0., d = 0.;
+    if (!offTop(C0, Q, u, v, d) || std::abs(d) <= gp::Resolution())
+    {
+      return false;
+    }
+    aSide = d > 0. ? 1. : -1.;
+  }
+  const auto g = [&](const double t, double& val) {
+    gp_Pnt C, Q;
+    double u = 0., v = 0., d = 0.;
+    if (!centreAt(t, C) || !offTop(C, Q, u, v, d))
+    {
+      return false;
+    }
+    val = aSide * d - R;
+    return true;
+  };
+  // A change of sign of g from T0 outwards, then bisection.
+  double gT0 = 0.;
+  if (!g(T0, gT0))
+  {
+    return false;
+  }
+  const double h  = (T2 - T1) / 400.;
+  double       ta = T0, tb = T0, ga = gT0, gb = gT0;
+  bool         aFound = std::abs(gT0) <= Precision::Confusion();
+  for (int i = 1; i <= 400 && !aFound; i++)
+  {
+    for (const double s : {1., -1.})
+    {
+      const double t = T0 + s * i * h;
+      if (aFound || t < T1 - Precision::PConfusion() || t > T2 + Precision::PConfusion())
+      {
+        continue;
+      }
+      const double tp = T0 + s * (i - 1) * h;
+      double       gPrev = 0., gt = 0.;
+      if (g(tp, gPrev) && g(t, gt) && gPrev * gt <= 0.)
+      {
+        ta     = tp;
+        tb     = t;
+        ga     = gPrev;
+        gb     = gt;
+        aFound = true;
+      }
+    }
+  }
+  if (!aFound)
+  {
+    return false;
+  }
+  T = ta;
+  for (int it = 0; it < 80 && std::abs(tb - ta) > Precision::PConfusion() * 1.e-3; it++)
+  {
+    const double tm = 0.5 * (ta + tb);
+    double       gm = 0.;
+    if (!g(tm, gm))
+    {
+      return false;
+    }
+    if ((gm <= 0.) == (ga <= 0.))
+    {
+      ta = tm;
+      ga = gm;
+    }
+    else
+    {
+      tb = tm;
+      gb = gm;
+    }
+    T = std::abs(ga) <= std::abs(gb) ? ta : tb;
+  }
+  Foot = CO->Value(T);
+  if (Foot.Distance(Foot0) > MaxGap)
+  {
+    return false;
+  }
+  gp_Pnt C, Q;
+  double u = 0., v = 0., d = 0.;
+  if (!centreAt(T, C) || !offTop(C, Q, u, v, d))
+  {
+    return false;
+  }
+  OnTop = Q;
+  UVTop.SetCoord(u, v);
+  // The guide's section through the contacts' middle (the blend's section
+  // condition, BlendFunc_ConstRad).
+  const gp_Pnt M((Foot.XYZ() + OnTop.XYZ()) * 0.5);
+  W = W0;
+  for (int it = 0; it < 30; it++)
+  {
+    gp_Pnt P;
+    gp_Vec D;
+    Guide->D1(W, P, D);
+    const double dd = D.SquareMagnitude();
+    if (dd <= gp::Resolution())
+    {
+      return false;
+    }
+    const double dw = gp_Vec(P, M).Dot(D) / dd;
+    W += dw;
+    if (std::abs(dw) <= Precision::PConfusion() * 1.e-3)
+    {
+      break;
+    }
+  }
+  return true;
+}
+
+namespace
+{
+// A ride's function with one of the support's parameters given and the
+// guide's parameter free: Y = (W, the other three of X).
+class RideAcrossFunction : public math_FunctionSetWithDerivatives
+{
+public:
+  RideAcrossFunction(Blend_Function& theFunc, const int theFixed)
+      : myFunc(theFunc),
+        myFixed(theFixed),
+        myValue(0.)
+  {
+  }
+
+  void SetFixed(const double theValue) { myValue = theValue; }
+
+  int NbVariables() const override { return 4; }
+
+  int NbEquations() const override { return 4; }
+
+  void ToX(const math_Vector& Y, math_Vector& X) const
+  {
+    int j = 2;
+    for (int k = 1; k <= 4; k++)
+    {
+      X(k) = k == myFixed ? myValue : Y(j++);
+    }
+  }
+
+  bool Value(const math_Vector& Y, math_Vector& F) override
+  {
+    math_Vector X(1, 4);
+    ToX(Y, X);
+    myFunc.Set(Y(1));
+    return myFunc.Value(X, F);
+  }
+
+  bool Derivatives(const math_Vector& Y, math_Matrix& D) override
+  {
+    math_Vector F(1, 4);
+    return Values(Y, F, D);
+  }
+
+  bool Values(const math_Vector& Y, math_Vector& F, math_Matrix& D) override
+  {
+    math_Vector X(1, 4), Fp(1, 4), Fm(1, 4);
+    math_Matrix DX(1, 4, 1, 4);
+    ToX(Y, X);
+    // (The guide's parameter by central differences: the function's own
+    // derivatives are in X only.)
+    const double h = 1.e-7 * std::max(1., std::abs(Y(1)));
+    myFunc.Set(Y(1) + h);
+    if (!myFunc.Value(X, Fp))
+    {
+      return false;
+    }
+    myFunc.Set(Y(1) - h);
+    if (!myFunc.Value(X, Fm))
+    {
+      return false;
+    }
+    myFunc.Set(Y(1));
+    if (!myFunc.Values(X, F, DX))
+    {
+      return false;
+    }
+    for (int i = 1; i <= 4; i++)
+    {
+      D(i, 1) = (Fp(i) - Fm(i)) / (2. * h);
+      int j   = 2;
+      for (int k = 1; k <= 4; k++)
+      {
+        if (k != myFixed)
+        {
+          D(i, j++) = DX(i, k);
+        }
+      }
+    }
+    return true;
+  }
+
+private:
+  Blend_Function& myFunc;
+  int             myFixed;
+  double          myValue;
+};
+
+// The sections of a ride for its approximation, by a parameter s that the
+// support's parameter Fixed follows linearly (s = Sign (X(Fixed) - X0)), not
+// by the guide's: where the ride ends on a fold of its walk (its contact on
+// the support running to the support's edge like a square root of the guide's
+// parameter, the guide's parameter turning back on the way, mitcad#2075) the
+// sections are regular in s. The line's points carry s; their guide's
+// parameters are kept apart. Only D0: the approximation is C0 between its
+// spans.
+class RideAcrossSweep : public Approx_SweepFunction
+{
+public:
+  RideAcrossSweep(const occ::handle<BRepBlend_AppFunc>&   theInner,
+                  Blend_Function&                         theFunc,
+                  const occ::handle<Adaptor3d_Surface>&   theS1,
+                  const occ::handle<Adaptor3d_Surface>&   theS2,
+                  const occ::handle<BRepBlend_Line>&      theLine,
+                  const NCollection_Sequence<double>&     theW,
+                  const int                               theFixed,
+                  const double                            theX0,
+                  const double                            theSign,
+                  const double                            theTol3d)
+      : myInner(theInner),
+        myFunc(theFunc),
+        myS1(theS1),
+        myS2(theS2),
+        myLine(theLine),
+        myW(theW),
+        myAcross(theFunc, theFixed),
+        myFixed(theFixed),
+        myX0(theX0),
+        mySign(theSign),
+        myTol(1, 4)
+  {
+    math_Vector aTolX(1, 4);
+    myFunc.GetTolerance(aTolX, theTol3d);
+    myTol(1) = 1.e-10;
+    int j    = 2;
+    for (int k = 1; k <= 4; k++)
+    {
+      if (k != myFixed)
+      {
+        myTol(j++) = aTolX(k);
+      }
+    }
+    myWLo = myWHi = myW.First();
+    for (int i = 1; i <= myW.Length(); i++)
+    {
+      myWLo = std::min(myWLo, myW.Value(i));
+      myWHi = std::max(myWHi, myW.Value(i));
+    }
+  }
+
+  bool D0(const double                  Param,
+          const double                  /*First*/,
+          const double                  /*Last*/,
+          NCollection_Array1<gp_Pnt>&   Poles,
+          NCollection_Array1<gp_Pnt2d>& Poles2d,
+          NCollection_Array1<double>&   Weights) override
+  {
+    Blend_Point P;
+    if (!SearchPoint(Param, P))
+    {
+      return false;
+    }
+    myFunc.Set(P.Parameter());
+    myFunc.Section(P, Poles, Poles2d, Weights);
+    return true;
+  }
+
+  bool D1(const double,
+          const double,
+          const double,
+          NCollection_Array1<gp_Pnt>&,
+          NCollection_Array1<gp_Vec>&,
+          NCollection_Array1<gp_Pnt2d>&,
+          NCollection_Array1<gp_Vec2d>&,
+          NCollection_Array1<double>&,
+          NCollection_Array1<double>&) override
+  {
+    return false;
+  }
+
+  bool D2(const double,
+          const double,
+          const double,
+          NCollection_Array1<gp_Pnt>&,
+          NCollection_Array1<gp_Vec>&,
+          NCollection_Array1<gp_Vec>&,
+          NCollection_Array1<gp_Pnt2d>&,
+          NCollection_Array1<gp_Vec2d>&,
+          NCollection_Array1<gp_Vec2d>&,
+          NCollection_Array1<double>&,
+          NCollection_Array1<double>&,
+          NCollection_Array1<double>&) override
+  {
+    return false;
+  }
+
+  int Nb2dCurves() const override { return myInner->Nb2dCurves(); }
+
+  void SectionShape(int& NbPoles, int& NbKnots, int& Degree) const override
+  {
+    myInner->SectionShape(NbPoles, NbKnots, Degree);
+  }
+
+  void Knots(NCollection_Array1<double>& TKnots) const override { myInner->Knots(TKnots); }
+
+  void Mults(NCollection_Array1<int>& TMults) const override { myInner->Mults(TMults); }
+
+  bool IsRational() const override { return myInner->IsRational(); }
+
+  int NbIntervals(const GeomAbs_Shape) const override { return 1; }
+
+  void Intervals(NCollection_Array1<double>& T, const GeomAbs_Shape) const override
+  {
+    T(T.Lower())     = myLine->Point(1).Parameter();
+    T(T.Lower() + 1) = myLine->Point(myLine->NbPoints()).Parameter();
+  }
+
+  void SetInterval(const double, const double) override {}
+
+  void Resolution(const int Index, const double Tol, double& TolU, double& TolV) const override
+  {
+    myInner->Resolution(Index, Tol, TolU, TolV);
+  }
+
+  void GetTolerance(const double                BoundTol,
+                    const double                SurfTol,
+                    const double                AngleTol,
+                    NCollection_Array1<double>& Tol3d) const override
+  {
+    myInner->GetTolerance(BoundTol, SurfTol, AngleTol, Tol3d);
+  }
+
+  void SetTolerance(const double Tol3d, const double Tol2d) override { myInner->SetTolerance(Tol3d, Tol2d); }
+
+  gp_Pnt BarycentreOfSurf() const override { return myInner->BarycentreOfSurf(); }
+
+  double MaximalSection() const override { return myInner->MaximalSection(); }
+
+  void GetMinimalWeight(NCollection_Array1<double>& Weigths) const override
+  {
+    myInner->GetMinimalWeight(Weigths);
+  }
+
+private:
+  // The section at s, from the line's points around it.
+  bool SearchPoint(const double s, Blend_Point& P)
+  {
+    const int n = myLine->NbPoints();
+    if (s < myLine->Point(1).Parameter() - Precision::PConfusion()
+        || s > myLine->Point(n).Parameter() + Precision::PConfusion())
+    {
+      return false;
+    }
+    int i = 1;
+    while (i < n - 1 && myLine->Point(i + 1).Parameter() < s)
+    {
+      i++;
+    }
+    const Blend_Point& Pa = myLine->Point(i);
+    const Blend_Point& Pb = myLine->Point(i + 1);
+    const double       sa = Pa.Parameter(), sb = Pb.Parameter();
+    math_Vector        Xa(1, 4), Xb(1, 4), Y(1, 4), Ylo(1, 4), Yhi(1, 4), X(1, 4), Xlo(1, 4), Xhi(1, 4);
+    Pa.ParametersOnS1(Xa(1), Xa(2));
+    Pa.ParametersOnS2(Xa(3), Xa(4));
+    Pb.ParametersOnS1(Xb(1), Xb(2));
+    Pb.ParametersOnS2(Xb(3), Xb(4));
+    const double f  = sb > sa ? std::min(1., std::max(0., (s - sa) / (sb - sa))) : 0.;
+    const double wa = myW.Value(i), wb = myW.Value(i + 1);
+    if (f <= 0. || f >= 1.)
+    {
+      const Blend_Point& Pe = f <= 0. ? Pa : Pb;
+      P                     = Pe;
+      P.SetParameter(f <= 0. ? wa : wb);
+      return true;
+    }
+    Y(1)  = wa + (wb - wa) * f;
+    int j = 2;
+    for (int k = 1; k <= 4; k++)
+    {
+      if (k != myFixed)
+      {
+        Y(j++) = Xa(k) + (Xb(k) - Xa(k)) * f;
+      }
+    }
+    myFunc.Set(Y(1));
+    myFunc.GetBounds(Xlo, Xhi);
+    const double aMargin = 0.1 * (myWHi - myWLo) + Precision::PConfusion();
+    Ylo(1)               = myWLo - aMargin;
+    Yhi(1)               = myWHi + aMargin;
+    j                    = 2;
+    for (int k = 1; k <= 4; k++)
+    {
+      if (k != myFixed)
+      {
+        Ylo(j)   = Xlo(k);
+        Yhi(j++) = Xhi(k);
+      }
+    }
+    myAcross.SetFixed(myX0 + mySign * s);
+    math_FunctionSetRoot aSolver(myAcross, myTol, 50);
+    aSolver.Perform(myAcross, Y, Ylo, Yhi);
+    if (!aSolver.IsDone())
+    {
+      return false;
+    }
+    math_Vector R(1, 4);
+    aSolver.Root(R);
+    myAcross.ToX(R, X);
+    myFunc.Set(R(1));
+    if (!myFunc.IsSolution(X, myTol(2)))
+    {
+      return false;
+    }
+    P.SetValue(myS1->Value(X(1), X(2)), myS2->Value(X(3), X(4)), R(1), X(1), X(2), X(3), X(4));
+    return true;
+  }
+
+  occ::handle<BRepBlend_AppFunc>  myInner;
+  Blend_Function&                 myFunc;
+  occ::handle<Adaptor3d_Surface>  myS1;
+  occ::handle<Adaptor3d_Surface>  myS2;
+  occ::handle<BRepBlend_Line>     myLine;
+  NCollection_Sequence<double>    myW;
+  RideAcrossFunction              myAcross;
+  int                             myFixed;
+  double                          myX0;
+  double                          mySign;
+  double                          myWLo;
+  double                          myWHi;
+  math_Vector                     myTol;
+};
+} // namespace
