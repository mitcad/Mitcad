Mitcad's patch to OCCT 8.0.1, under OCCT's licence:
SPDX-License-Identifier: LGPL-2.1-only WITH OCCT-exception-1.0

Fillets: a rounding that ends where the face between it and a larger
rounding at its end vertex narrows to nothing rides on from there over
that rounding's blend, and the face at the end cuts both (mitcad#1926).

A U-shaped fin standing on a plate, its arms' tops sloping down into the
plate, its outer foot rounded with 3 and its top's edges with 0.5: at an
outer arm end the top's 0.5 (the rider B, between the top and the arm's
outer wall) and the foot's 3 (A, between the wall and the plate) meet at
the vertex where the top, the wall and the plate meet. The wall is lower
than 3 there: A's end runs on over the wall's plane and the top cuts it,
ending in a point on the top's edge with the plate run on past the vertex
(WalkedCutToEnd, patch 1700). B's contact on the wall crosses A's before
the vertex; the corner then went to PerformMoreThreeCorner, which met an
edge twice and failed (patch 1711).

- PerformRideOnStripeAtEnd, tried for a corner of two stripes before
  PerformMoreThreeCorner's last chance: B the smaller constant rounding,
  A ending in a point short of the vertex (a free boundary), B ending at
  the vertex with a width. Where B's contact on a face F crosses A's
  contact on F once, inside both (in the SurfDatas within three of the
  vertex), at W, B is cut at W's section and walked on between its other
  face (the top, its surface run on past its edges) and A's blend as a
  support (RideOnCornerWalk, patch 1727), SurfData by SurfData of A's
  from W to the vertex: each up to its end there (J), the last until its
  contact comes down to A's contact with the face at the end (P_foot,
  where the walk stops on the support's bound).
- A's SurfData through W is split there; its piece towards the vertex and
  the SurfDatas after it hold B's lines on their side under B, A ends in
  the point P_foot (its contact with the face at the end trimmed there).
  B's SurfDatas between W and the vertex go (their faces are generated by
  no edge); its walked pieces follow its SurfData up to W, the last cut
  by the face at the end section by section (ChFi3d_CutBySections) from
  P_top, where B's other contact meets that face, to P_foot.
- The top's edge with the face at the end, run on past the vertex to A's
  old end point by WalkedCutToEnd, is run on to P_top instead; the top's
  edge with the face between at the vertex and that face's edge with the
  face at the end go (cut at the vertex).
- The stripes' points at W, at each J and at P_foot are made one once
  they are in the data structure (as a part ride's ends); B goes into it
  after A, and a line shared against a stripe's way is turned
  (turnRidesAgainst); B's new pieces' faces are turned, as 1727's.

diff --git a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.cxx b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.cxx
index 41ebe0fd..9dccef06 100644
--- a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.cxx
+++ b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_Builder.cxx
@@ -4955,6 +4955,627 @@ bool ChFi3d_Builder::PerformRideOnCornerAtEnd(const int Index)
   return false;
 }
 
+bool ChFi3d_Builder::PerformRideOnStripeAtEnd(const int Index)
+{
+  const TopoDS_Vertex&        Vtx  = myVDataMap.FindKey(Index);
+  TopOpeBRepDS_DataStructure& DStr = myDS->ChangeDS();
+  if (myVDataMap(Index).Extent() != 2)
+  {
+    return false;
+  }
+  occ::handle<ChFiDS_Stripe> aS[2];
+  {
+    NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator It(myVDataMap(Index));
+    aS[0] = It.Value();
+    It.Next();
+    aS[1] = It.Value();
+  }
+  if (aS[0] == aS[1])
+  {
+    return false;
+  }
+  const gp_Pnt PV = BRep_Tool::Pnt(Vtx);
+  for (int r = 0; r < 2; r++)
+  {
+    const occ::handle<ChFiDS_Stripe>&  B    = aS[r];
+    const occ::handle<ChFiDS_Stripe>&  A    = aS[1 - r];
+    const occ::handle<ChFiDS_FilSpine> aFsB = occ::down_cast<ChFiDS_FilSpine>(B->Spine());
+    if (aFsB.IsNull() || !aFsB->IsConstant() || A->Spine().IsNull() || A->SetOfSurfData().IsNull()
+        || B->SetOfSurfData().IsNull() || myRideStripes.Contains(B) || myRideOn.Contains(B)
+        || myRideStripes.Contains(A) || myRideOn.Contains(A))
+    {
+      continue;
+    }
+    // (The rider the smaller rounding; A ending in a point short of the
+    // vertex, cut by the face at the end that grows out to it, as a walked
+    // end WalkedCutToEnd runs on over a flat stretch's plane leaves it; B
+    // ending at the vertex with a width.)
+    const occ::handle<ChFiDS_FilSpine> aFsA = occ::down_cast<ChFiDS_FilSpine>(A->Spine());
+    if (aFsA.IsNull() || !aFsA->IsConstant() || aFsB->Radius() >= aFsA->Radius())
+    {
+      continue;
+    }
+    int  iBe = 0, iAe = 0;
+    bool fB = false, fA = false;
+    if (endDataAt(Vtx, B, iBe, fB).IsNull() || endDataAt(Vtx, A, iAe, fA).IsNull()
+        || A->Spine()->Status(fA) != ChFiDS_FreeBoundary)
+    {
+      continue;
+    }
+    {
+      const occ::handle<ChFiDS_SurfData>& aDA = A->SetOfSurfData()->Value(iAe);
+      const occ::handle<ChFiDS_SurfData>& aDB = B->SetOfSurfData()->Value(iBe);
+      if (!aDA->Vertex(fA, 1).Point().IsEqual(aDA->Vertex(fA, 2).Point(), tolapp3d)
+          || aDA->Vertex(fA, 1).Point().Distance(PV) <= 10. * tolapp3d
+          || aDB->Vertex(fB, 1).Point().IsEqual(aDB->Vertex(fB, 2).Point(), tolapp3d))
+      {
+        continue;
+      }
+    }
+    const int nB = B->SetOfSurfData()->Length(), nA = A->SetOfSurfData()->Length();
+    // Where B's contact on a face F crosses A's contact on F, once, inside
+    // both: the SurfDatas nearest the vertex first (within three of it).
+    int    ib = 0, ia = 0, onB = 0, onA = 0;
+    double tB = 0., tA = 0.;
+    for (int db = 0; db < 3 && ib == 0; db++)
+    {
+      const int jb = fB ? iBe + db : iBe - db;
+      if (jb < 1 || jb > nB)
+      {
+        break;
+      }
+      const occ::handle<ChFiDS_SurfData>& Db = B->SetOfSurfData()->Value(jb);
+      for (int da = 0; da < 3 && ib == 0; da++)
+      {
+        const int ja = fA ? iAe + da : iAe - da;
+        if (ja < 1 || ja > nA)
+        {
+          break;
+        }
+        const occ::handle<ChFiDS_SurfData>& Da = A->SetOfSurfData()->Value(ja);
+        for (int kb = 1; kb <= 2 && ib == 0; kb++)
+        {
+          for (int ka = 1; ka <= 2 && ib == 0; ka++)
+          {
+            if (Db->Index(kb) <= 0 || Db->Index(kb) != Da->Index(ka) || Db->IsOnCurve(kb) || Da->IsOnCurve(ka))
+            {
+              continue;
+            }
+            const ChFiDS_FaceInterference& Fb = Db->Interference(kb);
+            const ChFiDS_FaceInterference& Fa = Da->Interference(ka);
+            if (Fb.PCurveOnFace().IsNull() || Fa.PCurveOnFace().IsNull() || Fb.LineIndex() <= 0
+                || Fa.LineIndex() <= 0)
+            {
+              continue;
+            }
+            const double bLo = std::min(Fb.FirstParameter(), Fb.LastParameter());
+            const double bHi = std::max(Fb.FirstParameter(), Fb.LastParameter());
+            const double aLo = std::min(Fa.FirstParameter(), Fa.LastParameter());
+            const double aHi = std::max(Fa.FirstParameter(), Fa.LastParameter());
+            Geom2dAdaptor_Curve aCb(Fb.PCurveOnFace(), bLo, bHi), aCa(Fa.PCurveOnFace(), aLo, aHi);
+            Geom2dInt_GInter    anInter(aCb, aCa, tol2d, Precision::PConfusion());
+            if (!anInter.IsDone() || anInter.NbPoints() != 1 || anInter.NbSegments() != 0)
+            {
+              continue;
+            }
+            const double sb = anInter.Point(1).ParamOnFirst(), sa = anInter.Point(1).ParamOnSecond();
+            if (sb <= bLo + 1.e-3 * (bHi - bLo) || sb >= bHi - 1.e-3 * (bHi - bLo)
+                || sa <= aLo + 1.e-3 * (aHi - aLo) || sa >= aHi - 1.e-3 * (aHi - aLo))
+            {
+              continue;
+            }
+            if (DStr.Curve(Fb.LineIndex()).Curve()->Value(sb).Distance(DStr.Curve(Fa.LineIndex()).Curve()->Value(sa))
+                > 10. * tolapp3d)
+            {
+              continue;
+            }
+            ib  = jb;
+            ia  = ja;
+            onB = kb;
+            onA = ka;
+            tB  = sb;
+            tA  = sa;
+          }
+        }
+      }
+    }
+    if (ib == 0)
+    {
+      continue;
+    }
+    const occ::handle<ChFiDS_SurfData> SB  = B->SetOfSurfData()->Value(ib);
+    const occ::handle<ChFiDS_SurfData> SA  = A->SetOfSurfData()->Value(ia);
+    const occ::handle<ChFiDS_SurfData> SBe = B->SetOfSurfData()->Value(iBe);
+    const occ::handle<ChFiDS_SurfData> SAe = A->SetOfSurfData()->Value(iAe);
+    const int                          onT = 3 - onB;
+    const int                          iF  = SB->Index(onB);
+    const int                          It  = SB->Index(onT);
+    const int                          Ip  = SA->Index(3 - onA);
+    if (It <= 0 || SB->IsOnCurve(onT) || Ip <= 0 || SA->IsOnCurve(3 - onA) || It == Ip)
+    {
+      continue;
+    }
+    // A's SurfDatas from the crossing to the vertex, each on the face at
+    // the end (Ip) and on its side B rides on; B's SurfDatas from the
+    // crossing to the vertex on the top (It), the last also on the face F'
+    // between B and A at the vertex.
+    const int                                          stepA = fA ? -1 : 1;
+    NCollection_Sequence<occ::handle<ChFiDS_SurfData>> aRideA;
+    NCollection_Sequence<int>                          aSideA;
+    bool                                               aOk = true;
+    for (int j = ia;; j += stepA)
+    {
+      const occ::handle<ChFiDS_SurfData>& D = A->SetOfSurfData()->Value(j);
+      const int k = j == ia ? onA : (D->Index(1) == Ip ? 2 : (D->Index(2) == Ip ? 1 : 0));
+      aOk = aOk && k != 0 && D->Index(3 - k) == Ip && !D->IsOnCurve(3 - k) && !D->IsOnCurve(k);
+      aRideA.Append(D);
+      aSideA.Append(k);
+      if (j == iAe)
+      {
+        break;
+      }
+    }
+    for (int j = ib; aOk; j += fB ? -1 : 1)
+    {
+      const occ::handle<ChFiDS_SurfData>& D = B->SetOfSurfData()->Value(j);
+      aOk = D->Index(onT) == It && !D->IsOnCurve(onT);
+      if (j == iBe)
+      {
+        break;
+      }
+    }
+    if (!aOk || SBe->Index(onB) <= 0 || SBe->IsOnCurve(onB))
+    {
+      continue;
+    }
+    const int         iFv  = SBe->Index(onB);
+    const TopoDS_Face F    = TopoDS::Face(DStr.Shape(iF));
+    const TopoDS_Face Fv   = TopoDS::Face(DStr.Shape(iFv));
+    const TopoDS_Face aTopF = TopoDS::Face(DStr.Shape(It));
+    const TopoDS_Face Fp    = TopoDS::Face(DStr.Shape(Ip));
+    TopoDS_Face       Top   = BRepLib_MakeFace(BRep_Tool::Surface(aTopF), Precision::Confusion());
+    Top.Orientation(aTopF.Orientation());
+    const TopoDS_Edge Etp = edgeAtVertex(aTopF, Fp, Vtx);
+    const TopoDS_Edge Etw = edgeAtVertex(aTopF, Fv, Vtx);
+    const TopoDS_Edge Ewp = edgeAtVertex(Fv, Fp, Vtx);
+    if (Etp.IsNull() || Etw.IsNull() || Ewp.IsNull())
+    {
+      continue;
+    }
+    const gp_Pnt W = DStr.Curve(SB->Interference(onB).LineIndex()).Curve()->Value(tB);
+    // B split at W's section, on a copy until everything below is found.
+    occ::handle<ChFiDS_SurfData> aSBc = new ChFiDS_SurfData();
+    aSBc->Copy(SB);
+    const occ::handle<ChFiDS_SurfData> aSBn = splitSurfDataAt(DStr, aSBc, onB, tB);
+    if (aSBn.IsNull())
+    {
+      continue;
+    }
+    const gp_Pnt Wt = aSBc->Vertex(false, onT).Point();
+    const double Ws = sectionParam(B->Spine(), W, aSBc->LastSpineParam());
+    double       WEnd = fB ? B->Spine()->FirstParameter() : B->Spine()->LastParameter();
+    {
+      gp_Pnt S;
+      gp_Vec T;
+      B->Spine()->D1(WEnd, S, T);
+      if (T.SquareMagnitude() > gp::Resolution())
+      {
+        WEnd += gp_Vec(S, PV).Dot(T) / T.SquareMagnitude();
+      }
+    }
+    const double                      WFar   = WEnd + 0.05 * (WEnd - Ws);
+    const occ::handle<ChFiDS_ElSpine> aGuide = guideAlong(B->Spine(), Ws, WFar);
+    if (aGuide.IsNull())
+    {
+      continue;
+    }
+    // B's ball walked on A's blend, SurfData by SurfData, from W towards the
+    // vertex: up to each one's end there, the last until its contact comes
+    // down to A's contact with the face at the end (the support bounded
+    // there; the furthest section the walk reaches, by bisection).
+    const int                                          nR = aRideA.Length();
+    NCollection_Sequence<occ::handle<ChFiDS_SurfData>> aR;
+    NCollection_Sequence<gp_Pnt>                       aStart;
+    double                                             Wc = Ws, aReached = WFar;
+    gp_Pnt                                             Pc = W, Pct = Wt;
+    for (int n = 1; n <= nR && aOk; n++)
+    {
+      aStart.Append(Pc);
+      const occ::handle<ChFiDS_SurfData>& D = aRideA.Value(n);
+      if (n < nR)
+      {
+        const TopoDS_Face Sup = cornerRideSupport(DStr, D, aSideA.Value(n), fA, !fA, F, Pc);
+        occ::handle<ChFiDS_SurfData> R = new ChFiDS_SurfData();
+        double                       Wn = 0.;
+        aOk = !Sup.IsNull() && RideOnCornerWalk(R, B, aGuide, Sup, Top, onB, Wc, WEnd, Pc, Pct, false, Wn);
+        if (aOk)
+        {
+          aR.Append(R);
+          Pc  = R->Vertex(fB, onB).Point();
+          Pct = R->Vertex(fB, onT).Point();
+          Wc  = Wn;
+        }
+        continue;
+      }
+      const TopoDS_Face Sup = cornerRideSupport(DStr, D, aSideA.Value(n), false, false, F, Pc, true);
+      if (Sup.IsNull())
+      {
+        aOk = false;
+        break;
+      }
+      occ::handle<ChFiDS_SurfData> RL;
+      double                       Wn = 0., aWOk = Wc, aWNo = WFar;
+      for (int it = 0; it < 40 && std::abs(aWNo - aWOk) > Precision::PConfusion(); it++)
+      {
+        const double                 aW = it == 0 ? WFar : 0.5 * (aWOk + aWNo);
+        occ::handle<ChFiDS_SurfData> aTry = new ChFiDS_SurfData();
+        if (RideOnCornerWalk(aTry, B, aGuide, Sup, Top, onB, Wc, aW, Pc, Pct, false, Wn))
+        {
+          RL       = aTry;
+          aWOk     = aW;
+          aReached = Wn;
+          if (it == 0)
+          {
+            break;
+          }
+        }
+        else
+        {
+          aWNo = aW;
+        }
+      }
+      aOk = !RL.IsNull() && std::abs(aReached - WFar) > Precision::PConfusion();
+      if (aOk)
+      {
+        aR.Append(RL);
+      }
+    }
+    if (!aOk)
+    {
+      continue;
+    }
+    const occ::handle<ChFiDS_SurfData>& RL   = aR.Value(nR);
+    const int                           onAe = aSideA.Value(nR);
+    const gp_Pnt                        J    = aStart.Value(nR);
+    const ChFiDS_FaceInterference&      FS2  = RL->Interference(onB);
+    const ChFiDS_FaceInterference&      FT2  = RL->Interference(onT);
+    const ChFiDS_FaceInterference&      FCp  = SAe->Interference(3 - onAe);
+    if (FS2.PCurveOnFace().IsNull() || FCp.PCurveOnSurf().IsNull() || FT2.LineIndex() <= 0)
+    {
+      continue;
+    }
+    const bool   r2J = RL->Vertex(true, onB).Point().Distance(J) <= RL->Vertex(false, onB).Point().Distance(J);
+    const double tJ2 = r2J ? FS2.FirstParameter() : FS2.LastParameter();
+    // P_top: where the last walk's contact on the top crosses the face at
+    // the end.
+    const occ::handle<Geom_Surface> SP   = BRep_Tool::Surface(Fp);
+    const occ::handle<Geom_Surface> ST   = BRep_Tool::Surface(aTopF);
+    const occ::handle<Geom_Curve>&  CT2  = DStr.Curve(FT2.LineIndex()).Curve();
+    const double                    t2lo = std::min(FT2.FirstParameter(), FT2.LastParameter());
+    const double                    t2hi = std::max(FT2.FirstParameter(), FT2.LastParameter());
+    GeomAPI_IntCS                   anICS(new Geom_TrimmedCurve(CT2, t2lo, t2hi), SP);
+    if (!anICS.IsDone() || anICS.NbPoints() != 1)
+    {
+      continue;
+    }
+    double uI = 0., vI = 0., tTop = 0.;
+    anICS.Parameters(1, uI, vI, tTop);
+    const gp_Pnt Ptop = anICS.Point(1);
+    // P_foot: where the last walk's contact on A's blend comes down to A's
+    // contact with the face at the end.
+    const double tFoot = r2J ? FS2.LastParameter() : FS2.FirstParameter();
+    const gp_Pnt Pfoot = DStr.Curve(FS2.LineIndex()).Curve()->Value(tFoot);
+    const double cplo  = std::min(FCp.FirstParameter(), FCp.LastParameter());
+    const double cphi  = std::max(FCp.FirstParameter(), FCp.LastParameter());
+    Geom2dAPI_ProjectPointOnCurve aPrFoot(FS2.PCurveOnFace()->Value(tFoot), FCp.PCurveOnSurf(), cplo, cphi);
+    if (aPrFoot.NbPoints() == 0 || aPrFoot.LowerDistance() > 10. * tol2d)
+    {
+      continue;
+    }
+    const double tPl = aPrFoot.LowerDistanceParameter();
+    if ((tTop - FT2.FirstParameter()) * (FT2.LastParameter() - FT2.FirstParameter()) < 0.
+        || std::abs(tFoot - tJ2) <= Precision::PConfusion())
+    {
+      continue;
+    }
+    // B's end: the last walk's piece cut by the face at the end, section by
+    // section, from P_top to P_foot.
+    const occ::handle<Geom_Surface>& SR2 = DStr.Surface(RL->Surf()).Surface();
+    const gp_Pnt2d                   uv1 = FT2.PCurveOnSurf()->Value(tTop);
+    const gp_Pnt2d                   uv2 = FS2.PCurveOnSurf()->Value(tFoot);
+    double                           uB = 0., vB = 0.;
+    if (!uvOn(Fp, Ptop, uB, vB))
+    {
+      continue;
+    }
+    const gp_Pnt2d uvB1(uB, vB);
+    if (!uvOn(Fp, Pfoot, uB, vB))
+    {
+      continue;
+    }
+    const gp_Pnt2d uvB2(uB, vB);
+    const gp_Pnt2d e0     = FT2.PCurveOnSurf()->Value(FT2.FirstParameter());
+    const gp_Pnt2d e1     = FT2.PCurveOnSurf()->Value(FT2.LastParameter());
+    const int      aCoord = std::abs(e1.X() - e0.X()) >= std::abs(e1.Y() - e0.Y()) ? 1 : 2;
+    occ::handle<Geom_Curve>   Cc;
+    occ::handle<Geom2d_Curve> Ps, Pc2;
+    double                    tolCut = tolapp3d;
+    if (!ChFi3d_CutBySections(SR2, Fp, uv1, uvB1, uv2, uvB2, aCoord, aCoord == 1 ? uv1.Y() : uv1.X(), tolapp3d,
+                              Cc, Ps, Pc2, tolCut))
+    {
+      continue;
+    }
+    // The top's edge with the face at the end, prolonged from the vertex to
+    // P_top (both faces' surfaces holding the segment).
+    if (PV.Distance(Ptop) <= 10. * tolapp3d)
+    {
+      continue;
+    }
+    const occ::handle<Geom_Curve> Z3d(GC_MakeSegment(PV, Ptop).Value());
+    bool                          aOnBoth = !Z3d.IsNull();
+    for (int i = 1; i < 8 && aOnBoth; i++)
+    {
+      const gp_Pnt X = Z3d->Value(Z3d->FirstParameter() + (Z3d->LastParameter() - Z3d->FirstParameter()) * i / 8.);
+      for (const occ::handle<Geom_Surface>& S : {SP, ST})
+      {
+        GeomAPI_ProjectPointOnSurf aPr(X, S);
+        aOnBoth = aOnBoth && aPr.NbPoints() > 0 && aPr.LowerDistance() <= 10. * tolapp3d;
+      }
+    }
+    if (!aOnBoth)
+    {
+      continue;
+    }
+    const double                    uZ0 = Z3d->FirstParameter(), uZ1 = Z3d->LastParameter();
+    const occ::handle<Geom2d_Curve> Z2dP = GeomProjLib::Curve2d(Z3d, uZ0, uZ1, SP);
+    const occ::handle<Geom2d_Curve> Z2dT = GeomProjLib::Curve2d(Z3d, uZ0, uZ1, ST);
+    if (Z2dP.IsNull() || Z2dT.IsNull())
+    {
+      continue;
+    }
+    const auto sideOf = [](const occ::handle<Geom2d_Curve>& C, const double t, const gp_Pnt2d& Towards) {
+      gp_Pnt2d p;
+      gp_Vec2d d;
+      C->D1(t, p, d);
+      return d.Crossed(gp_Vec2d(p, Towards)) > 0. ? TopAbs_FORWARD : TopAbs_REVERSED;
+    };
+    const double   aEps     = 0.5 * std::min(Ptop.Distance(Pfoot), Ptop.Distance(PV));
+    const gp_Pnt2d aPlateIn = insideNear(Fp, Etp, Vtx, uvB1, aEps);
+    double         uT = 0., vT = 0.;
+    if (!uvOn(aTopF, CT2->Value(0.5 * (tTop + (r2J ? FT2.FirstParameter() : FT2.LastParameter()))), uT, vT))
+    {
+      continue;
+    }
+    const TopAbs_Orientation EtZP = sideOf(Z2dP, 0.5 * (uZ0 + uZ1), aPlateIn);
+    const TopAbs_Orientation EtZT = sideOf(Z2dT, 0.5 * (uZ0 + uZ1), gp_Pnt2d(uT, vT));
+    gp_Vec2d                 aOut(uvOn(Fp, PV, uB, vB) ? gp_Pnt2d(uB, vB) : uvB1, uvB1);
+    if (aOut.Magnitude() <= gp::Resolution())
+    {
+      continue;
+    }
+    const TopAbs_Orientation EtCut =
+      sideOf(Pc2, 0.5 * (Pc2->FirstParameter() + Pc2->LastParameter()), uvB1.Translated(aOut.Normalized() * aEps));
+    // A's end before: a point on the top's edge with the face at the end
+    // run on past the vertex (WalkedCutToEnd), which that edge's
+    // prolongation reached; that prolongation goes.
+    const gp_Pnt aAOld = SAe->Vertex(fA, onAe).Point();
+    // A split at W's section: its piece towards the vertex rides under B.
+    const occ::handle<ChFiDS_SurfData> aAn = splitSurfDataAt(DStr, SA, onA, tA);
+    if (aAn.IsNull())
+    {
+      continue;
+    }
+    // ---- From here on the stripes change. ----
+    const auto setIndex = [](const occ::handle<ChFiDS_SurfData>& D, const int k, const int I) {
+      if (k == 1)
+      {
+        D->ChangeIndexOfS1(I);
+        D->SetIndexOfC1(0);
+      }
+      else
+      {
+        D->ChangeIndexOfS2(I);
+        D->SetIndexOfC2(0);
+      }
+    };
+    const auto pointCP = [](const gp_Pnt& P) {
+      ChFiDS_CommonPoint CP;
+      CP.SetPoint(P);
+      return CP;
+    };
+    for (const int Iface : {Ip, It})
+    {
+      for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator itI(DStr.ChangeShapeInterferences(Iface));
+           itI.More();)
+      {
+        bool aDrop = false;
+        if (itI.Value()->GeometryType() == TopOpeBRepDS_CURVE)
+        {
+          const int                      ic = itI.Value()->Geometry();
+          const occ::handle<Geom_Curve>& C  = DStr.Curve(ic).Curve();
+          if (!C.IsNull())
+          {
+            const gp_Pnt c0 = C->Value(C->FirstParameter()), c1 = C->Value(C->LastParameter());
+            aDrop = (c0.Distance(PV) <= 10. * tolapp3d && c1.Distance(aAOld) <= 10. * tolapp3d)
+                    || (c1.Distance(PV) <= 10. * tolapp3d && c0.Distance(aAOld) <= 10. * tolapp3d);
+            if (aDrop)
+            {
+              DStr.ChangeCurve(ic).ChangeKeep(false);
+            }
+          }
+        }
+        if (aDrop)
+        {
+          DStr.ChangeShapeInterferences(Iface).Remove(itI);
+        }
+        else
+        {
+          itI.Next();
+        }
+      }
+    }
+    const double tolP   = std::max(tolapp3d, tolCut);
+    const int    IPfoot = DStr.AddPoint(TopOpeBRepDS_Point(Pfoot, tolP));
+    const int    IPtop  = DStr.AddPoint(TopOpeBRepDS_Point(Ptop, tolP));
+    // A: the piece of the crossing's SurfData towards the vertex after it.
+    A->ChangeSetOfSurfData()->InsertAfter(ia, aAn);
+    aRideA.ChangeValue(1) = fA ? SA : aAn;
+    for (int n = 1; n <= nR; n++)
+    {
+      const occ::handle<ChFiDS_SurfData>& D  = aRideA.Value(n);
+      const occ::handle<ChFiDS_SurfData>& R  = aR.Value(n);
+      const int                           k  = aSideA.Value(n);
+      const ChFiDS_FaceInterference&      FR = R->Interference(onB);
+      const gp_Pnt&                       P0 = aStart.Value(n);
+      const bool r0 = R->Vertex(true, onB).Point().Distance(P0) <= R->Vertex(false, onB).Point().Distance(P0);
+      const double t0 = r0 ? FR.FirstParameter() : FR.LastParameter();
+      const double t1 = n == nR ? tFoot : (r0 ? FR.LastParameter() : FR.FirstParameter());
+      ChFiDS_FaceInterference&        FD  = D->ChangeInterference(k);
+      const occ::handle<Geom2d_Curve> aPc =
+        inPeriodOf(FR.PCurveOnFace(), t0, D->Interference(3 - k), DStr.Surface(D->Surf()).Surface());
+      FD.SetInterference(FR.LineIndex(), FD.Transition(), aPc, aPc);
+      FD.SetFirstParameter(fA ? t1 : t0);
+      FD.SetLastParameter(fA ? t0 : t1);
+      setIndex(D, k, 0);
+      D->ChangeVertex(!fA, k) = pointCP(P0);
+      D->ChangeVertex(fA, k)  = pointCP(n == nR ? Pfoot : aStart.Value(n + 1));
+    }
+    // A's end: a point at P_foot, its contact with the face at the end
+    // trimmed there.
+    SAe->ChangeInterference(3 - onAe).SetParameter(tPl, fA);
+    SAe->ChangeVertex(fA, 3 - onAe) = pointCP(Pfoot);
+    A->SetIndexPoint(IPfoot, fA, 1);
+    A->SetIndexPoint(IPfoot, fA, 2);
+    A->SetCurve(0, fA);
+    A->Spine()->SetStatus(ChFiDS_FreeBoundary, fA);
+    // B: its SurfDatas up to W, then the walked pieces, cut by the face at
+    // the end; those between W and the vertex go.
+    for (int n = 1; n <= nR; n++)
+    {
+      setIndex(aR.Value(n), onB, 0);
+      setIndex(aR.Value(n), onT, It);
+    }
+    RL->ChangeInterference(onB).SetParameter(tFoot, !r2J);
+    RL->ChangeInterference(onT).SetParameter(tTop, !r2J);
+    RL->ChangeVertex(!r2J, onB) = pointCP(Pfoot);
+    RL->ChangeVertex(!r2J, onT) = pointCP(Ptop);
+    NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeqB = B->ChangeSetOfSurfData()->ChangeSequence();
+    NCollection_Map<int>                                aGone;
+    if (fB)
+    {
+      aSBn->FirstSpineParam(Ws);
+      aSeqB.ChangeValue(ib) = aSBn;
+      for (int j = 1; j < ib; j++)
+      {
+        aGone.Add(aSeqB.First()->Surf());
+        aSeqB.Remove(1);
+      }
+      for (int n = 1; n <= nR; n++)
+      {
+        aSeqB.Prepend(aR.Value(n));
+      }
+    }
+    else
+    {
+      aSBc->LastSpineParam(Ws);
+      aSeqB.ChangeValue(ib) = aSBc;
+      while (aSeqB.Length() > ib)
+      {
+        aGone.Add(aSeqB.Last()->Surf());
+        aSeqB.Remove(aSeqB.Length());
+      }
+      for (int n = 1; n <= nR; n++)
+      {
+        aSeqB.Append(aR.Value(n));
+      }
+    }
+    // (The faces of the pieces gone are generated by no edge.)
+    for (NCollection_DataMap<TopoDS_Shape, NCollection_List<int>, TopTools_ShapeMapHasher>::Iterator itM(myEVIMap);
+         itM.More() && !aGone.IsEmpty();
+         itM.Next())
+    {
+      for (NCollection_List<int>::Iterator itL(itM.ChangeValue()); itL.More();)
+      {
+        if (aGone.Contains(itL.Value()))
+        {
+          itM.ChangeValue().Remove(itL);
+        }
+        else
+        {
+          itL.Next();
+        }
+      }
+    }
+    const int Icut = DStr.AddCurve(TopOpeBRepDS_Curve(Cc, tolCut));
+    B->SetCurve(Icut, fB);
+    B->SetParameters(fB, Pc2->FirstParameter(), Pc2->LastParameter());
+    B->ChangePCurve(fB) = Ps;
+    B->SetIndexPoint(IPfoot, fB, onB);
+    B->SetIndexPoint(IPtop, fB, onT);
+    B->SetOrientation(onT == 1 ? TopAbs_FORWARD : TopAbs_REVERSED, fB);
+    B->Spine()->SetStatus(ChFiDS_FreeBoundary, fB);
+    DStr.ChangeShapeInterferences(Ip).Append(ChFi3d_FilCurveInDS(Icut, Ip, Pc2, EtCut));
+    // The prolonged edge on both faces, from the vertex to P_top.
+    const int IZ = DStr.AddCurve(TopOpeBRepDS_Curve(Z3d, tolapp3d));
+    DStr.ChangeShapeInterferences(Ip).Append(ChFi3d_FilCurveInDS(IZ, Ip, Z2dP, EtZP));
+    DStr.ChangeShapeInterferences(It).Append(ChFi3d_FilCurveInDS(IZ, It, Z2dT, EtZT));
+    DStr.ChangeCurveInterferences(IZ).Append(ChFi3d_FilVertexInDS(TopAbs_FORWARD, IZ, DStr.AddShape(Vtx), uZ0));
+    DStr.ChangeCurveInterferences(IZ).Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, IZ, IPtop, uZ1));
+    // The top's edge with F' and F''s edge with the face at the end go.
+    for (const TopoDS_Edge& E : {Etw, Ewp})
+    {
+      const int   Iarc  = DStr.AddShape(E);
+      TopoDS_Edge anArc = E;
+      anArc.Orientation(TopAbs_FORWARD);
+      for (TopExp_Explorer exv(anArc, TopAbs_VERTEX); exv.More(); exv.Next())
+      {
+        const TopoDS_Vertex& vv = TopoDS::Vertex(exv.Current());
+        if (!vv.IsSame(Vtx))
+        {
+          continue;
+        }
+        const int IV   = DStr.AddShape(vv);
+        bool      aHas = false;
+        for (NCollection_List<occ::handle<TopOpeBRepDS_Interference>>::Iterator itI(DStr.ShapeInterferences(Iarc));
+             itI.More() && !aHas;
+             itI.Next())
+        {
+          aHas = itI.Value()->GeometryType() == TopOpeBRepDS_VERTEX && itI.Value()->Geometry() == IV;
+        }
+        if (!aHas)
+        {
+          DStr.ChangeShapeInterferences(Iarc).Append(
+            ChFi3d_FilVertexInDS(TopAbs::Reverse(vv.Orientation()), Iarc, IV, BRep_Tool::Parameter(vv, anArc)));
+        }
+      }
+    }
+    // The stripes' points at W, between A's SurfDatas and at P_foot are
+    // made one once they are in the data structure.
+    for (int n = 1; n <= nR; n++)
+    {
+      ChFi3d_PartRideEnds().Append(aStart.Value(n));
+      ChFi3d_PartRideEndFaces().Append(F);
+    }
+    ChFi3d_PartRideEnds().Append(Pfoot);
+    ChFi3d_PartRideEndFaces().Append(F);
+    for (int n = 1; n <= nR; n++)
+    {
+      aR.Value(n)->ChangeOrientation() = TopAbs::Reverse(aR.Value(n)->Orientation());
+    }
+    if (!myCornerRiders.Contains(B))
+    {
+      myCornerRiders.Append(B);
+      myCornerRides.Append(B);
+    }
+    if (!myCornerRides.Contains(A))
+    {
+      myCornerRides.Append(A);
+    }
+    return true;
+  }
+  return false;
+}
