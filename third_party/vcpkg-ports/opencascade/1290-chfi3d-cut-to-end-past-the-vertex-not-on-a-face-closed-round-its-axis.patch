+//=======================================================================
+// function : ChFi3d_HasSeam
+// purpose  : Whether face F is closed round its surface: an edge of it is
+//            a seam (closed on F).
+//=======================================================================
+
+static bool ChFi3d_HasSeam(const TopoDS_Face& F)
+{
+  for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    if (BRep_Tool::IsClosed(TopoDS::Edge(ex.Current()), F))
+    {
+      return true;
+    }
+  }
+  return false;
+}
