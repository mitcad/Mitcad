+// Whether the contact curve C on [T1, T2] runs along the whole edge E: its
+// ends at the vertices of E and its points on E, within Tol.
+static bool runsAlongEdge(const occ::handle<Geom_Curve>& C,
+                          const double                   T1,
+                          const double                   T2,
+                          const TopoDS_Edge&             E,
+                          const double                   Tol)
+{
+  TopoDS_Vertex V1, V2;
+  TopExp::Vertices(E, V1, V2);
+  if (V1.IsNull() || V2.IsNull() || V1.IsSame(V2))
+  {
+    return false;
+  }
+  const gp_Pnt A = BRep_Tool::Pnt(V1), B = BRep_Tool::Pnt(V2);
+  const gp_Pnt P1 = C->Value(T1), P2 = C->Value(T2);
+  const double aTol = Tol + std::max(BRep_Tool::Tolerance(V1), BRep_Tool::Tolerance(V2));
+  if (!((P1.Distance(A) <= aTol && P2.Distance(B) <= aTol)
+        || (P1.Distance(B) <= aTol && P2.Distance(A) <= aTol)))
+  {
+    return false;
+  }
+  double                        f = 0., l = 0.;
+  const occ::handle<Geom_Curve> aCE = BRep_Tool::Curve(E, f, l);
+  if (aCE.IsNull())
+  {
+    return false;
+  }
+  // (Not widened by the edge's tolerance: a rounding made a little smaller
+  // than its face, as on a retry, stays inside the face.)
+  const double  aTolE = Tol;
+  constexpr int aNbSamples = 9;
+  for (int i = 1; i < aNbSamples; i++)
+  {
+    const gp_Pnt                aP = C->Value(T1 + (T2 - T1) * i / aNbSamples);
+    GeomAPI_ProjectPointOnCurve aProj(aP, aCE, f, l);
+    if (aProj.NbPoints() == 0 || aProj.LowerDistance() > aTolE)
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+// The outward normal of face F at the point of its surface nearest to P.
+static bool faceNormalAt(const TopoDS_Face& F, const gp_Pnt& P, gp_Dir& N)
+{
+  const occ::handle<Geom_Surface> S = BRep_Tool::Surface(F);
+  GeomAPI_ProjectPointOnSurf      aProj(P, S);
+  if (aProj.NbPoints() == 0)
+  {
+    return false;
+  }
+  double u = 0., v = 0.;
+  aProj.LowerDistanceParameters(u, v);
+  gp_Pnt aP;
+  gp_Vec aDu, aDv;
+  S->D1(u, v, aP, aDu, aDv);
+  const gp_Vec aN = aDu.Crossed(aDv);
+  if (aN.Magnitude() <= gp::Resolution())
+  {
+    return false;
+  }
+  N = gp_Dir(aN);
+  return true;
+}
