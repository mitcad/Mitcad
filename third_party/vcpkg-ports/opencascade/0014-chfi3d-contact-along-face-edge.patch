+void ChFi3d_ContactsAlongFaceEdges(TopOpeBRepDS_DataStructure&       DStr,
+                                   const occ::handle<ChFiDS_Stripe>& CorDat,
+                                   const ChFiDS_Map&                 EFMap,
+                                   const double                      Tol3d)
+{
+  const occ::handle<ChFiDS_Spine>& aSpine = CorDat->Spine();
+  if (aSpine.IsNull() || CorDat->SetOfSurfData().IsNull())
+  {
+    return;
+  }
+  const NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& SeqFil =
+    CorDat->SetOfSurfData()->Sequence();
+  for (int j = 1; j <= SeqFil.Length(); j++)
+  {
+    const occ::handle<ChFiDS_SurfData>& Fd = SeqFil(j);
+    for (int ons = 1; ons <= 2; ons++)
+    {
+      const int anIndex = Fd->Index(ons);
+      if (Fd->IsOnCurve(ons) || anIndex <= 0)
+      {
+        continue;
+      }
+      const ChFiDS_FaceInterference& FI = Fd->Interference(ons);
+      if (FI.LineIndex() == 0 || FI.PCurveOnFace().IsNull())
+      {
+        continue;
+      }
+      const occ::handle<Geom_Curve>& C  = DStr.Curve(FI.LineIndex()).Curve();
+      const double                   T1 = FI.FirstParameter(), T2 = FI.LastParameter();
+      if (C.IsNull() || std::abs(T2 - T1) <= Precision::PConfusion())
+      {
+        continue;
+      }
+      const TopoDS_Face F = TopoDS::Face(DStr.Shape(anIndex));
+      TopoDS_Edge       E;
+      for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More() && E.IsNull(); ex.Next())
+      {
+        const TopoDS_Edge& aCur = TopoDS::Edge(ex.Current());
+        bool               onSpine = BRep_Tool::Degenerated(aCur);
+        for (int ie = 1; ie <= aSpine->NbEdges() && !onSpine; ie++)
+        {
+          onSpine = aSpine->Edges(ie).IsSame(aCur);
+        }
+        if (!onSpine && runsAlongEdge(C, T1, T2, aCur, 0.1 * Tol3d))
+        {
+          E = aCur;
+        }
+      }
+      if (E.IsNull() || !EFMap.Contains(E))
+      {
+        continue;
+      }
+      // The face beyond the edge.
+      TopoDS_Face Fv;
+      int         aNbFaces = 0;
+      for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More(); it.Next())
+      {
+        aNbFaces++;
+        if (!it.Value().IsSame(F))
+        {
+          Fv = TopoDS::Face(it.Value());
+        }
+      }
+      if (Fv.IsNull() || aNbFaces != 2)
+      {
+        continue;
+      }
+      const occ::handle<Geom_Surface> Sv = BRep_Tool::Surface(Fv);
+      const occ::handle<Geom2d_Curve> PCv =
+        GeomProjLib::Curve2d(new Geom_TrimmedCurve(C, T1, T2), T1, T2, Sv);
+      if (PCv.IsNull())
+      {
+        continue;
+      }
+      // The transition on the face beyond: the blend lies, from the contact
+      // curve, toward the other contact (outside that face), as on F (inside
+      // F); the sides compare in each face's parametric orientation.
+      const double aTm = 0.5 * (T1 + T2);
+      gp_Pnt       aPm;
+      gp_Vec       aT;
+      C->D1(aTm, aPm, aT);
+      const ChFiDS_FaceInterference& FIo = Fd->Interference(3 - ons);
+      const occ::handle<Geom_Curve>& Co  = DStr.Curve(FIo.LineIndex()).Curve();
+      gp_Dir                         NF, Nv;
+      if (Co.IsNull() || aT.Magnitude() <= gp::Resolution() || !faceNormalAt(F, aPm, NF)
+          || !faceNormalAt(Fv, aPm, Nv))
+      {
+        continue;
+      }
+      const gp_Vec aToBlend(aPm, Co->Value(aTm));
+      const gp_Vec aBF = aToBlend - gp_Vec(NF) * aToBlend.Dot(gp_Vec(NF));
+      const gp_Vec aBv = aToBlend - gp_Vec(Nv) * aToBlend.Dot(gp_Vec(Nv));
+      const double aSF = gp_Vec(NF).Crossed(aT).Dot(aBF);
+      const double aSv = gp_Vec(Nv).Crossed(aT).Dot(aBv);
+      if (std::abs(aSF) <= gp::Resolution() || std::abs(aSv) <= gp::Resolution())
+      {
+        continue;
+      }
+      const TopAbs_Orientation aTra =
+        (aSF > 0.) == (aSv > 0.) ? FI.Transition() : TopAbs::Reverse(FI.Transition());
+      ChFiDS_FaceInterference& aFI = Fd->ChangeInterference(ons);
+      aFI.ChangePCurveOnFace()     = PCv;
+      aFI.SetTransition(aTra);
+      if (ons == 1)
+      {
+        Fd->ChangeIndexOfS1(DStr.AddShape(Fv));
+        Fd->SetIndexOfC1(DStr.AddShape(E));
+      }
+      else
+      {
+        Fd->ChangeIndexOfS2(DStr.AddShape(Fv));
+        Fd->SetIndexOfC2(DStr.AddShape(E));
+      }
+    }
+  }
+}
