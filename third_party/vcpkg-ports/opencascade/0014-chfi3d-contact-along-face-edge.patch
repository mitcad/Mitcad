+//=======================================================================
+// function : HatchOnBoundary
+// purpose  : A tangency line lying on the boundary of its face (a face
+//            exactly as wide as the blend's contact distance) has no domain
+//            inside the face for the hatcher. Its domains are those of the
+//            same line moved into the face by Shift (a little more than the
+//            hatcher's tolerance), when the line lies on the boundary all
+//            along them. Replaces the hatching iH of H by that one and
+//            returns the number of domains; 0 otherwise.
+//=======================================================================
+
+static int HatchOnBoundary(Geom2dHatch_Hatcher&                    H,
+                           int&                                    iH,
+                           const occ::handle<Geom2d_Curve>&        C,
+                           const occ::handle<Adaptor3d_TopolTool>& I,
+                           const double                            Shift)
+{
+  const double f = C->FirstParameter(), l = C->LastParameter();
+  const double tm =
+    (Precision::IsInfinite(f) || Precision::IsInfinite(l)) ? 0. : 0.5 * (f + l);
+  gp_Pnt2d aP;
+  gp_Vec2d aT;
+  C->D1(tm, aP, aT);
+  if (aT.Magnitude() <= gp::Resolution())
+  {
+    return 0;
+  }
+  const gp_Vec2d aN = gp_Vec2d(-aT.Y(), aT.X()) / aT.Magnitude();
+  for (const double aSide : {1., -1.})
+  {
+    const occ::handle<Geom2d_Curve> aCs =
+      occ::down_cast<Geom2d_Curve>(C->Translated(aN * (aSide * Shift)));
+    if (aCs.IsNull())
+    {
+      continue;
+    }
+    Geom2dAdaptor_Curve aLs(aCs);
+    const int           iHs = H.Trim(aLs);
+    H.ComputeDomains(iHs);
+    const int aNb = H.IsDone(iHs) ? H.NbDomains(iHs) : 0;
+    bool      onBoundary = aNb > 0;
+    for (int i = 1; i <= aNb && onBoundary; i++)
+    {
+      const HatchGen_Domain& aDom = H.Domain(iHs, i);
+      if (!aDom.HasFirstPoint() || !aDom.HasSecondPoint())
+      {
+        onBoundary = false;
+        break;
+      }
+      const double a = aDom.FirstPoint().Parameter(), b = aDom.SecondPoint().Parameter();
+      for (int k = 1; k < 8 && onBoundary; k++)
+      {
+        onBoundary =
+          I->Classify(C->Value(a + (b - a) * k / 8.), Precision::Confusion(), false) == TopAbs_ON;
+      }
+    }
+    if (onBoundary)
+    {
+      H.RemHatching(iH);
+      iH = iHs;
+      return aNb;
+    }
+    H.RemHatching(iHs);
+  }
+  return 0;
+}
+
+//=======================================================================
+// function : SnapToVertex
+// purpose  : The end of a tangency line on the boundary of face F (see
+//            HatchOnBoundary) found on arc E within Tol of a vertex of E is
+//            at that vertex: on the line at the vertex, on E at its
+//            parameter.
+//=======================================================================
+
+static void SnapToVertex(TopOpeBRepDS_DataStructure&   DStr,
+                         occ::handle<ChFiDS_SurfData>& CD,
+                         const bool                    isFirst,
+                         const int                     ons,
+                         const double                  pitol,
+                         const double                  Tol)
+{
+  ChFiDS_CommonPoint& Pons = CD->ChangeVertex(isFirst, ons);
+  if (!Pons.IsOnArc() || Pons.IsVertex())
+  {
+    return;
+  }
+  const TopoDS_Edge E = Pons.Arc();
+  const TopoDS_Face F = TopoDS::Face(DStr.Shape(CD->Index(ons)));
+  TopoDS_Vertex     V1, V2;
+  TopExp::Vertices(E, V1, V2);
+  for (const TopoDS_Vertex& V : {V1, V2})
+  {
+    if (V.IsNull() || BRep_Tool::Pnt(V).Distance(Pons.Point()) > Tol)
+    {
+      continue;
+    }
+    Geom2dAPI_ProjectPointOnCurve aProj(BRep_Tool::Parameters(V, F),
+                                        CD->Interference(ons).PCurveOnFace());
+    if (aProj.NbPoints() == 0)
+    {
+      return;
+    }
+    const double             aPar = aProj.LowerDistanceParameter();
+    const TopAbs_Orientation aTra = Pons.TransitionOnArc();
+    Pons.SetVertex(V);
+    Pons.SetArc(pitol, E, BRep_Tool::Parameter(V, E), aTra);
+    occ::handle<Geom_Surface> Surf = DStr.Surface(CD->Surf()).Surface();
+    for (int s = 1; s <= 2; s++)
+    {
+      if (s != ons && CD->Vertex(isFirst, s).IsOnArc())
+      {
+        continue;
+      }
+      CD->ChangeInterference(s).SetParameter(aPar, isFirst);
+      const gp_Pnt2d aUV = CD->Interference(s).PCurveOnSurf()->Value(aPar);
+      CD->ChangeVertex(isFirst, s).SetPoint(Surf->Value(aUV.X(), aUV.Y()));
+    }
+    return;
+  }
+}
