+//=======================================================================
+// function : ChFi3d_ContactEndsOnProlongedEdge
+// purpose  : Whether P, the end of an OnSame stripe's opposite contact on
+//            the face at the end, lies on the prolonged edge E itself,
+//            inside it and away from its vertex V at the corner (the face
+//            at the end tangent to the opposite face along E, which runs
+//            from V the way the opposite face goes on, so that the contact
+//            touches the face at the end on E short of V): E's parameter
+//            there in W.
+//=======================================================================
+
+static bool ChFi3d_ContactEndsOnProlongedEdge(const TopoDS_Edge&   E,
+                                              const TopoDS_Vertex& V,
+                                              const gp_Pnt&        P,
+                                              const double         Tol,
+                                              double&              W)
+{
+  if (E.IsNull() || V.IsNull() || BRep_Tool::Degenerated(E))
+  {
+    return false;
+  }
+  double                        f = 0., l = 0.;
+  const occ::handle<Geom_Curve> C = BRep_Tool::Curve(E, f, l);
+  if (C.IsNull() || P.Distance(BRep_Tool::Pnt(V)) <= Tol)
+  {
+    return false;
+  }
+  GeomAPI_ProjectPointOnCurve aProj(P, C, f, l);
+  if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+  {
+    return false;
+  }
+  W = aProj.LowerDistanceParameter();
+  return C->Value(W).Distance(C->Value(f)) > Tol && C->Value(W).Distance(C->Value(l)) > Tol;
+}
+
+//=======================================================================
+// function : ChFi3d_SeamRunOnAlongEdge
+// purpose  : Where E, cut at W where an OnSame stripe's opposite contact
+//            ends on it (its part from the corner's vertex V dropped), lies
+//            along the line of a seam of the face at the end F that ends at
+//            V (E bounding F there, with F's curve on one side of the seam
+//            or on both: an edge left from the seam), F goes on across that
+//            line from V to the cut: the seam runs on along its line from V
+//            to the point Ip of the cut, on both of its sides, and stays.
+//=======================================================================
+
+static void ChFi3d_SeamRunOnAlongEdge(TopOpeBRepDS_DataStructure& DStr,
+                                      const TopoDS_Face&          F,
+                                      const int                   IF,
+                                      const TopoDS_Edge&          E,
+                                      const double                W,
+                                      const TopoDS_Vertex&        V,
+                                      const int                   Ip,
+                                      const double                Tol)
+{
+  TopoDS_Face FF = F;
+  FF.Orientation(TopAbs_FORWARD);
+  TopoDS_Edge aSeam;
+  for (TopExp_Explorer ex(FF, TopAbs_EDGE); ex.More() && aSeam.IsNull(); ex.Next())
+  {
+    const TopoDS_Edge& Es = TopoDS::Edge(ex.Current());
+    TopoDS_Vertex      V1, V2;
+    TopExp::Vertices(Es, V1, V2);
+    if (!Es.IsSame(E) && !BRep_Tool::Degenerated(Es) && BRep_Tool::IsClosed(Es, FF)
+        && (V.IsSame(V1) || V.IsSame(V2)))
+    {
+      aSeam = Es;
+    }
+  }
+  if (aSeam.IsNull())
+  {
+    return;
+  }
+  double                          f2 = 0., l2 = 0.;
+  const occ::handle<Geom2d_Curve> aSeam2d = BRep_Tool::CurveOnSurface(aSeam, FF, f2, l2);
+  const occ::handle<Geom2d_Curve> aE2d    = BRep_Tool::CurveOnSurface(E, FF, f2, l2);
+  if (aSeam2d.IsNull() || aE2d.IsNull())
+  {
+    return;
+  }
+  TopoDS_Vertex aV1, aV2;
+  TopExp::Vertices(aSeam, aV1, aV2);
+  const TopoDS_Vertex& aOther = V.IsSame(aV1) ? aV2 : aV1;
+  const gp_Pnt2d       uvV    = aSeam2d->Value(BRep_Tool::Parameter(V, aSeam, FF));
+  const gp_Pnt2d       uvO    = aSeam2d->Value(BRep_Tool::Parameter(aOther, aSeam, FF));
+  const gp_Pnt2d       uvX    = aE2d->Value(W);
+  const bool           isU    = std::abs(uvV.X() - uvO.X()) <= Precision::PConfusion();
+  const bool           isV    = std::abs(uvV.Y() - uvO.Y()) <= Precision::PConfusion();
+  const double         cV = isU ? uvV.Y() : uvV.X(), cO = isU ? uvO.Y() : uvO.X();
+  const double         cX = isU ? uvX.Y() : uvX.X();
+  if (isU == isV || (cX - cV) * (cV - cO) <= 0.)
+  {
+    return;
+  }
+  // (E along the seam's line: its point at the cut on that line, a whole
+  // number of periods off where the face is periodic.)
+  {
+    BRepAdaptor_Surface aBs(FF, false);
+    double              dOff = isU ? uvX.X() - uvV.X() : uvX.Y() - uvV.Y();
+    if (isU ? aBs.IsUPeriodic() : aBs.IsVPeriodic())
+    {
+      const double T = isU ? aBs.UPeriod() : aBs.VPeriod();
+      dOff           = ElCLib::InPeriod(dOff, -0.5 * T, 0.5 * T);
+    }
+    if (std::abs(dOff) > Precision::PConfusion())
+    {
+      return;
+    }
+  }
+  // As where a corner's cut crosses the seam's line past its end (the seam
+  // run on there): the line from V to the cut on F on both sides of the
+  // seam. Here the line is a curve of its own, run the way the seam's
+  // curve runs and used on each side as the seam is there: the faces'
+  // builder chains the pieces of a seam's line by their orientation.
+  const occ::handle<Geom_Surface> aSurf  = BRep_Tool::Surface(FF);
+  const double                    aConst = isU ? uvV.X() : uvV.Y();
+  occ::handle<Geom_Curve>         aIso   = isU ? aSurf->UIso(aConst) : aSurf->VIso(aConst);
+  double                          fs = 0., ls = 0.;
+  BRep_Tool::CurveOnSurface(aSeam, FF, fs, ls);
+  const gp_Pnt2d aSf = aSeam2d->Value(fs), aSl = aSeam2d->Value(ls);
+  // (The seam's curve running down the iso-line's parameter: the iso-line
+  // reversed, whose parameter is A - t at the iso-line's t.)
+  const bool   isReversed = (isU ? aSl.Y() - aSf.Y() : aSl.X() - aSf.X()) < 0.;
+  const double A          = isReversed ? aIso->ReversedParameter(0.) : 0.;
+  if (isReversed)
+  {
+    aIso = aIso->Reversed();
+  }
+  const auto   onCurve = [&](const double c) { return isReversed ? A - c : c; };
+  const double pV = onCurve(cV), pX = onCurve(cX);
+  const double c1 = std::min(pV, pX), c2 = std::max(pV, pX);
+  const int    IS = DStr.AddCurve(
+    TopOpeBRepDS_Curve(new Geom_TrimmedCurve(aIso, c1, c2), std::max(BRep_Tool::Tolerance(aSeam), Tol)));
+  for (TopExp_Explorer ex(FF, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    if (!ex.Current().IsSame(aSeam))
+    {
+      continue;
+    }
+    const TopoDS_Edge&              aUse   = TopoDS::Edge(ex.Current());
+    double                          fu = 0., lu = 0.;
+    const occ::handle<Geom2d_Curve> aUse2d = BRep_Tool::CurveOnSurface(aUse, FF, fu, lu);
+    if (aUse2d.IsNull())
+    {
+      continue;
+    }
+    const gp_Pnt2d a     = aUse2d->Value(fu);
+    const double   aSide = isU ? a.X() : a.Y();
+    // (At the curve's t, the line's coordinate along it: t, or A - t.)
+    const double                    d = isReversed ? -1. : 1.;
+    const occ::handle<Geom2d_Curve> aLine =
+      isU ? new Geom2d_Line(gp_Pnt2d(aSide, A), gp_Dir2d(0., d)) : new Geom2d_Line(gp_Pnt2d(A, aSide), gp_Dir2d(d, 0.));
+    DStr.ChangeShapeInterferences(IF).Append(
+      ChFi3d_FilCurveInDS(IS, IF, new Geom2d_TrimmedCurve(aLine, c1, c2), aUse.Orientation()));
+  }
+  const int IVs = DStr.AddShape(V);
+  DStr.ChangeCurveInterferences(IS).Append(pV < pX ? ChFi3d_FilVertexInDS(TopAbs_FORWARD, IS, IVs, c1)
+                                                   : ChFi3d_FilPointInDS(TopAbs_FORWARD, IS, Ip, c1));
+  DStr.ChangeCurveInterferences(IS).Append(pV < pX ? ChFi3d_FilPointInDS(TopAbs_REVERSED, IS, Ip, c2)
+                                                   : ChFi3d_FilVertexInDS(TopAbs_REVERSED, IS, IVs, c2));
+  // (The seam itself kept from V on: past the parts cut away at V it is
+  // the only edge left there.)
+  TopoDS_Edge aSeamF = aSeam;
+  aSeamF.Orientation(TopAbs_FORWARD);
+  const int ISeam = DStr.AddShape(aSeamF);
+  DStr.ChangeShapeInterferences(ISeam).Append(ChFi3d_FilVertexInDS(V.IsSame(aV1) ? TopAbs_FORWARD : TopAbs_REVERSED,
+                                                                   ISeam,
+                                                                   IVs,
+                                                                   BRep_Tool::Parameter(V, aSeam)));
+}
