+//=======================================================================
+// function : ChFi3d_NarrowsToVertex
+// purpose  : Whether the edges E1 and E2 leave their common vertex V the
+//            same way (within 0.25 rad): the face they bound narrows to a
+//            point at V.
+//=======================================================================
+
+static bool ChFi3d_NarrowsToVertex(const TopoDS_Edge& E1, const TopoDS_Edge& E2, const TopoDS_Vertex& V)
+{
+  gp_Vec aOut[2];
+  int    k = 0;
+  for (const TopoDS_Edge& E : {E1, E2})
+  {
+    bool atV = false;
+    for (TopExp_Explorer ex(E, TopAbs_VERTEX); ex.More() && !atV; ex.Next())
+    {
+      atV = ex.Current().IsSame(V);
+    }
+    if (!atV || BRep_Tool::Degenerated(E))
+    {
+      return false;
+    }
+    const BRepAdaptor_Curve aC(E);
+    const double            p = BRep_Tool::Parameter(V, E);
+    gp_Pnt                  aP;
+    aC.D1(p, aP, aOut[k]);
+    // (Away from V: towards the edge's other end.)
+    const double pm = 0.5 * (aC.FirstParameter() + aC.LastParameter());
+    if (pm < p)
+    {
+      aOut[k].Reverse();
+    }
+    if (aOut[k].Magnitude() <= gp::Resolution())
+    {
+      return false;
+    }
+    k++;
+  }
+  return aOut[0].Angle(aOut[1]) < 0.25;
+}
+
+//=======================================================================
+// function : ChFi3d_OnOneSurface
+// purpose  : Whether faces F1 and F2 lie on one surface (planes in one
+//            plane, cylinders about one axis with one radius, or one
+//            surface).
+//=======================================================================
+
+static bool ChFi3d_OnOneSurface(const TopoDS_Face& F1, const TopoDS_Face& F2)
+{
+  const occ::handle<Geom_Surface> S1 = BRep_Tool::Surface(F1), S2 = BRep_Tool::Surface(F2);
+  if (S1.IsNull() || S2.IsNull())
+  {
+    return false;
+  }
+  if (S1 == S2)
+  {
+    return true;
+  }
+  const GeomAdaptor_Surface A1(S1), A2(S2);
+  if (A1.GetType() != A2.GetType())
+  {
+    return false;
+  }
+  const double tol = Precision::Confusion();
+  if (A1.GetType() == GeomAbs_Plane)
+  {
+    const gp_Pln P1 = A1.Plane(), P2 = A2.Plane();
+    return P1.Axis().IsParallel(P2.Axis(), Precision::Angular()) && P1.Distance(P2.Location()) <= tol;
+  }
+  if (A1.GetType() == GeomAbs_Cylinder)
+  {
+    const gp_Cylinder C1 = A1.Cylinder(), C2 = A2.Cylinder();
+    return C1.Axis().IsParallel(C2.Axis(), Precision::Angular())
+           && gp_Lin(C1.Axis()).Distance(C2.Location()) <= tol && std::abs(C1.Radius() - C2.Radius()) <= tol;
+  }
+  return false;
+}
+
+//=======================================================================
+// function : ChFi3d_NarrowsAtOtherEnd
+// purpose  : Whether face F narrows to a point at the other end of its edge
+//            E with face B from V: at the end of the chain of F's edges
+//            that go on from E tangentially with faces on B's surface (a
+//            half circle in two arcs, with the two halves of a cylinder),
+//            another edge of F leaves that end the way the chain arrives.
+//=======================================================================
+
+static bool ChFi3d_NarrowsAtOtherEnd(const TopoDS_Face&  F,
+                                     const TopoDS_Face&  B,
+                                     const TopoDS_Edge&  E,
+                                     const TopoDS_Vertex& V,
+                                     const ChFiDS_Map&   EFMap)
+{
+  // The direction along edge Ec away from its vertex Vc.
+  const auto outOf = [](const TopoDS_Edge& Ec, const TopoDS_Vertex& Vc, gp_Vec& D) {
+    const BRepAdaptor_Curve aC(Ec);
+    const double            p = BRep_Tool::Parameter(Vc, Ec);
+    gp_Pnt                  aP;
+    aC.D1(p, aP, D);
+    if (0.5 * (aC.FirstParameter() + aC.LastParameter()) < p)
+    {
+      D.Reverse();
+    }
+    return D.Magnitude() > gp::Resolution();
+  };
+  TopoDS_Edge   Ecur = E;
+  TopoDS_Vertex Vfrom = V;
+  for (int step = 0; step < 16; step++)
+  {
+    TopoDS_Vertex V1, V2;
+    TopExp::Vertices(Ecur, V1, V2);
+    const TopoDS_Vertex W = V1.IsSame(Vfrom) ? V2 : V1;
+    gp_Vec              aIn;
+    if (W.IsNull() || W.IsSame(Vfrom) || !outOf(Ecur, W, aIn))
+    {
+      return false;
+    }
+    TopoDS_Edge aNext;
+    for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+    {
+      const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+      if (Ec.IsSame(Ecur) || BRep_Tool::Degenerated(Ec))
+      {
+        continue;
+      }
+      bool atW = false;
+      for (TopExp_Explorer exv(Ec, TopAbs_VERTEX); exv.More() && !atW; exv.Next())
+      {
+        atW = exv.Current().IsSame(W);
+      }
+      gp_Vec aOut;
+      if (!atW || !outOf(Ec, W, aOut))
+      {
+        continue;
+      }
+      const double a = aIn.Angle(aOut);
+      if (a < 0.25)
+      {
+        return true; // (F narrows to a point at W)
+      }
+      if (M_PI - a < 0.01 && EFMap.Contains(Ec))
+      {
+        // (The chain goes on tangentially, with a face on B's surface.)
+        for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(Ec)); it.More(); it.Next())
+        {
+          if (!it.Value().IsSame(F) && ChFi3d_OnOneSurface(TopoDS::Face(it.Value()), B))
+          {
+            aNext = Ec;
+          }
+        }
+      }
+    }
+    if (aNext.IsNull())
+    {
+      return false;
+    }
+    Vfrom = W;
+    Ecur  = aNext;
+  }
+  return false;
+}
