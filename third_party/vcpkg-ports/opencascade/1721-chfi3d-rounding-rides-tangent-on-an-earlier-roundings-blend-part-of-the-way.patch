+// A's blend surface as a face over the parameters of its contact lines on
+// SurfData SA (its side OnA on face F), run on a quarter past them both along
+// the contact and across it, within the surface's bounds, oriented as F
+// where the blend touches it: the support a tangent ride rolls on
+// (RideOnBlend, RideOnBlendPart). Null where it cannot be made.
+static TopoDS_Face rideSupport(const TopOpeBRepDS_DataStructure&   DStr,
+                               const occ::handle<ChFiDS_SurfData>& SA,
+                               const int                           OnA,
+                               const TopoDS_Face&                  F,
+                               const bool                          Across)
+{
+  const occ::handle<Geom_Surface>& SS = DStr.Surface(SA->Surf()).Surface();
+  if (SS.IsNull())
+  {
+    return TopoDS_Face();
+  }
+  double u1 = RealLast(), u2 = -RealLast(), v1 = RealLast(), v2 = -RealLast();
+  for (int k = 1; k <= 2; k++)
+  {
+    const ChFiDS_FaceInterference& FIk = SA->Interference(k);
+    if (FIk.PCurveOnSurf().IsNull())
+    {
+      return TopoDS_Face();
+    }
+    for (int i = 0; i <= 10; i++)
+    {
+      const double   t  = FIk.FirstParameter() + (FIk.LastParameter() - FIk.FirstParameter()) * i / 10.;
+      const gp_Pnt2d uv = FIk.PCurveOnSurf()->Value(t);
+      u1                = std::min(u1, uv.X());
+      u2                = std::max(u2, uv.X());
+      v1                = std::min(v1, uv.Y());
+      v2                = std::max(v2, uv.Y());
+    }
+  }
+  const ChFiDS_FaceInterference& FIA0 = SA->Interference(OnA);
+  const gp_Pnt2d a0 = FIA0.PCurveOnSurf()->Value(FIA0.FirstParameter());
+  const gp_Pnt2d a1 = FIA0.PCurveOnSurf()->Value(FIA0.LastParameter());
+  double         su1 = 0., su2 = 0., sv1 = 0., sv2 = 0.;
+  SS->Bounds(su1, su2, sv1, sv2);
+  const bool alongV = std::abs(a1.Y() - a0.Y()) >= std::abs(a1.X() - a0.X());
+  for (int d = 0; d < 2; d++)
+  {
+    // (d == 0: along the contact; d == 1: across it.)
+    if (d == 1 && !Across)
+    {
+      continue;
+    }
+    if ((d == 0) == alongV)
+    {
+      const double m = (d == 0 ? 0.25 : 1.) * (v2 - v1);
+      v1             = SS->IsVPeriodic() ? v1 - m : std::max(sv1, v1 - m);
+      v2             = SS->IsVPeriodic() ? v2 + m : std::min(sv2, v2 + m);
+    }
+    else
+    {
+      const double m = (d == 0 ? 0.25 : 1.) * (u2 - u1);
+      u1             = SS->IsUPeriodic() ? u1 - m : std::max(su1, u1 - m);
+      u2             = SS->IsUPeriodic() ? u2 + m : std::min(su2, u2 + m);
+    }
+  }
+  BRepLib_MakeFace aMakeFace(SS, u1, u2, v1, v2, Precision::Confusion());
+  if (!aMakeFace.IsDone())
+  {
+    return TopoDS_Face();
+  }
+  TopoDS_Face Support = aMakeFace.Face();
+  const ChFiDS_CommonPoint& CPA = SA->Vertex(true, OnA);
+  gp_Dir                    aNF, aNS;
+  Support.Orientation(TopAbs_FORWARD);
+  if (!outwardNormalAt(F, CPA.Point(), aNF) || !outwardNormalAt(Support, CPA.Point(), aNS))
+  {
+    return TopoDS_Face();
+  }
+  if (aNF.Dot(aNS) < 0.)
+  {
+    Support.Orientation(TopAbs_REVERSED);
+  }
+  return Support;
+}
+
+bool ChFi3d_Builder::RideOnBlendPart(const occ::handle<ChFiDS_Stripe>& A,
+                                     const occ::handle<ChFiDS_Stripe>& B,
+                                     const TopoDS_Face&                F)
+{
+  TopOpeBRepDS_DataStructure&        DStr = myDS->ChangeDS();
+  const occ::handle<ChFiDS_FilSpine> aFsA = occ::down_cast<ChFiDS_FilSpine>(A->Spine());
+  const occ::handle<ChFiDS_FilSpine> aFsB = occ::down_cast<ChFiDS_FilSpine>(B->Spine());
+  if (aFsA.IsNull() || aFsB.IsNull() || !aFsA->IsConstant() || !aFsB->IsConstant()
+      || A->SetOfSurfData().IsNull() || B->SetOfSurfData().IsNull()
+      || A->SetOfSurfData()->Length() != 1 || B->SetOfSurfData()->Length() != 1)
+  {
+    return false;
+  }
+  ChFiDS_TypeOfConcavity aType[2] = {ChFiDS_Other, ChFiDS_Other};
+  for (int i = 0; i < 2; i++)
+  {
+    const TopoDS_Edge E = spineEdgeOf(i == 0 ? A->Spine() : B->Spine(), F);
+    if (E.IsNull() || !myEFMap.Contains(E) || myEFMap(E).Extent() != 2)
+    {
+      return false;
+    }
+    aType[i] = ChFi3d::DefineConnectType(E,
+                                         TopoDS::Face(myEFMap(E).First()),
+                                         TopoDS::Face(myEFMap(E).Last()),
+                                         1.e-6,
+                                         false);
+    if (aType[i] != ChFiDS_Convex && aType[i] != ChFiDS_Concave)
+    {
+      return false;
+    }
+  }
+  if (aType[0] == aType[1] && aFsB->Radius() >= aFsA->Radius() * (1. - 1.e-3))
+  {
+    return false;
+  }
+  for (const occ::handle<ChFiDS_Stripe>& S : {A, B})
+  {
+    const occ::handle<ChFiDS_Spine>& Sp = S->Spine();
+    if (Sp->IsPeriodic() || Sp->IsClosed())
+    {
+      return false;
+    }
+    for (const TopoDS_Vertex& V : {Sp->FirstVertex(), Sp->LastVertex()})
+    {
+      int aNb = 0;
+      for (int j = 1; j <= myVDataMap.Extent() && aNb == 0; j++)
+      {
+        aNb = myVDataMap.FindKey(j).IsSame(V) ? myVDataMap.FindFromIndex(j).Extent() : 0;
+      }
+      if (aNb != 1)
+      {
+        return false;
+      }
+    }
+  }
+  occ::handle<ChFiDS_SurfData> SA, SB;
+  int                          onA = 0, onB = 0;
+  if (!findRideSurfData(DStr, A, F, SA, onA) || !findRideSurfData(DStr, B, F, SB, onB)
+      || SA->IsOnCurve(onA) || SB->IsOnCurve(onB))
+  {
+    return false;
+  }
+  const ChFiDS_FaceInterference& FA0 = SA->Interference(onA);
+  const ChFiDS_FaceInterference& FB0 = SB->Interference(onB);
+  if (FA0.LineIndex() <= 0 || FB0.LineIndex() <= 0 || FA0.PCurveOnFace().IsNull()
+      || FB0.PCurveOnFace().IsNull())
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve> CAF = DStr.Curve(FA0.LineIndex()).Curve();
+  const occ::handle<Geom_Curve> CBF = DStr.Curve(FB0.LineIndex()).Curve();
+  if (CAF.IsNull() || CBF.IsNull())
+  {
+    return false;
+  }
+  const double aLo = std::min(FA0.FirstParameter(), FA0.LastParameter());
+  const double aHi = std::max(FA0.FirstParameter(), FA0.LastParameter());
+  const double bLo = std::min(FB0.FirstParameter(), FB0.LastParameter());
+  const double bHi = std::max(FB0.FirstParameter(), FB0.LastParameter());
+  // The contacts on F cross once, inside both.
+  Geom2dAdaptor_Curve aCA(FA0.PCurveOnFace(), aLo, aHi), aCB(FB0.PCurveOnFace(), bLo, bHi);
+  Geom2dInt_GInter    anInter(aCA, aCB, tol2d, Precision::PConfusion());
+  if (!anInter.IsDone() || anInter.NbPoints() != 1 || anInter.NbSegments() != 0)
+  {
+    return false;
+  }
+  const double tA = anInter.Point(1).ParamOnFirst(), tB = anInter.Point(1).ParamOnSecond();
+  if (tA <= aLo + 1.e-3 * (aHi - aLo) || tA >= aHi - 1.e-3 * (aHi - aLo) || tB <= bLo + 1.e-3 * (bHi - bLo)
+      || tB >= bHi - 1.e-3 * (bHi - bLo))
+  {
+    return false;
+  }
+  const gp_Pnt P = CAF->Value(tA);
+  if (P.Distance(CBF->Value(tB)) > 10. * tolapp3d)
+  {
+    return false;
+  }
+  // The end of each contact where the ride is: B's contact there lies
+  // nearer A's edge than A's contact (beyond it, as the two roundings
+  // overlap on F there).
+  const TopoDS_Edge EA = spineEdgeOf(A->Spine(), F);
+  // (The distance from A's edge's curve, run on past the edge's ends where
+  // the foot of the point lies beyond them.)
+  const auto fromEA = [&](const gp_Pnt& X) {
+    double                         f = 0., l = 0.;
+    const occ::handle<Geom_Curve>& C = BRep_Tool::Curve(EA, f, l);
+    if (C.IsNull())
+    {
+      return RealLast();
+    }
+    const double d = distanceToEdge(X, EA);
+    if (d < RealLast())
+    {
+      return d;
+    }
+    GeomAPI_ProjectPointOnCurve aPr(X, C);
+    return aPr.NbPoints() > 0 ? aPr.LowerDistance() : RealLast();
+  };
+  const auto beyond = [&](const gp_Pnt& Xb, const gp_Pnt& Ya) {
+    return fromEA(Xb) < fromEA(Ya) - 10. * tolapp3d;
+  };
+  const auto nearestOn = [](const occ::handle<Geom_Curve>& C, double t1, double t2, const gp_Pnt& X, gp_Pnt& Y) {
+    GeomAPI_ProjectPointOnCurve aPr(X, C, t1, t2);
+    if (aPr.NbPoints() == 0)
+    {
+      return false;
+    }
+    Y = aPr.NearestPoint();
+    return true;
+  };
+  bool bRide[2] = {false, false}, aRide[2] = {false, false};
+  for (int f = 0; f < 2; f++)
+  {
+    const gp_Pnt Xb = SB->Vertex(f == 0, onB).Point();
+    gp_Pnt       Ya;
+    if (!nearestOn(CAF, aLo, aHi, Xb, Ya))
+    {
+      return false;
+    }
+    bRide[f]        = beyond(Xb, Ya);
+    const gp_Pnt Y2 = SA->Vertex(f == 0, onA).Point();
+    gp_Pnt       X2;
+    if (!nearestOn(CBF, bLo, bHi, Y2, X2))
+    {
+      return false;
+    }
+    aRide[f] = beyond(X2, Y2);
+  }
+  if (bRide[0] == bRide[1] || aRide[0] == aRide[1])
+  {
+    return false;
+  }
+  const bool bFirst = bRide[0], aFirst = aRide[0];
+  // A's contact at the ride's end lies on an arc of F, the face at the end
+  // beyond it.
+  const ChFiDS_CommonPoint& CPAe = SA->Vertex(aFirst, onA);
+  if (!CPAe.IsOnArc() || CPAe.IsVertex())
+  {
+    return false;
+  }
+  const TopoDS_Edge anEndArc = CPAe.Arc();
+  const TopoDS_Face Fe       = otherFaceOf(myEFMap, anEndArc, F);
+  if (Fe.IsNull())
+  {
+    return false;
+  }
+  // B as computed on the faces of its edge, its piece beyond the ride.
+  occ::handle<ChFiDS_SurfData> aBN = new ChFiDS_SurfData();
+  aBN->Copy(SB);
+  occ::handle<ChFiDS_SurfData> aBN2 = splitSurfDataAt(DStr, aBN, onB, tB);
+  if (aBN2.IsNull())
+  {
+    return false;
+  }
+  const occ::handle<ChFiDS_SurfData> aBNorm = bFirst ? aBN2 : aBN;
+  // The support: A's blend, run on across its contact on F too, so that B's
+  // ball riding on it passes the crossing.
+  const TopoDS_Face Support = rideSupport(DStr, SA, onA, F, true);
+  if (Support.IsNull())
+  {
+    return false;
+  }
+  myRideStripes.Append(B);
+  myRideOn.Append(A);
+  myRideFaces.Append(F);
+  myRideEdges.Append(TopoDS_Edge());
+  myRideSupports.Append(Support);
+  myTangentRides.Append(B);
+  const auto undo = [&]() {
+    removeRideOf(B, myRideStripes, myRideOn, myRideFaces, myRideEdges, myRideSupports);
+    removeTangentRide(B, myTangentRides);
+    B->Reset();
+    B->Spine()->SetErrorStatus(ChFiDS_Ok);
+    try
+    {
+      OCC_CATCH_SIGNALS
+      occ::handle<ChFiDS_Stripe> aStripe = B;
+      PerformSetOfSurf(aStripe);
+    }
+    catch (Standard_Failure const&)
+    {
+    }
+  };
+  B->Reset();
+  B->Spine()->SetErrorStatus(ChFiDS_Ok);
+  try
+  {
+    OCC_CATCH_SIGNALS
+    occ::handle<ChFiDS_Stripe> aStripe = B;
+    PerformSetOfSurf(aStripe);
+  }
+  catch (Standard_Failure const&)
+  {
+    undo();
+    return false;
+  }
+  occ::handle<ChFiDS_SurfData> SB2;
+  int                          onB2 = 0;
+  // (The ride's piece from the crossing: where its walk ran on past the
+  // ride's end onto the face beyond, the piece beyond is not kept.)
+  if (B->Spine()->ErrorStatus() == ChFiDS_Ok && !B->SetOfSurfData().IsNull()
+      && B->SetOfSurfData()->Length() >= 1)
+  {
+    const occ::handle<ChFiDS_SurfData>& aNear =
+      bFirst ? B->SetOfSurfData()->Last() : B->SetOfSurfData()->First();
+    for (int k = 1; k <= 2; k++)
+    {
+      if (aNear->Index(k) > 0 && DStr.Shape(aNear->Index(k)).IsSame(Support))
+      {
+        SB2  = aNear;
+        onB2 = k;
+      }
+    }
+  }
+  if (B->Spine()->ErrorStatus() != ChFiDS_Ok || SB2.IsNull() || !SB2->Vertex(bFirst, 3 - onB2).IsOnArc())
+  {
+    undo();
+    return false;
+  }
+  const ChFiDS_FaceInterference& FR = SB2->Interference(onB2);
+  if (FR.LineIndex() <= 0 || FR.PCurveOnFace().IsNull() || FR.PCurveOnSurf().IsNull())
+  {
+    undo();
+    return false;
+  }
+  const occ::handle<Geom_Curve> CB = DStr.Curve(FR.LineIndex()).Curve();
+  const double rLo = std::min(FR.FirstParameter(), FR.LastParameter());
+  const double rHi = std::max(FR.FirstParameter(), FR.LastParameter());
+  GeomAPI_ProjectPointOnCurve aPrP(P, CB, rLo, rHi);
+  if (aPrP.NbPoints() == 0 || aPrP.LowerDistance() > 100. * tolapp3d)
+  {
+    undo();
+    return false;
+  }
+  const double tR = aPrP.LowerDistanceParameter();
+  // (The ride computed up to the crossing's section: its end there; else
+  // split there.)
+  occ::handle<ChFiDS_SurfData> aBRide = new ChFiDS_SurfData();
+  aBRide->Copy(SB2);
+  if (std::abs(tR - (bFirst ? FR.LastParameter() : FR.FirstParameter())) > 1.e-6 * (rHi - rLo))
+  {
+    occ::handle<ChFiDS_SurfData> aBR2 = splitSurfDataAt(DStr, aBRide, onB2, tR);
+    if (aBR2.IsNull())
+    {
+      undo();
+      return false;
+    }
+    if (!bFirst)
+    {
+      aBRide = aBR2;
+    }
+  }
+  // The two pieces of B meet at the crossing's section: the ride's points
+  // there are the other piece's.
+  {
+    ChFiDS_CommonPoint& CPr = aBRide->ChangeVertex(!bFirst, onB2);
+    ChFiDS_CommonPoint& CPn = aBNorm->ChangeVertex(bFirst, onB);
+    CPr.Reset();
+    CPr.SetPoint(P);
+    CPr.SetParameter(tR);
+    const double aPn = CPn.Parameter();
+    CPn.Reset();
+    CPn.SetPoint(P);
+    CPn.SetParameter(aPn);
+    ChFiDS_CommonPoint& COr = aBRide->ChangeVertex(!bFirst, 3 - onB2);
+    ChFiDS_CommonPoint& COn = aBNorm->ChangeVertex(bFirst, 3 - onB);
+    COn = COr;
+  }
+  // B's contact on the support: its end at the face at the end (where it
+  // crosses Fe), and at the crossing.
+  double aEndT = 0.;
+  {
+    GeomAPI_IntCS anIntCS(CB, BRep_Tool::Surface(Fe));
+    if (!anIntCS.IsDone())
+    {
+      undo();
+      return false;
+    }
+    double aBest = RealLast();
+    for (int i = 1; i <= anIntCS.NbPoints(); i++)
+    {
+      double u = 0., v = 0., t = 0.;
+      anIntCS.Parameters(i, u, v, t);
+      const double d = anIntCS.Point(i).Distance(CPAe.Point());
+      if (t >= rLo - Precision::PConfusion() && t <= rHi + Precision::PConfusion() && d < aBest)
+      {
+        aBest = d;
+        aEndT = t;
+      }
+    }
+    if (aBest == RealLast())
+    {
+      undo();
+      return false;
+    }
+  }
+  const double b1 = bFirst ? aEndT : tR, b2 = bFirst ? tR : aEndT;
+  if (b2 - b1 <= Precision::PConfusion())
+  {
+    undo();
+    return false;
+  }
+  ChFiDS_FaceInterference&        FIB = aBRide->ChangeInterference(onB2);
+  const occ::handle<Geom2d_Curve> PCF =
+    GeomProjLib::Curve2d(new Geom_TrimmedCurve(CB, b1, b2), b1, b2, BRep_Tool::Surface(F));
+  if (PCF.IsNull())
+  {
+    undo();
+    return false;
+  }
+  const int                       iF   = DStr.AddShape(F);
+  const occ::handle<Geom2d_Curve> PCA  = FIB.PCurveOnFace(); // on A's surface
+  const TopAbs_Orientation        aTra = DStr.Shape(iF).Orientation() != Support.Orientation()
+                                           ? TopAbs::Reverse(FIB.Transition())
+                                           : FIB.Transition();
+  FIB.SetInterference(FIB.LineIndex(), aTra, PCF, FIB.PCurveOnSurf());
+  if (onB2 == 1)
+  {
+    aBRide->ChangeIndexOfS1(iF);
+  }
+  else
+  {
+    aBRide->ChangeIndexOfS2(iF);
+  }
+  {
+    ChFiDS_CommonPoint& CP = aBRide->ChangeVertex(bFirst, onB2);
+    CP.Reset();
+    CP.SetPoint(CB->Value(aEndT));
+    CP.SetParameter(aEndT);
+    FIB.SetParameter(aEndT, bFirst);
+    FIB.SetParameter(tR, !bFirst);
+    aBRide->ChangeVertex(!bFirst, onB2).SetParameter(tR);
+  }
+  // (Whether B runs against A: its ride's end at the face at the end is
+  // A's last there.)
+  const bool against = aFirst != bFirst;
+  int                       iCA  = FIB.LineIndex();
+  occ::handle<Geom_Curve>   CA   = CB;
+  double                    a1   = b1, a2 = b2;
+  occ::handle<Geom2d_Curve> PCFA = PCF, PCAA = PCA;
+  if (against)
+  {
+    CA   = CB->Reversed();
+    a1   = CB->ReversedParameter(b2);
+    a2   = CB->ReversedParameter(b1);
+    iCA  = DStr.AddCurve(TopOpeBRepDS_Curve(CA, DStr.Curve(FIB.LineIndex()).Tolerance()));
+    PCFA = GeomProjLib::Curve2d(new Geom_TrimmedCurve(CA, a1, a2), a1, a2, BRep_Tool::Surface(F));
+    PCAA = GeomProjLib::Curve2d(new Geom_TrimmedCurve(CA, a1, a2),
+                                a1,
+                                a2,
+                                DStr.Surface(SA->Surf()).Surface());
+    if (PCFA.IsNull() || PCAA.IsNull())
+    {
+      undo();
+      return false;
+    }
+  }
+  // B: the ride, then the rest, in its spine's order.
+  {
+    NCollection_Sequence<occ::handle<ChFiDS_SurfData>>& aSeq = B->ChangeSetOfSurfData()->ChangeSequence();
+    aSeq.Clear();
+    aSeq.Append(bFirst ? aBRide : aBNorm);
+    aSeq.Append(bFirst ? aBNorm : aBRide);
+  }
+  // A split at the crossing, its piece of the ride holding B's contact on
