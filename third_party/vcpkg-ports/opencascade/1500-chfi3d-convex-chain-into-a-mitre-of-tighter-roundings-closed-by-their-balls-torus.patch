+namespace
+{
+//! A convex mitre at the end of a chain (ChFi3d_ConvexMitre): the chain's
+//! edge Ex between the planes A and B (outward normals nA, nB) ends at V,
+//! where the mitre Em between the cylinders KA and KB of radius rk starts;
+//! KA is tangent to A along Ea, KB to B along Eb (both through V); Em ends
+//! at W on the plane T (outward normal nT along Ex), which KA and KB touch
+//! along Eta and Etb (both through W). O is the centre of the torus that
+//! closes the corner: on the axis of the ball of R between A and B, rk
+//! inside T; rho = R - rk; phi the angle between nA and nB.
+struct ChFi3d_ConvexMitreData
+{
+  TopoDS_Face   A, B, KA, KB, T;
+  TopoDS_Edge   Ea, Eb, Eta, Etb;
+  TopoDS_Vertex V, W;
+  gp_Dir        nA, nB, nT;
+  gp_Pnt        O;
+  double        rk  = 0.;
+  double        rho = 0.;
+  double        phi = 0.;
+};
+} // namespace
+
+//=======================================================================
+// function : ChFi3d_EdgeOfFaceAt
+// purpose  : The edge of F other than Ex holding the vertex V whose
+//            other face is G (G null: any other face, given back in G).
+//=======================================================================
+
+static bool ChFi3d_EdgeOfFaceAt(const TopoDS_Face&   F,
+                                const TopoDS_Edge&   Ex,
+                                const TopoDS_Vertex& V,
+                                const ChFiDS_Map&    EFMap,
+                                TopoDS_Face&         G,
+                                TopoDS_Edge&         E)
+{
+  for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& Ec = TopoDS::Edge(ex.Current());
+    if (Ec.IsSame(Ex) || BRep_Tool::Degenerated(Ec))
+    {
+      continue;
+    }
+    TopoDS_Vertex v1, v2;
+    TopExp::Vertices(Ec, v1, v2);
+    if (!v1.IsSame(V) && !v2.IsSame(V))
+    {
+      continue;
+    }
+    const TopoDS_Face Gc = ChFi3d_FaceBeyond(EFMap, Ec, F);
+    if (Gc.IsNull() || (!G.IsNull() && !Gc.IsSame(G)))
+    {
+      continue;
+    }
+    G = Gc;
+    E = Ec;
+    return true;
+  }
+  return false;
+}
+
+//=======================================================================
+// function : ChFi3d_ConvexMitre
+// purpose  : Whether the edge Em at the end of a convex chain of radius R
+//            past its edge Ex is a mitre of two earlier convex roundings of
+//            a radius rk below R (ChFi3d_ConvexMitreData) that a torus
+//            closes: Ex a line between the planes A and B, the roundings
+//            cylinders tangent to A and B along their edges at V and to
+//            the plane T at Em's other end, T square to Ex, their axes
+//            through the torus's tube circle (radius R - rk about Ex's
+//            ball axis, rk inside T, at V's height).
+//=======================================================================
+
+static bool ChFi3d_ConvexMitre(const TopoDS_Edge&      Ex,
+                               const TopoDS_Edge&      Em,
+                               const ChFiDS_Map&       EFMap,
+                               const double            R,
+                               const double            tol,
+                               ChFi3d_ConvexMitreData& D)
+{
+  const double angTol = 1.e-6;
+  if (Ex.IsSame(Em) || BRep_Tool::Degenerated(Ex) || BRep_Tool::Degenerated(Em) || !EFMap.Contains(Ex)
+      || !EFMap.Contains(Em) || EFMap(Ex).Extent() != 2 || EFMap(Em).Extent() != 2
+      || !TopExp::CommonVertex(Ex, Em, D.V))
+  {
+    return false;
+  }
+  {
+    TopoDS_Vertex v1, v2;
+    TopExp::Vertices(Em, v1, v2);
+    if (v1.IsNull() || v2.IsNull() || v1.IsSame(v2))
+    {
+      return false;
+    }
+    D.W = v1.IsSame(D.V) ? v2 : v1;
+  }
+  BRepAdaptor_Curve aCx(Ex);
+  if (aCx.GetType() != GeomAbs_Line)
+  {
+    return false;
+  }
+  const gp_Dir d = aCx.Line().Direction();
+  D.A            = TopoDS::Face(EFMap(Ex).First());
+  D.B            = TopoDS::Face(EFMap(Ex).Last());
+  gp_Pln PlA, PlB, PlT;
+  if (D.A.IsSame(D.B) || !ChFi3d_PlaneOf(D.A, PlA, D.nA) || !ChFi3d_PlaneOf(D.B, PlB, D.nB)
+      || std::abs(D.nA.Dot(d)) > angTol || std::abs(D.nB.Dot(d)) > angTol)
+  {
+    return false;
+  }
+  const TopoDS_Face K1 = TopoDS::Face(EFMap(Em).First());
+  const TopoDS_Face K2 = TopoDS::Face(EFMap(Em).Last());
+  if (K1.IsSame(K2) || BRepAdaptor_Surface(K1, false).GetType() != GeomAbs_Cylinder
+      || BRepAdaptor_Surface(K2, false).GetType() != GeomAbs_Cylinder)
+  {
+    return false;
+  }
+  // KA beside A, KB beside B (each along an edge through V).
+  TopoDS_Face G = K1;
+  if (ChFi3d_EdgeOfFaceAt(D.A, Ex, D.V, EFMap, G, D.Ea))
+  {
+    D.KA = K1;
+    D.KB = K2;
+  }
+  else
+  {
+    D.KA = K2;
+    D.KB = K1;
+    G    = K2;
+    if (!ChFi3d_EdgeOfFaceAt(D.A, Ex, D.V, EFMap, G, D.Ea))
+    {
+      return false;
+    }
+  }
+  G = D.KB;
+  if (!ChFi3d_EdgeOfFaceAt(D.B, Ex, D.V, EFMap, G, D.Eb))
+  {
+    return false;
+  }
+  const gp_Cylinder CA = BRepAdaptor_Surface(D.KA, false).Cylinder();
+  const gp_Cylinder CB = BRepAdaptor_Surface(D.KB, false).Cylinder();
+  D.rk                 = CA.Radius();
+  if (std::abs(CB.Radius() - D.rk) > tol || !(D.rk > 10. * tol && D.rk < R - 10. * tol))
+  {
+    return false;
+  }
+  // The plane T at W, which both cylinders touch along an edge through W.
+  TopoDS_Face T;
+  if (!ChFi3d_EdgeOfFaceAt(D.KA, Em, D.W, EFMap, T, D.Eta) || T.IsSame(D.KB) || T.IsSame(D.A))
+  {
+    return false;
+  }
+  if (!ChFi3d_EdgeOfFaceAt(D.KB, Em, D.W, EFMap, T, D.Etb))
+  {
+    return false;
+  }
+  D.T = T;
+  if (!ChFi3d_PlaneOf(D.T, PlT, D.nT) || std::abs(std::abs(D.nT.Dot(d)) - 1.) > angTol)
+  {
+    return false;
+  }
+  // The cylinders convex, tangent to their plane beside the chain and to T:
+  // their axes square to Ex, along their planes, rk inside both.
+  const auto inside = [](const gp_Pln& Pl, const gp_Dir& n, const gp_Pnt& X) {
+    return gp_Vec(Pl.Location(), X).Dot(gp_Vec(n));
+  };
+  for (const gp_Cylinder* C : {&CA, &CB})
+  {
+    const gp_Dir& a  = C->Axis().Direction();
+    const gp_Dir& nP = C == &CA ? D.nA : D.nB;
+    const gp_Pln& Pl = C == &CA ? PlA : PlB;
+    if (std::abs(a.Dot(d)) > angTol || std::abs(a.Dot(nP)) > angTol
+        || std::abs(inside(Pl, nP, C->Location()) + D.rk) > tol
+        || std::abs(inside(PlT, D.nT, C->Location()) + D.rk) > tol)
+    {
+      return false;
+    }
+  }
+  // O: R inside A and B, rk inside T.
+  const gp_Vec vA(D.nA), vB(D.nB), vT(D.nT);
+  const double aDet = vA.Dot(vB.Crossed(vT));
+  if (std::abs(aDet) < 1.e-6)
+  {
+    return false;
+  }
+  const double hA = vA.Dot(gp_Vec(PlA.Location().XYZ())) - R;
+  const double hB = vB.Dot(gp_Vec(PlB.Location().XYZ())) - R;
+  const double hT = vT.Dot(gp_Vec(PlT.Location().XYZ())) - D.rk;
+  D.O             = gp_Pnt((hA * vB.Crossed(vT).XYZ() + hB * vT.Crossed(vA).XYZ() + hT * vA.Crossed(vB).XYZ()) / aDet);
+  D.rho           = R - D.rk;
+  D.phi           = D.nA.Angle(D.nB);
+  if (D.phi < 1.e-3 || D.phi > M_PI - 1.e-3)
+  {
+    return false;
+  }
+  // The cylinders' axes through the tube circle; V at O's height.
+  if (gp_Lin(CA.Axis()).Distance(gp_Pnt(D.O.XYZ() + D.rho * D.nA.XYZ())) > tol
+      || gp_Lin(CB.Axis()).Distance(gp_Pnt(D.O.XYZ() + D.rho * D.nB.XYZ())) > tol
+      || std::abs(gp_Vec(D.O, BRep_Tool::Pnt(D.V)).Dot(vT)) > tol)
+  {
+    return false;
+  }
+  return true;
+}
+
+//=======================================================================
+// function : ChFi3d_ConvexMitreAt
+// purpose  : The convex mitre (ChFi3d_ConvexMitre) at the vertex Vx of a
+//            chain whose end edge is Ex, given back in Em.
+//=======================================================================
+
+static bool ChFi3d_ConvexMitreAt(const TopoDS_Vertex&    Vx,
+                                 const TopoDS_Edge&      Ex,
+                                 const ChFiDS_Map&       VEMap,
+                                 const ChFiDS_Map&       EFMap,
+                                 const double            R,
+                                 const double            tol,
+                                 TopoDS_Edge&            Em,
+                                 ChFi3d_ConvexMitreData& D)
+{
+  if (!VEMap.Contains(Vx))
+  {
+    return false;
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(VEMap(Vx)); it.More(); it.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(it.Value());
+    if (!E.IsSame(Ex) && ChFi3d_ConvexMitre(Ex, E, EFMap, R, tol, D) && D.V.IsSame(Vx))
+    {
+      Em = E;
+      return true;
+    }
+  }
+  return false;
+}
