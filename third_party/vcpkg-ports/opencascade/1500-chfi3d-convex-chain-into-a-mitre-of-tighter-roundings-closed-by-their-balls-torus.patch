+//=======================================================================
+// function : SplitAtConvexMitres
+// purpose  : See the header.
+//=======================================================================
+
+void ChFi3d_Builder::SplitAtConvexMitres()
+{
+  const double                                 tol = std::max(10. * tolapp3d, 1.e-5);
+  NCollection_List<occ::handle<ChFiDS_Stripe>> aNew;
+  bool                                         aSplit = false;
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator it(myListStripe); it.More(); it.Next())
+  {
+    const occ::handle<ChFiDS_Stripe>&  S  = it.Value();
+    const occ::handle<ChFiDS_FilSpine> sp = S.IsNull() ? occ::handle<ChFiDS_FilSpine>()
+                                                        : occ::down_cast<ChFiDS_FilSpine>(S->Spine());
+    const int n = sp.IsNull() ? 0 : sp->NbEdges();
+    if (sp.IsNull() || !sp->IsConstant() || n < 2 || sp->IsClosed()
+        || sp->GetTypeOfConcavity() == ChFiDS_Concave)
+    {
+      aNew.Append(S);
+      continue;
+    }
+    const double           R = sp->Radius();
+    ChFi3d_ConvexMitreData D;
+    const bool             aFirst = ChFi3d_ConvexMitre(sp->Edges(2), sp->Edges(1), myEFMap, R, tol, D);
+    const bool aLast = ChFi3d_ConvexMitre(sp->Edges(n - 1), sp->Edges(n), myEFMap, R, tol, D);
+    const int  i1 = aFirst ? 2 : 1, i2 = aLast ? n - 1 : n;
+    if ((!aFirst && !aLast) || i2 < i1)
+    {
+      aNew.Append(S);
+      continue;
+    }
+    occ::handle<ChFiDS_Stripe>   st = new ChFiDS_Stripe();
+    occ::handle<ChFiDS_FilSpine> ns = new ChFiDS_FilSpine(tolesp);
+    st->ChangeSpine()               = ns;
+    for (int k = i1; k <= i2; k++)
+    {
+      ns->SetEdges(sp->Edges(k));
+    }
+    ns->SetFirstStatus(aFirst ? ChFiDS_Tangent : sp->FirstStatus());
+    ns->SetLastStatus(aLast ? ChFiDS_Tangent : sp->LastStatus());
+    ns->SetTypeOfConcavity(sp->GetTypeOfConcavity());
+    ns->Load();
+    ns->SetRadius(R);
+    aNew.Append(st);
+    aSplit = true;
+  }
+  if (aSplit)
+  {
+    myListStripe = aNew;
+  }
+}
+
+//=======================================================================
+// function : PerformConvexMitreCorners
+// purpose  : See the header. At the stripe's end at V (its end section
+//            the arc of radius R about the ball's axis from PA on A to PB
+//            on B), the torus about that axis (major radius rho = R - rk,
+//            its tube the ball of rk) turns from KA's section through PA
+//            (the meridian from PA to QA on T) to KB's (PB to QB), touching
+//            the stripe's blend along the end arc and T along the circle
+//            of radius rho from QA to QB. KA and KB are cut along the
+//            meridians, T along that circle; the mitre and the strips of
+//            KA and KB beside it go.
+//=======================================================================
+
+bool ChFi3d_Builder::PerformConvexMitreCorners()
+{
+  TopOpeBRepDS_DataStructure&                        DStr = myDS->ChangeDS();
+  const double                                       tol  = std::max(10. * tolapp3d, 1.e-5);
+  NCollection_List<occ::handle<ChFiDS_Stripe>>       aCorners;
+  const NCollection_List<occ::handle<ChFiDS_Stripe>> aStripes = myListStripe;
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itS(aStripes); itS.More(); itS.Next())
+  {
+    const occ::handle<ChFiDS_Stripe>&  S  = itS.Value();
+    const occ::handle<ChFiDS_FilSpine> sp = S->Spine().IsNull()
+                                              ? occ::handle<ChFiDS_FilSpine>()
+                                              : occ::down_cast<ChFiDS_FilSpine>(S->Spine());
+    if (sp.IsNull() || !sp->IsConstant() || sp->GetTypeOfConcavity() == ChFiDS_Concave)
+    {
+      continue;
+    }
+    for (const bool isfirst : {true, false})
+    {
+      if ((isfirst ? sp->FirstStatus() : sp->LastStatus()) != ChFiDS_Tangent)
+      {
+        continue;
+      }
+      const TopoDS_Vertex    Vx = isfirst ? sp->FirstVertex() : sp->LastVertex();
+      const TopoDS_Edge      Ex = sp->Edges(isfirst ? 1 : sp->NbEdges());
+      TopoDS_Edge            Em;
+      ChFi3d_ConvexMitreData D;
+      const double           R = sp->Radius();
+      if (!ChFi3d_ConvexMitreAt(Vx, Ex, myVEMap, myEFMap, R, tol, Em, D))
+      {
+        continue;
+      }
+      if (S->SetOfSurfData().IsNull() || S->SetOfSurfData()->IsEmpty())
+      {
+        return false;
+      }
+      const occ::handle<ChFiDS_SurfData>& Fd =
+        isfirst ? S->SetOfSurfData()->Value(1) : S->SetOfSurfData()->Value(S->SetOfSurfData()->Length());
+      const int IA = DStr.AddShape(D.A);
+      const int IB = DStr.AddShape(D.B);
+      const int sA = Fd->IndexOfS1() == IA ? 1 : Fd->IndexOfS2() == IA ? 2 : 0;
+      if (sA == 0 || Fd->Index(3 - sA) != IB || Fd->IsOnCurve(1) || Fd->IsOnCurve(2))
+      {
+        return false;
+      }
+      const int                        sB  = 3 - sA;
+      const occ::handle<Geom_Surface>& SfP = DStr.Surface(Fd->Surf()).Surface();
+      const double                     rk = D.rk, rho = D.rho, phi = D.phi;
+      const gp_Pnt                     PA(D.O.XYZ() + R * D.nA.XYZ());
+      const gp_Pnt                     PB(D.O.XYZ() + R * D.nB.XYZ());
+      const gp_Pnt                     QA(D.O.XYZ() + rho * D.nA.XYZ() + rk * D.nT.XYZ());
+      const gp_Pnt                     QB(D.O.XYZ() + rho * D.nB.XYZ() + rk * D.nT.XYZ());
+
+      // The stripe's contacts end at PA and PB.
+      const auto onContact = [&](const int s, const gp_Pnt& X, double& t) {
+        const ChFiDS_FaceInterference& Fi = Fd->Interference(s);
+        const occ::handle<Geom_Curve>& Cc = DStr.Curve(Fi.LineIndex()).Curve();
+        if (Cc.IsNull() || Fi.PCurveOnSurf().IsNull())
+        {
+          return false;
+        }
+        const double f = Fi.FirstParameter(), l = Fi.LastParameter();
+        const double tEnd = isfirst ? f : l;
+        if (Cc->Value(tEnd).Distance(X) <= tol)
+        {
+          t = tEnd;
+          return true;
+        }
+        GeomAPI_ProjectPointOnCurve aPr(X, Cc, std::min(f, l), std::max(f, l));
+        if (aPr.NbPoints() == 0 || aPr.LowerDistance() > tol)
+        {
+          return false;
+        }
+        t = aPr.LowerDistanceParameter();
+        return true;
+      };
+      double tA = 0., tB = 0.;
+      if (!onContact(sA, PA, tA) || !onContact(sB, PB, tB))
+      {
+        return false;
+      }
+      const gp_Pnt2d uvPA = Fd->Interference(sA).PCurveOnSurf()->Value(tA);
+
+      // The torus: X along nA, Z along nT, Y towards nB.
+      gp_Ax3 aFrame(D.O, D.nT, D.nA);
+      if (gp_Vec(aFrame.YDirection()).Dot(gp_Vec(D.nB)) < 0.)
+      {
+        aFrame.YReverse();
+      }
+      const gp_Dir                            aY = aFrame.YDirection();
+      const occ::handle<Geom_ToroidalSurface> aT = new Geom_ToroidalSurface(aFrame, rho, rk);
+      const occ::handle<Geom_Curve> ce  = new Geom_TrimmedCurve(aT->VIso(0.), 0., phi);         // PA to PB
+      const occ::handle<Geom_Curve> cw  = new Geom_TrimmedCurve(aT->VIso(0.5 * M_PI), 0., phi); // QA to QB
+      const occ::handle<Geom_Curve> cka = new Geom_TrimmedCurve(aT->UIso(0.), 0., 0.5 * M_PI);  // PA to QA
+      const occ::handle<Geom_Curve> ckb = new Geom_TrimmedCurve(aT->UIso(phi), 0., 0.5 * M_PI); // PB to QB
+      if (ce->Value(0.).Distance(PA) > tol || ce->Value(phi).Distance(PB) > tol || cw->Value(0.).Distance(QA) > tol
+          || cw->Value(phi).Distance(QB) > tol || cka->Value(0.).Distance(PA) > tol
+          || cka->Value(0.5 * M_PI).Distance(QA) > tol || ckb->Value(0.).Distance(PB) > tol
+          || ckb->Value(0.5 * M_PI).Distance(QB) > tol)
+      {
+        return false;
+      }
+      const occ::handle<Geom2d_Curve> pTe  = new Geom2d_Line(gp_Pnt2d(0., 0.), gp_Dir2d(1., 0.));
+      const occ::handle<Geom2d_Curve> pTw  = new Geom2d_Line(gp_Pnt2d(0., 0.5 * M_PI), gp_Dir2d(1., 0.));
+      const occ::handle<Geom2d_Curve> pTka = new Geom2d_Line(gp_Pnt2d(0., 0.), gp_Dir2d(0., 1.));
+      const occ::handle<Geom2d_Curve> pTkb = new Geom2d_Line(gp_Pnt2d(phi, 0.), gp_Dir2d(0., 1.));
+      const TopoDS_Face               TF   = TopoDS::Face(D.T.Oriented(TopAbs_FORWARD));
+      const TopoDS_Face               KAF  = TopoDS::Face(D.KA.Oriented(TopAbs_FORWARD));
+      const TopoDS_Face               KBF  = TopoDS::Face(D.KB.Oriented(TopAbs_FORWARD));
+      const occ::handle<Geom_Surface> ST   = BRep_Tool::Surface(TF);
+      const occ::handle<Geom_Surface> SKA  = BRep_Tool::Surface(KAF);
+      const occ::handle<Geom_Surface> SKB  = BRep_Tool::Surface(KBF);
+      // (Parameters on a face near its own.)
+      const auto uvOnFace = [&](const TopoDS_Face& F, const occ::handle<Geom_Surface>& Sf, const gp_Pnt& X) {
+        double                     u = 0., v = 0.;
+        GeomAPI_ProjectPointOnSurf aPr(X, Sf);
+        if (aPr.NbPoints() > 0)
+        {
+          aPr.LowerDistanceParameters(u, v);
+        }
+        double u1 = 0., u2 = 0., v1 = 0., v2 = 0.;
+        BRepTools::UVBounds(F, u1, u2, v1, v2);
+        if (Sf->IsUPeriodic())
+        {
+          u = ElCLib::InPeriod(u, 0.5 * (u1 + u2) - 0.5 * Sf->UPeriod(), 0.5 * (u1 + u2) + 0.5 * Sf->UPeriod());
+        }
+        if (Sf->IsVPeriodic())
+        {
+          v = ElCLib::InPeriod(v, 0.5 * (v1 + v2) - 0.5 * Sf->VPeriod(), 0.5 * (v1 + v2) + 0.5 * Sf->VPeriod());
+        }
+        return gp_Pnt2d(u, v);
+      };
+      const occ::handle<Geom2d_Curve> pPe = ChFi3d_PCurveNear(ce, 0., phi, SfP, uvPA);
+      const occ::handle<Geom2d_Curve> pWt = ChFi3d_PCurveNear(cw, 0., phi, ST, uvOnFace(TF, ST, QA));
+      const occ::handle<Geom2d_Curve> pKa = ChFi3d_PCurveNear(cka, 0., 0.5 * M_PI, SKA, uvOnFace(KAF, SKA, PA));
+      const occ::handle<Geom2d_Curve> pKb = ChFi3d_PCurveNear(ckb, 0., 0.5 * M_PI, SKB, uvOnFace(KBF, SKB, PB));
+      if (pPe.IsNull() || pWt.IsNull() || pKa.IsNull() || pKb.IsNull())
+      {
+        return false;
+      }
+      const double dPe = ChFi3d_OffSurface(ce, pPe, SfP, 0., phi, tolapp3d);
+      const double dWt = ChFi3d_OffSurface(cw, pWt, ST, 0., phi, tolapp3d);
+      const double dKa = ChFi3d_OffSurface(cka, pKa, SKA, 0., 0.5 * M_PI, tolapp3d);
+      const double dKb = ChFi3d_OffSurface(ckb, pKb, SKB, 0., 0.5 * M_PI, tolapp3d);
+      if (dPe > tol || dWt > tol || dKa > tol || dKb > tol)
+      {
+        return false;
+      }
+
+      // The points: PA and PB on the edges A and B share with KA and KB,
+      // QA and QB on the edges KA and KB share with T, the parts towards V
+      // and W taken away.
+      const auto onEdge = [&](const TopoDS_Edge& E, const TopoDS_Vertex& Vaway, const gp_Pnt& X,
+                              ChFiDS_CommonPoint& cp) {
+        const TopoDS_Edge             EF = TopoDS::Edge(E.Oriented(TopAbs_FORWARD));
+        double                        f = 0., l = 0.;
+        const occ::handle<Geom_Curve> Ce = BRep_Tool::Curve(EF, f, l);
+        if (Ce.IsNull())
+        {
+          return false;
+        }
+        GeomAPI_ProjectPointOnCurve aPr(X, Ce, f, l);
+        if (aPr.NbPoints() == 0 || aPr.LowerDistance() > tol)
+        {
+          return false;
+        }
+        TopoDS_Vertex v1, v2;
+        TopExp::Vertices(EF, v1, v2);
+        cp.Reset();
+        cp.SetTolerance(tol);
+        cp.SetPoint(X);
+        cp.SetArc(tol, EF, aPr.LowerDistanceParameter(), v2.IsSame(Vaway) ? TopAbs_REVERSED : TopAbs_FORWARD);
+        return true;
+      };
+      ChFiDS_CommonPoint cpPA, cpPB, cpQA, cpQB;
+      if (!onEdge(D.Ea, D.V, PA, cpPA) || !onEdge(D.Eb, D.V, PB, cpPB) || !onEdge(D.Eta, D.W, QA, cpQA)
+          || !onEdge(D.Etb, D.W, QB, cpQB))
+      {
+        return false;
+      }
+      const int iPA = ChFi3d_IndexPointInDS(cpPA, DStr);
+      const int iPB = ChFi3d_IndexPointInDS(cpPB, DStr);
+      const int iQA = ChFi3d_IndexPointInDS(cpQA, DStr);
+      const int iQB = ChFi3d_IndexPointInDS(cpQB, DStr);
+
+      // The stripe's end: the arc.
+      {
+        ChFiDS_CommonPoint a = cpPA, b = cpPB;
+        a.SetParameter(Fd->Vertex(isfirst, sA).Parameter());
+        b.SetParameter(Fd->Vertex(isfirst, sB).Parameter());
+        Fd->ChangeVertex(isfirst, sA) = a;
+        Fd->ChangeVertex(isfirst, sB) = b;
+        Fd->ChangeInterference(sA).SetParameter(tA, isfirst);
+        Fd->ChangeInterference(sB).SetParameter(tB, isfirst);
+      }
+      const int Ie = DStr.AddCurve(TopOpeBRepDS_Curve(ce, dPe));
+      S->SetCurve(Ie, isfirst);
+      S->SetParameters(isfirst, 0., phi);
+      S->ChangePCurve(isfirst) = pPe;
+      S->SetIndexPoint(iPA, isfirst, sA);
+      S->SetIndexPoint(iPB, isfirst, sB);
+      S->SetOrientation(sA == 1 ? TopAbs_FORWARD : TopAbs_REVERSED, isfirst);
+      S->InDS(isfirst);
+
+      // The orientation: as the stripe's blend, where the surfaces' normals
+      // agree with its outwards.
+      bool sP = false;
+      {
+        gp_Pnt Pp;
+        gp_Vec du, dv;
+        SfP->D1(uvPA.X(), uvPA.Y(), Pp, du, dv);
+        sP = du.Crossed(dv).Dot(gp_Vec(D.nA)) > 0.;
+      }
+      TopAbs_Orientation aOrT = Fd->Orientation();
+      {
+        const double u = 0.5 * phi, v = 0.25 * M_PI;
+        gp_Pnt       Pt;
+        gp_Vec       du, dv;
+        aT->D1(u, v, Pt, du, dv);
+        const gp_Pnt Ct(D.O.XYZ() + rho * (std::cos(u) * D.nA.XYZ() + std::sin(u) * aY.XYZ()));
+        if ((du.Crossed(dv).Dot(gp_Vec(Ct, Pt)) > 0.) != sP)
+        {
+          aOrT = TopAbs::Reverse(aOrT);
+        }
+      }
+
+      // The torus: S1 on the stripe's blend (the arc), S2 on T, KA's
+      // meridian first, KB's last.
+      const double                 eps = 1.e-2 * rk;
+      occ::handle<ChFiDS_Stripe>   cT  = new ChFiDS_Stripe();
+      cT->ChangeSetOfSurfData()        = new NCollection_HSequence<occ::handle<ChFiDS_SurfData>>();
+      occ::handle<ChFiDS_SurfData> sT  = new ChFiDS_SurfData();
+      cT->ChangeSetOfSurfData()->Append(sT);
+      const int IsT = DStr.AddSurface(TopOpeBRepDS_Surface(aT, tolapp3d));
+      sT->ChangeSurf(IsT);
+      sT->ChangeOrientation() = aOrT;
+      sT->ChangeIndexOfS1(-Fd->Surf());
+      const int IT = DStr.AddShape(D.T);
+      sT->ChangeIndexOfS2(IT);
+      const int Iw  = DStr.AddCurve(TopOpeBRepDS_Curve(cw, dWt));
+      const int Ika = DStr.AddCurve(TopOpeBRepDS_Curve(cka, dKa));
+      const int Ikb = DStr.AddCurve(TopOpeBRepDS_Curve(ckb, dKb));
+      {
+        ChFiDS_FaceInterference& FI = sT->ChangeInterference(1);
+        FI.SetInterference(
+          Ie,
+          ChFi3d_KeptSideOn(ce, 0.5 * phi, pPe, SfP, gp_Pnt(ce->Value(0.5 * phi).XYZ() + eps * D.nT.XYZ())),
+          pPe,
+          pTe);
+        FI.SetFirstParameter(0.);
+        FI.SetLastParameter(phi);
+      }
+      {
+        const gp_Pnt Pw = cw->Value(0.5 * phi);
+        const gp_Vec aOut(gp_Pnt(D.O.XYZ() + rk * D.nT.XYZ()), Pw);
+        ChFiDS_FaceInterference& FI = sT->ChangeInterference(2);
+        FI.SetInterference(Iw,
+                           ChFi3d_KeptSideOn(cw, 0.5 * phi, pWt, ST, gp_Pnt(Pw.XYZ() + (eps / rho) * aOut.XYZ())),
+                           pWt,
+                           pTw);
+        FI.SetFirstParameter(0.);
+        FI.SetLastParameter(phi);
+      }
+      sT->ChangeVertex(true, 1)  = cpPA;
+      sT->ChangeVertex(true, 2)  = cpQA;
+      sT->ChangeVertex(false, 1) = cpPB;
+      sT->ChangeVertex(false, 2) = cpQB;
+      cT->ChangeFirstCurve(Ika);
+      cT->ChangeFirstParameters(0., 0.5 * M_PI);
+      cT->ChangeFirstPCurve() = pTka;
+      cT->FirstPCurveOrientation(TopAbs_FORWARD);
+      cT->ChangeIndexFirstPointOnS1(iPA);
+      cT->ChangeIndexFirstPointOnS2(iQA);
+      cT->ChangeLastCurve(Ikb);
+      cT->ChangeLastParameters(0., 0.5 * M_PI);
+      cT->ChangeLastPCurve() = pTkb;
+      cT->LastPCurveOrientation(TopAbs_FORWARD);
+      cT->ChangeIndexLastPointOnS1(iPB);
+      cT->ChangeIndexLastPointOnS2(iQB);
+      cT->SetSolidIndex(S->SolidIndex());
+      aCorners.Append(cT);
+
+      // KA and KB cut along the meridians, the parts towards the mitre
+      // taken away.
+      const int    IKA = DStr.AddShape(D.KA);
+      const int    IKB = DStr.AddShape(D.KB);
+      // (Along the torus's u at KA's meridian towards KB, and back at KB's.)
+      const gp_XYZ aToB = aY.XYZ();
+      const gp_XYZ aToA = std::sin(phi) * D.nA.XYZ() - std::cos(phi) * aY.XYZ();
+      DStr.ChangeShapeInterferences(IKA).Append(ChFi3d_FilCurveInDS(
+        Ika,
+        IKA,
+        pKa,
+        ChFi3d_KeptSideOn(cka, 0.25 * M_PI, pKa, SKA, gp_Pnt(cka->Value(0.25 * M_PI).XYZ() + eps * aToB))));
+      DStr.ChangeShapeInterferences(IKB).Append(ChFi3d_FilCurveInDS(
+        Ikb,
+        IKB,
+        pKb,
+        ChFi3d_KeptSideOn(ckb, 0.25 * M_PI, pKb, SKB, gp_Pnt(ckb->Value(0.25 * M_PI).XYZ() + eps * aToA))));
+      for (const int Ik : {Ika, Ikb})
+      {
+        ChFiDS_Regul aReg;
+        aReg.SetCurve(Ik);
+        aReg.SetS1(IsT, false);
+        aReg.SetS2(Ik == Ika ? IKA : IKB, true);
+        myRegul.Append(aReg);
+      }
+      // (The torus is generated from the mitre's edge.)
+      if (!myEVIMap.IsBound(Em))
+      {
+        myEVIMap.Bind(Em, NCollection_List<int>());
+      }
+      myEVIMap.ChangeFind(Em).Append(IsT);
+    }
+  }
+  for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itC(aCorners); itC.More(); itC.Next())
+  {
+    myListStripe.Append(itC.Value());
+  }
+  return true;
+}
+
 //=======================================================================
 // function : PerformRolledPastEnd
 // purpose  : The end of a lone stripe at a vertex of more than three edges
