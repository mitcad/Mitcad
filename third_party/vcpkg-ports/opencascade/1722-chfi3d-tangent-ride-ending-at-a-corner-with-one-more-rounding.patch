+//=======================================================================
+// function : PerformTwoCornerAtRideEnd
+// purpose  : The corner of two stripes at a vertex where one of them (the
+//            big) is a stripe of a tangent ride (RideOnBlend), its side on
+//            the face between the two roundings ending at a mere point on
+//            the face at the end, and the other (the small) has its other
+//            side on that face at the end: the small is cut by the big's
+//            blend, from the crossing of their contacts on their common
+//            face to the point where the small's contact on the face at the
+//            end meets the big's blend; the big is cut by the small's blend
+//            up to there and by the face at the end from there to the ride's
+//            point (as PerformTwoCornerbyInter's bevel of a big and a small
+//            blend whose pivot points differ).
+//=======================================================================
+
+bool ChFi3d_Builder::PerformTwoCornerAtRideEnd(const int Index)
+{
+  const TopoDS_Vertex&        Vtx  = myVDataMap.FindKey(Index);
+  TopOpeBRepDS_DataStructure& DStr = myDS->ChangeDS();
+  if (myVDataMap(Index).Extent() != 2)
+  {
+    return false;
+  }
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator It(myVDataMap(Index));
+  occ::handle<ChFiDS_Stripe> Corner1 = It.Value();
+  It.Next();
+  occ::handle<ChFiDS_Stripe> Corner2 = It.Value();
+  if (Corner1 == Corner2)
+  {
+    return false;
+  }
+  const bool aRide1 = IsTangentRide(Corner1) || IsTangentRideOn(Corner1);
+  const bool aRide2 = IsTangentRide(Corner2) || IsTangentRideOn(Corner2);
+  if (!aRide1 && !aRide2)
+  {
+    return false;
+  }
+  int Sens1 = 0, Sens2 = 0;
+  int IFd1 = ChFi3d_IndexOfSurfData(Vtx, Corner1, Sens1);
+  int IFd2 = ChFi3d_IndexOfSurfData(Vtx, Corner2, Sens2);
+  const bool isfirst1 = (Sens1 == 1);
+  const bool isfirst2 = (Sens2 == 1);
+  bool        OkinterCC = false, Okvisavis = false, SameSide = false;
+  int         IFaCo1 = 0, IFaCo2 = 0;
+  double      UIntPC1 = 0., UIntPC2 = 0.;
+  TopoDS_Face FaCo;
+  OkinterCC = ChFi3d_IsInFront(DStr,
+                               Corner1,
+                               Corner2,
+                               IFd1,
+                               IFd2,
+                               Sens1,
+                               Sens2,
+                               UIntPC1,
+                               UIntPC2,
+                               FaCo,
+                               SameSide,
+                               IFaCo1,
+                               IFaCo2,
+                               Okvisavis,
+                               Vtx,
+                               true);
+  if (!Okvisavis || !OkinterCC)
+  {
+    return false;
+  }
+  const int                    IFaArc1 = 3 - IFaCo1, IFaArc2 = 3 - IFaCo2;
+  occ::handle<ChFiDS_SurfData> Fd1     = Corner1->SetOfSurfData()->Value(IFd1);
+  occ::handle<ChFiDS_SurfData> Fd2     = Corner2->SetOfSurfData()->Value(IFd2);
+  const ChFiDS_CommonPoint&    CP1     = Fd1->Vertex(isfirst1, IFaArc1);
+  const ChFiDS_CommonPoint&    CP2     = Fd2->Vertex(isfirst2, IFaArc2);
+  // The big: the ride's stripe, its point on the face between a mere point;
+  // the small's point on the face at the end on an arc of it.
+  int aBig = 0;
+  if (aRide1 && !CP1.IsOnArc() && CP2.IsOnArc())
+  {
+    aBig = 1;
+  }
+  else if (aRide2 && !CP2.IsOnArc() && CP1.IsOnArc())
+  {
+    aBig = 2;
+  }
+  if (aBig == 0)
+  {
+    return false;
+  }
+  occ::handle<ChFiDS_Stripe>   BigCD  = aBig == 1 ? Corner1 : Corner2;
+  occ::handle<ChFiDS_Stripe>   SmaCD  = aBig == 1 ? Corner2 : Corner1;
+  occ::handle<ChFiDS_SurfData> BigFD  = aBig == 1 ? Fd1 : Fd2;
+  occ::handle<ChFiDS_SurfData> SmaFD  = aBig == 1 ? Fd2 : Fd1;
+  const int    IFaCoBig   = aBig == 1 ? IFaCo1 : IFaCo2;
+  const int    IFaCoSma   = aBig == 1 ? IFaCo2 : IFaCo1;
+  const int    IFaArcBig  = aBig == 1 ? IFaArc1 : IFaArc2;
+  const int    IFaArcSma  = aBig == 1 ? IFaArc2 : IFaArc1;
+  const bool   isfirstBig = aBig == 1 ? isfirst1 : isfirst2;
+  const bool   isfirstSma = aBig == 1 ? isfirst2 : isfirst1;
+  double       UIntPCBig  = aBig == 1 ? UIntPC1 : UIntPC2;
+  double       UIntPCSma  = aBig == 1 ? UIntPC2 : UIntPC1;
+  // (Two constant roundings of one radius: where their edges meet square,
+  // their blends' intersection is singular, two curves crossing.)
+  {
+    const occ::handle<ChFiDS_FilSpine> aFsB = occ::down_cast<ChFiDS_FilSpine>(BigCD->Spine());
+    const occ::handle<ChFiDS_FilSpine> aFsS = occ::down_cast<ChFiDS_FilSpine>(SmaCD->Spine());
+    if (aFsB.IsNull() || aFsS.IsNull() || !aFsB->IsConstant() || !aFsS->IsConstant()
+        || std::abs(aFsB->Radius() - aFsS->Radius()) <= 1.e-3 * aFsB->Radius())
+    {
+      return false;
+    }
+  }
+  // The face at the end: the small's other face, where the ride's point lies.
+  if (SmaFD->Index(IFaArcSma) <= 0 || BigFD->Index(IFaCoBig) <= 0)
+  {
+    return false;
+  }
+  const TopoDS_Face F = TopoDS::Face(DStr.Shape(SmaFD->Index(IFaArcSma)));
+  const gp_Pnt      aRidePoint = BigFD->Vertex(isfirstBig, IFaArcBig).Point();
+  {
+    GeomAPI_ProjectPointOnSurf aPr(aRidePoint, BRep_Tool::Surface(F));
+    if (aPr.NbPoints() == 0 || aPr.LowerDistance() > 10. * tolapp3d)
+    {
+      return false;
+    }
+  }
+  const ChFiDS_FaceInterference& FiArcSma = SmaFD->Interference(IFaArcSma);
+  if (FiArcSma.LineIndex() <= 0 || FiArcSma.PCurveOnFace().IsNull()
+      || BigFD->Interference(IFaArcBig).PCurveOnSurf().IsNull())
+  {
+    return false;
+  }
+  occ::handle<GeomAdaptor_Surface> BigHS = ChFi3d_BoundSurf(DStr, BigFD, IFaCoBig, IFaArcBig);
+  occ::handle<GeomAdaptor_Surface> SmaHS = ChFi3d_BoundSurf(DStr, SmaFD, IFaCoSma, IFaArcSma);
+  NCollection_Array1<double>       Pardeb(1, 4), Parfin(1, 4);
+  occ::handle<Geom2d_Curve>        PGc1, PGc2;
+  occ::handle<Geom_Curve>          Gc;
+
+  // Intersection of the big with the small, from the crossing of their
+  // contacts on their common face.
+  ChFi3d_ComputesIntPC(SmaFD->Interference(IFaCoSma),
+                       BigFD->Interference(IFaCoBig),
+                       SmaHS,
+                       BigHS,
+                       UIntPCSma,
+                       UIntPCBig);
+  gp_Pnt2d UVi = BigFD->Interference(IFaCoBig).PCurveOnSurf()->Value(UIntPCBig);
+  Pardeb(3)    = UVi.X();
+  Pardeb(4)    = UVi.Y();
+  UVi          = SmaFD->Interference(IFaCoSma).PCurveOnSurf()->Value(UIntPCSma);
+  Pardeb(1)    = UVi.X();
+  Pardeb(2)    = UVi.Y();
+  const gp_Pnt PFaCo = SmaHS->Value(UVi.X(), UVi.Y());
+  // ... to where the small's contact on the face at the end meets the big's
+  // blend.
+  occ::handle<Geom_Curve>        ctg  = DStr.Curve(FiArcSma.LineIndex()).Curve();
+  occ::handle<GeomAdaptor_Curve> Hctg = new GeomAdaptor_Curve();
+  double                         temp = 0., wi = 0.;
+  if (isfirstSma)
+  {
+    wi = temp = FiArcSma.FirstParameter();
+    if (UIntPCSma < temp)
+    {
+      temp = UIntPCSma;
+    }
+    Hctg->Load(ctg, temp, FiArcSma.LastParameter());
+  }
+  else
+  {
+    wi = temp = FiArcSma.LastParameter();
+    if (UIntPCSma > temp)
+    {
+      temp = UIntPCSma;
+    }
+    Hctg->Load(ctg, FiArcSma.FirstParameter(), temp);
+  }
+  if (!ChFi3d_IntCS(BigHS, Hctg, UVi, wi))
+  {
+    return false;
+  }
+  Parfin(3)         = UVi.X();
+  Parfin(4)         = UVi.Y();
+  UVi               = FiArcSma.PCurveOnSurf()->Value(wi);
+  Parfin(1)         = UVi.X();
+  Parfin(2)         = UVi.Y();
+  const gp_Pnt PMil = SmaHS->Value(Parfin(1), Parfin(2));
+  double       tolreached = tolapp3d;
+  if (!ChFi3d_ComputeCurves(SmaHS, BigHS, Pardeb, Parfin, Gc, PGc1, PGc2, tolapp3d, tol2d, tolreached))
+  {
+    return false;
+  }
+  // The intersection of the big with the face at end, from there to the
+  // ride's point.
+  occ::handle<BRepAdaptor_Surface> HF = new BRepAdaptor_Surface(F);
+  NCollection_Array1<double>       Pardeb2(1, 4), Parfin2(1, 4);
+  occ::handle<Geom2d_Curve>        PGf1, PGf2;
+  occ::handle<Geom_Curve>          Gf;
+  double                           tolreached2 = tolapp3d;
+  {
+    const gp_Pnt2d aMilOnF = FiArcSma.PCurveOnFace()->Value(wi);
+    Pardeb2(1)             = aMilOnF.X();
+    Pardeb2(2)             = aMilOnF.Y();
+    Pardeb2(3)             = Parfin(3);
+    Pardeb2(4)             = Parfin(4);
+    GeomAPI_ProjectPointOnSurf aPr(aRidePoint, BRep_Tool::Surface(F));
+    double                     u = 0., v = 0.;
+    aPr.LowerDistanceParameters(u, v);
+    Parfin2(1)                = u;
+    Parfin2(2)                = v;
+    const double   ptg        = BigFD->Interference(IFaArcBig).Parameter(isfirstBig);
+    const gp_Pnt2d aEndOnBig  = BigFD->Interference(IFaArcBig).PCurveOnSurf()->Value(ptg);
+    Parfin2(3)                = aEndOnBig.X();
+    Parfin2(4)                = aEndOnBig.Y();
+    double uu1 = 0., uu2 = 0., vv1 = 0., vv2 = 0.;
+    ChFi3d_Boite(aMilOnF, gp_Pnt2d(u, v), uu1, uu2, vv1, vv2);
+    ChFi3d_BoundFac(*HF, uu1, uu2, vv1, vv2, true);
+    if (PMil.Distance(aRidePoint) > 10. * tolapp3d
+        && !ChFi3d_ComputeCurves(HF, BigHS, Pardeb2, Parfin2, Gf, PGf1, PGf2, tolapp3d, tol2d, tolreached2))
+    {
+      return false;
+    }
+  }
+
+  // The small: cut by the big's blend; its points there mere points.
+  double              WFirst  = Gc->FirstParameter();
+  double              WLast   = Gc->LastParameter();
+  ChFiDS_CommonPoint& psmaco  = SmaFD->ChangeVertex(isfirstSma, IFaCoSma);
+  ChFiDS_CommonPoint& pbigco  = BigFD->ChangeVertex(isfirstBig, IFaCoBig);
+  const double        tolpco  = std::max(psmaco.Tolerance(), pbigco.Tolerance());
+  ChFiDS_CommonPoint& psmamil = SmaFD->ChangeVertex(isfirstSma, IFaArcSma);
+  const double        tolpmil = psmamil.Tolerance();
+  int                 ICurv   = DStr.AddCurve(TopOpeBRepDS_Curve(Gc, tolreached));
+  SmaCD->SetParameters(isfirstSma, WFirst, WLast);
+  SmaCD->SetCurve(ICurv, isfirstSma);
+  SmaCD->ChangePCurve(isfirstSma) = PGc1;
+  psmaco.Reset();
+  psmaco.SetPoint(PFaCo);
+  psmaco.SetTolerance(std::max(tolpco, tolreached));
+  SmaFD->ChangeInterference(IFaCoSma).SetParameter(UIntPCSma, isfirstSma);
+  psmamil.Reset();
+  psmamil.SetPoint(PMil);
+  psmamil.SetTolerance(std::max(tolpmil, tolreached));
+  SmaFD->ChangeInterference(IFaArcSma).SetParameter(wi, isfirstSma);
+  const int IpointCo = ChFi3d_IndexPointInDS(psmaco, DStr);
+  SmaCD->SetIndexPoint(IpointCo, isfirstSma, IFaCoSma);
+  const int IpointMil = ChFi3d_IndexPointInDS(psmamil, DStr);
+  SmaCD->SetIndexPoint(IpointMil, isfirstSma, IFaArcSma);
+  if (IFaCoSma == 2)
+  {
+    SmaCD->SetOrientation(TopAbs_REVERSED, isfirstSma);
+  }
+
+  // The big: its end curves put in the data structure here.
+  BigCD->SetIndexPoint(IpointCo, isfirstBig, IFaCoBig);
+  BigFD->ChangeVertex(isfirstBig, IFaCoBig) = psmaco;
+  BigFD->ChangeInterference(IFaCoBig).SetParameter(UIntPCBig, isfirstBig);
+  NCollection_List<occ::handle<TopOpeBRepDS_Interference>>& Li = DStr.ChangeCurveInterferences(ICurv);
+  Li.Append(ChFi3d_FilPointInDS(TopAbs_FORWARD, ICurv, IpointCo, WFirst));
+  Li.Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, ICurv, IpointMil, WLast));
+  // (The transition of the curves on the big, from its side 1 as for the
+  // bevel; from its side 2, the other way, where side 1 is on no face.)
+  TopAbs_Orientation tracurv = TopAbs_FORWARD;
+  if (BigFD->IndexOfS1() > 0)
+  {
+    tracurv = TopAbs::Compose(TopAbs::Compose(DStr.Shape(BigFD->IndexOfS1()).Orientation(), BigFD->Orientation()),
+                              BigFD->InterferenceOnS1().Transition());
+  }
+  else if (BigFD->IndexOfS2() > 0)
+  {
+    tracurv = TopAbs::Reverse(
+      TopAbs::Compose(TopAbs::Compose(DStr.Shape(BigFD->IndexOfS2()).Orientation(), BigFD->Orientation()),
+                      BigFD->InterferenceOnS2().Transition()));
+  }
+  else
+  {
+    return false;
+  }
+  if (!isfirstBig)
+  {
+    tracurv = TopAbs::Reverse(tracurv);
+  }
+  if (IFaCoBig != 1)
+  {
+    tracurv = TopAbs::Reverse(tracurv);
+  }
+  const int ISurf = BigFD->Surf();
+  DStr.ChangeSurfaceInterferences(ISurf).Append(ChFi3d_FilCurveInDS(ICurv, ISurf, PGc2, tracurv));
+  ChFiDS_CommonPoint& cpend = BigFD->ChangeVertex(isfirstBig, IFaArcBig);
+  if (Gf.IsNull())
+  {
+    // (The ride's point is the small's point on the face at the end.)
+    BigCD->SetIndexPoint(IpointMil, isfirstBig, IFaArcBig);
+    cpend = psmamil;
+  }
+  else
+  {
+    const double WFirst2 = Gf->FirstParameter();
+    const double WLast2  = Gf->LastParameter();
+    const int    ICurv2  = DStr.AddCurve(TopOpeBRepDS_Curve(Gf, tolreached2));
+    cpend.SetTolerance(std::max(cpend.Tolerance(), tolreached2));
+    const int IpointArc = ChFi3d_IndexPointInDS(cpend, DStr);
+    BigCD->SetIndexPoint(IpointArc, isfirstBig, IFaArcBig);
+    NCollection_List<occ::handle<TopOpeBRepDS_Interference>>& Li2 = DStr.ChangeCurveInterferences(ICurv2);
+    Li2.Append(ChFi3d_FilPointInDS(TopAbs_FORWARD, ICurv2, IpointMil, WFirst2));
+    Li2.Append(ChFi3d_FilPointInDS(TopAbs_REVERSED, ICurv2, IpointArc, WLast2));
+    DStr.ChangeSurfaceInterferences(ISurf).Append(ChFi3d_FilCurveInDS(ICurv2, ISurf, PGf2, tracurv));
+    // On the face at the end: the face keeps the side of the curve away
+    // from the vertex, which the blends take away.
+    const double tm = 0.5 * (WFirst2 + WLast2);
+    gp_Pnt       aP;
+    gp_Vec       aT;
+    Gf->D1(tm, aP, aT);
+    const gp_Pnt2d     aUV = PGf1->Value(tm);
+    BRepLProp_SLProps  aProps(*HF, aUV.X(), aUV.Y(), 1, Precision::Confusion());
+    TopAbs_Orientation traface = TopAbs_FORWARD;
+    if (aProps.IsNormalDefined())
+    {
+      // (The surface's own normal: the transition is the curve's on the face
+      // taken FORWARD, as the edges' orientations in it.)
+      const gp_Vec aN(aProps.Normal());
+      // (FORWARD where the vertex's side, which goes, lies on the curve's
+      // right about that normal.)
+      const gp_Vec aLeft = aN.Crossed(aT);
+      if (aLeft.Dot(gp_Vec(aP, BRep_Tool::Pnt(Vtx))) > 0.)
+      {
+        traface = TopAbs_REVERSED;
+      }
+    }
+    const int IShape = DStr.AddShape(F);
+    DStr.ChangeShapeInterferences(IShape).Append(ChFi3d_FilCurveInDS(ICurv2, IShape, PGf1, traface));
+  }
+  BigCD->InDS(isfirstBig);
+  return true;
+}
+
