 // function : UpdateTolesp
 // purpose  : Update tolesp field to fit it to range of parameter of spine curve
diff --git a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_FilBuilder_C2.cxx b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_FilBuilder_C2.cxx
index da82d205..b18d52f9 100644
--- a/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_FilBuilder_C2.cxx
+++ b/src/ModelingAlgorithms/TKFillet/ChFi3d/ChFi3d_FilBuilder_C2.cxx
@@ -175,6 +175,13 @@ void ChFi3d_FilBuilder::PerformTwoCorner(const int Index)
     done = true;
     return;
   }
+  // (A tangent ride's stripe ending at a mere point on the face at the end,
+  // the other stripe's other face.)
+  if (PerformTwoCornerAtRideEnd(Index))
+  {
+    done = true;
+    return;
+  }
   const TopoDS_Vertex&                                   Vtx  = myVDataMap.FindKey(Index);
   TopOpeBRepDS_DataStructure&                            DStr = myDS->ChangeDS();
   NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator It;
