+// Whether stripes A's and B's contacts on face F, each of one SurfData
+// computed on the faces of its edge, pass each other all along without
+// crossing: B's contact nowhere farther from A's edge than A's contact (within
+// a tolerance) and nearer it somewhere, and the two contacts run the whole
+// length of the face between (their ends at each other's): the face is
+// nowhere wider than the two roundings together (it may be as wide as both at
+// a point), so that B's ball rolls tangent on A's blend all along
+// (RideOnBlend).
+static bool contactsPassAllAlong(const TopOpeBRepDS_DataStructure& DStr,
+                                 const occ::handle<ChFiDS_Stripe>& A,
+                                 const occ::handle<ChFiDS_Stripe>& B,
+                                 const TopoDS_Face&                F,
+                                 const double                      Tol)
+{
+  occ::handle<ChFiDS_SurfData> SA, SB;
+  int                          onA = 0, onB = 0;
+  if (!findRideSurfData(DStr, A, F, SA, onA) || !findRideSurfData(DStr, B, F, SB, onB) || SA->IsOnCurve(onA)
+      || SB->IsOnCurve(onB))
+  {
+    return false;
+  }
+  const ChFiDS_FaceInterference& FA = SA->Interference(onA);
+  const ChFiDS_FaceInterference& FB = SB->Interference(onB);
+  if (FA.LineIndex() <= 0 || FB.LineIndex() <= 0)
+  {
+    return false;
+  }
+  const occ::handle<Geom_Curve> CA = DStr.Curve(FA.LineIndex()).Curve();
+  const occ::handle<Geom_Curve> CB = DStr.Curve(FB.LineIndex()).Curve();
+  const TopoDS_Edge             EA = spineEdgeOf(A->Spine(), F);
+  if (CA.IsNull() || CB.IsNull() || EA.IsNull())
+  {
+    return false;
+  }
+  const double aLo = std::min(FA.FirstParameter(), FA.LastParameter());
+  const double aHi = std::max(FA.FirstParameter(), FA.LastParameter());
+  const double bLo = std::min(FB.FirstParameter(), FB.LastParameter());
+  const double bHi = std::max(FB.FirstParameter(), FB.LastParameter());
+  if (aHi - aLo <= Precision::PConfusion() || bHi - bLo <= Precision::PConfusion())
+  {
+    return false;
+  }
+  // (The ends of each contact at the other's ends: the contacts span the
+  // face's length alike.)
+  const double aLen = CA->Value(aLo).Distance(CA->Value(aHi));
+  for (const double t : {bLo, bHi})
+  {
+    const gp_Pnt X = CB->Value(t);
+    if (std::min(X.Distance(CA->Value(aLo)), X.Distance(CA->Value(aHi))) > 0.5 * aLen)
+    {
+      return false;
+    }
+  }
+  bool aBeyond = false;
+  for (int i = 1; i < 20; i++)
+  {
+    const gp_Pnt                X = CB->Value(bLo + (bHi - bLo) * i / 20.);
+    GeomAPI_ProjectPointOnCurve aPr(X, CA, aLo, aHi);
+    if (aPr.NbPoints() == 0)
+    {
+      return false;
+    }
+    const double dB = distanceToEdge(X, EA);
+    const double dA = distanceToEdge(aPr.NearestPoint(), EA);
+    if (dB == RealLast() || dA == RealLast() || dB > dA + 10. * Tol)
+    {
+      return false;
+    }
+    aBeyond = aBeyond || dB < dA - 10. * Tol;
+  }
+  return aBeyond;
+}
