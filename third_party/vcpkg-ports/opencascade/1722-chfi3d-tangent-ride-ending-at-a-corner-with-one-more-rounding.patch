+// Whether a tangent ride (RideOnBlend) may end at vertex V of stripe S's
+// spine, F the face between the two roundings: V holds S alone, or S and one
+// other constant rounding of another radius whose spine's edge at V does not
+// bound F, at a vertex of three edges (the corner PerformTwoCornerAtRideEnd
+// makes).
+bool ChFi3d_Builder::rideEndCornerAllowed(const TopoDS_Vertex&              V,
+                                          const occ::handle<ChFiDS_Stripe>& S,
+                                          const TopoDS_Face&                F) const
+{
+  for (int j = 1; j <= myVDataMap.Extent(); j++)
+  {
+    if (!myVDataMap.FindKey(j).IsSame(V))
+    {
+      continue;
+    }
+    const NCollection_List<occ::handle<ChFiDS_Stripe>>& aL = myVDataMap.FindFromIndex(j);
+    if (aL.Extent() == 1)
+    {
+      return true;
+    }
+    if (aL.Extent() != 2 || !myVEMap.Contains(V))
+    {
+      return false;
+    }
+    if (ChFi3d_NumberOfSharpEdges(V, myVEMap, myEFMap) != 3)
+    {
+      return false;
+    }
+    const occ::handle<ChFiDS_Stripe>& O = aL.First() == S ? aL.Last() : aL.First();
+    if (O == S)
+    {
+      return false;
+    }
+    // (Of constant roundings of different radii: of one radius, their
+    // blends' intersection at a square corner is singular.)
+    const occ::handle<ChFiDS_FilSpine> aFsS = occ::down_cast<ChFiDS_FilSpine>(S->Spine());
+    const occ::handle<ChFiDS_FilSpine> aFsO = occ::down_cast<ChFiDS_FilSpine>(O->Spine());
+    if (aFsS.IsNull() || aFsO.IsNull() || !aFsS->IsConstant() || !aFsO->IsConstant()
+        || std::abs(aFsS->Radius() - aFsO->Radius()) <= 1.e-3 * aFsS->Radius())
+    {
+      return false;
+    }
+    const occ::handle<ChFiDS_Spine>& SpO = O->Spine();
+    TopoDS_Edge                      EO;
+    for (int i = 1; i <= SpO->NbEdges() && EO.IsNull(); i++)
+    {
+      TopoDS_Vertex V1, V2;
+      TopExp::Vertices(SpO->Edges(i), V1, V2);
+      if (V1.IsSame(V) || V2.IsSame(V))
+      {
+        EO = SpO->Edges(i);
+      }
+    }
+    if (EO.IsNull() || !myEFMap.Contains(EO))
+    {
+      return false;
+    }
+    for (NCollection_List<TopoDS_Shape>::Iterator itF(myEFMap(EO)); itF.More(); itF.Next())
+    {
+      if (itF.Value().IsSame(F))
+      {
+        return false;
+      }
+    }
+    return true;
+  }
+  return false;
+}
+
+// P-curve PC (on surface S) moved by whole periods of S so that its point at
+// parameter T lies within half a period of the nearest point of the other
+// interference's p-curve on S (a SurfData's two sides lie within a period).
+static occ::handle<Geom2d_Curve> inPeriodOf(const occ::handle<Geom2d_Curve>& PC,
+                                            const double                     T,
+                                            const ChFiDS_FaceInterference&   Other,
+                                            const occ::handle<Geom_Surface>& S)
+{
+  if (PC.IsNull() || S.IsNull() || Other.PCurveOnSurf().IsNull() || (!S->IsUPeriodic() && !S->IsVPeriodic()))
+  {
+    return PC;
+  }
+  const gp_Pnt2d P = PC->Value(T);
+  gp_Pnt2d       R = Other.PCurveOnSurf()->Value(Other.FirstParameter());
+  double         aBest = RealLast();
+  for (int i = 0; i <= 10; i++)
+  {
+    const gp_Pnt2d Q =
+      Other.PCurveOnSurf()->Value(Other.FirstParameter() + (Other.LastParameter() - Other.FirstParameter()) * i / 10.);
+    const double d = std::min(S->IsUPeriodic() ? std::abs(std::remainder(Q.X() - P.X(), S->UPeriod())) : 0.,
+                              RealLast())
+                     + (S->IsVPeriodic() ? std::abs(std::remainder(Q.Y() - P.Y(), S->VPeriod())) : 0.);
+    if (d < aBest)
+    {
+      aBest = d;
+      R     = Q;
+    }
+  }
+  gp_Vec2d aShift(0., 0.);
+  if (S->IsUPeriodic())
+  {
+    aShift.SetX(S->UPeriod() * std::round((R.X() - P.X()) / S->UPeriod()));
+  }
+  if (S->IsVPeriodic())
+  {
+    aShift.SetY(S->VPeriod() * std::round((R.Y() - P.Y()) / S->VPeriod()));
+  }
+  if (aShift.Magnitude() <= Precision::PConfusion())
+  {
+    return PC;
+  }
+  return occ::down_cast<Geom2d_Curve>(PC->Translated(aShift));
+}
