+bool BRepBlend_SurfRstLineBuilder::FindTouchOverSliver(Blend_SurfRstFunction& Func,
+                                                       const double           P0,
+                                                       const math_Vector&     S0)
+{
+  math_Vector tolerance(1, 3), infb(1, 3), supb(1, 3);
+  Func.GetTolerance(tolerance, tolpoint3d);
+  Func.GetBounds(infb, supb);
+  math_FunctionSetRoot rsnld(Func, tolerance, 30);
+  double      pa = P0, pb = param, ga = 0., gb = 0.;
+  math_Vector sa(S0), sb(sol), sm(1, 3);
+  Func.Set(pa);
+  if (!SliverGap(Func, sa, ga) || !SliverGap(Func, sb, gb) || ga < 0. || gb >= 0.)
+  {
+    Func.Set(param);
+    return false;
+  }
+  for (int it = 0; it < 100; it++)
+  {
+    const double pm = it % 2 == 0 ? pa + (pb - pa) * ga / (ga - gb) : 0.5 * (pa + pb);
+    Func.Set(pm);
+    rsnld.Perform(Func, sa, infb, supb);
+    if (!rsnld.IsDone())
+    {
+      break;
+    }
+    rsnld.Root(sm);
+    double gm = 0.;
+    if (!Func.IsSolution(sm, tolpoint3d) || !SliverGap(Func, sm, gm))
+    {
+      break;
+    }
+    if (std::abs(gm) <= 1.e-3 * tolpoint3d || std::abs(pb - pa) <= Precision::PConfusion())
+    {
+      param = pm;
+      sol   = sm;
+      return true;
+    }
+    if (gm > 0.)
+    {
+      pa = pm;
+      sa = sm;
+      ga = gm;
+    }
+    else
+    {
+      pb = pm;
+      sb = sm;
+      gb = gm;
+    }
+  }
+  Func.Set(param);
+  return false;
+}
