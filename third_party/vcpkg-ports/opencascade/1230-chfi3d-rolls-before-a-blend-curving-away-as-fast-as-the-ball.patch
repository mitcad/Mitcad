+bool BRepBlend_SurfRstLineBuilder::SliverGap(Blend_SurfRstFunction& Func,
+                                             const math_Vector&     theSol,
+                                             double&                theGap) const
+{
+  gp_Pnt centre;
+  if (!Func.Centre(theSol, centre))
+  {
+    return false;
+  }
+  const double radius = centre.Distance(surf1->Value(theSol(1), theSol(2)));
+  bool         found  = false;
+  theGap              = RealLast();
+  for (int k = 0; k < 2; k++)
+  {
+    occ::handle<Adaptor3d_Curve> next;
+    if (!Func.NextEdgePassedOver(k == 1) || !Func.NextCurveAtEnd(k == 1, next) || next.IsNull())
+    {
+      continue;
+    }
+    const double  w1 = next->FirstParameter(), w2 = next->LastParameter();
+    Extrema_ExtPC anExt(centre, *next, w1, w2, Precision::PConfusion());
+    for (int i = 1; anExt.IsDone() && i <= anExt.NbExt(); i++)
+    {
+      if (anExt.IsMin(i))
+      {
+        theGap = std::min(theGap, std::sqrt(anExt.SquareDistance(i)) - radius);
+        found  = true;
+      }
+    }
+    for (const double w : {w1, w2})
+    {
+      theGap = std::min(theGap, centre.Distance(next->Value(w)) - radius);
+      found  = true;
+    }
+  }
+  return found;
+}
