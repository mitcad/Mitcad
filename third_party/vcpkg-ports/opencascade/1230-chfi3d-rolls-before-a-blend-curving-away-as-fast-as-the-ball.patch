+bool ChFi3d_Builder::RollsBeforeTangent(const occ::handle<ChFiDS_Stripe>& S, const TopoDS_Shape& F) const
+{
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itS(myRollTangentStripes);
+  NCollection_List<TopoDS_Shape>::Iterator               itF(myRollTangentFaces);
+  for (; itS.More(); itS.Next(), itF.Next())
+  {
+    if (itS.Value() == S && itF.Value().IsSame(F))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ChFi3d_Builder::RollsBeforeTangent(const occ::handle<ChFiDS_Spine>& Sp, const TopoDS_Shape& F) const
+{
+  if (Sp.IsNull() || F.IsNull())
+  {
+    return false;
+  }
+  NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator itS(myRollTangentStripes);
+  NCollection_List<TopoDS_Shape>::Iterator               itF(myRollTangentFaces);
+  for (; itS.More(); itS.Next(), itF.Next())
+  {
+    if (itS.Value()->Spine() == Sp && itF.Value().IsSame(F))
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ChFi3d_Builder::PassesOverEdge(const occ::handle<ChFiDS_Spine>& Sp,
+                                    const TopoDS_Face&               F,
+                                    const TopoDS_Edge&               E) const
+{
+  if (Sp.IsNull() || F.IsNull() || E.IsNull() || BRep_Tool::Degenerated(E) || !myEFMap.Contains(E))
+  {
+    return false;
+  }
+  TopoDS_Face G;
+  for (NCollection_List<TopoDS_Shape>::Iterator itG(myEFMap(E)); itG.More(); itG.Next())
+  {
+    if (!itG.Value().IsSame(F))
+    {
+      G = TopoDS::Face(itG.Value());
+    }
+  }
+  if (G.IsNull() || !RollsBeforeTangent(Sp, G))
+  {
+    return false;
+  }
+  BRepAdaptor_Curve aC(E);
+  return GCPnts_AbscissaPoint::Length(aC) < 100. * tolesp;
+}
+
+bool ChFi3d_Builder::RollsBeforeCurvedAway(const occ::handle<ChFiDS_Stripe>& S)
+{
+  const occ::handle<ChFiDS_FilSpine> Sp = occ::down_cast<ChFiDS_FilSpine>(S->Spine());
+  if (Sp.IsNull())
+  {
+    return false;
+  }
+  bool found = false;
+  for (int i = 1; i <= Sp->NbEdges(); i++)
+  {
+    const TopoDS_Edge& E = Sp->Edges(i);
+    if (!Sp->IsConstant(i) || !myEFMap.Contains(E))
+    {
+      continue;
+    }
+    const double R = Sp->Radius(E);
+    for (NCollection_List<TopoDS_Shape>::Iterator itF(myEFMap(E)); itF.More(); itF.Next())
+    {
+      const TopoDS_Face F = TopoDS::Face(itF.Value());
+      for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+      {
+        const TopoDS_Edge e = TopoDS::Edge(ex.Current());
+        if (BRep_Tool::Degenerated(e) || !myEFMap.Contains(e) || Sp->Index(e) > 0)
+        {
+          continue;
+        }
+        TopoDS_Face G;
+        for (NCollection_List<TopoDS_Shape>::Iterator itG(myEFMap(e)); itG.More(); itG.Next())
+        {
+          if (!itG.Value().IsSame(F))
+          {
+            G = TopoDS::Face(itG.Value());
+          }
+        }
+        if (G.IsNull() || !spineEdgeOf(Sp, G).IsNull() || RollsBefore(S, G))
+        {
+          continue;
+        }
+        double f, l;
+        const occ::handle<Geom_Curve> c = BRep_Tool::Curve(e, f, l);
+        if (c.IsNull())
+        {
+          continue;
+        }
+        const double wm = 0.5 * (f + l);
+        gp_Pnt       Pm;
+        gp_Vec       Tm;
+        c->D1(wm, Pm, Tm);
+        if (distanceToEdge(Pm, E) > 2. * R || Tm.Magnitude() <= gp::Resolution()
+            || !ChFi3d::IsTangentFaces(e, F, G))
+        {
+          continue;
+        }
+        // G's normal curvature across e at its middle, toward the material
+        // (negative where G bulges out).
+        const occ::handle<Geom2d_Curve> pc = BRep_Tool::CurveOnSurface(e, G, f, l);
+        if (pc.IsNull())
+        {
+          continue;
+        }
+        const gp_Pnt2d       uv = pc->Value(wm);
+        BRepAdaptor_Surface  aG(G);
+        BRepLProp_SLProps    props(aG, uv.X(), uv.Y(), 2, Precision::Confusion());
+        if (!props.IsCurvatureDefined() || !props.IsNormalDefined())
+        {
+          continue;
+        }
+        gp_Dir N = props.Normal();
+        if (G.Orientation() == TopAbs_REVERSED)
+        {
+          N.Reverse();
+        }
+        const gp_Vec across = gp_Vec(N).Crossed(Tm);
+        if (across.Magnitude() <= gp::Resolution())
+        {
+          continue;
+        }
+        gp_Dir dMax, dMin;
+        props.CurvatureDirections(dMax, dMin);
+        const double cs = gp_Dir(across).Dot(dMax);
+        double       kn = props.MaxCurvature() * cs * cs + props.MinCurvature() * (1. - cs * cs);
+        if (G.Orientation() == TopAbs_REVERSED)
+        {
