+bool BRepBlend_SurfRstLineBuilder::NearlyOnSurfaceFace(const math_Vector& Sol) const
+{
+  gp_Pnt       P;
+  gp_Vec       Du, Dv;
+  surf1->D1(Sol(1), Sol(2), P, Du, Dv);
+  const double aSpeed = std::max(Du.Magnitude(), Dv.Magnitude());
+  if (aSpeed <= gp::Resolution())
+  {
+    return false;
+  }
+  // (The point brought within the face's parameters, a hair at most.)
+  const double aHair = 10. * tolpoint3d / aSpeed;
+  const double u = std::min(std::max(Sol(1), surf1->FirstUParameter()), surf1->LastUParameter());
+  const double v = std::min(std::max(Sol(2), surf1->FirstVParameter()), surf1->LastVParameter());
+  if (std::abs(u - Sol(1)) > aHair || std::abs(v - Sol(2)) > aHair)
+  {
+    return false;
+  }
+  return domain1->Classify(gp_Pnt2d(u, v), Precision::PConfusion(), false) != TopAbs_OUT;
+}
