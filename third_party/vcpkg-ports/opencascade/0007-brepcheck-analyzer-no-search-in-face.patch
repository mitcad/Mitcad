BRepCheck: BRepCheck_Analyzer checks every vertex and every edge of a face
in the context of the face, and BRepCheck_Vertex::InContext and
BRepCheck_Edge::InContext first searched the face for the vertex or edge:
quadratic in the edges of a face (a face with five thousand edges took over
a second to check). The analyzer calls the new InContextOfAncestor, which
skips the search (the vertex or edge is one of the face's); other callers
keep InContext, and the checks and their statuses are unchanged.
--- a/src/ModelingAlgorithms/TKTopAlgo/BRepCheck/BRepCheck_Analyzer.cxx
+++ b/src/ModelingAlgorithms/TKTopAlgo/BRepCheck/BRepCheck_Analyzer.cxx
@@ -137,7 +137,17 @@
               OCC_CATCH_SIGNALS
               if (MapS.Add(exp.Current()))
               {
-                aFaceVertexRes->InContext(aShape);
+                // A vertex of the face: not searched for in it.
+                const occ::handle<BRepCheck_Vertex> aVertexRes =
+                  occ::down_cast<BRepCheck_Vertex>(aFaceVertexRes);
+                if (!aVertexRes.IsNull())
+                {
+                  aVertexRes->InContextOfAncestor(aShape);
+                }
+                else
+                {
+                  aFaceVertexRes->InContext(aShape);
+                }
               }
             }
             catch (Standard_Failure const& anException)
@@ -166,7 +176,17 @@
               OCC_CATCH_SIGNALS
               if (MapS.Add(exp.Current()))
               {
-                aFaceEdgeRes->InContext(aShape);
+                // An edge of the face: not searched for in it.
+                const occ::handle<BRepCheck_Edge> anEdgeRes =
+                  occ::down_cast<BRepCheck_Edge>(aFaceEdgeRes);
+                if (!anEdgeRes.IsNull())
+                {
+                  anEdgeRes->InContextOfAncestor(aShape);
+                }
+                else
+                {
+                  aFaceEdgeRes->InContext(aShape);
+                }
 
                 if (performwire)
                 {
