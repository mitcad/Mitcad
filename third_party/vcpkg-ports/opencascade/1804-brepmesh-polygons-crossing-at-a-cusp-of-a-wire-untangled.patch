+//! The index of the point of an edge's discretization at its vertex theV
+//! (0 or the last), or -1.
+int indexAtVertex(const IMeshData::IEdgeHandle& theDEdge, const TopoDS_Vertex& theV)
+{
+  TopoDS_Edge anEdge = theDEdge->GetEdge();
+  anEdge.Orientation(TopAbs_FORWARD);
+  TopoDS_Vertex aFirst, aLast;
+  TopExp::Vertices(anEdge, aFirst, aLast);
+  const int aNb = theDEdge->GetCurve()->ParametersNb();
+  if (aFirst.IsSame(theV) && !aLast.IsSame(theV))
+  {
+    return 0;
+  }
+  if (aLast.IsSame(theV) && !aFirst.IsSame(theV))
+  {
+    return aNb - 1;
+  }
+  return -1;
+}
+
+//! Removes the point theIndex of an edge's discretization: from its curve
+//! and from every pcurve of it, so that its faces' polygons stay one.
+void removeEdgePoint(const IMeshData::IEdgeHandle& theDEdge, const int theIndex)
+{
+  for (int aPCurveIt = 0; aPCurveIt < theDEdge->PCurvesNb(); ++aPCurveIt)
+  {
+    theDEdge->GetPCurve(aPCurveIt)->RemovePoint(theIndex);
+  }
+  theDEdge->GetCurve()->RemovePoint(theIndex);
+}
+
+//! A cusp of a face's wire: two consecutive edges leaving their common
+//! vertex in its parameter plane in nearly the same direction (a corner of
+//! almost no angle, as where a fillet's corner plate pinches to a point on
+//! a sharp edge). Their polygons, each within its own deflection of its
+//! curve, cross each other there, a loop too small for the face checker,
+//! and the face's frontier has no inside: the face got no triangles. The
+//! points of one polygon between the vertex and the crossing are taken out
+//! (of the one with fewer of them), its first segment from the vertex going
+//! past the crossing, until the two polygons no longer cross. Returns
+//! whether a point was taken out.
+bool untangleCusp(const IMeshData::IFaceHandle& theDFace,
+                  const IMeshData::IEdgeHandle& theEdgeA,
+                  const TopAbs_Orientation      theOriA,
+                  const IMeshData::IEdgeHandle& theEdgeB,
+                  const TopAbs_Orientation      theOriB)
+{
+  if (theEdgeA->GetEdge().IsSame(theEdgeB->GetEdge()))
+  {
+    return false;
+  }
+  TopoDS_Vertex aV;
+  if (!TopExp::CommonVertex(theEdgeA->GetEdge(), theEdgeB->GetEdge(), aV))
+  {
+    return false;
+  }
+  const int aEndA = indexAtVertex(theEdgeA, aV);
+  const int aEndB = indexAtVertex(theEdgeB, aV);
+  if (aEndA < 0 || aEndB < 0)
+  {
+    return false;
+  }
+  const IMeshData::IPCurveHandle& aPCurveA = theEdgeA->GetPCurve(theDFace.get(), theOriA);
+  const IMeshData::IPCurveHandle& aPCurveB = theEdgeB->GetPCurve(theDFace.get(), theOriB);
+  bool                            aRemoved = false;
+  for (int aStep = 0; aStep < 1000; ++aStep)
+  {
+    const int aNbA = aPCurveA->ParametersNb(), aNbB = aPCurveB->ParametersNb();
+    if (aNbA < 3 && aNbB < 3)
+    {
+      break;
+    }
+    // The k-th point away from the vertex.
+    const auto aPntA = [&](const int k) -> const gp_Pnt2d& {
+      return aPCurveA->GetPoint(aEndA == 0 ? k : aNbA - 1 - k);
+    };
+    const auto aPntB = [&](const int k) -> const gp_Pnt2d& {
+      return aPCurveB->GetPoint(aEndB == 0 ? k : aNbB - 1 - k);
+    };
+    // A cusp only: the first segments leave the vertex within 5 degrees.
+    const gp_Vec2d aDirA(aPntA(0), aPntA(1)), aDirB(aPntB(0), aPntB(1));
+    if (aDirA.SquareMagnitude() < gp::Resolution() || aDirB.SquareMagnitude() < gp::Resolution()
+        || std::abs(aDirA.Angle(aDirB)) > 5. * M_PI / 180.)
+    {
+      break;
+    }
+    int aCrossA = -1, aCrossB = -1;
+    for (int i = 0; i + 1 < aNbA && aCrossA < 0; ++i)
+    {
+      for (int j = 0; j + 1 < aNbB; ++j)
+      {
+        if (i == 0 && j == 0)
+        {
+          continue;
+        }
+        gp_Pnt2d aInt;
+        if (BRepMesh_GeomTool::IntSegSeg(aPntA(i).XY(),
+                                         aPntA(i + 1).XY(),
+                                         aPntB(j).XY(),
+                                         aPntB(j + 1).XY(),
+                                         false,
+                                         false,
+                                         aInt)
+            == BRepMesh_GeomTool::Cross)
+        {
+          aCrossA = i;
+          aCrossB = j;
+          break;
+        }
+      }
+    }
+    if (aCrossA < 0)
+    {
+      break;
+    }
+    // Take out the points 1..aCrossA of A or 1..aCrossB of B (a polygon
+    // keeps its far end), the fewer.
+    const bool aOnA = (aCrossA > 0 && aCrossA + 1 < aNbA) && (aCrossB == 0 || aCrossA <= aCrossB || aCrossB + 1 >= aNbB);
+    const bool aOnB = !aOnA && aCrossB > 0 && aCrossB + 1 < aNbB;
+    if (!aOnA && !aOnB)
+    {
+      break;
+    }
+    const IMeshData::IEdgeHandle& aDEdge = aOnA ? theEdgeA : theEdgeB;
+    const int                     aEnd   = aOnA ? aEndA : aEndB;
+    const int                     aNb    = aOnA ? aNbA : aNbB;
+    // The first point away from the vertex (the others follow one by one).
+    removeEdgePoint(aDEdge, aEnd == 0 ? 1 : aNb - 2);
+    aRemoved = true;
+  }
+  return aRemoved;
+}
+
+//! Untangles the cusps of a face's wires (untangleCusp).
+void untangleCusps(const IMeshData::IFaceHandle& theDFace)
+{
+  for (int aWireIt = 0; aWireIt < theDFace->WiresNb(); ++aWireIt)
+  {
+    const IMeshData::IWireHandle& aDWire = theDFace->GetWire(aWireIt);
+    const int                     aNb    = aDWire->EdgesNb();
+    for (int aEdgeIt = 0; aEdgeIt < aNb && aNb > 1; ++aEdgeIt)
+    {
+      const int aNextIt = (aEdgeIt + 1) % aNb;
+      untangleCusp(theDFace,
+                   aDWire->GetEdge(aEdgeIt),
+                   aDWire->GetEdgeOrientation(aEdgeIt),
+                   aDWire->GetEdge(aNextIt),
+                   aDWire->GetEdgeOrientation(aNextIt));
+    }
+  }
+}
