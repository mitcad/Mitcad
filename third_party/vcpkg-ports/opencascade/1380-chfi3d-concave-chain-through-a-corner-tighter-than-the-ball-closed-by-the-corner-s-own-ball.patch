+        return false;
+      }
+      aTriS.Append(g);
+      s = g;
+    }
+  }
+
+  // The faces.
+  const double                     tolFit = std::max(tolapp3d, 1.e-6);
+  occ::handle<Geom_BSplineSurface> aSs;
+  if (aStrip)
+  {
+    aSs = tcFit(aStripS, rk, false, PP, tolFit);
+    if (aSs.IsNull())
+    {
+      return false;
+    }
+  }
+  const occ::handle<Geom_BSplineSurface> aSt = tcFit(aTriS, rk, true, PP, tolFit);
+  if (aSt.IsNull())
+  {
+    return false;
+  }
+  double us1 = 0., us2 = 0., vs1 = 0., vs2 = 0., ut1 = 0., ut2 = 0., vt1 = 0., vt2 = 0.;
+  if (aStrip)
+  {
+    aSs->Bounds(us1, us2, vs1, vs2);
+  }
+  aSt->Bounds(ut1, ut2, vt1, vt2);
+  const occ::handle<Geom_Surface> SK   = BRep_Tool::Surface(K);
+  const gp_Pnt2d                  uvPL = FiLU.PCurveOnSurf()->Value(sP);
+  const gp_Pnt2d                  uvWH = FiHW.PCurveOnSurf()->Value(eH.tW);
+  if (SK.IsNull())
+  {
+    return false;
+  }
+
+  // The curves. The top: K's section, the strip's (or the triangle's) first
+  // section; Q-Q2 between the strip and the triangle; the contacts.
+  const occ::handle<Geom_BSplineSurface>& aTopS = aStrip ? aSs : aSt;
+  const double tu1 = aStrip ? us1 : ut1, tu2 = aStrip ? us2 : ut2, tv1 = aStrip ? vs1 : vt1;
+  const occ::handle<Geom_Curve> cTop = aTopS->VIso(tv1);
+  occ::handle<Geom2d_Curve>     pTopK;
+  {
+    double u = 0., v = 0., d = 0.;
+    if (!tcProject(SK, cTop->Value(tu1), u, v, d))
+    {
+      return false;
+    }
+    pTopK = tcPCurve(cTop, tu1, tu2, SK, gp_Pnt2d(u, v));
+    tcIntoFace(K, pTopK, tu1, tu2);
+  }
+  const occ::handle<Geom2d_Curve> pTopOn = tcSegment(gp_Pnt2d(tu1, tv1), gp_Pnt2d(tu2, tv1), tu1, tu2);
+  occ::handle<Geom_Curve>         cQ, cS1, cS2;
+  occ::handle<Geom2d_Curve>       pQs, pQt, pS1W, pS1s, pS2H, pS2s;
+  if (aStrip)
+  {
+    cQ  = aSs->VIso(vs2);
+    pQs = tcSegment(gp_Pnt2d(us1, vs2), gp_Pnt2d(us2, vs2), us1, us2);
+    pQt = tcPCurve(cQ, us1, us2, aSt, gp_Pnt2d(ut1, vt1));
+    cS1 = aSs->UIso(us1); // K1 to Q, on L's wall
+    cS2 = aSs->UIso(us2); // W to Q2, on H's blend
+    double u = 0., v = 0., d = 0.;
+    if (!tcProject(SWL, PK1, u, v, d))
+    {
+      return false;
+    }
+    pS1W = tcPCurve(cS1, vs1, vs2, SWL, gp_Pnt2d(u, v));
+    tcIntoFace(eL.W, pS1W, vs1, vs2);
+    pS1s = tcSegment(gp_Pnt2d(us1, vs1), gp_Pnt2d(us1, vs2), vs1, vs2);
+    pS2H = tcPCurve(cS2, vs1, vs2, eH.Sf, uvWH);
+    pS2s = tcSegment(gp_Pnt2d(us2, vs1), gp_Pnt2d(us2, vs2), vs1, vs2);
+    if (pQt.IsNull() || pS1W.IsNull() || pS2H.IsNull())
+    {
+      return false;
+    }
+  }
+  const occ::handle<Geom_Curve>   cT1  = aSt->UIso(ut1); // Q to P, on L's blend
+  const occ::handle<Geom_Curve>   cT2  = aSt->UIso(ut2); // Q2 to P, on H's blend
+  const occ::handle<Geom2d_Curve> pT1L = tcPCurve(cT1, vt1, vt2, eL.Sf, uvQL);
+  const occ::handle<Geom2d_Curve> pT1t = tcSegment(gp_Pnt2d(ut1, vt1), gp_Pnt2d(ut1, vt2), vt1, vt2);
+  // (Each curve's first point near its own parameters: Q2's on H's blend
+  // the triangle's first section's.)
+  const occ::handle<Geom2d_Curve> pT2H = tcPCurve(cT2, vt1, vt2, eH.Sf, gp_Pnt2d(aTriS(1).x[2], aTriS(1).x[3]));
+  const occ::handle<Geom2d_Curve> pT2t = tcSegment(gp_Pnt2d(ut2, vt1), gp_Pnt2d(ut2, vt2), vt1, vt2);
+  const occ::handle<Geom2d_Curve> pApx = tcSegment(gp_Pnt2d(ut1, vt2), gp_Pnt2d(ut2, vt2), 0., 1.);
+  if (pTopK.IsNull() || pT1L.IsNull() || pT2H.IsNull())
+  {
+    return false;
+  }
+  // H's end: one curve from W to P along both contacts on its blend (the
+  // stripe's own end; its faces are the strip's and the triangle's pieces).
+  occ::handle<Geom_BSplineCurve> cHEnd;
+  occ::handle<Geom2d_Curve>      pHEnd;
+  {
+    NCollection_Sequence<gp_Pnt> aPts;
+    if (aStrip)
+    {
+      for (int i = 0; i < 16; i++)
+      {
+        aPts.Append(cS2->Value(vs1 + (vs2 - vs1) * i / 16.));
+      }
+    }
+    for (int i = 0; i <= 32; i++)
+    {
+      aPts.Append(cT2->Value(vt1 + (vt2 - vt1) * i / 32.));
+    }
+    cHEnd = tcFitCurve(aPts, tolFit);
+    if (cHEnd.IsNull())
+    {
+      return false;
+    }
+    pHEnd = tcPCurve(cHEnd, cHEnd->FirstParameter(), cHEnd->LastParameter(), eH.Sf, uvWH);
+    if (pHEnd.IsNull())
+    {
+      return false;
+    }
+  }
+  // (The ends of the curves at the points.)
+  if (cT1->Value(vt1).Distance(PQ) > tol || cT1->Value(vt2).Distance(PP) > tol || cT2->Value(vt2).Distance(PP) > tol
+      || cT2->Value(vt1).Distance(PQ2) > tol)
+  {
+    return false;
+  }
+  if (aStrip
+      && (cS1->Value(vs1).Distance(PK1) > tol || cS1->Value(vs2).Distance(PQ) > tol
