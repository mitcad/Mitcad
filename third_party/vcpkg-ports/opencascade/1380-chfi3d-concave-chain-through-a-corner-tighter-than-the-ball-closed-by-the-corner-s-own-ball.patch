+    gp_Pnt X;
+    gp_Vec du, dv;
+    eL.Sf->D1(uvPL.X(), uvPL.Y(), X, du, dv);
+    sL = du.Crossed(dv).Dot(gp_Vec(nP)) > 0.;
+  }
+  const auto orientOf = [&](const occ::handle<Geom_BSplineSurface>& Sf, const TCSection& s, const double u,
