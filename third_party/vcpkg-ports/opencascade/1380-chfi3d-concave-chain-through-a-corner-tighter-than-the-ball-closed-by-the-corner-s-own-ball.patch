+
+  const int IK = DStr.AddShape(K);
+  const int IL = -eL.Fd->Surf();
+  const int IH = -eH.Fd->Surf();
+  int       IQ = 0, IsS = 0;
+  const int ITop = DStr.AddCurve(TopOpeBRepDS_Curve(cTop, tcOffSurface(cTop, pTopK, SK, tu1, tu2, tolapp3d)));
+  // K cut along its section; the part towards U is taken away.
+  {
+    const double tm = 0.5 * (tu1 + tu2);
+    DStr.ChangeShapeInterferences(IK).Append(ChFi3d_FilCurveInDS(
+      ITop, IK, pTopK, tcKeptSideOn(cTop, tm, pTopK, SK, into(aTopS, tm, tv1, false, 1.))));
+  }
+
+  // The strip: S1 on L's wall (K1 to Q), S2 on H's blend (W to Q2), K's
+  // section first, Q-Q2 last.
+  if (aStrip)
+  {
+    const int IS1 = DStr.AddCurve(TopOpeBRepDS_Curve(cS1, tcOffSurface(cS1, pS1W, SWL, vs1, vs2, tolapp3d)));
+    const int IS2 = DStr.AddCurve(TopOpeBRepDS_Curve(cS2, tcOffSurface(cS2, pS2H, eH.Sf, vs1, vs2, tolapp3d)));
+    IQ = DStr.AddCurve(TopOpeBRepDS_Curve(cQ, tcOffSurface(cQ, pQt, aSt, us1, us2, tolapp3d)));
+    occ::handle<ChFiDS_Stripe>   cS = new ChFiDS_Stripe();
+    cS->ChangeSetOfSurfData()       = new NCollection_HSequence<occ::handle<ChFiDS_SurfData>>();
+    occ::handle<ChFiDS_SurfData> sS = new ChFiDS_SurfData();
+    cS->ChangeSetOfSurfData()->Append(sS);
+    IsS = DStr.AddSurface(TopOpeBRepDS_Surface(aSs, tolFit));
+    sS->ChangeSurf(IsS);
+    const TCSection& sm = aStripS(1 + aStripS.Length() / 2);
+    sS->ChangeOrientation() = orientOf(aSs, sm, 0.5 * (us1 + us2), 0.5 * (vs1 + vs2));
+    sS->ChangeIndexOfS1(DStr.AddShape(eL.W));
+    sS->ChangeIndexOfS2(IH);
+    const double vm = 0.5 * (vs1 + vs2);
+    {
+      // (L's wall surface as the face's own, FORWARD.)
+      const TopoDS_Face             WF  = TopoDS::Face(eL.W.Oriented(TopAbs_FORWARD));
+      const occ::handle<Geom_Surface> SWF = BRep_Tool::Surface(WF);
+      ChFiDS_FaceInterference&      FI  = sS->ChangeInterference(1);
+      FI.SetInterference(IS1, tcKeptSideOn(cS1, vm, pS1W, SWF, into(aSs, us1, vm, true, 1.)), pS1W, pS1s);
+      FI.SetFirstParameter(vs1);
+      FI.SetLastParameter(vs2);
+    }
+    {
+      ChFiDS_FaceInterference& FI = sS->ChangeInterference(2);
+      FI.SetInterference(IS2, tcKeptSideOn(cS2, vm, pS2H, eH.Sf, into(aSs, us2, vm, true, -1.)), pS2H, pS2s);
+      FI.SetFirstParameter(vs1);
+      FI.SetLastParameter(vs2);
+    }
+    sS->ChangeVertex(true, 1)  = cpK1;
+    sS->ChangeVertex(true, 2)  = cpW;
+    sS->ChangeVertex(false, 1) = cpQ;
+    sS->ChangeVertex(false, 2) = cpQ2;
+    cS->ChangeFirstCurve(ITop);
+    cS->ChangeFirstParameters(us1, us2);
+    cS->ChangeFirstPCurve() = pTopOn;
+    cS->FirstPCurveOrientation(TopAbs_FORWARD);
+    cS->ChangeIndexFirstPointOnS1(iK1);
+    cS->ChangeIndexFirstPointOnS2(iW);
+    cS->ChangeLastCurve(IQ);
+    cS->ChangeLastParameters(us1, us2);
+    cS->ChangeLastPCurve() = pQs;
+    cS->LastPCurveOrientation(TopAbs_FORWARD);
+    cS->ChangeIndexLastPointOnS1(iQ);
+    cS->ChangeIndexLastPointOnS2(iQ2);
+    cS->SetSolidIndex(eL.St->SolidIndex());
+    Corners.Append(cS);
+    ChFiDS_Regul aRegK;
+    aRegK.SetCurve(ITop);
+    aRegK.SetS1(IsS, false);
+    aRegK.SetS2(IK, true);
+    Regul.Append(aRegK);
+  }
+
+  // The triangle: S1 on L's blend (Q to P), S2 on H's (Q2 to P), Q-Q2 (or
+  // K's section) first, a point at P last.
+  {
+    occ::handle<ChFiDS_Stripe>   cT = new ChFiDS_Stripe();
+    cT->ChangeSetOfSurfData()       = new NCollection_HSequence<occ::handle<ChFiDS_SurfData>>();
+    occ::handle<ChFiDS_SurfData> sT = new ChFiDS_SurfData();
+    cT->ChangeSetOfSurfData()->Append(sT);
+    const int IsT = DStr.AddSurface(TopOpeBRepDS_Surface(aSt, tolFit));
+    sT->ChangeSurf(IsT);
+    sT->ChangeOrientation() = orientOf(aSt, aTriS(1 + aTriS.Length() / 3), 0.5 * (ut1 + ut2), vt1 + (vt2 - vt1) / 3.);
+    sT->ChangeIndexOfS1(IL);
+    sT->ChangeIndexOfS2(IH);
+    const double vm = vt1 + 0.5 * (vt2 - vt1);
+    {
+      ChFiDS_FaceInterference& FI = sT->ChangeInterference(1);
+      FI.SetInterference(IT1, tcKeptSideOn(cT1, vm, pT1L, eL.Sf, into(aSt, ut1, vm, true, 1.)), pT1L, pT1t);
+      FI.SetFirstParameter(vt1);
+      FI.SetLastParameter(vt2);
+    }
+    {
+      ChFiDS_FaceInterference& FI = sT->ChangeInterference(2);
+      FI.SetInterference(IT2, tcKeptSideOn(cT2, vm, pT2H, eH.Sf, into(aSt, ut2, vm, true, -1.)), pT2H, pT2t);
+      FI.SetFirstParameter(vt1);
+      FI.SetLastParameter(vt2);
+    }
+    sT->ChangeVertex(true, 1)  = cpQ;
+    sT->ChangeVertex(true, 2)  = aStrip ? cpQ2 : cpW;
+    sT->ChangeVertex(false, 1) = cpP;
+    sT->ChangeVertex(false, 2) = cpP;
+    if (aStrip)
+    {
+      cT->ChangeFirstCurve(IQ);
+      cT->ChangeFirstParameters(us1, us2);
+      cT->ChangeFirstPCurve() = pQt;
+    }
+    else
+    {
+      cT->ChangeFirstCurve(ITop);
+      cT->ChangeFirstParameters(ut1, ut2);
+      cT->ChangeFirstPCurve() = pTopOn;
+    }
+    cT->FirstPCurveOrientation(TopAbs_FORWARD);
+    cT->ChangeIndexFirstPointOnS1(iQ);
+    cT->ChangeIndexFirstPointOnS2(aStrip ? iQ2 : iW);
+    {
+      NCollection_Array1<gp_Pnt> aP(1, 2);
+      NCollection_Array1<double> aK(1, 2);
+      NCollection_Array1<int>    aMu(1, 2);
+      aP(1) = aP(2) = PP;
+      aK(1)         = 0.;
+      aK(2)         = 1.;
+      aMu(1) = aMu(2) = 2;
+      const int Id    = DStr.AddCurve(TopOpeBRepDS_Curve(new Geom_BSplineCurve(aP, aK, aMu, 1), tolapp3d));
+      cT->ChangeLastCurve(Id);
+    }
+    cT->ChangeLastParameters(0., 1.);
+    cT->ChangeLastPCurve() = pApx;
+    cT->LastPCurveOrientation(TopAbs_FORWARD);
+    cT->ChangeIndexLastPointOnS1(iP);
+    cT->ChangeIndexLastPointOnS2(iP);
+    cT->SetSolidIndex(eL.St->SolidIndex());
+    Corners.Append(cT);
+    ChFiDS_Regul aReg;
+    aReg.SetCurve(aStrip ? IQ : ITop);
+    aReg.SetS1(IsT, false);
+    if (aStrip)
+    {
+      aReg.SetS2(IsS, false);
+    }
+    else
+    {
+      aReg.SetS2(IK, true);
+    }
+    Regul.Append(aReg);
+    // The faces made from the arc's edge.
+    if (!EVIMap.IsBound(Ek))
+    {
+      EVIMap.Bind(Ek, NCollection_List<int>());
+    }
+    if (aStrip)
+    {
+      EVIMap.ChangeFind(Ek).Append(IsS);
+    }
+    EVIMap.ChangeFind(Ek).Append(IsT);
+  }
+  return true;
+}
