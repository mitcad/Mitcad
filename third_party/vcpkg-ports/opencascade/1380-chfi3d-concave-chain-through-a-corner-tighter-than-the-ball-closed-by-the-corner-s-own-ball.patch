+  {
+    double                         d   = 0.;
+    const occ::handle<Geom_Curve>& CHW = DStr.Curve(FiHW.LineIndex()).Curve();
+    if (!tcOnCurve(CHW, FiHW.FirstParameter(), FiHW.LastParameter(), eH.PW, tWH, d) || d > tol)
+    {
+      return false;
+    }
+  }
+  {
+    ChFiDS_CommonPoint p = cpP, q = cpQ;
+    p.SetParameter(eL.Fd->Vertex(eL.First, eL.sU).Parameter());
+    q.SetParameter(eL.Fd->Vertex(eL.First, eL.sW).Parameter());
+    eL.Fd->ChangeVertex(eL.First, eL.sU) = p;
+    eL.Fd->ChangeVertex(eL.First, eL.sW) = q;
+    eL.Fd->ChangeInterference(eL.sU).SetParameter(sP, eL.First);
+    eL.Fd->ChangeInterference(eL.sW).SetParameter(tQL, eL.First);
+  }
+  {
+    ChFiDS_CommonPoint p = cpP, w = cpW;
+    p.SetParameter(eH.Fd->Vertex(eH.First, eH.sU).Parameter());
+    w.SetParameter(eH.Fd->Vertex(eH.First, eH.sW).Parameter());
+    eH.Fd->ChangeVertex(eH.First, eH.sU) = p;
+    eH.Fd->ChangeVertex(eH.First, eH.sW) = w;
+    eH.Fd->ChangeInterference(eH.sU).SetParameter(tPH, eH.First);
+    eH.Fd->ChangeInterference(eH.sW).SetParameter(tWH, eH.First);
+  }
+  const int IT1 = DStr.AddCurve(TopOpeBRepDS_Curve(cT1, tcOffSurface(cT1, pT1L, eL.Sf, vt1, vt2, tolapp3d)));
+  const int IT2 = DStr.AddCurve(TopOpeBRepDS_Curve(cT2, tcOffSurface(cT2, pT2H, eH.Sf, vt1, vt2, tolapp3d)));
+  const int IHE = DStr.AddCurve(TopOpeBRepDS_Curve(
