+  const double eps = 1.e-2 * rk;
+  // A point of the part a support loses, off a curve's middle along the
+  // corner face's own direction into it.
+  const auto into = [&](const occ::handle<Geom_BSplineSurface>& Sf, const double u, const double v, const bool alongU,
