+    tcOffSurface(cHEnd, pHEnd, eH.Sf, cHEnd->FirstParameter(), cHEnd->LastParameter(), tolapp3d)));
+  eL.St->SetCurve(IT1, eL.First);
+  eL.St->SetParameters(eL.First, vt1, vt2);
+  eL.St->ChangePCurve(eL.First) = pT1L;
+  eL.St->SetIndexPoint(iP, eL.First, eL.sU);
+  eL.St->SetIndexPoint(iQ, eL.First, eL.sW);
+  // (The curve runs from the wall's side, Q, to U's, P.)
+  eL.St->SetOrientation(eL.sW == 1 ? TopAbs_FORWARD : TopAbs_REVERSED, eL.First);
