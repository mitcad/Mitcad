+    return false;
+  }
+
+  // The points.
+  ChFiDS_CommonPoint cpP, cpQ, cpQ2, cpK1, cpW;
+  for (ChFiDS_CommonPoint* cp : {&cpP, &cpQ, &cpQ2, &cpK1, &cpW})
