+  cpQ.SetPoint(PQ);
+  cpQ2.SetPoint(PQ2);
+  cpK1.SetPoint(aStrip ? PK1 : PQ);
+  cpW.SetPoint(eH.PW);
+  {
+    const TopoDS_Edge             EL = TopoDS::Edge(eL.E.Oriented(TopAbs_FORWARD));
+    const TopoDS_Edge             EH = TopoDS::Edge(eH.E.Oriented(TopAbs_FORWARD));
+    double                        fL = 0., lL = 0., fH = 0., lH = 0.;
+    const occ::handle<Geom_Curve> CEL = BRep_Tool::Curve(EL, fL, lL);
+    const occ::handle<Geom_Curve> CEH = BRep_Tool::Curve(EH, fH, lH);
+    double                        wL = 0., wH = 0., dL = 0., dH = 0.;
+    if (CEL.IsNull() || CEH.IsNull())
+    {
+      return false;
+    }
+    tcOnCurve(CEL, fL, lL, aStrip ? PK1 : PQ, wL, dL);
+    tcOnCurve(CEH, fH, lH, eH.PW, wH, dH);
+    if (dL > tol || dH > tol)
+    {
+      return false;
+    }
+    cpK1.SetArc(tol, EL, wL, tcKeptAbove(EL, a));
+    cpW.SetArc(tol, EH, wH, tcKeptAbove(EH, a));
+    if (!aStrip)
+    {
+      cpQ = cpK1;
+    }
+  }
+  const int iP  = ChFi3d_IndexPointInDS(cpP, DStr);
+  const int iQ  = ChFi3d_IndexPointInDS(cpQ, DStr);
+  const int iQ2 = ChFi3d_IndexPointInDS(cpQ2, DStr);
+  const int iK1 = aStrip ? ChFi3d_IndexPointInDS(cpK1, DStr) : iQ;
+  const int iW  = ChFi3d_IndexPointInDS(cpW, DStr);
+
+  // The blends' ends: L's cut along the triangle's contact from Q to P,
+  // H's along both contacts from W to P.
