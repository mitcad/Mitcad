+  eH.St->SetCurve(IHE, eH.First);
+  eH.St->SetParameters(eH.First, cHEnd->FirstParameter(), cHEnd->LastParameter());
+  eH.St->ChangePCurve(eH.First) = pHEnd;
+  eH.St->SetIndexPoint(iP, eH.First, eH.sU);
+  eH.St->SetIndexPoint(iW, eH.First, eH.sW);
+  eH.St->SetOrientation(eH.sW == 1 ? TopAbs_FORWARD : TopAbs_REVERSED, eH.First);
