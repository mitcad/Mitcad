 //            middle, the intersection gave more than one edge, and the
 //            branch runs past the plane of the end (the osculating plane
 //            of the face's boundary there); elsewhere nothing changes.
+//            Where the walls lean in towards that end, the offsets become
+//            tangent inside the solid or on its end (mitcad#1193): the
+//            branch along the edge runs up to the tangency, and past it
+//            the offsets cross along its continuation and two branches
+//            turning sideways, all starting tangent there and joined by
+//            pieces of a few microns, not always connected. There one
+//            edge is made of the branch and its continuation (theMerged),
+//            so that the walls, extended to a removed end face, meet along
+//            one edge.
 //=======================================================================
 static void DropCrossingsPastTangentEnd(
-  const TopoDS_Edge&                                             RefEdge,
-  const TopoDS_Face&                                             RefFace1,
-  const TopoDS_Face&                                             RefFace2,
-  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& TrueEdges)
+  const TopoDS_Edge&                                                   RefEdge,
+  const TopoDS_Face&                                                   RefFace1,
+  const TopoDS_Face&                                                   RefFace2,
+  NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>&       TrueEdges,
+  const NCollection_IndexedMap<TopoDS_Shape, TopTools_ShapeMapHasher>& AllEdges,
+  const TopoDS_Face&                                                   OffsetFace1,
+  TopoDS_Edge&                                                         theMerged)
 {
-  if (RefEdge.IsNull() || RefFace1.IsNull() || RefFace2.IsNull() || TrueEdges.Extent() < 2
-      || BRep_Tool::Degenerated(RefEdge))
+  if (RefEdge.IsNull() || RefFace1.IsNull() || RefFace2.IsNull() || TrueEdges.IsEmpty()
+      || AllEdges.Extent() < 2 || BRep_Tool::Degenerated(RefEdge))
   {
     return;
   }
@@ -1612,11 +1629,303 @@
       aMain       = i;
     }
   }
+  if (aMain == 0)
+  {
+    return;
+  }
+  // Where the offsets become tangent: the tangent end's point on the offset
+  // surface (its nearest point there, along the normal).
+  GeomAPI_ProjectPointOnSurf aOnOffset(aPEnd, BRep_Tool::Surface(OffsetFace1));
+  if (!aOnOffset.IsDone() || aOnOffset.NbPoints() == 0)
+  {
+    return;
+  }
+  const gp_Pnt aPQ         = aOnOffset.NearestPoint();
+  const double aOffsetDist = aOnOffset.LowerDistance();
+  // About the tangency the pieces of the intersection lie within a few
+  // microns of each other: a neighbourhood of 5 % of the offset. The
+  // branch is cut, and its continuation starts, 1 % of the offset before
+  // and past the tangency.
+  const double aNear = 0.05 * aOffsetDist;
+  const double aStep = 0.01 * aOffsetDist;
+  // The pave filler may stop the main branch before the removed end even
+  // when the tangency lies past it. Join its continuation then, too:
+  // leaving all crossings there loses the inner walls (the octagon-to-circle shell).
+  if (aStep > Precision::Confusion()
+      && (gp_Vec(aPEnd, aPQ).Dot(aEndNormal) <= aStep || aMainBeyond <= Precision::Confusion()))
+  {
+    // The tangency inside the solid or on its end: the branch along the edge
+    // up to the tangency and its continuation past it, as one edge.
+    // An edge's curve from its point nearest to the tangency (within
+    // theNear of it) to its end away from it, oriented towards the tangency
+    // or away from it; theFarDist the distance of that end.
+    const auto aPiece = [&](const TopoDS_Edge& theE, const bool theTowards, double& theFarDist,
+                            const double theNear) {
+      theFarDist = -1.;
+      double                         aF, aL;
+      const occ::handle<Geom_Curve>& aCurve = BRep_Tool::Curve(theE, aF, aL);
+      if (aCurve.IsNull())
+      {
+        return occ::handle<Geom_BSplineCurve>();
+      }
+      const double aDistF = aCurve->Value(aF).Distance(aPQ);
+      const double aDistL = aCurve->Value(aL).Distance(aPQ);
+      double       aTQ    = aDistF <= aDistL ? aF : aL;
+      double       aDistQ = std::min(aDistF, aDistL);
+      GeomAPI_ProjectPointOnCurve aOnC(aPQ, aCurve, aF, aL);
+      if (aOnC.NbPoints() > 0 && aOnC.LowerDistance() < aDistQ)
+      {
+        aTQ    = aOnC.LowerDistanceParameter();
+        aDistQ = aOnC.LowerDistance();
+      }
+      if (aDistQ > theNear)
+      {
+        return occ::handle<Geom_BSplineCurve>();
+      }
+      const bool   aFarIsLast = aDistL >= aDistF;
+      const double aT0        = aFarIsLast ? aTQ : aF;
+      const double aT1        = aFarIsLast ? aL : aTQ;
+      theFarDist              = std::max(aDistF, aDistL);
+      if (aT1 - aT0 <= Precision::PConfusion())
+      {
+        return occ::handle<Geom_BSplineCurve>();
+      }
+      occ::handle<Geom_BSplineCurve> aBS =
+        GeomConvert::CurveToBSplineCurve(new Geom_TrimmedCurve(aCurve, aT0, aT1));
+      if (!aBS.IsNull() && aFarIsLast == theTowards)
+      {
+        aBS->Reverse();
+      }
+      return aBS;
+    };
+    const TopoDS_Edge&             aMainE   = TopoDS::Edge(TrueEdges(aMain));
+    double                         aMainFar = 0.;
+    occ::handle<Geom_BSplineCurve> aB1      = aPiece(aMainE, true, aMainFar, aNear);
+    // The main branch may have the same gap as the continuation: use its
+    // existing 20 % neighbourhood before giving up on this intersection.
+    if (aB1.IsNull())
+    {
+      aB1 = aPiece(aMainE, true, aMainFar, 4. * aNear);
+    }
+    if (aB1.IsNull() || aMainFar <= aNear)
+    {
+      return;
+    }
+    const gp_Vec aDir = gp_Vec(aB1->StartPoint(), aB1->EndPoint()).Normalized();
+    // The continuation: of all the pieces of the intersection (it may start
+    // a few microns from the branch's end, not connected to it), the one
+    // from about the tangency (within theNear of it) that goes on most
+    // nearly in the branch's direction.
+    occ::handle<Geom_BSplineCurve> aB2;
+    TopoDS_Edge                    aB2Edge;
+    double                         aBest = -2.;
+    double                         aTol  = BRep_Tool::Tolerance(aMainE);
+    const auto aSearch = [&](const double theNear) {
+      for (int i = 1; i <= AllEdges.Extent(); i++)
+      {
+        if (AllEdges(i).IsSame(aMainE))
+        {
+          continue;
+        }
+        double                               aFar  = 0.;
+        const occ::handle<Geom_BSplineCurve> aCand = aPiece(TopoDS::Edge(AllEdges(i)), false, aFar, theNear);
+        if (aCand.IsNull() || aFar <= theNear)
+        {
+          continue;
+        }
+        const double aCos = gp_Vec(aPQ, aCand->EndPoint()).Normalized().Dot(aDir);
+        if (aCos > aBest)
+        {
+          aBest   = aCos;
+          aB2     = aCand;
+          aB2Edge = TopoDS::Edge(AllEdges(i));
+          aTol    = std::max(BRep_Tool::Tolerance(aMainE), BRep_Tool::Tolerance(TopoDS::Edge(AllEdges(i))));
+        }
+      }
+    };
+    aSearch(aNear);
+    // (A single edge that itself runs on along the branch is left as it
+    // is.)
+    {
+      double                               aFar  = 0.;
+      const occ::handle<Geom_BSplineCurve> aRest = aPiece(aMainE, false, aFar, aNear);
+      if (!aRest.IsNull() && aFar > aNear && aRest->StartPoint().Distance(aB1->EndPoint()) <= Precision::Confusion()
+          && gp_Vec(aPQ, aRest->EndPoint()).Normalized().Dot(aDir) > aBest)
+      {
+        if (TrueEdges.Extent() == 1)
+        {
+          return;
+        }
+        aBest = gp_Vec(aPQ, aRest->EndPoint()).Normalized().Dot(aDir);
+        aB2   = aRest;
+        aB2Edge.Nullify();
+        aTol  = BRep_Tool::Tolerance(aMainE);
+      }
+    }
+    // (Where no piece goes on from the neighbourhood, the pave filler may
+    // have left a longer gap about the tangency, where the offsets are
+    // nearly tangent and its walk stops early: a piece from within four
+    // times as far, 20 % of the offset. With patch 1200's extension of a
+    // half of a side the loft splits, the gap at that half's corner came
+    // out 8 % of the offset on Windows, where the shell was then invalid,
+    // while on Linux it passed (mitcad#1217). The curve tangent to both
+    // pieces bridges it.)
+    if (aB2.IsNull() || aBest < 0.5)
+    {
+      aSearch(4. * aNear);
+    }
+    if (aB2.IsNull() || aBest < 0.5)
+    {
+      return;
+    }
+    // (The continuation may be a short piece: on into the edges that go on
+    // from its far end in the branch's direction.)
+    for (int aStep = 0; !aB2Edge.IsNull() && aStep < AllEdges.Extent(); aStep++)
+    {
+      TopoDS_Vertex aV1, aV2;
+      TopExp::Vertices(aB2Edge, aV1, aV2);
+      if (aV1.IsNull() || aV2.IsNull())
+      {
+        break;
+      }
+      const gp_Pnt         aEnd  = aB2->EndPoint();
+      const TopoDS_Vertex& aFarV = BRep_Tool::Pnt(aV1).Distance(aEnd) <= BRep_Tool::Pnt(aV2).Distance(aEnd) ? aV1 : aV2;
+      const gp_Pnt         aFarP = BRep_Tool::Pnt(aFarV);
+      TopoDS_Edge                    aNext;
+      occ::handle<Geom_BSplineCurve> aNextC;
+      double                         aNextCos = 0.9;
+      for (int i = 1; i <= AllEdges.Extent(); i++)
+      {
+        const TopoDS_Edge& aE = TopoDS::Edge(AllEdges(i));
+        if (aE.IsSame(aMainE) || aE.IsSame(aB2Edge))
+        {
+          continue;
+        }
+        TopoDS_Vertex aE1, aE2;
+        TopExp::Vertices(aE, aE1, aE2);
+        double                         aF, aL;
+        const occ::handle<Geom_Curve>& aCurve = BRep_Tool::Curve(aE, aF, aL);
+        if (aCurve.IsNull() || aE1.IsNull() || aE2.IsNull() || (!aE1.IsSame(aFarV) && !aE2.IsSame(aFarV))
+            || aE1.IsSame(aE2))
+        {
+          continue;
+        }
+        occ::handle<Geom_BSplineCurve> aC =
+          GeomConvert::CurveToBSplineCurve(new Geom_TrimmedCurve(aCurve, aF, aL));
+        if (aC.IsNull())
+        {
+          continue;
+        }
+        if (aC->StartPoint().Distance(aFarP) > aC->EndPoint().Distance(aFarP))
+        {
+          aC->Reverse();
+        }
+        const gp_Vec aOn(aFarP, aC->EndPoint());
+        if (aOn.Magnitude() > gp::Resolution() && aOn.Normalized().Dot(aDir) > aNextCos)
+        {
+          aNextCos = aOn.Normalized().Dot(aDir);
+          aNext    = aE;
+          aNextC   = aC;
+        }
+      }
+      if (aNext.IsNull())
+      {
+        break;
+      }
+      GeomConvert_CompCurveToBSplineCurve aChain(aB2);
+      if (!aChain.Add(aNextC, 2. * BRep_Tool::Tolerance(aFarV) + Precision::Confusion(), true))
+      {
+        break;
+      }
+      aB2     = aChain.BSplineCurve();
+      aTol    = std::max(aTol, BRep_Tool::Tolerance(aNext));
+      aB2Edge = aNext;
+    }
+    // The two may run past each other about the tangency: the branch is cut
+    // a little before it and the continuation a little past it (along the
+    // branch's direction; where they end or start further away, there),
+    // joined by a curve tangent to both, so that the edge does not turn
+    // back on itself.
+    const auto aAt = [&](const occ::handle<Geom_BSplineCurve>& theC, const double theH) {
+      double     aLo = theC->FirstParameter(), aHi = theC->LastParameter();
+      const auto aH  = [&](const double theU) { return gp_Vec(aPQ, theC->Value(theU)).Dot(aDir) - theH; };
+      if (aH(aLo) >= 0.)
+      {
+        return aLo;
+      }
+      if (aH(aHi) <= 0.)
+      {
+        return aHi;
+      }
+      for (int k = 0; k < 100 && aHi - aLo > Precision::PConfusion(); k++)
+      {
+        const double aMid = 0.5 * (aLo + aHi);
+        (aH(aMid) < 0. ? aLo : aHi) = aMid;
+      }
+      return 0.5 * (aLo + aHi);
+    };
+    const double aU1 = aAt(aB1, -aStep);
+    const double aU2 = aAt(aB2, aStep);
+    if (aU1 <= aB1->FirstParameter() + Precision::PConfusion() || aU2 >= aB2->LastParameter() - Precision::PConfusion())
+    {
+      return;
+    }
+    if (aU1 < aB1->LastParameter())
+    {
+      aB1->Segment(aB1->FirstParameter(), aU1);
+    }
+    if (aU2 > aB2->FirstParameter())
+    {
+      aB2->Segment(aU2, aB2->LastParameter());
+    }
+    gp_Pnt aP0, aP3;
+    gp_Vec aT0, aT3;
+    aB1->D1(aB1->LastParameter(), aP0, aT0);
+    aB2->D1(aB2->FirstParameter(), aP3, aT3);
+    const double aGap = aP0.Distance(aP3);
+    if (aT0.Magnitude() <= gp::Resolution() || aT3.Magnitude() <= gp::Resolution()
+        || aGap <= Precision::Confusion())
+    {
+      return;
+    }
+    NCollection_Array1<gp_Pnt> aPoles(1, 4);
+    aPoles(1) = aP0;
+    aPoles(2) = aP0.Translated(aT0.Normalized() * (aGap / 3.));
+    aPoles(3) = aP3.Translated(aT3.Normalized() * (-aGap / 3.));
+    aPoles(4) = aP3;
+    const occ::handle<Geom_BSplineCurve> aJoin =
+      GeomConvert::CurveToBSplineCurve(new Geom_BezierCurve(aPoles));
+    // Each piece parametrised by its length, so that the edge's parameter
+    // runs evenly along it.
+    const auto aByLength = [](const occ::handle<Geom_BSplineCurve>& theC, const double theStart) {
+      GeomAdaptor_Curve          aGC(theC);
+      const double               aLen = GCPnts_AbscissaPoint::Length(aGC);
+      NCollection_Array1<double> aKnots(1, theC->NbKnots());
+      theC->Knots(aKnots);
+      BSplCLib::Reparametrize(theStart, theStart + aLen, aKnots);
+      theC->SetKnots(aKnots);
