 #include <TopTools_ShapeMapHasher.hxx>
 #include <NCollection_Map.hxx>
 
+#include <algorithm>
 #include <cstdio>
 
+//=======================================================================
+// function : CoverPoints
+// purpose  : The tolerance of a vertex that takes the place of another,
+//            widened to cover the other's points on its edges' curves,
+//            which it takes over (mitcad#1193): the two may lie apart by
+//            more than their tolerances.
+//=======================================================================
+static void CoverPoints(const occ::handle<BRep_TVertex>& theNew, const occ::handle<BRep_TVertex>& theOld)
+{
+  double aTol = theNew->Tolerance();
+  for (NCollection_List<occ::handle<BRep_PointRepresentation>>::Iterator aIt(theOld->Points()); aIt.More();
+       aIt.Next())
+  {
+    const occ::handle<BRep_PointRepresentation>& aPR = aIt.Value();
+    gp_Pnt                                       aP;
+    if (aPR->IsPointOnCurve() && !aPR->Curve().IsNull())
+    {
+      aP = aPR->Curve()->Value(aPR->Parameter());
+    }
+    else if (aPR->IsPointOnCurveOnSurface() && !aPR->PCurve().IsNull() && !aPR->Surface().IsNull())
+    {
+      const gp_Pnt2d aUV = aPR->PCurve()->Value(aPR->Parameter());
+      aP                 = aPR->Surface()->Value(aUV.X(), aUV.Y());
+    }
+    else
+    {
+      continue;
+    }
+    aP.Transform(aPR->Location().Transformation());
+    // (With a margin: the checker compares the squared distances.)
+    aTol = std::max(aTol, 1.001 * aP.Distance(theNew->Pnt()));
+  }
+  theNew->Tolerance(aTol);
+}
+
 BRepOffset_MakeLoops::BRepOffset_MakeLoops() = default;
 
