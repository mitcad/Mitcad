+//=======================================================================
+// function : ChFi3d_RunOnExtrusionCurve
+// purpose  : The surface S of linear extrusion of a bounded B-spline curve
+//            C with C run on past its end nearer the parameter U by the
+//            length L: C extended there curvature continuously
+//            (GeomLib::ExtendCurveToPoint, third order) up to its own
+//            polynomial run on at that length, its own parameters kept. S
+//            itself where it is no such surface or the extension fails.
+//=======================================================================
+
+static occ::handle<Geom_Surface> ChFi3d_RunOnExtrusionCurve(const occ::handle<Geom_Surface>& S,
+                                                            const double                     U,
+                                                            const double                     L)
+{
+  const occ::handle<Geom_SurfaceOfLinearExtrusion> aExt = occ::down_cast<Geom_SurfaceOfLinearExtrusion>(S);
+  if (aExt.IsNull())
+  {
+    return S;
+  }
+  const occ::handle<Geom_BSplineCurve> aC = occ::down_cast<Geom_BSplineCurve>(aExt->BasisCurve());
+  if (aC.IsNull() || aC->IsPeriodic() || aC->IsClosed())
+  {
+    return S;
+  }
+  const double u1 = aC->FirstParameter(), u2 = aC->LastParameter();
+  const bool   after = std::abs(U - u2) < std::abs(U - u1);
+  const double ue    = after ? u2 : u1;
+  gp_Pnt       aP;
+  gp_Vec       aD1;
+  aC->D1(ue, aP, aD1);
+  if (aD1.Magnitude() <= gp::Resolution() || L <= Precision::Confusion())
+  {
+    return S;
+  }
+  try
+  {
+    OCC_CATCH_SIGNALS
+    // (A B-spline curve evaluated past its end runs on along its end span's
+    // polynomial.)
+    const gp_Pnt aTo = aC->Value(ue + (after ? 1. : -1.) * L / aD1.Magnitude());
+    occ::handle<Geom_BoundedCurve> aRun = occ::down_cast<Geom_BoundedCurve>(aC->Copy());
+    GeomLib::ExtendCurveToPoint(aRun, aTo, 3, after);
+    const double um = 0.5 * (u1 + u2);
+    if (aRun.IsNull() || aRun->Value(um).Distance(aC->Value(um)) > Precision::Confusion()
+        || aRun->Value(ue).Distance(aP) > Precision::Confusion())
+    {
+      return S;
+    }
+    return new Geom_SurfaceOfLinearExtrusion(aRun, aExt->Direction());
+  }
+  catch (Standard_Failure const&)
+  {
+    return S;
+  }
+}
