+// Whether every edge of face F is an edge of a stripe's spine (the face's
+// whole outline rounded).
+static bool allEdgesRounded(const TopoDS_Face&                                  F,
+                            const NCollection_List<occ::handle<ChFiDS_Stripe>>& theStripes)
+{
+  for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More(); ex.Next())
+  {
+    const TopoDS_Edge& E = TopoDS::Edge(ex.Current());
+    if (BRep_Tool::Degenerated(E))
+    {
+      continue;
+    }
+    bool aFound = false;
+    for (NCollection_List<occ::handle<ChFiDS_Stripe>>::Iterator it(theStripes); it.More() && !aFound; it.Next())
+    {
+      const occ::handle<ChFiDS_Spine>& Sp = it.Value()->Spine();
+      for (int i = 1; !Sp.IsNull() && i <= Sp->NbEdges() && !aFound; i++)
+      {
+        aFound = Sp->Edges(i).IsSame(E);
+      }
+    }
+    if (!aFound)
+    {
+      return false;
+    }
+  }
+  return true;
+}
