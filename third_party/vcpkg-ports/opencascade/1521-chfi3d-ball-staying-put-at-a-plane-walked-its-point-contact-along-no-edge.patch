@@ -3217,8 +3239,9 @@ static bool runsAlongEdgePart(const occ::handle<Geom_Curve>& C,
     {
       return false;
     }
+    aMoves = aMoves || aP.Distance(aP1) > Tol;
   }
-  return true;
+  return aMoves;
 }
 
