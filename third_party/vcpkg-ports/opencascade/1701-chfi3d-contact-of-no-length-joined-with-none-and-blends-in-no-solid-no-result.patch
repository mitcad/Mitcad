+// The length of the contact of SurfData S on its side onS, along the
+// polyline through nine points of its curve; 0 where it has no curve or its
+// range is of no length.
+static double contactLength(const TopOpeBRepDS_DataStructure&   DStr,
+                            const occ::handle<ChFiDS_SurfData>& S,
+                            const int                           onS)
+{
+  const ChFiDS_FaceInterference& I = S->Interference(onS);
+  if (I.LineIndex() <= 0)
+  {
+    return 0.;
+  }
+  const occ::handle<Geom_Curve>& C = DStr.Curve(I.LineIndex()).Curve();
+  const double                   f = I.FirstParameter(), l = I.LastParameter();
+  if (C.IsNull() || std::abs(l - f) <= Precision::PConfusion())
+  {
+    return 0.;
+  }
+  double aLength = 0.;
+  gp_Pnt aPrev   = C->Value(f);
+  for (int i = 1; i <= 8; i++)
+  {
+    const gp_Pnt aP = C->Value(f + (l - f) * i / 8.);
+    aLength += aPrev.Distance(aP);
+    aPrev = aP;
+  }
+  return aLength;
+}
