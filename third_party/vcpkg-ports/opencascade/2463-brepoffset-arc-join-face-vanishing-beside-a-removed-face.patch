+//! The kept face across faces whose offset vanishes from the edge theE of
+//! the removed face theCap (theAcross: face A, its edge, face B, its edge),
+//! and its edge to them; a null face where there is none (mitcad#2463).
+static TopoDS_Face KeptFaceAcrossToCap(const NCollection_List<TopoDS_Shape>* theAcross,
+                                       const TopoDS_Shape&                   theCap,
+                                       const TopoDS_Shape&                   theE,
+                                       TopoDS_Edge&                          theEdge)
+{
+  theEdge.Nullify();
+  if (!theAcross)
+  {
+    return TopoDS_Face();
+  }
+  for (NCollection_List<TopoDS_Shape>::Iterator it(*theAcross); it.More();)
+  {
+    TopoDS_Shape aF[2], aE[2];
+    for (int k = 0; k < 2; ++k)
+    {
+      if (!it.More())
+      {
+        return TopoDS_Face();
+      }
+      aF[k] = it.Value();
+      it.Next();
+      if (!it.More())
+      {
+        return TopoDS_Face();
+      }
+      aE[k] = it.Value();
+      it.Next();
+    }
+    for (int k = 0; k < 2; ++k)
+    {
+      if (aF[k].IsSame(theCap) && aE[k].IsSame(theE) && !aF[1 - k].IsSame(theCap))
+      {
+        theEdge = TopoDS::Edge(aE[1 - k]);
+        return TopoDS::Face(aF[1 - k]);
+      }
+    }
+  }
+  return TopoDS_Face();
+}
+
+//! Whether the section theS of a kept face's offset with the removed face
+//! theCap runs inside theCap: its middle is inside theCap, not on its
+//! boundary or past it (mitcad#2463).
+static bool SectionRunsInsideCap(const TopoDS_Edge& theS, const TopoDS_Face& theCap)
+{
+  double                         aF, aL;
+  const occ::handle<Geom_Curve>& aC = BRep_Tool::Curve(theS, aF, aL);
+  if (aC.IsNull())
+  {
+    return false;
+  }
+  BRepClass_FaceClassifier aClassifier(theCap, aC->Value(0.5 * (aF + aL)), Precision::Confusion());
+  return aClassifier.State() == TopAbs_IN;
+}
