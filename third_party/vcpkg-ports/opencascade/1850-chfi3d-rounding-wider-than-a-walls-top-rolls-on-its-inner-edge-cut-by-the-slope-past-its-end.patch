+// Whether the solid turns away at edge E between faces F1 and F2 by a right
+// angle or more at its parameter W: E convex there (convexAt) and the
+// faces' outward normals at least a right angle apart (a wall's top meeting
+// its inner wall).
+static bool turnsAwayAt(const TopoDS_Edge& E, const TopoDS_Face& F1, const TopoDS_Face& F2, const double W)
+{
+  if (!convexAt(E, F1, F2, W))
+  {
+    return false;
+  }
+  double                          f, l;
+  const occ::handle<Geom2d_Curve> C1 = BRep_Tool::CurveOnSurface(E, F1, f, l);
+  const occ::handle<Geom2d_Curve> C2 = BRep_Tool::CurveOnSurface(E, F2, f, l);
+  gp_Vec                          N[2];
+  for (int k = 0; k < 2; k++)
+  {
+    const TopoDS_Face&              F  = k == 0 ? F1 : F2;
+    const gp_Pnt2d                  uv = (k == 0 ? C1 : C2)->Value(W);
+    const occ::handle<Geom_Surface> S  = BRep_Tool::Surface(F);
+    gp_Pnt                          P;
+    gp_Vec                          DU, DV;
+    S->D1(uv.X(), uv.Y(), P, DU, DV);
+    N[k] = DU.Crossed(DV);
+    if (N[k].SquareMagnitude() <= gp::Resolution())
+    {
+      return false;
+    }
+    N[k].Normalize();
+  }
+  // (The sign of the product does not depend on the faces' orientations
+  // where both are oriented alike; convexAt has the solid's sides.)
+  const double aDot = (F1.Orientation() == F2.Orientation() ? 1. : -1.) * N[0].Dot(N[1]);
+  return aDot <= 1.e-6;
+}
