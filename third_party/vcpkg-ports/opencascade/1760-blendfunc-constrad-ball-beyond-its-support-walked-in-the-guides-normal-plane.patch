+#include <gp_Ax1.hxx>
+#include <gp_Circ.hxx>
+#include <ElSLib.hxx>
+#include <gp_Cone.hxx>
+#include <gp_Cylinder.hxx>
+#include <gp_Pnt.hxx>
+#include <gp_Sphere.hxx>
+#include <gp_Torus.hxx>
+#include <gp_Vec.hxx>
+#include <gp_Vec2d.hxx>
+#include <math_Gauss.hxx>
+#include <math_Matrix.hxx>
+#include <math_SVD.hxx>
+#include <Precision.hxx>
+#include <Standard_DomainError.hxx>
+#include <Standard_NotImplemented.hxx>
+#include <Standard_TypeDef.hxx>
+
+#include <algorithm>
+#include <cmath>
+
+#define Eps 1.e-15
+
+//=================================================================================================
+
+bool BlendFunc_ConstRad::BallBeyondSupport(const occ::handle<Adaptor3d_Surface>& S,
+                                           const double                          Ray,
+                                           const occ::handle<Adaptor3d_Curve>&   Guide)
+{
+  if (S.IsNull() || Guide.IsNull())
+  {
+    return false;
+  }
+  // The guide's middle and its direction there.
+  const double first = Guide->FirstParameter();
+  const double last  = Guide->LastParameter();
+  if (Precision::IsInfinite(first) || Precision::IsInfinite(last))
+  {
+    return false;
+  }
+  gp_Pnt G;
+  gp_Vec T;
+  Guide->D1((first + last) / 2., G, T);
+  // The point of the support there (an elementary surface's own parameters).
+  double u = 0., v = 0.;
+  switch (S->GetType())
+  {
+    case GeomAbs_Cylinder:
+      ElSLib::Parameters(S->Cylinder(), G, u, v);
+      break;
+    case GeomAbs_Cone:
+      ElSLib::Parameters(S->Cone(), G, u, v);
+      break;
+    case GeomAbs_Sphere:
+      ElSLib::Parameters(S->Sphere(), G, u, v);
+      break;
+    case GeomAbs_Torus:
+      ElSLib::Parameters(S->Torus(), G, u, v);
+      break;
+    default:
+      return false;
+  }
+  gp_Pnt P;
+  gp_Vec Su, Sv, Suu, Svv, Suv;
+  S->D2(u, v, P, Su, Sv, Suu, Svv, Suv);
+  gp_Vec       n    = Su.Crossed(Sv);
+  const double norm = n.Magnitude();
+  // (The guide runs along the support's edge with the other support: a guide away from it
+  // is no edge of it.)
+  if (norm < Eps || P.Distance(G) > 0.5 * std::abs(Ray))
+  {
+    return false;
+  }
+  n /= norm;
+  // The guide's direction in the support's tangent plane, in its parameters.
+  const gp_Vec t  = T - n * T.Dot(n);
+  const double E  = Su.Dot(Su);
+  const double F  = Su.Dot(Sv);
+  const double GG = Sv.Dot(Sv);
+  const double det = E * GG - F * F;
+  if (det < Eps || t.Magnitude() < Eps)
+  {
+    return false;
+  }
+  const double a = (GG * Su.Dot(t) - F * Sv.Dot(t)) / det;
+  const double b = (E * Sv.Dot(t) - F * Su.Dot(t)) / det;
+  // The support's normal curvature along the guide: its centre of curvature lies at 1 / kn
+  // along the unit normal.
+  const double first_form  = E * a * a + 2. * F * a * b + GG * b * b;
+  const double second_form = Suu.Dot(n) * a * a + 2. * Suv.Dot(n) * a * b + Svv.Dot(n) * b * b;
+  if (first_form < Eps)
+  {
+    return false;
+  }
+  const double kn = second_form / first_form;
+  // The ball's centre lies at Ray along minus the unit normal: beyond the centre of curvature
+  // where it goes towards it farther than 1 / |kn| by more than 1e-6 (a ball of the support's
+  // own radius, 1520's tubes, is not; just above that radius the true ball's walk left the
+  // result invalid, so the margin is no wider).
+  return -Ray * kn > 0. && std::abs(Ray) > 1. / std::abs(kn) + 1.e-6;
+}
+
+//=================================================================================================
+
+
+bool BlendFunc_ConstRad::ComputeValuesInGuidePlane(const math_Vector& X,
+                                       const int          Order,
+                                       const bool         byParam,
+                                       const double       Param)
+{
+  // Per-thread scratch, reused across calls via the t_OK / myX_OK guards below.
+  static thread_local gp_Vec d3u1, d3v1, d3uuv1, d3uvv1, d3u2, d3v2, d3uuv2, d3uvv2;
+  static thread_local gp_Vec d1gui, d2gui, d3gui;
+  static thread_local gp_Pnt ptgui;
+  static thread_local double invnormtg, dinvnormtg;
+  double                     T = Param, aux;
+
+  // Case of implicite parameter
+  if (!byParam)
+  {
+    T = param;
+  }
+
+  // Is the work already done ?
+  bool myX_OK = (Order <= myXOrder);
+  for (int ii = 1; ((ii <= X.Length()) && myX_OK); ii++)
+  {
+    myX_OK = (X(ii) == xval(ii));
+  }
+
+  bool t_OK = ((T == tval) && ((Order <= myTOrder) || (!byParam)));
+
+  if (myX_OK && (t_OK))
+  {
+    return true;
+  }
+
+  // Processing of t
+  if (!t_OK)
+  {
+    tval = T;
+    if (byParam)
+    {
+      myTOrder = Order;
+    }
+    else
+    {
+      myTOrder = 0;
+    }
+    //----- Positioning on the curve ----------------
+    switch (myTOrder)
+    {
+      case 0: {
+        tcurv->D1(T, ptgui, d1gui);
+        nplan = d1gui.Normalized();
+      }
+      break;
+
+      case 1: {
+        tcurv->D2(T, ptgui, d1gui, d2gui);
+        nplan     = d1gui.Normalized();
+        invnormtg = ((double)1) / d1gui.Magnitude();
+        dnplan.SetLinearForm(invnormtg, d2gui, -invnormtg * (nplan.Dot(d2gui)), nplan);
+        break;
+      }
+      case 2: {
+        tcurv->D3(T, ptgui, d1gui, d2gui, d3gui);
+        nplan     = d1gui.Normalized();
+        invnormtg = ((double)1) / d1gui.Magnitude();
+        dnplan.SetLinearForm(invnormtg, d2gui, -invnormtg * (nplan.Dot(d2gui)), nplan);
+        dinvnormtg = -nplan.Dot(d2gui) * invnormtg * invnormtg;
+        d2nplan.SetLinearForm(invnormtg, d3gui, dinvnormtg, d2gui);
+        aux = dinvnormtg * (nplan.Dot(d2gui)) + invnormtg * (dnplan.Dot(d2gui) + nplan.Dot(d3gui));
+        d2nplan.SetLinearForm(-invnormtg * (nplan.Dot(d2gui)), dnplan, -aux, nplan, d2nplan);
+        break;
+      }
+      default:
+        return false;
+    }
+  }
+
+  // Processing of X
+  if (!myX_OK)
+  {
+    xval     = X;
+    myXOrder = Order;
+    //-------------- Positioning on surfaces -----------------
+    switch (myXOrder)
+    {
+      case 0: {
+        surf1->D1(X(1), X(2), pts1, d1u1, d1v1);
+        nsurf1 = d1u1.Crossed(d1v1);
+        surf2->D1(X(3), X(4), pts2, d1u2, d1v2);
+        nsurf2 = d1u2.Crossed(d1v2);
+        break;
+      }
+      case 1: {
+        surf1->D2(X(1), X(2), pts1, d1u1, d1v1, d2u1, d2v1, d2uv1);
+        nsurf1 = d1u1.Crossed(d1v1);
+        dns1u1 = d2u1.Crossed(d1v1).Added(d1u1.Crossed(d2uv1));
+        dns1v1 = d2uv1.Crossed(d1v1).Added(d1u1.Crossed(d2v1));
+        surf2->D2(X(3), X(4), pts2, d1u2, d1v2, d2u2, d2v2, d2uv2);
+        nsurf2 = d1u2.Crossed(d1v2);
+        dns1u2 = d2u2.Crossed(d1v2).Added(d1u2.Crossed(d2uv2));
+        dns1v2 = d2uv2.Crossed(d1v2).Added(d1u2.Crossed(d2v2));
+        break;
+      }
+      case 2: {
+        surf1->D3(X(1), X(2), pts1, d1u1, d1v1, d2u1, d2v1, d2uv1, d3u1, d3v1, d3uuv1, d3uvv1);
+        nsurf1 = d1u1.Crossed(d1v1);
+        dns1u1 = d2u1.Crossed(d1v1).Added(d1u1.Crossed(d2uv1));
+        dns1v1 = d2uv1.Crossed(d1v1).Added(d1u1.Crossed(d2v1));
+
+        surf2->D3(X(3), X(4), pts2, d1u2, d1v2, d2u2, d2v2, d2uv2, d3u2, d3v2, d3uuv2, d3uvv2);
+        nsurf2 = d1u2.Crossed(d1v2);
+        dns1u2 = d2u2.Crossed(d1v2).Added(d1u2.Crossed(d2uv2));
+        dns1v2 = d2uv2.Crossed(d1v2).Added(d1u2.Crossed(d2v2));
+        break;
+      }
+      default:
+        return false;
+    }
