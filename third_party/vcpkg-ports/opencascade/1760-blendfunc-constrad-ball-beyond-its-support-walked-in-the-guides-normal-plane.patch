+        D2EDXDT(1, 3) = dnplan.Dot(d1u2) / 2;
+        D2EDXDT(1, 4) = dnplan.Dot(d1v2) / 2;
+
+        carre = invnorm1 * invnorm1;
+        cube  = carre * invnorm1;
