+// The walked constant-radius blend with its sections in the guide's normal plane, as OCCT
+// 8.0.1 walks it (BlendFunc_ConstRad.cxx and BlendFunc_ConstRadInv.cxx before Mitcad's
+// patch 0075): the centre at the radius along each surface's normal projected into that
+// plane. BlendFunc_ConstRad and BlendFunc_ConstRadInv take these where a support curves
+// round the guide more tightly than the ball, towards its centre (BallBeyondSupport, 1760).
+// The functions are OCCT's own, renamed; BlendFunc_ConstRadInv's derivatives go through
+// ValuesInGuidePlane, whose derivative of the guide's plane is the right one.
+
+#include <Adaptor2d_Curve2d.hxx>
+#include <Adaptor3d_Curve.hxx>
+#include <Blend_Point.hxx>
+#include <BlendFunc.hxx>
+#include <BlendFunc_ConstRad.hxx>
