+// Whether stripe B's ride on A's contact line on face F (RideOnOverlap) has
+// a section of (nearly) no width: A, of one SurfData on F, has its contact
+// there along B's edge on F within Tol all along (sampled), so that B's
+// ball, touching its other face and passing through that line, touches
+// that face on its own edge or within Tol of it.
+static bool rideOfNoWidth(const TopOpeBRepDS_DataStructure& DStr,
+                          const occ::handle<ChFiDS_Stripe>& A,
+                          const occ::handle<ChFiDS_Stripe>& B,
+                          const TopoDS_Face&                F,
+                          const double                      Tol)
+{
+  if (A->SetOfSurfData().IsNull() || A->SetOfSurfData()->Length() != 1 || B->Spine()->NbEdges() != 1)
+  {
+    return false;
+  }
+  TopoDS_Edge EB;
+  for (TopExp_Explorer ex(F, TopAbs_EDGE); ex.More() && EB.IsNull(); ex.Next())
+  {
+    if (ex.Current().IsSame(B->Spine()->Edges(1)))
+    {
+      EB = TopoDS::Edge(ex.Current());
+    }
+  }
+  if (EB.IsNull())
+  {
+    return false;
+  }
+  double                        e1 = 0., e2 = 0.;
+  const occ::handle<Geom_Curve> CE = BRep_Tool::Curve(EB, e1, e2);
+  const occ::handle<ChFiDS_SurfData>& D = A->SetOfSurfData()->Value(1);
+  for (int k = 1; k <= 2; k++)
+  {
+    if (CE.IsNull() || D->IsOnCurve(k) || D->Index(k) <= 0 || !DStr.Shape(D->Index(k)).IsSame(F))
+    {
+      continue;
+    }
+    const ChFiDS_FaceInterference& FI = D->Interference(k);
+    if (FI.LineIndex() <= 0 || DStr.Curve(FI.LineIndex()).Curve().IsNull())
+    {
+      return false;
+    }
+    const occ::handle<Geom_Curve>& CA = DStr.Curve(FI.LineIndex()).Curve();
+    for (int is = 0; is <= 10; is++)
+    {
+      const double w = FI.FirstParameter() + (FI.LastParameter() - FI.FirstParameter()) * is / 10.;
+      GeomAPI_ProjectPointOnCurve aProj(CA->Value(w), CE, e1, e2);
+      if (aProj.NbPoints() == 0 || aProj.LowerDistance() > Tol)
+      {
+        return false;
+      }
+    }
+    return true;
+  }
+  return false;
+}
