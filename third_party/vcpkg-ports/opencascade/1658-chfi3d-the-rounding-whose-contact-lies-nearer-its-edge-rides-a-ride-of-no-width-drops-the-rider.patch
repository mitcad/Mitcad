+// How far from its edge on face F a constant rounding's contact lies there,
+// r / tan(a / 2) with a the angle between F and the edge's other face on
+// the ball's side (at the edge's middle); -1 where it is not known.
+static double contactReach(const occ::handle<ChFiDS_Stripe>& S, const TopoDS_Face& F, const ChFiDS_Map& EFMap)
+{
+  const occ::handle<ChFiDS_FilSpine> aFs = occ::down_cast<ChFiDS_FilSpine>(S->Spine());
+  const TopoDS_Edge                  E   = spineEdgeOf(S->Spine(), F);
+  if (aFs.IsNull() || !aFs->IsConstant() || E.IsNull() || !EFMap.Contains(E) || EFMap(E).Extent() != 2)
+  {
+    return -1.;
+  }
+  BRepAdaptor_Curve aC(E);
+  const gp_Pnt      aP = aC.Value(0.5 * (aC.FirstParameter() + aC.LastParameter()));
+  gp_Dir            aN[2];
+  int               k = 0;
+  for (NCollection_List<TopoDS_Shape>::Iterator it(EFMap(E)); it.More() && k < 2; it.Next(), k++)
+  {
+    const TopoDS_Face aF = TopoDS::Face(it.Value());
+    BRepAdaptor_Surface aS(aF);
+    GeomAPI_ProjectPointOnSurf aProj(aP, BRep_Tool::Surface(aF));
+    if (aProj.NbPoints() == 0)
+    {
+      return -1.;
+    }
+    double u = 0., v = 0.;
+    aProj.LowerDistanceParameters(u, v);
+    BRepLProp_SLProps aProps(aS, u, v, 1, Precision::Confusion());
+    if (!aProps.IsNormalDefined())
+    {
+      return -1.;
+    }
+    aN[k] = aProps.Normal();
+    if (aF.Orientation() == TopAbs_REVERSED)
+    {
+      aN[k].Reverse();
+    }
+  }
+  const double a = M_PI - aN[0].Angle(aN[1]);
+  if (a <= Precision::Angular() || a >= M_PI - Precision::Angular())
+  {
+    return -1.;
+  }
+  return aFs->Radius() / std::tan(0.5 * a);
+}
