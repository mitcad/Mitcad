[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "mitcad#2064, tools/ui-input-picks-test.sh: three boxes of 10 at x 0, 20 and 40 (Body1 F1.b0, Body2 F2.b0, Body3 F3.b0); Sketch1 (F4) with a line c3 from (0, 20) to (0, 80); PathPattern1 (F5) copies the three bodies once 20 mm along it; Fillet1 (F6) rounds two opposite top edges of Body1 with 2 mm; a plate 60 x 40 x 5 at (0, 90) (F7), a boss of 8 mm 15 mm high at (10, 100) joined on it (Sketch2 F8, Extrude1 F9) and RectangularPattern1 (F10) of the boss's side and top three times 20 mm along X. All geometry is synthetic."},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [0, 0],
    "length": 10, "width": 10, "height": 10, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [20, 0],
    "length": 10, "width": 10, "height": 10, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [40, 0],
    "length": 10, "width": 10, "height": 10, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "sketch", "plane": "xy", "entities": [
    {"id": "p1", "type": "point", "at": [0, 20], "fixed": true},
    {"id": "p2", "type": "point", "at": [0, 80], "fixed": true},
    {"id": "c3", "type": "line", "start": "p1", "end": "p2"}]}},
  {"cmd": "add_feature", "def": {"type": "path_pattern",
    "objects": {"type": "bodies", "bodies": ["F1.b0", "F2.b0", "F3.b0"]},
    "path": {"sketch": "F4", "curve": "c3"}, "quantity": 2, "distance": 20,
    "distance_type": "spacing", "start": 0, "flip": false, "along_path": false, "symmetric": false}},
  {"expect": {"feature": "F5", "status": "ok"}},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F1.b0",
    "edges": ["E{F1:side0|F1:top}", "E{F1:side2|F1:top}"], "radius": 2}},
  {"expect": {"feature": "F6", "status": "ok"}},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [0, 90],
    "length": 60, "width": 40, "height": 5, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "sketch", "plane": "xy", "entities": [
    {"id": "p1", "type": "point", "at": [10, 100], "fixed": true},
    {"id": "c2", "type": "circle", "center": "p1", "radius": 4}]}},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F8", "region": "r{c2}"}],
    "extent": {"type": "distance", "distance": 15}, "operation": "join", "participants": ["F7.b0"]}},
  {"expect": {"feature": "F9", "status": "ok"}},
  {"cmd": "add_feature", "def": {"type": "rectangular_pattern",
    "objects": {"type": "faces", "body": "F7.b0", "faces": ["F9:side(c2)", "F9:end(r{c2})"]},
    "direction1": {"axis": {"type": "origin", "axis": "x"}, "quantity": 3, "distance": 20},
    "distance_type": "spacing"}},
  {"expect": {"feature": "F10", "status": "ok"}}
]
