# SPDX-License-Identifier: MIT
# Both inner boxes are wholly enclosed by Outer, including their bottom faces.
wait-idle 30
window-resize 1280 900
expect-viewport
command view.fit
expect-ever 'Timeline Inner at '
expect-selection 0 0
capture-view-image '${MITCAD_TEST_SHOTS}/baseline.png'
mark
hover-logged '^Timeline Inner at '
expect-timeline-hover F1
expect-log '^Timeline hover highlighted: F1 6$'
expect-timeline-tooltip '(?s)Box: Inner.*Component: Root.*Length: 10.*Width: 10.*Height: 10'
expect-selection 0 0
expect-view-image '${MITCAD_TEST_SHOTS}/baseline.png' changed
screenshot '${MITCAD_TEST_SHOTS}/hidden-hover.png'
timeline-leave
expect-timeline-hover none
expect-log '^Timeline hover highlighted: none$'
expect-view-image '${MITCAD_TEST_SHOTS}/baseline.png' same
mark
click-logged '^Timeline Inner at '
timeline-leave
expect-selection 1 0
expect-selection-info '(?s)\A(?!.*F1)(?!.*O1).*Selected: Inner.*Box: Inner.*Component: Root.*Length: 10.*Width: 10.*Height: 10'
expect-view-image '${MITCAD_TEST_SHOTS}/baseline.png' changed
screenshot '${MITCAD_TEST_SHOTS}/hidden-selected.png'
key Escape
expect-selection 0 0
expect-view-image '${MITCAD_TEST_SHOTS}/baseline.png' same
# Folded group hover previews both members and clears without selecting them.
click-logged '^Timeline group Inner details at '
hover-logged '^Timeline group Inner details at '
expect-timeline-hover F1,F2
expect-log '^Timeline hover highlighted: F1 6, F2 6$'
expect-timeline-tooltip '(?s)Inner details.*2 feature'
expect-selection 0 0
expect-view-image '${MITCAD_TEST_SHOTS}/baseline.png' changed
timeline-leave
expect-view-image '${MITCAD_TEST_SHOTS}/baseline.png' same
# Failed, suppressed and rolled-back cells never show cached geometry.
hover-logged '^Timeline Failed round at '
expect-timeline-hover none
expect-timeline-tooltip '(?s)Fillet: Failed round.*No geometry to show'
expect-view-image '${MITCAD_TEST_SHOTS}/baseline.png' same
hover-logged '^Timeline Suppressed detail at '
expect-timeline-hover none
expect-timeline-tooltip '(?s)Box: Suppressed detail.*Suppressed.*No geometry to show'
expect-view-image '${MITCAD_TEST_SHOTS}/baseline.png' same
hover-logged '^Timeline Later plane at '
expect-timeline-hover none
expect-timeline-tooltip '(?s)Later plane.*Rolled back.*No geometry to show'
expect-view-image '${MITCAD_TEST_SHOTS}/baseline.png' same
# A thread's hover text leads with its size, before its sizes; a tapped
# hole names its thread (mitcad#1235).
hover-logged '^Timeline Thread M76 at '
expect-timeline-tooltip '(?s)Thread: Thread M76.*Component: Root.*M76x2 6H, internal, modeled.*Radial Clearance: 0\.2 mm; Flank clearance: 0\.1 mm; Length: 10 mm'
hover-logged '^Timeline Thread M6 at '
expect-timeline-tooltip '(?s)Thread: Thread M6.*Component: Root.*M6x1 6g, external, cosmetic'
hover-logged '^Timeline Tapped hole at '
expect-timeline-tooltip '(?s)Hole: Tapped hole.*Component: Root.*Simple hole, M6x1 6H, internal, cosmetic'
timeline-leave
# A Fillet's picked edges are drawn where they were, its card names how
# many, and they go with the selection (mitcad#957).
mark
click-logged '^Timeline Fillet1 at '
timeline-leave
expect-selection 1 0
expect-log '^Feature inputs highlighted: Fillet1 edges 4$'
expect-selection-info '(?s)Fillet: Fillet1.*4 edges; Radius: 2 mm'
expect-view-image '${MITCAD_TEST_SHOTS}/baseline.png' changed
screenshot '${MITCAD_TEST_SHOTS}/fillet-edges.png'
key Escape
expect-selection 0 0
expect-log '^Feature inputs highlighted: none$'
expect-view-image '${MITCAD_TEST_SHOTS}/baseline.png' same
expect-never 'OCCT view event failed|The document was read while a job computes it|TestDriver: FAIL'
