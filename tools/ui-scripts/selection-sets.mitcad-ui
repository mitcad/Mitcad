# SPDX-License-Identifier: MIT
# Selection sets (mitcad#2192) on selection-sets.json: Sketch1 (F1) used by
# Extrude1 (F2, its body Body1), and the box Block (F3).
#   1. Block, Sketch1 and Extrude1 selected in the Browser, Create Selection
#      Set from Block's row menu: one undo step, a Selection Sets folder
#      beside Named Views, the set's row renamed in place (SelectionSet1
#      typed over: Favourites). Extrude1's body is not a member of its own:
#      the feature's row selected it.
#   2. A click on the set's row selects the three: Sketch1, Extrude1 and
#      Block in the timeline, their own rows in the Browser.
#   3. The set opened, its member rows: Find in Timeline on Extrude1's
#      selects Extrude1 in the timeline; Find in Browser on Sketch1's
#      selects Sketch1's own row.
#   4. Remove from Set on Block's member row, and Undo.
#   5. Delete on the set's row deletes the set alone, and Undo.
#   6. Undo of the rename and of the creation, Redo of both; saved (the
#      wrapper checks the file with selection-sets-check.json).
# Run by tools/ui-selection-sets-test.sh (Linux),
# tools/ui-windows-selection-sets-test.ps1 (Windows) and
# tools/ui-macos-selection-sets-test.sh (macOS).
wait-idle
command view.fit
wait-idle
expect-ever '^Browser Root/Bodies/Block at '
expect-ever '^Browser Root/Sketches/Sketch1 at '
expect-never '^Browser Root/Selection Sets'
capture-undo-depth start

# 1. Block, Sketch1 and Extrude1 selected; Create Selection Set, renamed
# Favourites in place.
mark
click-logged '^Browser arrow Root/Sketches/Sketch1 at '
wait-log '^Browser Root/Sketches/Sketch1/Extrude1 at '
wait-idle
click-logged '^Browser Root/Bodies/Block at '
click-logged '^Browser Root/Sketches/Sketch1 at ' left ctrl
click-logged '^Browser Root/Sketches/Sketch1/Extrude1 at ' left ctrl
wait-idle
mark
context-menu-logged '^Browser Root/Bodies/Block at ' 'Create Selection Set'
wait-log '^Created selection set SelectionSet1: body F3\.b0, feature F1, feature F2$'
wait-log '^Browser Selection Sets: SelectionSet1 \[Block, Sketch1, Extrude1\]$'
wait-log '^Renaming Root/Selection Sets/SelectionSet1$'
wait-idle
key Ctrl+a
type 'Favourites'
key Return
wait-log '^Renamed SelectionSet1 to Favourites$'
wait-log '^Browser Selection Sets: Favourites \[Block, Sketch1, Extrude1\]$'
wait-log '^Browser Root/Selection Sets/Favourites at '
expect-undo-depth ${start} 2

# 2. A click on the set's row selects its three members.
mark
click-logged '^Browser Root/Bodies/Body1 at '
wait-log '^Timeline selected: F2$'
wait-idle
mark
click-logged '^Browser Root/Selection Sets/Favourites at '
wait-log '^Timeline selected: F1, F2, F3$'
wait-log '^Browser selected: (?=.*Root/Bodies/Block(,|$))(?=.*Root/Sketches/Sketch1(,|$))(?=.*Root/Sketches/Sketch1/Extrude1(,|$))'
wait-idle
expect-undo-depth ${start} 2

# 3. The member rows find their items' own places.
mark
click-logged '^Browser arrow Root/Selection Sets/Favourites at '
wait-log '^Browser Root/Selection Sets/Favourites/Block at '
wait-log '^Browser Root/Selection Sets/Favourites/Sketch1 at '
wait-log '^Browser Root/Selection Sets/Favourites/Extrude1 at '
wait-idle
mark
context-menu-logged '^Browser Root/Selection Sets/Favourites/Extrude1 at ' 'Find in Timeline'
expect-log '^Context menu: .*\| Find in Timeline \| .*\| Find in Browser \| Remove from Set \| Collapse All$'
wait-log '^Found F2 in the timeline$'
wait-idle
mark
context-menu-logged '^Browser Root/Selection Sets/Favourites/Sketch1 at ' 'Find in Browser'
wait-log '^Found Sketch1 in the browser$'
wait-log '^Browser selected: Root/Sketches/Sketch1$'
wait-idle
expect-undo-depth ${start} 2

# 4. Remove from Set on Block's member row; Undo puts it back.
mark
context-menu-logged '^Browser Root/Selection Sets/Favourites/Block at ' 'Remove from Set'
wait-log '^Removed Block from selection set Favourites$'
wait-log '^Browser Selection Sets: Favourites \[Sketch1, Extrude1\]$'
expect-undo-depth ${start} 3
mark
command edit.undo
wait-log '^Undo: Change Selection Set Favourites$'
wait-log '^Browser Selection Sets: Favourites \[Block, Sketch1, Extrude1\]$'
expect-undo-depth ${start} 2

# 5. Delete on the set's row: the set alone goes, its items stay; Undo.
mark
context-menu-logged '^Browser Root/Selection Sets/Favourites at ' 'Delete'
expect-log '^Context menu: Select \| Add Selection \| Replace with Selection \| Rename \| Delete \| Collapse All$'
wait-log '^Deleted selection set Favourites$'
wait-log '^Browser Selection Sets: none$'
wait-log '^Browser Root/Selection Sets out of sight$'
expect-never 'Recompute failed'
mark
command edit.undo
wait-log '^Undo: Delete [Ss]election [Ss]et Favourites$'
wait-log '^Browser Selection Sets: Favourites \[Block, Sketch1, Extrude1\]$'
expect-undo-depth ${start} 2

# 6. The rename and the creation undone and redone; saved.
mark
command edit.undo
wait-log '^Undo: Rename Selection Set SelectionSet1$'
wait-log '^Browser Selection Sets: SelectionSet1 \[Block, Sketch1, Extrude1\]$'
mark
command edit.undo
wait-log '^Undo: Add Selection Set SelectionSet1$'
wait-log '^Browser Selection Sets: none$'
expect-undo-depth ${start} 0
mark
command edit.redo
wait-log '^Browser Selection Sets: SelectionSet1 \[Block, Sketch1, Extrude1\]$'
mark
command edit.redo
wait-log '^Browser Selection Sets: Favourites \[Block, Sketch1, Extrude1\]$'
expect-undo-depth ${start} 2
command file.save
wait-log '^Saved '
expect-never 'Recompute failed|TestDriver: FAIL'
