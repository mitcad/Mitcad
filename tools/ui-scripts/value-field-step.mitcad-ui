# SPDX-License-Identifier: MIT
# Up, Down and the mouse wheel step a value field's number (mitcad#1254,
# GitHub mitcad/Mitcad#129), and so do the step buttons at its right end
# and the 3D view's value boxes (mitcad#2327, GitHub mitcad/Mitcad#594),
# on value-field-step.json (a 10 mm cube F2.b0 and a sketch F3 with a
# square):
#   1. Extrude F3's square: its Distance holding `d1*2` is not stepped by
#      Up (the expression stays), its step buttons show disabled and a
#      click on the up button leaves it too; 10 mm and Shift+Up is 20 mm,
#      previewed at once as a typed value; a click on the up button is
#      21 mm, Shift and a click 31 mm, the down button held steps down
#      again and again (30 mm, 29 mm, ...).
#   2. Box on the cube's top face: a click on its Height's value box in
#      the view opens the box with 10 mm; Up is 11 mm, Shift+Up 21 mm and
#      a wheel notch over the box 22 mm, each previewed as typed; the view
#      neither turns nor zooms. Enter keeps it; the command is cancelled.
#   3. Circular Pattern of the cube about one of its top edges: Quantity 4
#      and Up is 5, previewed; the wheel over Total Angle, a field without
#      the keyboard, changes nothing; the wheel over Quantity, which has
#      it, steps it to 6; OK is one undo step.
#   4. Sketch F3 edited: the rectangle tool's Width typed 40 mm, its up
#      button steps it to 41 mm, and the rectangle is added 41 mm wide.
# Run by tools/ui-value-field-step-test.sh (Linux) and
# tools/ui-windows-value-field-step-test.ps1 (Windows).
expect-ever 'View area'
wait-idle
command view.fit
wait-idle

# 1. Extrude: an expression is left alone, Shift+Up steps by 10 mm.
mark
command solid.extrude
expect-log '^Command Extrude started'
wait-idle
# Extrude may preselect a profile: cleared, so that the click adds F3's.
mark
button '.*' clear_profiles
wait-log '^Extrude Profiles: nothing$'
wait-log '^Pick profile F3/r' 20
click-pick 'profile F3/r'
wait-log '^Extrude Profiles: 1 profile'
# Typed character by character: the step buttons turn off at the first
# one that makes no plain value (mitcad#2327).
mark
type-in '^Panel Extrude input distance at ' 'd1*2'
expect-input-text distance '^d1[*]2$'
expect-log '^Step buttons Extrude Distance off: '
mark
key Up
expect-log '^Value field Extrude Distance: Up not stepped: d1[*]2 is not a plain value$'
expect-input-text distance '^d1[*]2$'
# A click on the disabled up button leaves the expression too.
mark
click-logged '^Panel Extrude step-up distance at '
wait-idle
expect-input-text distance '^d1[*]2$'
expect-no-log '^Value field Extrude Distance: Up button'
mark
type-in '^Panel Extrude input distance at ' '10 mm'
wait-log '^Extrude Distance: 10 mm = 10 mm'
expect-log '^Step buttons Extrude Distance on$'
wait-idle
mark
key shift+Up
expect-log '^Value field Extrude Distance: Shift[+]Up stepped 10 mm to 20 mm$'
expect-input-text distance '^20 mm$'
wait-log '^Extrude Distance: 20 mm = 20 mm'
wait-log '^Preview Extrude: ok' 30
wait-idle
# The step buttons (mitcad#2327): the up button steps as Up does, with
# Shift as Shift+Up, previewed as typed.
mark
click-logged '^Panel Extrude step-up distance at '
expect-log '^Value field Extrude Distance: Up button stepped 20 mm to 21 mm$'
expect-input-text distance '^21 mm$'
wait-log '^Extrude Distance: 21 mm = 21 mm'
wait-idle
mark
click-logged '^Panel Extrude step-up distance at ' shift
expect-log '^Value field Extrude Distance: Shift[+]Up button stepped 21 mm to 31 mm$'
expect-input-text distance '^31 mm$'
wait-log '^Extrude Distance: 31 mm = 31 mm'
wait-log '^Preview Extrude: ok' 30
wait-idle
# The down button held: a step at once, then repeats after the delay.
mark
pointer-logged press '^Panel Extrude step-down distance at ' left
sleep 2000
pointer-logged release '^Panel Extrude step-down distance at ' left
expect-log '^Value field Extrude Distance: Down button stepped 31 mm to 30 mm$'
expect-log '^Value field Extrude Distance: Down button held stepped 30 mm to 29 mm$'
expect-input-text distance '^(29|2[0-8]|1?[0-9]|-[0-9]+) mm$'
wait-idle
wait-log '^Preview Extrude: ok' 30
mark
button '^OK$'
wait-log '^Added Extrude' 30
wait-idle

# 2. Box: its Height's value box in the view steps with Up, Shift+Up and
#    the wheel (mitcad#2327); the view neither turns nor zooms. Height's
#    box, above the cube: Length's lies beyond it, under the panel. The
#    view fitted to the preview too: in the Windows VM's 1024 px wide
#    window Height's box lay right of the view, under the panel's dock.
mark
command solid.box
expect-log '^Command Box started' 10
wait-idle
click-pick 'face F2[.]b0/F2:end'
wait-log '^Box Place On: 1 face'
wait-log '^Preview Box: ok' 30
wait-log '^Value box Box height at ' 30
wait-idle
mark
command view.fit
wait-log '^Value box Box height at ' 30
wait-idle
mark
click-logged '^Value box Box height at '
wait-log '^Value box Box height opened: 10 mm at '
capture-view-height before_box
capture-view-orientation turned_box
mark
key Up
expect-log '^Value field Box Height: Up stepped 10 mm to 11 mm$'
wait-log '^Box Height: 11 mm = '
mark
key shift+Up
expect-log '^Value field Box Height: Shift[+]Up stepped 11 mm to 21 mm$'
wait-log '^Box Height: 21 mm = '
wait-idle
mark
wheel-logged '^Value box Box height opened: ' 1
expect-log '^Value field Box Height: wheel stepped 21 mm to 22 mm$'
wait-log '^Box Height: 22 mm = '
wait-log '^Preview Box: ok' 30
wait-idle
expect-view-zoom ${before_box} unchanged
expect-view-orientation ${turned_box} unchanged
mark
key Return
wait-log '^Value box Box height closed: 22 mm'
wait-idle
mark
button '^Cancel$'
wait-log '^Command Box cancelled' 30
wait-idle

# 3. Circular Pattern: Quantity 4, Up, 5 previewed; the wheel.
capture-undo-depth before_pattern
mark
command solid.circular_pattern
expect-log '^Command Circular Pattern started'
wait-idle
click-logged '^Body F2[.]b0 at '
wait-log '^Circular Pattern Objects: 1 body'
mark
click-logged '^Panel Circular Pattern input axis at '
wait-log '^Pick edge F2[.]b0/E[{].*F2:end' 20
click-pick 'edge F2[.]b0/E[{].*F2:end'
wait-log '^Circular Pattern Axis: 1 edge'
wait-log '^Preview Circular Pattern: ok' 30
wait-idle
expect-input-text quantity '^4$'
click-logged '^Panel Circular Pattern input quantity at '
wait-idle
mark
key Up
expect-log '^Value field Circular Pattern Quantity: Up stepped 4 to 5$'
expect-input-text quantity '^5$'
wait-log '^Circular Pattern Quantity: 5 = '
wait-log '^Preview Circular Pattern: ok' 30
wait-idle
# The wheel over a field without the keyboard is the panel's: no value
# changes (Quantity keeps the keyboard).
mark
wheel-logged '^Panel Circular Pattern input angle at ' 1
wheel-logged '^Panel Circular Pattern input angle at ' -1
wait-idle
expect-input-text angle '^360 deg$'
expect-input-text quantity '^5$'
expect-no-log '^Value field Circular Pattern Total Angle'
# The wheel over the field with the keyboard steps it.
mark
wheel-logged '^Panel Circular Pattern input quantity at ' 1
expect-log '^Value field Circular Pattern Quantity: wheel stepped 5 to 6$'
expect-input-text quantity '^6$'
wait-log '^Preview Circular Pattern: ok' 30
mark
button '^OK$'
wait-log '^Added Circular Pattern' 30
wait-idle
expect-undo-depth ${before_pattern} 1

# 4. A sketch tool's field (mitcad#2327): the rectangle's Width, typed
#    into, steps with its up button.
mark
dblclick-logged '^Timeline Sketch2 at '
wait-log '^Editing sketch F3 \(Sketch2\)' 30
wait-idle
mark
command sketch.rectangle
sketch-click 0 0
type '40 mm'
wait-log '^Sketch value width: 40 mm = 40 mm'
wait-log '^Step buttons sketch width up at '
wait-idle
mark
click-logged '^Step buttons sketch width up at '
expect-log '^Value field sketch width: Up button stepped 40 mm to 41 mm$'
wait-log '^Sketch value width: 41 mm = 41 mm'
key Tab
type '15 mm'
wait-log '^Sketch value height: 15 mm = 15 mm'
key Return
wait-log 'Added rectangle 41 x 15 mm at \(0, 0\)' 30
key Escape
wait-idle
mark
command sketch.finish
wait-log '^Sketch finished' 30
wait-idle
expect-never 'Recompute failed|TestDriver: FAIL'
