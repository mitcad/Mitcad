# SPDX-License-Identifier: MIT
# panel-first-field-keys.mitcad-ui with the Docked layout's Command panel
# floated, a window of its own (mitcad#2391, GitHub mitcad/Mitcad#617: the
# case reported): Extrude opened with E gives Distance the keyboard by
# activating the floated panel's window, 25 typed without a click and Enter
# add a 25 mm extrusion with the view unturned, and once the panel is
# closed the 3D view has the keys again (the main window activated back).
# Run by tools/ui-panel-first-field-keys-test.sh (Docked).
expect-ever 'View area'
wait-idle
dock-float commandDock 1080 120 420 620
expect-dock-float commandDock 1080 120 420 620
expect-dock-area commandDock floating
sleep 500
wait-idle

# 1. Extrude from the edited sketch.
mark
dblclick-logged '^Timeline Sketch1 at '
expect-log '^Editing sketch F1 \(Sketch1\)'
wait-idle
mark
key e
wait-log '^Command Extrude started'
wait-log '^Panel Extrude: first value field \(distance\) focused; ' 30
# A new Extrude starts at 0 mm and waits for a distance (mitcad#2481).
wait-log '^Preview Extrude: not built: Type a distance or drag the arrow[.]$' 30
# The floated panel's window is activated a moment later (the system's
# activation arrives as an event); the field's selection comes with it.
sleep 500
wait-idle
capture-view-orientation opened

# 2. 25 typed into Distance without a click; Enter is OK.
mark
type 25
wait-log '^Panel field distance: ' 30
wait-log '^Preview Extrude: ok' 30
wait-idle
expect-input-text distance '^25$'
expect-view-orientation ${opened} unchanged
mark
key Return
expect-log 'Added extrude \(New Body\), distance 25' 20
expect-model-bodies 1 7853.981633974483
expect-view-orientation ${opened} unchanged

# 3. The 3D view has the keys again: 1 is the front view.
wait-idle
mark
key 1
wait-log '^Camera direction -?0 1 -?0 up -?0 -?0 1 ' 30
expect-view-orientation ${opened} changed
expect-never 'TestDriver: FAIL'
