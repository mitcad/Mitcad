# The design window's kept place (mitcad#1710, GitHub mitcad/Mitcad#283),
# a start with no place kept: MitCad opens at its start size; the window is
# resized to 900 x 600 and moved 70, 50 from its screen's available area's
# top left. Its place is kept when MitCad ends after the script.
# Run by tools/ui-window-place-test.sh and
# tools/ui-windows-window-place-test.ps1.
expect-ever '^Window place: none saved, ' 10
wait-idle
window-resize 900 600
window-move 70 50
sleep 300
wait-idle
expect-window-state normal
expect-window-place 70 50 900 600
