# SPDX-License-Identifier: MIT
# The Docked layout's workspace selector on macOS (mitcad#2082, GitHub
# mitcad/Mitcad#476), where the system shows the menus and the Docked
# toolbar has no top bar above it (Windows and Linux:
# docked-workspaces.mitcad-ui), through the real UI, on a box with one
# drawing (workspaces.json), in a 1280 x 800 window:
#   0. The workspace block at the toolbar's left, as high as the tab row
#      and the groups together, 8 px to them; Design's tabs with the Start
#      tab first, Make's out of sight; the quick-access group flat at the
#      tab row's right end, Undo and Redo first inside it, the command
#      search field after it; the Boost development button in the tab
#      row (the system shows the menu bar); one ˅
#      per group caption; the fonts of docs/ui-conventions.md §10 (pill
#      tabs 0.92 DemiBold, captions 0.92 Regular, the block's name 1.00
#      DemiBold and its line 0.85 Regular, labels 0.85 Regular, all in the
#      application font's family).
#   1. Outside Render the window's menu of its panels lists none of the
#      Render workspace's docks.
#   2. Design -> Make from the selector's list: only 3D Print, Laser and
#      CNC of the workspaces' tabs (Start stays first), Design's out of
#      sight; Laser shown.
#   3. Make -> Render: the RENDER tab alone with its own row, the rendered
#      view on (where the render worker is there), its docks shown and the
#      model's hidden; the panels' menu lists its docks there.
#   4. Render -> Design: Design's tabs, the docks shown before and the view
#      mode of before; Design -> Make opens on Laser, the tab shown last
#      there; back to Design.
#   5. The Timeline hidden by the user, the Projects panel shown. Drawing
#      from the selector opens the design's drawing: Command and Projects
#      hidden, the Browser stays, the Timeline stays hidden. Close Drawing
#      shows exactly Command and Projects again; the Timeline stays hidden.
#   6. The Start page shown (one design: no designs' tabs to go back by):
#      the toolbar its tab row alone, the workspace block and the groups'
#      row hidden; Solid's tab leaves the page with both back. The page
#      again, Drawing chosen over it (as the selector would): the page
#      goes, the block and the groups back, the drawing opens with the same
#      docks hidden; Close Drawing shows the docks shown before the Start
#      page.
#   7. The selector disabled while a sketch is edited, enabled after it.
# Run by tools/ui-macos-docked-workspaces-test.sh (macOS, Docked).
expect-ever 'View area' 30
window-resize 1280 800
wait-idle
expect-ever '^Quick access group: flat [(]Docked[)]$' 30
expect-ever '^Ribbon workspace: DESIGN [(]tabs SOLID, SURFACE, SHEET METAL, BUILD, MANAGE[)]$' 30
expect-ever '^Ribbon workspace at ' 30
expect-ever '^Ribbon workspace block: left of the card [(]x [0-9]+-[0-9]+, the card from x [0-9]+, gap 8[)], as high as both rows: yes ' 30
expect-ever '^Quick access leading ribbonToolbarUndo at [0-9]+,[0-9]+: inside the group, first$' 30
expect-ever '^Quick access leading ribbonToolbarRedo at [0-9]+,[0-9]+: inside the group, first$' 30
expect-ever '^Ribbon tab row end: (.*, )?quickAccess, boostButton, ribbonSearch$' 30
expect-ever '^Boost button row: the tab row [(]Docked, the system.s menu bar[)]$' 30
expect-ever '^Ribbon captions: [1-9][0-9]* shown, one ˅ each: yes$' 30
expect-ever '^Ribbon fonts: application (.+) [0-9.]+pt; tab shown \1 0[.]92 DemiBold; tab not shown \1 0[.]92 DemiBold; caption \1 0[.]92 Regular; workspace name \1 1[.]00 DemiBold; workspace line \1 0[.]85 Regular; labels \1 0[.]85 Regular$' 30
expect-ever '^Ribbon tab START at ' 30
expect-ever '^Ribbon tab SOLID at ' 30
expect-ever '^Ribbon tab MAKE_PRINT out of sight$' 30
expect-widget-property ribbonWorkspace enabled true
expect-dock browserDock shown
expect-dock timelineDock shown
expect-dock commandDock shown
wait-idle

# 1. The panels' menu outside Render: none of the Render docks.
dock-title-context browserDock
expect-popup-entries '^(?!.*\b(Appearances|Look|Lights|Environment|Shots|Output)\b)Browser [|] Timeline'
key Escape
wait-idle

# 2. Design -> Make (the list opens on the current workspace's entry:
# the arrow keys and Enter choose).
sleep 300
mark
click-logged '^Ribbon workspace at '
wait-log '^Ribbon workspace menu: Design [(]current[)] [|] Make [|] Render [|] Drawing$'
wait-log '^Ribbon workspace entry MAKE at '
key Down
key Return
wait-log '^Ribbon workspace chosen: MAKE$'
wait-log '^Ribbon workspace: MAKE [(]tabs MAKE_PRINT, MAKE_LASER, MAKE_CNC[)]$'
wait-log '^Ribbon tab shown: MAKE_PRINT$'
wait-idle
wait-log '^Ribbon tab MAKE_PRINT at '
wait-log '^Ribbon tab MAKE_LASER at '
wait-log '^Ribbon tab MAKE_CNC at '
wait-log '^Ribbon tab SOLID out of sight$'
wait-log '^Ribbon tab MANAGE out of sight$'
expect-ever '^Ribbon tab START at ' 10
mark
click-logged '^Ribbon tab MAKE_LASER at '
wait-log '^Ribbon tab shown: MAKE_LASER$'
wait-idle

# 3. Make -> Render.
sleep 300
mark
click-logged '^Ribbon workspace at '
wait-log '^Ribbon workspace menu: Design [|] Make [(]current[)] [|] Render [|] Drawing$'
wait-log '^Ribbon workspace entry RENDER at '
key Down
key Return
wait-log '^Ribbon workspace chosen: RENDER$'
wait-log '^Ribbon tabs: RENDER [(]shown RENDER[)]$'
wait-log '^Ribbon workspace: RENDER [(]tabs RENDER[)]$'
wait-log '^Workspace RENDER: the rendered view (on|not available)$'
wait-log '^Render workspace opened$' 30
wait-idle
wait-log '^Ribbon tab RENDER: its own row$'
expect-dock-area renderLeftPanel left
expect-dock-area renderSettingsPanel right
expect-dock-area renderBarPanel bottom
expect-dock browserDock hidden
expect-dock timelineDock hidden
expect-dock commandDock hidden
dock-title-context renderLeftPanel
expect-popup-entries '\bShots\b'
key Escape
wait-idle

# 4. Render -> Design: the model's tabs, docks and view mode back.
sleep 300
mark
click-logged '^Ribbon workspace at '
wait-log '^Ribbon workspace menu: Design [|] Make [|] Render [(]current[)] [|] Drawing$'
wait-log '^Ribbon workspace entry DESIGN at '
key Up
key Up
key Return
wait-log '^Ribbon workspace chosen: DESIGN$'
wait-log '^Workspace RENDER left: the rendered view off$'
wait-log '^Render workspace closed$' 30
wait-log '^Ribbon workspace: DESIGN [(]tabs SOLID, SURFACE, SHEET METAL, BUILD, MANAGE[)]$'
wait-idle
wait-log '^Ribbon tab SOLID at '
wait-log '^Ribbon tab MAKE_PRINT out of sight$'
expect-dock browserDock shown
expect-dock timelineDock shown
expect-dock commandDock shown
dock-title-context browserDock
expect-popup-entries '^(?!.*\b(Appearances|Look|Lights|Environment|Shots|Output)\b)Browser [|] Timeline'
key Escape
wait-idle
# Make opens on the tab shown last there.
sleep 300
mark
click-logged '^Ribbon workspace at '
wait-log '^Ribbon workspace entry MAKE at '
key Down
key Return
wait-log '^Ribbon workspace chosen: MAKE$'
wait-log '^Ribbon tab shown: MAKE_LASER$'
wait-idle
sleep 300
mark
click-logged '^Ribbon workspace at '
wait-log '^Ribbon workspace entry DESIGN at '
key Up
key Return
wait-log '^Ribbon workspace chosen: DESIGN$'
wait-log '^Ribbon tab shown: SOLID$'
wait-idle

# 5. A drawing hides the model's docks; one the user hid stays hidden.
expect-dock projectsDock hidden
dock-close timelineDock
expect-dock timelineDock hidden
menu View/Panels/Projects
expect-dock projectsDock shown
wait-idle
sleep 300
mark
click-logged '^Ribbon workspace at '
wait-log '^Ribbon workspace entry DRAWING at '
key Down
key Down
key Down
key Return
wait-log '^Ribbon workspace chosen: DRAWING$'
wait-log '^Workspace DRAWING: opened D1$'
wait-log '^Ribbon tabs: DRAWING [(]shown DRAWING[)]$'
wait-log '^Drawing docks hidden: commandDock, projectsDock$'
wait-idle
expect-dock browserDock shown
expect-dock commandDock hidden
expect-dock projectsDock hidden
expect-dock timelineDock hidden
mark
command drawing.close
wait-log '^Drawing docks shown again: commandDock, projectsDock$'
wait-log '^Ribbon tab shown: SOLID$'
wait-idle
expect-dock browserDock shown
expect-dock commandDock shown
expect-dock projectsDock shown
expect-dock timelineDock hidden

# 6. The Start page: the tab row alone; Solid's tab leads back.
sleep 300
mark
click-logged '^Ribbon tab START at '
wait-log '^Start page shown$'
wait-log '^Docked toolbar on the Start page: tab row only$'
wait-idle
expect-dock browserDock hidden
expect-dock commandDock hidden
expect-widget-property ribbonToolbar visible true
expect-widget-property ribbonWorkspace visible false
expect-widget-property ribbonPages visible false
wait-log '^Ribbon tab SOLID at '
sleep 300
mark
click-logged '^Ribbon tab SOLID at '
wait-log '^Ribbon tab shown: SOLID$'
wait-log '^Start page hidden$'
wait-log '^Docked toolbar back: workspace block, tab row and groups$'
wait-idle
expect-widget-property ribbonWorkspace visible true
expect-widget-property ribbonPages visible true
expect-dock browserDock shown
expect-dock commandDock shown
# The page again, then Drawing over it.
sleep 300
mark
click-logged '^Ribbon tab START at '
wait-log '^Start page shown$'
wait-log '^Docked toolbar on the Start page: tab row only$'
wait-idle
mark
workspace DRAWING
wait-log '^Workspace DRAWING: opened D1$'
wait-log '^Start page hidden$'
wait-log '^Docked toolbar back: workspace block, tab row and groups$'
wait-log '^Drawing docks hidden: commandDock, projectsDock$'
wait-idle
expect-widget-property ribbonWorkspace visible true
expect-widget-property ribbonPages visible true
expect-dock browserDock shown
expect-dock commandDock hidden
expect-dock projectsDock hidden
expect-dock timelineDock hidden
mark
command drawing.close
wait-log '^Drawing docks shown again: commandDock, projectsDock$'
wait-idle
expect-dock browserDock shown
expect-dock commandDock shown
expect-dock projectsDock shown
expect-dock timelineDock hidden

# 7. The selector locked while sketching.
mark
command sketch.create
expect-log 'Datum xy at ' 10
click-logged '^Datum xy at '
expect-log 'Sketch started on xy' 10
wait-idle
expect-widget-property ribbonWorkspace enabled false
mark
command sketch.finish
wait-log '^Sketch finished'
wait-idle
expect-widget-property ribbonWorkspace enabled true
expect-never 'TestDriver: FAIL'
