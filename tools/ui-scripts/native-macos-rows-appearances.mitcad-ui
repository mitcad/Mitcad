# SPDX-License-Identifier: MIT
# The AppKit frontend's bridged tables (mitcad#1355), on
# tools/ui-scripts/native-rows-appearances.json (a closed table with the
# option size and the parameter columns d and k, rows M3 to M6 with their
# designations):
#   1. Configurations, Rows: a press selects M3's d, Shift+Down and
#      Shift+Right extend the range to M4's k (the Rows sheet's own mouse
#      and key handling), Command+C copies the 2 x 2 block, a press on M5's
#      d and Command+V paste it two rows down, one undo step: M5 and M6
#      take M3's and M4's d and k. A press on M6's designation and Delete
#      empty it. The keys are sent to the dialog window as AppKit key
#      events in this process; the clipboard is the application's own.
#   2. Appearances, searched for Chrome: a press on the Metal heading folds
#      its group and another unfolds it; Up from Chrome reaches the heading,
#      where Space, Return, Left and Right fold and unfold it, as in the
#      Qt frontend (mitcad#1133); Down returns to Chrome.
expect-ever 'Native UI: AppKit shell with embedded OCCT viewport'
wait-idle
expect-model-bodies 1 300

# 1. The Rows sheet's ranges of cells, Copy, Paste and Delete.
command solid.configurations
focus-dialog '^Configurations$'
expect-log 'Configurations window opened'
native-choice configurationsTabs Rows
expect-native-visible configurationsRows true
expect-native-text configurationsRows/2/2 '^5 mm$'
expect-native-text configurationsRows/3/4 '^Screw M6$'
capture-undo-depth before
mark
native-pointer-click configurationsRows/0/2
expect-log '^Native cell selection: configurationsRows current=0,2 selected=0,2$'
key Shift+Down
expect-log '^Native cell selection: configurationsRows current=1,2 selected=0,2 1,2$'
key Shift+Right
expect-log '^Native cell selection: configurationsRows current=1,3 selected=0,2 0,3 1,2 1,3$'
key Ctrl+c
expect-log '^Configurations copied 2 x 2 cells$'
mark
native-pointer-click configurationsRows/2/2
expect-log '^Native cell selection: configurationsRows current=2,2 selected=2,2$'
key Ctrl+v
expect-log '^Configurations pasted 2 x 2 cells at M5 d: added none$'
expect-log '^Configurations rows: closed, .*M5: size = M5, d = 3 mm, k = 3 mm; M6: size = M6, d = 4 mm, k = 4 mm$'
wait-idle
focus-dialog '^Configurations$'
expect-undo-depth ${before} 1
expect-native-text configurationsRows/2/2 '^3 mm$'
expect-native-text configurationsRows/2/3 '^3 mm$'
expect-native-text configurationsRows/3/2 '^4 mm$'
expect-native-text configurationsRows/3/3 '^4 mm$'
expect-native-text configurationsRows/0/2 '^3 mm$'
mark
native-pointer-click configurationsRows/3/4
expect-log '^Native cell selection: configurationsRows current=3,4 selected=3,4$'
key Delete
expect-log '^Configurations cleared 1 cells$'
wait-idle
focus-dialog '^Configurations$'
expect-undo-depth ${before} 2
expect-native-text configurationsRows/3/4 '^$'
expect-native-text configurationsRows/2/4 '^Screw M5$'
screenshot-dialog '${MITCAD_TEST_WORK}/native-rows-sheet.png'
native-pointer-button '^Close$'
expect-native-dialog-gone '^Configurations$'
focus-main

# 2. The Appearances window's group headings.
wait-idle
mark
command solid.appearances
focus-dialog '^Appearances$'
expect-log 'Appearances dialog opened'
native-pointer-click appearanceSearch
key Ctrl+a
type Chrome
sleep 500
wait-idle
expect-native-text appearanceLibrary/1/0 '^Chrome$'
mark
native-pointer-click appearance.group.metal
expect-log '^Native row clicked: appearanceLibrary row=0 '
expect-log '^Appearances group Metal collapsed$'
mark
native-pointer-click appearance.group.metal
expect-log '^Appearances group Metal expanded$'
expect-native-text appearanceLibrary/1/0 '^Chrome$'
native-pointer-click appearanceLibrary/1/0
mark
key Up
expect-log '^Native heading row: appearanceLibrary key=[0-9]+ row=0 '
key Space
expect-log '^Appearances group Metal collapsed$'
mark
key Space
expect-log '^Appearances group Metal expanded$'
mark
key Return
expect-log '^Appearances group Metal collapsed$'
mark
key Right
expect-log '^Appearances group Metal expanded$'
mark
key Left
expect-log '^Appearances group Metal collapsed$'
mark
key Right
expect-log '^Appearances group Metal expanded$'
mark
key Down
expect-log '^Native selected row: appearanceLibrary key=[0-9]+ row=1 '
screenshot-dialog '${MITCAD_TEST_WORK}/native-appearances-headings.png'
native-pointer-button '^Close$'
expect-native-dialog-gone '^Appearances$'
focus-main
