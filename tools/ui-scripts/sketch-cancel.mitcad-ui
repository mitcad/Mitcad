# SPDX-License-Identifier: MIT
# Cancel Sketch, and every sketch edit as one undo step at Finish Sketch
# (mitcad#2225, GitHub mitcad/Mitcad#554; app/COMMANDS.md "Finish
# Sketch"), on sketch-cancel.json (Sketch1 F1 with a rectangle on XY,
# Extrude1 F2 after it, an empty 3D sketch 3DSketch1 F3 last):
#   1. Edit Sketch1 (the timeline marker moves back), a line and a Sketch
#      Dimension on it, Cancel Sketch under the Sketch Palette: back in the
#      model, Sketch1's degrees of freedom as before, the marker at the end
#      and no undo step left. Redo brings the line and the dimension back
#      in one step (Edit Sketch1) as Finish Sketch leaves them: the marker
#      at the end again, Extrude1's body shown (mitcad#2263); Undo takes
#      them back again.
#   2. Create Sketch on XY, a line, Cancel Sketch from the sketch's context
#      menu (below Finish Sketch): no new sketch in the timeline and no
#      undo step left.
#   3. Edit 3DSketch1 (the last feature), a line drawn while the Line tool
#      still runs, Cancel Sketch under the 3D Sketch Palette: no undo step
#      left; Redo brings the line back as Edit 3DSketch1.
#   4. Edit Sketch1 with nothing changed, Cancel Sketch from the SKETCH
#      tab: left as Finish Sketch leaves it.
#   5. Edit 3DSketch1, a line, Finish Sketch: the edit is one undo step,
#      Edit 3DSketch1.
#   6. Edit 3DSketch1 and the Line tool with a pending point: the app
#      quits with the tool running, without a crash (mitcad#2263).
# Run by tools/ui-sketch-cancel-test.sh (Linux) and
# tools/ui-windows-sketch-cancel-test.ps1 (Windows).
expect-ever 'View area'
wait-idle
capture-undo-depth baseline
capture-model-number dofstart '{"query": "timeline"}' features.0.dof

# 1. Edit Sketch1: a line and a dimension, Cancel Sketch under the palette.
mark
dblclick-logged '^Timeline Sketch1 at '
wait-log '^Editing sketch F1 \(Sketch1\)'
key F6
wait-idle
command sketch.line
sketch-click 64 70
sketch-click 76 70
wait-log '^Added line c[0-9]+ from '
key Escape
key Escape
wait-log '^Sketch tool ended: Line'
wait-idle
mark
command sketch.dimension
wait-log '^Sketch tool Sketch Dimension$'
sketch-click 70 70
sketch-click 70 74
wait-log '^Sketch value editor at '
key ctrl+a
type 15
key Return
wait-log '^Added (driven )?dimension k[0-9]+ '
key Escape
wait-idle
capture-model-number dofedit '{"query": "timeline"}' features.0.dof
mark
button '^Cancel Sketch$' paletteCancel
wait-log '^Sketch cancelled: Sketch1, [1-9][0-9]* step\(s\) taken back$' 30
expect-no-log '^Sketch finished$'
wait-idle
expect-undo-depth ${baseline} 0
capture-model-number marker '{"query": "timeline"}' marker
expect-near ${marker} 3
capture-model-number dofnow '{"query": "timeline"}' features.0.dof
expect-near ${dofnow} ${dofstart}
# Redo: the line and the dimension back, in one step, as Finish Sketch
# leaves them (mitcad#2263): the marker at the end again, Extrude1's body
# shown.
mark
key ctrl+y
wait-log '^Redo: Edit Sketch1$' 30
wait-idle
expect-undo-depth ${baseline} 1
capture-model-number dofnow '{"query": "timeline"}' features.0.dof
expect-near ${dofnow} ${dofedit}
capture-model-number marker '{"query": "timeline"}' marker
expect-near ${marker} 3
capture-model-number bodies '{"query": "document"}' bodies
expect-near ${bodies} 1
mark
key ctrl+z
wait-log '^Undo: Edit Sketch1$' 30
wait-idle
expect-undo-depth ${baseline} 0
capture-model-number marker '{"query": "timeline"}' marker
expect-near ${marker} 3
capture-model-number bodies '{"query": "document"}' bodies
expect-near ${bodies} 1

# 2. Create Sketch on XY, a line, Cancel Sketch from the context menu.
mark
command sketch.create
expect-log '^Create Sketch: select a plane' 10
click-logged '^Browser arrow Root/Origin at '
wait-idle 60
expect-log '^Browser Root/Origin/XY at ' 10
click-logged '^Browser Root/Origin/XY at '
expect-log 'Sketch started on xy' 10
wait-idle
expect-undo-depth ${baseline} 1
key F6
wait-idle
command sketch.line
sketch-click 64 70
sketch-click 76 70
wait-log '^Added line c[0-9]+ from '
key Escape
key Escape
wait-log '^Sketch tool ended: Line'
wait-idle
mark
# A right-click on the line just drawn (a point the view shows: the
# design's fit leaves farther places outside it).
sketch-click 67 70 right
wait-log '^Context menu: .*Finish Sketch [|] Cancel Sketch' 10
popup 'Cancel Sketch'
wait-log '^Sketch cancelled: Sketch[0-9]+, taken back, it was new$' 30
wait-idle
expect-undo-depth ${baseline} 0
# Three features, as before: the new sketch is gone.
capture-model-number marker '{"query": "timeline"}' marker
expect-near ${marker} 3

# 3. Edit 3DSketch1, a line, Cancel Sketch while the Line tool runs.
mark
dblclick-logged '^Timeline 3DSketch1 at '
wait-log '^Editing 3D sketch F3 [(]3DSketch1[)]'
wait-log '^3D sketch frame at '
wait-idle
mark
command sketch.line
wait-log '^3D sketch tool Line: started; on the XY plane'
wait-idle
mark
# The start on the XY plane beside the block, where the view shows it: the
# sketch's origin is outside the view fitted to the block (60..80 mm).
click-view-point 50,70,0
wait-log '^3D sketch Line: pending point 1 at ' 10
wait-idle
mark
click-logged '^3D sketch field dx at '
type 10
wait-log '^3D sketch field dx: 10'
key Tab
wait-log '^3D sketch field focus: dy'
type 0
wait-log '^3D sketch field dy: 0'
key Tab
wait-log '^3D sketch field focus: dz'
type 15
wait-log '^3D sketch field dz: 15'
key Return
wait-log '^3D sketch Line: made c[0-9]+ from p[0-9]+ to p[0-9]+'
wait-idle
mark
button '^Cancel Sketch$' sketch3dCancel
wait-log '^Sketch cancelled: 3DSketch1, [1-9][0-9]* step\(s\) taken back$' 30
wait-idle
expect-undo-depth ${baseline} 0
mark
key ctrl+y
wait-log '^Redo: Edit 3DSketch1$' 30
wait-idle
expect-undo-depth ${baseline} 1
mark
key ctrl+z
wait-log '^Undo: Edit 3DSketch1$' 30
wait-idle
expect-undo-depth ${baseline} 0

# 4. Edit Sketch1, nothing changed, Cancel Sketch from the SKETCH tab.
mark
dblclick-logged '^Timeline Sketch1 at '
wait-log '^Editing sketch F1 \(Sketch1\)'
wait-idle
mark
command sketch.cancel
wait-log '^Sketch finished$' 30
wait-log '^Sketch cancelled: Sketch1, 0 step\(s\) taken back$' 10
wait-idle
expect-undo-depth ${baseline} 0
capture-model-number marker '{"query": "timeline"}' marker
expect-near ${marker} 3

# 5. Edit 3DSketch1, a line, Finish Sketch: one undo step.
mark
dblclick-logged '^Timeline 3DSketch1 at '
wait-log '^Editing 3D sketch F3 [(]3DSketch1[)]'
wait-log '^3D sketch frame at '
wait-idle
mark
command sketch.line
wait-log '^3D sketch tool Line: started; on the XY plane'
wait-idle
mark
click-view-point 50,70,0
wait-log '^3D sketch Line: pending point 1 at ' 10
wait-idle
mark
click-logged '^3D sketch field dx at '
type 10
wait-log '^3D sketch field dx: 10'
key Tab
wait-log '^3D sketch field focus: dy'
type 0
wait-log '^3D sketch field dy: 0'
key Tab
wait-log '^3D sketch field focus: dz'
type 15
wait-log '^3D sketch field dz: 15'
key Return
wait-log '^3D sketch Line: made c[0-9]+ from p[0-9]+ to p[0-9]+'
wait-idle
mark
command sketch.finish
wait-log '^Sketch finished$' 30
wait-idle
expect-undo-depth ${baseline} 1
mark
key ctrl+z
wait-log '^Undo: Edit 3DSketch1$' 30
wait-idle
expect-undo-depth ${baseline} 0

# 6. Edit 3DSketch1, the Line tool with a pending point: the script ends
# and the app quits with the tool running (mitcad#2263; the test checks
# that nothing crashes on the way out).
mark
dblclick-logged '^Timeline 3DSketch1 at '
wait-log '^Editing 3D sketch F3 [(]3DSketch1[)]'
wait-log '^3D sketch frame at '
wait-idle
mark
command sketch.line
wait-log '^3D sketch tool Line: started; on the XY plane'
wait-idle
mark
click-view-point 50,70,0
wait-log '^3D sketch Line: pending point 1 at ' 10
wait-idle
expect-never 'Recompute failed|TestDriver: FAIL'
