[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "mitcad#2016: a Rail (C1, Rail:1 O1, grounded; Body1, Sketch1 F1, Extrude1 F2, 200 x 20 x 5 about its origin) and a Gantry (C2, Gantry:1 O2 at the origin) with a Carriage (C3, Carriage:1 O3 at (0, 40, 10); Body2, Sketch2 F3, Extrude2 F4, 60 x 20 x 5) and a Joiner (C4, Joiner:1 O4 at (0, 0, 10); Body3, Sketch3 F5, Extrude3 F6, 20 x 20 x 5), no joints of the Gantry's own. Joint1 (F7, the root's) is a slider along x from the Joiner's origin to the Rail's (0, 0, 10), where the Joiner already is. The Gantry is placed again 150 along y (Gantry:2 O5). All geometry is synthetic."},
  {"cmd": "create_component", "name": "Rail"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [-100, -10], "width": 200, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Gantry"},
  {"cmd": "create_component", "name": "Carriage", "transform": {"translation": [0, 40, 10]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [-30, -10], "width": 60, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Gantry"},
  {"cmd": "create_component", "name": "Joiner", "transform": {"translation": [0, 0, 10]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F5", "corner": [-10, -10], "width": 20, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F5", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "ground_occurrence", "occurrence": "Rail:1"},
  {"cmd": "add_joint", "kind": "slider", "slide_axis": "x",
    "a": {"occurrence": "Gantry:1/Joiner:1", "geometry": {"point": [0, 0, 0]}},
    "b": {"occurrence": "Rail:1", "geometry": {"point": [0, 0, 10]}}},
  {"expect": {"feature": "Joint1", "status": "ok"}},
  {"cmd": "copy_occurrence", "occurrence": "Gantry:1", "transform": {"translation": [0, 150, 0]}}
]
