[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "The milling panels' Tool (mitcad#2590, GitHub mitcad/Mitcad#748): a 40 x 30 block 10 high (F2.b0), a 12 x 10 rectangle on a second sketch (F3); a router whose tool 1 is a ball end mill, tool 2 a flat end mill and tool 3 an engraving cutter, and a second router with only a ball end mill and a drill. Setup 1 on the first router, the stock 1 mm above the block, with Pocket 1 saved with the ball end mill; Setup 2 on the second router."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 30},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [10, 10], "width": 12, "height": 10},
  {"cmd": "cam_machine_put", "machine": {
    "id": "router",
    "machine": {
      "name": "Bench router",
      "controller": "grbl",
      "travel": {"min": [0, 0, -120], "max": [600, 400, 0]},
      "spindle": {"min_rpm": 8000, "max_rpm": 24000, "spin_up_seconds": 2, "nose_diameter": 50, "nose_length": 80},
      "max_feed": 5000,
      "rapid_feed": 6000,
      "tool_changer": {"kind": "manual"}
    },
    "tools": {"tools": [
      {"number": 1, "name": "6 mm ball end mill", "shape": {"kind": "ball"}, "diameter": 6,
       "flute_length": 18, "length": 25, "cutting": {"spindle_rpm": 18000, "feed": 1200, "plunge_feed": 300}},
      {"number": 2, "name": "6 mm flat end mill", "shape": {"kind": "flat"}, "diameter": 6,
       "flute_length": 18, "length": 25, "cutting": {"spindle_rpm": 18000, "feed": 1200, "plunge_feed": 300}},
      {"number": 3, "name": "Engraver", "shape": {"kind": "engraver", "angle": 90, "tip_diameter": 0}, "diameter": 6,
       "flute_length": 3, "length": 20, "cutting": {"spindle_rpm": 18000, "feed": 600, "plunge_feed": 200}}
    ]}
  }},
  {"cmd": "cam_machine_put", "machine": {
    "id": "balls",
    "machine": {
      "name": "Ball router",
      "controller": "grbl",
      "travel": {"min": [0, 0, -120], "max": [600, 400, 0]},
      "spindle": {"min_rpm": 8000, "max_rpm": 24000, "spin_up_seconds": 2, "nose_diameter": 50, "nose_length": 80},
      "max_feed": 5000,
      "rapid_feed": 6000,
      "tool_changer": {"kind": "manual"}
    },
    "tools": {"tools": [
      {"number": 1, "name": "6 mm ball end mill", "shape": {"kind": "ball"}, "diameter": 6,
       "flute_length": 18, "length": 25, "cutting": {"spindle_rpm": 18000, "feed": 1200, "plunge_feed": 300}},
      {"number": 2, "name": "5 mm drill", "shape": {"kind": "drill", "point_angle": 118}, "diameter": 5,
       "flute_length": 15, "length": 25, "cutting": {"spindle_rpm": 10000, "feed": 400, "plunge_feed": 200}}
    ]}
  }},
  {"cmd": "cam_setup_add", "setup": {"machine": "router", "stock": {"kind": "around_bodies", "top": 1}}},
  {"cmd": "cam_operation_add", "setup": 1, "operation": {"kind": {"type": "pocket"}, "tool": 1,
    "inputs": [{"kind": "region", "sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "depths": {"bottom": "-3 mm"}}},
  {"cmd": "cam_setup_add", "setup": {"machine": "balls", "stock": {"kind": "around_bodies", "top": 1}}}
]
