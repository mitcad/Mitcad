[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "Designs for tools/ui-scripts/sketch-snap-hold.mitcad-ui (mitcad#1645). Sketch1 (F1) on XY: p1 and p2 frame the view's fit at (-40, -30) and (40, 30); p3 at (5, 10) for the paste, p4 at (20, 10) for Move/Copy's Target Point, p5 at (10, -15) for Move/Copy's handle; c6 a circle of radius 3 about p7 at (-20, 0), copied, pasted and copied Point to Point; c8 a circle of radius 3 about p9 at (-20, -15), moved by the handle. Sketch2 (F2) on XZ: p1 and p2 frame its fit; p3 at (-25, 15) and p4 at (-5, 25) for a text's frame, p5 at (15, 18) for a 3-Point Arc's middle click, p6 at (25, -10) for a Center Point Arc's end."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_point", "sketch": "F1", "at": [-40, -30]},
  {"cmd": "sketch.add_point", "sketch": "F1", "at": [40, 30]},
  {"cmd": "sketch.add_point", "sketch": "F1", "at": [5, 10]},
  {"cmd": "sketch.add_point", "sketch": "F1", "at": [20, 10]},
  {"cmd": "sketch.add_point", "sketch": "F1", "at": [10, -15]},
  {"cmd": "sketch.circle", "sketch": "F1", "mode": "center", "center": [-20, 0], "radius": 3},
  {"cmd": "sketch.circle", "sketch": "F1", "mode": "center", "center": [-20, -15], "radius": 3},
  {"expect": {"query": {"query": "sketch", "uid": "F1"}, "result": {"entities": [
    {"id": "p1"}, {"id": "p2"}, {"id": "p3"}, {"id": "p4"}, {"id": "p5"},
    {"id": "p7", "at": [-20, 0]}, {"id": "c6", "type": "circle"},
    {"id": "p9", "at": [-20, -15]}, {"id": "c8", "type": "circle"}
  ]}}},
  {"cmd": "sketch.create", "plane": "xz"},
  {"cmd": "sketch.add_point", "sketch": "F2", "at": [-40, -30]},
  {"cmd": "sketch.add_point", "sketch": "F2", "at": [40, 30]},
  {"cmd": "sketch.add_point", "sketch": "F2", "at": [-25, 15]},
  {"cmd": "sketch.add_point", "sketch": "F2", "at": [-5, 25]},
  {"cmd": "sketch.add_point", "sketch": "F2", "at": [15, 18]},
  {"cmd": "sketch.add_point", "sketch": "F2", "at": [25, -10]},
  {"expect": {"query": {"query": "sketch", "uid": "F2"}, "result": {"entities": [
    {"id": "p1"}, {"id": "p2"}, {"id": "p3"}, {"id": "p4"}, {"id": "p5"}, {"id": "p6"}
  ]}}}
]
