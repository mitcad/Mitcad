# SPDX-License-Identifier: MIT
# Continuity Analysis (mitcad#2521), the shared input script of
# tools/ui-continuity-analysis-test.sh (Linux),
# tools/ui-windows-continuity-analysis-test.ps1 (Windows) and
# tools/ui-macos-continuity-analysis-test.sh (macOS), on
# continuity-analysis.json saved as continuity-part.mitcad in the work
# folder: a 40 x 30 x 20 mm box (Body1) with one upright edge rounded 4 mm
# tangent (Fillet1) and another rounded 4 mm curvature continuous
# (Fillet2). The runners set MITCAD_LOG_PICKS. ASCII only: the Windows
# runner copies it as ASCII.
#   1. Inspect > Continuity Analysis, the tangent rounding's face picked in
#      the view: its two long edges G1 (0 degrees, the curvature across
#      jumping by 1 / 4 mm: 100 %), its two ends on the top and bottom G0
#      (90 degrees); the view draws them in their classes' colours.
#   2. Body1 from the browser: every edge of the box, the curvature
#      continuous rounding's long edges G2, the box's own edges G0.
#   3. Curvature 150 %: the tangent rounding's edges count as G2 too.
#   4. Escape: nothing is kept.
expect-ever 'View area' 600
wait-idle 600
command view.fit
wait-idle
expect-ever '^Browser opened (folded|expanded): ' 30
expect-ever '^Browser Root at ' 30
mark
context-menu-logged '^Browser Root at ' 'Collapse All'
wait-log '^Browser collapsed all$' 10
wait-idle
mark
click-logged '^Browser arrow Root/Bodies at '
wait-log '^Browser Root/Bodies/Body1 at ' 30
wait-idle

# --- 1. The tangent rounding's face: its four edges.
mark
command inspect.continuity_analysis
wait-log '^Command Continuity Analysis started' 20
wait-log '^Pick places:' 30
click-pick 'face F2[.]b0/F3:[^ ]* at '
wait-log '^Continuity Analysis Edges: 1 face' 20
wait-log '^Inspect Continuity Analysis: 4 edges: g2 0, g1 2, g0 2, none 0, unmeasured 0; worst gap 0[.]000[0-9] mm, angle (89[.]99[0-9]|90[.]00[0-9]) deg, curvature (99[.]9|100[.]0) %$' 60
wait-log '^Preview colored edges: ContinuityG1 2, ContinuityG0 2$' 30
wait-idle 60
screenshot-view '${MITCAD_TEST_WORK}/continuity-face.png'

# --- 2. Body1 from the browser: every edge of it.
mark
click-logged '^Browser Root/Bodies/Body1 at '
wait-log '^Inspect Continuity Analysis: [1-9][0-9]* edges: g2 [1-9][0-9]*, g1 2, g0 [1-9][0-9]*, none 0, unmeasured 0; worst gap 0[.]000[0-9] mm, angle (89[.]99[0-9]|90[.]00[0-9]) deg, curvature (99[.]9|100[.]0) %$' 60
wait-log '^Preview colored edges: ContinuityG2 [1-9][0-9]*, ContinuityG1 2, ContinuityG0 [1-9][0-9]*$' 30
wait-idle 60
screenshot-view '${MITCAD_TEST_WORK}/continuity-body.png'

# --- 3. A curvature tolerance above the tangent rounding's jump.
mark
type-in '^Panel Continuity Analysis input curvature at ' '150'
wait-log '^Inspect Continuity Analysis: [1-9][0-9]* edges: g2 [1-9][0-9]*, g1 0, g0 [1-9][0-9]*, none 0, unmeasured 0; ' 60
wait-idle 60

# --- 4. Escape: an inspection keeps nothing.
mark
key Escape
wait-log '^Command Continuity Analysis cancelled$' 20
wait-idle
expect-no-log '^Kept '
expect-never 'Recompute failed|OCCT view event failed|TestDriver: FAIL'
