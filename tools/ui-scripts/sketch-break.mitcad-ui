# SPDX-License-Identifier: MIT
# Break and Split at Point (mitcad#2108) on sketch-break.json's Sketch1
# (two framing points at (-40, -30) and (40, 30); a line from the fixed
# point (-25, 0) to (25, 0); a circle of radius 10 about the fixed origin
# across it at (-10, 0) and (10, 0); an arc about (0, -20) from (6, -20)
# over (0, -14) to (-6, -20) with its radius 6 dimensioned):
#   1. Split at Point on the arc 70 degrees round from its start: two
#      pieces, and the radius dimension stays on the first.
#   2. Break on the line inside the circle: three pieces, each collinear
#      with the one before, the two split points held on the circle.
#   3. The line's free end dragged up to (25, 10): the pieces turn about
#      the fixed start together, so Split at Point then finds the middle
#      piece at (0, 5), where the line now runs.
# The wrapper replaces ENTER_SKETCH with the frontend's ordinary timeline
# activation. The clicks stay within x -30..30 mm, y -25..25 mm: the free
# part of the view after the fit also in session 0's 1024x768 window on
# Windows. Run by tools/ui-sketch-break-test.sh (Linux),
# tools/ui-windows-sketch-break-test.ps1 (Windows) and
# tools/ui-macos-sketch-break-test.sh (macOS).
wait-idle
ENTER_SKETCH
expect-log '^Editing sketch F1 \(Sketch1\)'
key F6
wait-idle

# 1. Split at Point on the arc.
mark
command sketch.split
wait-log '^Sketch tool Split at Point$'
mark
sketch-click 2.052 -14.362
wait-log '^Split c[0-9]+ at \([^)]*\) into c[0-9]+, c[0-9]+$'
wait-log '^Pieces of c[0-9]+ hold: .*radius c[0-9]+'
expect-no-log 'Split at Point: '
wait-idle
key Escape

# 2. Break on the line between the crossings with the circle.
mark
command sketch.break
wait-log '^Sketch tool Break$'
mark
sketch-click 3 0
wait-log '^Broke c[0-9]+ at \([^)]*\) into c[0-9]+, c[0-9]+, c[0-9]+$'
wait-log '^Pieces of c[0-9]+ hold: .*collinear c[0-9]+ c[0-9]+.*collinear c[0-9]+ c[0-9]+'
expect-log '^Pieces of c[0-9]+ hold: .*coincident p[0-9]+ c[0-9]+.*coincident p[0-9]+ c[0-9]+'
expect-no-log 'Break: '
screenshot '${MITCAD_TEST_WORK}/sketch-break.png'
wait-idle
key Escape

# 3. The free end dragged up: the pieces hold together.
mark
sketch-drag 25 0 25 10
wait-log '^Dragged p[0-9]+ to '
wait-idle
mark
command sketch.split
wait-log '^Sketch tool Split at Point$'
mark
sketch-click 0 5
wait-log '^Split c[0-9]+ at \([^)]*\) into c[0-9]+, c[0-9]+$'
expect-no-log 'Split at Point: '
screenshot '${MITCAD_TEST_WORK}/sketch-break-dragged.png'
key Escape

command sketch.finish
wait-log '^Sketch finished'
command file.save
wait-log '^Saved '
expect-never 'Recompute failed|TestDriver: FAIL'
