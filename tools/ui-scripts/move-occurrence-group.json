[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "Move to Component on a rigid group joined to a shaft (mitcad#1847), tools/ui-move-occurrence-group-test.sh: in the root Shaft:1 (O1) with a 60 x 10 x 10 box (F1.b0), Bearing:1 (O2) at (10, 0, 30) and Tube:1 (O3) at (30, 0, 30), each with a 10 x 10 x 10 box (F2.b0, F3.b0); Holder:1 (O4), empty, at (0, 80, 0). RigidGroup1 (F4) holds Bearing:1 and Tube:1; Joint1 (F5) puts Bearing:1's bottom on Shaft:1's top."},
  {"cmd": "create_component", "name": "Shaft"},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [0, 0],
    "length": 60, "width": 10, "height": 10, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Bearing", "transform": {"translation": [10, 0, 30]}},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [0, 0],
    "length": 10, "width": 10, "height": 10, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Tube", "transform": {"translation": [30, 0, 30]}},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [0, 0],
    "length": 10, "width": 10, "height": 10, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Holder", "transform": {"translation": [0, 80, 0]}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "add_rigid_group", "occurrences": ["O2", "O3"]},
  {"cmd": "add_joint", "kind": "rigid", "flip": true,
    "a": {"occurrence": "Bearing:1", "geometry": {"body": "F2.b0", "face": "F2:bottom"}},
    "b": {"occurrence": "Shaft:1", "geometry": {"body": "F1.b0", "face": "F1:top"}}},
  {"expect": {"feature": "F4", "status": "ok"}},
  {"expect": {"feature": "F5", "status": "ok"}}
]
