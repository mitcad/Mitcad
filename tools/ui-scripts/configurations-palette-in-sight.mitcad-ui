# SPDX-License-Identifier: MIT
# Configurations on the default test screen (1000 logical px high) with no
# kept size (mitcad#2036): the window opens at its size hint, the Rules
# palette's every entry in sight, its last one too without scrolling. Run
# by ui-configurations-palette-in-sight-test.sh.
expect-ever 'View area'
wait-idle
mark
command solid.configurations
focus-dialog '^Configurations$'
expect-log 'Configurations window opened'
wait-log '^Configurations window size [0-9]+x[0-9]+ \(for the rows. columns\)'
expect-ever 'Configurations tab Rules at'
mark
dialog-click-logged '^Configurations tab Rules at '
wait-log '^Configurations page Rules'
wait-log '^Rule palette in_table at '
expect-dialog-fits
button '^Close$'
expect-dialog-gone '^Configurations$'
focus-main
