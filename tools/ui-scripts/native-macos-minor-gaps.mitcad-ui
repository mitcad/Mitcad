# SPDX-License-Identifier: MIT
# Minor AppKit gaps (mitcad#1358), run by tools/ui-macos-native-minor-gaps-test.sh
# on its design: Sketch1 (F1), Block (F2, its extrude), Block round (F3, a
# rounding too large for the block, which fails), in the components Pin
# and Cap a sketch and a post each (F4, Pin post F5; F6, Cap post F7) and
# the Center of Mass marker.
#   1. The window's title carries the version, as the Qt window's
#      ("design.mitcad - MitCad <version>", mitcad#1209).
#   2. Timeline search's results: each with its feature's icon, the failed
#      one in the error colour (the Browser's failed tone), the state in the
#      tooltip, as the Qt results (mitcad#1040, mitcad#1104); each with its
#      component's swatch in the timeline band's colour (Pin the palette's
#      first, Cap its second), none for the root's (mitcad#1380).
#   3. The Browser's Delete key removes the Center of Mass marker also in
#      Sketch mode, as the Qt Delete key does (mitcad#1094).
# Input is the TestDriver's in-process native commands; no system input.
expect-ever 'Native UI: AppKit shell with embedded OCCT viewport'
wait-idle 30
native-resize 1280 820
native-appearance light
expect-ever 'Failed features: Block round'
expect-native-history

# 1. The title with the version.
expect-native-text native.window.title '^design[.]mitcad - MitCad [0-9]+[.][0-9]+'

# 2. Timeline search's results.
mark
native-click native.history.search
expect-native-visible native.timelineSearch true
native-type native.timelineSearch 'Block'
wait-log 'Timeline search "Block": 2 matches' 10
expect-native-style native.timelineSearchResult.F2 result-icon
expect-native-style native.timelineSearchResult.F3 result-icon
expect-native-style native.timelineSearchResult.F2 row-plain
expect-native-style native.timelineSearchResult.F3 row-failed
expect-native-tooltip native.timelineSearchResult.F2 '^Block$'
expect-native-tooltip native.timelineSearchResult.F3 '^Block round: Failed'
expect-native-style native.timelineSearchResult.F2 result-swatch,none
expect-native-style native.timelineSearchResult.F3 result-swatch,none
screenshot '${MITCAD_TEST_SHOTS}/native-minor-gaps-search.png'
# The components' swatches: Component0 and Component1 of the role table.
native-type native.timelineSearch 'post'
wait-log 'Timeline search "post": 2 matches' 10
expect-native-style native.timelineSearchResult.F5 result-swatch,e0892a
expect-native-style native.timelineSearchResult.F7 result-swatch,3aa35b
expect-native-style native.timelineSearchResult.F5 result-icon
screenshot '${MITCAD_TEST_SHOTS}/native-minor-gaps-swatches.png'
key Ctrl+w
expect-native-visible native.timelineSearch false

# 3. Delete removes the marker while Sketch1 is edited.
mark
native-activate native.history.F1
wait-log '^Editing sketch F1' 30
native-expand native.modelTree
native-select native.model.center-of-mass
# The pick's round trip through the shared Browser keeps the row selected
# in Sketch mode (it has no view item to select instead).
wait-idle
expect-native-style native.model.center-of-mass row-selected
mark
native-key-event Delete
wait-log '^Deleted the Center of Mass marker' 20
expect-native-visible native.ribbon.sketch.finish true
native-click native.ribbon.sketch.finish
wait-log 'Sketch finished' 30
wait-log '^Center of Mass: none' 20
wait-idle
