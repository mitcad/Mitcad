  {"comment":"A Web from a circle (mitcad#2364; tools/ui-web-circle-test.sh and its Windows and macOS twins): a 100 x 100 x 5 plate (Sketch1 F1, Extrude1 F2, Body1 F2.b0), 50000 mm3. On the plate's top (Plane1 F3, z = 5; Sketch2 F4) a circle of radius 20 about (50, 50) (c1)."},
  {"cmd":"sketch.create"},
  {"cmd":"sketch.add_rectangle","sketch":"F1","corner":[0,0],"width":100,"height":100},
  {"cmd":"add_feature","def":{"type":"extrude","profiles":[{"sketch":"F1","region":"r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],"extent":{"type":"distance","distance":5},"operation":"new_body"}},
  {"expect":{"bodies":1,"body":"F2.b0","volume":50000,"tolerance":1e-9}},
  {"cmd":"add_feature","def":{"type":"construction_plane","definition":{"type":"offset","plane":"xy","distance":5}}},
  {"cmd":"sketch.create","plane":"F3"},
  {"cmd":"sketch.add_circle","sketch":"F4","center":[50,50],"diameter":40},
  {"expect":{"feature":"F4","status":"ok"}}
