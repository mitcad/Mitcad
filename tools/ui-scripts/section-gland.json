    "axis":"y","extent":{"type":"full"},"operation":"cut"}},
  {"cmd":"sketch.create"},
  {"cmd":"sketch.add_rectangle","sketch":"F5","corner":[15,27],"width":16,"height":19},
  {"cmd":"add_feature","def":{"type":"revolve","profiles":[{"sketch":"F5","region":"r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis":"y","extent":{"type":"full"},"operation":"cut"}},
  {"cmd":"add_feature","def":{"type":"thread","faces":[{"body":"F2.b0","face":"F4:side(c2[c1,c3])"}],
    "thread":{"designation":"M45x3","class":"6H"},"modeled":true}},
  {"cmd":"add_feature","def":{"type":"thread","faces":[{"body":"F2.b0","face":"F6:side(c4[c3,c1])"}],
    "thread":{"designation":"M30x2","class":"6g"},"modeled":true}},
