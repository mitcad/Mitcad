# SPDX-License-Identifier: MIT
# The Finnish interface walked (mitcad#1473), MitCad started with
# --language fi and MITCAD_LOG_UNTRANSLATED=1: every menu filled, the
# Browser's context menus on a design with a body and a sketch, then every
# command opened and closed again; in a sketch, the sketch commands.
# tools/ui-language-walk-test.sh reads the "Untranslated:" and "Fallback:"
# lines this logs.
expect-ever '^Language: fi [(]--language[)]$' 30
wait-idle

# The menus.
walk-menus
wait-idle

# A design with a body and a sketch, for the Browser's rows.
model-command '{"cmd":"sketch.create"}'
model-command '{"cmd":"sketch.add_rectangle","sketch":"F1","corner":[30,0],"width":10,"height":10}'
model-command '{"cmd":"add_feature","def":{"type":"box","plane":{"type":"origin","plane":"xy"},"corner":[0,0],"length":20,"width":10,"height":5,"operation":"new_body"}}'
wait-idle
walk-context-menus
wait-idle

# Every command but those that end the design, the window or the app, undo
# its body, or leave it (a folder, a page, a remote).
walk-commands '.' '^(file[.](exit|quit|close|new|new_design|new_project|recover|sync|check_remote|open_remote|remote_browser|update_web_viewer|web_viewer|create_drawing)|edit[.](undo|redo)|window[.]|help[.](open_log_folder|user_guide)|tools[.]web_search|sketch[.]|drawing[.])'
wait-idle

# The sketch commands, in a sketch on the XY plane.
command sketch.create
click-logged 'Datum xy'
wait-log '^Ribbon tab shown: SKETCH' 20
walk-commands '^sketch[.]' '^sketch[.](create|finish|exit)'
wait-idle
command sketch.finish
wait-idle

# A drawing of the design: its commands and the Browser's rows.
command file.create_drawing
wait-log '^Create Drawing dialog opened' 20
focus-dialog '.'
key Return
focus-main
wait-log '^Drawing created: ' 30
wait-idle
walk-context-menus
wait-idle
walk-commands '^drawing[.]' '^drawing[.](close|finish)'
wait-idle
