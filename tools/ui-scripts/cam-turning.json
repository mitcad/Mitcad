[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "CAM turning's UI test (mitcad#1869): a 40 x 30 block 10 high (F2.b0) turned about the design's Z through its middle (a part 40 mm across), and a two-axis lathe on the Fanuc turning dialect with a turning tool (1), a parting blade (2) and a threading insert (3) on its turret."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 30},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "cam_machine_put", "machine": {
    "id": "lathe",
    "machine": {
      "name": "Lathe",
      "controller": "fanuc_turning",
      "travel": {"min": [-5, 0, -300], "max": [150, 0, 200]},
      "spindle": {"min_rpm": 50, "max_rpm": 3000, "nose_diameter": 0, "nose_length": 0},
      "max_feed": 5000,
      "rapid_feed": 20000,
      "lathe": {"turret_stations": 8, "chuck_diameter": 160, "chuck_length": 50}
    },
    "tools": {"tools": [
      {"number": 1, "name": "Turning", "shape": {"kind": "turning", "nose_radius": 0.4},
       "diameter": 20, "flute_length": 3, "length": 30},
      {"number": 2, "name": "Parting", "shape": {"kind": "parting", "width": 3},
       "diameter": 20, "flute_length": 25, "length": 30},
      {"number": 3, "name": "Thread", "shape": {"kind": "threading", "angle": 60},
       "diameter": 16, "flute_length": 2, "length": 30}
    ]}
  }}
]
