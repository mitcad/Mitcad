[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "mitcad#1599: Part:1 (O1, C1). Sketch1 (F1) a 20 x 10 rectangle on XY; Sketch2 (F2) on XZ (its sketch y runs along -Z) with p1 at z 35, p2 at z 20 and the line c5 along X at z 50. Extrude1 (F3) up to p1, Hole1 (F4) 4 mm from the top down to p2, Extrude2 (F5) 10 long from c5."},
  {"cmd": "create_component", "name": "Part"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 20, "height": 10},
  {"cmd": "add_feature", "def": {"type": "sketch", "plane": "xz", "entities": [
    {"id": "p1", "type": "point", "at": [5, -35]},
    {"id": "p2", "type": "point", "at": [5, -20]},
    {"id": "p3", "type": "point", "at": [0, -50]},
    {"id": "p4", "type": "point", "at": [20, -50]},
    {"id": "c5", "type": "line", "start": "p3", "end": "p4"}]}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "to_object", "object": {"type": "point", "point": {"sketch": "F2", "point": "p1"}}},
    "operation": "new_body"}},
  {"expect": {"feature": "Extrude1", "status": "ok", "volume": 7000, "tolerance": 1e-6}},
  {"cmd": "add_feature", "def": {"type": "hole", "diameter": 4, "flat": true,
    "placement": {"type": "face", "body": "F3.b0", "face": "F3:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})",
      "points": [[10, 5, 35]]},
    "extent": {"type": "to_object", "object": {"type": "point", "point": {"sketch": "F2", "point": "p2"}}}}},
  {"expect": {"feature": "Hole1", "status": "ok"}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "start": {"type": "object", "object": {"type": "line", "line": {"sketch": "F2", "curve": "c5"}}},
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"expect": {"feature": "Extrude2", "status": "ok", "volume": 2000, "tolerance": 1e-6}}
]
