[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "A design for tools/ui-scripts/parameters-everywhere.mitcad-ui (mitcad#1582): Sketch1 (F1) with a 40 x 20 rectangle, extruded 20 mm (F2, F2.b0), a user parameter width = 40 mm, and Drawing1 (D1, A3) with the body's top view."},
  {"cmd": "add_parameter", "name": "width", "unit": "mm", "expression": "40 mm"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}], "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"expect": {"feature": "F2", "status": "ok"}},
  {"cmd": "add_drawing", "size": "A3"},
  {"cmd": "add_drawing_view", "drawing": "D1", "type": "base", "direction": "top", "at": [210, 150], "scale": "2:1"}
]
