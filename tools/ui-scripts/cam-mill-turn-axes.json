[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "CAM mill-turn axes' UI test (mitcad#2319): a 40 x 30 block 10 high (F2.b0) turned about the design's Z through its middle, a rectangle on the XZ plane (F3, 15 mm from the spindle axis) to wrap onto the diameter, and a lathe with a C axis, live tools, a Y axis, a B head and a sub-spindle on the Fanuc turning dialect: a turning tool (1), a parting blade (2), a radial 6 mm end mill (8), a 4 mm drill in the B head (9) and a radial 1 mm end mill (10)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 30},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "sketch.create", "plane": "xz"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [18, -6], "width": 4, "height": 2},
  {"cmd": "cam_machine_put", "machine": {
    "id": "mill-turn",
    "machine": {
      "name": "Mill-turn",
      "controller": "fanuc_turning",
      "travel": {"min": [-60, -40, -300], "max": [150, 40, 200]},
      "spindle": {"min_rpm": 50, "max_rpm": 3000, "nose_diameter": 0, "nose_length": 0},
      "max_feed": 5000,
      "rapid_feed": 20000,
      "lathe": {"turret_stations": 12, "chuck_diameter": 160, "chuck_length": 50,
                "axes": {"c": true, "live_tools": true, "y": true, "b": true, "sub_spindle": true}}
    },
    "tools": {"tools": [
      {"number": 1, "name": "Turning", "shape": {"kind": "turning", "nose_radius": 0.4},
       "diameter": 20, "flute_length": 3, "length": 30},
      {"number": 2, "name": "Parting", "shape": {"kind": "parting", "width": 3},
       "diameter": 20, "flute_length": 25, "length": 30},
      {"number": 8, "name": "Flat mill", "shape": {"kind": "flat"}, "diameter": 6, "flute_length": 18,
       "length": 30, "mount": "radial", "cutting": {"spindle_rpm": 2500, "feed": 400, "plunge_feed": 150}},
      {"number": 9, "name": "Head drill", "shape": {"kind": "drill"}, "diameter": 4, "flute_length": 20,
       "length": 30, "mount": "head", "cutting": {"spindle_rpm": 2000, "feed": 200, "plunge_feed": 100}},
      {"number": 10, "name": "Engraver", "shape": {"kind": "flat"}, "diameter": 1, "flute_length": 3,
       "length": 20, "mount": "radial", "cutting": {"spindle_rpm": 3000, "feed": 300, "plunge_feed": 100}}
    ]}
  }}
]
