# SPDX-License-Identifier: MIT
# The workflow test's third script (see workflow.mitcad-ui), the counterpart
# of the end of tools/ui-windows-workflow-test.ps1; the application is started
# with the saved design opened and d3 changed (--open ... --set d3=25):
#   8. Version history (P12d, mitcad#89): Move to a Project makes the
#      design's folder a Local project (New Project with the folder offered;
#      the author typed there, as git's configuration is the test's own,
#      without a user): the design as saved is the first version, the open
#      one the second; Ctrl+S records a third.
#   9. Version History (P12e, Ctrl+Shift+H): the three versions with what
#      each changed, compared; Restore of the second records it as a fourth
#      version and opens it. (Restore is the dialog's button: macOS has no
#      Alt+R mnemonics.) The test checks git's log afterwards.
# The test sets MITCAD_TEST_WORK and starts the application as said above.

expect-ever 'View area'
sleep 1500
expect-ever 'Opened ${MITCAD_TEST_WORK:re}/block\.mitcad'
expect-ever 'Version status: none'

# --- The folder made a project, three versions
mark
command file.move_to_project
expect-log 'Move to a Project dialog: block\.mitcad'
focus-dialog '^Move to a Project$|Move block\.mitcad into a project'
key Return
expect-log 'New Project dialog: folder ${MITCAD_TEST_WORK:re}: designs'
focus-dialog '^Move to a Project$'
type 'macOS Tester'
key Tab
type 'macos@example.invalid'
key Return
focus-main
expect-log 'New Project: created ${MITCAD_TEST_WORK:re}: version ' 20
expect-log 'Version author: macOS Tester <macos@example\.invalid> \(git\)'
expect-log 'Version recorded: block\.mitcad ' 20
expect-log 'Version status: files, main, v2'
expect-log 'Version preview saved: ' 20
expect-files "${MITCAD_THUMBNAIL_DIR}" '*.png' 1
mark
key ctrl+z
key ctrl+s
expect-log 'Version recorded: block\.mitcad ' 20
expect-log 'Version status: files, main, v3'

# --- The three versions compared, the second restored
mark
key ctrl+shift+h
expect-log 'Version History: 3 versions of block\.mitcad: v3 ' 20
expect-log 'Version History changes: v3 d3 25 mm -> 20 mm'
expect-log 'Version History selected v3 \('
expect-log 'Version History compare v3 with v2: '
expect-log 'd3 \(Extrude1 distance\): 25 mm -> 20 mm'
focus-dialog '^Version History - block\.mitcad$'
mark
key Down
expect-log 'Version History selected v2 \('
button '^Restore$'
expect-log 'Restore dialog: v2 \('
focus-dialog '^Restore Version$|^Restore v2 \(.*\) of block\.mitcad\?$'
key Return
focus-main
expect-log 'Version restored: block\.mitcad v2 \(' 20
expect-log 'Opened ${MITCAD_TEST_WORK:re}/block\.mitcad' 20
expect-log 'Version status: files, main, v4'
