# SPDX-License-Identifier: MIT
# The AppKit toolbar's quick-access group (mitcad#1113), run by
# tools/ui-macos-native-quick-access-test.sh on a saved plate, as
# tools/ui-quick-access-test.sh checks the Qt group (mitcad#1090).
wait-idle
expect-ever 'Native UI: AppKit shell with embedded OCCT viewport'
native-resize 1440 900

# The default commands this build has, after the workspace tabs.
expect-ever '^Native quick access: file\.new_design, file\.open, file\.save, (file\.print, )?(file\.design_properties, )?tools\.preferences$'
expect-native-visible native.quickAccess.file.new_design true
expect-native-visible native.quickAccessHairline true
expect-native-visible native.quickAccessMenu true
expect-native-enabled native.quickAccess.file.open true

# Save: disabled for the unchanged saved design, its tooltip saying why;
# enabled once the origin's light bulb changed the display state, which
# Save keeps.
expect-native-enabled native.quickAccess.file.save false
expect-ever '^Native quick access file\.save disabled: Save \(.+\): no unsaved changes$'
mark
native-expand native.modelTree
native-click native.model.eye.origin
expect-log 'Visibility Root/Origin: shown'
expect-native-enabled native.quickAccess.file.save true
wait-log '^Native quick access file\.save enabled: Save \(.+\)$'

# View › Look At checked in the group's menu: a button more, in the menus'
# order before Preferences, kept in the settings.
mark
native-popup native.quickAccessMenu 'View/Look At'
wait-log '^Native quick access menu: File \| Edit \| View \| Tools \| Reset to Default$'
wait-log '^Quick access added view\.look_at$'
wait-log '^Native quick access: file\.new_design, .*file\.save, .*view\.look_at, tools\.preferences$'
expect-native-visible native.quickAccess.view.look_at true
screenshot '${MITCAD_TEST_SHOTS}/quick-access.png'

# Reset to Default: the default set again.
mark
native-popup native.quickAccessMenu 'Reset to Default'
wait-log '^Quick access reset to the default$'
wait-log '^Native quick access: file\.new_design, file\.open, file\.save, (file\.print, )?(file\.design_properties, )?tools\.preferences$'
expect-native-present native.quickAccess.view.look_at false

# A narrow window folds the group into its ⋮ before the name is cut.
mark
native-resize 860 800
wait-log '^Native quick access folded$' 10
expect-native-visible native.quickAccess.file.save false
expect-native-visible native.quickAccessMenu true
mark
native-resize 1440 900
wait-log '^Native quick access unfolded$' 10
expect-native-visible native.quickAccess.file.save true
