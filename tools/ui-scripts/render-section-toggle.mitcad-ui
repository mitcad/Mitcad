# Rendering goes on after the last change, and the worker deleted the
# meshes the render left.
mark
model-command '{"cmd":"set_analysis_visible","name":"Section1","visible":false}'
wait-log '^Render scene \d+ applied in ' 300
mark
wait-log '^Render frame view \d+ \d+x\d+ samples ' 300
expect-ever '^Render worker: render-retired: [1-9]\d* geometries deleted'
expect-never '^Render worker stopped'
expect-never 'TestDriver: FAIL'
