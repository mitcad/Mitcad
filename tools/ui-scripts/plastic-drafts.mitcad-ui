# SPDX-License-Identifier: MIT
# Plastic Feature's fields of mitcad#2511, on plastic-drafts.json (a box
# shelled 6 thick through its top, Body1 F1.b0, 57984 mm3; a plate with a
# wall along its far edge, Body2 F3.b0, 19800 mm3):
#   1. A lip on the box's rim with Follow Tangency and Side Draft checked
#      (Side Draft Angle shown with it) at 3 degrees: 1 wide and 2 high,
#      the wall along the opening going on from the box's straight inner
#      wall, the outer one leaning: 212 w + 4 w^2 over the height for
#      w = 1 - z tan 3 deg, 408.970 mm3 more.
#   2. Lip1 reopened: both checks and the angle loaded; Cancel.
#   3. A boss on the plate at (130, 30, 3), 6 across, 10 high, two ribs 1
#      thick; Rib Draft shows Rib Draft Angle (unchecked again); Add Rib
#      End gives rib 1 a row, Up to the Wall: the first rib (along +Y)
#      reaches the wall at y = 50, the second ends at its length: the post
#      pi 9 10 and the ribs 10 (A(20) + A(6)), A(D) = D - (0.5 sqrt(8.75)
#      + 9 asin(1/6)), 483.022 mm3 more.
#   4. Boss1 reopened: its rib end's row loaded; Cancel; Undo takes both
#      away.
# Run by tools/ui-plastic-drafts-test.sh (Linux),
# tools/ui-windows-plastic-drafts-test.ps1 (Windows) and
# tools/ui-macos-plastic-drafts-test.sh (macOS).
expect-ever 'View area'
wait-idle
command view.fit
wait-idle
expect-model-bodies 2 77784
capture-undo-depth baseline

# 1. A lip following the face beside it, its other side drafted.
mark
command solid.plastic
wait-log '^Command Plastic Feature started' 30
wait-idle 30
qt-choice input_type 'Lip'
wait-idle 30
mark
click-logged '^Panel Plastic Feature input face at '
wait-idle 30
click-pick 'face F1[.]b0/F2:offset_cap[(]F1:top[)] at '
wait-log '^Plastic Feature Face: 1 face' 20
wait-log '^Panel Plastic Feature input tangent at (?!.*[(]hidden[)])' 20
wait-log '^Panel Plastic Feature input side_draft at (?!.*[(]hidden[)])' 20
wait-idle 30
mark
click-logged '^Panel Plastic Feature input tangent at '
wait-idle 30
expect-widget-property input_tangent checked true
mark
click-logged '^Panel Plastic Feature input side_draft at '
wait-idle 30
expect-widget-property input_side_draft checked true
wait-log '^Panel Plastic Feature input side_draft_angle at (?!.*[(]hidden[)])' 20
mark
type-in '^Panel Plastic Feature input side_draft_angle at ' '3 deg'
wait-log '^Preview Plastic Feature: ok' 60
wait-idle 30
mark
button '^OK$'
wait-log '^Added plastic feature [(]Lip[)]' 60
wait-idle 60
capture lip 'Body \S+ [(]F1[.]b0[)]: volume [0-9.]+ -> ([0-9.]+) mm3' 30
expect-near ${lip} 58392.969874 1e-6 0.01
wait-log '^Timeline Lip1 at ' 30

# 2. Reopened: the checks and the angle as they were saved.
mark
dblclick-logged '^Timeline Lip1 at '
wait-log 'Editing F5 with Plastic Feature' 30
wait-log '^Preview Plastic Feature: ok' 60
wait-idle 30
expect-widget-property input_tangent checked true
expect-widget-property input_side_draft checked true
expect-input-text side_draft_angle '^3 deg$'
mark
button '^Cancel$'
wait-idle 60
expect-undo-depth ${baseline} 1

# 3. A boss with a rib up to the wall.
mark
command solid.plastic
wait-log '^Command Plastic Feature started' 30
wait-idle 30
qt-choice input_type 'Boss'
wait-idle 30
mark
click-logged '^Panel Plastic Feature input face at '
wait-idle 30
click-pick 'face F3[.]b0/F3:top at '
wait-log '^Plastic Feature Face: 1 face' 20
wait-idle 30
type-in '^Panel Plastic Feature input x at ' '130 mm'
type-in '^Panel Plastic Feature input y at ' '30 mm'
type-in '^Panel Plastic Feature input z at ' '3 mm'
type-in '^Panel Plastic Feature input diameter at ' '6 mm'
type-in '^Panel Plastic Feature input height at ' '10 mm'
type-in '^Panel Plastic Feature input ribs at ' '2'
type-in '^Panel Plastic Feature input rib_thickness at ' '1 mm'
wait-idle 30
mark
click-logged '^Panel Plastic Feature input rib_draft at '
wait-idle 30
expect-widget-property input_rib_draft checked true
wait-log '^Panel Plastic Feature input rib_draft_angle at (?!.*[(]hidden[)])' 20
mark
click-logged '^Panel Plastic Feature input rib_draft at '
wait-idle 30
expect-widget-property input_rib_draft checked false
mark
click-logged '^Panel Plastic Feature add rib_ends at '
wait-log '^Plastic Feature: added rib_ends row 1$' 20
wait-log '^Panel Plastic Feature input rib_ends[.]0[.]short at (?!.*[(]hidden[)])' 20
wait-log '^Preview Plastic Feature: ok' 60
wait-idle 30
mark
button '^OK$'
wait-log '^Added plastic feature [(]Boss[)]' 60
wait-idle 60
capture boss 'Body \S+ [(]F3[.]b0[)]: volume [0-9.]+ -> ([0-9.]+) mm3' 30
expect-near ${boss} 20283.022286 1e-6 0.01
wait-log '^Timeline Boss1 at ' 30

# 4. Reopened: the rib end's row back; then Undo takes both away.
mark
dblclick-logged '^Timeline Boss1 at '
wait-log 'Editing F6 with Plastic Feature' 30
wait-log '^Preview Plastic Feature: ok' 60
wait-log '^Panel Plastic Feature input rib_ends[.]0[.]short at (?!.*[(]hidden[)])' 20
wait-idle 30
mark
button '^Cancel$'
wait-idle 60
expect-undo-depth ${baseline} 2
mark
command edit.undo
wait-idle 60
command edit.undo
wait-idle 60
expect-model-bodies 2 77784
expect-undo-depth ${baseline} 0
expect-never 'Failed features: [^n]|Recompute failed|TestDriver: FAIL'
