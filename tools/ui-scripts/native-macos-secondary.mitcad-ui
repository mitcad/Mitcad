# SPDX-License-Identifier: MIT
# Native secondary UI regression: editable parameter sheets, modeless
# Project Settings, constrained item views and nested report preview. Starts
# with an empty document and never confirms Send or opens an external issue tracker.
expect-ever 'Native UI: AppKit shell with embedded OCCT viewport'
sleep 800

# Native icon choices use the shared BUILD direction artwork. More was
# removed from BUILD; its generic disclosure contract is tested separately.
expect-native-form-controls
expect-log 'Command Native form controls regression started'
expect-native-disclosure-layout
native-click input_more
expect-native-disclosure-layout
expect-native-layout
native-resize 900 640
expect-native-disclosure-layout
expect-native-layout
screenshot '${MITCAD_TEST_WORK}/native-macos-disclosure.png'
native-click input_more
expect-native-disclosure-layout
native-resize 1280 820
mark
native-click commandCancel
expect-log 'Command Native form controls regression cancelled'
mark
command build.profile
expect-log 'Command Profile started'
expect-native-visible input_axis_x true
expect-native-visible input_axis_y true
expect-native-visible input_axis_z true
native-click input_axis_x
expect-log 'Profile: Direction = Along X'
native-click input_axis_y
expect-log 'Profile: Direction = Along Y'
native-click input_axis_z
expect-log 'Profile: Direction = Along Z'
expect-native-layout
screenshot '${MITCAD_TEST_WORK}/native-macos-build-icons.png'
native-resize 900 640
expect-native-layout
native-resize 1280 820
native-click commandCancel
expect-log 'Command Profile cancelled'

# The upstream Local project flow must work through the native form. All
# folders and identities belong to the test; no remote is contacted.
mark
native-action file.new_project
focus-dialog '^New Project$'
native-type projectFolder '${MITCAD_TEST_WORK}/CancelledProject'
native-type projectDisplayName 'Must not be kept'
native-type projectAuthorName 'Cancelled Author'
native-type projectAuthorEmail 'cancelled@example.invalid'
native-choice projectLiveHere 'Another broker'
native-type projectHereBroker 'mqtts://cancelled.example.invalid'
button '^Cancel$'
expect-native-dialog-gone '^New Project$'
focus-main
native-action file.new_project
focus-dialog '^New Project$'
native-type projectFolder '${MITCAD_TEST_WORK}/NativeProject'
native-type projectAuthorName 'Native Project Tester'
native-type projectAuthorEmail 'native-project@example.invalid'
native-type projectDisplayName 'Native Workshop'
native-click projectSendAtOnce
native-choice projectCheckMinutes 'every 30 minutes'
native-choice projectLiveHere 'Off'
button '^Create$'
expect-log 'New Project: created ${MITCAD_TEST_WORK:re}/NativeProject: version ' 30
expect-native-dialog-gone '^New Project$'
focus-main
# An empty project (mitcad#145): no design named after the folder.
expect-log 'Open Project: no designs in ${MITCAD_TEST_WORK:re}/NativeProject' 20
expect-file '${MITCAD_TEST_WORK}/NativeProject/.mitcad/project.json'

# Closing immediately after a native user edit must keep the author. Close
# intentionally skips editingFinished; reopening reads git's actual config.
mark
native-action file.project_settings
focus-dialog '^Project Settings - NativeProject$'
expect-native-text projectDisplayName '^Native Workshop$'
expect-native-text projectCheckMinutes '^every 30 minutes$'
expect-native-text projectLiveHere '^Off$'
expect-native-text projectAuthorName '^Native Project Tester$'
expect-native-text projectAuthorEmail '^native-project@example\.invalid$'
# Its width still holds the whole placeholder in AppKit's font (mitcad#953).
expect-native-bounds projectAuthorEmail placeholder '^Author:$'
native-type projectAuthorName 'Native Project Edited'
button '^Close$'
expect-log 'Project Settings: author Native Project Edited <native-project@example\.invalid>'
expect-native-dialog-gone '^Project Settings - NativeProject$'
focus-main
native-action file.project_settings
focus-dialog '^Project Settings - NativeProject$'
expect-native-text projectAuthorName '^Native Project Edited$'
native-type projectAuthorEmail 'native-edited@example.invalid'
button '^Close$'
expect-log 'Project Settings: author Native Project Edited <native-edited@example\.invalid>'
expect-native-dialog-gone '^Project Settings - NativeProject$'
focus-main
native-action file.project_settings
focus-dialog '^Project Settings - NativeProject$'
expect-native-text projectAuthorName '^Native Project Edited$'
expect-native-text projectAuthorEmail '^native-edited@example\.invalid$'
button '^Close$'
expect-native-dialog-gone '^Project Settings - NativeProject$'
focus-main

# Cloud settings are configured before creation, then read back through the
# same form. The repository is a local test fixture and brokers stay off here.
mark
native-action file.new_project
focus-dialog '^New Project$'
native-type projectFolder '${MITCAD_TEST_WORK}/NativeCloudProject'
native-click projectStorageCloud
native-type cloudAddress '${MITCAD_TEST_WORK}/native-cloud.git'
native-type projectAuthorName 'Native Cloud Tester'
native-type projectAuthorEmail 'cloud-project@example.invalid'
native-type projectDisplayName 'Cloud Workshop'
native-type projectLockIdle '25'
native-type projectLockPoll '40'
native-click projectLiveBroker
native-type projectBroker 'mqtts://shared.example.invalid:8883'
native-type projectBrokerPrefix 'team'
native-choice projectLiveHere 'Off'
native-choice projectCheckMinutes 'every hour'
expect-log 'Reachable and empty: ready.' 30
button '^Create$'
expect-log 'New Project: created ${MITCAD_TEST_WORK:re}/NativeCloudProject: version ' 30
expect-native-dialog-gone '^New Project$'
focus-main
native-action file.project_settings
focus-dialog '^Project Settings - NativeCloudProject$'
expect-native-text projectDisplayName '^Cloud Workshop$'
expect-native-text projectLockIdle '^25'
expect-native-text projectLockPoll '^40'
expect-native-text projectBroker '^mqtts://shared\.example\.invalid:8883$'
expect-native-text projectBrokerPrefix '^team$'
expect-native-text projectLiveHere '^Off$'
expect-native-text projectCheckMinutes '^every hour$'
button '^Close$'
expect-native-dialog-gone '^Project Settings - NativeCloudProject$'
focus-main

# Add a parameter through a native child sheet; accepting it must keep the
# outer Parameters sheet open and update the shared document model.
mark
native-action solid.parameters
expect-log 'Parameters dialog opened'
focus-dialog '^Parameters$'
native-click parametersAdd
expect-log 'Add User Parameter dialog opened'
focus-dialog '^Add User Parameter$'
type 'nativeWidth'
key Tab
key Ctrl+a
type 'mm'
key Tab
type '30'
button '^OK$'
expect-log 'Added parameter nativeWidth = 30 mm' 30
focus-dialog '^Parameters$'
button '^OK$'
focus-main

# These real presenters cap an item view at 110 points, below the native
# default minimum: the faces list in Appearances and the known-brokers tree
# on the Cloud (RemotePreferences) page must lay out without warnings.
mark
native-action solid.appearances
expect-log 'Appearances dialog opened'
focus-dialog '^Appearances$'
screenshot '${MITCAD_TEST_WORK}/native-appearances.png'
expect-file '${MITCAD_TEST_WORK}/native-appearances.png'
button '^Close$'
expect-native-dialog-gone '^Appearances$'
focus-main
native-action tools.search
native-type native.commandSearch 'Preferences: Cloud'
key Return
focus-dialog '^Settings$'
screenshot '${MITCAD_TEST_WORK}/native-cloud-settings.png'
expect-file '${MITCAD_TEST_WORK}/native-cloud-settings.png'
key Ctrl+w
expect-native-dialog-gone '^Settings$'
focus-main

# Settings is a real native modeless window. Search-only settings pages
# remain available through command search without appearing in CAD menus.
# Cache Diagnostics exercises a nested dialog with table models and tabs.
native-action tools.search
native-type native.commandSearch 'Preferences: Cache'
key Return
focus-dialog '^Settings$'
# The Cache page's button, not the Diagnostics section of the selector.
button '^Diagnostics…$'
focus-dialog '^Diagnostics$'
button '^Close$'
focus-dialog '^Settings$'
key Ctrl+w
expect-native-dialog-gone '^Settings$'
focus-main

# Preview remains local. Native field editing and the section checkbox must
# drive the same presenter data; cancelling both sheets sends nothing.
mark
native-action help.send_feedback
expect-log 'Send Feedback: the form shows'
focus-dialog '^Send Feedback$'
button '^Preview.*$'
focus-dialog '^Review Report$'
expect-native-text reportTitle '^Bug: Feedback$'
native-type reportTitle 'Native secondary UI regression'
expect-native-text reportTitle '^Native secondary UI regression$'
native-click reportSection_diagnostics
expect-log 'Report section diagnostics left out'
screenshot '${MITCAD_TEST_WORK}/native-secondary.png'
expect-file '${MITCAD_TEST_WORK}/native-secondary.png'
# Real pointer presses on the wide section checkbox aim at its box, not at
# the inert middle of its stretched frame; the shared presenter's log and
# the Qt group box record every transition (mitcad#987).
mark
native-pointer-click reportSection_diagnostics
expect-log 'Report section diagnostics included'
expect-log 'Native pointer active cell: reportSection_diagnostics point=\{[^}]*\} default'
expect-widget-property reportSection_diagnostics checked true
mark
native-pointer-click reportSection_diagnostics
expect-log 'Report section diagnostics left out'
expect-widget-property reportSection_diagnostics checked false
mark
native-pointer-button '^Diagnostics$'
expect-log 'Report section diagnostics included'
expect-widget-property reportSection_diagnostics checked true
# Explicit fractions inside the box remain a valid press.
mark
native-pointer-click reportSection_diagnostics 0.02 0.5
expect-log 'Report section diagnostics left out'
expect-widget-property reportSection_diagnostics checked false
# A push button keeps the centre of its frame.
mark
native-pointer-button '^Cancel$'
expect-log 'Report not sent: the preview was cancelled'
focus-dialog '^Send Feedback$'
button '^Cancel$'
expect-log 'Send Feedback cancelled'
focus-main
expect-never 'Report sent:|Report on the clipboard:|TestDriver: FAIL|Native Mac canvas:|OCCT view event failed'
