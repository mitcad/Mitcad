[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "mitcad#1793: a Hinge (C1; its plate Body1, Sketch1 F1, Extrude1 F2, 40 x 40 x 5 about its origin) with an Arm (C2, Arm:1 O2; Body2, Sketch2 F3, Extrude2 F4, 60 x 10 x 5 from its origin) turning on a pin at the Hinge's (0, 0, 10) (Joint1 F5, revolute, the Hinge's own), placed twice in the root: Hinge:1 (O1) at the origin and Hinge:2 (O3) 120 along x, both grounded. All geometry is synthetic."},
  {"cmd": "create_component", "name": "Hinge"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [-20, -20], "width": 40, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "create_component", "name": "Arm", "transform": {"translation": [0, 0, 10]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [-5, -5], "width": 60, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Hinge"},
  {"cmd": "add_joint", "kind": "revolute",
    "a": {"occurrence": "Arm:1", "geometry": {"point": [0, 0, 0]}},
    "b": {"geometry": {"point": [0, 0, 10]}}},
  {"expect": {"feature": "Joint1", "status": "ok"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "copy_occurrence", "occurrence": "Hinge:1", "transform": {"translation": [120, 0, 0]}},
  {"cmd": "ground_occurrence", "occurrence": "Hinge:1"},
  {"cmd": "ground_occurrence", "occurrence": "Hinge:2"}
