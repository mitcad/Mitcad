# SPDX-License-Identifier: MIT
# The 3D sketch manipulator's keys and Copy and Paste between 3D sketches
# (mitcad#1661, app/COMMANDS.md "3D sketches" and "3D sketch drawing
# tools"), on sketch3d-keys-clipboard.json (3DSketch1 F1 and 3DSketch2 F2,
# empty, on XY):
#   1. Edit 3DSketch1, Line: the plane and placement controls' tooltips name
#      the keys; the start clicked on the origin; with the view's keyboard
#      Tab cycles the plane to YZ and ZX, Shift+Tab back, Up Arrow switches
#      to Normal and back, each logged with its key.
#   2. In the fields Tab moves from field to field and changes no plane;
#      the end typed 10, 0, 15 from the start: the route rises to z 15.
#   3. Finish; Edit 3DSketch1 again, the line selected and copied with its
#      attachment to the origin and its offsets.
#   4. Edit 3DSketch2: Paste puts the line where it was, z 15 kept, its
#      relations and dimensions with it, fully constrained; the pasted
#      geometry selected; one undo step. Finish.
# Run by tools/ui-sketch3d-keys-clipboard-test.sh (Linux) and
# tools/ui-windows-sketch3d-keys-clipboard-test.ps1 (Windows).
expect-ever 'View area'
wait-idle

# 1. The keys while the Line tool draws.
mark
dblclick-logged '^Timeline 3DSketch1 at '
wait-log '^Editing 3D sketch F1 [(]3DSketch1[)]'
wait-log '^3D sketch frame at '
wait-idle
mark
command sketch.line
wait-log '^3D sketch tool Line: started; on the XY plane'
wait-log '^3D sketch control keys: planes Tab: the next plane, Shift[+]Tab: the previous plane; normal Up: On Plane or Normal$'
wait-idle
mark
click-logged '^3D sketch frame at '
wait-log '^3D sketch Line: pending point 1 at [(]0[.]000, 0[.]000, 0[.]000[)] [(]Origin[)]'
wait-idle
mark
key Tab
wait-log '^3D placement plane: YZ [(]Tab[)]$'
key Tab
wait-log '^3D placement plane: ZX [(]Tab[)]$'
key shift+tab
wait-log '^3D placement plane: YZ [(]Shift[+]Tab[)]$'
mark
key Up
wait-log '^3D placement: Normal [(]Up[)]$'
key Up
wait-log '^3D placement: On Plane [(]Up[)]$'
key Up
wait-log '^3D placement: Normal [(]Up[)]$'
# Back to On Plane, where the offsets' fields show (Normal shows none).
key Up
wait-log '^3D placement: On Plane [(]Up[)]$'
wait-idle

# 2. A field keeps Tab; the end typed rises to z 15. Back On Plane the
# fields are where the tool's start logged them.
mark
click-logged '^3D sketch field dx at '
type 10
wait-log '^3D sketch field dx: 10'
key Tab
wait-log '^3D sketch field focus: dy'
type 0
wait-log '^3D sketch field dy: 0'
key Tab
wait-log '^3D sketch field focus: dz'
type 15
wait-log '^3D sketch field dz: 15'
expect-no-log '^3D placement plane: '
mark
key Return
wait-log '^3D sketch Line: made c3 from p1 to p2'
wait-log '^3D sketch anchor at p2 [(]10[.]000, 0[.]000, 15[.]000[)]'
wait-idle
mark
command sketch.finish
wait-log '^Sketch finished'
wait-idle

# 3. The line copied with its attachment to the origin and its offsets.
mark
dblclick-logged '^Timeline 3DSketch1 at '
wait-log '^Editing 3D sketch F1 [(]3DSketch1[)]'
wait-log '^3D sketch entity F1/c3 at '
wait-idle
mark
click-logged '^3D sketch entity F1/c3 at '
wait-log '\[sketch curve c3 of F1\]'
mark
command sketch.copy
wait-log '^3D sketch copied c3 from 3DSketch1: [1-9][0-9]* relation[(]s[)] and dimension[(]s[)] kept, 0 left out, 1 linked reference[(]s[)], base point at [(]0[.]000, 0[.]000, 0[.]000[)]$'
mark
command sketch.finish
wait-log '^Sketch finished'
wait-idle

# 4. Pasted into 3DSketch2 where it was: z kept, its relations with it.
mark
dblclick-logged '^Timeline 3DSketch2 at '
wait-log '^Editing 3D sketch F2 [(]3DSketch2[)]'
wait-idle
mark
command sketch.paste
wait-log '^3D sketch Paste: 3D sketch geometry of 3DSketch1 from .*, base point at [(]0[.]000, 0[.]000, 0[.]000[)], where it was$'
wait-log '^3D sketch Pasted p1, p2, c3 into 3DSketch2: [1-9][0-9]* relation[(]s[)] and dimension[(]s[)] kept, 0 left out, 0 linked reference[(]s[)] left out$'
wait-log '^3D sketch F2 [(]3DSketch2[)]: 2 points, 1 curves, dof 0'
wait-log 'Point p2 at 10[.]00, 0[.]00, 15[.]00 mm'
wait-idle
expect-no-log '^3D sketch Paste refused'
mark
command edit.undo
wait-log 'Undo: Paste in 3DSketch2'
wait-idle
mark
command sketch.finish
wait-log '^Sketch finished'
wait-idle
