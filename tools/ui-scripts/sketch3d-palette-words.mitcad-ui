# SPDX-License-Identifier: MIT
# The 3D Sketch Palette's rows in words (mitcad#1652, app/COMMANDS.md "3D
# sketches"), on sketch3d-palette-words.json (Box1 F1.b0; 3DSketch1 F2 on
# its top face with one reference curve, the box's upright edge
# E{F1:side0|F1:side1} included in 3D):
#   1. Edit 3DSketch1: the Linked references row reads "Reference curve 1
#      (an edge of Box1); included in 3D"; the log gives the agents' text
#      with the ids before "| shown:", and no shown text has an id, a
#      topological name or a coordinate.
#   2. The pointer over the row's words paints the reference curve and the
#      edge it follows (the notice hover's places, 2 drawn).
#   3. The pointer leaving the row clears them; Finish Sketch.
# Run by tools/ui-sketch3d-palette-words-test.sh (Linux) and
# tools/ui-windows-sketch3d-palette-words-test.ps1 (Windows).
expect-ever 'View area'
wait-idle

# 1. The row in words, the ids only in the log's agents' part.
mark
dblclick-logged '^Timeline 3DSketch1 at '
wait-log '^Editing 3D sketch F2 [(]3DSketch1[)]'
wait-log '^3D sketch reference c[0-9]+: edge E[{]F1:side0[|]F1:side1[}] of F1[.]b0; body F1[.]b0; included in 3D [|] shown: Reference curve 1 [(]an edge of Box1[)]; included in 3D$'
capture REF '^3D sketch reference (c[0-9]+): edge '
wait-log '^3D sketch edit control coincident at '
wait-idle
expect-no-log '[|] shown: .*([pck][0-9]+([^0-9]|$)|[EV][{]|F[0-9]+[.:]|[0-9][.][0-9]+, -?[0-9])'

# 2. The pointer over the row's words: the reference curve and its edge
# painted. The card is wheeled to its end first, where the row is in sight
# also on a short screen.
wheel-logged '^3D sketch edit control coincident at ' -10
wait-idle
mark
hover-logged '^3D sketch reference ${REF} text at '
wait-log '^3D sketch palette hover: ${REF}: sketch_curve ${REF} of F2, edge E[{]F1:side0[|]F1:side1[}] of F1[.]b0$'
wait-log '^Notice hover highlighted: 3D Sketch Palette: sketch_curve ${REF} of F2, edge E[{]F1:side0[|]F1:side1[}] of F1[.]b0 [(]2 drawn[)]$'

# 3. The pointer leaves the row: nothing painted.
mark
leave-widget 'sketch3dRow ${REF}'
wait-log '^3D sketch palette hover: none$'
wait-log '^Notice hover highlighted: none$'
wait-idle
mark
command sketch.finish
wait-log '^Sketch finished'
wait-idle
