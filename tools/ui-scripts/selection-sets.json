[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "A design for tools/ui-scripts/selection-sets.mitcad-ui (mitcad#2192): Sketch1 (F1) on XY with a 30 x 20 rectangle, used by Extrude1 (F2, 10 up, Body1), and the 10 mm box Block (F3, its body F3.b0)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 30, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "box", "plane": {"type": "origin", "plane": "xy"},
    "corner": [40, 0], "length": 10, "width": 10, "height": 10, "operation": "new_body"}},
  {"cmd": "rename_body", "uid": "F3.b0", "name": "Block"},
  {"expect": {"feature": "F2", "status": "ok"}},
  {"expect": {"feature": "F3", "status": "ok"}},
  {"expect": {"query": {"query": "selection_sets"}, "result": []}}
]
