# SPDX-License-Identifier: MIT
# mitcad#1643, mitcad#1800: Send to Slicer's Filament changes on
# filament-changes.json: a red 40 mm box (F2.b0) and Plane1 (F3) 15 mm
# above XY beside it. The panel has no Change At row: Filament Change
# places each event by a height above the bed or by a plane or face picked
# into its own field (At: Distance from Bed or To Object).
#   1. Add change: Filament Change opens on a new change 10 mm up to the
#      blue, at a height; 12 typed and OK set it (one undo step), the row
#      shows it and the view draws the box red below and blue above with
#      the ring.
#   2. Add change, To Object, a click on Plane1: the field takes the pick
#      and shows the height it gives; OK adds the change at the plane.
#   3. Add pause, To Object, a click on the box's top: a pause at the face.
#   4. Edit of each: the height opens with Distance from Bed (14 typed and
#      OK move it), the plane's and the face's with To Object and their
#      picks (Cancel).
#   5. The pointer over the plane's row paints it; Remove takes the plane's
#      and then the face's away.
#   6. Closing the panel restores the normal look; Undo takes the last
#      Remove back (the panel shows the face's row again), Redo does it
#      again.
#   7. Filament Change Here… on Plane1's context menu opens Send to Slicer
#      and Filament Change with the plane picked; OK adds it.
#   8. Filament Change Here… on the box's top, a face of a body on Plate 1,
#      opens Plates… on Plate 1 and Filament Change with the face picked;
#      OK gives the plate a schedule of its own: the design's events and
#      the change at the face. The design saved keeps both schedules and
#      the references.
# Run by tools/ui-filament-changes-test.sh (Linux) and
# tools/ui-windows-filament-changes-test.ps1 (Windows).
wait-idle
command view.fit
wait-log '^Datum F3 at ' 30

# 1. A change at a typed height.
mark
command make.print3d
expect-log '^Command Send to Slicer started'
wait-log '^Panel Send to Slicer note filament_changes: None \[Add change\] \[Add pause\]' 30
wait-log '^Panel Send to Slicer action filament_changes[.]0 at ' 30
# No Change At row: its input has no place in the panel.
expect-no-log '^Panel Send to Slicer input change_at at [0-9-]+,[0-9-]+$'
click-logged '^Panel Send to Slicer action filament_changes[.]0 at '
focus-dialog '^Filament Change$' 30
wait-log '^Filament change dialog: new, height 10 mm, change to PLA Two \(Blue\)$' 10
type 12
button '^OK$'
focus-main
wait-log '^Send to Slicer filament changes: 12 mm: Change to PLA Two \(Blue\)$' 30
wait-log '^Panel Send to Slicer note change_1: Change to PLA Two \(Blue\) \[Edit\] \[Remove\]$' 30
wait-log '^Filament change overlay: [0-9]+ triangle\(s\) in #0000FF, #FF0000; [0-9]+ ring segment\(s\)$' 30
expect-no-log '^Filament changes refused'

# 2. A change at a plane picked in Filament Change's own field.
mark
click-logged '^Panel Send to Slicer action filament_changes[.]0 at '
focus-dialog '^Filament Change$' 30
wait-log '^Filament change dialog: new, height 22 mm, change to PLA Two \(Blue\)$' 10
qt-choice filamentChangeExtent 'To Object'
wait-log '^Filament change dialog extent: to object$' 10
wait-log '^Filament change dialog picks: on$' 10
focus-main
wait-idle
click-logged '^Datum F3 at '
wait-log '^Filament change dialog at: Plane1: 15 mm above the bed$' 30
focus-dialog '^Filament Change$' 10
button '^OK$'
focus-main
wait-log '^Filament change dialog picks: off$' 30
wait-log '^Send to Slicer filament changes: 12 mm: Change to PLA Two \(Blue\) [|] Plane1 \(15 mm\): Change to PLA Two \(Blue\)$' 30
wait-log '^Panel Send to Slicer note change_2: Change to PLA Two \(Blue\) \[Edit\] \[Remove\]$' 30
expect-no-log '^Filament changes refused'

# 3. A pause at a face picked in the field: the box's top.
mark
click-logged '^Panel Send to Slicer action filament_changes[.]1 at '
focus-dialog '^Filament Change$' 30
wait-log '^Filament change dialog: new, height 25 mm, change to Pause$' 10
qt-choice filamentChangeExtent 'To Object'
wait-log '^Filament change dialog picks: on$' 10
focus-main
wait-idle
wait-log '^Pick face F2[.]b0/F2:end' 30
click-logged '^Pick face F2[.]b0/F2:end'
wait-log '^Filament change dialog at: A face of Body1: 40 mm above the bed$' 30
focus-dialog '^Filament Change$' 10
button '^OK$'
focus-main
wait-log '^Send to Slicer filament changes: 12 mm: Change to PLA Two \(Blue\) [|] Plane1 \(15 mm\): Change to PLA Two \(Blue\) [|] A face of Body1 \(40 mm\): Pause$' 30
wait-log '^Panel Send to Slicer note change_3: Pause \[Edit\] \[Remove\]$' 30
expect-no-log '^Filament changes refused'

# 4. Edit opens each in the way it was placed.
mark
click-logged '^Panel Send to Slicer action change_1[.]0 at '
focus-dialog '^Filament Change$' 30
wait-log '^Filament change dialog: row 1, height 12 mm, change to PLA Two \(Blue\)$' 10
type 14
button '^OK$'
focus-main
wait-log '^Send to Slicer filament changes: 14 mm: Change to PLA Two \(Blue\) [|] Plane1 \(15 mm\): Change to PLA Two \(Blue\) [|] A face of Body1 \(40 mm\): Pause$' 30
mark
click-logged '^Panel Send to Slicer action change_2[.]0 at '
focus-dialog '^Filament Change$' 30
wait-log '^Filament change dialog: row 2, to object Plane1: 15 mm above the bed, change to PLA Two \(Blue\)$' 10
wait-log '^Filament change dialog picks: on$' 10
button '^Cancel$'
focus-main
wait-log '^Filament change dialog picks: off$' 10
mark
click-logged '^Panel Send to Slicer action change_3[.]0 at '
focus-dialog '^Filament Change$' 30
wait-log '^Filament change dialog: row 3, to object A face of Body1: 40 mm above the bed, change to Pause$' 10
button '^Cancel$'
focus-main
wait-log '^Filament change dialog picks: off$' 10
expect-no-log '^Send to Slicer filament changes: '

# 5. The pointer over the plane's row paints its plane; Remove takes the
# plane's change away, then the face's pause.
mark
hover-logged '^Panel Send to Slicer input change_2 at '
wait-log '^Panel Send to Slicer note change_2 hovered: 0 places, 1 items$' 10
leave-widget input_change_2
wait-log '^Panel Send to Slicer note change_2 left$' 10
mark
click-logged '^Panel Send to Slicer action change_2[.]1 at '
wait-log '^Filament changes: removed Plane1 \(15 mm\)$' 30
wait-log '^Send to Slicer filament changes: 14 mm: Change to PLA Two \(Blue\) [|] A face of Body1 \(40 mm\): Pause$' 30
wait-log '^Panel Send to Slicer note change_2: Pause \[Edit\] \[Remove\]$' 30
mark
click-logged '^Panel Send to Slicer action change_2[.]1 at '
wait-log '^Filament changes: removed A face of Body1 \(40 mm\)$' 30
wait-log '^Send to Slicer filament changes: 14 mm: Change to PLA Two \(Blue\)$' 30

# 6. The panel closed: the bodies look as before.
mark
key Escape
key Escape
wait-log '^Command Send to Slicer cancelled' 30
wait-log '^Filament change overlay: none$' 30

# 6. Undo and Redo (with the panel closed, as for every command): the
# last Remove of 5 is one step, taken back and brought again.
mark
key ctrl+z
wait-log '^Undo: Set Filament Changes$' 30
mark
command make.print3d
wait-log '^Send to Slicer filament changes: 14 mm: Change to PLA Two \(Blue\) [|] A face of Body1 \(40 mm\): Pause$' 30
key Escape
key Escape
wait-log '^Command Send to Slicer cancelled' 30
mark
key ctrl+y
wait-log '^Redo: Set Filament Changes$' 30

# 7. Filament Change Here… on Plane1: the window with the plane picked.
wait-idle
mark
click-logged '^Datum F3 at ' right
wait-log '^Context menu: .*Filament Change Here…' 10
popup 'Filament Change Here…'
wait-log '^Filament Change Here: Plane1$' 10
wait-log '^Command Send to Slicer started' 30
focus-dialog '^Filament Change$' 30
wait-log '^Filament change dialog: new, to object Plane1: 15 mm above the bed, change to PLA Two \(Blue\)$' 30
button '^OK$'
focus-main
wait-log '^Send to Slicer filament changes: 14 mm: Change to PLA Two \(Blue\) [|] Plane1 \(15 mm\): Change to PLA Two \(Blue\)$' 30
wait-log '^Panel Send to Slicer note change_2: Change to PLA Two \(Blue\) \[Edit\] \[Remove\]$' 30
key Escape
key Escape
wait-log '^Command Send to Slicer cancelled' 30

# 8. Filament Change Here… on the box's top: Plates… on Plate 1.
mark
command inspect.measure
wait-log '^Pick face F2[.]b0/F2:end' 30
key Escape
wait-log '^Command Measure cancelled' 30
mark
click-logged '^Pick face F2[.]b0/F2:end' right
wait-log '^Context menu: .*Filament Change Here…' 10
popup 'Filament Change Here…'
wait-log '^Filament Change Here: A face of Body1 on plate plate1$' 10
wait-log '^Command Plates… started' 30
focus-dialog '^Filament Change$' 30
wait-log '^Filament change dialog: new, to object A face of Body1: 40 mm above the bed, change to PLA Two \(Blue\)$' 30
button '^OK$'
focus-main
wait-log '^Send to Slicer filament changes: Plate 1 \(its own\): 14 mm: Change to PLA Two \(Blue\) [|] Plane1 \(15 mm\): Change to PLA Two \(Blue\) [|] A face of Body1 \(40 mm\): Change to PLA Two \(Blue\)$' 30
wait-log '^Panel Plates… note change_3: Change to PLA Two \(Blue\) \[Edit\] \[Remove\]$' 30
mark
key Escape
key Escape
wait-log '^Filament change overlay: none$' 30
mark
key ctrl+s
wait-log '^Saved ' 30
expect-never 'TestDriver: FAIL'
