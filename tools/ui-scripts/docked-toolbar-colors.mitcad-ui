# SPDX-License-Identifier: MIT
# The Docked layout's top colours in both themes (GitHub #127, mitcad#1245;
# the top bar and the toolbar panel of Windows and Linux since mitcad#2082):
# the title row and its Undo and Redo pair, flat on it, show the window's
# colour (the "window" colour of the "Window style:" line), as the
# Floating top bar does; the Chat button on the row and the toolbar panel's
# card (ribbonPanel) are of the theme (dark or light), not the Windows 11
# style's neutral grey, as the window draws them ("TestDriver: widget
# background ...", "TestDriver: widget theme ..."):
#   1. In the dark theme.
#   2. In the light theme, after a switch while Mitcad runs.
#   3. In the dark theme again, after the switch back.
# The scheme is asked for at each step (color-scheme), whichever the session
# started in; a "Window style:" line is logged at the start and at each
# change of theme, so the last one of the theme gives its window colour.
# Run by tools/ui-docked-toolbar-colors-test.sh (Linux) and
# tools/ui-windows-docked-toolbar-colors-test.ps1 (Windows), both Docked.
expect-ever 'View area' 30
wait-idle

color-scheme dark
capture window '^Window style: dark, window (#[0-9a-f]+), panels #[0-9a-f]+,' 10
wait-idle
sleep 500
expect-widget-background titleRow ${window} 6
expect-widget-background titleHistory ${window} 6
expect-widget-theme titleChat dark
expect-widget-theme ribbonPanel dark

color-scheme light
capture window '^Window style: light, window (#[0-9a-f]+), panels #[0-9a-f]+,' 10
wait-idle
sleep 500
expect-widget-background titleRow ${window} 6
expect-widget-background titleHistory ${window} 6
expect-widget-theme titleChat light
expect-widget-theme ribbonPanel light

color-scheme dark
capture window '^Window style: dark, window (#[0-9a-f]+), panels #[0-9a-f]+,' 10
wait-idle
sleep 500
expect-widget-background titleRow ${window} 6
expect-widget-theme ribbonPanel dark
expect-never 'TestDriver: FAIL'
