# SPDX-License-Identifier: MIT
# Sketch Offset where corner arcs vanish (mitcad#1234). The wrapper
# replaces ENTER_SKETCH with the frontend's ordinary timeline activation on
# the fixture's Sketch1: two framing points at (-40, -30) and (40, 30) and
# a regular hexagon of circumradius 20 about the origin whose corners are
# rounded with 2 mm arcs; its sides run counter-clockwise, the first from
# (20, 0) to (10, 17.32). The clicks stay within x -30..30 mm, y -25..25
# mm: the free part of the view after the fit also in session 0's 1024x768
# window on Windows.
wait-idle
ENTER_SKETCH
expect-log '^Editing sketch F1 \(Sketch1\)'
key F6

# The first side selected, Offset opened with Chain Selection on: the
# chain runs against the side, clockwise, so the distance goes inward. At
# the default 5 mm the corner arcs vanish: the preview builds the sharp
# hexagon and says so as a note, not as an error.
mark
sketch-click 15 8.66
expect-selection 1 0
mark
command sketch.offset
wait-log '^Command Offset started'
wait-log '^Preview Offset: ok, note: corner arcs .* vanish at this distance$'
expect-no-log '^Preview Offset: failed'

# 2 mm, the arcs' radius: they collapse to their centers, where the sides'
# offsets meet; OK keeps it.
mark
type-in '^Panel Offset input distance at ' '2 mm'
wait-log '^Preview Offset: ok, note: corner arcs .* vanish at this distance$'
expect-no-log '^Preview Offset: failed'
screenshot '${MITCAD_TEST_WORK}/sketch-offset-vanishing.png'
mark
key Return
wait-log '^Added Offset'
expect-no-log 'larger than'

command sketch.finish
wait-log '^Sketch finished'
command file.save
wait-log '^Saved '
expect-never 'Recompute failed|TestDriver: FAIL'
