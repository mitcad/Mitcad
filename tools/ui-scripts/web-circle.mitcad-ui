# SPDX-License-Identifier: MIT
# A Web from a circle (mitcad#2364), on web-circle.json (a 100 x 100 x 5
# plate, 50000 mm3, and on its top Sketch2 F4 with a circle of radius 20
# about (50, 50), c1):
#   1. Web, the circle picked, Depth (10 mm): the preview is made (a closed
#      curve is no longer refused).
#   2. OK: a ring wall 2 thick along the circle, 10 high, joined to the
#      plate: 2 pi 20 x 2 x 10 = 800 pi mm3 more, one body.
#   3. Undo takes it away in one step.
# Run by tools/ui-web-circle-test.sh (Linux),
# tools/ui-windows-web-circle-test.ps1 (Windows) and
# tools/ui-macos-web-circle-test.sh (macOS).
expect-ever 'View area'
wait-idle
command view.fit
wait-idle
expect-model-bodies 1 50000
capture-undo-depth baseline

# 1. Web on the circle, by a depth.
mark
command solid.web
wait-log '^Command Web started'
wait-log '^Sketch entity F4/c1 at ' 20
wait-idle
click-logged '^Sketch entity F4/c1 at '
wait-log '^Web Curves: 1 sketch curve' 30
qt-choice input_depth_type 'Depth'
wait-log '^Preview Web: ok' 60
wait-idle 60

# 2. OK: the ring on the plate.
mark
key Return
wait-log '^Added web on 1 curve\(s\), thickness 2' 60
wait-idle 60
expect-model-bodies 1 52513.2741228718
expect-undo-depth ${baseline} 1

# 3. Undo.
mark
command edit.undo
wait-idle 60
expect-model-bodies 1 50000
expect-undo-depth ${baseline} 0
