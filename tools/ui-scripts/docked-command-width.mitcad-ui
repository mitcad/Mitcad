# SPDX-License-Identifier: MIT
# The Docked layout's Command panel at the largest Text size and Icon size
# (mitcad#1825, GitHub mitcad/Mitcad#336), MitCad started with
# appearance/textSize and appearance/iconSize 200 and no width remembered:
#   1. The panel is at least 300 px times 200 %: "Command panel width <w>
#      (at least 600)".
#   2. A sketch on the XY plane: every row of the Sketch Palette (its title,
#      settings, Dimension text, the Create and Constraints sections, Look
#      At, Finish Sketch) lies whole within the panel ("Palette rows cut:
#      none"), no Create or Constraints button is clipped, and the palette
#      is not scrolled sideways (a row left of the panel's edge is cut).
#   3. The panel's edge (the window's separator left of the dock) dragged
#      150 px to the left: the wider width is remembered
#      (commandPanel/dockWidth) once the drag rests, and the palette's rows
#      are still whole at it.
# The runner reads the widths from the log; the restart is
# docked-command-width-restart.mitcad-ui. Run by
# tools/ui-docked-command-width-test.sh (Linux) and
# tools/ui-windows-docked-command-width-test.ps1 (Windows), both Docked.
expect-ever '^Text and icon size: Text size 200%, Icon size 200%, ' 30
expect-ever 'View area' 30
wait-idle
window-resize 1500 950
wait-idle

# 1. The panel's width at these sizes.
expect-ever '^Command panel width [0-9]+ [(]at least 600[)]$' 10
expect-ever '^Command edge at ' 10
expect-no-log '^Command panel: dock width [0-9]+ restored$'

# 2. A sketch: the palette whole within the panel.
mark
command sketch.create
expect-log 'Datum xy at ' 10
click-logged '^Datum xy at '
expect-log 'Sketch started on xy' 10
wait-idle
expect-log '^Palette rows cut: none [(]' 10
expect-log '^Palette buttons clipped: none ' 10

# 3. The edge dragged wider: remembered, the rows whole at the new width.
mark
drag-from '^Command edge at ' -150 0
expect-log '^Command panel: dock width [0-9]+ remembered$' 10
capture WIDTH '^Command panel: dock width ([0-9]+) remembered$'
expect-setting commandPanel/dockWidth ${WIDTH}
expect-log '^Command panel width ${WIDTH} [(]at least 600[)]$' 10
expect-log '^Palette rows cut: none [(]' 10
expect-log '^Palette buttons clipped: none ' 10
expect-never 'TestDriver: FAIL'
