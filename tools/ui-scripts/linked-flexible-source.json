[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "mitcad#2209: the design tools/ui-scripts/linked-flexible-holder.json links with its components. A Base (C1, Base:1 O1, grounded; Sketch1 F1, Extrude1 F2, 100 x 20 x 5 about its origin) and a Key (C2, Key:1 O2 at (0, 0, 10); Sketch2 F3, Extrude2 F4, 20 x 20 x 5 about its origin) that slides along x on the Base: Joint1 (F5, the root's), within -40 to 40 mm. All geometry is synthetic."},
  {"cmd": "create_component", "name": "Base"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [-50, -10], "width": 100, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "ground_occurrence", "occurrence": "Base:1"},
  {"cmd": "create_component", "name": "Key", "transform": {"translation": [0, 0, 10]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [-10, -10], "width": 20, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "add_joint", "kind": "slider", "slide_axis": "x",
    "a": {"occurrence": "Key:1", "geometry": {"point": [0, 0, 0]}},
    "b": {"occurrence": "Base:1", "geometry": {"point": [0, 0, 10]}},
    "limits": {"tx": {"min": -40, "max": 40}}},
  {"expect": {"feature": "Joint1", "status": "ok"}}
]
