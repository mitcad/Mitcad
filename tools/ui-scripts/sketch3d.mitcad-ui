wait-log '^3D sketch input axis: [+]Z'
wait-log '^3D sketch field length at '
wait-idle
click-logged '^3D sketch field length at '
type 25
wait-log '^3D sketch field length: 25'
mark
key Return
wait-log '"axis":"z"'
wait-log '^3D sketch Line: made c5 from p2 to p4'
wait-log '3 points, 2 curves, dof 1'

# Esc layers and Undo.
