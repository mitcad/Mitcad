mark
key Return
wait-log '^3D sketch Ellipse: pending point 2 at '
wait-log '^3D sketch field minor at '
wait-idle
expect-no-log '^3D sketch command: '
click-logged '^3D sketch field minor at '
view-pointer move 34 62 none
wait-idle
type 5
wait-log '^3D sketch field minor: 5'
mark
key Return
wait-log '"cmd":"sketch3d[.]add_ellipse"'
wait-log '"plane":"xy"'
wait-log '"major_value":"10'
wait-log '"minor_value":"5'
wait-log '^3D sketch Ellipse: made c'
wait-log ' points, 1 curves, dof '
mark
key Escape
key Escape
wait-log '^3D sketch tool Ellipse: stopped'
expect-no-log '^Sketch finished'

mark
command sketch.polygon
wait-log '^3D sketch tool Circumscribed Polygon: started; on the XY plane'
wait-idle
mark
click-logged '^3D sketch frame at '
wait-log '^3D sketch Circumscribed Polygon: pending point 1 at [(]0[.]000, 0[.]000, 0[.]000[)]'
wait-log '^3D sketch field radius at '
wait-idle
click-logged '^3D sketch field radius at '
view-pointer move 36 56 none
wait-idle
type 20
wait-log '^3D sketch field radius: 20'
mark
key Return
wait-log '"cmd":"sketch3d[.]add_polygon"'
wait-log '"sides":6'
wait-log '"radius":"20'
wait-log '^3D sketch Circumscribed Polygon: made c'
wait-log ' points, 9 curves, dof '
mark
key Escape
key Escape
wait-log '^3D sketch tool Circumscribed Polygon: stopped'
expect-no-log '^Sketch finished'

mark
command sketch.text
wait-log '^3D sketch tool Text: started; on the XY plane'
# The 3D Sketch box disabled as the tool starts (mitcad#1592).
wait-log '^3D Sketch Palette 3D Sketch box: enabled no: Finish or Escape the active tool first[.]$'
wait-idle
mark
view-pointer move 34 36 none
view-pointer press 34 36 left
view-pointer move 36 37 left
view-pointer move 38 38 left
view-pointer move 40 39 left
view-pointer move 42 40 left
view-pointer move 44 41 left
wait-log '^3D sketch Text: frame preview from [(]'
view-pointer release 44 41 left
wait-log '^3D sketch Text: frame to [(]'
wait-log '^3D sketch Text: pending point 1 at '
expect-ever '^3D sketch field text at '
wait-idle
expect-no-log '^3D sketch command: '
click-logged '^3D sketch field text at '
type MitCad
wait-log '^3D sketch field text: MitCad'
mark
key Return
wait-log '"cmd":"sketch3d[.]add_text"'
wait-log '"frame":\['
wait-log '"text":"MitCad"'
wait-log '^3D sketch Text: made t'
wait-log ' points, 13 curves, dof '
mark
key Escape
key Escape
wait-log '^3D sketch tool Text: stopped'
# And enabled again as it ends (mitcad#1592).
wait-log '^3D Sketch Palette 3D Sketch box: enabled yes: '
mark
command sketch.finish
wait-log '^Sketch finished'
expect-never 'Recompute failed'
expect-never 'TestDriver: FAIL'
