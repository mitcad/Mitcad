# Edit Sketch of 3DSketch1 from the Timeline.
mark
dblclick-logged '^Timeline 3DSketch1 at '
wait-log '^Editing 3D sketch F2 [(]3DSketch1[)]'
wait-log '^3D sketch F2 [(]3DSketch1[)]: '
wait-log '^3D sketch frame in the design: origin [(]-?[0-9.]+, -?[0-9.]+, 20[.]000000[)]'
wait-log '^View banner: 3D Sketch 3DSketch1'
wait-log 'sketch[.]slot: a 2D sketch tool does not apply to a 3D sketch'
wait-log '^3D sketch entity F2/p2 at '
wait-log '^3D sketch entity F2/c10 at '
# Every relation and dimension button whole across the card (mitcad#1592).
wait-log '^3D sketch edit controls across the card: all whole$'
wait-idle
mark
click-logged '^3D sketch entity F2/p2 at '
wait-log 'Selected: 1 sketch point \[sketch point p2 of F2\]'
wait-log 'selected Point p2 at 40[.]00, 0[.]00, 0[.]00 mm'
wait-log '^3D Sketch Palette: 3DSketch1.*, 20[.]00 mm in the component'
wait-log '^3D sketch hover: Point p2'
# The point's description in the card's sight (mitcad#1592).
wait-log '^3D sketch selection description at '
mark
click-logged '^3D sketch entity F2/c10 at '
wait-log 'Reference curve c10: edge E[{]F1:side0[|]F1:side1[}] of F1[.]b0; included in 3D'
mark
key Escape
wait-log 'Selected: nothing'
key Escape
wait-idle
expect-no-log '^Sketch finished'
mark
click-logged '^3D sketch entity F2/c16 at '
wait-log '\[sketch curve c16 of F2\]'
key Delete
wait-log '^3D sketch F2: deleted'
mark
command sketch.finish
wait-log '^Sketch finished'
mark
command edit.undo
wait-log 'Undo: Edit 3DSketch1'
expect-never 'Recompute failed'

# The light bulb.
