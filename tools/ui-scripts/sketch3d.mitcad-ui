expect-no-log '^Sketches shown: .*F2'
mark
click-logged '^Browser eye Root/Sketches/3DSketch1 at '
wait-log 'Visibility Root/Sketches/3DSketch1: shown'

# The drawing tools: a Line chain from the origin by typed values.
mark
command sketch.create
