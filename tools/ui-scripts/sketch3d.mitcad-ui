key Return
# Delta Y untouched is no dimension: one degree of freedom left.
wait-log '^3D sketch command: .*"offsets":\["40[^\]]*,null,'
wait-log '^3D sketch Line: made c3 from p1 to p2'
wait-log '2 points, 1 curves, dof 1'
wait-idle
