# SPDX-License-Identifier: MIT
wait-idle
show-dialog-style-fixture setup
command tools.libraries
focus-dialog '^Library Sources$'
button '.*' libraryAddSource
key Escape
focus-dialog '^Library Sources$'
button '.*' libraryAddSource
popup 'Add URL…'
focus-dialog '^Add Library$'
key Escape
focus-dialog '^Library Sources$'
key Return
expect-dialog-gone '^Library Sources$'
focus-main
show-dialog-style-fixture parts
focus-dialog '^Components in This Design$'
show-dialog-style-fixture bom
test-dialog-controls bom
screenshot-dialog '${MITCAD_STYLE_SHOTS}/bom-${MITCAD_TEST_COLOR_SCHEME}.png'
key Return
expect-dialog-gone '^Components in This Design$'
focus-main
show-dialog-style-fixture picker
focus-dialog '^Component Picker'
button '.*' partPickerPin
expect-widget-property partPickerPin checked true
button '.*' partPickerPin
expect-widget-property partPickerPin checked false
button '.*' partPickerStar
expect-widget-property partPickerStar checked true
button '.*' partPickerStar
expect-widget-property partPickerStar checked false
key Return
expect-dialog-gone '^Component Picker'
focus-main
show-dialog-style-fixture project-settings
focus-dialog '^Project Settings'
button '^Cloud \(git\)$'
button '^Local$'
focus-widget projectDisplayName
key Return
expect-dialog-gone '^Project Settings'
focus-main
command tools.shortcuts
focus-dialog '^Keyboard Shortcuts$'
focus-widget shortcutSearch
type noMatchingCommandForThisFixture
test-dialog-controls shortcuts-empty
key ctrl+a
type Extrude
test-dialog-controls shortcuts-results
key Escape
expect-dialog-gone '^Keyboard Shortcuts$'
focus-main
expect-model-bodies 1 48000

# Old scripts and typed captions may still use the three-dot spelling.
command tools.search
focus-widget commandSearchInput
type 'Library Sources...'
expect-command-search 'Library Sources...' tools.libraries
key ctrl+a
type 'Library Sources…'
expect-command-search 'Library Sources…' tools.libraries
key Escape
focus-main

# The Materials window (mitcad#655) shares the same conventions.
command solid.materials
focus-dialog '^Materials$'
test-dialog-controls materials
screenshot-dialog '${MITCAD_STYLE_SHOTS}/materials-${MITCAD_TEST_COLOR_SCHEME}.png'
key Escape
expect-dialog-gone '^Materials$'
focus-main
