[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "A joint edited with its Offset emptied while typing (mitcad#1860, GitHub mitcad/Mitcad#347), tools/ui-joint-edit-empty-offset-test.sh: Shaft:1 (O1, grounded) with a 60 x 10 x 10 box (F1.b0); Bearing:1 (O2) at (10, 0, 30) and Tube:1 (O3) at (30, 0, 60), each with a 10 x 10 x 10 box (F2.b0, F3.b0). Joint1 (F4) puts Bearing:1's bottom on Shaft:1's top with an Offset of 5 mm, Joint2 (F5) Tube:1's bottom on Bearing:1's top, and RigidGroup1 (F6) holds Bearing:1 and Tube:1: the joint and the group after Joint1 are rolled back while Joint1 is edited. All geometry is synthetic."},
  {"cmd": "create_component", "name": "Shaft"},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [0, 0],
    "length": 60, "width": 10, "height": 10, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Bearing", "transform": {"translation": [10, 0, 30]}},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [0, 0],
    "length": 10, "width": 10, "height": 10, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Tube", "transform": {"translation": [30, 0, 60]}},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [0, 0],
    "length": 10, "width": 10, "height": 10, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "ground_occurrence", "occurrence": "Shaft:1"},
  {"cmd": "add_joint", "kind": "rigid", "flip": true, "offset": 5,
    "a": {"occurrence": "Bearing:1", "geometry": {"body": "F2.b0", "face": "F2:bottom"}},
    "b": {"occurrence": "Shaft:1", "geometry": {"body": "F1.b0", "face": "F1:top"}}},
  {"cmd": "add_joint", "kind": "rigid", "flip": true,
    "a": {"occurrence": "Tube:1", "geometry": {"body": "F3.b0", "face": "F3:bottom"}},
    "b": {"occurrence": "Bearing:1", "geometry": {"body": "F2.b0", "face": "F2:top"}}},
  {"cmd": "add_rigid_group", "occurrences": ["Bearing:1", "Tube:1"]},
  {"expect": {"feature": "F4", "status": "ok"}},
  {"expect": {"feature": "F5", "status": "ok"}},
  {"expect": {"feature": "F6", "status": "ok"}}
]
