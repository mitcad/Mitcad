# SPDX-License-Identifier: MIT
# A new sphere's see-through preview without a pattern of triangles
# (mitcad#1575, GitHub mitcad/Mitcad#219): in an empty design with the
# layout grid off, Sphere placed on the XY plane by its row in the browser,
# 400 mm across (larger than the picked plane drawn behind it, so that the
# fit frames the sphere). Its preview is logged see-through with its back
# faces culled (a closed solid), and in the view's own frame the middle of
# the preview has no steps in brightness (expect-view-smooth; the lines
# behind it, the plane's axes and outline, are left out by comparing with
# the frame without the preview) from the fitted start view, two turns,
# and the top and front views. At the start view the old double-sided
# look (preview-back-faces draw) trips the same measure
# (expect-view-stepped), so the check is known to catch the pattern. Run by
# tools/ui-preview-transparency-test.sh,
# tools/ui-windows-preview-transparency-test.ps1 and
# tools/ui-macos-preview-transparency-test.sh.
expect-ever 'Browser arrow Root/Origin at' 30
color-scheme light
sleep 500
wait-idle
mark
command view.grid
expect-log '^Layout grid off' 10
wait-idle
mark
command solid.sphere
expect-log '^Command Sphere started' 30
click-logged '^Browser arrow Root/Origin at '
wait-idle 60
expect-log '^Browser Root/Origin/XY at ' 10
mark
click-logged '^Browser Root/Origin/XY at '
expect-log '^Place Sphere: .*plane xy' 30
wait-log '^Preview Sphere: ok' 30
mark
type-in '^Panel Sphere input diameter at ' '400 mm'
wait-log '^Preview Sphere: ok' 30
expect-ever '^View new body \S+: transparency 0[.]5, back faces culled$' 10
command view.fit
wait-idle
expect-view-smooth 0.5
screenshot-view '${MITCAD_TEST_WORK}/preview-transparency-culled.png'
# The old look, double-sided, at the same view, measured and logged only:
# Mesa's software renderer (the Windows and Linux UI tests) draws the far
# half without the pattern at this view (0.000 % on Windows, mitcad#1575),
# so the reported pattern cannot be required here; the culled look must
# stay smooth from every view below.
mark
preview-back-faces draw
expect-log '^View new body \S+: transparency 0[.]5, both sides drawn$' 10
wait-idle
expect-view-stepped 0
screenshot-view '${MITCAD_TEST_WORK}/preview-transparency-double-sided.png'
mark
preview-back-faces cull
expect-log '^View new body \S+: transparency 0[.]5, back faces culled$' 10
wait-idle
expect-view-smooth 0.5
command view.turn_left
wait-idle
expect-view-smooth 0.5
command view.turn_up
wait-idle
expect-view-smooth 0.5
command view.top
wait-idle
expect-view-smooth 0.5
command view.front
wait-idle
expect-view-smooth 0.5
screenshot-view '${MITCAD_TEST_WORK}/preview-transparency-front.png'
key Escape
expect-log '^Command Sphere cancelled' 30
