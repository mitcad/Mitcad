# SPDX-License-Identifier: MIT
# Native sketch precision fields and command-form integration. Run with
# the native UI, an empty document, MITCAD_LOG_VOLUMES=1 and MITCAD_TEST_WORK.
# Actual AppKit text input, focus traversal and confirmation create a
# 40.5 x 25 mm rectangle, then OCCT verifies its 20 mm extrusion volume.
expect-ever 'Native UI: AppKit shell with embedded OCCT viewport'
expect-ever 'View area'
sleep 800
native-appearance '${MITCAD_TEST_COLOR_SCHEME}'

mark
native-action sketch.create
expect-log 'Create Sketch: select a plane'
click-logged 'Datum xy'
expect-log 'Sketch started on xy'
expect-native-visible native.inspectorCard true
expect-native-layout
expect-native-text native.ribbon.group.create '^Create$'
expect-native-visible native.ribbon.sketch.line true
expect-native-visible native.ribbon.sketch.rectangle true
expect-native-visible native.ribbon.sketch.constraint.horizontal_vertical true
expect-native-visible palette_sketch.constraint.horizontal_vertical true
expect-native-layout
expect-native-bounds paletteFinish 1
screenshot '${MITCAD_TEST_WORK}/native-macos-sketch-palette.png'
expect-native-style paletteFinish caption

# Native inline fx uses the same parameter source and shared editors as a
# command field. Its independent user parameter is undone before the
# original numeric/geometry workflow below, and no sketch is drawn here.
capture-undo-depth inlineFxBaseline
expect-model-parameter ui_inline_width absent
mark
native-pointer-click native.ribbon.sketch.rectangle
sketch-click 0 0
expect-native-visible sketchField_widthFx true
expect-native-text sketchField_widthFx '^fx$'
expect-native-style sketchField_widthFx caption
native-pointer-click sketchField_width
native-key-event Ctrl+a
type '15 mm'
expect-native-text sketchField_width '^15 mm$'
native-pointer-popup sketchField_widthFx 'Create User Parameter…' '${MITCAD_TEST_WORK}/native-inline-fx-menu.png'
expect-log '^Parameter browser opened for sketch width$'
focus-dialog '^Create User Parameter$'
native-pointer-click createParameterName
native-key-event Ctrl+a
type ui_cancelled_inline
native-pointer-click createParameterExpression
native-key-event Ctrl+a
type 8
native-key-event Escape
expect-native-dialog-gone '^Create User Parameter$'
expect-model-parameter ui_cancelled_inline absent
expect-native-text sketchField_width '^15 mm$'
expect-native-control-focus sketchField_width
expect-undo-depth ${inlineFxBaseline} 0

# Create through the real tracked fx menu, then return to the same live
# field. The shared parameter is a separate undo step, not drawing input.
mark
native-key-event Ctrl+a
native-pointer-popup sketchField_widthFx 'Create User Parameter…'
expect-log '^Create User Parameter opened for sketch width'
focus-dialog '^Create User Parameter$'
native-pointer-click createParameterName
native-key-event Ctrl+a
type ui_inline_width
native-pointer-click createParameterExpression
native-key-event Ctrl+a
type 15
expect-native-text createParameterExpression '^15$'
screenshot-screen '${MITCAD_TEST_WORK}/native-inline-fx-create.png'
native-pointer-button '^Create$'
expect-log '^Created user parameter ui_inline_width = 15 mm [(]mm[)] for sketch width$'
expect-log '^Parameter created inserted ui_inline_width into sketch width: ui_inline_width$'
expect-native-dialog-gone '^Create User Parameter$'
expect-native-text sketchField_width '^ui_inline_width$'
expect-native-control-focus sketchField_width
expect-model-parameter ui_inline_width 15
expect-undo-depth ${inlineFxBaseline} 1

# A parameter reference replaces the actual middle selection, rather
# than replacing the whole expression or using the hidden Qt caret.
native-key-event Ctrl+a
type '5 mm + 999 mm'
native-key-event Shift+Left Shift+Left Shift+Left Shift+Left Shift+Left Shift+Left
mark
native-pointer-popup sketchField_widthFx ui_inline_width
expect-log '^Parameter browser inserted ui_inline_width into sketch width: 5 mm [+] ui_inline_width$'
expect-native-text sketchField_width '^5 mm [+] ui_inline_width$'
expect-native-control-focus sketchField_width
expect-sketch-field-dimension width length 20
screenshot-screen '${MITCAD_TEST_WORK}/native-inline-fx-reference.png'

# Cancel preserves the current expression; accepting the shared Formula
# Editor writes it back into the same native field without drawing yet.
native-key-event Ctrl+a
type ui_inline_width
native-pointer-popup sketchField_widthFx 'Edit Formula…'
focus-dialog '^Formula Editor$'
expect-native-text formulaText '^ui_inline_width$'
native-pointer-click formulaText
native-key-event Ctrl+a
type 'ui_inline_width + 2 mm'
native-key-event Escape
expect-native-dialog-gone '^Formula Editor$'
expect-native-text sketchField_width '^ui_inline_width$'
expect-native-control-focus sketchField_width
native-pointer-popup sketchField_widthFx 'Edit Formula…'
focus-dialog '^Formula Editor$'
native-pointer-click formulaText
native-key-event Ctrl+a
type 'ui_inline_width + 5 mm'
screenshot-screen '${MITCAD_TEST_WORK}/native-inline-fx-formula.png'
native-key-event Ctrl+Return
expect-log '^Formula editor applied: ui_inline_width [+] 5 mm$'
expect-native-dialog-gone '^Formula Editor$'
expect-native-text sketchField_width '^ui_inline_width [+] 5 mm$'
expect-native-control-focus sketchField_width
expect-sketch-field-dimension width length 20
expect-no-log 'Added rectangle'
expect-undo-depth ${inlineFxBaseline} 1

# F5 and Option-Escape request AppKit's own completion provider. The unique
# reference keeps the live caret; Tab/Shift+Tab retain field traversal.
native-key-event Ctrl+a
type ui_inline_w
native-key-event Alt+Escape
expect-native-text sketchField_width '^ui_inline_width$'
expect-native-control-focus sketchField_width
expect-no-qt-popup
native-key-event Right
type ' + 5 mm'
expect-native-text sketchField_width '^ui_inline_width [+] 5 mm$'
expect-sketch-field-dimension width length 20
native-key-event Ctrl+a
type ui_inline_w
native-key-event F5
expect-native-text sketchField_width '^ui_inline_width$'
expect-native-control-focus sketchField_width
expect-no-qt-popup
screenshot-screen '${MITCAD_TEST_WORK}/native-inline-fx-completion.png'
native-key-event Tab
expect-native-control-focus sketchField_height
native-key-event Ctrl+a
type '9 mm'
native-key-event Shift+Tab
expect-native-control-focus sketchField_width
expect-native-text sketchField_width '^ui_inline_width$'
expect-no-qt-popup
native-key-event Escape
expect-native-visible sketchField_width false
expect-native-visible sketchField_widthFx false
expect-native-focus native.viewportHost
expect-no-log 'Added rectangle'
expect-model-bodies 0 0
expect-profiles 0
expect-model-parameter ui_inline_width 15
expect-undo-depth ${inlineFxBaseline} 1

# Reopening creates fresh native fields/tools. Cancel still removes the
# drawing, then ordinary Undo removes only the independent user parameter.
native-pointer-click native.ribbon.sketch.rectangle
sketch-click 0 0
expect-native-visible sketchField_widthFx true
native-pointer-click sketchField_width
native-key-event Ctrl+a
type '7 mm'
expect-native-text sketchField_width '^7 mm$'
expect-no-qt-popup
screenshot-screen '${MITCAD_TEST_WORK}/native-inline-fx-reopened.png'
native-key-event Escape
expect-native-visible sketchField_width false
expect-native-visible sketchField_widthFx false
expect-native-focus native.viewportHost
command edit.undo
expect-model-parameter ui_inline_width absent
expect-undo-depth ${inlineFxBaseline} 0
expect-profiles 0
expect-model-bodies 0 0

# Escape from a real AppKit field cancels the unfinished drawing safely.
mark
native-click native.ribbon.sketch.rectangle
sketch-click 0 0
native-type sketchField_width '90 mm'
expect-log 'Sketch value width: 90 mm = '
key Escape
expect-no-log 'Added rectangle'

# Validation and precision entry share the declarative sketch controller.
# Typing into the focused field after Tab/Shift+Tab verifies native focus
# transfer, rather than selecting each field through the test bridge.
mark
native-click native.ribbon.sketch.rectangle
sketch-click 0 0
native-type sketchField_width 'bad_expression'
expect-log 'Sketch value width: bad_expression is invalid:'
native-type sketchField_width '40,5 mm'
expect-log 'Sketch value width: 40,5 mm = 40\.5 mm'
key Tab
type '25 mm'
expect-native-text sketchField_height '^25 mm$'
expect-log 'Sketch value height: 25 mm = 25 mm'
key shift+Tab
type '40.5 mm'
expect-native-text sketchField_width '^40\.5 mm$'
key Tab
screenshot '${MITCAD_TEST_WORK}/native-macos-sketch-fields.png'
native-key-event Return
expect-log 'Added rectangle 40\.5 x 25 mm at \(0, 0\)' 30
expect-log 'Sketch Sketch1: 0 DOF' 30

# Starting a panel command closes the Dimension tool's native inline
# editor before retiring the tool (mitcad#351). Neither confirmation nor
# a click after Cancel may invoke the pending dimension callback.
mark
capture-undo-depth beforeDimension
native-action sketch.dimension
sketch-click 20 0
sketch-click 20 8
expect-log 'Sketch value editor at'
# Unlike a tool's width/height, this dimension editor offers naming. Its
# native helper must preserve that action without committing the dimension.
expect-native-visible sketchValueEditorFx true
expect-native-style sketchValueEditorFx caption
native-pointer-popup sketchValueEditorFx 'Name This Value (name = value)'
expect-log '^Parameter naming for sketch dimension: name = '
expect-native-text sketchValueEditor '^name = '
expect-native-control-focus sketchValueEditor
screenshot-screen '${MITCAD_TEST_WORK}/native-inline-fx-naming.png'
native-click native.ribbon.sketch.offset
expect-log 'Command Offset started'
expect-log 'Sketch value editor closed'
native-click commandCancel
expect-log 'Command Offset cancelled'
key Return
sketch-click 25 10
expect-no-log 'Added (driven )?dimension'
expect-undo-depth ${beforeDimension} 0
native-click native.ribbon.sketch.finish
expect-log 'Sketch finished' 30

# The native feature presenter consumes the actual newly drawn profile.
mark
native-action solid.extrude
expect-log 'Command Extrude started'
native-type input_distance '20 mm'
expect-native-enabled commandOk true
native-click commandOk
expect-log 'Added extrude \(New Body\), distance 20' 30
capture extruded 'New body \S+ \(F2\.b0\): volume ([0-9.]+) mm3' 30
expect-near ${extruded} 20250
screenshot '${MITCAD_TEST_WORK}/native-macos-sketch-extrude.png'

# Browser Return activates the selected sketch or feature through the same
# shared controller as a double-click. A row's field editor still owns
# Return while renaming, without reopening the sketch. Whole AppKit events
# cover dispatch before the default button, without a direct equivalent call.
native-expand native.modelTree
native-select native.model.sketch:F1@O1
mark
native-type sketch:F1@O1 'KeyboardSketch'
native-key-event Return
expect-log 'Renamed Sketch1 to KeyboardSketch' 30
expect-no-log 'Editing sketch F1'
native-expand native.modelTree
native-select native.model.sketch:F1@O1
native-key-event Return
expect-log 'Editing sketch F1 \(KeyboardSketch\)' 30
native-click native.ribbon.sketch.finish
expect-log 'Sketch finished' 30
native-expand native.modelTree
native-select 'native.model.feature:F2<F1@O1'
mark
native-key-event Return
expect-log 'Editing F2 with Extrude'
expect-native-text input_distance '^20(?:\.0*)?(?: mm)?$'
# Browser activation also takes precedence while a command can confirm.
# The shared editor refuses a second edit; Return must not commit this one.
native-type input_distance '30 mm'
native-expand native.modelTree
native-select native.model.sketch:F1@O1
mark
native-key-event Enter
# The long Extrude form can scroll its buttons below the viewport.
expect-native-present commandOk true
expect-native-text input_distance '^30 mm$'
expect-no-log 'Edited F2|Editing sketch F1'
native-click commandCancel
expect-log 'Command Extrude cancelled' 30
expect-model-bodies 1 20250
expect-file '${MITCAD_TEST_WORK}/native-macos-sketch-fields.png'
expect-file '${MITCAD_TEST_WORK}/native-macos-sketch-palette.png'
expect-file '${MITCAD_TEST_WORK}/native-macos-sketch-extrude.png'
expect-never 'The document was read while a job computes it|Native Mac canvas:|OCCT view event failed|TestDriver: FAIL'
