# SPDX-License-Identifier: MIT
# Send to Slicer with Isolate (mitcad#2475), the 3MF run of
# tools/ui-print-isolate-test.sh on tools/ui-scripts/print-isolate.json
# (Pin placed twice as Pin:1 and Pin:2, Cube in the design, one plate),
# with 3MF as the last format:
#   1. Pin:2 isolated, nothing selected: Bodies starts with the placement
#      the view shows, Send the Design's Plates off; Send writes the bodies,
#      not the plates.
#   1b. Still isolated, nothing selected (mitcad#2490): Print Analysis and
#      Draft Analysis start with Pin alone, the body Isolate leaves shown,
#      not Cube (Esc closes each).
#   2. Still isolated: the box ticked sends the design's plates.
#   3. Isolate off, nothing selected: the plates start on again and Bodies
#      holds every shown placement (Esc sends nothing).
#   4. Pin:2 isolated again and its pin selected: that placement alone,
#      the plates off; Send writes the 3MF, which the wrapper reads (one
#      object of one placement, Pin:2's).
wait-idle
key F6

# 1. Pin:2 isolated, nothing selected.
mark
model-command '{"cmd":"set_isolation","items":[{"occurrence":"O2"}]}'
wait-log '^Bodies shown: F1[.]b0 in O2$'
key F6
wait-log '^Body F1[.]b0 in O2 at '
wait-idle
mark
command make.print3d
wait-log '^Command Send to Slicer started'
wait-log '^3D Print plates: 1, off: the bodies isolated$'
wait-log '^3D Print panel: 1 isolated: Pin; format 3mf'
wait-log '^3D Print placements: F1[.]b0 O2$'
wait-log '^Panel Send to Slicer input plates at '
mark
key Return
wait-log '^3D Print: 1 bodies as 3mf '
expect-no-log '^3D Print plate '
wait-idle

# 1b. Still isolated, nothing selected (mitcad#2490): Print Analysis and
#     Draft Analysis start from the bodies Isolate leaves shown, as Send to
#     Slicer does: Pin alone, not Cube.
mark
command inspect.print_analysis
wait-log '^Command Print Analysis started' 20
wait-log '^Print Analysis Bodies: 1 body' 20
wait-log '^Inspect Print Analysis: Pin overhang [^;]*, estimate ' 60
expect-no-log '^Inspect Print Analysis: .*Cube'
wait-idle 60
mark
key Escape
wait-log '^Command Print Analysis cancelled'
wait-idle
mark
command inspect.draft_analysis
wait-log '^Command Draft Analysis started' 20
wait-log '^Draft Analysis Bodies: 1 body' 20
wait-log '^Inspect Draft Analysis: pull [(]0, 0, 1[)], angle 1: Pin along ' 60
expect-no-log '^Inspect Draft Analysis: .*Cube'
wait-idle 60
mark
key Escape
wait-log '^Command Draft Analysis cancelled'
wait-idle

# 2. The box ticked: the design's plates.
mark
command make.print3d
wait-log '^Command Send to Slicer started'
wait-log '^3D Print plates: 1, off: the bodies isolated$'
wait-log '^Panel Send to Slicer input plates at '
click-logged '^Panel Send to Slicer input plates at '
wait-idle
mark
key Return
wait-log '^3D Print plate Plate 1: [0-9]+ pieces'
wait-log '^3D Print: plates '
wait-idle

# 3. Isolate off: the plates start on, every shown placement in Bodies.
mark
model-command '{"cmd":"set_isolation","items":[]}'
wait-log '^Bodies shown: .*F1[.]b0 in O1'
wait-idle
mark
command make.print3d
wait-log '^Command Send to Slicer started'
wait-log '^3D Print plates: 1$'
wait-log '^3D Print panel: 2 visible: '
wait-log '^3D Print placements: (?=.*F2[.]b0)(?=.*F1[.]b0 O1)(?=.*F1[.]b0 O2)'
key Escape
wait-log '^Command Send to Slicer cancelled'
wait-idle

# 4. Pin:2 isolated again, its pin selected: that placement alone.
mark
model-command '{"cmd":"set_isolation","items":[{"occurrence":"O2"}]}'
wait-log '^Bodies shown: F1[.]b0 in O2$'
key F6
wait-log '^Body F1[.]b0 in O2 at '
wait-idle
mark
click-logged '^Body F1[.]b0 in O2 at '
wait-log '^Selected: 1 .* of F1[.]b0 in O2\]$'
mark
command make.print3d
wait-log '^Command Send to Slicer started'
wait-log '^3D Print plates: 1, off: the bodies selected$'
wait-log '^3D Print panel: 1 selected: Pin; format 3mf'
wait-log '^3D Print placements: F1[.]b0 O2$'
mark
key Return
wait-log '^3D Print: 1 bodies as 3mf '
expect-no-log '^3D Print plate '
wait-idle
expect-never 'TestDriver: FAIL'
