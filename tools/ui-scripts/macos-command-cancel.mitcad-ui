# SPDX-License-Identifier: MIT
# Real Qt fields with asynchronous previews and synchronous explicit commands.
# A worker gate holds each preview while the real UI sends competing input.
expect-ever 'View area'
window-resize 1280 820
sleep 600
# The synthetic persisted baseline avoids selecting an origin plane whose
# logged pick can lie beneath the floating command card. This test targets
# command races; all edited values and confirmation/cancellation still go
# through the real Qt form controls.
expect-model-bodies 1 10000
capture-undo-depth initial_depth

# Replace the value while its preceding preview is genuinely busy. Return
# requests acceptance of the newest input before the replacement preview
# completes. The stale 11 mm result must never become the committed body.
mark
dblclick-logged '^Timeline Box1 at'
expect-log 'Editing F1 with Box'
wait-idle 30
mark
hold-model-preview true
qt-type-now input_height '11 mm'
wait-log 'Computing preview started' 30
expect-model-busy true
qt-type-now input_height '11.2 mm'
qt-type-now input_height '11.4 mm'
qt-type-now input_height '12 mm'
key-now Return
hold-model-preview false
expect-log 'Edited F1' 30
expect-model-bodies 1 12000
expect-undo-depth ${initial_depth} 1
expect-no-log 'Body .*volume .* -> 11000\.000 mm3|Box Height: 11\.[24] mm'

# Return to the already displayed/cached definition while another value
# computes, then request OK before it finishes. A cache hit must resume
# that pending acceptance just like a newly computed exact result.
mark
dblclick-logged '^Timeline Box1 at'
expect-log 'Editing F1 with Box'
wait-idle 30
mark
hold-model-preview true
qt-type-now input_height '13 mm'
wait-log 'Computing preview started' 30
expect-model-busy true
qt-type-now input_height '12 mm'
key-now Return
hold-model-preview false
expect-log 'Edited F1' 30
expect-model-bodies 1 12000
capture-undo-depth committed_depth

# Interrupt the background preview through the test worker control. OK
# after an interrupted preview computes the actual edit_feature; its real
# progress dialog still offers Cancel. Interactive previews have no modal
# progress UI. Volume and undo depth must remain at the 12 mm edit.
mark
dblclick-logged '^Timeline Box1 at'
expect-log 'Editing F1 with Box'
wait-idle 30
mark
hold-model-preview true
qt-type-now input_height '14 mm'
wait-log 'Computing preview started' 30
cancel-model-job Box
hold-model-preview false
wait-log 'Computing preview cancelled after ' 30
expect-log 'Preview Box: cancelled' 30
focus-main
mark
button '^OK$'
qt-cancel-progress edit_feature
wait-log 'Computing edit_feature cancelled after ' 30
expect-log 'Box: OK cancelled' 30
focus-main
key Escape
expect-log 'Command Box cancelled' 30
expect-model-bodies 1 12000
expect-undo-depth ${committed_depth} 0
expect-no-log 'Edited F1|Body .*volume .* -> 14000\.000 mm3'

# Escape cancels a running background preview and its form, then starts
# a different command. This catches
# stale form/session state and accidental undo-stack mutation.
mark
dblclick-logged '^Timeline Box1 at'
expect-log 'Editing F1 with Box'
wait-idle 30
mark
hold-model-preview true
qt-type-now input_height '99 mm'
wait-log 'Computing preview started' 30
expect-model-busy true
key-now Escape
hold-model-preview false
wait-log 'Computing preview cancelled after ' 30
expect-log 'Command Box cancelled' 30
command solid.sphere
expect-log 'Command Sphere started'
key Escape
expect-log 'Command Sphere cancelled' 30
expect-model-bodies 1 12000
expect-undo-depth ${committed_depth} 0
expect-no-log 'Edited F1|Body .*volume .* -> 99000\.000 mm3'

# An external Open while a preview owns the model cancels the edit before the save
# question reads the document. Cancelling that question keeps the current
# file, its earlier committed dimensions and its history.
mark
dblclick-logged '^Timeline Box1 at'
expect-log 'Editing F1 with Box'
wait-idle 30
mark
hold-model-preview true
qt-type-now input_height '16 mm'
wait-log 'Computing preview started' 30
expect-model-busy true
open-file-now '${MITCAD_TEST_WORK}/root-design.mitcad'
focus-dialog '^MitCad$|^Save changes'
button '^Cancel$'
hold-model-preview false
focus-main
expect-log 'Command Box cancelled' 30
expect-model-bodies 1 12000
expect-undo-depth ${committed_depth} 0

# Exit requests Quit through the document-window manager, which cancels
# the busy edit and restores the marker before asking about the earlier
# unsaved change. Cancel that Quit/save question, retain the live document with
# its prior body/undo history, and verify another command still works.
mark
dblclick-logged '^Timeline Box1 at'
expect-log 'Editing F1 with Box'
wait-idle 30
mark
hold-model-preview true
qt-type-now input_height '15 mm'
wait-log 'Computing preview started' 30
expect-model-busy true
menu-now 'File/Exit'
wait-log 'Computing preview: cancel requested after ' 30
wait-log 'Computing preview cancelled after ' 30
focus-dialog '^MitCad$|^Save changes'
button '^Cancel$'
hold-model-preview false
focus-main
expect-log 'Command Box cancelled' 30
expect-model-bodies 1 12000
expect-undo-depth ${committed_depth} 0
command solid.sphere
expect-log 'Command Sphere started'
key Escape
expect-log 'Command Sphere cancelled' 30
expect-never 'The document was read while a job computes it|OCCT view event failed'
