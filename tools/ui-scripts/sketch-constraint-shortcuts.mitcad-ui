# SPDX-License-Identifier: MIT
# The sketch constraints' Shift keys (mitcad#1229). The wrapper replaces
# ENTER_SKETCH with the frontend's ordinary timeline activation on the
# fixture's Sketch1: two framing points at (-40, -30) and (40, 30), two
# slanted lines A (mid (-17.5, 13)) and B (mid (-17.5, -11)), a nearly
# vertical line C (mid (12, -10)) and a horizontal line D (mid (17.5, 15)).
# The clicks stay within x -30..30 mm, y -25..25 mm: the free part of the
# view after the fit also in session 0's 1024x768 window on Windows.
wait-idle
ENTER_SKETCH
expect-log '^Editing sketch F1 \(Sketch1\)'
key F6

# Two lines selected (Ctrl adds in a sketch), Shift+P: Parallel, as its
# button would, at once on the selection.
mark
sketch-click -17.5 13
expect-selection 1 0
sketch-click -17.5 -11 ctrl
expect-selection 2 0
mark
key shift+p
wait-log '^Added constraint parallel .* on \S+, \S+$'
expect-selection 0 0

# A nearly vertical line, Shift+V: Horizontal/Vertical makes it vertical.
mark
sketch-click 12 -10
expect-selection 1 0
mark
key shift+v
wait-log '^Added constraint vertical .* on \S+$'
expect-no-log '^Added constraint horizontal '

# A dimension's value field keeps the keys: Shift+P there types a capital
# P and adds no constraint; Esc puts the value back.
mark
sketch-click 17.5 15
expect-selection 1 0
mark
key d
sketch-click 17.5 22
wait-log '^Sketch value editor at '
key shift+p
expect-widget-property sketchValueEditor text P
expect-no-log '^Added constraint '
screenshot '${MITCAD_TEST_WORK}/sketch-constraint-shortcuts.png'
key Escape
key Escape
key Escape
wait-idle
expect-no-log '^Added constraint '

command sketch.finish
wait-log '^Sketch finished'
expect-never 'Recompute failed|TestDriver: FAIL'
