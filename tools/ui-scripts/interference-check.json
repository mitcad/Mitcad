[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "Interference checks' bodies (mitcad#2664, tools/ui-scripts/interference-check.mitcad-ui): four 10 x 10 x 10 mm blocks on XY. Body1 (F2.b0) at the origin; Body2 (F4.b0) 5 mm along X, raised by the parameter lift (0 mm), so that it shares 500 mm3 with Body1; Body3 (F6.b0) at x 40, apart; Body4 (F8.b0) at x 45, sharing 500 mm3 with Body3, suppressed until the script brings it in."},
  {"cmd": "add_parameter", "name": "lift", "value": "0 mm"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [5, 0], "width": 10, "height": 10},
