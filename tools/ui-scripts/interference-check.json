    "start": {"type": "offset", "offset": "lift"},
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F5", "corner": [40, 0], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
