# SPDX-License-Identifier: MIT
# Extend to Meet (mitcad#2178) on sketch-extend-to-meet.json's Sketch1
# (two framing points at (-40, -30) and (40, 30); a line from (-25, -15)
# to (-10, -15) and a line from (5, -3) to (5, -10); a short line from
# (-2, 12) to (2, 12) and an arc about (0, 4) of radius 10 from (10, 4)
# over (0, 14) to (-10, 4)):
#   1. Two lines: the first picked at (-20, -15), the pointer over the
#      second at (5, -5) previews their one result at (5, -15), and the
#      click makes it: both lines end in one point there.
#   2. A line and an arc: the line picked at (1.5, 12), the pointer over
#      the arc 20 degrees round previews the nearer of the two results,
#      (6, 12); Tab steps to the other, (-6, 12), and the click makes that
#      one.
# The wrapper replaces ENTER_SKETCH with the frontend's ordinary timeline
# activation. The clicks stay within x -25..25 mm, y -20..20 mm: the free
# part of the view after the fit also in session 0's 1024x768 window on
# Windows. Run by tools/ui-sketch-extend-to-meet-test.sh (Linux),
# tools/ui-windows-sketch-extend-to-meet-test.ps1 (Windows) and
# tools/ui-macos-sketch-extend-to-meet-test.sh (macOS).
wait-idle
ENTER_SKETCH
expect-log '^Editing sketch F1 \(Sketch1\)'
key F6
wait-idle

# 1. Two lines meeting beyond both ends.
mark
command sketch.extend_to_meet
wait-log '^Sketch tool Extend to Meet$'
mark
sketch-click -20 -15
wait-log '^Extend to Meet first c[0-9]+ at \([^)]*\)$'
sketch-move 5 -5
wait-log '^Extend to Meet preview c[0-9]+ and c[0-9]+: result 1 of 1 at \(5, -15\)$'
screenshot '${MITCAD_TEST_WORK}/sketch-extend-to-meet-lines.png'
sketch-click 5 -5
wait-log '^Extended c[0-9]+ and c[0-9]+ to meet at p[0-9]+ \(5, -15\), result 1 of 1$'
expect-no-log 'Message band: (error|warning) Extend to Meet: '
wait-idle

# 2. A line and an arc: two results, Tab to the second.
mark
sketch-click 1.5 12
wait-log '^Extend to Meet first c[0-9]+ at \([^)]*\)$'
sketch-move 9.396926 7.420201
wait-log '^Extend to Meet preview c[0-9]+ and c[0-9]+: result 1 of 2 at \(6, 12\)$'
key Tab
wait-log '^Extend to Meet Tab steps to result 2 of 2$'
wait-log '^Extend to Meet preview c[0-9]+ and c[0-9]+: result 2 of 2 at \(-6, 12\)$'
screenshot '${MITCAD_TEST_WORK}/sketch-extend-to-meet-tab.png'
sketch-click 9.396926 7.420201
wait-log '^Extended c[0-9]+ and c[0-9]+ to meet at p[0-9]+ \(-6, 12\), result 2 of 2$'
expect-no-log 'Message band: (error|warning) Extend to Meet: '
screenshot '${MITCAD_TEST_WORK}/sketch-extend-to-meet.png'
wait-idle
key Escape

command sketch.finish
wait-log '^Sketch finished'
command file.save
wait-log '^Saved '
expect-never 'Recompute failed|TestDriver: FAIL'
