[
  {"comment":"SPDX-License-Identifier: MIT"},
  {"comment":"The timeline filter's default and saved choice (mitcad#1662), tools/ui-timeline-filter-default-test.sh: Base:1 (C1) with Sketch1 (F1) and Extrude1 (F2), Pin:1 (C2) placed in Base with Sketch2 (F3), Lid:1 (C3) in the root, 50 mm along X, with Sketch3 (F4). Four features; the root is active when the design opens."},
  {"cmd": "create_component", "name": "Base"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 30, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "create_component", "name": "Pin"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [5, 5], "width": 5, "height": 5},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Lid", "transform": [[1, 0, 0, 50], [0, 1, 0, 0], [0, 0, 1, 0]]},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F4", "corner": [0, 0], "width": 30, "height": 20},
  {"cmd": "activate_component", "component": "Root"}
]
