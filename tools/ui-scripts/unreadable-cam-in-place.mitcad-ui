# SPDX-License-Identifier: MIT
# Edit in Place of a linked design whose CAM section this MitCad cannot read
# (mitcad#2587, after mitcad#2581), on holder.mitcad holding a plate of its
# own and linking part.mitcad (a 10 mm cube whose CAM has two setups with
# one id), both in one folder. Edit in Place (the browser's context menu)
# reads the part from its file, as no tab has it open; a 5 mm cube is added
# to it. An agent's save (MCP document_save) is refused and asks nothing;
# Save asks before it writes over the part's file, without Save As, and the
# runner's answer is clicked: MITCAD_TEST_ANSWER is the button (Cancel, or
# Save and Drop Them) and MITCAD_TEST_ANSWERED the word the answer logs
# (cancelled, save). The runners (tools/ui-unreadable-cam-in-place-test.sh,
# tools/ui-macos-unreadable-cam-in-place-test.sh,
# tools/ui-windows-unreadable-cam-in-place-test.ps1) check the file after
# the run: as it was byte for byte after Cancel, without its CAM after Save
# and Drop Them. All geometry is synthetic.
wait-idle
expect-model-bodies 2 9000

# Edit in Place: the part read from its file, the plate around it.
mark
context-menu-logged '^Browser Root/part:1 at ' 'Edit in Place'
wait-log '^Edit in Place C[0-9]+: part[.]mitcad read, 1 bodies of the assembly$'
wait-idle
expect-model-bodies 2 9000
expect-document-modified no

# A 5 mm cube beside the part's own.
model-command '{"cmd":"add_feature","def":{"type":"box","plane":{"type":"origin","plane":"xy"},"corner":[20,0],"length":5,"width":5,"height":5,"operation":"new_body"}}'
expect-model-bodies 3 9125
expect-document-modified yes

# An agent's save over it: refused, nothing asked, nothing written.
mark
mcp-tool document_save '{}' refused 'The CAM of part[.]mitcad could not be read'
expect-log '^MCP refused: '
expect-log '^Save drops unknown fields: .*/part[.]mitcad: cam$'
expect-no-log '^Edit in Place: saved '
expect-document-modified yes

# Save asks first; the runner's answer.
mark
command file.save
focus-dialog '^MitCad$|^The CAM of part[.]mitcad could not be read'
expect-log '^Save drops unknown fields: .*/part[.]mitcad: cam$'
button '^${MITCAD_TEST_ANSWER}$'
focus-main
expect-log '^Save drops unknown fields: ${MITCAD_TEST_ANSWERED}$'
wait-idle
quit
