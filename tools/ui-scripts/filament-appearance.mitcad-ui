# SPDX-License-Identifier: MIT
# A filament's colour is its appearance (mitcad#1055), through the real Qt
# controls; shared by tools/ui-filament-appearance-test.sh (Linux, Xvfb),
# tools/ui-windows-filament-appearance-test.ps1 and
# tools/ui-macos-filament-appearance-test.sh. The design is
# filament-appearance.json: two boxes of the default material and PLA
# Basic, which offers Bright Green (its default), Plastic - Black and
# Translucent Blue. Pictures go to ${MITCAD_TEST_WORK}.
#   1. Material ▸ PLA Basic ▸ Plastic - Black on Body1 and ▸ Translucent
#      Blue on Body2 assign the material and the appearance, one undo step
#      each; Body1's menu checks PLA Basic's submenu entry and Plastic -
#      Black in it (mitcad#1149); the root's Material ▸ PLA
#      Basic ▸ Translucent Blue sets its default material and appearance.
#   2. The Materials window (mitcad#1083): a new FDM plastic with a long
#      name shows in full in the list at the window's default size; PLA
#      Basic's Class shows FDM Plastic, fixed by its print settings
#      (mitcad#1102); General's list of its appearances, the default marked
#      in its row; Add… opens the appearance library's popover, the FDM
#      Plastic and then the General Plastic appearances first, then the
#      others by class, Plastic - Orange typed and Return adds it; a row
#      selected and Make Default; Remove; Make Default on Bright Green
#      again.
#   3. The Appearances window groups the appearances by class
#      (mitcad#1133): This design first, then Metal, General Plastic, FDM
#      Plastic (the 15 filament colours), Resin and Other with their
#      counts; a search narrows them to FDM Plastic; a click on Metal's
#      heading collapses it (remembered) and another expands it.
#   4. The Appearance tool's picker on Body1, of PLA Basic: FDM Plastic
#      first, then General Plastic, then the others by class.
wait-idle
window-resize 1280 860
focus-main
capture-undo-depth start
mark

# 1. Material ▸ material ▸ appearance. The Browser logs its rows' places
# when the window opens, before the mark: any time, not since it.
expect-ever '^Browser Root/Bodies/Body1 at '
expect-ever '^Browser Root/Bodies/Body2 at '
expect-ever '^Browser Root at '
context-menu-logged '^Browser Root/Bodies/Body1 at ' 'Material/PLA Basic/Plastic - Black'
expect-log '^Context menu Material: Steel \| PLA Basic \| More…$'
expect-log '^Context menu Material PLA Basic: Bright Green \| Plastic - Black \| Translucent Blue$'
expect-log '^Material assigned from menu: PLA Basic, Plastic - Black to 1 bodies$'
expect-undo-depth ${start} 1
wait-idle
mark
context-menu-logged '^Browser Root/Bodies/Body2 at ' 'Material/PLA Basic/Translucent Blue'
expect-log '^Material assigned from menu: PLA Basic, Translucent Blue to 1 bodies$'
expect-undo-depth ${start} 2
wait-idle
mark
context-menu-logged '^Browser Root/Bodies/Body1 at ' 'Material/PLA Basic/Plastic - Black'
# Read from the menu's actions as shown (mitcad#1149): PLA Basic's submenu
# entry itself is checked, as a plain entry would be.
expect-log '^Context menu Material checked: PLA Basic$'
expect-log '^Context menu Material PLA Basic checked: Plastic - Black$'
expect-undo-depth ${start} 2
wait-idle
mark
context-menu-logged '^Browser Root at ' 'Material/PLA Basic/Translucent Blue'
expect-log '^Material assigned from menu: PLA Basic, Translucent Blue to component Root$'
expect-undo-depth ${start} 3
wait-idle

# 2. The Materials window at its default size. A plastic with a long name:
# the list widens to show it in full ("none cut", mitcad#1083).
mark
command solid.materials
focus-dialog '^Materials$'
expect-log '^Materials list: [0-9]+ names, none cut$'
wait-idle
mark
button '^New'
expect-log '^Materials new menu: Metal \| General Plastic \| FDM Plastic \| Resin \| Wood \| Other \| Browse Material Dataset…$'
popup 'FDM Plastic'
# Then where (mitcad#1135): This design first.
expect-log '^Materials new menu: This design \| My library$'
popup 'This design'
expect-log '^Material created: .+ in design$'
expect-undo-depth ${start} 4
wait-idle
mark
focus-widget materialName
key ctrl+a
type 'Generic PLA @Printer A1 mini - high temp'
key Return
expect-log '^Material .+ \(design\) name = Generic PLA @Printer A1 mini - high temp$'
expect-log '^Materials list: [0-9]+ names, none cut$'
expect-undo-depth ${start} 5
wait-idle
screenshot-dialog '${MITCAD_TEST_WORK}/materials-list-${MITCAD_TEST_COLOR_SCHEME}.png'

# The list of PLA Basic's appearances: each row its swatch and name, the
# default marked in its row.
mark
focus-widget materialsList
key Home
type 'PLA Basic'
expect-log '^Material selected: PLA Basic \(design\)'
# Print settings make it an FDM plastic: its Class shows so, disabled
# (mitcad#1102).
expect-log '^Materials class: FDM Plastic, fixed by its print settings$'
expect-log '^Materials appearances: Bright Green \(default\) \| Plastic - Black \| Translucent Blue$'
expect-log '^Materials appearance row Plastic - Black at '
wait-idle
screenshot-dialog '${MITCAD_TEST_WORK}/materials-appearances-${MITCAD_TEST_COLOR_SCHEME}.png'
mark
button '^Add$' materialAppearanceAdd
expect-log '^Materials add appearance picker opened: [0-9]+ appearances$'
# The material's class first, then General Plastic, then the design's
# others and the library's by class (mitcad#1102, mitcad#1133): Bright
# Green is an FDM plastic's look beside the library's 15 filament colours,
# Translucent Blue the design's other.
expect-log '^Materials add appearance picker sections: FDM Plastic 16 \| General Plastic 6 \| This design 1 \| Metal 8 \| Resin 3 \| Wood 17 \| Other 11$'
focus-widget appearancePickerSearch
# Plastic - Orange, not Filament - Orange, which comes first.
type 'Plastic - Orange'
expect-log '^Materials add appearance picker search: Plastic - Orange, 1 shown$'
screenshot-dialog '${MITCAD_TEST_WORK}/appearance-picker-${MITCAD_TEST_COLOR_SCHEME}.png'
key Return
expect-log '^Materials add appearance picker chosen: Plastic - Orange \(plastic_orange\)$'
expect-log '^Material PLA Basic \(design\) appearances = bright_green, plastic_black, translucent_blue, plastic_orange$'
expect-log '^Materials appearances: Bright Green \(default\) \| Plastic - Black \| Translucent Blue \| Plastic - Orange$'
expect-undo-depth ${start} 6
focus-dialog '^Materials$'
wait-idle
mark
# Logged when Add… grew the list, before this mark.
expect-ever '^Materials appearance row Plastic - Black at '
dialog-click-logged '^Materials appearance row Plastic - Black at '
expect-log '^Materials appearance selected: Plastic - Black$'
button '^Make Default$' materialAppearanceDefault
expect-log '^Material PLA Basic \(design\) appearance = plastic_black$'
expect-log '^Materials appearances: Plastic - Black \(default\) \| Bright Green \| Translucent Blue \| Plastic - Orange$'
expect-undo-depth ${start} 7
wait-idle
mark
# Logged when Make Default reordered the rows, before this mark.
expect-ever '^Materials appearance row Plastic - Orange at '
dialog-click-logged '^Materials appearance row Plastic - Orange at '
expect-log '^Materials appearance selected: Plastic - Orange$'
button '^Remove$' materialAppearanceRemove
expect-log '^Material PLA Basic \(design\) appearances = plastic_black, bright_green, translucent_blue$'
expect-log '^Materials appearances: Plastic - Black \(default\) \| Bright Green \| Translucent Blue$'
expect-undo-depth ${start} 8
wait-idle
mark
expect-ever '^Materials appearance row Bright Green at '
dialog-click-logged '^Materials appearance row Bright Green at '
expect-log '^Materials appearance selected: Bright Green$'
button '^Make Default$' materialAppearanceDefault
expect-log '^Material PLA Basic \(design\) appearance = bright_green$'
expect-log '^Materials appearances: Bright Green \(default\) \| Plastic - Black \| Translucent Blue$'
expect-undo-depth ${start} 9
wait-idle
screenshot-dialog '${MITCAD_TEST_WORK}/materials-appearances-after-${MITCAD_TEST_COLOR_SCHEME}.png'
button '^Close$'
focus-main

# 3. The Appearances window grouped by class (mitcad#1133): the design's
# own first, then the library's under Metal, General Plastic, FDM Plastic
# (the filament colours), Resin, Wood (mitcad#1552) and Other, each
# heading with its count.
wait-idle
mark
command solid.appearances
focus-dialog '^Appearances$'
expect-log '^Appearances groups: This design [0-9]+ \| Metal 8 \| General Plastic 6 \| FDM Plastic 15 \| Resin 3 \| Wood 17 \| Other 11$'
expect-log '^Appearances group FDM Plastic: filament_white, filament_black, filament_grey, filament_silver, filament_red, filament_orange, filament_yellow, filament_green, filament_blue, filament_light_blue, filament_purple, filament_pink, filament_brown, filament_beige, filament_translucent$'
expect-log '^Appearances group design at '
expect-log '^Appearances group metal at '
wait-idle
screenshot-dialog '${MITCAD_TEST_WORK}/appearances-groups-${MITCAD_TEST_COLOR_SCHEME}.png'
# The search narrows the groups: only FDM Plastic has a match.
mark
focus-widget appearanceSearch
type 'filament'
expect-log '^Appearances filtered "filament" \(All Categories\): 15 shown$'
expect-log '^Appearances groups shown: FDM Plastic 15$'
wait-idle
screenshot-dialog '${MITCAD_TEST_WORK}/appearances-search-${MITCAD_TEST_COLOR_SCHEME}.png'
# Cleared, every group again; Metal's heading collapses its group, which
# is remembered, and expands it again.
mark
key ctrl+a
key Delete
expect-log '^Appearances group metal at '
wait-idle
mark
dialog-click-logged '^Appearances group metal at '
expect-log '^Appearances group Metal collapsed$'
expect-setting appearances/collapsedGroups metal
wait-idle
mark
dialog-click-logged '^Appearances group metal at '
expect-log '^Appearances group Metal expanded$'
wait-idle
button '^Close$' appearanceClose
focus-main

# 4. The Appearance tool's picker on Body1, of PLA Basic (an FDM plastic,
# mitcad#1133): FDM Plastic first (Bright Green and the filament colours),
# then General Plastic, then the design's other and the library's others
# by class.
wait-idle
mark
click-logged '^Browser Root/Bodies/Body1 at '
expect-log '^Browser selected: Root/Bodies/Body1$'
command solid.appearance
expect-log '^Panel Appearance input value at '
wait-idle
mark
click-logged '^Panel Appearance input value at '
expect-log '^Appearance picker sections: FDM Plastic 16 \| General Plastic 6 \| This design [0-9]+ \| Metal 8 \| Resin 3 \| Wood 17 \| Other 11$'
expect-log '^Appearance picker opened: '
focus-dialog '^Appearance Picker$'
wait-idle
screenshot-dialog '${MITCAD_TEST_WORK}/appearance-tool-picker-${MITCAD_TEST_COLOR_SCHEME}.png'
key Escape
focus-main
key Escape
wait-idle
