# SPDX-License-Identifier: MIT
# The AppKit frontend, by Settings' native macOS interface or --ui=native
# (mitcad#1056, tools/ui-macos-native-frontend-test.sh): it starts with the
# design open, and the script's end quits it.
expect-ever 'Native UI: AppKit shell with embedded OCCT viewport'
expect-ever '^Frontend: native \((preference|--ui)\)$'
wait-idle
expect-model-bodies 1 48000
# Assistant connection states keep their native menu presentation. These
# real enabled leaves toggle the underlying row; other menus' tab hints
# are covered by the unchanged bindings-parity workflow.
set-setting assistant/rows claude-code
set-setting assistant/blocked claude-code
mark
native-popup native.agentMenu 'Claude Code — blocked'
expect-log '^Agent indicator: Claude Code allowed$'
mark
native-popup native.agentMenu 'Claude Code — not connected'
expect-log '^Agent indicator: Claude Code blocked$'
expect-setting assistant/blocked claude-code
