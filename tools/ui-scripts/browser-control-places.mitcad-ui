# SPDX-License-Identifier: MIT
# The Browser rows' Activate radio button and Show eye places (mitcad#2223,
# GitHub mitcad/Mitcad#508) in the Floating layout, on the design of
# tools/ui-scripts/browser-control-places.json: a body in the root, Frame:1
# with a body and Pin:1 placed in it (Frame:1/Pin:1, a level deeper), and a
# component with a long name placed in the root; the root active.
#   0. The defaults (Classic, Rows background): the radio button right after
#      each name, so at another x on each row (Frame:1's right of the
#      root's, the long name's far right of Frame:1's); no right edge logged.
#   1. Preferences › Display › Browser Activate button: Right. Every radio
#      button's centre has the same x (within 1 px), just inside the visible
#      right edge; the long name is elided before it. A click on Pin:1's
#      radio button activates Pin, the root's activates the root.
#   2. Browser Show eye: Right too. Every eye's centre has the same x, left
#      of the radio buttons, the names before them; a click on Pin:1's eye
#      hides it, another shows it.
#   3. The Card background: the same columns at the card's right edge; a
#      click on Frame:1's radio button activates Frame.
#   4. Restore Defaults › Current Group (Display): both Classic again, saved,
#      and the rows as at the start.
# Preferences is a dialog on Windows and Linux (applied with OK) and the
# Settings window on macOS (applied as it changes).
# Run by tools/ui-browser-control-places-test.sh (Linux),
# tools/ui-windows-browser-control-places-test.ps1 (Windows) and
# tools/ui-macos-browser-control-places-test.sh (macOS); the Docked layout's
# steps are browser-control-places-docked.mitcad-ui.
expect-ever 'View area'
wait-idle
window-resize 1260 860
wait-idle
sleep 300

# 0. The defaults: Classic, the radio buttons after the names.
expect-ever '^Browser background: rows$'
expect-ever '^Browser controls: activate classic, eye classic$'
expect-ever '^Browser radio Root/Frame:1/Pin:1 at ' 30
expect-never '^Browser right edge at '
capture rootRadio '^Browser radio Root at (-?[0-9]+),'
capture frameRadio '^Browser radio Root/Frame:1 at (-?[0-9]+),'
capture pinRadio '^Browser radio Root/Frame:1/Pin:1 at (-?[0-9]+),'
expect-less ${rootRadio} ${frameRadio}
capture pinName '^Browser Root/Frame:1/Pin:1 at (-?[0-9]+),'
capture longRadio '^Browser radio Root/Bracket-for-the-left-side-motor-unit-with-the-mounting-plate-and-cover:1 at (-?[0-9]+),'
expect-less ${pinName} ${pinRadio}
expect-less ${frameRadio} ${longRadio}

# 1. Activate on the right.
mark
command tools.preferences.display
focus-dialog '^(Preferences|Settings)$'
expect-widget-property browserActivatePlace currentIndex 0
expect-widget-property browserEyePlace currentIndex 0
qt-choice browserActivatePlace 'Right'
key Return
wait-log '^Preferences: browser activate button right$'
focus-main
expect-setting browser/activateButtonPlace right
wait-log '^Browser controls: activate right, eye classic$'
wait-idle
sleep 500
capture edge '^Browser right edge at (-?[0-9]+),'
capture rootRadio '^Browser radio Root at (-?[0-9]+),'
capture frameRadio '^Browser radio Root/Frame:1 at (-?[0-9]+),'
capture pinRadio '^Browser radio Root/Frame:1/Pin:1 at (-?[0-9]+),'
capture longRadio '^Browser radio Root/Bracket-for-the-left-side-motor-unit-with-the-mounting-plate-and-cover:1 at (-?[0-9]+),'
capture longName '^Browser Root/Bracket-for-the-left-side-motor-unit-with-the-mounting-plate-and-cover:1 at (-?[0-9]+),'
expect-near ${frameRadio} ${rootRadio} 0 1
expect-near ${pinRadio} ${rootRadio} 0 1
expect-near ${longRadio} ${rootRadio} 0 1
expect-less ${rootRadio} ${edge}
expect-near ${rootRadio} ${edge} 0 24
expect-less ${longName} ${longRadio}
expect-log '^Browser name elided Root/Bracket-for-the-left-side-motor-unit-with-the-mounting-plate-and-cover:1: '
# A click on the radio buttons in the column activates their components.
mark
click-logged '^Browser radio Root/Frame:1/Pin:1 at '
wait-log '^Activated Pin$'
wait-idle
mark
click-logged '^Browser radio Root at '
wait-log '^Activated Root$'
wait-idle

# 2. The eye on the right too, left of the radio buttons.
mark
command tools.preferences.display
focus-dialog '^(Preferences|Settings)$'
expect-widget-property browserActivatePlace currentIndex 1
qt-choice browserEyePlace 'Right'
key Return
wait-log '^Preferences: browser show eye right$'
focus-main
expect-setting browser/showEyePlace right
wait-log '^Browser controls: activate right, eye right$'
wait-idle
sleep 500
capture rootRadio '^Browser radio Root at (-?[0-9]+),'
capture frameRadio '^Browser radio Root/Frame:1 at (-?[0-9]+),'
capture frameEye '^Browser eye Root/Frame:1 at (-?[0-9]+),'
capture pinEye '^Browser eye Root/Frame:1/Pin:1 at (-?[0-9]+),'
capture bodyEye '^Browser eye Root/Bodies/[^ ]+ at (-?[0-9]+),'
capture longEye '^Browser eye Root/Bracket-for-the-left-side-motor-unit-with-the-mounting-plate-and-cover:1 at (-?[0-9]+),'
capture frameName '^Browser Root/Frame:1 at (-?[0-9]+),'
capture longName '^Browser Root/Bracket-for-the-left-side-motor-unit-with-the-mounting-plate-and-cover:1 at (-?[0-9]+),'
expect-near ${frameRadio} ${rootRadio} 0 1
expect-near ${pinEye} ${frameEye} 0 1
expect-near ${bodyEye} ${frameEye} 0 1
expect-near ${longEye} ${frameEye} 0 1
expect-less ${frameEye} ${frameRadio}
expect-less ${frameName} ${frameEye}
expect-less ${longName} ${longEye}
expect-log '^Browser name elided Root/Bracket-for-the-left-side-motor-unit-with-the-mounting-plate-and-cover:1: '
# A click on an eye in the column hides its row, another shows it.
mark
click-logged '^Browser eye Root/Frame:1/Pin:1 at '
wait-log '^Visibility Root/Frame:1/Pin:1: hidden$'
wait-idle
mark
click-logged '^Browser eye Root/Frame:1/Pin:1 at '
wait-log '^Visibility Root/Frame:1/Pin:1: shown$'
wait-idle

# 3. The Card background: the columns at the card's right edge.
mark
command tools.preferences.display
focus-dialog '^(Preferences|Settings)$'
qt-choice browserBackground 'Card'
key Return
wait-log '^Preferences: browser background card$'
focus-main
wait-log '^Browser background: card$'
wait-idle
sleep 500
capture edge '^Browser right edge at (-?[0-9]+),'
capture rootRadio '^Browser radio Root at (-?[0-9]+),'
capture frameRadio '^Browser radio Root/Frame:1 at (-?[0-9]+),'
capture pinRadio '^Browser radio Root/Frame:1/Pin:1 at (-?[0-9]+),'
capture frameEye '^Browser eye Root/Frame:1 at (-?[0-9]+),'
capture pinEye '^Browser eye Root/Frame:1/Pin:1 at (-?[0-9]+),'
capture bodyEye '^Browser eye Root/Bodies/[^ ]+ at (-?[0-9]+),'
expect-near ${frameRadio} ${rootRadio} 0 1
expect-near ${pinRadio} ${rootRadio} 0 1
expect-less ${rootRadio} ${edge}
expect-near ${rootRadio} ${edge} 0 24
expect-near ${pinEye} ${frameEye} 0 1
expect-near ${bodyEye} ${frameEye} 0 1
expect-less ${frameEye} ${frameRadio}
mark
click-logged '^Browser radio Root/Frame:1 at '
wait-log '^Activated Frame$'
wait-idle
mark
click-logged '^Browser radio Root at '
wait-log '^Activated Root$'
wait-idle

# 4. Restore Defaults on Display: both Classic again.
mark
command tools.preferences.display
focus-dialog '^(Preferences|Settings)$'
button '^Restore Defaults$' preferencesRestoreDefaults
popup 'Current Group (Display)'
wait-log '^Preferences restore defaults asked: Restore the defaults of the Display settings[?]'
focus-dialog '^(Restore Defaults|Restore the defaults of (the Display|all) settings[?])$'
button '^Restore Defaults$'
wait-log '^Preferences: restore defaults, current group: display$'
focus-dialog '^(Preferences|Settings)$'
wait-idle
expect-widget-property browserActivatePlace currentIndex 0
expect-widget-property browserEyePlace currentIndex 0
expect-setting browser/activateButtonPlace classic
expect-setting browser/showEyePlace classic
key Escape
focus-main
wait-log '^Browser controls: activate classic, eye classic$'
wait-idle
sleep 500
capture rootRadio '^Browser radio Root at (-?[0-9]+),'
capture frameRadio '^Browser radio Root/Frame:1 at (-?[0-9]+),'
capture pinRadio '^Browser radio Root/Frame:1/Pin:1 at (-?[0-9]+),'
expect-less ${rootRadio} ${frameRadio}
capture pinName '^Browser Root/Frame:1/Pin:1 at (-?[0-9]+),'
capture longRadio '^Browser radio Root/Bracket-for-the-left-side-motor-unit-with-the-mounting-plate-and-cover:1 at (-?[0-9]+),'
expect-less ${pinName} ${pinRadio}
expect-less ${frameRadio} ${longRadio}
expect-never 'Recompute failed|TestDriver: FAIL'
