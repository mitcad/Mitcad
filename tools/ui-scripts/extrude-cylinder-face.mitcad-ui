# SPDX-License-Identifier: MIT
# Extrude of a sketch on a cylinder's side with the automatic operation
# (mitcad#1908, GitHub mitcad/Mitcad#362) on extrude-cylinder-face.json
# (Component1:1, O1: a cylinder of radius 150, F2.b0, and Sketch2, F3, on
# its side: a 60 x 30 rectangle from (-100, 40) and a circle of diameter 40
# about (40, 60) in the face's developed coordinates):
#   1. Extrude takes the rectangle and the circle. Their highlights lie on
#      the cylinder's side: the rectangle's middle at (131.3, -66.1, 55),
#      where the region flat on the face's carrier plane x = 150 had it at
#      (150, -70, 55). The distance arrow starts on the face at the
#      profiles' middle (147.96, -24.66, 57.06) and points along the face's
#      normal there, not from the carrier plane.
#   2. The New Body preview touches the cylinder: the automatic operation
#      turns Join with the cylinder as Local bodies, and that Join builds
#      (it was refused for its cut targets).
#   3. OK adds the Join: one body, the cylinder and the profiles raised by
#      the 10 typed in 1. (a new Extrude starts at 0, mitcad#2481):
#      22500 pi 129 + (1800 + 400 pi) 10 (1 + 10 / 300).
# Run by tools/ui-extrude-cylinder-face-test.sh (Linux),
# tools/ui-windows-extrude-cylinder-face-test.ps1 (Windows) and
# tools/ui-macos-extrude-cylinder-face-test.sh (macOS), with
# MITCAD_LOG_PICKS=1 for the highlights' places.
expect-ever 'View area'
wait-idle
command view.fit
wait-idle

# 1. The two profiles, highlighted on the face.
mark
command solid.extrude
expect-log '^Command Extrude started'
wait-idle
# Extrude may preselect a profile: cleared, so that the clicks add these.
mark
button '.*' clear_profiles
wait-log '^Extrude Profiles: nothing$'
wait-log '^Pick profile F3/r\{c1\[' 20
wait-log '^Pick profile F3/r\{c9\}' 20
click-pick 'profile F3/r\{c1\['
wait-log '^Extrude Profiles: 1 profile \[profile r\{c1\['
click-pick 'profile F3/r\{c9\}'
wait-log '^Extrude Profiles: 2 profiles '
# A new Extrude starts at 0 mm (mitcad#2481): 10 mm typed.
type-in '^Panel Extrude input distance at ' '10 mm'
wait-log '^View highlight places: .*profile F3/r\{c1\[c4,c2\],c2\[c1,c3\],c3\[c2,c4\],c4\[c3,c1\]\} in O1 at 13[01]\.[0-9],-66\.[0-9],55\.0' 30
wait-log '^Handle world Extrude distance: origin 147\.[89][0-9]*,-2[45]\.[0-9]*,5[67]\.[0-9]*, knob ' 30
wait-log '^Arrow direction Extrude distance: 0\.98[0-9],-0\.16[0-9],-?0\.000$' 30

# 2. The automatic Join, chosen by the first preview once 10 mm is typed.
# Since the start all the same (CommandSession::takeAutoOperation logs a
# change, not a repeated choice), and OK below shows the Join builds.
expect-ever '^Extrude: automatic Operation = Join' 30
expect-ever '^Extrude Local bodies: 1 body \[body F2\.b0 in O1\]' 30
wait-idle
expect-never 'Preview Extrude: failed'
screenshot '${MITCAD_TEST_WORK}/extrude-cylinder-face.png'

# 3. OK.
mark
button '^OK$'
wait-log '^Added extrude \(Join\)' 30
wait-idle
expect-model-bodies 1 9150057.926679213
expect-never 'Preview Extrude: failed|Recompute failed|TestDriver: FAIL'
