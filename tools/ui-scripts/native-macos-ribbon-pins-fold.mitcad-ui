# check-all sources: app/framework/Ribbon.cpp app/framework/RibbonFit.cpp app/platform/macos/NativeMacWindow.mm
# check-all sources: app/platform/NativeMacWindow.hpp app/MainWindowNative.cpp
# The AppKit ribbon in a narrow window (mitcad#1357, after the Qt
# ribbon's mitcad#1111): Sweep pinned into Create from its menu's Pin to
# Toolbar submenu, then the window narrowed in steps of 8 points (the
# in-process native resize, no system input) down to its narrowest. The
# groups on the right collapse first; Sweep's pinned button folds before
# Create collapses (tools/ui-macos-native-ribbon-pins-fold-test.sh reads
# the order from the log); wide again, it is back.
expect-ever 'Native UI: AppKit shell with embedded OCCT viewport'
sleep 800
native-resize 1400 820
expect-native-visible native.ribbon.solid.extrude true
mark
native-popup native.ribbon.group.create 'Pin to Toolbar/Sweep'
expect-log 'Pinned to toolbar: Sweep \(Solid\)'
expect-log 'Ribbon group SOLID/CREATE pinned: solid\.sweep$'
expect-native-visible native.ribbon.pinned.solid.sweep true
expect-native-visible native.ribbon.solid.extrude true
expect-native-layout
mark
native-resize 1392 820
native-resize 1384 820
native-resize 1376 820
native-resize 1368 820
native-resize 1360 820
native-resize 1352 820
native-resize 1344 820
native-resize 1336 820
native-resize 1328 820
native-resize 1320 820
native-resize 1312 820
native-resize 1304 820
native-resize 1296 820
native-resize 1288 820
native-resize 1280 820
native-resize 1272 820
