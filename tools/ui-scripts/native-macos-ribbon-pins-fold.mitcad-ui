native-resize 820 820
# At its narrowest Sweep's button is out of the row (folded, or Create
# collapsed with it).
expect-native-visible native.ribbon.pinned.solid.sweep false
expect-native-layout
screenshot '${MITCAD_TEST_WORK}/ribbon-pins-fold-narrow.png'
mark
native-resize 1400 820
expect-log '^Ribbon pinned folded SOLID/CREATE: none$'
expect-native-visible native.ribbon.pinned.solid.sweep true
expect-native-visible native.ribbon.solid.extrude true
expect-native-layout
screenshot '${MITCAD_TEST_WORK}/ribbon-pins-fold-wide.png'
