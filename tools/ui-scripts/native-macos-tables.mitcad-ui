# SPDX-License-Identifier: MIT
# Native AppKit tables (mitcad#814), run once per appearance by
# tools/ui-macos-native-tables-test.sh: the demo block's (60 x 40 x 20 mm)
# Parameters with an invalid unit committed by Return and by Tab, Escape,
# F2, a correction, section rows, read-only cells and the shared column
# sizes at normal and narrow sizes; then the Libraries table's long
# synthetic library name and path. Cell identifiers: parameter.<name>.<column>.
expect-ever 'Native UI: AppKit shell with embedded OCCT viewport'
sleep 800
native-appearance '${MITCAD_TABLES_SCHEME}'
wait-idle
expect-model-bodies 1 48000
show-dialog-style-fixture setup

# The shared dialog's size: every column at its shared width, Comment
# stretching into the rest. Section rows are bold, values read-only.
mark
native-action solid.parameters
expect-log 'Parameters dialog opened'
focus-dialog '^Parameters$'
native-dialog-size 1240 520
expect-native-columns parametersTable fit
expect-native-style parameters.group.users bold,readonly,single-line
expect-native-style parameters.group.models bold,readonly,single-line
expect-native-style parameters.group.Sketch1 bold
expect-native-style parameters.group.Extrude1 bold
expect-native-style parameter.d3.0 regular,editable,single-line,normal
expect-native-style parameter.d3.1 readonly
expect-native-style parameter.d3.2 editable,normal,single-line
expect-native-style parameter.d3.3 readonly,regular
expect-native-text parameter.d3.2 '^20 mm$'
expect-native-text parameter.d3.3 '^20 mm$'
screenshot-dialog '${MITCAD_TEST_WORK}/parameters-normal-${MITCAD_TABLES_SCHEME}.png'

# Return in the cell editor commits the invalid unit: the model refuses it
# and keeps 20 mm, Parameters stays open with the red cell and reason.
mark
native-click parameter.d3.2
expect-native-style parameter.d3.2 editing
key Ctrl+a
type '30 deg'
key Return
expect-log '^Parameter d3 expression: 30 deg refused:'
wait-idle
focus-dialog '^Parameters$' 2
expect-native-visible parametersTable true
expect-native-style parameter.d3.2 not-editing
expect-native-text parameter.d3.2 '^30 deg$'
expect-native-text parameter.d3.3 '^20 mm$'
expect-model-bodies 1 48000
expect-native-text parametersMessage '^d3: .*expected length'
expect-native-style parametersMessage error
native-select parameter.d1.0
expect-native-style parameter.d3.2 error,single-line
screenshot-dialog '${MITCAD_TEST_WORK}/parameters-return-${MITCAD_TABLES_SCHEME}.png'

# Tab commits as well and edits the next editable cell, Comment, whose edit
# stays across the refusal's model refresh; Escape leaves it. The dialog stays.
mark
native-click parameter.d3.2
key Ctrl+a
type '45 deg'
key Tab
expect-log '^Parameter d3 expression: 45 deg refused:'
wait-idle
focus-dialog '^Parameters$' 2
expect-native-visible parametersTable true
expect-native-text parameter.d3.2 '^45 deg$'
expect-native-text parameter.d3.3 '^20 mm$'
expect-model-bodies 1 48000
expect-native-text parametersMessage '^d3: .*expected length'
expect-native-style parametersMessage error
expect-native-style parameter.d3.4 editing
key Escape
expect-native-style parameter.d3.4 not-editing
expect-native-visible parametersTable true
native-select parameter.d1.0
expect-native-style parameter.d3.2 error,not-editing
screenshot-dialog '${MITCAD_TEST_WORK}/parameters-tab-${MITCAD_TABLES_SCHEME}.png'

# Escape discards an edit without closing Parameters.
mark
native-click parameter.d3.2
key Ctrl+a
type '99 mm'
key Escape
expect-native-style parameter.d3.2 not-editing
expect-native-text parameter.d3.2 '^45 deg$'
wait-idle
expect-native-visible parametersTable true
expect-model-bodies 1 48000
# The pattern keeps its echo in the log from matching the shell's whole-log check.
expect-no-log '^Parameter d3 expression: 99[ ]mm'

# A correction succeeds and clears the refusal.
mark
native-click parameter.d3.2
key Ctrl+a
type '25 mm'
key Return
expect-log '^Parameter d3 expression: 25 mm = '
wait-idle
focus-dialog '^Parameters$' 2
expect-native-visible parametersTable true
expect-native-text parameter.d3.2 '^25 mm$'
expect-native-text parameter.d3.3 '^25 mm$'
expect-model-bodies 1 60000
expect-native-text parametersMessage '^$'
native-select parameter.d1.0
expect-native-style parameter.d3.2 normal,not-editing

# F2 edits the current cell from the keyboard; Escape leaves it unchanged.
native-select parameter.d1.0
key F2
expect-native-style parameter.d1.0 editing
key Escape
expect-native-style parameter.d1.0 not-editing
expect-native-text parameter.d1.0 '^d1$'
expect-native-visible parametersTable true

# Narrow: the fixed columns keep their widths, Comment its minimum, and the
# table scrolls; a cell at the far right scrolls into view for editing.
native-dialog-size 720 380
expect-native-columns parametersTable scroll
native-click parameter.d3.8
expect-native-style parameter.d3.8 editing,in-view
key Escape
expect-native-style parameter.d3.8 not-editing
expect-native-visible parametersTable true
screenshot-dialog '${MITCAD_TEST_WORK}/parameters-narrow-${MITCAD_TABLES_SCHEME}.png'
native-dialog-size 1240 520
expect-native-columns parametersTable fit
button '^OK$'
expect-native-dialog-gone '^Parameters$'
focus-main
expect-model-bodies 1 60000

# Libraries: the long source path and library name stay on one line each,
# elided where the column is narrower, at normal and narrow sizes.
mark
command tools.libraries
focus-dialog '^Library Sources$'
expect-log 'Library source .*: Synthetic fasteners with a deliberately long library name for elision checks \(mitcad-parts\)'
expect-native-style librarySources/0/2 single-line,truncated,readonly
expect-native-style librarySources/0/3 single-line,readonly
expect-native-style librarySources/1/2 single-line,truncated
expect-native-style librarySources/1/3 single-line
expect-native-columns librarySources any
screenshot-dialog '${MITCAD_TEST_WORK}/libraries-normal-${MITCAD_TABLES_SCHEME}.png'
native-dialog-size 640 400
expect-native-columns librarySources scroll
expect-native-style librarySources/0/2 single-line
expect-native-style librarySources/0/3 single-line
screenshot-dialog '${MITCAD_TEST_WORK}/libraries-narrow-${MITCAD_TABLES_SCHEME}.png'
button '^Close$'
expect-native-dialog-gone '^Library Sources$'
focus-main
