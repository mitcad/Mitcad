# SPDX-License-Identifier: MIT
# Conic Curve and Edit Rho (mitcad#2236) on sketch-conic.json's Sketch1
# (two framing points at (-40, -30) and (40, 30), nothing else):
#   1. Conic Curve: a click at the start (-20, -10), Rho 0.7 typed in its
#      field, a click at the end (20, -10) and one at the shoulder (3, 15):
#      the conic is made with Rho 0.7, as the sketch query says (the
#      sixth entity: two framing points, the conic's three, the conic).
#   2. A right-click on the conic's middle, 0.7 of the way from the
#      chord's middle (0, -10) to the shoulder, (2.1, 7.5): Edit Rho opens
#      with 0.7, 0.3 is typed and OK changes it, one undo step.
# The wrapper replaces ENTER_SKETCH with the frontend's ordinary timeline
# activation. The clicks stay within x -25..25 mm, y -20..20 mm: the free
# part of the view after the fit also in session 0's 1024x768 window on
# Windows, and off the sketch's axes. Run by tools/ui-sketch-conic-test.sh
# (Linux), tools/ui-windows-sketch-conic-test.ps1 (Windows) and
# tools/ui-macos-sketch-conic-test.sh (macOS).
wait-idle
ENTER_SKETCH
expect-log '^Editing sketch F1 \(Sketch1\)'
key F6
wait-idle
capture-undo-depth before

# 1. Three clicks, Rho 0.7 typed in the tool's field.
mark
command sketch.conic
wait-log '^Sketch tool Conic Curve$'
sketch-click -20 -10
key Tab
type 0.7
sketch-click 20 -10
sketch-move 3 15
screenshot '${MITCAD_TEST_WORK}/sketch-conic-preview.png'
mark
sketch-click 3 15
wait-log '^Added conic c[0-9]+, Rho 0[.]7$'
expect-no-log 'Message band: (error|warning) Conic Curve'
wait-idle
key Escape
expect-undo-depth ${before} 1
capture-model-number rho '{"query":"sketch","uid":"F1"}' entities.5.rho
expect-near ${rho} 0.7

# 2. Edit Rho from the conic's right-click menu.
mark
sketch-click 2.1 7.5 right
wait-log '^Context menu: '
expect-log '^Context menu: .*Edit Rho'
popup 'Edit Rho'
wait-log '^Command Edit Rho started'
expect-input-text rho '^0[.]7$'
wait-idle
mark
type-in '^Panel Edit Rho input rho at ' '0.3'
wait-idle
mark
button '^OK$'
wait-log '^Edited conic c[0-9]+: Rho 0[.]3'
wait-idle
expect-undo-depth ${before} 2
capture-model-number rho2 '{"query":"sketch","uid":"F1"}' entities.5.rho
expect-near ${rho2} 0.3
screenshot '${MITCAD_TEST_WORK}/sketch-conic.png'

command sketch.finish
wait-log '^Sketch finished'
command file.save
wait-log '^Saved '
expect-never 'Recompute failed|TestDriver: FAIL'
