[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "The Bill of Materials' Kind and BOM Structure and the Sheet Metal list (mitcad#1980, mitcad#1985), tools/ui-bom-kinds-test.sh: Bracket (C1) a 40 x 20 sheet Face 1 mm thick (rules F1, sketch F2, Face F3, body F3.b0); Plate (C2, placed twice) a 30 x 10 sheet Face (rules F4, sketch F5, Face F6, body F6.b0); Block (C3) a plain 10 mm box (sketch F7, extrude F8). No bends, no materials."},
  {"cmd": "create_component", "name": "Bracket"},
  {"cmd": "add_feature", "def": {"type": "sheet_rules", "thickness": 1, "bend_radius": 1,
    "allowance": {"type": "k_factor", "k": 0.44}, "reference_side": "front",
    "bend_relief": {"type": "round", "width": 1, "depth": 2},
    "corner_relief": {"type": "round", "width": 1, "depth": 2}}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F2", "corner": [0, 0], "width": 40, "height": 20},
  {"cmd": "add_feature", "def": {"type": "sheet_face", "rules": "F1",
    "profiles": [{"sketch": "F2", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}]}},
  {"expect": {"feature": "F3", "status": "ok", "body": "F3.b0"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Plate", "transform": [[1, 0, 0, 60], [0, 1, 0, 0], [0, 0, 1, 0]]},
  {"cmd": "add_feature", "def": {"type": "sheet_rules", "thickness": 1, "bend_radius": 1,
    "allowance": {"type": "k_factor", "k": 0.44}, "reference_side": "front",
    "bend_relief": {"type": "round", "width": 1, "depth": 2},
    "corner_relief": {"type": "round", "width": 1, "depth": 2}}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F5", "corner": [0, 0], "width": 30, "height": 10},
  {"cmd": "add_feature", "def": {"type": "sheet_face", "rules": "F4",
    "profiles": [{"sketch": "F5", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}]}},
  {"expect": {"feature": "F6", "status": "ok", "body": "F6.b0"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "copy_occurrence", "occurrence": "O2", "transform": [[1, 0, 0, 60], [0, 1, 0, 20], [0, 0, 1, 0]]},
  {"cmd": "create_component", "name": "Block", "transform": [[1, 0, 0, 120], [0, 1, 0, 0], [0, 0, 1, 0]]},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F7", "corner": [0, 0], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F7", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"expect": {"bodies": 3}}
]
