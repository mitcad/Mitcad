# SPDX-License-Identifier: MIT
# Convert to Sheet Metal by triangulation (mitcad#2442; app/COMMANDS.md
# "Convert to Sheet Metal"), on sheet-convert-triangulated.json (rules F1,
# the shelled rectangle-to-round transition F5.b0, both ends open):
#   1. Convert to Sheet Metal seen from above: one outer face picked into
#      Face; Development Approximate shows Further Faces and Triangles;
#      the other outer faces picked into Further Faces (the loft splits
#      one side in two where the circle has a vertex: both pieces): the
#      preview is ok.
#   2. Triangles 96, OK: the conversion F7 by triangulation; the body is
#      as it was (its volume kept); its Flat Pattern says it is
#      approximate, in about 96 triangles, its lengths within 1 mm.
#   3. Edited from the timeline it loads Approximate; 24 triangles, OK:
#      the pattern's stated deviation grows.
# Run by tools/ui-sheet-convert-triangulated-test.sh (Linux),
# tools/ui-windows-sheet-convert-triangulated-test.ps1 (Windows) and
# tools/ui-macos-sheet-convert-triangulated-test.sh (macOS).
expect-ever 'View area'
wait-idle
key F6
wait-idle
capture-model-number before '{"query":"properties"}' total.volume

# 1. The faces, seen from above (the transition widens downwards).
mark
command sheet.convert
wait-log '^Pick places:' 30
wait-idle
expect-choice-text rules '^SheetRules1'
expect-choice-text development '^Exact$'
mark
command view.top
wait-idle
command view.fit
wait-idle
wait-log '^Pick places:' 30
mark
click-pick 'face F5[.]b0/F5:side[(]c1[[]c4,c2[]][)] at'
wait-idle
mark
qt-choice input_development 'Approximate'
wait-idle
expect-choice-text development '^Approximate$'
mark
click-logged '^Panel Convert to Sheet Metal input faces at '
wait-log '^Pick places:' 30
wait-idle
mark
click-pick 'face F5[.]b0/F5:side[(]c2[[]c1,c3[]][)]#0 at'
wait-idle
mark
click-pick 'face F5[.]b0/F5:side[(]c2[[]c1,c3[]][)]#1 at'
wait-idle
mark
click-pick 'face F5[.]b0/F5:side[(]c3[[]c2,c4[]][)] at'
wait-idle
mark
click-pick 'face F5[.]b0/F5:side[(]c4[[]c3,c1[]][)] at'
wait-log '^Preview Convert to Sheet Metal: ok' 120
wait-idle

# 2. 96 triangles, OK.
mark
type-in '^Panel Convert to Sheet Metal input triangles at ' '96'
wait-log '^Preview Convert to Sheet Metal: ok' 120
wait-idle
mark
button '^OK$'
wait-log '^Converted to sheet metal by triangulation: 5 face[(]s[)], 96 triangles$' 120
wait-log '^Added Convert to Sheet Metal as F7$' 120
wait-idle
expect-never 'Failed features: [^n]'
capture-model-number after '{"query":"properties"}' total.volume
expect-near ${after} ${before}
model-command '{"cmd":"set_flat_pattern","body":"F5.b0"}'
wait-idle
capture-model-number fine '{"query":"flat_pattern","body":"F5.b0"}' approximation.triangles
expect-less 80 ${fine}
expect-less ${fine} 112
capture-model-number close '{"query":"flat_pattern","body":"F5.b0"}' approximation.edges
expect-less ${close} 1

# 3. Edited: Approximate loaded; fewer triangles, further from the faces.
mark
dblclick-logged '^Timeline SheetConvert1 at '
wait-log '^Editing F7 with Convert to Sheet Metal$' 30
wait-log '^Preview Convert to Sheet Metal: ok' 120
wait-idle
expect-choice-text development '^Approximate$'
mark
type-in '^Panel Convert to Sheet Metal input triangles at ' '24'
wait-log '^Preview Convert to Sheet Metal: ok' 120
wait-idle
mark
button '^OK$'
wait-log '^Edited F7$' 120
wait-idle
expect-never 'Failed features: [^n]'
capture-model-number coarse '{"query":"flat_pattern","body":"F5.b0"}' approximation.edges
expect-less ${close} ${coarse}
