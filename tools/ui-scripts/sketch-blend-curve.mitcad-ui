# SPDX-License-Identifier: MIT
# Blend Curve (mitcad#2107) on sketch-blend-curve.json's Sketch1 (two fixed
# framing points at (-40, -30) and (40, 30); a line from (-30, 15) to
# (-20, 15), one from (-10, 5) down to (-10, -5); an arc of r 5 about
# (0, -20) from (0, -25) to (5, -20) and one of r 5 about (20, -5) from
# (20, -10) to (25, -5)):
#   1. The first line picked nearer its end than its start (3 mm off it,
#      clear of the end point's pick), Blend Curve, the second line
#      picked near its start: the preview is the blend; OK makes it, a
#      spline held by a Tangent at each end (the steps bar's hover list).
#   2. The first arc near its end, Blend Curve, Continuity Curvature, the
#      second arc near its start: OK makes a blend held by a Smooth
#      (curvature) constraint at each end.
#   3. The first line's length dimensioned to 6 mm: the blend follows, no
#      conflict.
# The wrapper replaces ENTER_SKETCH with the frontend's ordinary timeline
# activation. The clicks stay within x -30..30 mm, y -25..25 mm: the free
# part of the view after the fit also in session 0's 1024x768 window on
# Windows. Run by tools/ui-sketch-blend-curve-test.sh (Linux),
# tools/ui-windows-sketch-blend-curve-test.ps1 (Windows) and
# tools/ui-macos-sketch-blend-curve-test.sh (macOS).
wait-idle
ENTER_SKETCH
expect-log '^Editing sketch F1 \(Sketch1\)'
key F6
wait-idle

# 1. Tangent between the two lines.
mark
sketch-click -23 15
expect-selection 1 0
mark
command sketch.blend_curve
wait-log '^Command Blend Curve started'
mark
sketch-click -10 4
wait-log '^Blend Curve Curve 2: '
wait-log '^Preview Blend Curve: ok'
expect-no-log '^Preview Blend Curve: failed'
screenshot '${MITCAD_TEST_WORK}/sketch-blend-curve-preview.png'
# No mark before OK: the preview already shows the step in the steps bar,
# whose line is not written again when OK keeps it.
key Return
wait-log '^Blend curve from c[0-9]+ end to c[0-9]+ start, tangent$'
wait-log '^Added Blend Curve'
wait-idle
wait-log '^Sketch steps: .*s[0-9]+ blend_curve x[0-9]+$'
capture tangent '^Sketch steps: .*(s[0-9]+) blend_curve x[0-9]+$'
wait-log "^Sketch step ${tangent} at "
mark
hover-logged "^Sketch step ${tangent} at "
wait-log "^Sketch step ${tangent} hover list: Blend Curve: .*c[0-9]+ spline"
expect-log "^Sketch step ${tangent} hover list: Blend Curve: .*k[0-9]+ tangent.*k[0-9]+ tangent"
# Off the hover list, which opens over the view's lower part above the
# steps bar (at (0, -20) in session 0's 1024x768 window on Windows, where
# the next click then picked its row): up to the free part above it, and
# the list closed before the next pick.
sketch-move 0 20
wait-log '^Sketch step hover list closed$'
key Escape
wait-idle

# 2. Curvature between the two arcs.
mark
sketch-click 4.330 -22.5
expect-selection 1 0
mark
command sketch.blend_curve
wait-log '^Command Blend Curve started'
qt-choice input_continuity 'Curvature'
mark
sketch-click 20.868 -9.924
wait-log '^Blend Curve Curve 2: '
wait-log '^Preview Blend Curve: ok'
screenshot '${MITCAD_TEST_WORK}/sketch-blend-curve-curvature.png'
# No mark before OK: the preview already shows the step in the steps bar,
# whose line is not written again when OK keeps it.
key Return
wait-log '^Blend curve from c[0-9]+ end to c[0-9]+ start, curvature$'
wait-log '^Added Blend Curve'
wait-idle
wait-log "^Sketch steps: .*${tangent} blend_curve x[0-9]+, s[0-9]+ blend_curve x[0-9]+$"
capture smooth "^Sketch steps: .*, (s[0-9]+) blend_curve x[0-9]+$"
wait-log "^Sketch step ${smooth} at "
mark
hover-logged "^Sketch step ${smooth} at "
wait-log "^Sketch step ${smooth} hover list: Blend Curve: .*k[0-9]+ smooth.*k[0-9]+ smooth"
# Off the hover list, as after the first blend.
sketch-move 0 20
wait-log '^Sketch step hover list closed$'
key Escape
wait-idle

# 3. The first line's length to 6 mm: the solve keeps the blend joined
# and tangent, with no conflict.
mark
command sketch.dimension
wait-log '^Sketch tool Sketch Dimension$'
sketch-click -25 15
sketch-click -25 19
wait-log '^Sketch value editor at '
key ctrl+a
type 6
key Return
wait-log '^Added (driven )?dimension k[0-9]+ '
key Escape
wait-idle
expect-no-log '^Sketch conflict painted: k'
expect-no-log 'Sketch Palette solve: .*[Ee]rror'
screenshot '${MITCAD_TEST_WORK}/sketch-blend-curve-dimension.png'

command sketch.finish
wait-log '^Sketch finished'
command file.save
wait-log '^Saved '
expect-never 'Recompute failed|TestDriver: FAIL'
