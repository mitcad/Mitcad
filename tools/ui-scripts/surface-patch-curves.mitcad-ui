# SPDX-License-Identifier: MIT
# Patch closes part of an opening with two single free edges and a sketch
# line (mitcad#1972, GitHub mitcad/Mitcad#407), on the reported design (a
# wall of a box cut at a slant: Body1 F2.b0, one planar face in the plane
# y = -22.059883 whose four edges are all free, and its offset copy Body7
# F13.b0, hidden here so that Body1's edges are in view):
#   a sketch on the XZ plane moved onto the wall's plane holds one line
#   (c42) from the lower end of the slanted free edge to the far end of the
#   top free edge, across the wall: with them it closes a triangle;
#   Patch with Whole Opening off takes the top and the slanted free edge
#   one by one and the line beside them, the preview builds, Stitch is
#   turned off, and OK adds the patch as a body of its own.
# Run by tools/ui-surface-patch-curves-test.sh (Linux),
# tools/ui-windows-surface-patch-curves-test.ps1 (Windows) and
# tools/ui-macos-surface-patch-curves-test.sh (macOS).
expect-ever 'View area' 600
wait-idle 600
model-command '{"cmd":"set_body_visible","uid":"F13.b0","visible":false}'
wait-idle 60
# The sketch: XZ (sketch x along the design's X, sketch y along -Z, its
# normal +Y) moved -22.059883 along its normal; the slanted edge's lower
# end (x 42.991993, z 0) to the top edge's far end (x -25.837054, z 10).
model-command '{"cmd":"add_feature","def":{"type":"sketch","plane":"xz","placement":{"offset":-22.059883001913107},"entities":[{"id":"p40","type":"point","at":[42.99199335877307,0]},{"id":"p41","type":"point","at":[-25.837054357949604,-10]},{"id":"c42","type":"line","start":"p40","end":"p41"}]}}'
wait-idle 60
command view.fit
wait-idle

# Patch, Whole Opening off: single free edges.
mark
command surface.patch
wait-log '^Panel Patch input whole_opening at ' 20
wait-idle
click-logged '^Panel Patch input whole_opening at '
wait-log '^Patch: Whole Opening = off$' 10
wait-idle
# The top free edge (its middle at x 11.318849, z 10) and the slanted one
# (its middle at x 45.733373, z 5).
mark
click-pick 'edge F2[.]b0/[{]"at":\[11[.]3188[0-9]*,-22[.]0598[0-9]*,10\][^ ]* at '
wait-log '^Patch Profiles or Edges: 1 edge [[]edge [{]"at":\[11[.]3188' 20
wait-idle 30
mark
click-pick 'edge F2[.]b0/[{]"at":\[45[.]7333[0-9]*,-22[.]0598[0-9]*,5\][^ ]* at '
wait-log '^Patch Profiles or Edges: 2 edges' 20
wait-idle 30
# The line across the wall beside them: the loop closes.
expect-ever '^Sketch entity F[0-9]+/c42 at ' 20
mark
click-logged '^Sketch entity F[0-9]+/c42 at '
wait-log '^Patch Profiles or Edges: 2 edges, 1 sketch curve ' 20
expect-no-log ' not taken: '
wait-log '^Preview Patch: ok' 60
wait-idle 60

# Stitch off: the patch is a body of its own.
expect-ever '^Panel Patch input stitch at ' 20
mark
click-logged '^Panel Patch input stitch at '
wait-log '^Patch: Stitch = off$' 10
wait-log '^Preview Patch: ok' 60
wait-idle 60
mark
button '^OK$'
wait-log '^Added patch of 3 items$' 60
wait-idle 60
expect-never 'Recompute failed|OCCT view event failed|TestDriver: FAIL'
