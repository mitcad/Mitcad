# SPDX-License-Identifier: MIT
# Mesh tools that change a mesh's shape (mitcad#2515, app/COMMANDS.md "Mesh
# tools: Smooth, Combine, Offset and Shell, Align, Plane Cut") on the design
# mesh-shape-tools.json makes: the mesh bodies cube (F2.b0, a box 20 on a
# side at the origin), cube2 (F4.b0, the same moved by 10 along X and Y),
# cyl (F6.b0, a cylinder 20 across) and cube3 (F8.b0, a copy of cube), and
# Plane1 (F10) 5 above XY.
#   1. Smooth Mesh: cyl, Sharp Edge Angle 60 degrees (the rims sharp, the
#      side's facets not): a new closed mesh body (F11.b0); undone.
#   2. Combine Meshes: cube the target, cube2 the tool, Join: one closed
#      mesh of 14000 mm3; undone.
#   3. Offset Mesh: cube as a Shell 2 mm Inward: a closed wall of
#      8000 - 16^3 mm3; undone.
#   4. Align Mesh: cube3 onto cube by best fit (already in place: the
#      panel, not the fit, is tested here): a new mesh body; undone.
#   5. Plane Cut: cube by Plane1, both pieces capped: 6000 and 2000 mm3.
# Run by tools/ui-mesh-shape-tools-test.sh (Linux),
# tools/ui-windows-mesh-shape-tools-test.ps1 (Windows) and
# tools/ui-macos-mesh-shape-tools-test.sh (macOS).
expect-ever 'View area'
wait-idle
command view.fit
wait-idle 30

# 1. Smooth Mesh: the cylinder, its rims kept sharp, its side's facets
# not.
mark
command solid.mesh_smooth
wait-log '^Command Smooth Mesh started' 30
wait-idle
click-logged '^Browser Root/Bodies/cyl at '
wait-log '^Smooth Mesh Mesh Body: 1 body [[]body F6[.]b0[]]' 30
type-in '^Panel Smooth Mesh input sharp_angle at ' '60 deg'
wait-log '^Preview Smooth Mesh: ok' 60
wait-idle 60
screenshot '${MITCAD_TEST_WORK}/mesh-smooth-preview.png'
mark
key Return
wait-log '^Added mesh smooth of F6[.]b0, 5 passes' 60
wait-idle 60
capture-model-number smoothed '{"query":"mesh_stats","body":"F11.b0"}' open_edges
expect-near ${smoothed} 0 0 0
expect-ever '^Timeline Smooth1 at ' 30
mark
key ctrl+z
wait-log '^Undo: ' 20
wait-idle 30

# 2. Combine Meshes: the two boxes joined.
mark
command solid.mesh_combine
wait-log '^Command Combine Meshes started' 30
wait-idle
click-logged '^Browser Root/Bodies/cube at '
wait-log '^Combine Meshes Target Mesh: 1 body [[]body F2[.]b0[]]' 30
click-logged '^Panel Combine Meshes input tools at '
click-logged '^Browser Root/Bodies/cube2 at '
wait-log '^Combine Meshes Tool Meshes: 1 body [[]body F4[.]b0[]]' 30
wait-log '^Preview Combine Meshes: ok' 60
wait-idle 60
screenshot '${MITCAD_TEST_WORK}/mesh-combine-preview.png'
mark
key Return
wait-log '^Added mesh combine [(]Join[)] of F2[.]b0 with 1 tool' 60
wait-idle 60
capture-model-number joined '{"query":"mesh_stats","body":"F11.b0"}' volume
expect-near ${joined} 14000 1e-6 0.01
mark
key ctrl+z
wait-log '^Undo: ' 20
wait-idle 30

# 3. Offset Mesh: a shell 2 mm thick inside the box.
mark
command solid.mesh_offset
wait-log '^Command Offset Mesh started' 30
wait-idle
click-logged '^Browser Root/Bodies/cube at '
wait-log '^Offset Mesh Mesh Body: 1 body [[]body F2[.]b0[]]' 30
click-logged '^Panel Offset Mesh input mode at '
key Home Down Return
wait-log 'Offset Mesh: Type = Shell' 30
wait-idle 30
click-logged '^Panel Offset Mesh input side at '
key Home Down Return
wait-log 'Offset Mesh: Direction = Inward' 30
wait-log '^Preview Offset Mesh: ok' 60
wait-idle 60
screenshot '${MITCAD_TEST_WORK}/mesh-shell-preview.png'
mark
key Return
wait-log '^Added mesh shell of F2[.]b0, inward, thickness 2' 60
wait-idle 60
capture-model-number shelled '{"query":"mesh_stats","body":"F11.b0"}' volume
expect-near ${shelled} 3904 1e-6 0.01
mark
key ctrl+z
wait-log '^Undo: ' 20
wait-idle 30

# 4. Align Mesh: cube3 onto cube by best fit alone.
mark
command solid.mesh_align
wait-log '^Command Align Mesh started' 30
wait-idle
click-logged '^Browser Root/Bodies/cube3 at '
wait-log '^Align Mesh Mesh Body: 1 body [[]body F8[.]b0[]]' 30
click-logged '^Panel Align Mesh input target at '
click-logged '^Browser Root/Bodies/cube at '
wait-log '^Align Mesh Target: 1 body [[]body F2[.]b0[]]' 30
wait-log '^Preview Align Mesh: ok' 60
wait-idle 60
mark
key Return
wait-log '^Added mesh align of F8[.]b0 onto F2[.]b0, 0 point pairs, best fit' 60
wait-idle 60
expect-ever '^Timeline MeshAlign1 at ' 30
mark
key ctrl+z
wait-log '^Undo: ' 20
wait-idle 30

# 5. Plane Cut: the box by Plane1, both pieces capped.
mark
command solid.mesh_plane_cut
wait-log '^Command Plane Cut started' 30
wait-idle
click-logged '^Browser Root/Bodies/cube at '
wait-log '^Plane Cut Mesh Body: 1 body [[]body F2[.]b0[]]' 30
click-logged '^Panel Plane Cut input plane at '
click-logged '^Datum F10 at '
wait-log '^Plane Cut Plane: 1 plane [[]plane F10[]]' 30
wait-log '^Preview Plane Cut: ok' 60
wait-idle 60
screenshot '${MITCAD_TEST_WORK}/mesh-plane-cut-preview.png'
mark
key Return
wait-log '^Added mesh plane cut of F2[.]b0, keep both, capped' 60
wait-idle 60
capture-model-number above '{"query":"mesh_stats","body":"F11.b0"}' volume
expect-near ${above} 6000 1e-6 0.01
capture-model-number below '{"query":"mesh_stats","body":"F11.b1"}' volume
expect-near ${below} 2000 1e-6 0.01
expect-ever '^Timeline PlaneCut1 at ' 30
expect-never 'Recompute failed|The document was read while a job computes it|TestDriver: FAIL'
