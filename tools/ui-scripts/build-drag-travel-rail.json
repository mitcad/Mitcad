[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "The synthetic guide rail of the drag and travel UI test (mitcad#2088, tools/ui-build-drag-travel-test.sh): a square bar 15 wide, extruded by L from z = 0, with the end frames of a cut-to-length part, its carriage's frame rail on its top (y+) and its face frame base on its bottom (y-), their x along the bar."},
  {"cmd": "add_parameter", "name": "L", "expression": "500 mm"},
  {"cmd": "sketch.create", "plane": "xy"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [-7.5, -7.5], "width": 15, "height": 15},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": "L"}, "operation": "new_body"}},
  {"cmd": "add_feature", "name": "mount:end_a", "def": {"type": "joint_origin", "geometry": "origin",
    "frame_override": {"origin": [0, 0, 0], "z_axis": [0, 0, -1], "x_axis": [1, 0, 0]}}},
  {"cmd": "add_feature", "name": "mount:end_b", "def": {"type": "joint_origin",
    "geometry": {"body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}}},
  {"cmd": "add_feature", "name": "mount:rail", "def": {"type": "joint_origin",
    "geometry": {"origin": [0, 7.5, 0], "normal": [0, 1, 0], "x_axis": [0, 0, 1]}}},
  {"cmd": "add_feature", "name": "mount:base", "def": {"type": "joint_origin",
    "geometry": {"origin": [0, -7.5, 0], "normal": [0, -1, 0], "x_axis": [0, 0, 1]}}},
  {"expect": {"bodies": 1}}
]
