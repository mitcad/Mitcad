[
  {"comment": "SPDX-License-Identifier: MIT"},
  {"comment": "URDF export through the Export dialog (mitcad#2100): the mechanism of tools/cli/tests/urdf_export.json (a grounded plate, a pin on a limited revolute joint, a shaft on a cylindrical joint), saved as robot.mitcad by the UI tests tools/ui-urdf-test.sh, tools/ui-windows-urdf-test.ps1 and tools/ui-macos-urdf-test.sh."},
  {"cmd": "create_component", "name": "Plate"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}], "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Pin", "transform": {"translation": [100, 0, 0]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [0, 0], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}], "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Shaft", "transform": {"translation": [-50, 0, 0]}},
  {"cmd": "add_feature", "def": {"type": "cylinder", "plane": "xy", "center": [0, 0], "diameter": 6, "height": 30, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "ground_occurrence", "occurrence": "Plate:1"},
  {"cmd": "add_joint", "kind": "revolute", "flip": true, "a": {"occurrence": "Pin:1", "geometry": {"body": "F4.b0", "face": "F4:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}}, "b": {"occurrence": "Plate:1", "geometry": {"body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}}, "limits": {"rz": {"min": "-90 deg", "max": "90 deg"}}},
  {"cmd": "add_joint", "kind": "cylindrical", "a": {"occurrence": "Shaft:1", "geometry": {"body": "F5.b0", "edge": "E{F5:bottom|F5:side0}"}}, "b": {"occurrence": "Plate:1", "geometry": {"body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}, "frame_override": {"origin": [5, 5, 10]}}, "limits": {"tz": {"min": 0, "max": 15, "rest": 5}}}
]
