  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [15, 10], "diameter": 8},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [45, 10], "diameter": 8},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [15, 30], "diameter": 8},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [45, 30], "diameter": 8},
  {"cmd": "add_feature", "def": {"type": "extrude",
