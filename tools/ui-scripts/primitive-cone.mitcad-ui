# SPDX-License-Identifier: MIT
# Cone (mitcad#2239; app/COMMANDS.md "Primitives"), in an empty design:
#   1. Cone placed on the XY plane by its row in the browser, with its
#      defaults (Radius 10 mm, Top Radius 0 mm, Height 30 mm): OK adds Cone1
#      (F1), one body of pi r^2 h / 3 = 1000 pi mm3 with two faces, one of
#      them flat (the base; no top at the apex).
#   2. Cone1 edited from the timeline, Top Radius 4 mm: a frustum of
#      pi h (R^2 + R r + r^2) / 3 = 1560 pi mm3 with three faces, two flat.
#   3. Undo and Redo go back to the cone and to the frustum.
# The volumes and face counts are logged (MITCAD_LOG_VOLUMES=1 and the
# captured numbers). Run by tools/ui-primitive-cone-test.sh (Linux),
# tools/ui-windows-primitive-cone-test.ps1 (Windows) and
# tools/ui-macos-primitive-cone-test.sh (macOS).
expect-ever 'Browser arrow Root/Origin at' 30
wait-idle

# 1. A cone on XY.
mark
command solid.cone
expect-log '^Command Cone started' 30
click-logged '^Browser arrow Root/Origin at '
wait-idle 60
expect-log '^Browser Root/Origin/XY at ' 10
mark
click-logged '^Browser Root/Origin/XY at '
expect-log '^Place Cone: .*plane xy' 30
wait-log '^Preview Cone: ok' 30
wait-idle
mark
button '^OK$'
wait-log '^Added Cone as F1$' 60
wait-idle
expect-never 'Failed features: [^n]'
expect-model-bodies 1 3141.592653589793
capture-model-number coneFaces '{"query":"faces","body":"F1.b0","limit":50}' total
expect-near ${coneFaces} 2 0 0
capture-model-number coneFlat '{"query":"faces","body":"F1.b0","surface":"plane"}' total
expect-near ${coneFlat} 1 0 0
capture-model-number coneSide '{"query":"faces","body":"F1.b0","surface":"cone"}' total
expect-near ${coneSide} 1 0 0

# 2. A frustum: Top Radius 4 mm.
mark
dblclick-logged '^Timeline Cone1 at '
wait-log '^Editing F1 with Cone$' 30
wait-log '^Preview Cone: ok' 60
wait-idle
mark
type-in '^Panel Cone input top_radius at ' '4 mm'
wait-log '^Preview Cone: ok' 30
wait-idle
mark
button '^OK$'
wait-log '^Edited F1' 60
wait-idle
expect-never 'Failed features: [^n]'
expect-model-bodies 1 4900.884539600077
capture-model-number frustumFaces '{"query":"faces","body":"F1.b0","limit":50}' total
expect-near ${frustumFaces} 3 0 0
capture-model-number frustumFlat '{"query":"faces","body":"F1.b0","surface":"plane"}' total
expect-near ${frustumFlat} 2 0 0

# 3. Undo: the cone again; Redo: the frustum.
mark
command edit.undo
wait-idle
expect-model-bodies 1 3141.592653589793
mark
command edit.redo
wait-idle
expect-model-bodies 1 4900.884539600077
expect-never 'OCCT view event failed|TestDriver: FAIL'
