# check-all sources: app/platform app/files app/MainWindowNative.cpp app/mcp/AgentIndicator.cpp
# A second application process restores the explicitly customized layout.
expect-ever 'Native UI: AppKit shell with embedded OCCT viewport'
sleep 800
expect-native-toolbar-item mitcad.sidebar false
expect-native-toolbar-item mitcad.search true
expect-native-toolbar-item mitcad.project false
expect-native-toolbar-item mitcad.agent true
expect-native-toolbar-item command.file.open_from_project true
native-toolbar-item command.file.open_from_project remove
expect-native-toolbar-item command.file.open_from_project false
expect-native-toolbar-item command.file.open true
native-toolbar-item command.file.open remove
expect-native-toolbar-item command.file.open false
native-toolbar-item mitcad.project insert
expect-native-toolbar-item mitcad.project true
expect-native-text mitcad.project 'Not in a project'
native-toolbar-item mitcad.project remove
expect-native-toolbar-item mitcad.project false
