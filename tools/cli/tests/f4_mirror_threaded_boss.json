[
  {"comment": "SPDX-License-Identifier: MIT. A mirrored and a patterned cosmetic Thread feature keep their thread (mitcad#2537): a 60 x 40 x 20 block (Sketch1 F1, Extrude1 F2) with a boss 10 across and 10 high at (10, 10) on its top (Sketch2 F3, Extrude2 F4), threaded M10x1.5 6g cosmetically 4 long from 1 above the block (Thread1 F5). The boss' axis runs from its top (z = 30) down to the block, so the thread runs from z = 25 down to z = 21."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [10, 10], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "start": {"type": "offset", "offset": 20}, "extent": {"type": "distance", "distance": 10},
    "operation": "join", "participants": ["F2.b0"]}},
  {"expect": {"feature": "Extrude2", "status": "ok", "bodies": 1, "body": "F2.b0", "has_face": "F4:side(c1)"}},
  {"cmd": "add_feature", "def": {"type": "thread", "faces": [{"body": "F2.b0", "face": "F4:side(c1)"}],
    "thread": {"designation": "M10x1.5", "class": "6g"}, "length": 4, "offset": 1}},
  {"expect": {"feature": "Thread1", "status": "ok"}},
  {"expect": {"query": {"query": "threads", "cosmetic": true}, "result": [{"feature": "F5", "face": "F4:side(c1)",
    "start": [10, 10, 25], "end": [10, 10, 21]}]}},

  {"comment": "The boss and its thread mirrored across the plane x = 30 (Mirror1 F6): both bosses are listed, each where it is, with the thread's designation, class, hand and part."},
  {"cmd": "add_feature", "def": {"type": "mirror", "objects": {"type": "features", "features": ["F4", "F5"]},
    "plane": {"type": "fixed", "origin": [30, 0, 0], "normal": [1, 0, 0]}}},
  {"expect": {"feature": "Mirror1", "status": "ok", "bodies": 1, "body": "F2.b0", "has_face": "F6:inst1(F4:side(c1))"}},
  {"expect": {"query": {"query": "threads", "cosmetic": true}, "result": [
    {"feature": "F5", "body": "F2.b0", "face": "F4:side(c1)", "designation": "M10x1.5", "class": "6g",
     "right_handed": true, "modeled": false, "internal": false, "pitch": 1.5, "radius": 5,
     "start": [10, 10, 25], "end": [10, 10, 21]},
    {"feature": "F5", "body": "F2.b0", "face": "F6:inst1(F4:side(c1))", "designation": "M10x1.5", "class": "6g",
     "right_handed": true, "modeled": false, "internal": false, "pitch": 1.5, "radius": 5,
     "start": [50, 10, 25], "end": [50, 10, 21]}]}},

  {"comment": "An edit of the thread changes both: M10x1.25 left-handed, 6 long from 2 above the block."},
  {"cmd": "edit_feature", "uid": "F5", "def": {"type": "thread", "faces": [{"body": "F2.b0", "face": "F4:side(c1)"}],
    "thread": {"designation": "M10x1.25", "class": "6g", "right_handed": false}, "length": 6, "offset": 2}},
  {"expect": {"feature": "Thread1", "status": "ok"}},
  {"expect": {"feature": "Mirror1", "status": "ok"}},
  {"expect": {"query": {"query": "threads", "cosmetic": true}, "result": [
    {"face": "F4:side(c1)", "designation": "M10x1.25", "right_handed": false, "pitch": 1.25,
     "start": [10, 10, 28], "end": [10, 10, 22]},
    {"face": "F6:inst1(F4:side(c1))", "designation": "M10x1.25", "right_handed": false, "pitch": 1.25,
     "start": [50, 10, 28], "end": [50, 10, 22]}]}},

  {"comment": "The boss mirrored without its thread: the image is a plain cylinder, with no thread."},
  {"cmd": "edit_feature", "uid": "F6", "def": {"type": "mirror", "objects": {"type": "features", "features": ["F4"]},
    "plane": {"type": "fixed", "origin": [30, 0, 0], "normal": [1, 0, 0]}}},
  {"expect": {"feature": "Mirror1", "status": "ok", "body": "F2.b0", "has_face": "F6:inst1(F4:side(c1))"}},
  {"expect": {"query": {"query": "threads"}, "result": [{"feature": "F5", "face": "F4:side(c1)"}]}},

  {"comment": "The boss and its thread patterned 3 times 12 apart along y (RectangularPattern1 F7): the copies at y = 22 and 34 have the thread, the mirror's plain image still none."},
  {"cmd": "add_feature", "def": {"type": "rectangular_pattern",
    "objects": {"type": "features", "features": ["F4", "F5"]},
    "direction1": {"axis": {"type": "origin", "axis": "y"}, "quantity": 3, "distance": 12},
    "distance_type": "spacing"}},
  {"expect": {"feature": "RectangularPattern1", "status": "ok", "bodies": 1, "body": "F2.b0",
    "has_face": "F7:inst2(F4:side(c1))"}},
  {"expect": {"query": {"query": "threads", "cosmetic": true}, "result": [
    {"feature": "F5", "face": "F4:side(c1)", "designation": "M10x1.25", "start": [10, 10, 28], "end": [10, 10, 22]},
    {"feature": "F5", "face": "F7:inst1(F4:side(c1))", "designation": "M10x1.25", "right_handed": false,
     "start": [10, 22, 28], "end": [10, 22, 22]},
    {"feature": "F5", "face": "F7:inst2(F4:side(c1))", "designation": "M10x1.25", "right_handed": false,
     "start": [10, 34, 28], "end": [10, 34, 22]}]}}
]
