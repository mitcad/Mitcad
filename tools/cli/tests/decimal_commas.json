[
  {"comment": "Decimal commas (mitcad#2): a value written 1,5 mm is 1.5 mm, and parameters keep their expressions with points. Sketch1 (F1): a 60 x 40 rectangle (d1, d2)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": "1,5 mm"}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": "-1.5 mm"}, "operation": "new_body"}},
  {"comment": "The same volume as with a point."},
  {"expect": {"body": "F2.b0", "volume": 3600, "min": [0, 0, 0], "max": [60, 40, 1.5]}},
  {"expect": {"body": "F3.b0", "volume": 3600, "min": [0, 0, -1.5], "max": [60, 40, 0]}},

  {"comment": "In a function a comma between digits is a decimal comma; ', ' and ';' separate arguments."},
  {"cmd": "add_parameter", "name": "wall", "expression": "max(d3, 0,75 mm) * 2", "unit": "mm"},
  {"expect": {"parameter": "wall", "value": 3}},
  {"cmd": "set_parameter", "name": "d3", "expression": "2,5 mm"},
  {"expect": {"body": "F2.b0", "volume": 6000, "max": [60, 40, 2.5]}},
  {"expect": {"parameter": "wall", "value": 5}},
  {"expect": {"query": {"query": "parameters"}, "result": [
    {"name": "d1"}, {"name": "d2"},
    {"name": "d3", "expression": "2.5 mm", "value": 2.5},
    {"name": "d4", "expression": "-1.5 mm"},
    {"name": "wall", "expression": "max(d3, 0.75 mm) * 2", "value": 5}]}},
  {"expect": {"query": {"query": "evaluate", "expression": "d3 * 1,5 + max(1; ,5)"},
              "result": {"value": 4.75, "expression": "d3 * 1.5 + max(1; .5)"}}}
]
