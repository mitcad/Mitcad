[
  {"comment": "SPDX-License-Identifier: MIT. Mesh tools for reverse engineering (mitcad#1871) through the OCCT kernel. A cylinder 30 across and 12 high (F1) and a box 40 x 20 x 10 at x 50 (F3) are written to STL files and read back as the mesh bodies cyl (Base1 F2, F2.b0) and box (Base2 F4, F4.b0); Plane1 (F5) lies 6 above XY. Files go to the working directory."},
  {"cmd": "add_feature", "def": {"type": "cylinder", "plane": "xy", "diameter": 30, "height": 12, "operation": "new_body"}},
  {"cmd": "export", "path": "cyl.stl", "bodies": ["F1.b0"]},
  {"cmd": "import_file", "path": "cyl.stl"},
  {"cmd": "add_feature", "def": {"type": "box", "plane": {"type": "origin", "plane": "xy"}, "corner": [50, 0],
    "length": 40, "width": 20, "height": 10, "operation": "new_body"}},
  {"cmd": "export", "path": "box.stl", "bodies": ["F3.b0"]},
  {"cmd": "import_file", "path": "box.stl"},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "offset", "plane": "xy", "distance": 6}}},
  {"expect": {"feature": "Base2", "status": "ok"}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F2.b0"}, "result": {"closed": true, "holes": 0}}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F4.b0"}, "result": {"closed": true, "holes": 0}}},

  {"comment": "Mesh Section: the cylinder cut 6, 8 and 10 above XY, fitted within 0.2 mm, in Sketch1 to Sketch3 (F6 to F8)."},
  {"cmd": "mesh_section", "body": "F2.b0", "plane": "F5", "count": 3, "spacing": 2, "tolerance": 0.2},
  {"expect": {"feature": "Sketch1", "status": "ok"}},
  {"expect": {"feature": "Sketch3", "status": "ok"}},

  {"comment": "Repair (F9): the cylinder's mesh needs nothing, a new closed mesh body. Decimate (F10) within 0.5 mm: closed still."},
  {"cmd": "add_feature", "def": {"type": "mesh_repair", "body": "F2.b0", "tolerance": 0.01, "max_hole": 5}},
  {"expect": {"feature": "Repair1", "status": "ok"}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F9.b0"}, "result": {"closed": true, "holes": 0}}},
  {"cmd": "add_feature", "def": {"type": "mesh_decimate", "body": "F2.b0", "tolerance": 0.5}},
  {"expect": {"feature": "Decimate1", "status": "ok"}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F10.b0"}, "result": {"closed": true}}},

  {"comment": "Remove Region: a lasso round the box seen from above takes its top (F11: a hole), and filled (F12: closed)."},
  {"cmd": "add_feature", "def": {"type": "mesh_remove", "body": "F4.b0",
    "lassos": [{"normal": [0, 0, 1], "points": [[45, -5, 20], [95, -5, 20], [95, 25, 20], [45, 25, 20]]}]}},
  {"expect": {"feature": "RemoveRegion1", "status": "ok"}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F11.b0"}, "result": {"holes": 1, "closed": false}}},
  {"cmd": "add_feature", "def": {"type": "mesh_remove", "body": "F4.b0", "fill": true,
    "lassos": [{"normal": [0, 0, 1], "points": [[45, -5, 20], [95, -5, 20], [95, 25, 20], [45, 25, 20]]}]}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F12.b0"}, "result": {"holes": 0, "closed": true}}},

  {"comment": "Segment (F13): the box's six faces, six mesh bodies; the largest (a 40 x 20 face) fitted (F14) as a plane of its area."},
  {"cmd": "add_feature", "def": {"type": "mesh_segment", "body": "F4.b0", "angle": "20 deg", "tolerance": 0.05}},
  {"expect": {"feature": "Segment1", "status": "ok"}},
  {"expect": {"body": "F13.b5", "faces": 1}},
  {"cmd": "add_feature", "def": {"type": "mesh_fit_surface", "body": "F13.b0", "tolerance": 0.05}},
  {"expect": {"feature": "FitSurface1", "status": "ok"}},
  {"expect": {"body": "F14.b0", "area": 800, "tolerance": 1e-6}},

  {"comment": "Segment (F15) the cylinder: its side the largest region, fitted (F16) as a cylinder of its area, pi x 30 x 12."},
  {"cmd": "add_feature", "def": {"type": "mesh_segment", "body": "F2.b0", "angle": "45 deg", "tolerance": 0.05}},
  {"expect": {"feature": "Segment2", "status": "ok"}},
  {"cmd": "add_feature", "def": {"type": "mesh_fit_surface", "body": "F15.b0", "surface": "cylinder", "tolerance": 0.05}},
  {"expect": {"feature": "FitSurface2", "status": "ok"}},
  {"expect": {"body": "F16.b0", "area": 1130.9734, "tolerance": 1e-4}}
]
