[
  {"comment": "Data exchange round trips: a 60 x 40 x 20 block with a 5 mm fillet (F1..F3), named Bracket, written to every format and read back as base features (F4..F8). Files go to the working directory."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F2.b0",
    "edges": ["E{F2:side(c1[c4,c2])|F2:side(c2[c1,c3])}"], "radius": 5}},
  {"cmd": "rename_body", "uid": "F2.b0", "name": "Bracket"},
  {"expect": {"body": "Bracket", "volume": 47892.699081699, "faces": 7, "edges": 15}},

  {"cmd": "export", "path": "bracket.step", "bodies": ["Bracket"], "schema": "ap242"},
  {"cmd": "export", "path": "bracket.igs"},
  {"cmd": "export", "path": "bracket.brep"},
  {"cmd": "export", "path": "bracket.stl", "refinement": "high"},
  {"cmd": "export", "path": "bracket.obj", "refinement": {"deviation": 0.005, "angle": 0.1}},

  {"comment": "B-rep formats bring the solid back exactly, with its name (STEP, IGES) or the file's (BRep); faces are named by index."},
  {"cmd": "import_file", "path": "bracket.step"},
  {"expect": {"feature": "Base1", "status": "ok", "bodies": 2, "body": "Bracket (2)",
    "volume": 47892.699081699, "faces": 7, "edges": 15, "has_face": "F4:import(0)"}},
  {"expect": {"body": "Bracket (2)", "has_face": "F4:import(6)"}},
  {"cmd": "import_file", "path": "bracket.igs"},
  {"expect": {"feature": "Base2", "status": "ok", "body": "Bracket (3)",
    "volume": 47892.699081699, "faces": 7, "edges": 15, "has_face": "F5:import(3)"}},
  {"cmd": "import_file", "path": "bracket.brep"},
  {"expect": {"feature": "Base3", "status": "ok", "body": "bracket",
    "volume": 47892.699081699, "faces": 7, "edges": 15}},

  {"comment": "Meshes come back as mesh bodies: one face of triangles without edges; the volume is within the triangulation's deviation."},
  {"cmd": "import_file", "path": "bracket.stl"},
  {"expect": {"feature": "Base4", "status": "ok", "body": "bracket (2)", "volume": 47892.7,
    "tolerance": 1e-4, "faces": 1, "edges": 0, "has_face": "F7:import(0)"}},
  {"cmd": "import_file", "path": "bracket.obj", "name": "Scan"},
  {"expect": {"feature": "Scan", "status": "ok", "bodies": 6, "body": "Bracket (4)",
    "volume": 47892.7, "tolerance": 1e-4, "faces": 1}},

  {"comment": "A mesh body goes to STL as it is (STEP and IGES refuse it)."},
  {"cmd": "export", "path": "mesh.stl", "bodies": ["Bracket (4)"]},

  {"comment": "The original moves on; the imported copies do not follow (no history)."},
  {"cmd": "set_parameter", "name": "d3", "value": 10},
  {"expect": {"body": "Bracket", "volume": 23946.349540849, "tolerance": 1e-6}},
  {"expect": {"body": "Bracket (2)", "volume": 47892.699081699}},

  {"comment": "STL in the design's coordinates (mitcad#17): the Bracket in a component placed 100 mm along x and turned a quarter about z. Read back, the file's mesh is where the view shows the body; with component coordinates where its component has it."},
  {"cmd": "components_from_bodies", "bodies": ["F2.b0"]},
  {"cmd": "set_occurrence_transform", "occurrence": "Bracket:1",
    "transform": {"translation": [100, 0, 0], "rotation": {"axis": [0, 0, 1], "angle": 1.5707963267948966}}},
  {"expect": {"occurrence": "Bracket:1", "body": "Bracket",
    "bbox": {"min": [60, 0, 0], "max": [100, 60, 10]}, "tolerance": 1e-6}},
  {"cmd": "export", "path": "placed.stl", "bodies": ["Bracket"], "refinement": "high"},
  {"cmd": "import_file", "path": "placed.stl"},
  {"expect": {"body": "placed", "volume": 23946.35, "tolerance": 1e-4,
    "bbox": {"min": [60, 0, 0], "max": [100, 60, 10]}}},
  {"cmd": "export", "path": "local.stl", "bodies": ["Bracket"], "coordinates": "component", "ascii": true},
  {"cmd": "import_file", "path": "local.stl"},
  {"expect": {"body": "local", "bbox": {"min": [0, 0, 0], "max": [60, 40, 10]}, "tolerance": 1e-5}},

  {"comment": "A mesh body in a moved and turned occurrence (mitcad#20): the STL copy of the 20 mm Bracket in a component placed as the Bracket's. The kernel moves its triangles (OCCT's checker, which rejects a face without a surface, is not asked about them): measured by its occurrence, in the instances' properties and in the report printed after the script, it is where the view shows it, and so is its STL."},
  {"cmd": "rename_body", "uid": "F7.b0", "name": "Mesh"},
  {"cmd": "components_from_bodies", "bodies": ["F7.b0"]},
  {"cmd": "set_occurrence_transform", "occurrence": "Mesh:1",
    "transform": {"translation": [100, 0, 0], "rotation": {"axis": [0, 0, 1], "angle": 1.5707963267948966}}},
  {"expect": {"occurrence": "Mesh:1", "body": "Mesh", "volume": 47892.7, "tolerance": 1e-4,
    "bbox": {"min": [60, 0, 0], "max": [100, 60, 20]}}},
  {"expect": {"query": {"query": "instances", "properties": true}, "tolerance": 1e-4,
    "result": [{}, {}, {}, {}, {}, {}, {"occurrence": "Bracket:1"},
      {"occurrence": "Mesh:1", "name": "Mesh", "volume": 47892.7, "center": [79.958, 29.935, 10],
        "bbox": {"min": [60, 0, 0], "max": [100, 60, 20]}}]}},
  {"cmd": "export", "path": "mesh_placed.stl", "bodies": ["Mesh"]},
  {"cmd": "import_file", "path": "mesh_placed.stl"},
  {"expect": {"body": "mesh_placed", "volume": 47892.7, "tolerance": 1e-4,
    "bbox": {"min": [60, 0, 0], "max": [100, 60, 20]}}},

  {"comment": "STEP, IGES, OBJ and BRep in the design's coordinates too (mitcad#19; the STEP file an assembly that places the Bracket's part): read back, each file's body is where the view shows the Bracket, and the Mesh where its occurrence places it (OBJ and BRep move it by its location); with component coordinates where its component has it."},
  {"cmd": "export", "path": "placed.step", "bodies": ["Bracket"]},
  {"cmd": "export", "path": "placed.igs", "bodies": ["Bracket"]},
  {"cmd": "export", "path": "placed.obj", "bodies": ["Bracket"], "refinement": "high"},
  {"cmd": "export", "path": "placed.brep", "bodies": ["Bracket"]},
  {"cmd": "export", "path": "local.step", "bodies": ["Bracket"], "coordinates": "component"},
  {"cmd": "import_file", "path": "placed.step"},
  {"expect": {"body": "Bracket (5)", "volume": 23946.349540849,
    "bbox": {"min": [60, 0, 0], "max": [100, 60, 10]}, "tolerance": 1e-5}},
  {"cmd": "import_file", "path": "placed.igs"},
  {"expect": {"body": "Bracket (6)", "volume": 23946.349540849,
    "bbox": {"min": [60, 0, 0], "max": [100, 60, 10]}, "tolerance": 1e-5}},
  {"cmd": "import_file", "path": "placed.obj"},
  {"expect": {"body": "Bracket (7)", "volume": 23946.35, "tolerance": 1e-4,
    "bbox": {"min": [60, 0, 0], "max": [100, 60, 10]}}},
  {"cmd": "import_file", "path": "placed.brep"},
  {"expect": {"body": "placed (2)", "volume": 23946.349540849,
    "bbox": {"min": [60, 0, 0], "max": [100, 60, 10]}, "tolerance": 1e-5}},
  {"cmd": "import_file", "path": "local.step"},
  {"expect": {"body": "Bracket (8)", "volume": 23946.349540849,
    "bbox": {"min": [0, 0, 0], "max": [60, 40, 10]}, "tolerance": 1e-5}},
  {"cmd": "export", "path": "mesh_placed.obj", "bodies": ["Mesh"]},
  {"cmd": "import_file", "path": "mesh_placed.obj"},
  {"expect": {"body": "Mesh (2)", "volume": 47892.7, "tolerance": 1e-4,
    "bbox": {"min": [60, 0, 0], "max": [100, 60, 20]}}},
  {"cmd": "export", "path": "mesh_placed.brep", "bodies": ["Mesh"]},
  {"cmd": "import_file", "path": "mesh_placed.brep"},
  {"expect": {"body": "mesh_placed (2)", "volume": 47892.7, "tolerance": 1e-4,
    "bbox": {"min": [60, 0, 0], "max": [100, 60, 20]}}}
]
