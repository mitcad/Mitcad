[
  {"comment": "Sketch tools (S1) on OCCT: each sketch is extruded and the volume checked against the analytic area."},

  {"comment": "Sketch1 (F1): a hexagon inscribed in r = 10, extruded 10 (F2): 6 (sqrt 3 / 4) 10^2 10."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.polygon", "sketch": "F1", "center": [0, 0], "vertex": [10, 0], "sides": 6},
  {"expect": {"sketch": "Sketch1", "regions": ["r{c1[c6,c2],c2[c1,c3],c3[c2,c4],c4[c3,c5],c5[c4,c6],c6[c5,c1]}"]}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c6,c2],c2[c1,c3],c3[c2,c4],c4[c3,c5],c5[c4,c6],c6[c5,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"expect": {"bodies": 1, "body": "F2.b0", "volume": 2598.07621135332}},

  {"comment": "Sketch2 (F3): a slot 20 between centres, 10 wide: 20 x 10 + pi 5^2; extruded 10 (F4)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.slot", "sketch": "F3", "mode": "center_to_center", "a": [30, 0], "b": [50, 0], "width": 10},
  {"expect": {"sketch": "Sketch2", "regions": ["r{c1[c2,c4],c2[c3,c1],c3[c4,c2],c4[c1,c3]}"]}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c2,c4],c2[c3,c1],c3[c4,c2],c4[c1,c3]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"expect": {"body": "F4.b0", "volume": 2785.39816339745}},

  {"comment": "Sketch3 (F5): a 40 x 20 rectangle (d3, d4) with a fillet r = 5 (d5) and a chamfer 4 (d6), fully constrained."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F5", "corner": [0, 30], "width": 40, "height": 20},
  {"cmd": "sketch.fillet", "sketch": "F5", "a": "c1", "b": "c2", "radius": 5},
  {"cmd": "sketch.chamfer", "sketch": "F5", "a": "c3", "b": "c4", "distance": 4},
  {"expect": {"sketch": "Sketch3", "dof": 0,
    "regions": ["r{c1[c4,c9],c2[c9,c3],c3[c2,c13],c4[c13,c1],c9[c1,c2],c13[c3,c4]}"]}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F5", "region": "r{c1[c4,c9],c2[c9,c3],c3[c2,c13],c4[c13,c1],c9[c1,c2],c13[c3,c4]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"expect": {"body": "F6.b0", "volume": 7866.34954084936}},
  {"comment": "The fillet and the chamfer follow their parameters; the chamfer by an expression."},
  {"cmd": "set_parameter", "name": "d5", "value": 2},
  {"expect": {"body": "F6.b0", "volume": 7911.4159265359}},
  {"cmd": "set_parameter", "name": "d6", "value": "d5 * 3"},
  {"expect": {"parameter": "d6", "value": 6, "body": "F6.b0", "volume": 7811.4159265359}},

  {"comment": "Sketch4 (F7): a circle of diameter 20 (d8) offset out by 5 (d9); the ring between them extruded 10 (F8)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.circle", "sketch": "F7", "mode": "center", "center": [100, 0], "radius": 10},
  {"cmd": "sketch.add_dimension", "sketch": "F7", "dimension": {"type": "diameter", "curve": "c1"}},
  {"cmd": "sketch.offset", "sketch": "F7", "curves": ["c1"], "distance": 5},
  {"expect": {"parameter": "d8", "value": 20}},
  {"expect": {"sketch": "Sketch4", "regions": ["r{c1}", "r{c3}"]}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F7", "region": "r{c3}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"expect": {"body": "F8.b0", "volume": 3926.99081698724}},
  {"cmd": "set_parameter", "name": "d9", "value": 2},
  {"expect": {"body": "F8.b0", "volume": 1382.30076757951}},

  {"comment": "Sketch5 (F9): a line closed by a three-point arc, a half disc of r = 10; a text below it bounds its letters' profiles (P3)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_line", "sketch": "F9", "start": [200, 0], "end": [220, 0]},
  {"cmd": "sketch.arc", "sketch": "F9", "mode": "three_point", "start": "p3", "through": [210, 10], "end": "p2"},
  {"cmd": "sketch.add_text", "sketch": "F9", "text": "S1", "at": [205, -8], "height": 4},
  {"expect": {"sketch": "Sketch5", "regions": ["r{c1[c4,c4],c4[c1,c1]}", "r{t6.g0.c0}", "r{t6.g1.c0}"]}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F9", "region": "r{c1[c4,c4],c4[c1,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"expect": {"body": "F10.b0", "volume": 1570.7963267949}},

  {"comment": "Sketch6 (F11) on the hexagon's top face: its frame is XY at z = 10; a boss r = 3, 5 high (F12)."},
  {"cmd": "sketch.create", "plane": {"face": "F2:end(r{c1[c6,c2],c2[c1,c3],c3[c2,c4],c4[c3,c5],c5[c4,c6],c6[c5,c1]})",
    "body": "F2.b0"}},
  {"cmd": "sketch.circle", "sketch": "F11", "mode": "center", "center": [0, 0], "radius": 3},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F11", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "join", "participants": ["F2.b0"]}},
  {"expect": {"body": "F2.b0", "volume": 2739.44788076486,
    "bbox": {"min": [-10, -8.660254037844, 0], "max": [10, 8.660254037844, 15]}, "tolerance": 1e-6}},

  {"comment": "Sketch7 (F13) on XZ: x = +X, y = -Z, normal +Y (as in .f3d designs); a circle at (300, 5) is at z = -5."},
  {"cmd": "sketch.create", "plane": "xz"},
  {"cmd": "sketch.circle", "sketch": "F13", "mode": "center", "center": [300, 5], "radius": 2},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F13", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 4}, "operation": "new_body"}},
  {"expect": {"body": "F14.b0", "volume": 50.2654824574367,
    "bbox": {"min": [298, 0, -7], "max": [302, 4, -3]}, "tolerance": 1e-6}},

  {"comment": "Sketch8 (F15): its own frame 50 up and turned a quarter (x along +Y); a 10 x 4 rectangle, 3 high."},
  {"cmd": "sketch.create", "plane": "xy",
    "frame": {"origin": [0, 0, 50], "x_axis": [0, 1, 0], "y_axis": [-1, 0, 0]}},
  {"cmd": "sketch.rectangle", "sketch": "F15", "mode": "two_point", "a": [0, 0], "b": [10, 4]},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F15", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 3}, "operation": "new_body"}},
  {"expect": {"body": "F16.b0", "volume": 120,
    "bbox": {"min": [-4, 0, 50], "max": [0, 10, 53]}, "tolerance": 1e-6}},

  {"comment": "Sketch9 (F17): the top face of Sketch3's body projected (linked) onto XY, extruded 5 down (F18)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.project", "sketch": "F17",
    "source": "F6:end(r{c1[c4,c9],c2[c9,c3],c3[c2,c13],c4[c13,c1],c9[c1,c2],c13[c3,c4]})",
    "body": "F6.b0", "linked": true},
  {"expect": {"sketch": "Sketch9", "dof": 0, "regions": ["r{c1[c13,c4],c4[c1,c7],c7[c4,c9],c9[c7,c11],c11[c9,c13],c13[c11,c1]}"]}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F17", "region": "r{c1[c13,c4],c4[c1,c7],c7[c4,c9],c9[c7,c11],c11[c9,c13],c13[c11,c1]}"}],
    "extent": {"type": "distance", "distance": -5}, "operation": "new_body"}},
  {"expect": {"body": "F18.b0", "volume": 3905.70796326795,
    "bbox": {"min": [0, 30, -5], "max": [40, 50, 0]}, "tolerance": 1e-6}},
  {"comment": "A wider rectangle: Sketch3's body and the projection follow."},
  {"cmd": "set_parameter", "name": "d3", "value": 50},
  {"expect": {"body": "F6.b0", "volume": 9811.4159265359}},
  {"expect": {"body": "F18.b0", "volume": 4905.70796326795}},

  {"comment": "Sketch10 (F19): a circle r = 2 patterned 4 times around (400, 0), a new fixed point p3; each extruded 5 (F20)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.circle", "sketch": "F19", "mode": "center", "center": [400, 10], "radius": 2},
  {"cmd": "sketch.circular_pattern", "sketch": "F19", "entities": ["c1"], "center": [400, 0], "count": 4},
  {"expect": {"sketch": "Sketch10", "regions": ["r{c1}", "r{c4}", "r{c6}", "r{c8}"]}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F19", "region": "r{c1}"}, {"sketch": "F19", "region": "r{c4}"},
                 {"sketch": "F19", "region": "r{c6}"}, {"sketch": "F19", "region": "r{c8}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"expect": {"bodies": 12, "body": "F20.b0", "volume": 62.8318530717959}},
  {"expect": {"body": "F20.b3", "volume": 62.8318530717959}},
  {"comment": "All: hexagon 2739.44788076486, slot 2785.39816339745, Sketch3 9811.4159265359, ring 1382.30076757951, half disc 1570.7963267949, XZ 50.2654824574367, frame 120, projection 4905.70796326795, pattern 4 x 62.8318530717959."},
  {"expect": {"total_volume": 23616.6599230852}}
]
