[
  {"comment": "The reference model pat_rect_bodies: a 10 mm cube at the origin (Sketch1 F1, Extrude1 F2) patterned three times along X with 20 mm spacing (RectangularPattern1, F3): three bodies."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "rectangular_pattern",
    "objects": {"type": "bodies", "bodies": ["F2.b0"]},
    "direction1": {"axis": {"type": "origin", "axis": "x"}, "quantity": 3, "distance": 20},
    "distance_type": "spacing"}},
  {"expect": {"feature": "RectangularPattern1", "status": "ok", "bodies": 3, "total_volume": 3000}},
  {"expect": {"body": "Body3", "volume": 1000, "bbox": {"min": [40, 0, 0], "max": [50, 10, 10]},
    "has_face": "F3:inst2(F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}))"}},
  {"comment": "Extent: 20 mm from the first to the last element (experiment K41)."},
  {"cmd": "edit_feature", "uid": "F3", "def": {"type": "rectangular_pattern",
    "objects": {"type": "bodies", "bodies": ["F2.b0"]},
    "direction1": {"axis": {"type": "origin", "axis": "x"}, "quantity": "d4", "distance": "d5"},
    "distance_type": "extent"}},
  {"expect": {"body": "Body3", "bbox": {"min": [20, 0, 0], "max": [30, 10, 10]}}},
  {"comment": "Two directions, symmetric in the second: 3 x 3 elements; element 4 (1, 1) suppressed, its body F3.b3 gone, the others keep their ids."},
  {"cmd": "edit_feature", "uid": "F3", "def": {"type": "rectangular_pattern",
    "objects": {"type": "bodies", "bodies": ["F2.b0"]},
    "direction1": {"axis": {"type": "origin", "axis": "x"}, "quantity": "d4", "distance": "d5"},
    "direction2": {"axis": {"type": "origin", "axis": "y"}, "quantity": 2, "distance": 30, "symmetric": true},
    "distance_type": "spacing", "suppressed_elements": [4]}},
  {"expect": {"bodies": 8, "total_volume": 8000}},
  {"expect": {"body": "F3.b4", "bbox": {"min": [40, 30, 0], "max": [50, 40, 10]}}},
  {"expect": {"body": "F3.b7", "bbox": {"min": [40, -30, 0], "max": [50, -20, 10]}}},
  {"cmd": "undo"},

  {"comment": "The reference model pat_circ_bodies: a 10 mm cylinder 10 mm high at (20, 0) (Sketch2 F4, Extrude2 F5) patterned four times over 360 degrees about Z (CircularPattern1, F6)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F4", "center": [20, 0], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F4", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "circular_pattern",
    "objects": {"type": "bodies", "bodies": ["F5.b0"]},
    "axis": {"type": "origin", "axis": "z"}, "quantity": 4, "angle": 6.283185307179586}},
  {"expect": {"feature": "CircularPattern1", "status": "ok", "bodies": 7, "total_volume": 6141.592653589793}},
  {"expect": {"body": "F6.b0", "volume": 785.3981633974483, "center": [0, 20, 5]}},
  {"expect": {"body": "F6.b2", "center": [0, -20, 5]}},
  {"comment": "A partial angle of 90 degrees spans the four: 30 degrees apart (experiment K40)."},
  {"cmd": "edit_feature", "uid": "F6", "def": {"type": "circular_pattern",
    "objects": {"type": "bodies", "bodies": ["F5.b0"]},
    "axis": {"type": "origin", "axis": "z"}, "quantity": "d8", "angle": 1.5707963267948966}},
  {"expect": {"body": "F6.b0", "center": [17.320508075688775, 10, 5]}},
  {"expect": {"body": "F6.b2", "center": [0, 20, 5]}},

  {"comment": "The reference model pat_path_bodies: a 5 mm cube (Sketch3 F7, Extrude3 F8) patterned four times with 15 mm spacing along line c1 of Sketch4 (F9), from (0, 0) to (60, 0) (PathPattern1, F10)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F7", "corner": [0, 100], "width": 5, "height": 5},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F7", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F9", "corner": [0, 0], "width": 60, "height": 10},
  {"cmd": "add_feature", "def": {"type": "path_pattern",
    "objects": {"type": "bodies", "bodies": ["F8.b0"]},
    "path": {"type": "sketch_curve", "sketch": "F9", "curve": "c1"},
    "quantity": 4, "distance": 15, "distance_type": "spacing"}},
  {"expect": {"feature": "PathPattern1", "status": "ok", "bodies": 11}},
  {"expect": {"body": "F10.b2", "volume": 125, "bbox": {"min": [45, 100, 0], "max": [50, 105, 5]}}},
  {"comment": "Turning with a circular path: the circle c9 (after the rectangle's lines c1..c4 and corners p5..p8) of 20 mm about (0, 100) in Sketch4, a quarter turn apart."},
  {"cmd": "sketch.add_circle", "sketch": "F9", "center": [0, 100], "diameter": 20},
  {"cmd": "edit_feature", "uid": "F10", "def": {"type": "path_pattern",
    "objects": {"type": "bodies", "bodies": ["F8.b0"]},
    "path": {"type": "sketch_curve", "sketch": "F9", "curve": "c9"},
    "quantity": 2, "distance": 15.707963267948966, "distance_type": "spacing", "along_path": true}},
  {"expect": {"bodies": 9, "body": "F10.b0", "bbox": {"min": [-5, 100, 0], "max": [0, 105, 5]}}}
]
