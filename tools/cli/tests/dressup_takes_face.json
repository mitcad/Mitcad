[
  {"comment": "Fillets and chamfers that take a face away (mitcad#1106). A 30 x 20 x 7 block (Sketch1 F1, Extrude1 F2, Body1) with a pocket 26 x 16 from z = 5 (Sketch2 F3, Extrude2 F4): a tray whose walls are 2 thick and 2 high."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 30, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 7}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [2, 2], "width": 26, "height": 16},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "start": {"type": "offset", "offset": 5},
    "extent": {"type": "distance", "distance": 2}, "operation": "cut"}},
  {"expect": {"feature": "Extrude2", "status": "ok", "body": "Body1", "volume": 3368}},

  {"comment": "Chamfer1 (F5): 2 mm on the four inner top edges takes the walls' top and inner faces away. It is built at its size, without a warning or an info: the walls' volume less the bevels' prisms of 2 mm2 along their centroids' path, 2/3 mm outside the pocket."},
  {"cmd": "add_feature", "def": {"type": "chamfer", "body": "F2.b0",
    "edges": ["E{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F4:side(c1[c4,c2])}",
              "E{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F4:side(c2[c1,c3])}",
              "E{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F4:side(c3[c2,c4])}",
              "E{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F4:side(c4[c3,c1])}"],
    "size": {"type": "equal_distance", "distance": 2}}},
  {"expect": {"feature": "Chamfer1", "status": "ok", "body": "Body1", "volume": 3189.3333333333,
    "faces": 10}},
  {"expect": {"query": {"query": "feature", "uid": "F5"}, "result": {"status": "ok", "level": null}}},

  {"comment": "Fillet1 (F6): 1.5 mm where the bevel meets the outer wall at x = 0. The bevel's face holds the names of the inner face it took away, so the edge is named after that face and the outer wall."},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F2.b0",
    "edges": ["E{F2:side(c4[c3,c1])|F4:side(c4[c3,c1])}"], "radius": 1.5}},
  {"expect": {"feature": "Fillet1", "status": "ok", "body": "Body1"}},
  {"expect": {"query": {"query": "feature", "uid": "F6"}, "result": {"status": "ok", "level": null}}}
]
