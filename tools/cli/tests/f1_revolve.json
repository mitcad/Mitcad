[
  {"comment": "Revolve with the volumes of the T0 models (rev_*). Sketch1 (F1): the rectangle (10, 0)-(20, 30)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [10, 0], "width": 10, "height": 30},

  {"comment": "rev_full_sketch_line (the centre line on the Y axis as the origin Y axis): a tube, no caps."},
  {"cmd": "add_feature", "def": {"type": "revolve",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": "y", "extent": {"type": "full"}, "operation": "new_body"}},
  {"expect": {"feature": "Revolve1", "status": "ok", "body": "F2.b0", "volume": 28274.333882308136, "faces": 4,
    "has_face": "F2:side(c2[c1,c3])", "tolerance": 1e-5}},
  {"comment": "rev_angle: 90 degrees, the right-hand turn about +Y from +x towards -z."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "revolve",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": "y", "extent": {"type": "angle", "angle": 1.5707963267948966},
    "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 7068.583470577034, "faces": 6, "min": [0, 0, -20], "max": [20, 30, 0],
    "has_face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})", "tolerance": 1e-5}},
  {"comment": "A negative angle turns the other way."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "revolve",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": "y", "extent": {"type": "angle", "angle": -1.5707963267948966},
    "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 7068.583470577034, "min": [0, 0, 0], "max": [20, 30, 20], "tolerance": 1e-5}},
  {"comment": "rev_symmetric: 45 degrees to each side."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "revolve",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": "y", "extent": {"type": "symmetric", "angle": 0.7853981633974483},
    "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 7068.583470577034, "tolerance": 1e-5}},
  {"comment": "rev_two_sides: 60 and 30 degrees."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "revolve",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": "y",
    "extent": {"type": "two_sides", "angle1": 1.0471975511965976, "angle2": 0.5235987755982988},
    "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 7068.583470577034, "tolerance": 1e-5}},
  {"comment": "Up to the YZ plane, which the turn first meets after 90 degrees."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "revolve",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": "y", "extent": {"type": "to_object", "object": {"type": "plane", "plane": "yz"}},
    "operation": "new_body"}},
  {"expect": {"feature": "F2", "status": "ok", "body": "F2.b0", "volume": 7068.583470577034, "tolerance": 1e-5}},

  {"comment": "rev_groove_cut: a cylinder r = 20, 40 long, revolved about its own left edge (curve c4 of Sketch2 F3, at x = 100), then a 2 mm deep, 10 mm wide groove revolved about the same line as a cut (Sketch3 F5, Revolve3 F6)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [100, 0], "width": 20, "height": 40},
  {"cmd": "add_feature", "def": {"type": "revolve",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": {"sketch": "F3", "curve": "c4"}, "extent": {"type": "full"},
    "operation": "new_body"}},
  {"expect": {"body": "F4.b0", "volume": 50265.482457436694, "tolerance": 1e-5}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F5", "corner": [118, 15], "width": 2, "height": 10},
  {"cmd": "add_feature", "def": {"type": "revolve",
    "profiles": [{"sketch": "F5", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": {"sketch": "F3", "curve": "c4"}, "extent": {"type": "full"},
    "operation": "cut", "participants": ["F4.b0"]}},
  {"expect": {"feature": "F6", "status": "ok", "body": "F4.b0", "volume": 47877.87204070845, "tolerance": 1e-5,
    "has_face": "F6:side(c4[c3,c1])"}},

  {"comment": "About a straight model edge: a 60 x 40 x 20 block (Sketch4 F7, Extrude1 F8) and a 10 x 20 rectangle against its right side revolved about its bottom edge (x = 60, z = 0): a cylinder r = 10, 20 long (Sketch5 F9, Revolve4 F10)."},
  {"cmd": "add_parameter", "name": "block_width", "value": 60},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F7", "corner": [0, 100], "width": "block_width", "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F7", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F9", "corner": [60, 100], "width": 10, "height": 20},
  {"cmd": "add_feature", "def": {"type": "revolve",
    "profiles": [{"sketch": "F9", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": {"body": "F8.b0",
             "edge": "E{F8:side(c2[c1,c3])|F8:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})}"},
    "extent": {"type": "full"}, "operation": "new_body"}},
  {"expect": {"feature": "F10", "status": "ok", "body": "F10.b0", "volume": 6283.185307179587, "tolerance": 1e-5,
    "min": [50, 100, -10], "max": [70, 120, 10]}},
  {"comment": "A narrower block moves the edge, and the revolution about it becomes a tube r = 10..20."},
  {"cmd": "set_parameter", "name": "block_width", "value": 50},
  {"expect": {"feature": "F10", "status": "ok", "body": "F10.b0", "volume": 18849.555921538758,
    "min": [30, 100, -20], "max": [70, 120, 20], "tolerance": 1e-5}}
]
