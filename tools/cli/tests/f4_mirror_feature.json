[
  {"comment": "The reference model mir_feature: a 60 x 40 x 20 block (Sketch1 F1, Extrude1 F2) with a 10 mm boss at (15, 20) standing 10 mm on it (Sketch2 F3, Extrude2 F4, joined from the XY plane), mirrored across the plane x = 30 (a construction plane in the reference model, a fixed plane here) by Mirror1 (F5)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [15, 20], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 30}, "operation": "join"}},
  {"expect": {"bodies": 1, "body": "Body1", "volume": 48785.39816339745}},
  {"cmd": "add_feature", "def": {"type": "mirror", "objects": {"type": "features", "features": ["F4"]},
    "plane": {"type": "fixed", "origin": [30, 0, 0], "normal": [1, 0, 0]}}},
  {"comment": "60*40*20 + 2*pi*5**2*10 = 49570.8 mm3, as in the reference model; the copy's faces are inst1 of the boss's."},
  {"expect": {"feature": "Mirror1", "status": "ok", "bodies": 1, "body": "Body1", "volume": 49570.796326794894,
    "has_face": "F5:inst1(F4:end(r{c1}))"}},
  {"expect": {"body": "Body1", "has_edge": "E{F5:inst1(F4:end(r{c1}))|F5:inst1(F4:side(c1))}"}},

  {"comment": "Round the mirrored boss's top; the fillet follows a larger boss (d4 = 12)."},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F2.b0",
    "edges": ["E{F5:inst1(F4:end(r{c1}))|F5:inst1(F4:side(c1))}"], "radius": 1}},
  {"expect": {"feature": "Fillet1", "status": "ok"}},
  {"cmd": "set_parameter", "name": "d4", "value": 12},
  {"expect": {"feature": "Fillet1", "status": "ok"}},
  {"cmd": "undo"},
  {"cmd": "delete_feature", "uid": "F6"},

  {"comment": "Identical gives the same result; so does a mirror in the block's face at x = 60 for a boss at x = 105 that touches nothing: it fails."},
  {"cmd": "edit_feature", "uid": "F5", "def": {"type": "mirror", "objects": {"type": "features", "features": ["F4"]},
    "plane": {"type": "fixed", "origin": [30, 0, 0], "normal": [1, 0, 0]}, "compute": "identical"}},
  {"expect": {"body": "Body1", "volume": 49570.796326794894}},
  {"cmd": "edit_feature", "uid": "F5", "def": {"type": "mirror", "objects": {"type": "features", "features": ["F4"]},
    "plane": {"type": "face", "body": "F2.b0", "face": "F2:side(c2[c1,c3])"}}},
  {"expect": {"feature": "Mirror1", "status": "error", "error_contains": "no copy of Extrude2 reaches a body"}},

  {"comment": "Faces mirrored: the boss's side and top across x = 30, joined as a boss."},
  {"cmd": "edit_feature", "uid": "F5", "def": {"type": "mirror",
    "objects": {"type": "faces", "body": "F2.b0", "faces": ["F4:side(c1)", "F4:end(r{c1})"]},
    "plane": {"type": "fixed", "origin": [30, 0, 0], "normal": [1, 0, 0]}}},
  {"expect": {"feature": "Mirror1", "status": "ok", "body": "Body1", "volume": 49570.796326794894,
    "has_face": "F5:inst1(F4:side(c1))"}}
]
