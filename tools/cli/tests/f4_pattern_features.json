[
  {"comment": "The reference model pat_rect_feature (group diff_pattern_quantity): a 60 x 40 x 5 plate (Sketch1 F1, Extrude1 F2), a 5 mm hole at (10, 10) cut through all (Sketch2 F3, Extrude2 F4), the cut patterned 3 x 2 with 20 mm spacing along X and Y (RectangularPattern1, F5)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [10, 10], "diameter": 5},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "extent": {"type": "through_all"}, "operation": "cut"}},
  {"cmd": "add_feature", "def": {"type": "rectangular_pattern",
    "objects": {"type": "features", "features": ["F4"]},
    "direction1": {"axis": {"type": "origin", "axis": "x"}, "quantity": 3, "distance": 20},
    "direction2": {"axis": {"type": "origin", "axis": "y"}, "quantity": 2, "distance": 20},
    "distance_type": "spacing"}},
  {"comment": "60*40*5 - 6*pi*2.5**2*5 = 11410.95 mm3, as in the reference model. Element 4 is the hole at (30, 30)."},
  {"expect": {"feature": "RectangularPattern1", "status": "ok", "bodies": 1, "body": "Body1",
    "volume": 11410.951377451915, "faces": 12, "has_face": "F5:inst4(F4:side(c1))"}},

  {"comment": "Round the top rim of element 1's hole at (30, 10)."},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F2.b0",
    "edges": ["E{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F5:inst1(F4:side(c1))}"], "radius": 0.5}},
  {"expect": {"feature": "Fillet1", "status": "ok"}},

  {"comment": "pat_rect_feature_2x2: quantity 2 along X (d5), 11607.30 mm3; element 1 is still the hole at (30, 10), so the fillet stays."},
  {"cmd": "set_parameter", "name": "d5", "value": 2},
  {"cmd": "suppress_feature", "uid": "F6"},
  {"expect": {"body": "Body1", "volume": 11607.300918301276}},
  {"cmd": "suppress_feature", "uid": "F6", "suppressed": false},
  {"expect": {"feature": "Fillet1", "status": "ok"}},
  {"cmd": "undo"},
  {"cmd": "undo"},
  {"cmd": "undo"},

  {"comment": "Element 1 suppressed: five holes, and the fillet on its rim fails."},
  {"cmd": "edit_feature", "uid": "F5", "def": {"type": "rectangular_pattern",
    "objects": {"type": "features", "features": ["F4"]},
    "direction1": {"axis": {"type": "origin", "axis": "x"}, "quantity": "d5", "distance": "d6"},
    "direction2": {"axis": {"type": "origin", "axis": "y"}, "quantity": "d7", "distance": "d8"},
    "distance_type": "spacing", "suppressed_elements": [1]}},
  {"expect": {"feature": "Fillet1", "status": "error", "error_contains": "F5:inst1(F4:side(c1))"}},
  {"expect": {"body": "Body1", "volume": 11509.126147876595}},

  {"comment": "Identical (one boolean of the moved tool) gives the same as Adjust; a bigger hole (d4) follows."},
  {"cmd": "edit_feature", "uid": "F5", "def": {"type": "rectangular_pattern",
    "objects": {"type": "features", "features": ["F4"]},
    "direction1": {"axis": {"type": "origin", "axis": "x"}, "quantity": "d5", "distance": "d6"},
    "direction2": {"axis": {"type": "origin", "axis": "y"}, "quantity": "d7", "distance": "d8"},
    "distance_type": "spacing", "compute": "identical"}},
  {"expect": {"feature": "Fillet1", "status": "ok"}},
  {"cmd": "delete_feature", "uid": "F6"},
  {"expect": {"body": "Body1", "volume": 11410.951377451915}},
  {"cmd": "set_parameter", "name": "d4", "value": 6},
  {"expect": {"body": "Body1", "volume": 11151.769983530756}},

  {"comment": "Overlapping copies (spacing 4 mm) still cut as one tool."},
  {"cmd": "set_parameter", "name": "d6", "value": 4},
  {"expect": {"feature": "RectangularPattern1", "status": "ok", "bodies": 1}}
]
