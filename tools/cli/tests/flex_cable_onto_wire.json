      {"id": "n2", "at": [55.81311694, -80.85206692, 9.991345827]},
      {"id": "n3", "at": [103.7870476, -42.21263587, 9.991345827]}]}},
  {"expect": {"feature": "Flex1", "status": "ok"}},
  {"expect": {"feature": "Flex2", "status": "ok"}},
  {"cmd": "add_feature", "def": {"type": "flex",
