[
  {"comment": "SPDX-License-Identifier: MIT. Convert to Sheet Metal by triangulation (mitcad#2442): duct transitions laid flat approximately, the pattern stating how far its lengths are from the faces'. Rules F1: t 2, K 0.5."},
  {"cmd": "add_feature", "def": {"type": "sheet_rules", "thickness": 2, "bend_radius": 3, "allowance": {"type": "k_factor", "k": 0.5}, "reference_side": "front", "bend_relief": {"type": "rectangular", "width": 2, "depth": 3}, "corner_relief": {"type": "round", "width": 2, "depth": 3}}},

  {"comment": "A rectangle-to-round transition with an offset: Sketch F2's rectangle 120 x 80 about the origin, a plane 80 up (F3) with a 60 mm circle centred (10, 5) on it (Sketch F4), lofted (F5) and shelled 2 mm inside with both ends open (F6). Its four outer faces, the material behind them, convert by triangulation in 96 triangles: the strip closes round the transition and is opened at the picked face's first edge across it, the corner gap (the thickness) wide."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F2", "corner": [-60, -40], "width": 120, "height": 80},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "offset", "plane": "xy", "distance": 80}}},
  {"cmd": "sketch.create", "plane": "F3"},
  {"cmd": "sketch.add_circle", "sketch": "F4", "center": [10, 5], "diameter": 60},
  {"cmd": "add_feature", "def": {"type": "loft", "sections": [
    {"type": "profile", "sketch": "F2", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"},
    {"type": "profile", "sketch": "F4", "region": "r{c1}"}], "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "shell", "body": "F5.b0",
    "faces": ["F5:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})", "F5:end(r{c1})"], "inside": 2}},
  {"expect": {"feature": "F6", "status": "ok", "bodies": 1}},
  {"cmd": "add_feature", "def": {"type": "sheet_convert", "rules": "F1", "body": "F5.b0", "face": "F5:side(c1[c4,c2])",
    "development": "triangulated", "triangles": 96,
    "faces": ["F5:side(c3[c2,c4])", "F5:side(c2[c1,c3])", "F5:side(c4[c3,c1])"]}},
  {"expect": {"feature": "F7", "status": "ok", "bodies": 1}},
  {"expect": {"query": {"query": "feature", "uid": "F7"}, "result": {"status": "ok", "level": "info"}}},
  {"expect": {"query": {"query": "sheet_state", "body": "F5.b0"}, "result": {"status": "valid"}}},
  {"cmd": "set_flat_pattern", "body": "F5.b0"},
  {"expect": {"query": {"query": "flat_pattern", "body": "F5.b0"}, "result": {"status": "valid",
    "approximation": {"method": "triangulation", "seam": true}}}},
  {"expect": {"query": {"query": "sheet_bodies"}, "result": [{"body": "F5.b0",
    "flat_pattern": {"status": "valid", "approximation": {"method": "triangulation", "seam": true}}}]}},
  {"comment": "Its DXF with the fold lines the triangulation puts on the bend layers."},
  {"cmd": "export_flat_pattern_dxf", "body": "F5.b0", "path": "sheet_convert_triangulated.dxf", "folds": true},

  {"comment": "Refused: one face of the four is no plate of the body; further faces need the triangulation (a number of triangles that is not whole is refused when the definition is set: edit_feature fails)."},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "sheet_convert", "rules": "F1", "body": "F5.b0", "face": "F5:side(c1[c4,c2])",
    "development": "triangulated"}},
  {"expect": {"feature": "F7", "status": "error", "error_contains": "the body is not a plate of its rules' thickness 2 mm behind"}},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "sheet_convert", "rules": "F1", "body": "F5.b0", "face": "F5:side(c1[c4,c2])",
    "faces": ["F5:side(c3[c2,c4])", "F5:side(c2[c1,c3])", "F5:side(c4[c3,c1])"]}},
  {"expect": {"feature": "F7", "status": "error", "error_contains": "further faces are laid flat with the picked one only by triangulation"}},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "sheet_convert", "rules": "F1", "body": "F5.b0", "face": "F5:side(c1[c4,c2])",
    "development": "triangulated", "triangles": 96,
    "faces": ["F5:side(c3[c2,c4])", "F5:side(c2[c1,c3])", "F5:side(c4[c3,c1])"]}},
  {"expect": {"feature": "F7", "status": "ok", "bodies": 1}},
  {"comment": "Sheet features do not change a sheet laid flat by triangulation."},
  {"cmd": "add_feature", "def": {"type": "sheet_corner_round", "body": "F5.b0", "corners": [{"panel": {"feature": "F7", "slot": 0},
    "incoming": {"type": "generated", "feature": "F7", "slot": 2000000}, "outgoing": {"type": "generated", "feature": "F7", "slot": 2000001}}],
    "radius": 1}},
  {"expect": {"feature": "F8", "status": "error", "error_contains": "the sheet is laid flat approximately, by triangulation"}},

  {"comment": "A square-to-round transition: Sketch F9's square 80 x 80 about (300, 0), a 50 mm circle about it on F3 (Sketch F10), lofted (F11) and shelled (F12); its four faces in the default 64 triangles."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F9", "corner": [260, -40], "width": 80, "height": 80},
  {"cmd": "sketch.create", "plane": "F3"},
  {"cmd": "sketch.add_circle", "sketch": "F10", "center": [300, 0], "diameter": 50},
  {"cmd": "add_feature", "def": {"type": "loft", "sections": [
    {"type": "profile", "sketch": "F9", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"},
    {"type": "profile", "sketch": "F10", "region": "r{c1}"}], "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "shell", "body": "F11.b0",
    "faces": ["F11:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})", "F11:end(r{c1})"], "inside": 2}},
  {"cmd": "add_feature", "def": {"type": "sheet_convert", "rules": "F1", "body": "F11.b0", "face": "F11:side(c2[c1,c3])",
    "development": "triangulated",
    "faces": ["F11:side(c1[c4,c2])", "F11:side(c3[c2,c4])", "F11:side(c4[c3,c1])"]}},
  {"expect": {"feature": "F13", "status": "ok", "bodies": 2}},
  {"cmd": "set_flat_pattern", "body": "F11.b0"},
  {"expect": {"query": {"query": "flat_pattern", "body": "F11.b0"}, "result": {"status": "valid",
    "approximation": {"method": "triangulation", "seam": true}}}},

  {"comment": "Where the exact development applies the approximation is not used: the tube of cli.sheet_convert_curved (Sketch F14's rectangle (18, 0)-(20, 50) revolved once about Y, F15) asked to be triangulated is developed exactly, saying so: its blank 38 pi - 2 by 50, as there."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F14", "corner": [18, 0], "width": 2, "height": 50},
  {"cmd": "add_feature", "def": {"type": "revolve",
    "profiles": [{"sketch": "F14", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": "y", "extent": {"type": "full"}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "sheet_convert", "rules": "F1", "body": "F15.b0", "face": "F15:side(c2[c1,c3])",
    "development": "triangulated"}},
  {"expect": {"feature": "F16", "status": "ok", "body": "F15.b0", "volume": 11738.052083641214}},
  {"expect": {"query": {"query": "feature", "uid": "F16"}, "result": {"status": "ok", "level": "info",
    "infos": ["the face is flat, cylindrical or conical and lies flat exactly: it is developed exactly, and the approximate development is not needed"]}}},
  {"cmd": "set_flat_pattern", "body": "F15.b0"},
  {"expect": {"query": {"query": "flat_pattern", "body": "F15.b0"}, "result": {"status": "valid", "area": 5869.026041820606}}},

  {"comment": "Holes laid out with the strip (mitcad#2558): the rectangle-to-round transition with an offset again 300 along Y (Sketch F17's rectangle about (0, 300), Sketch F18's 60 mm circle about (10, 305) on F3, lofted F19, shelled F20), a 16 mm round hole 40 up through both long sides (Sketch F21 on XZ, cut through all both ways, F22). Its four faces convert by triangulation in 96 triangles: both holes are holes of the pattern, and the largest difference of a length along the pattern's edges from the faces', the holes' edges among them, is well under a millimetre."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F17", "corner": [-60, 260], "width": 120, "height": 80},
  {"cmd": "sketch.create", "plane": "F3"},
  {"cmd": "sketch.add_circle", "sketch": "F18", "center": [10, 305], "diameter": 60},
  {"cmd": "add_feature", "def": {"type": "loft", "sections": [
    {"type": "profile", "sketch": "F17", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"},
    {"type": "profile", "sketch": "F18", "region": "r{c1}"}], "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "shell", "body": "F19.b0",
    "faces": ["F19:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})", "F19:end(r{c1})"], "inside": 2}},
  {"cmd": "sketch.create", "plane": "xz"},
  {"cmd": "sketch.add_circle", "sketch": "F21", "center": [0, -40], "diameter": 16},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F21", "region": "r{c1}"}],
    "extent": {"type": "through_all", "both_sides": true}, "operation": "cut", "participants": ["F19.b0"]}},
  {"expect": {"feature": "F22", "status": "ok"}},
  {"cmd": "add_feature", "def": {"type": "sheet_convert", "rules": "F1", "body": "F19.b0", "face": "F19:side(c1[c4,c2])",
    "development": "triangulated", "triangles": 96,
    "faces": ["F19:side(c3[c2,c4])", "F19:side(c2[c1,c3])", "F19:side(c4[c3,c1])"]}},
  {"expect": {"feature": "F23", "status": "ok"}},
  {"expect": {"query": {"query": "feature", "uid": "F23"}, "result": {"status": "ok", "level": "info"}}},
  {"cmd": "set_flat_pattern", "body": "F19.b0"},
  {"expect": {"query": {"query": "flat_pattern", "body": "F19.b0"}, "result": {"status": "valid",
    "approximation": {"method": "triangulation", "seam": true, "holes": 2}}}},
  {"expect": {"query": {"query": "flat_pattern", "body": "F19.b0"}, "tolerance": 0.5, "result": {"approximation": {"edges": 0}}}},
  {"cmd": "export_flat_pattern_dxf", "body": "F19.b0", "path": "sheet_convert_triangulated_holes.dxf", "folds": true},

  {"comment": "Fans, a strip whose edges meet at a point where it starts (mitcad#2558) or midway (mitcad#2574), are tested in the model (sheet/folded/triangulated_tests.rs) and not here: Thicken cannot yet make a solid of a surface lofted between two curves that start at one point (the kernel's offset of that face fails to either side and half way; mitcad#2585)."},

  {"comment": "Planes and a cone in one strip (mitcad#2574): Sketch F24's rectangle 80 x 60 from (260, 260) with one corner rounded 20 (between c1 and c2: the arc c9), extruded 40 with a taper of -10 degrees (F25, its walls planes and a cone, as a tapered extrusion keeps them) and shelled 2 inside with both ends open (F26). The planes are trapezoids whose edges are not their parameter lines; their grids are built from their edges, the rungs the edges they share with the walls beside them. Its five outer walls convert by triangulation in one strip round the duct, opened at the picked wall's first edge across it; the largest difference of a length along the pattern's edges from the walls' well under a millimetre."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F24", "corner": [260, 260], "width": 80, "height": 60},
  {"cmd": "sketch.fillet", "sketch": "F24", "a": "c1", "b": "c2", "radius": 20},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F24", "region": "r{c1[c4,c9],c2[c9,c3],c3[c2,c4],c4[c3,c1],c9[c1,c2]}"}],
    "extent": {"type": "distance", "distance": 40, "taper": -0.17453292519943295}, "operation": "new_body"}},
  {"expect": {"feature": "F25", "status": "ok", "bodies": 5}},
  {"cmd": "add_feature", "def": {"type": "shell", "body": "F25.b0",
    "faces": ["F25:start(r{c1[c4,c9],c2[c9,c3],c3[c2,c4],c4[c3,c1],c9[c1,c2]})", "F25:end(r{c1[c4,c9],c2[c9,c3],c3[c2,c4],c4[c3,c1],c9[c1,c2]})"], "inside": 2}},
  {"expect": {"feature": "F26", "status": "ok"}},
  {"cmd": "add_feature", "def": {"type": "sheet_convert", "rules": "F1", "body": "F25.b0", "face": "F25:side(c1[c4,c9])",
    "development": "triangulated",
    "faces": ["F25:side(c9[c1,c2])", "F25:side(c2[c9,c3])", "F25:side(c3[c2,c4])", "F25:side(c4[c3,c1])"]}},
  {"expect": {"feature": "F27", "status": "ok"}},
  {"expect": {"query": {"query": "feature", "uid": "F27"}, "result": {"status": "ok", "level": "info"}}},
  {"cmd": "set_flat_pattern", "body": "F25.b0"},
  {"expect": {"query": {"query": "flat_pattern", "body": "F25.b0"}, "result": {"status": "valid",
    "approximation": {"method": "triangulation", "seam": true, "holes": 0}}}},
  {"expect": {"query": {"query": "flat_pattern", "body": "F25.b0"}, "tolerance": 0.5, "result": {"approximation": {"edges": 0}}}},
  {"cmd": "export_flat_pattern_dxf", "body": "F25.b0", "path": "sheet_convert_triangulated_planes.dxf", "folds": true}
]
