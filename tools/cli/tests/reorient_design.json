[
  {"comment": "Reorient Design (mitcad#502): a 60 x 40 x 20 block on XY (Sketch1 F1, Extrude1 F2), a boss of 20 x 10 from Plane1 (F3) offset 40 from XZ (Sketch2 F4, Extrude2 F5, joined), a 5 mm fillet on a vertical edge (F6), an 8 mm hole through the top (F7), a 10 x 8 pocket 5 deep from a sketch on the top face (Sketch3 F8, Extrude3 F9) and the block exported and imported again (Base1 F10). Files go to the working directory."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "offset", "plane": "xz", "distance": 40}}},
  {"cmd": "sketch.create", "plane": "F3"},
  {"cmd": "sketch.add_rectangle", "sketch": "F4", "corner": [20, -15], "width": 20, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F4", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 15}, "operation": "join", "participants": ["F2.b0"]}},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F2.b0",
    "edges": ["E{F2:side(c1[c4,c2])|F2:side(c2[c1,c3])}"], "radius": 5}},
  {"cmd": "add_feature", "def": {"type": "hole",
    "placement": {"type": "face", "body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})",
                  "points": [[15, 20, 20]]},
    "diameter": 8, "extent": {"type": "through_all"}}},
  {"cmd": "sketch.create", "plane": {"face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})", "body": "F2.b0"}},
  {"cmd": "sketch.add_rectangle", "sketch": "F8", "corner": [40, 25], "width": 10, "height": 8},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F8", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "flip": true, "operation": "cut", "participants": ["F2.b0"]}},
  {"cmd": "rename_body", "uid": "F2.b0", "name": "Block"},
  {"cmd": "export", "path": "reorient-block.brep", "bodies": ["Block"]},
  {"cmd": "import_file", "path": "reorient-block.brep", "wrap": false},
  {"cmd": "rename_body", "uid": "F10.b0", "name": "Imported"},
  {"expect": {"body": "Block", "volume": 49487.38943254999, "center": [30.12084806213477, 21.635288936618608, 9.939378495523817], "bbox": {"min": [0, 0, 0], "max": [60, 55, 20]},
    "has_face": "F7:hole0.wall", "has_edge": "E{F5:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F5:side(c1[c4,c2])}"}},
  {"expect": {"body": "Block", "has_face": "F6:fillet(E{F2:side(c1[c4,c2])|F2:side(c2[c1,c3])})"}},
  {"expect": {"body": "Block", "has_face": "F9:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
  {"expect": {"body": "Imported", "volume": 49487.38943254999, "bbox": {"min": [0, 0, 0], "max": [60, 55, 20]}, "has_face": "F10:import(0)"}},

  {"comment": "90 degrees about X: the block stands on XZ, below it (y -20..0), the boss up along Z; the same faces. Sketch1 goes to XZ facing -Y, Plane1 is offset from XY (XZ turned), the imported body turns by Move1 after Base1."},
  {"cmd": "reorient_design", "axis": "x", "degrees": 90},
  {"expect": {"body": "Block", "volume": 49487.38943254999, "center": [30.12084806213477, -9.939378495523817, 21.635288936618608], "bbox": {"min": [0, -20, 0], "max": [60, 0, 55]},
    "has_face": "F7:hole0.wall", "has_edge": "E{F5:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F5:side(c1[c4,c2])}"}},
  {"expect": {"body": "Block", "has_face": "F6:fillet(E{F2:side(c1[c4,c2])|F2:side(c2[c1,c3])})"}},
  {"expect": {"body": "Block", "has_face": "F9:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
  {"expect": {"body": "Imported", "volume": 49487.38943254999, "bbox": {"min": [0, -20, 0], "max": [60, 0, 55]}}},
  {"expect": {"feature": "Move1", "status": "ok"}},
  {"expect": {"feature": "Hole1", "status": "ok"}},

  {"comment": "Undo takes it all back."},
  {"cmd": "undo"},
  {"expect": {"body": "Block", "volume": 49487.38943254999, "center": [30.12084806213477, 21.635288936618608, 9.939378495523817], "bbox": {"min": [0, 0, 0], "max": [60, 55, 20]}}},
  {"expect": {"body": "Imported", "bbox": {"min": [0, 0, 0], "max": [60, 55, 20]}}},

  {"comment": "180 degrees about Y: x -60..0, z -20..0."},
  {"cmd": "reorient_design", "axis": "y", "degrees": 180},
  {"expect": {"body": "Block", "volume": 49487.38943254999, "center": [-30.12084806213477, 21.635288936618608, -9.939378495523817], "bbox": {"min": [-60, 0, -20], "max": [0, 55, 0]},
    "has_face": "F7:hole0.wall"}},
  {"expect": {"body": "Imported", "bbox": {"min": [-60, 0, -20], "max": [0, 55, 0]}}},
  {"cmd": "undo"},

  {"comment": "270 degrees about Z: (x, y) to (y, -x)."},
  {"cmd": "reorient_design", "axis": "z", "degrees": 270},
  {"expect": {"body": "Block", "volume": 49487.38943254999, "center": [21.635288936618608, -30.12084806213477, 9.939378495523817], "bbox": {"min": [0, -60, 0], "max": [55, 0, 20]},
    "has_face": "F7:hole0.wall"}},
  {"expect": {"body": "Imported", "bbox": {"min": [0, -60, 0], "max": [55, 0, 20]}}},
  {"cmd": "undo"},

  {"comment": "YZ becomes XY (three quarter turns about Y): x to z, z to -x."},
  {"cmd": "reorient_design", "plane": "yz"},
  {"expect": {"body": "Block", "volume": 49487.38943254999, "center": [-9.939378495523817, 21.635288936618608, 30.12084806213477], "bbox": {"min": [-20, 0, 0], "max": [0, 55, 60]},
    "has_face": "F7:hole0.wall"}},
  {"expect": {"body": "Imported", "bbox": {"min": [-20, 0, 0], "max": [0, 55, 60]}}}
]
