    "extent": {"type": "through_all"}, "operation": "cut"}},
  {"expect": {"bodies": 1, "body": "Body1", "has_face": "F4:side(c3)"}},
  {"expect": {"query": {"query": "measure",
    "a": {"body": "F2.b0", "edge": "E{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F4:side(c1)}"},
    "b": {"body": "F2.b0", "face": "F4:side(c3)"}},
    "result": {"between": {"main": "distance", "distance": 26.5, "axis_distance": 35,
