[
  {"comment": "SPDX-License-Identifier: MIT. The other inputs that take a 3D sketch's curves, and a closed path (mitcad#1550), on the geometry kernel. 3DSketch1 (F1): the route A-B-C-D from the origin, AB 40 along +X (c3, its length k3), BC 30 along +Y (c5, to p4), CD 20 along +Z (c7), 90 long, taken by one chained pick of AB."},
  {"cmd": "sketch3d.create"},
  {"cmd": "sketch3d.add_line", "sketch": "F1", "start": [0, 0, 0], "end": [38, 1, 0], "axis": "x", "length": 40, "start_source": "origin"},
  {"cmd": "sketch3d.add_line", "sketch": "F1", "start": "p2", "end": [41, 28, 0], "axis": "y", "length": 30},
  {"cmd": "sketch3d.add_line", "sketch": "F1", "start": "p4", "end": [40, 31, 18], "axis": "z", "length": 20},
  {"expect": {"query": {"query": "sketch3d", "uid": "F1", "path": {"curves": ["c3"], "chain": true}},
    "result": {"route": {"curves": ["c3", "c5", "c7"], "start": "p1", "end": "p6", "closed": false}}}},

  {"comment": "Plane1 (F2) normal to the route a quarter along it (22.5 on AB), Point1 (F3) at 0.6 of it (14 along BC), Axis1 (F4) through CD, Point2 (F5) at C (p4)."},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "along_path",
    "path": {"spatial_sketch": "F1", "curves": ["c3"], "chain": true}, "distance": 0.25}}},
  {"expect": {"query": {"query": "datum", "uid": "F2"}, "result": {"origin": [22.5, 0, 0], "normal": [1, 0, 0]}}},
  {"cmd": "add_feature", "def": {"type": "construction_point", "definition": {"type": "along_path",
    "path": {"spatial_sketch": "F1", "curves": ["c3"], "chain": true}, "distance": 0.6}}},
  {"expect": {"query": {"query": "datum", "uid": "F3"}, "result": {"point": [40, 14, 0]}}},
  {"cmd": "add_feature", "def": {"type": "construction_axis", "definition": {"type": "edge",
    "edge": {"sketch": "F1", "curve": "c7"}}}},
  {"expect": {"query": {"query": "datum", "uid": "F4"}, "result": {"origin": [40, 30, 0], "direction": [0, 0, 1]}}},
  {"cmd": "add_feature", "def": {"type": "construction_point", "definition": {"type": "point",
    "point": {"sketch": "F1", "point": "p4"}}}},
  {"expect": {"query": {"query": "datum", "uid": "F5"}, "result": {"point": [40, 30, 0]}}},

  {"comment": "Box1 (F6), 4 mm about A, patterned three times 30 apart along the route (PathPattern1, F7): the copies at 30 (on AB) and 60 (20 along BC)."},
  {"cmd": "add_feature", "def": {"type": "box", "plane": "xy", "corner": [-2, -2], "length": 4, "width": 4, "height": 4,
    "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "path_pattern", "objects": {"type": "bodies", "bodies": ["F6.b0"]},
    "path": {"spatial_sketch": "F1", "curves": ["c3"], "chain": true},
    "quantity": 3, "distance": 30, "distance_type": "spacing"}},
  {"expect": {"feature": "PathPattern1", "status": "ok"}},
  {"expect": {"body": "F7.b0", "bbox": {"min": [28, -2, 0], "max": [32, 2, 4]}}},
  {"expect": {"body": "F7.b1", "bbox": {"min": [38, 18, 0], "max": [42, 22, 4]}}},

  {"comment": "AB to 50 (k3): the route is 100 long; every one of them follows."},
  {"cmd": "sketch3d.set_dimension", "sketch": "F1", "dimension": "k3", "value": 50},
  {"expect": {"query": {"query": "datum", "uid": "F2"}, "result": {"origin": [25, 0, 0], "normal": [1, 0, 0]}}},
  {"expect": {"query": {"query": "datum", "uid": "F3"}, "result": {"point": [50, 10, 0]}}},
  {"expect": {"query": {"query": "datum", "uid": "F4"}, "result": {"origin": [50, 30, 0], "direction": [0, 0, 1]}}},
  {"expect": {"query": {"query": "datum", "uid": "F5"}, "result": {"point": [50, 30, 0]}}},
  {"expect": {"body": "F7.b1", "bbox": {"min": [48, 8, 0], "max": [52, 12, 4]}}},

  {"comment": "A closed path: 3DSketch2 (F8) a circle of radius 20 about (0, 0, 100) square to Z (c2); Pipe1 (F9) of 4 mm round it is a torus, 2 pi 20 pi 2^2 = 160 pi^2."},
  {"cmd": "sketch3d.create"},
  {"cmd": "sketch3d.add_circle", "sketch": "F8", "center": [0, 0, 100], "radius": 20, "normal_axis": "z"},
  {"expect": {"query": {"query": "sketch3d", "uid": "F8", "path": {"curves": ["c2"]}},
    "result": {"route": {"curves": ["c2"], "closed": true}}}},
  {"cmd": "add_feature", "def": {"type": "pipe", "path": {"spatial_sketch": "F8", "curves": ["c2"]},
    "size": 4, "operation": "new_body"}},
  {"expect": {"feature": "Pipe1", "status": "ok", "body": "F9.b0", "volume": 1579.136704174297, "tolerance": 1e-2}}
]
