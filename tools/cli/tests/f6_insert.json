[
  {"comment": "External components (F6), run where f6_assembly.json saved plate.mitcad: two plates with pins, 13051.327 mm3 in all."},
  {"comment": "Linked, 100 mm up: component 'plate' keeps the file's components, read only (mitcad#2209): its own base feature F1 holds the file's root bodies (none), 'Plate' (C2, base feature F2) and 'Pin' (C3, F3) hold their own bodies, placed as the file places them (its move and captured position taken as placements): two bodies, four placed."},
  {"cmd": "insert_component", "path": "plate.mitcad", "transform": {"translation": [0, 0, 100]}},
  {"expect": {"bodies": 2, "instances": 4, "world_volume": 13051.327412287183}},
  {"expect": {"occurrence": "plate:1/Plate:1", "body": "Body1", "volume": 6400,
    "bbox": {"min": [80, 0, 100], "max": [100, 40, 108]}, "tolerance": 1e-6}},
  {"expect": {"occurrence": "plate:1/Plate:2", "body": "Body1", "volume": 6400,
    "bbox": {"min": [0, -50, 100], "max": [40, -30, 108]}, "tolerance": 1e-6}},
  {"expect": {"query": {"query": "components"}, "result": {
    "components": [{"uid": "C0"},
                   {"uid": "C1", "name": "plate", "link": "plate.mitcad", "features": ["F1"], "link_tree": true},
                   {"uid": "C2", "name": "Plate", "features": ["F2"], "linked_in": "C1"},
                   {"uid": "C3", "name": "Pin", "features": ["F3"], "linked_in": "C1"}]}}},

  {"comment": "A copy, 200 mm along Y: 'Plate copy' with the file's history (its plate, pin, move and captured position), editable; its components take free names beside the linked ones."},
  {"cmd": "insert_component", "path": "plate.mitcad", "link": false, "name": "Plate copy",
    "transform": {"translation": [0, 200, 0]}},
  {"expect": {"bodies": 4, "instances": 8, "world_volume": 26102.654824574366}},
  {"expect": {"query": {"query": "components"}, "result": {
    "components": [{"uid": "C0"}, {"uid": "C1"}, {"uid": "C2"}, {"uid": "C3"},
                   {"uid": "C4", "name": "Plate copy"}, {"uid": "C5", "name": "Plate (1)"},
                   {"uid": "C6", "name": "Pin (1)"}]}}},
  {"expect": {"occurrence": "Plate copy:1/Plate (1):2", "body": "Body3", "volume": 6400,
    "bbox": {"min": [0, 150, 0], "max": [40, 170, 8]}, "tolerance": 1e-6}},
  {"expect": {"occurrence": "Plate copy:1/Plate (1):1/Pin (1):1", "body": "Body4", "center": [90, 210, 10], "tolerance": 1e-6}},
  {"expect": {"feature": "Move1", "status": "ok"}},
  {"expect": {"feature": "Position1", "status": "ok"}},

  {"comment": "The copy's plate 2 mm thinner (its copied parameters are d1 ... d8, d3 the plate's distance): only the copy changes."},
  {"cmd": "set_parameter", "name": "d3", "value": 6},
  {"expect": {"occurrence": "Plate copy:1/Plate (1):2", "body": "Body3", "volume": 4800}},
  {"expect": {"occurrence": "plate:1/Plate:1", "body": "Body1", "volume": 6400}}
]
