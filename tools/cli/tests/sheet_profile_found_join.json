[
  {"comment":"SPDX-License-Identifier: MIT. A face joined to a sheet whose sketch's outline is edited (mitcad#1444): the 40 x 20 panel of sheet_face_join (t=1, front) takes a 20 x 4 strip (Sketch2: c1 bottom on the panel's edge y=20, c2 right, c3 top, c4 left) through its thickness, volume 880."},
  {"cmd":"add_feature","def":{"type":"sheet_rules","thickness":1,"bend_radius":1,"allowance":{"type":"k_factor","k":0.4},"reference_side":"front","bend_relief":{"type":"rectangular","width":1,"depth":1},"corner_relief":{"type":"round","width":2,"depth":2}}},
  {"cmd":"sketch.create"},
  {"cmd":"sketch.add_rectangle","sketch":"F2","corner":[0,0],"width":40,"height":20},
  {"cmd":"add_feature","def":{"type":"sheet_face","rules":"F1","profiles":[{"sketch":"F2","region":"r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}]}},
  {"cmd":"sketch.create"},
  {"cmd":"sketch.add_rectangle","sketch":"F4","corner":[20,20],"width":20,"height":4},
  {"cmd":"add_feature","def":{"type":"sheet_face","rules":"F1","body":"F3.b0","profiles":[{"sketch":"F4","region":"r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}]}},
  {"expect":{"feature":"F5","status":"ok","bodies":1}},
  {"expect":{"body":"F3.b0","volume":880,"min":[0,0,0],"max":[40,24,1]}},

  {"comment":"The strip's outer corner (40, 24) rounded with radius 1: the joined face finds its changed region and warns; the strip loses 1 - pi/4."},
  {"cmd":"sketch.fillet","sketch":"F4","a":"c2","b":"c3","radius":1},
  {"expect":{"feature":"F5","status":"warning","error_contains":"region r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]} found as r{"}},
  {"expect":{"feature":"F5","error_contains":"after a change in Sketch2"}},
  {"expect":{"bodies":1,"body":"F3.b0","volume":879.7853981633974,"min":[0,0,0],"max":[40,24,1]}},
  {"expect":{"query":{"query":"sheet_state","body":"F3.b0"},"result":{"status":"valid","charts":[{"domain":{"kind":"panel","id":{"feature":"F3","slot":0}},"regions":[{"loops":[{}]}]}]}}},
  {"cmd":"undo"},
  {"expect":{"feature":"F5","status":"ok","body":"F3.b0","volume":880}},

  {"comment":"The strip's curves deleted: the joined face's profile is gone and it fails naming its sketch."},
  {"cmd":"sketch.remove","sketch":"F4","items":["c1","c2","c3","c4"]},
  {"expect":{"feature":"F5","status":"error","error_contains":"Sketch2 has no profile r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}},
  {"cmd":"undo"},
  {"expect":{"feature":"F5","status":"ok","body":"F3.b0","volume":880}}
]
