  {"comment": "A plate 40 to 45 above the base (Sketch3 F6, Extrude3 F7, Body2): the block's top up to its underside (MoveFace2 F8), then the plate lowered to 30 to 35: the stop follows it."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F6", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F6", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "start": {"type": "offset", "offset": 40},
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "move_face", "body": "F2.b0",
    "faces": ["F4:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"],
    "to_object": {"type": "face", "body": "F7.b0", "face": "F7:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}}},
  {"expect": {"feature": "MoveFace2", "status": "ok"}},
  {"expect": {"body": "Body1", "volume": 33000,
    "bbox": {"min": [0, 0, 0], "max": [60, 40, 40]}, "tolerance": 1e-6}},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "extrude",
    "profiles": [{"sketch": "F6", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "start": {"type": "offset", "offset": 30},
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"expect": {"feature": "MoveFace2", "status": "ok"}},
  {"expect": {"body": "Body1", "volume": 30000,
    "bbox": {"min": [0, 0, 0], "max": [60, 40, 30]}, "tolerance": 1e-6}},
