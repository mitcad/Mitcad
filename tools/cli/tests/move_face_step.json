  {"comment": "mitcad#2548 (GitHub mitcad/Mitcad#731): a raised block on a base. The base 60 x 40 x 10 (Sketch1 F1, Extrude1 F2, Body1 F2.b0); the block x 10..30, y 15..25, z 10..25 (Sketch2 F3, Extrude2 F4) joined on its top. The block's end at x = 10 faces the base's side at x = 0."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [10, 15], "width": 20, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "start": {"type": "offset", "offset": 10},
    "extent": {"type": "distance", "distance": 15}, "operation": "join", "participants": ["F2.b0"]}},
  {"expect": {"bodies": 1, "body": "Body1", "volume": 27000,
    "has_face": "F4:side(c4[c3,c1])"}},

