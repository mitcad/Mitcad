[
  {"comment": "Construction geometry on the block of T0's cons_axes: 60 x 40 x 20 mm (F2) with a 10 mm hole through (30, 20) (F3; F2 extrudes both profiles, the rectangle with the circle as its hole and the circle). Faces: top F2:end(R), bottom F2:start(R), front (y = 0) F2:side(c1[c4,c2]), right (x = 60) F2:side(c2[c1,c3]), back F2:side(c3[c2,c4]), left F2:side(c4[c3,c1]), hole F3:side(c9); R is the rectangle's region."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "sketch.add_circle", "sketch": "F1", "center": [30, 20], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}, {"sketch": "F1", "region": "r{c9}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F1", "region": "r{c9}"}],
    "extent": {"type": "through_all"}, "operation": "cut"}},
  {"expect": {"bodies": 1, "body": "Body1", "volume": 46429.20367320511}},

  {"comment": "Axes: through two vertices, along an edge, where two offset planes meet, through the hole."},
  {"cmd": "add_feature", "def": {"type": "construction_axis", "definition": {"type": "two_points",
    "point1": {"body": "F2.b0", "vertex": "V{F2:side(c1[c4,c2])|F2:side(c4[c3,c1])|F2:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})}"},
    "point2": {"body": "F2.b0", "vertex": "V{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F2:side(c2[c1,c3])|F2:side(c3[c2,c4])}"}}}},
  {"expect": {"query": {"query": "datum", "uid": "F4"}, "result": {"name": "Axis1", "type": "axis",
    "origin": [0, 0, 0], "direction": [0.8017837257372732, 0.5345224838248488, 0.2672612419124244]}}},
  {"cmd": "add_feature", "def": {"type": "construction_axis", "definition": {"type": "edge",
    "edge": {"body": "F2.b0", "edge": "E{F2:side(c2[c1,c3])|F2:side(c3[c2,c4])}"}}}},
  {"expect": {"query": {"query": "datum", "uid": "F5"}, "result": {"origin": [60, 40, 0], "direction": [0, 0, 1]}}},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "offset", "plane": "yz", "distance": 30}}},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "offset", "plane": "xz", "distance": 20}}},
  {"cmd": "add_feature", "def": {"type": "construction_axis", "definition": {"type": "two_planes", "plane1": "F6", "plane2": "F7"}}},
  {"expect": {"query": {"query": "datum", "uid": "F8"}, "result": {"origin": [30, 20, 0], "direction": [0, 0, 1]}}},
  {"cmd": "add_feature", "def": {"type": "construction_axis", "definition": {"type": "circular_face",
    "face": {"body": "F2.b0", "face": "F3:side(c9)"}}}},
  {"expect": {"query": {"query": "datum", "uid": "F9"}, "result": {"name": "Axis4", "origin": [30, 20, 10], "direction": [0, 0, 1]}}},

  {"comment": "Planes: offset from the top face, midway between the side faces x = 0 and 60, through three vertices (2x + 3y + 6z = 120), at 30 degrees about X."},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "offset",
    "plane": {"body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}, "distance": 10}}},
  {"expect": {"query": {"query": "datum", "uid": "F10"}, "result": {"name": "Plane3", "origin": [0, 0, 30], "normal": [0, 0, 1]}}},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "midplane",
    "plane1": {"body": "F2.b0", "face": "F2:side(c4[c3,c1])"}, "plane2": {"body": "F2.b0", "face": "F2:side(c2[c1,c3])"}}}},
  {"expect": {"query": {"query": "datum", "uid": "F11"}, "result": {"origin": [30, 0, 0], "normal": [-1, 0, 0]}}},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "three_points",
    "point1": {"body": "F2.b0", "vertex": "V{F2:side(c1[c4,c2])|F2:side(c2[c1,c3])|F2:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})}"},
    "point2": {"body": "F2.b0", "vertex": "V{F2:side(c3[c2,c4])|F2:side(c4[c3,c1])|F2:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})}"},
    "point3": {"body": "F2.b0", "vertex": "V{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F2:side(c1[c4,c2])|F2:side(c4[c3,c1])}"}}}},
  {"expect": {"query": {"query": "datum", "uid": "F12"}, "result": {"origin": [60, 0, 0],
    "normal": [0.2857142857142857, 0.42857142857142855, 0.8571428571428571]}}},

  {"comment": "Points: the centre of the hole's top rim and the three origin planes' common point."},
  {"cmd": "add_feature", "def": {"type": "construction_point", "definition": {"type": "center",
    "entity": {"body": "F2.b0", "edge": "E{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F3:side(c9)}"}}}},
  {"expect": {"query": {"query": "datum", "uid": "F13"}, "result": {"name": "Point1", "point": [30, 20, 20]}}},
  {"cmd": "add_feature", "def": {"type": "construction_point", "definition": {"type": "three_planes",
    "plane1": "xy", "plane2": "yz", "plane3": "xz"}}},
  {"expect": {"query": {"query": "datum", "uid": "F14"}, "result": {"point": [0, 0, 0]}}},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "angle",
    "line": "x", "angle": 0.5235987755982988, "plane": "xy"}}},
  {"expect": {"query": {"query": "datum", "uid": "F15"}, "result": {"origin": [0, 0, 0], "normal": [0, -0.5, 0.8660254037844386]}}},
  {"cmd": "add_feature", "def": {"type": "construction_point", "definition": {"type": "point",
    "point": {"body": "F2.b0", "vertex": "V{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F2:side(c2[c1,c3])|F2:side(c3[c2,c4])}"}}}},
  {"expect": {"query": {"query": "datum", "uid": "F16"}, "result": {"point": [60, 40, 20]}}},

  {"comment": "A plane a quarter along the top front edge, an axis normal to the front face through Point3, and where the hole's axis meets Plane3."},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "along_path",
    "path": {"body": "F2.b0", "edges": ["E{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F2:side(c1[c4,c2])}"]}, "distance": 0.25}}},
  {"expect": {"query": {"query": "datum", "uid": "F17"}, "result": {"origin": [15, 0, 20], "normal": [1, 0, 0]}}},
  {"cmd": "add_feature", "def": {"type": "construction_axis", "definition": {"type": "normal_to_face_at_point",
    "face": {"body": "F2.b0", "face": "F2:side(c1[c4,c2])"}, "point": "F16"}}},
  {"expect": {"query": {"query": "datum", "uid": "F18"}, "result": {"origin": [60, 40, 20], "direction": [0, -1, 0]}}},
  {"cmd": "add_feature", "def": {"type": "construction_point", "definition": {"type": "edge_and_plane", "line": "F9", "plane": "F10"}}},
  {"expect": {"query": {"query": "datum", "uid": "F19"}, "result": {"point": [30, 20, 30]}}},
  {"expect": {"query": {"query": "timeline"}, "result": {"marker": 19}}},

  {"comment": "The block grows to 30 mm (d4): the datums on it follow, the others are not evaluated again."},
  {"cmd": "set_parameter", "name": "d4", "value": 30},
  {"expect": {"query": {"query": "datum", "uid": "F4"}, "result": {"direction": [0.7682212795973759, 0.5121475197315839, 0.3841106397986879]}}},
  {"expect": {"query": {"query": "datum", "uid": "F10"}, "result": {"origin": [0, 0, 40]}}},
  {"expect": {"query": {"query": "datum", "uid": "F13"}, "result": {"point": [30, 20, 30]}}},
  {"expect": {"query": {"query": "datum", "uid": "F9"}, "result": {"origin": [30, 20, 15]}}},
  {"expect": {"query": {"query": "datum", "uid": "F19"}, "result": {"point": [30, 20, 40]}}},
  {"expect": {"query": {"query": "datum", "uid": "F12"}, "result": {"normal": [0.37139067635410367, 0.5570860145311556, 0.7427813527082073]}}},
  {"expect": {"feature": "Plane5", "status": "ok"}},

  {"comment": "Measurements on the block and against a datum."},
  {"expect": {"query": {"query": "measure", "a": "Body1/F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})",
    "b": "Body1/F2:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"},
    "result": {"a": {"kind": "face", "area": 2321.4601836602552}, "between": {"distance": 30, "angle": 3.141592653589793}}}},
  {"expect": {"query": {"query": "measure", "a": {"body": "F2.b0", "face": "F3:side(c9)"}},
    "result": {"a": {"kind": "face", "area": 942.4777960769379, "circle": {"radius": 5}}}}},
  {"expect": {"query": {"query": "measure", "a": "Body1/E{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F2:side(c1[c4,c2])}",
    "b": "Body1/F2:side(c2[c1,c3])"}, "result": {"a": {"kind": "edge", "length": 60}, "between": {"distance": 0, "angle": 1.5707963267948966}}}},
  {"expect": {"query": {"query": "measure", "a": "F10", "b": "Body1/F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"},
    "result": {"a": {"kind": "face"}, "between": {"distance": 10, "angle": 0}}}},
  {"expect": {"query": {"query": "measure", "a": "Body1/V{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F2:side(c2[c1,c3])|F2:side(c3[c2,c4])}"},
    "result": {"a": {"kind": "vertex", "point": [60, 40, 30]}}}},
  {"expect": {"query": {"query": "measure", "a": "Body1"}, "result": {"a": {"kind": "body", "volume": 69643.80550980767}}}}
]
