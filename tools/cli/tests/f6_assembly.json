[
  {"comment": "Components and occurrences (F6). Plate (C1): a 40 x 20 x 5 block in its own coordinates, Sketch1 F1 and Extrude1 F2 (d1, d2 the rectangle, d3 the distance)."},
  {"cmd": "create_component", "name": "Plate"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"expect": {"bodies": 1, "instances": 1, "body": "Body1", "volume": 4000}},
  {"expect": {"query": {"query": "components"}, "result": {"active": "C1",
    "components": [{"uid": "C0", "name": "Root", "features": []},
                   {"uid": "C1", "name": "Plate", "features": ["F1", "F2"], "bodies": ["F2.b0"], "occurrences": 1}]}}},

  {"comment": "A second occurrence 50 mm along Y (copy and paste into the root), and the first turned a quarter about Z and moved 100 mm along X: one body, two placements."},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "copy_occurrence", "occurrence": "Plate:1", "transform": {"translation": [0, 50, 0]}},
  {"cmd": "set_occurrence_transform", "occurrence": "Plate:1",
    "transform": {"translation": [100, 0, 0], "rotation": {"axis": [0, 0, 1], "angle": 1.5707963267948966}}},
  {"expect": {"bodies": 1, "instances": 2, "world_volume": 8000}},
  {"expect": {"occurrence": "Plate:2", "body": "Body1", "volume": 4000}},
  {"expect": {"occurrence": "Plate:2", "body": "Body1", "center": [20, 60, 2.5],
    "bbox": {"min": [0, 50, 0], "max": [40, 70, 5]}, "tolerance": 1e-6}},
  {"expect": {"occurrence": "Plate:1", "body": "Body1", "center": [90, 20, 2.5],
    "bbox": {"min": [80, 0, 0], "max": [100, 40, 5]}, "tolerance": 1e-6}},

  {"comment": "A subassembly: Pin (C2) placed in the plate at (10, 10, 5), a cylinder of diameter 4 and height 10 (Cylinder1 F3, d4 d5). Every plate brings its pin: 4 placed bodies."},
  {"cmd": "activate_component", "component": "Plate"},
  {"cmd": "create_component", "name": "Pin", "transform": {"translation": [10, 10, 5]}},
  {"cmd": "add_feature", "def": {"type": "cylinder", "plane": "xy", "center": [0, 0],
    "diameter": 4, "height": 10, "operation": "new_body"}},
  {"expect": {"feature": "Cylinder1", "status": "ok", "bodies": 2, "instances": 4,
    "world_volume": 8251.327412287183}},
  {"expect": {"occurrence": "Plate:2/Pin:1", "body": "Body2", "volume": 125.66370614359172,
    "center": [10, 60, 10], "bbox": {"min": [8, 58, 5], "max": [12, 62, 15]}, "tolerance": 1e-6}},
  {"expect": {"occurrence": "Plate:1/Pin:1", "body": "Body2", "center": [90, 10, 10], "tolerance": 1e-6}},
  {"expect": {"query": {"query": "instances", "properties": true}, "tolerance": 1e-6, "result": [
    {"occurrence": "Plate:1", "name": "Body1", "volume": 4000, "center": [90, 20, 2.5]},
    {"occurrence": "Plate:1/Pin:1", "name": "Body2", "volume": 125.66370614359172, "center": [90, 10, 10]},
    {"occurrence": "Plate:2", "name": "Body1", "volume": 4000, "center": [20, 60, 2.5]},
    {"occurrence": "Plate:2/Pin:1", "name": "Body2", "volume": 125.66370614359172, "center": [10, 60, 10]}]}},

  {"comment": "One definition: the plate 8 mm thick in both occurrences."},
  {"cmd": "activate_component", "component": "C0"},
  {"cmd": "set_parameter", "name": "d3", "value": 8},
  {"expect": {"instances": 4, "world_volume": 13051.327412287183}},
  {"expect": {"occurrence": "Plate:2", "body": "Body1", "bbox": {"min": [0, 50, 0], "max": [40, 70, 8]}, "tolerance": 1e-6}},

  {"comment": "Visibility: a hidden plate hides its pin too."},
  {"cmd": "set_occurrence_visible", "occurrence": "Plate:2", "visible": false},
  {"expect": {"instances": 2, "world_volume": 6525.663706143592}},
  {"cmd": "undo"},
  {"expect": {"instances": 4}},

  {"comment": "A timeline move of an occurrence (Move1 F4, 30 mm up), then grounded: the move fails and the plate stays."},
  {"cmd": "add_feature", "def": {"type": "move_occurrence", "occurrences": ["O2"],
    "transform": {"type": "translate_xyz", "x": 0, "y": 0, "z": 30}}},
  {"expect": {"feature": "Move1", "status": "ok"}},
  {"expect": {"occurrence": "Plate:2", "body": "Body1", "bbox": {"min": [0, 50, 30], "max": [40, 70, 38]}, "tolerance": 1e-6}},
  {"cmd": "ground_occurrence", "occurrence": "Plate:2"},
  {"expect": {"feature": "Move1", "status": "error", "error_contains": "Plate:2 is grounded"}},
  {"expect": {"occurrence": "Plate:2", "body": "Body1", "bbox": {"min": [0, 50, 0], "max": [40, 70, 8]}, "tolerance": 1e-6}},
  {"cmd": "undo"},

  {"comment": "Capture Position: Position1 (F5) puts the plate 50 mm along -Y after the move."},
  {"cmd": "set_occurrence_transform", "occurrence": "Plate:2", "transform": {"translation": [0, -50, 0]}, "capture": true},
  {"expect": {"feature": "Position1", "status": "ok"}},
  {"expect": {"occurrence": "Plate:2", "body": "Body1", "center": [20, -40, 4],
    "bbox": {"min": [0, -50, 0], "max": [40, -30, 8]}, "tolerance": 1e-6}},
  {"expect": {"occurrence": "Plate:2/Pin:1", "body": "Body2", "center": [10, -40, 10], "tolerance": 1e-6}},
  {"expect": {"query": {"query": "components"}, "result": {"active": "C0",
    "occurrences": [{"uid": "O1", "name": "Plate:1", "children": [{"uid": "O3", "name": "Pin:1", "path": "Plate:1/Pin:1"}]},
                    {"uid": "O2", "name": "Plate:2", "grounded": false,
                     "world": [[1, 0, 0, 0], [0, 1, 0, -50], [0, 0, 1, 0], [0, 0, 0, 1]]}]}}}
]
