    "angle": 1.5707963267948966, "length": {"mode": "tangent", "value": 30}, "position": "inside"}},
  {"expect": {"feature": "F6", "status": "ok", "bodies": 1}},
  {"expect": {"query": {"query": "sheet_process"}, "result": {"process": "board"}}}
