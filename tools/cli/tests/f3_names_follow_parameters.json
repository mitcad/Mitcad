[
  {"comment": "Names of sweeps, lofts and coils (F3) stay through parameter edits, so features that refer to their faces and edges keep working. Sketch1 (F1): a horizontal path line from a fixed origin, its length the parameter path_len (50)."},
  {"cmd": "add_parameter", "name": "path_len", "value": 50},
  {"cmd": "add_parameter", "name": "side", "value": 10},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_line", "sketch": "F1", "start": [0, 0], "end": [50, 0]},
  {"cmd": "sketch.set_fixed", "sketch": "F1", "entities": ["p2"]},
  {"cmd": "sketch.add_constraint", "sketch": "F1", "constraint": {"type": "horizontal", "line": "c1"}},
  {"cmd": "sketch.add_dimension", "sketch": "F1", "dimension": {"type": "length", "line": "c1"}, "value": "path_len"},
  {"comment": "Sketch2 (F2) on YZ: a square of side `side` from (-5, -5), swept along the line (Sweep1, F3), and an edge of its far end rounded (Fillet1, F4)."},
  {"cmd": "sketch.create", "plane": "yz"},
  {"cmd": "sketch.add_rectangle", "sketch": "F2", "corner": [-5, -5], "width": "side", "height": "side"},
  {"cmd": "add_feature", "def": {"type": "sweep",
    "profiles": [{"sketch": "F2", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "path": {"sketch": "F1", "curves": ["c1"]}, "operation": "new_body"}},
  {"expect": {"feature": "Sweep1", "status": "ok", "body": "F3.b0", "volume": 5000, "tolerance": 1e-6}},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F3.b0",
    "edges": ["E{F3:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F3:side(c1[c4,c2])}"], "radius": 2}},
  {"expect": {"feature": "Fillet1", "status": "ok", "body": "F3.b0", "volume": 4991.4159265358979, "tolerance": 1e-6}},
  {"comment": "A longer path and a bigger square: the sweep's faces keep their names and the fillet its edge."},
  {"cmd": "set_parameter", "name": "path_len", "value": 80},
  {"expect": {"feature": "Fillet1", "status": "ok", "body": "F3.b0", "volume": 7991.4159265358979, "tolerance": 1e-6}},
  {"cmd": "set_parameter", "name": "side", "value": 12},
  {"expect": {"feature": "Fillet1", "status": "ok", "body": "F3.b0", "volume": 11509.699111843078, "tolerance": 1e-6}},

  {"comment": "A loft from that square to a 20 mm square on a plane `path_len` + 40 out along X (Plane1 F5 from YZ, Sketch3 F6; Loft1 F7), and a hole-like extrusion cut from its end cap (Sketch4 F8 on the cap, Extrude1 F9)."},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "offset", "plane": "yz", "distance": "path_len + 40"}}},
  {"cmd": "sketch.create", "plane": "F5"},
  {"cmd": "sketch.add_rectangle", "sketch": "F6", "corner": [-10, -10], "width": 20, "height": 20},
  {"cmd": "add_feature", "def": {"type": "loft", "sections": [
    {"type": "profile", "sketch": "F2", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"},
    {"type": "profile", "sketch": "F6", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "operation": "new_body"}},
  {"expect": {"feature": "Loft1", "status": "ok", "body": "F7.b0", "volume": 31360, "tolerance": 1e-6}},
  {"cmd": "sketch.create", "plane": {"face": "F7:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})", "body": "F7.b0"}},
  {"cmd": "sketch.add_circle", "sketch": "F8", "center": [0, 0], "diameter": 6},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F8", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": -10}, "operation": "cut", "participants": ["F7.b0"]}},
  {"expect": {"feature": "Extrude1", "status": "ok", "body": "F7.b0", "volume": 31077.256661176918, "tolerance": 1e-6}},
  {"comment": "Moving the end plane keeps the cap's name, the sketch on it and the cut."},
  {"cmd": "set_parameter", "name": "path_len", "value": 60},
  {"expect": {"feature": "Extrude1", "status": "ok", "body": "F7.b0", "volume": 25850.589994510254, "tolerance": 1e-6}},

  {"comment": "A coil whose revolutions are the unitless parameter turns (Coil1, F10): fewer turns, the same cap names."},
  {"cmd": "add_parameter", "name": "turns", "expression": "3", "unit": ""},
  {"cmd": "add_feature", "def": {"type": "coil", "plane": "xy", "center": [0, 200], "diameter": 40,
    "helix": {"type": "revolutions_and_pitch", "revolutions": "turns", "pitch": 10}, "section_size": 4,
    "operation": "new_body"}},
  {"expect": {"feature": "Coil1", "status": "ok", "body": "F10.b0", "volume": 4752.386440264496, "tolerance": 1e-5,
    "has_face": "F10:start"}},
  {"cmd": "set_parameter", "name": "turns", "value": 2},
  {"expect": {"body": "F10.b0", "volume": 3168.2576268429974, "tolerance": 1e-5, "has_face": "F10:end"}}
]
