  {"comment": "T0 models of fillets and chamfers (fil_*, cha_*). Each uses a 60 x 40 x 20 block: a sketch with lines c1..c4 (c1 along y = y0, c2 at x = x0 + 60, c3 at y = y0 + 40, c4 at x = x0) and its extrusion."},

  {"comment": "fil_two_edge_sets: Sketch1 F1, Extrude1 F2. 5 mm at the vertical edge (0, 0) and 2 mm at (60, 40) in one fillet."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F2.b0", "sets": [
    {"edges": ["E{F2:side(c1[c4,c2])|F2:side(c4[c3,c1])}"], "size": {"type": "constant", "radius": 5}, "tangent_chain": false},
    {"edges": ["E{F2:side(c2[c1,c3])|F2:side(c3[c2,c4])}"], "size": {"type": "constant", "radius": 2}, "tangent_chain": false}]}},
  {"expect": {"feature": "Fillet1", "status": "ok", "body": "F2.b0", "volume": 47875.53093477052, "faces": 8,
    "has_face": "F3:fillet(E{F2:side(c2[c1,c3])|F2:side(c3[c2,c4])})"}},

