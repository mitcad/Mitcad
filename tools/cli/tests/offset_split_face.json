[
  {"comment": "Offset Face on a piece of a split face (mitcad#1928): a 60 x 40 x 20 block's top split at 20 mm from its end, the 20 x 40 piece (#0) offset alone by -1 mm and, on a second block, by +1 mm. The piece moves, the other piece stays, the seam becomes a 40 x 1 step named after the moved piece: a valid body of 48000 -/+ 800 mm3 with 8 faces."},

  {"comment": "Sketch1 F1, Extrude1 F2, SplitFace1 F3 at x = 20, OffsetFace1 F4: the piece 1 mm in."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "split_face", "body": "F2.b0",
    "faces": ["F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"],
    "tool": {"type": "plane", "origin": [20, 0, 0], "normal": [1, 0, 0]}}},
  {"expect": {"feature": "SplitFace1", "status": "ok", "body": "F2.b0", "volume": 48000, "faces": 7}},
  {"cmd": "add_feature", "def": {"type": "offset_face", "body": "F2.b0",
    "faces": ["F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})#0"], "distance": -1}},
  {"expect": {"feature": "OffsetFace1", "status": "ok", "body": "F2.b0", "volume": 47200, "faces": 8,
    "has_face": "F4:step(F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})#0)"}},
  {"expect": {"body": "F2.b0", "has_face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})#0"}},
  {"expect": {"body": "F2.b0", "has_face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})#1"}},

