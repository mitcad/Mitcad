[
  {"comment": "SPDX-License-Identifier: MIT. Mesh tools that change a mesh's shape (mitcad#2515) through the OCCT kernel. Two boxes 20 on a side, one at the origin (F1) and one moved by 10 along X and Y (F3), and a cylinder 20 across and 10 high at x 60 (F5) are written to STL files and read back as the mesh bodies cube (Base1 F2, F2.b0), cube2 (Base2 F4, F4.b0) and cyl (Base3 F6, F6.b0); the solids are removed (F7); Plane1 (F8) lies 5 above XY. Files go to the working directory."},
  {"cmd": "add_feature", "def": {"type": "box", "plane": {"type": "origin", "plane": "xy"}, "corner": [0, 0],
    "length": 20, "width": 20, "height": 20, "operation": "new_body"}},
  {"cmd": "export", "path": "cube.stl", "bodies": ["F1.b0"]},
  {"cmd": "import_file", "path": "cube.stl"},
  {"cmd": "add_feature", "def": {"type": "box", "plane": {"type": "origin", "plane": "xy"}, "corner": [10, 10],
    "length": 20, "width": 20, "height": 20, "operation": "new_body"}},
  {"cmd": "export", "path": "cube2.stl", "bodies": ["F3.b0"]},
  {"cmd": "import_file", "path": "cube2.stl"},
  {"cmd": "add_feature", "def": {"type": "cylinder", "plane": "xy", "center": [60, 0], "diameter": 20, "height": 10,
    "operation": "new_body"}},
  {"cmd": "export", "path": "cyl.stl", "bodies": ["F5.b0"]},
  {"cmd": "import_file", "path": "cyl.stl"},
  {"cmd": "add_feature", "def": {"type": "remove_body", "bodies": ["F1.b0", "F3.b0", "F5.b0"]}},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "offset", "plane": "xy", "distance": 5}}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F2.b0"}, "result": {"closed": true, "volume": 8000}}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F4.b0"}, "result": {"closed": true, "volume": 8000}}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F6.b0"}, "result": {"closed": true}}},

  {"comment": "Combine: the boxes overlap in 10 x 10 x 20. Joined (F9) 14000, cut (F10) 6000, intersected (F11) 2000, each closed; merged (F12) both boxes in one body, 16000."},
  {"cmd": "add_feature", "def": {"type": "mesh_combine", "target": "F2.b0", "tools": ["F4.b0"], "operation": "join"}},
  {"expect": {"feature": "MeshCombine1", "status": "ok"}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F9.b0"}, "result": {"closed": true, "volume": 14000}}},
  {"cmd": "add_feature", "def": {"type": "mesh_combine", "target": "F2.b0", "tools": ["F4.b0"], "operation": "cut"}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F10.b0"}, "result": {"closed": true, "volume": 6000}}},
  {"cmd": "add_feature", "def": {"type": "mesh_combine", "target": "F2.b0", "tools": ["F4.b0"], "operation": "intersect"}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F11.b0"}, "result": {"closed": true, "volume": 2000}}},
  {"cmd": "add_feature", "def": {"type": "mesh_combine", "target": "F2.b0", "tools": ["F4.b0"], "operation": "merge"}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F12.b0"}, "result": {"closed": true, "volume": 16000}}},

  {"comment": "Plane Cut of cube by Plane1 (F13): 6000 above and 2000 below, both capped, closed; not capped, the piece below only (F14): open with one hole."},
  {"cmd": "add_feature", "def": {"type": "mesh_plane_cut", "body": "F2.b0", "plane": "F8"}},
  {"expect": {"feature": "PlaneCut1", "status": "ok"}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F13.b0"}, "result": {"closed": true, "volume": 6000}}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F13.b1"}, "result": {"closed": true, "volume": 2000}}},
  {"cmd": "add_feature", "def": {"type": "mesh_plane_cut", "body": "F2.b0", "plane": "F8", "keep": "below", "cap": false}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F14.b0"}, "result": {"closed": false, "holes": 1}}},

  {"comment": "Offset of cube 2 mm outward (F15): each face 2 mm out, the corners sharp, 24 on a side. Shell 2 mm inward (F16): the box less a 16 mm cube; open at the top, the opening picked by a lasso seen from above (F17): less 16 x 16 x 18."},
  {"cmd": "add_feature", "def": {"type": "mesh_offset", "body": "F2.b0", "distance": 2}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F15.b0"}, "result": {"closed": true, "volume": 13824}}},
  {"cmd": "add_feature", "def": {"type": "mesh_offset", "body": "F2.b0", "mode": "shell", "side": "inward", "distance": 2}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F16.b0"}, "result": {"closed": true, "volume": 3904}}},
  {"cmd": "add_feature", "def": {"type": "mesh_offset", "body": "F2.b0", "mode": "shell", "side": "inward", "distance": 2,
    "openings": {"lassos": [{"normal": [0, 0, 1], "points": [[-5, -5, 20], [25, -5, 20], [25, 25, 20], [-5, 25, 20]]}]}}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F17.b0"}, "result": {"closed": true, "volume": 3392}}},

  {"comment": "Align cube2 onto cube by four corner pairs, then best fit (F18): back on cube."},
  {"cmd": "add_feature", "def": {"type": "mesh_align", "body": "F4.b0", "target": "F2.b0",
    "pairs": [{"from": [10, 10, 0], "to": [0, 0, 0]}, {"from": [30, 10, 0], "to": [20, 0, 0]},
              {"from": [10, 30, 0], "to": [0, 20, 0]}, {"from": [10, 10, 20], "to": [0, 0, 20]}]}},
  {"expect": {"feature": "MeshAlign1", "status": "ok"}},
  {"expect": {"body": "F18.b0", "min": [0, 0, 0], "max": [20, 20, 20], "tolerance": 1e-4}},

  {"comment": "Smooth cyl (F19): its rims (90 degrees) stay sharp, the side's facets (less than 60 degrees apart) do not, the mesh closed."},
  {"cmd": "add_feature", "def": {"type": "mesh_smooth", "body": "F6.b0", "amount": 0.5, "passes": 3, "sharp_angle": "60 deg"}},
  {"expect": {"feature": "Smooth1", "status": "ok"}},
  {"expect": {"query": {"query": "mesh_stats", "body": "F19.b0"}, "result": {"closed": true}}}
]
