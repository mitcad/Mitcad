        "features": [
          { "uid": "F1", "name": "Head", "type": "cylinder", "plane": "xy", "center": [0, 0],
            "diameter": "dk", "height": "k", "operation": "new_body" },
          { "uid": "F2", "name": "Shank", "type": "cylinder", "plane": "xy", "center": [0, 0],
