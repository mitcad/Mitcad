          { "name": "wide", "expression": "20 mm", "unit": "mm" },
          { "name": "t", "expression": "4 mm", "unit": "mm" }
        ],
        "features": [
          { "uid": "F1", "name": "Arm a", "type": "box", "plane": "xy", "corner": [0, -10],
