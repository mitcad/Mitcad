        "systems": [{ "type": "B", "slot": 8 }],
        "frames": [{ "name": "mount_a", "kind": "face" }, { "name": "mount_b", "kind": "face" }],
        "connector": {
          "junctions": ["L", "T"],
          "space": "inner_corner",
          "mates": [{ "frame": "mount_a", "to": "slot" }, { "frame": "mount_b", "to": "slot" }],
          "fasteners": [{ "frame": "mount_a",
                          "nut": { "library": "example-profiles", "component": "tnut8" },
