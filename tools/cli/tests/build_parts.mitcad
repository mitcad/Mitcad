          { "name": "nl", "expression": "10 mm", "unit": "mm" },
          { "name": "nw", "expression": "16 mm", "unit": "mm" },
          { "name": "nh", "expression": "4 mm", "unit": "mm" }
        ],
        "features": [
          { "uid": "F1", "name": "Block", "type": "box", "plane": "xy", "corner": [-5, -8],
            "length": "nl", "width": "nw", "height": "nh", "operation": "new_body" },
          { "uid": "F2", "name": "mount:slot", "type": "joint_origin",
            "geometry": { "origin": [0, 0, 0], "normal": [0, 0, 1], "x_axis": [1, 0, 0] } }
        ]
      } },
      "build": {
        "role": "fastener",
        "systems": [{ "type": "B", "slot": 8 }],
        "frames": [{ "name": "slot", "kind": "slot" }]
      },
      "supplier": "Example supplier",
      "part_number": "TN8"
    },
    {
      "id": "S4",
      "library": { "library": "example-profiles", "url": "https://example.org/example-profiles.git",
                   "rev": "1111111111111111111111111111111111111111", "label": "v1.0.0",
                   "component": "screw6", "path": "screws/screw6.mitcad", "license": "MIT" },
      "name": "Screw M6x12",
      "design": { "text": {
        "format": "mitcad", "version": 2, "units": { "length": "mm", "angle": "deg" },
        "parameters": [
          { "name": "dk", "expression": "10 mm", "unit": "mm" },
          { "name": "k", "expression": "6 mm", "unit": "mm" },
          { "name": "d", "expression": "6 mm", "unit": "mm" },
          { "name": "shank", "expression": "-12 mm", "unit": "mm" }
