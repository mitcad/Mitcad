[
  {"comment": "SPDX-License-Identifier: MIT. A base view of a sheet-metal body's Flat Pattern (mitcad#2280) through OCCT: the L of sheet_flat_dxf.json (t = 2, r = 3, K = 0.3, a 35 x 20 Face at x = -30..5 with a 4 mm hole at (-15, 10), a 90 degree Flange on its edge at x = 5, tangent length 15, inside), its blank 50.654866776461628 x 20 with the bend's centre line at x = 2.827433388230814 (a down bend seen from the front). The view at 1:1 with its middle at (150, 150) puts the blank's left edge at x = 124.672566611769186 and its right end at 175.327433388230814 on the sheet, the bend line at x = 157.5. A dimension of the bend line alone and one between the blank's ends picked on the sheet; seen from the back the bend is an up bend in the other line type; a longer flange lengthens the blank; the bend notes off; a scale that leaves the body no sheet metal keeps the view, not drawn, until it is suppressed."},
  {"cmd": "add_feature", "def": {"type": "sheet_rules", "thickness": 2, "bend_radius": 3, "allowance": {"type": "k_factor", "k": 0.3}, "reference_side": "back", "bend_relief": {"type": "rectangular", "width": 2, "depth": 3}, "corner_relief": {"type": "round", "width": 2, "depth": 3}}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F2", "corner": [-30, 0], "width": 35, "height": 20},
  {"cmd": "sketch.add_circle", "sketch": "F2", "center": [-15, 10], "diameter": 4},
  {"cmd": "add_feature", "def": {"type": "sheet_face", "rules": "F1", "profiles": [{"sketch": "F2", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}]}},
  {"cmd": "add_feature", "def": {"type": "sheet_flange", "body": "F3.b0", "boundary": {"panel": {"feature": "F3", "slot": 0}, "curve": {"type": "sketch", "sketch": "F2", "segment": "c2[c1,c3]"}}, "angle": 1.5707963267948966, "length": {"mode": "tangent", "value": 15}, "position": "inside", "offsets": {"start": 0, "end": 0}}},
  {"expect": {"feature": "F4", "status": "ok", "bodies": 1}},
  {"comment": "No Flat Pattern item: the view takes a new item's settings (the front), as the cut sheet does; the Front direction given is the pattern's frame's all the same."},
  {"cmd": "add_drawing", "size": "A3"},
  {"cmd": "add_drawing_view", "drawing": "D1", "type": "base", "direction": "front", "subject": {"type": "flat_pattern", "body": "F3.b0"}, "at": [150, 150], "scale": "1:1"},
  {"expect": {"query": {"query": "drawing", "drawing": "D1", "geometry": false}, "result": {"sheets": [{"views": [{"id": 1, "type": "base", "subject": {"type": "flat_pattern", "body": "F3.b0"}, "direction": {"toward_eye": [0, 0, 1], "x_axis": [1, 0, 0]}, "box": [[124.672566611769186, 140], [175.327433388230814, 160]], "flat_pattern": {"body": "F3.b0", "size": [50.654866776461628, 20], "bends": 1, "up": 0, "down": 1, "bend_notes": true, "bend_lines": [{"bend": {"feature": "F4", "slot": 0}, "piece": 0, "up": false, "pen": "phantom", "angle": 90, "radius": 3, "note": "DOWN 90° R3"}]}}]}]}}},
  {"comment": "The bend line's length, picked as a line of its own (a dimension whose pick chooses its type: one straight pick is a linear dimension from its start to its end); the blank's developed length between its ends, picked on the sheet."},
  {"cmd": "add_drawing_annotation", "drawing": "D1", "view": 1, "type": "dimension", "picks": [{"body": "F3.b0", "bend": {"bend": {"feature": "F4", "slot": 0}}}], "at": [165, 150]},
  {"cmd": "add_drawing_annotation", "drawing": "D1", "view": 1, "type": "linear", "along": "horizontal", "picks": [[124.672566611769186, 150], [175.327433388230814, 150]], "at": [150, 130]},
  {"expect": {"query": {"query": "drawing", "drawing": "D1", "geometry": false}, "result": {"sheets": [{"annotations": [{"id": 1, "type": "linear", "broken": false, "value": 20}, {"id": 2, "type": "linear", "broken": false, "value": 50.654866776461628}]}]}}},
  {"comment": "Seen from the back: mirrored, the eye on the other side, the bend up in the other line type."},
  {"cmd": "set_flat_pattern", "body": "F3.b0", "reference_side": "back"},
  {"expect": {"query": {"query": "drawing", "drawing": "D1", "geometry": false}, "result": {"sheets": [{"views": [{"id": 1, "direction": {"toward_eye": [0, 0, -1], "x_axis": [-1, 0, 0]}, "flat_pattern": {"size": [50.654866776461628, 20], "bends": 1, "up": 1, "down": 0, "bend_lines": [{"up": true, "pen": "chain", "note": "UP 90° R3"}]}}], "annotations": [{"id": 1, "broken": false, "value": 20}, {"id": 2, "broken": false, "value": 50.654866776461628}]}]}}},
  {"comment": "A flange 10 longer: the blank 10 longer, the bend line as long as before."},
  {"cmd": "edit_feature", "uid": "F4", "def": {"type": "sheet_flange", "body": "F3.b0", "boundary": {"panel": {"feature": "F3", "slot": 0}, "curve": {"type": "sketch", "sketch": "F2", "segment": "c2[c1,c3]"}}, "angle": 1.5707963267948966, "length": {"mode": "tangent", "value": 25}, "position": "inside", "offsets": {"start": 0, "end": 0}}},
  {"expect": {"query": {"query": "drawing", "drawing": "D1", "geometry": false}, "result": {"sheets": [{"views": [{"id": 1, "flat_pattern": {"size": [60.654866776461628, 20], "bends": 1}}], "annotations": [{"id": 1, "broken": false, "value": 20}, {"id": 2}]}]}}},
  {"comment": "The bend notes off: the lines stay."},
  {"cmd": "edit_drawing_view", "drawing": "D1", "view": 1, "bend_notes": false},
  {"expect": {"query": {"query": "drawing", "drawing": "D1", "geometry": false}, "result": {"sheets": [{"views": [{"id": 1, "subject": {"type": "flat_pattern", "body": "F3.b0", "bend_notes": false}, "flat_pattern": {"bend_notes": false, "bend_lines": [{"up": true, "note": null}]}}]}]}}},
  {"comment": "A scale leaves the body no sheet metal: the view is kept, not drawn, with the reason; suppressed, the view is drawn again."},
  {"cmd": "add_feature", "def": {"type": "scale", "bodies": ["F3.b0"], "point": {"type": "origin"}, "scale": {"type": "uniform", "factor": 2}}},
  {"expect": {"query": {"query": "drawing", "drawing": "D1", "geometry": false}, "result": {"sheets": [{"views": [{"id": 1, "broken": true}]}]}}},
  {"cmd": "suppress_feature", "uid": "F5"},
  {"expect": {"query": {"query": "drawing", "drawing": "D1", "geometry": false}, "result": {"sheets": [{"views": [{"id": 1, "flat_pattern": {"size": [60.654866776461628, 20], "bends": 1}}]}]}}}
