    "start": {"type": "offset", "offset": -10}, "extent": {"type": "distance", "distance": 9},
    "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [-20, -50], "width": 10, "height": 150},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "start": {"type": "offset", "offset": -5}, "extent": {"type": "distance", "distance": 15},
    "operation": "join", "participants": ["F2.b0"]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F5", "corner": [120, -50], "width": 10, "height": 150},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F5", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "start": {"type": "offset", "offset": -5}, "extent": {"type": "distance", "distance": 15},
    "operation": "join", "participants": ["F2.b0"]}},
  {"expect": {"bodies": 1, "body": "F2.b0", "volume": 235500}},

  {"comment": "The chain of the report on XY (Sketch4 F7): a line along x, a slanted line at 45 degrees and a line along x again, (0, 0) - (40, 0) - (70, 30) - (110, 30), curves c1, c4 and c7, between the walls and over the plate."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_line", "sketch": "F7", "start": [0, 0], "end": [40, 0]},
  {"cmd": "sketch.add_line", "sketch": "F7", "start": [40, 0], "end": [70, 30]},
  {"cmd": "sketch.add_line", "sketch": "F7", "start": [70, 30], "end": [110, 30]},

  {"comment": "Rib1 (F8), 4 thick about the sketch plane, Depth 30 Normal to Curves (Corners Sharp): its far side is each line moved 30 to its left, the copies meeting where they cross, a band of 30 * (80 + 30 sqrt(2)) mm2 (the inner corner's cut equals the outer corner's run on); 3 mm of the rib stand above the plate: 235500 + 3 * (2400 + 900 sqrt(2)). Each face of the far side lies 30 from the face its curve makes, parallel to it."},
  {"cmd": "add_feature", "def": {"type": "rib", "curves": {"sketch": "F7", "curves": ["c1", "c4", "c7"]}, "thickness": 4,
    "extent": {"type": "depth", "depth": 30}, "direction": "normal"}},
  {"expect": {"feature": "Rib1", "status": "ok"}},
  {"expect": {"bodies": 1, "body": "F2.b0", "volume": 246518.37661840735, "has_face": "F8:end(c4)", "no_face": "F8:corner(c4)"}},
  {"expect": {"query": {"query": "measure", "a": "Body1/F8:end(c1)", "b": "Body1/F8:side(c1)"},
    "result": {"between": {"distance": 30, "offset": 30}}}},
  {"expect": {"query": {"query": "measure", "a": "Body1/F8:end(c4)", "b": "Body1/F8:side(c4)"},
    "result": {"between": {"distance": 30, "offset": 30}}}},
  {"expect": {"query": {"query": "measure", "a": "Body1/F8:end(c7)", "b": "Body1/F8:side(c7)"},
    "result": {"between": {"distance": 30, "offset": 30}}}},

  {"comment": "Corners Round: the outer corner at (70, 30) is an arc of radius 30 about it (the face corner(c4)), so the band is 900 (tan(pi / 8) - pi / 8) smaller: 3300 + 112.5 pi mm2."},
  {"cmd": "edit_feature", "uid": "F8", "def": {"type": "rib", "curves": {"sketch": "F7", "curves": ["c1", "c4", "c7"]}, "thickness": 4,
    "extent": {"type": "depth", "depth": 30}, "direction": "normal", "corners": "round"}},
  {"expect": {"feature": "Rib1", "status": "ok"}},
  {"expect": {"bodies": 1, "body": "F2.b0", "volume": 246460.28752058657, "has_face": "F8:corner(c4)"}},
  {"expect": {"query": {"query": "measure", "a": "Body1/F8:end(c4)", "b": "Body1/F8:side(c4)"},
    "result": {"between": {"distance": 30, "offset": 30}}}},

  {"comment": "Flipped (Corners Sharp), the far side is 30 to the chain's right: the outer and inner corners change places and the band keeps its area."},
  {"cmd": "edit_feature", "uid": "F8", "def": {"type": "rib", "curves": {"sketch": "F7", "curves": ["c1", "c4", "c7"]}, "thickness": 4,
    "extent": {"type": "depth", "depth": 30}, "direction": "normal", "flip": true}},
  {"expect": {"feature": "Rib1", "status": "ok"}},
  {"expect": {"bodies": 1, "body": "F2.b0", "volume": 246518.37661840735}},
  {"expect": {"query": {"query": "measure", "a": "Body1/F8:end(c1)", "b": "Body1/F8:side(c1)"},
    "result": {"between": {"distance": 30, "offset": 30}}}},

  {"comment": "A Draft Angle of 1 degree: at a distance u from the curves the rib is 4 + 2 u tan(1 deg) thick, so above the plate (3 + u tan(1 deg)) over the band: (80 + 30 sqrt(2)) (90 + 450 tan(1 deg)) with sharp corners."},
  {"cmd": "edit_feature", "uid": "F8", "def": {"type": "rib", "curves": {"sketch": "F7", "curves": ["c1", "c4", "c7"]}, "thickness": 4,
    "extent": {"type": "depth", "depth": 30}, "direction": "normal", "draft_angle": "1 deg"}},
  {"expect": {"feature": "Rib1", "status": "ok"}},
  {"expect": {"bodies": 1, "body": "F2.b0", "volume": 247480.00901479664}},

  {"comment": "The same with Corners Round: the round corner's sides are cones about the chain's corner."},
  {"cmd": "edit_feature", "uid": "F8", "def": {"type": "rib", "curves": {"sketch": "F7", "curves": ["c1", "c4", "c7"]}, "thickness": 4,
    "extent": {"type": "depth", "depth": 30}, "direction": "normal", "corners": "round", "draft_angle": "1 deg"}},
  {"expect": {"feature": "Rib1", "status": "ok"}},
  {"expect": {"bodies": 1, "body": "F2.b0", "volume": 247415.16025714861}},

  {"comment": "Extend Ends: each end continued along its line 10 to its wall, 30 wide (from the curve's end to the far side's), 3 above the plate: 2 * 900 more."},
  {"cmd": "edit_feature", "uid": "F8", "def": {"type": "rib", "curves": {"sketch": "F7", "curves": ["c1", "c4", "c7"]}, "thickness": 4,
