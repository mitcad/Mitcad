  {"comment": "Closed: Sketch4 F10, Extrude4 F11, Shell4 F12 2 mm inside with no face removed, the bottom 5 mm: a void 56 x 36 from z = 5 to z = 18."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F10", "corner": [300, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F10", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "shell", "body": "F11.b0", "inside": 2,
    "face_thicknesses": [{"faces": ["F11:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"], "inside": 5}]}},
  {"expect": {"feature": "Shell4", "status": "ok", "body": "Body4", "volume": 21792}},

  {"comment": "A cylinder's side: Sketch5 F13 a circle of diameter 40, Extrude5 F14 30 high, Shell5 F15 2 mm inside with the top open, the side 4 mm: pi (20^2 30 - 16^2 28)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F13", "center": [500, 20], "diameter": 40},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F13", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 30}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "shell", "body": "F14.b0", "faces": ["F14:end(r{c1})"], "inside": 2,
    "face_thicknesses": [{"faces": ["F14:side(c1)"], "inside": 4}]}},
  {"expect": {"feature": "Shell5", "status": "ok", "body": "Body5", "volume": 15180.175702145881,
    "has_face": "F15:offset(F14:side(c1))"}},

  {"comment": "Rounded inside: Sketch6 F16, Extrude6 F17, Shell6 F18 as Shell1 with rounded corners: the block's edges are convex, the inside of the wall has no rounding, and the volume is Shell1's."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F16", "corner": [600, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F16", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "shell", "body": "F17.b0",
