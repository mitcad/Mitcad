    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "shell", "body": "F20.b0",
    "faces": ["F20:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"], "outside": 2, "rounded": true,
    "face_thicknesses": [{"faces": ["F20:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"], "outside": 5}]}},
