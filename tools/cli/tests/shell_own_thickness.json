    "face_thicknesses": [{"faces": ["F17:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"], "inside": 5}]}},
  {"expect": {"feature": "Shell6", "status": "ok", "body": "Body6", "volume": 17760}},

  {"comment": "Rounded outside is refused: the rounding along the bottom's edges would join the 5 mm bottom to the 2 mm sides (Sketch7 F19, Extrude7 F20, Shell7 F21); the block stays as it was."},
