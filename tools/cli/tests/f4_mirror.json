[
  {"comment": "The reference models mir_body and mir_body_combine (group diff_mirror_combine): a 20 x 20 x 10 block at x 0..20 (Sketch1 F1, Extrude1 F2) mirrored across the YZ origin plane by Mirror1 (F3)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 20, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "mirror", "objects": {"type": "bodies", "bodies": ["F2.b0"]},
    "plane": {"type": "origin", "plane": "yz"}}},
  {"comment": "mir_body: two touching bodies (8000 mm3); the copy's faces are inst1 of the originals."},
  {"expect": {"feature": "Mirror1", "status": "ok", "bodies": 2, "total_volume": 8000}},
  {"expect": {"body": "Body2", "volume": 4000, "faces": 6, "bbox": {"min": [-20, 0, 0], "max": [0, 20, 10]},
    "has_face": "F3:inst1(F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}))"}},

  {"comment": "mir_body_combine: one 40 x 20 x 10 body; the flush top faces merged."},
  {"cmd": "edit_feature", "uid": "F3", "def": {"type": "mirror", "objects": {"type": "bodies", "bodies": ["F2.b0"]},
    "plane": {"type": "origin", "plane": "yz"}, "combine": true}},
  {"expect": {"bodies": 1, "body": "Body1", "volume": 8000, "faces": 6,
    "bbox": {"min": [-20, 0, 0], "max": [20, 20, 10]}}},

  {"comment": "Mirrored in the block's own face at x = 20 instead."},
  {"cmd": "edit_feature", "uid": "F3", "def": {"type": "mirror", "objects": {"type": "bodies", "bodies": ["F2.b0"]},
    "plane": {"type": "face", "body": "F2.b0", "face": "F2:side(c2[c1,c3])"}, "combine": true}},
  {"expect": {"bodies": 1, "body": "Body1", "volume": 8000, "faces": 6,
    "bbox": {"min": [0, 0, 0], "max": [40, 20, 10]}}},

  {"comment": "Apart from the plane (x = 30), combine keeps two bodies (experiment K47)."},
  {"cmd": "edit_feature", "uid": "F3", "def": {"type": "mirror", "objects": {"type": "bodies", "bodies": ["F2.b0"]},
    "plane": {"type": "fixed", "origin": [30, 0, 0], "normal": [1, 0, 0]}, "combine": true}},
  {"expect": {"bodies": 2, "body": "Body2", "bbox": {"min": [40, 0, 0], "max": [60, 20, 10]}}}
]
