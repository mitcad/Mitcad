[
  {"comment": "Profile features that cannot be built fail as features: the command succeeds, the feature shows the error and the bodies pass it by."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},

  {"comment": "Through all with no body to go through (Extrude1 F2)."},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "through_all"}, "operation": "new_body"}},
  {"expect": {"feature": "Extrude1", "status": "error", "error_contains": "no bodies to extrude through", "bodies": 0}},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"expect": {"feature": "Extrude1", "status": "ok", "bodies": 1}},

  {"comment": "To an object behind the start: the block's bottom from a sketch 10 mm above it, going up (Sketch2 F3, Extrude2 F4)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [30, 20], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "start": {"type": "offset", "offset": 10},
    "extent": {"type": "to_object", "object": {"type": "face", "body": "F2.b0",
               "face": "F2:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
    "operation": "cut"}},
  {"expect": {"feature": "Extrude2", "status": "error", "error_contains": "behind the start", "body": "F2.b0", "volume": 48000}},
  {"comment": "A body the extrusion does not cover completely: the circle half off the block's edge, down to the block."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F5", "center": [60, 20], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F5", "region": "r{c1}"}],
    "start": {"type": "offset", "offset": 30}, "flip": true,
    "extent": {"type": "to_object", "object": {"type": "body", "body": "F2.b0"}}, "operation": "new_body"}},
  {"expect": {"feature": "Extrude3", "status": "error", "error_contains": "does not cut across the whole profile"}},

  {"comment": "A cut that misses every body."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F7", "center": [300, 300], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F7", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "cut"}},
  {"expect": {"feature": "Extrude4", "status": "error", "error_contains": "does not cut into any participant body"}},

  {"comment": "A revolution whose profile crosses its axis fails; about a construction axis 20 mm off to the side it is a ring (V = 2 pi 20 * 100)."},
  {"cmd": "add_feature", "def": {"type": "revolve",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": "x", "extent": {"type": "full"}, "operation": "new_body"}},
  {"expect": {"feature": "Revolve1", "status": "ok"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F10", "corner": [-5, 0], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "revolve",
    "profiles": [{"sketch": "F10", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": "y", "extent": {"type": "full"}, "operation": "new_body"}},
  {"expect": {"feature": "Revolve2", "status": "error", "error_contains": "crosses the revolve axis"}},
  {"cmd": "add_feature", "def": {"type": "construction_axis",
    "definition": {"type": "fixed", "origin": [-20, 0, 0], "direction": [0, 1, 0]}}},
  {"cmd": "add_feature", "def": {"type": "revolve",
    "profiles": [{"sketch": "F10", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "axis": "F12", "extent": {"type": "full"}, "operation": "new_body"}},
  {"expect": {"feature": "Revolve3", "status": "ok", "body": "F13.b0", "volume": 12566.370614359172,
    "min": [-45, 0, -25], "max": [5, 10, 25]}},

  {"comment": "A hole off the body's face, and a hole to a plane above its start."},
  {"cmd": "add_feature", "def": {"type": "hole",
    "placement": {"type": "face", "body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})",
                  "points": [[500, 500, 20]]},
    "diameter": 5, "extent": {"type": "distance", "depth": 5}, "participants": ["F2.b0"]}},
  {"expect": {"feature": "Hole1", "status": "error", "error_contains": "does not cut into any participant body"}},
  {"cmd": "add_feature", "def": {"type": "hole",
    "placement": {"type": "face", "body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})",
                  "points": [[30, 20, 20]]},
    "diameter": 5, "extent": {"type": "to_object", "object": {"type": "plane", "plane": "xy"}, "offset": -30},
    "participants": ["F2.b0"]}},
  {"expect": {"feature": "Hole2", "status": "error", "error_contains": "behind the start of the hole"}},
  {"comment": "Bodies are as they were before the failed features."},
  {"expect": {"body": "F2.b0", "volume": 48000}}
]
