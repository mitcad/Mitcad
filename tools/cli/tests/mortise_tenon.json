  {"expect": {"feature": "MortiseTenon3", "status": "ok"}},
  {"expect": {"body": "F7.b0", "volume": 127819.519855417, "tolerance": 1e-8, "has_face": "F9:side(c2[c1,c3])"}},
  {"expect": {"body": "F8.b0", "volume": 151919.950219554, "tolerance": 1e-8, "has_face": "F9:side(c12[c11,c13])"}},

