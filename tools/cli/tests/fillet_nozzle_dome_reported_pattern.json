  {"expect": {"query": {"query": "feature", "uid": "F17"}, "result": {"status": "ok", "level": null}}},
  {"expect": {"feature": "CircularPattern2", "status": "ok", "bodies": 1}},
  {"expect": {"query": {"query": "feature", "uid": "F18"}, "result": {"status": "ok", "level": null}}},
