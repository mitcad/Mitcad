[
  {"comment": "Joints between occurrences (mitcad#55). Plate (C1, Plate:1 at the origin): a 40 x 40 x 10 block, Sketch1 F1 and Extrude1 F2 (Body1)."},
  {"cmd": "create_component", "name": "Plate"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},

  {"comment": "Pin (C2, Pin:1 at x = 100): a 10 x 10 x 20 block, Sketch2 F3 and Extrude2 F4 (Body2)."},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Pin", "transform": {"translation": [100, 0, 0]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [0, 0], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},

  {"comment": "Shaft (C3, Shaft:1 at x = -50): a cylinder of diameter 6 and height 30, Cylinder1 F5 (Body3)."},
  {"cmd": "activate_component", "component": "Root"},
  {"cmd": "create_component", "name": "Shaft", "transform": {"translation": [-50, 0, 0]}},
  {"cmd": "add_feature", "def": {"type": "cylinder", "plane": "xy", "center": [0, 0],
    "diameter": 6, "height": 30, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "Root"},

  {"comment": "Joint1 F6: the pin's bottom turned over onto the plate's top, a revolute joint at rest at 30 degrees. Nothing is grounded: side a (the pin) moves onto side b, standing on the middle of the plate's top, turned 30 degrees about its normal."},
  {"cmd": "add_joint", "kind": "revolute", "flip": true,
    "a": {"occurrence": "Pin:1",
          "geometry": {"body": "F4.b0", "face": "F4:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
    "b": {"occurrence": "Plate:1",
          "geometry": {"body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
    "limits": {"rz": {"min": "-90 deg", "max": "90 deg", "rest": "30 deg"}}},
  {"expect": {"query": {"query": "joints"}, "result": {"joints": [
    {"name": "Joint1", "type": "joint", "kind": "revolute", "state": "placed", "solved": true}]}}},
  {"expect": {"occurrence": "Pin:1", "body": "Body2", "center": [20, 20, 20], "tolerance": 1e-6}},
  {"expect": {"occurrence": "Plate:1", "body": "Body1", "center": [20, 20, 5], "tolerance": 1e-6}},

  {"comment": "With the plate grounded the pin stays there."},
  {"cmd": "ground_occurrence", "occurrence": "Plate:1"},
  {"expect": {"occurrence": "Pin:1", "body": "Body2", "center": [20, 20, 20], "tolerance": 1e-6}},
  {"expect": {"query": {"query": "joints"}, "result": {"joints": [
    {"name": "Joint1", "state": "placed", "solved": true, "values": {"rz": 0.5235987755982988},
     "within_limits": true,
     "frames": {"a": {"origin": [20, 20, 10], "z_axis": [0, 0, -1]},
                "b": {"origin": [20, 20, 10], "z_axis": [0, 0, 1]}}}]}}},
  {"expect": {"query": {"query": "joint_dof", "occurrence": "Pin:1"},
    "result": {"dof": 1, "motions": ["rz"], "joints": [{"name": "Joint1", "other": "Plate:1"}]}}},

  {"comment": "Joint2 F7: the shaft's bottom circle on a point of the plate's top given directly, cylindrical, 5 mm up at rest: the shaft's axis on the plate's normal there."},
  {"cmd": "add_joint", "kind": "cylindrical",
    "a": {"occurrence": "Shaft:1", "geometry": {"body": "F5.b0", "edge": "E{F5:bottom|F5:side0}"}},
    "b": {"occurrence": "Plate:1",
          "geometry": {"body": "F2.b0", "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"},
          "frame_override": {"origin": [5, 5, 10]}},
    "limits": {"tz": {"rest": 5}}},
  {"expect": {"occurrence": "Shaft:1", "body": "Body3", "center": [5, 5, 30], "tolerance": 1e-6}},
  {"expect": {"query": {"query": "joints"}, "result": {
    "joints": [{"name": "Joint1"}, {"name": "Joint2", "state": "placed", "values": {"tz": 5, "rz": 0}}],
    "dof": [{"component": "C0", "total": 3}]}}},

  {"comment": "Suppressed, the shaft is back where it was placed; and back on the plate."},
  {"cmd": "suppress_feature", "uid": "F7"},
  {"expect": {"occurrence": "Shaft:1", "body": "Body3", "center": [-50, 0, 15], "tolerance": 1e-6}},
  {"cmd": "suppress_feature", "uid": "F7", "suppressed": false},
  {"expect": {"occurrence": "Shaft:1", "body": "Body3", "center": [5, 5, 30], "tolerance": 1e-6}},

  {"comment": "Driven to 60 degrees, the pin turns about the plate's normal; the driven value does not take its degree of freedom away."},
  {"cmd": "drive_joint", "joint": "Joint1", "values": {"rz": "60 deg"}},
  {"expect": {"query": {"query": "joints"}, "result": {
    "joints": [{"name": "Joint1", "position": {"rz": 1.0471975511965976},
                "values": {"rz": 1.0471975511965976},
                "frames": {"a": {"origin": [20, 20, 10], "x_axis": [0.5, 0.8660254037844386, 0]}}}, {"name": "Joint2"}],
    "dof": [{"component": "C0", "total": 3, "overconstrained": false}]}}},
  {"expect": {"occurrence": "Pin:1", "body": "Body2", "center": [20, 20, 20], "tolerance": 1e-6}},

  {"comment": "Dragging the pin's origin round the axis to where 80 degrees put it: the preview changes nothing, the drag keeps it and drives the joint there."},
  {"expect": {"query": {"query": "joint_drag", "occurrence": "Pin:1",
                        "target": [24.05579787672639, 14.20772034660431, 10]},
    "result": {"placements": [{"name": "Pin:1"}],
               "values": {"F6": {"rz": 1.3962634015954636}}}}},
  {"expect": {"query": {"query": "joints"}, "result": {"joints": [{"name": "Joint1", "values": {"rz": 1.0471975511965976}}, {"name": "Joint2"}]}}},
  {"cmd": "drag_occurrence", "occurrence": "Pin:1", "target": [24.05579787672639, 14.20772034660431, 10]},
  {"expect": {"query": {"query": "joints"}, "result": {"joints": [
    {"name": "Joint1", "position": {"rz": 1.3962634015954636}, "values": {"rz": 1.3962634015954636},
     "frames": {"a": {"origin": [20, 20, 10], "x_axis": [0.17364817766693, 0.98480775301221, 0]}}},
    {"name": "Joint2"}]}}},
  {"expect": {"occurrence": "Pin:1", "body": "Body2", "center": [20, 20, 20], "tolerance": 1e-6}},
  {"cmd": "undo"},
  {"expect": {"query": {"query": "joints"}, "result": {"joints": [{"name": "Joint1", "values": {"rz": 1.0471975511965976}}, {"name": "Joint2"}]}}},

  {"comment": "Joint3 F8: the shaft's top circle on the pin's top as well: the cylindrical joint and this one contradict each other, so Joint3 fails and moves nothing."},
  {"cmd": "add_joint", "kind": "rigid",
    "a": {"occurrence": "Shaft:1", "geometry": {"body": "F5.b0", "edge": "E{F5:side0|F5:top}"}},
    "b": {"occurrence": "Pin:1",
          "geometry": {"body": "F4.b0", "face": "F4:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}}},
  {"expect": {"feature": "Joint3", "status": "error", "error_contains": "cannot all hold"}},
  {"expect": {"occurrence": "Shaft:1", "body": "Body3", "center": [5, 5, 30], "tolerance": 1e-6}}
]
