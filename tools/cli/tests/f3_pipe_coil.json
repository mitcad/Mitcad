[
  {"comment": "Pipe and coil (F3) with the volumes of the T0 models (pipe_*; the coil of ui_coil). Sketch1 (F1): the path of pipe_path, a line (0,0)-(40,0), a quarter of radius 20 on to (60,20) and a line up to (60,60): 80 + 10 pi long."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_line", "sketch": "F1", "start": [0, 0], "end": [40, 0]},
  {"cmd": "sketch.arc", "sketch": "F1", "mode": "center", "center": [40, 20], "start": "p3", "end": [60, 20]},
  {"cmd": "sketch.add_line", "sketch": "F1", "start": [60, 20], "end": [60, 60]},

  {"comment": "pipe_path: an 8 mm rod along it, V = pi 4^2 (80 + 10 pi) (Pipe1, F2)."},
  {"cmd": "add_feature", "def": {"type": "pipe", "path": {"sketch": "F1", "curves": ["c1"], "chain": true},
    "size": 8, "operation": "new_body"}},
  {"expect": {"feature": "Pipe1", "status": "ok", "body": "F2.b0", "volume": 5600.375300769233, "tolerance": 1e-4,
    "has_face": "F2:side0"}},
  {"expect": {"body": "F2.b0", "has_face": "F2:start", "min": [0, -4, -4], "max": [64, 60, 4], "tolerance": 1e-3}},
  {"expect": {"body": "F2.b0", "has_face": "F2:end"}},
  {"comment": "A square in the 8 mm circle, side 8 / sqrt 2: V = 32 (80 + 10 pi)."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "pipe", "path": {"sketch": "F1", "curves": ["c1"], "chain": true},
    "section": "square", "size": 8, "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 3565.309649148733, "tolerance": 1e-4, "has_face": "F2:side3"}},
  {"comment": "Three quarters of the path."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "pipe", "path": {"sketch": "F1", "curves": ["c1"], "chain": true},
    "size": 8, "extent": {"type": "partial", "fraction": 0.75}, "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 4200.281475576925, "tolerance": 1e-4}},

  {"comment": "pipe_hollow: 10 mm with a 1 mm wall inside, along 50 mm of a line (Sketch2 F3, Pipe2 F4): V = pi (5^2 - 4^2) 50."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_line", "sketch": "F3", "start": [0, 100], "end": [50, 100]},
  {"cmd": "add_feature", "def": {"type": "pipe", "path": {"sketch": "F3", "curves": ["c1"]},
    "size": 10, "thickness": 1, "operation": "new_body"}},
  {"expect": {"feature": "Pipe2", "status": "ok", "body": "F4.b0", "volume": 1413.7166941154069, "tolerance": 1e-6,
    "faces": 4, "has_face": "F4:inner0"}},

  {"comment": "Round a circle of radius 30 (Sketch3 F5): a torus without caps (Pipe3 F6), V = pi 2^2 * 2 pi 30."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F5", "center": [0, 200], "diameter": 60},
  {"cmd": "add_feature", "def": {"type": "pipe", "path": {"sketch": "F5", "curves": ["c1"]},
    "size": 4, "operation": "new_body"}},
  {"expect": {"feature": "Pipe3", "status": "ok", "body": "F6.b0", "volume": 2368.705056261446, "tolerance": 1e-4,
    "has_face": "F6:side0"}},

  {"comment": "ui_coil: on XY round the origin, diameter 40, 3 turns of pitch 10, a 4 mm circle on the diameter: V = pi 2^2 * 3 sqrt((40 pi)^2 + 10^2) (Coil1, F7)."},
  {"cmd": "add_feature", "def": {"type": "coil", "plane": "xy", "center": [0, -100], "diameter": 40,
    "helix": {"type": "revolutions_and_pitch", "revolutions": 3, "pitch": 10}, "section_size": 4,
    "operation": "new_body"}},
  {"expect": {"feature": "Coil1", "status": "ok", "body": "F7.b0", "volume": 4752.386440264496, "tolerance": 1e-5,
    "has_face": "F7:side0"}},
  {"comment": "The section is at right angles to the helix, tilted by atan(10 / 40 pi): it reaches 2 cos(4.55 deg) below the plane."},
  {"expect": {"body": "F7.b0", "min": [-22, -122, -1.99369744], "max": [22, -78, 31.99369744], "tolerance": 1e-5}},
  {"comment": "The same as height and pitch, and as revolutions and height."},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "coil", "plane": "xy", "center": [0, -100], "diameter": 40,
    "helix": {"type": "height_and_pitch", "height": 30, "pitch": 10}, "section_size": 4, "operation": "new_body"}},
  {"expect": {"body": "F7.b0", "volume": 4752.386440264496, "tolerance": 1e-5}},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "coil", "plane": "xy", "center": [0, -100], "diameter": 40,
    "helix": {"type": "revolutions_and_height", "revolutions": 3, "height": 30}, "section_size": 4,
    "operation": "new_body"}},
  {"expect": {"body": "F7.b0", "volume": 4752.386440264496, "tolerance": 1e-5, "has_face": "F7:start"}},
  {"comment": "Cut from a 60 x 60 x 40 block round it, from z = -5 (Sketch4 F8, Extrude1 F9, Coil2 F10): the block loses the whole coil."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F8", "corner": [-30, -130], "width": 60, "height": 60},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F8", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "start": {"type": "offset", "offset": -5}, "extent": {"type": "distance", "distance": 40}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "coil", "plane": "xy", "center": [0, -100], "diameter": 40,
    "helix": {"type": "revolutions_and_pitch", "revolutions": 3, "pitch": 10}, "section_size": 4,
    "operation": "cut", "participants": ["F9.b0"]}},
  {"expect": {"feature": "Coil2", "status": "ok", "body": "F9.b0", "volume": 139247.6135597355, "tolerance": 1e-4}}
]
