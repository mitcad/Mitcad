[
  {"comment": "The reference model move_point_to_point: a 10 mm cube at the origin (Sketch1 F1, Extrude1 F2) moved (Move1, F3) so that its vertex (10, 10, 10) lands on (50, 0, 0): x 40..50, y -10..0, z -10..0."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 10, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "move", "bodies": ["F2.b0"],
    "transform": {"type": "point_to_point",
      "from": {"type": "vertex", "body": "F2.b0",
        "vertex": "V{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F2:side(c2[c1,c3])|F2:side(c3[c2,c4])}"},
      "to": {"type": "fixed", "point": [50, 0, 0]}}}},
  {"expect": {"feature": "Move1", "status": "ok", "body": "Body1", "volume": 1000,
    "bbox": {"min": [40, -10, -10], "max": [50, 0, 0]}}},

  {"comment": "Align1 (F4): the cube's bottom face against the XY plane, faces opposite and centred on the origin."},
  {"cmd": "add_feature", "def": {"type": "align", "bodies": ["F2.b0"],
    "from": {"type": "plane", "plane": {"type": "face", "body": "F2.b0",
      "face": "F2:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
    "to": {"type": "plane", "plane": {"type": "origin", "plane": "xy"}}}},
  {"expect": {"feature": "Align1", "status": "ok", "body": "Body1", "volume": 1000,
    "bbox": {"min": [-5, -5, 0], "max": [5, 5, 10]}}},
  {"comment": "Flipped, the face lies on the plane facing the same way: the cube below it; turned 45 degrees about the normal."},
  {"cmd": "edit_feature", "uid": "F4", "def": {"type": "align", "bodies": ["F2.b0"],
    "from": {"type": "plane", "plane": {"type": "face", "body": "F2.b0",
      "face": "F2:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
    "to": {"type": "plane", "plane": {"type": "origin", "plane": "xy"}}, "flip": true, "angle": 0.7853981633974483}},
  {"expect": {"body": "Body1", "bbox": {"min": [-7.0710678118654755, -7.0710678118654755, -10],
    "max": [7.0710678118654755, 7.0710678118654755, 0]}}},
  {"comment": "A vertex onto a fixed point."},
  {"cmd": "edit_feature", "uid": "F4", "def": {"type": "align", "bodies": ["F2.b0"],
    "from": {"type": "point", "point": {"type": "vertex", "body": "F2.b0",
      "vertex": "V{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F2:side(c2[c1,c3])|F2:side(c3[c2,c4])}"}},
    "to": {"type": "point", "point": {"type": "origin"}}}},
  {"expect": {"body": "Body1", "bbox": {"min": [-10, -10, -10], "max": [0, 0, 0]}}},

  {"comment": "The reference model scale_uniform: the cube (now x, y, z -10..0) scaled by 2 about its vertex at the origin (Scale1, F5)."},
  {"cmd": "add_feature", "def": {"type": "scale", "bodies": ["F2.b0"], "point": {"type": "origin"},
    "scale": {"type": "uniform", "factor": 2}}},
  {"expect": {"feature": "Scale1", "status": "ok", "body": "Body1", "volume": 8000,
    "bbox": {"min": [-20, -20, -20], "max": [0, 0, 0]}}},
  {"comment": "scale_non_uniform: 2, 1 and 0.5 along X, Y and Z (20 x 10 x 5 mm); planes become B-splines but keep their names."},
  {"cmd": "edit_feature", "uid": "F5", "def": {"type": "scale", "bodies": ["F2.b0"], "point": {"type": "origin"},
    "scale": {"type": "non_uniform", "x": 2, "y": 1, "z": 0.5}}},
  {"expect": {"body": "Body1", "volume": 1000, "faces": 6, "bbox": {"min": [-20, -10, -5], "max": [0, 0, 0]},
    "has_edge": "E{F2:side(c1[c4,c2])|F2:side(c2[c1,c3])}"}},
  {"comment": "About a fixed point."},
  {"cmd": "edit_feature", "uid": "F5", "def": {"type": "scale", "bodies": ["F2.b0"],
    "point": {"type": "fixed", "point": [-10, -10, -10]}, "scale": {"type": "uniform", "factor": 0.5}}},
  {"expect": {"body": "Body1", "volume": 125, "bbox": {"min": [-10, -10, -10], "max": [-5, -5, -5]}}}
]
