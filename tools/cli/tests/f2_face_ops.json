[
  {"comment": "T0 models of face operations (offset_face_top, presspull_hole_wall, delface_*, replface_surface) and split_body_plane, split_face_plane. Each uses a 60 x 40 x 20 block: a sketch with lines c1..c4 and its extrusion."},

  {"comment": "offset_face_top: Sketch1 F1, Extrude1 F2; the top 5 mm up keeps its name."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "offset_face", "body": "F2.b0",
    "faces": ["F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"], "distance": 5}},
  {"expect": {"feature": "OffsetFace1", "status": "ok", "body": "F2.b0", "volume": 60000, "faces": 6,
    "has_edge": "E{F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})|F2:side(c1[c4,c2])}"}},

  {"comment": "presspull_hole_wall: Sketch2 F4 with the block (c1..c4) and a 10 mm circle (c9), Extrude2 F5 the block (both profiles: the rectangle has the circle as a hole), Extrude3 F6 cuts the hole; the wall -2 mm, away from the axis: a 14 mm hole."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F4", "corner": [100, 0], "width": 60, "height": 40},
  {"cmd": "sketch.add_circle", "sketch": "F4", "center": [130, 20], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F4", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}, {"sketch": "F4", "region": "r{c9}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F4", "region": "r{c9}"}],
    "extent": {"type": "through_all"}, "operation": "cut"}},
  {"cmd": "add_feature", "name": "PressPull1", "def": {"type": "offset_face", "body": "F5.b0",
    "faces": ["F6:side(c9)"], "distance": -2}},
  {"expect": {"feature": "PressPull1", "status": "ok", "body": "F5.b0", "volume": 44921.23919948201}},

  {"comment": "delface_fillet: Sketch3 F8, Extrude4 F9, a 5 mm fillet at the edge (200, 0), then its face deleted."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F8", "corner": [200, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F8", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F9.b0",
    "edges": ["E{F9:side(c1[c4,c2])|F9:side(c4[c3,c1])}"], "radius": 5}},
  {"expect": {"body": "F9.b0", "volume": 47892.69908169872}},
  {"cmd": "add_feature", "def": {"type": "delete_face", "body": "F9.b0",
    "faces": ["F10:fillet(E{F9:side(c1[c4,c2])|F9:side(c4[c3,c1])})"]}},
  {"expect": {"feature": "DeleteFace1", "status": "ok", "body": "F9.b0", "volume": 48000, "faces": 6,
    "has_edge": "E{F9:side(c1[c4,c2])|F9:side(c4[c3,c1])}"}},

  {"comment": "delface_pocket: Sketch4 F12 (block c1..c4, circle c9), Extrude5 F13 the block (both profiles), Extrude6 F14 a 10 mm pocket from z = 10 to 20; its wall and floor deleted."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F12", "corner": [300, 0], "width": 60, "height": 40},
  {"cmd": "sketch.add_circle", "sketch": "F12", "center": [330, 20], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F12", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}, {"sketch": "F12", "region": "r{c9}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F12", "region": "r{c9}"}],
    "start": {"type": "offset", "offset": 10}, "extent": {"type": "distance", "distance": 20}, "operation": "cut"}},
  {"expect": {"body": "F13.b0", "volume": 47214.60183660255}},
  {"cmd": "add_feature", "def": {"type": "delete_face", "body": "F13.b0",
    "faces": ["F14:side(c9)", "F14:start(r{c9})"]}},
  {"expect": {"feature": "DeleteFace2", "status": "ok", "body": "F13.b0", "volume": 48000, "faces": 6}},

  {"comment": "replface_surface: Sketch5 F16, Extrude7 F17; the top replaced by a plane at z = 25 (the surface body of the T0 model is a fixed plane here)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F16", "corner": [400, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F16", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "replace_face", "body": "F17.b0",
    "faces": ["F17:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"],
    "target": {"type": "plane", "origin": [0, 0, 25], "normal": [0, 0, 1]}}},
  {"expect": {"feature": "ReplaceFace1", "status": "ok", "body": "F17.b0", "volume": 60000, "faces": 6,
    "has_face": "F18:replace(F17:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}))"}},

  {"comment": "split_body_plane: Sketch6 F19, Extrude8 F20, split at x = 520 (the YZ plane moved 520 mm); the 20 mm piece keeps the body, the 40 mm piece is SplitBody1's F21.b0 (Body7)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F19", "corner": [500, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F19", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "add_feature", "def": {"type": "split_body", "bodies": ["F20.b0"],
    "tool": {"type": "origin_plane", "plane": "yz", "offset": 520}}},
  {"expect": {"feature": "SplitBody1", "status": "ok", "bodies": 7}},
  {"expect": {"body": "F20.b0", "volume": 16000, "faces": 6, "has_face": "F21:split"}},
  {"expect": {"body": "Body7", "volume": 32000, "faces": 6, "has_face": "F21:split"}},

