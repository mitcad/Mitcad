[
  {"comment": "The reference model pat_circ_feature: a disk of 60 mm diameter, 5 mm thick (Sketch1 F1, Extrude1 F2), a 6 mm hole at (20, 0) cut through all (Sketch2 F3, Extrude2 F4), the cut patterned six times over 360 degrees about Z (CircularPattern1, F5)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F1", "center": [0, 0], "diameter": 60},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F1", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [20, 0], "diameter": 6},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "extent": {"type": "through_all"}, "operation": "cut"}},
  {"cmd": "add_feature", "def": {"type": "circular_pattern",
    "objects": {"type": "features", "features": ["F4"]},
    "axis": {"type": "origin", "axis": "z"}, "quantity": 6, "angle": 6.283185307179586}},
  {"comment": "pi*30**2*5 - 6*pi*3**2*5 = 13288.94 mm3, as in the reference model."},
  {"expect": {"feature": "CircularPattern1", "status": "ok", "bodies": 1, "body": "Body1",
    "volume": 13288.936924684824, "faces": 9, "has_face": "F5:inst3(F4:side(c1))"}},

  {"comment": "About the axis of the disk's rim face instead of the Z axis: the same."},
  {"cmd": "edit_feature", "uid": "F5", "def": {"type": "circular_pattern",
    "objects": {"type": "features", "features": ["F4"]},
    "axis": {"type": "face", "body": "F2.b0", "face": "F2:side(c1)"}, "quantity": "d4", "angle": "d5"}},
  {"expect": {"body": "Body1", "volume": 13288.936924684824}},
  {"comment": "Elements 2 and 4 suppressed: four holes."},
  {"cmd": "edit_feature", "uid": "F5", "def": {"type": "circular_pattern",
    "objects": {"type": "features", "features": ["F4"]},
    "axis": {"type": "origin", "axis": "z"}, "quantity": "d4", "angle": "d5", "suppressed_elements": [2, 4]}},
  {"expect": {"body": "Body1", "volume": 13571.680263507906, "faces": 7}},
  {"comment": "Seven holes: the names of the others stay."},
  {"cmd": "set_parameter", "name": "d4", "value": 7},
  {"expect": {"body": "Body1", "faces": 8, "has_face": "F5:inst6(F4:side(c1))"}},

  {"comment": "Faces patterned (experiment K46): a plate 60 x 40 x 5 (Sketch3 F6, Extrude3 F7) with an 8 mm boss 10 mm high at (10, 100) (Sketch4 F8, Extrude4 F9, joined from the XY plane), its side and top patterned three times 20 mm along X (RectangularPattern1, F10): bosses joined."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F6", "corner": [0, 90], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F6", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F8", "center": [10, 100], "diameter": 8},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F8", "region": "r{c1}"}],
    "extent": {"type": "distance", "distance": 15}, "operation": "join", "participants": ["F7.b0"]}},
  {"expect": {"body": "F7.b0", "volume": 12502.654824574367}},
  {"cmd": "add_feature", "def": {"type": "rectangular_pattern",
    "objects": {"type": "faces", "body": "F7.b0", "faces": ["F9:side(c1)", "F9:end(r{c1})"]},
    "direction1": {"axis": {"type": "origin", "axis": "x"}, "quantity": 3, "distance": 20},
    "distance_type": "spacing"}},
  {"expect": {"feature": "RectangularPattern1", "status": "ok", "body": "F7.b0",
    "volume": 13507.964473723101, "has_face": "F10:inst2(F9:end(r{c1}))"}},
  {"comment": "Identical joins the copies in one boolean."},
  {"cmd": "edit_feature", "uid": "F10", "def": {"type": "rectangular_pattern",
    "objects": {"type": "faces", "body": "F7.b0", "faces": ["F9:side(c1)", "F9:end(r{c1})"]},
    "direction1": {"axis": {"type": "origin", "axis": "x"}, "quantity": "d11", "distance": "d12"},
    "distance_type": "spacing", "compute": "identical"}},
  {"expect": {"body": "F7.b0", "volume": 13507.964473723101}}
]
