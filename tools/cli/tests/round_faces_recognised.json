[
  {"comment": "SPDX-License-Identifier: MIT. Round faces whatever their stored surface (mitcad#1855): Axis Through Cylinder, Point at Center and a Cylindrical joint take the wall of a hole made by Sketch + Extrude Cut as they take a Hole's, in a plate and in a sheet body's flange, whose holes' walls are B-spline cylinders and their edges B-spline circles once a sheet feature has rebuilt the body."},

  {"comment": "Plate (C1, Plate:1): a 60 x 40 x 10 block (F2.b0); a circle of diameter 10 at (30, 20) sketched on its top and cut through all (F4: its wall F4:side(c1)); a Hole of diameter 6 at (10, 10) (F5)."},
  {"cmd": "create_component", "name": "Plate"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "operation": "new_body"}},
  {"cmd": "sketch.create", "plane": {"face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})", "body": "F2.b0"}},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [30, 20], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "extent": {"type": "through_all"}, "flip": true, "operation": "cut"}},
  {"cmd": "add_feature", "def": {"type": "hole", "placement": {"type": "face", "body": "F2.b0",
    "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})", "points": [[10, 10, 10]]},
    "diameter": 6, "extent": {"type": "through_all"}}},
  {"expect": {"feature": "F5", "status": "ok"}},
  {"cmd": "activate_component", "component": "C0"},

  {"comment": "Bracket (C2, Bracket:1): a 40 x 20 sheet of thickness 2 (F8.b0) with a 20 mm flange folded up at x = 40 (F9: its front at x = 40, its back at x = 38); a circle of diameter 8 at (y, z) = (10, 15) sketched on the flange's front and cut through all (F11), then a Hole of diameter 4 at (40, 5, 20) (F12). The Hole rebuilds the sheet: both walls are then the sheet's B-spline walls F9:sheet_side0(F11:sheet_curve(8)) and F9:sheet_side0(F12:sheet_curve(0)), which no pick called round before mitcad#1855."},
  {"cmd": "create_component", "name": "Bracket"},
  {"cmd": "add_feature", "def": {"type": "sheet_rules", "thickness": 2, "bend_radius": 3, "allowance": {"type": "k_factor", "k": 0.3},
    "reference_side": "front", "bend_relief": {"type": "rectangular", "width": 2, "depth": 3},
    "corner_relief": {"type": "round", "width": 2, "depth": 3}}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F7", "corner": [0, 0], "width": 40, "height": 20},
  {"cmd": "add_feature", "def": {"type": "sheet_face", "rules": "F6",
    "profiles": [{"sketch": "F7", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}]}},
  {"cmd": "add_feature", "def": {"type": "sheet_flange", "body": "F8.b0",
    "boundary": {"panel": {"feature": "F8", "slot": 0}, "curve": {"type": "sketch", "sketch": "F7", "segment": "c2[c1,c3]"}},
    "angle": 1.5707963267948966, "length": {"mode": "tangent", "value": 20}, "position": "inside"}},
  {"cmd": "sketch.create", "plane": {"face": "F9:sheet_front(0)", "body": "F8.b0"}},
  {"cmd": "sketch.add_circle", "sketch": "F10", "center": [10, 15], "diameter": 8},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F10", "region": "r{c1}"}],
    "extent": {"type": "through_all"}, "flip": true, "operation": "cut"}},
  {"cmd": "add_feature", "def": {"type": "hole", "placement": {"type": "face", "body": "F8.b0",
    "face": "F9:sheet_front(0)", "points": [[40, 5, 20]]}, "diameter": 4, "extent": {"type": "through_all"}}},
  {"expect": {"feature": "F12", "status": "ok"}},
  {"expect": {"body": "F8.b0", "has_face": "F9:sheet_side0(F11:sheet_curve(8))"}},
  {"expect": {"body": "F8.b0", "has_face": "F9:sheet_side0(F12:sheet_curve(0))"}},
  {"comment": "The faces and edges queries read the B-spline walls and rims as the single reads do (mitcad#1863; they said bspline before, so an MCP pick without a geometry field, which reads them, was refused): the cut's wall (area 16 pi) a cylinder of radius 4 about the axis through (39, 10, 15) along X; its two rims circles of radius 4."},
  {"expect": {"query": {"query": "faces", "body": "F8.b0", "geometry": true, "surface": "cylinder", "min_area": 45, "max_area": 55},
    "result": {"total": 1, "faces": [{"surface": "cylinder", "radius": 4,
      "axis": [1, 0, 0], "origin": [39, 10, 15]}]},
    "tolerance": 1e-5}},
  {"expect": {"query": {"query": "edges", "body": "F8.b0", "geometry": true, "curve": "circle", "radius": 4},
    "result": {"total": 2, "edges": [{"curve": "circle", "radius": 4}, {"curve": "circle", "radius": 4}]},
    "tolerance": 1e-5}},
  {"cmd": "activate_component", "component": "C0"},

  {"comment": "Shaft (C3, Shaft:1 at x = -50): a cylinder of diameter 10 and height 30 (F13). Pin (C4, Pin:1 at x = -100): a cylinder of diameter 8 and height 10 (F14)."},
  {"cmd": "create_component", "name": "Shaft", "transform": {"translation": [-50, 0, 0]}},
  {"cmd": "add_feature", "def": {"type": "cylinder", "plane": "xy", "center": [0, 0],
    "diameter": 10, "height": 30, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "C0"},
  {"cmd": "create_component", "name": "Pin", "transform": {"translation": [-100, 0, 0]}},
  {"cmd": "add_feature", "def": {"type": "cylinder", "plane": "xy", "center": [0, 0],
    "diameter": 8, "height": 10, "operation": "new_body"}},
  {"cmd": "activate_component", "component": "C0"},

  {"comment": "Axis Through Cylinder on the plate's walls: the cut's and the Hole's, at the circles' centres along the plate's normal."},
  {"cmd": "activate_component", "component": "C1"},
  {"cmd": "add_feature", "def": {"type": "construction_axis", "definition": {"type": "circular_face",
    "face": {"body": "F2.b0", "face": "F4:side(c1)"}}}},
  {"expect": {"query": {"query": "datum", "uid": "F15"}, "result": {"origin": [30, 20, 5], "direction": [0, 0, 1]}}},
  {"cmd": "add_feature", "def": {"type": "construction_axis", "definition": {"type": "circular_face",
    "face": {"body": "F2.b0", "face": "F5:hole0.wall"}}}},
  {"expect": {"query": {"query": "datum", "uid": "F16"}, "result": {"origin": [10, 10, 5], "direction": [0, 0, 1]}}},
  {"cmd": "activate_component", "component": "C0"},

  {"comment": "The same on the flange's B-spline walls (in the middle of the flange's thickness, along its normal), and Point at Center on the cut's B-spline circle on the flange's front."},
  {"cmd": "activate_component", "component": "C2"},
  {"cmd": "add_feature", "def": {"type": "construction_axis", "definition": {"type": "circular_face",
    "face": {"body": "F8.b0", "face": "F9:sheet_side0(F11:sheet_curve(8))"}}}},
  {"expect": {"feature": "F17", "status": "ok"}},
  {"expect": {"query": {"query": "datum", "uid": "F17"}, "result": {"origin": [39, 10, 15], "direction": [1, 0, 0]}}},
  {"cmd": "add_feature", "def": {"type": "construction_axis", "definition": {"type": "circular_face",
    "face": {"body": "F8.b0", "face": "F9:sheet_side0(F12:sheet_curve(0))"}}}},
  {"expect": {"feature": "F18", "status": "ok"}},
  {"expect": {"query": {"query": "datum", "uid": "F18"}, "result": {"origin": [39, 5, 20], "direction": [1, 0, 0]}}},
  {"cmd": "add_feature", "def": {"type": "construction_point", "definition": {"type": "center",
    "entity": {"body": "F8.b0", "edge": "E{F9:sheet_front(0)|F9:sheet_side0(F11:sheet_curve(8))}"}}}},
  {"expect": {"feature": "F19", "status": "ok"}},
  {"expect": {"query": {"query": "datum", "uid": "F19"}, "result": {"point": [40, 10, 15]}}},
  {"cmd": "activate_component", "component": "C0"},

  {"comment": "Cylindrical joints take the walls as origins: the shaft moves onto the plate's cut wall, at rest with its middle on the wall's axis point (30, 20, 5); the pin onto the flange's cut wall, its middle at (39, 10, 15)."},
  {"cmd": "add_joint", "kind": "cylindrical",
    "a": {"occurrence": "Shaft:1", "geometry": {"body": "F13.b0", "face": "F13:side0"}},
    "b": {"occurrence": "Plate:1", "geometry": {"body": "F2.b0", "face": "F4:side(c1)"}},
    "limits": {"tz": {"rest": 0}}},
  {"expect": {"feature": "Joint1", "status": "ok"}},
  {"expect": {"occurrence": "Shaft:1", "body": "F13.b0", "center": [30, 20, 5], "tolerance": 1e-6}},
  {"cmd": "add_joint", "kind": "cylindrical",
    "a": {"occurrence": "Pin:1", "geometry": {"body": "F14.b0", "face": "F14:side0"}},
    "b": {"occurrence": "Bracket:1", "geometry": {"body": "F8.b0", "face": "F9:sheet_side0(F11:sheet_curve(8))"}},
    "limits": {"tz": {"rest": 0}}},
  {"expect": {"feature": "Joint2", "status": "ok"}},
  {"expect": {"occurrence": "Pin:1", "body": "F14.b0", "center": [39, 10, 15], "tolerance": 1e-5}}
]
