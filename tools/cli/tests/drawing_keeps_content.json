[
  {"comment": "SPDX-License-Identifier: MIT. A drawing keeps what was put into it (mitcad#1293, drawing-keeps-content-test.cmake): Plate (a 40 x 30 x 5 body, F2.b0) placed twice (Plate:1 O1 and Plate:2 O2, 50 mm apart), a front view of the design and its right view. The view records the two bodies; Plate:2 hidden and a third placement (O3) added change nothing; Update from Model (subject design) takes what the 3D view shows (O1, O3), undone; Plate:2 deleted leaves the view with a warning naming it."},
  {"cmd": "create_component", "name": "Plate"},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 40, "height": 30},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 5}, "operation": "new_body"}},
  {"expect": {"feature": "F2", "status": "ok", "bodies": 1, "body": "F2.b0", "volume": 6000}},
  {"cmd": "activate_component", "component": "C0"},
  {"cmd": "copy_occurrence", "occurrence": "Plate:1", "transform": {"translation": [50, 0, 0]}},
  {"cmd": "add_drawing", "size": "A3"},
  {"cmd": "add_drawing_view", "drawing": "D1", "type": "base", "direction": "front", "at": [150, 150], "scale": "1:1"},
  {"cmd": "add_drawing_view", "drawing": "D1", "type": "projected", "parent": 1, "side": "right"},
  {"comment": "Placed with the whole design: the bodies shown then, each where its occurrence places it."},
  {"expect": {"query": {"query": "drawing", "drawing": "D1", "geometry": false},
    "result": {"sheets": [{"views": [
      {"id": 1, "subject": {"type": "bodies", "bodies": [{"body": "F2.b0", "occurrence": "O1"}, {"body": "F2.b0", "occurrence": "O2"}]}},
      {"id": 2}]}],
      "projections": [{"view": 1, "bodies": 2}, {"view": 2, "bodies": 2}]}}},
  {"comment": "Plate:2 hidden and a third placement added: the view as it was."},
  {"cmd": "set_occurrence_visible", "occurrence": "Plate:2", "visible": false},
  {"cmd": "copy_occurrence", "occurrence": "Plate:1", "transform": {"translation": [100, 0, 0]}},
  {"expect": {"query": {"query": "drawing", "drawing": "D1", "geometry": false},
    "result": {"sheets": [{"views": [
      {"id": 1, "subject": {"type": "bodies", "bodies": [{"body": "F2.b0", "occurrence": "O1"}, {"body": "F2.b0", "occurrence": "O2"}]}},
      {"id": 2}]}],
      "projections": [{"view": 1, "bodies": 2}, {"view": 2, "bodies": 2}]}}},
  {"comment": "Update from Model: what the 3D view shows now; one undo step."},
  {"cmd": "edit_drawing_view", "drawing": "D1", "view": 1, "subject": {"type": "design"}},
  {"expect": {"query": {"query": "document"}, "result": {"undo": "Update view 1 of Drawing1"}}},
  {"expect": {"query": {"query": "drawing", "drawing": "D1", "geometry": false},
    "result": {"sheets": [{"views": [
      {"id": 1, "subject": {"type": "bodies", "bodies": [{"body": "F2.b0", "occurrence": "O1"}, {"body": "F2.b0", "occurrence": "O3"}]}},
      {"id": 2}]}]}}},
  {"cmd": "undo"},
  {"comment": "Plate:2 deleted: the view draws Plate:1 and says what is gone, in words for a person and by its id for agents (mitcad#1741)."},
  {"cmd": "delete_occurrence", "occurrence": "Plate:2"},
  {"expect": {"query": {"query": "drawing", "drawing": "D1", "geometry": false},
    "result": {"sheets": [{"views": [
      {"id": 1, "warnings": ["an occurrence is gone\n[placed: {\"message\":\"an occurrence is gone\",\"detail\":\"the occurrence O2 is gone\"}]"]},
      {"id": 2}]}],
      "projections": [{"view": 1, "bodies": 1}, {"view": 2, "bodies": 1}]}}},
  {"cmd": "undo"}
]
