[
  {"comment": "Narrow gaps between bodies printed in place (mitcad#1519) on the OCCT kernel: blocks of 20 mm, A at the origin (F2), B 0.2 mm beside it along X (F4), C 0.5 mm beside B (F6), and D (F8, 10 mm wide) touching A from -Y."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 20, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F3", "corner": [20.2, 0], "width": 20, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F3", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F5", "corner": [40.7, 0], "width": 20, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F5", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F7", "corner": [0, -20], "width": 10, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F7", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"expect": {"bodies": 4}},

  {"comment": "At the default 0.3 mm: A and B only, 0.2 mm apart, A and D touch (interference's)."},
  {"expect": {"query": {"query": "print_min_gap"}, "tolerance": 1e-6,
    "result": {"gap": 0.3, "gap_from": "default", "bodies": 4, "closest": 0.2, "touching": 1,
      "pairs": [{"a": "F2.b0", "b": "F4.b0", "names": ["Body1", "Body2"], "distance": 0.2}]}}},
  {"comment": "0.5 mm apart is no narrow gap at 0.3 mm; at 0.6 mm both pairs are, the closest first."},
  {"expect": {"query": {"query": "print_min_gap", "bodies": ["F4.b0", "F6.b0"]},
    "result": {"bodies": 2, "pairs": [], "closest": null, "touching": 0}}},
  {"expect": {"query": {"query": "print_min_gap", "gap": 0.6}, "tolerance": 1e-6,
    "result": {"gap_from": "query",
      "pairs": [{"a": "F2.b0", "b": "F4.b0", "distance": 0.2}, {"a": "F4.b0", "b": "F6.b0", "distance": 0.5}]}}}
]
