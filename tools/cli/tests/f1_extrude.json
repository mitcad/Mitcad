[
  {"comment": "Extrude options with the volumes of the T0 models (ext_*, diff_extrude_*). Sketch1 (F1): a 60 x 40 rectangle."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F1", "corner": [0, 0], "width": 60, "height": 40},

  {"comment": "ext_symmetric_full: 20 mm in total, z -10..10; the start is the far cap of side one (startFaces in .f3d designs)."},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "symmetric", "distance": 20, "full_length": true}, "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 48000, "faces": 6, "min": [0, 0, -10], "max": [60, 40, 10],
    "has_face": "F2:start(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
  {"comment": "ext_symmetric_half: 20 mm to each side."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "symmetric", "distance": 20}, "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 96000, "min": [0, 0, -20], "max": [60, 40, 20]}},
  {"comment": "ext_two_sides: 15 mm along the normal, 5 mm against it."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "two_sides", "side1": {"type": "distance", "distance": 15},
               "side2": {"type": "distance", "distance": 5}}, "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 48000, "min": [0, 0, -5], "max": [60, 40, 15]}},
  {"comment": "ext_start_offset: 10 mm up, then 20 mm."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "start": {"type": "offset", "offset": 10},
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 48000, "min": [0, 0, 10], "max": [60, 40, 30]}},
  {"comment": "ext_to_object_plane, mirrored: from 25 mm below up to the XY plane."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "start": {"type": "offset", "offset": -25},
    "extent": {"type": "to_object", "object": {"type": "plane", "plane": "xy"}}, "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 60000, "min": [0, 0, -25], "max": [60, 40, 0]}},
  {"comment": "diff_extrude_direction_negative: a negative distance goes down; so does flip."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": -20}, "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 48000, "min": [0, 0, -20], "max": [60, 40, 0]}},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "flip": true, "operation": "new_body"}},
  {"expect": {"body": "F2.b0", "volume": 48000, "min": [0, 0, -20], "max": [60, 40, 0]}},
  {"comment": "The block of the T0 models: 60 x 40 x 20."},
  {"cmd": "edit_feature", "uid": "F2", "def": {"type": "extrude",
    "profiles": [{"sketch": "F1", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"expect": {"bodies": 1, "body": "F2.b0", "volume": 48000, "min": [0, 0, 0], "max": [60, 40, 20]}},

  {"comment": "diff_extrude_operation_*: a 20 mm circle at (30, 20) extruded 10 mm symmetrically (Sketch2 F3, Extrude2 F4)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F3", "center": [30, 20], "diameter": 20},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "extent": {"type": "symmetric", "distance": 10, "full_length": true}, "operation": "cut", "participants": ["F2.b0"]}},
  {"expect": {"body": "F2.b0", "volume": 46429.203673205106}},
  {"cmd": "edit_feature", "uid": "F4", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "extent": {"type": "symmetric", "distance": 10, "full_length": true}, "operation": "intersect", "participants": ["F2.b0"]}},
  {"expect": {"bodies": 1, "body": "F2.b0", "volume": 1570.7963267948967}},
  {"cmd": "edit_feature", "uid": "F4", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "extent": {"type": "symmetric", "distance": 10, "full_length": true}, "operation": "join", "participants": ["F2.b0"]}},
  {"expect": {"bodies": 1, "body": "F2.b0", "volume": 49570.796326794894}},
  {"cmd": "edit_feature", "uid": "F4", "def": {"type": "extrude", "profiles": [{"sketch": "F3", "region": "r{c1}"}],
    "extent": {"type": "symmetric", "distance": 10, "full_length": true}, "operation": "new_body"}},
  {"expect": {"bodies": 2, "body": "F4.b0", "volume": 3141.592653589793}},
  {"expect": {"body": "F2.b0", "volume": 48000}},

  {"comment": "ext_to_object_face: a 20 mm circle 40 mm up (start offset), flipped down to the block's top and joined (Sketch3 F5, Extrude3 F6)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F5", "center": [30, 20], "diameter": 20},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F5", "region": "r{c1}"}],
    "start": {"type": "offset", "offset": 40}, "flip": true,
    "extent": {"type": "to_object", "object": {"type": "face", "body": "F2.b0",
               "face": "F2:end(r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]})"}},
    "operation": "join", "participants": ["F2.b0"]}},
  {"expect": {"feature": "F6", "status": "ok", "body": "F2.b0", "volume": 54283.185307179585, "max": [60, 40, 40],
    "has_face": "F6:start(r{c1})"}},
  {"comment": "ext_through_all_cut: a 10 mm circle cut through all, here through the block and the post (Sketch4 F7, Extrude4 F8)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_circle", "sketch": "F7", "center": [30, 20], "diameter": 10},
  {"cmd": "add_feature", "def": {"type": "extrude", "profiles": [{"sketch": "F7", "region": "r{c1}"}],
    "extent": {"type": "through_all"}, "operation": "cut", "participants": ["F2.b0"]}},
  {"expect": {"body": "F2.b0", "volume": 51141.59265358979, "has_face": "F8:side(c1)"}},

  {"comment": "ext_taper: 40 x 40, 10 high, -10 degrees: the sides lean in (Sketch5 F9, Extrude5 F10)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F9", "corner": [100, 0], "width": 40, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F9", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10, "taper": -0.17453292519943295}, "operation": "new_body"}},
  {"expect": {"body": "F10.b0", "volume": 14630.839093166633, "faces": 6, "min": [100, 0, 0], "max": [140, 40, 10]}},
  {"comment": "Names survive edits: round a leaning edge, then change the taper and the width."},
  {"cmd": "add_feature", "def": {"type": "fillet", "body": "F10.b0",
    "edges": ["E{F10:side(c1[c4,c2])|F10:side(c2[c1,c3])}"], "radius": 2}},
  {"expect": {"feature": "Fillet1", "status": "ok", "body": "F10.b0",
    "has_face": "F11:fillet(E{F10:side(c1[c4,c2])|F10:side(c2[c1,c3])})"}},
  {"cmd": "edit_feature", "uid": "F10", "def": {"type": "extrude",
    "profiles": [{"sketch": "F9", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10, "taper": 0.08726646259971647}, "operation": "new_body"}},
  {"expect": {"feature": "Fillet1", "status": "ok"}},
  {"cmd": "undo"},
  {"expect": {"feature": "Fillet1", "status": "ok", "body": "F10.b0"}},

  {"comment": "ext_thin_closed: a 2 mm wall centred on a 40 x 20 outline, 10 high; then outside (side 1) and inside (side 2) (Sketch6 F12, Extrude6 F13)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F12", "corner": [200, 0], "width": 40, "height": 20},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F12", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "thin": {"location": "center", "thickness": 2},
    "operation": "new_body"}},
  {"expect": {"body": "F13.b0", "volume": 2400, "faces": 10, "has_face": "F13:outer(c1[c4,c2])"}},
  {"expect": {"body": "F13.b0", "has_face": "F13:inner(c3[c2,c4])"}},
  {"cmd": "edit_feature", "uid": "F13", "def": {"type": "extrude",
    "profiles": [{"sketch": "F12", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "thin": {"location": "side1", "thickness": 2},
    "operation": "new_body"}},
  {"expect": {"body": "F13.b0", "volume": 2560, "min": [198, -2, 0], "max": [242, 22, 10]}},
  {"cmd": "edit_feature", "uid": "F13", "def": {"type": "extrude",
    "profiles": [{"sketch": "F12", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 10}, "thin": {"location": "side2", "thickness": 2},
    "operation": "new_body"}},
  {"expect": {"body": "F13.b0", "volume": 2240, "min": [200, 0, 0], "max": [240, 20, 10]}},

  {"comment": "ext_participants: blocks A and B from one extrude of two rectangles; a slot across both cut through all with only A participating (Sketch7 F14, Extrude7 F15, Sketch8 F16, Extrude8 F17)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F14", "corner": [0, 100], "width": 30, "height": 40},
  {"cmd": "sketch.add_rectangle", "sketch": "F14", "corner": [40, 100], "width": 30, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F14", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"},
                 {"sketch": "F14", "region": "r{c9[c12,c10],c10[c9,c11],c11[c10,c12],c12[c11,c9]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_body"}},
  {"expect": {"body": "F15.b0", "volume": 24000, "min": [0, 100, 0]}},
  {"expect": {"body": "F15.b1", "volume": 24000, "min": [40, 100, 0]}},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F16", "corner": [-5, 115], "width": 80, "height": 10},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F16", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "through_all"}, "operation": "cut", "participants": ["F15.b0"]}},
  {"comment": "The slot splits A in two (the second piece is a new body of the cut); B stays whole. 2 * 30 * 40 * 20 - 30 * 10 * 20 in all."},
  {"expect": {"bodies": 7, "body": "F15.b0", "volume": 9000, "max": [30, 115, 20]}},
  {"expect": {"body": "F17.b0", "volume": 9000, "min": [0, 125, 0]}},
  {"expect": {"body": "F15.b1", "volume": 24000}},

  {"comment": "ext_new_component: a new body flagged as a new component (Sketch9 F18, Extrude9 F19)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_rectangle", "sketch": "F18", "corner": [0, 200], "width": 60, "height": 40},
  {"cmd": "add_feature", "def": {"type": "extrude",
    "profiles": [{"sketch": "F18", "region": "r{c1[c4,c2],c2[c1,c3],c3[c2,c4],c4[c3,c1]}"}],
    "extent": {"type": "distance", "distance": 20}, "operation": "new_component"}},
  {"expect": {"body": "F19.b0", "volume": 48000}}
]
