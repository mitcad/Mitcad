[
  {"comment": "Sweeps, lofts, pipes, coils, ribs and webs (F3) that cannot be built fail as features: the command succeeds, the feature shows the error and the bodies pass it by. Options the geometry kernel lacks fail with 'unsupported: ', which the importer replaces with the file's body. Sketch1 (F1): three lines, two joined at (40, 0) and one apart; a fourth from (40, 0) makes a branch."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_line", "sketch": "F1", "start": [0, 0], "end": [40, 0]},
  {"cmd": "sketch.add_line", "sketch": "F1", "start": [40, 0], "end": [40, 30]},
  {"cmd": "sketch.add_line", "sketch": "F1", "start": [100, 0], "end": [120, 0]},
  {"cmd": "sketch.add_line", "sketch": "F1", "start": [40, 0], "end": [60, 0]},
  {"comment": "Sketch2 (F2) on YZ: a 10 mm circle, a 4 mm one inside it, and a 4 mm one at z = 100 (YZ sketch x is -Z)."},
  {"cmd": "sketch.create", "plane": "yz"},
  {"cmd": "sketch.add_circle", "sketch": "F2", "center": [0, 0], "diameter": 10},
  {"cmd": "sketch.add_circle", "sketch": "F2", "center": [0, 0], "diameter": 4},
  {"cmd": "sketch.add_circle", "sketch": "F2", "center": [-100, 0], "diameter": 4},

  {"comment": "A path with a gap, and one that branches (Sweep1, F3)."},
  {"cmd": "add_feature", "def": {"type": "sweep", "profiles": [{"sketch": "F2", "region": "r{c3}"}],
    "path": {"sketch": "F1", "curves": ["c1", "c7"]}, "operation": "new_body"}},
  {"expect": {"feature": "Sweep1", "status": "error", "error_contains": "path: the path's curves are not connected: c7 does not join the others", "bodies": 0}},
  {"cmd": "edit_feature", "uid": "F3", "def": {"type": "sweep", "profiles": [{"sketch": "F2", "region": "r{c3}"}],
    "path": {"sketch": "F1", "curves": ["c1", "c4", "c10"]}, "operation": "new_body"}},
  {"expect": {"feature": "Sweep1", "status": "error", "error_contains": "path: the path branches at (40.000000, 0.000000, 0.000000)"}},
  {"comment": "Fixed: two joined lines; a twist with parallel orientation is not supported."},
  {"cmd": "edit_feature", "uid": "F3", "def": {"type": "sweep", "profiles": [{"sketch": "F2", "region": "r{c3}"}],
    "path": {"sketch": "F1", "curves": ["c1"]}, "orientation": "parallel", "twist_angle": "45 deg",
    "operation": "new_body"}},
  {"expect": {"feature": "Sweep1", "status": "error", "error_contains": "unsupported: twists, tapers and guide rails with parallel orientation"}},
  {"cmd": "edit_feature", "uid": "F3", "def": {"type": "sweep", "profiles": [{"sketch": "F2", "region": "r{c3}"}],
    "path": {"sketch": "F1", "curves": ["c1"]}, "operation": "new_body"}},
  {"expect": {"feature": "Sweep1", "status": "ok", "bodies": 1}},
  {"comment": "A cut that misses every body: the circle at z = 100 swept along X, as placed against the path."},
  {"cmd": "add_feature", "def": {"type": "sweep", "profiles": [{"sketch": "F2", "region": "r{c5}"}],
    "path": {"sketch": "F1", "curves": ["c1"]}, "operation": "cut", "participants": ["F3.b0"]}},
  {"expect": {"feature": "Sweep2", "status": "error", "error_contains": "does not cut into any participant body"}},

  {"comment": "Lofts: end conditions along a centre line, rails with a point section and sections with holes are not supported; a rail must meet every section (Plane1 F5, Sketch3 F6, Loft1 F7)."},
  {"cmd": "add_feature", "def": {"type": "construction_plane", "definition": {"type": "offset", "plane": "yz", "distance": 30}}},
  {"cmd": "sketch.create", "plane": "F5"},
  {"cmd": "sketch.add_circle", "sketch": "F6", "center": [0, 0], "diameter": 20},
  {"cmd": "add_feature", "def": {"type": "loft", "sections": [
    {"type": "profile", "sketch": "F2", "region": "r{c3}"}, {"type": "profile", "sketch": "F6", "region": "r{c1}"}],
    "centerline": {"sketch": "F1", "curves": ["c1"]},
    "start_condition": {"type": "direction", "angle": 0, "weight": 1}, "operation": "new_body"}},
  {"expect": {"feature": "Loft1", "status": "error", "error_contains": "unsupported: end conditions of a loft along a centre line"}},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "loft", "sections": [
    {"type": "profile", "sketch": "F2", "region": "r{c3}"}, {"type": "point", "point": {"point": [30, 0, 0]}}],
    "rails": [{"start": [0, 2, 0], "end": [30, 0, 0]}], "operation": "new_body"}},
  {"expect": {"feature": "Loft1", "status": "error", "error_contains": "unsupported: loft rails with a point section"}},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "loft", "sections": [
    {"type": "profile", "sketch": "F2", "region": "r{c3}"}, {"type": "profile", "sketch": "F6", "region": "r{c1}"}],
    "rails": [{"sketch": "F1", "curves": ["c1"]}], "operation": "new_body"}},
  {"expect": {"feature": "Loft1", "status": "error", "error_contains": "rail 1 does not meet section 1"}},
  {"comment": "The 10 mm circle round the 4 mm one is a ring with a hole."},
  {"cmd": "edit_feature", "uid": "F7", "def": {"type": "loft", "sections": [
    {"type": "profile", "sketch": "F2", "region": "r{c1}"}, {"type": "profile", "sketch": "F6", "region": "r{c1}"}],
    "operation": "new_body"}},
  {"expect": {"feature": "Loft1", "status": "error", "error_contains": "section 1: unsupported: a loft section with holes"}},

  {"comment": "Coils whose turns overlap or whose section reaches the axis (Coil1, F8)."},
  {"cmd": "add_feature", "def": {"type": "coil", "plane": "xy", "center": [0, 100], "diameter": 40,
    "helix": {"type": "revolutions_and_pitch", "revolutions": 3, "pitch": 3}, "section_size": 4,
    "operation": "new_body"}},
  {"expect": {"feature": "Coil1", "status": "error", "error_contains": "the coil's pitch is smaller than its section"}},
  {"cmd": "edit_feature", "uid": "F8", "def": {"type": "coil", "plane": "xy", "center": [0, 100], "diameter": 3,
    "helix": {"type": "revolutions_and_pitch", "revolutions": 3, "pitch": 10}, "section_size": 4,
    "operation": "new_body"}},
  {"expect": {"feature": "Coil1", "status": "error", "error_contains": "the coil's section reaches its axis"}},

  {"comment": "A rib that grows away from every body, and a web along a quarter of an ellipse (Sketch4 F9, Rib1 F10, Web1 F11)."},
  {"cmd": "sketch.create"},
  {"cmd": "sketch.add_line", "sketch": "F9", "start": [0, 50], "end": [20, 50]},
  {"cmd": "sketch.ellipse", "sketch": "F9", "center": [50, 50], "major": [60, 50], "minor_radius": 5, "start": [60, 50], "end": [50, 55]},
  {"cmd": "add_feature", "def": {"type": "rib", "curves": {"sketch": "F9", "curves": ["c1"]}, "thickness": 2,
    "extent": {"type": "to_next"}}},
  {"expect": {"feature": "Rib1", "status": "error", "error_contains": "does not end at faces of the bodies"}},
  {"cmd": "add_feature", "def": {"type": "web", "curves": {"sketch": "F9", "curves": ["c4"]}, "thickness": 2,
    "extent": {"type": "depth", "depth": 5}}},
  {"expect": {"feature": "Web1", "status": "error", "error_contains": "unsupported: web curves other than lines and arcs (c4)"}},
  {"expect": {"bodies": 1}}
]
