{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mitcad",
  "version": "0.2.1",
  "description": "Open source parametric desktop CAD",
  "license": "MIT",
  "builtin-baseline": "3aea538b2bb21a586502c67b00eb474fdd2e3098",
  "vcpkg-configuration": {
    "overlay-ports": ["./third_party/vcpkg-ports"]
  },
  "dependencies": [
    "opencascade"
  ],
  "overrides": [
    { "name": "opencascade", "version": "8.0.1" }
  ],
  "features": {
    "render": {
      "description": "The Cycles render worker's libraries (MITCAD_RENDER, tools/dev-env/build-cycles.sh)",
      "dependencies": [
        { "name": "embree", "features": ["ray-mask"] },
        "tbb",
        { "name": "openimageio", "default-features": false },
        "opencolorio",
        "openexr",
        "pugixml",
        "zstd",
        "zlib",
        "cgltf",
        { "name": "sse2neon", "platform": "osx & arm64" }
      ]
    }
  }
}
