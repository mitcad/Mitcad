{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mitcad",
  "version": "0.38.0",
  "description": "Open source parametric desktop CAD",
  "license": "MIT",
  "builtin-baseline": "3aea538b2bb21a586502c67b00eb474fdd2e3098",
  "vcpkg-configuration": {
    "overlay-ports": ["./third_party/vcpkg-ports"]
  },
  "dependencies": [
    "opencascade",
    { "name": "embree", "features": ["ray-mask"] },
    "tbb",
    { "name": "openimageio", "default-features": false },
    "opencolorio",
    "openexr",
    "pugixml",
    "zstd",
    "zlib",
    "cgltf",
    { "name": "sse2neon", "platform": "osx & arm64" }
  ],
  "default-features": ["heif"],
  "features": {
    "heif": {
      "description": "HEIF/HEIC image references (MITCAD_HEIF): libheif with the libde265 HEVC decoder only; its default feature hevc (the x265 encoder, GPL) stays off",
      "dependencies": [
        { "name": "libheif", "default-features": false }
      ]
    }
  },
  "overrides": [
    { "name": "opencascade", "version": "8.0.1" }
  ]
}
