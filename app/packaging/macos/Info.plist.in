<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!--
  Info.plist of the macOS bundle. app/packaging/macos/Bundle.cmake fills the
  placeholders between at signs (configure_file with @ONLY) and gives the
  result to the target as MACOSX_BUNDLE_INFO_PLIST.

  File types: .mitcad is MitCad's own project format, a single JSON text file
  (core/model/src/file), so its UTI conforms to public.json. Every format
  that app/files/FileFormats.cpp can import is offered as a Viewer with
  Alternate rank: MitCad shows up in "Open With" but never takes over the
  files of other programs. CAD types without a system UTI are declared as
  imported types, which an exporting program's own declaration overrides.
  Format-specific identifiers under the bundle id are fallbacks; document
  types also list the extensions so other programs' type ids still match.
  STL, OBJ and SVG have
  system types (public.standard-tesselated-geometry-format and
  public.geometry-definition-format; yes, with that spelling; public.svg-image).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
