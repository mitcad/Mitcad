# The OCCT build stamp (mitcad#1454, app/update/BuildStamp.hpp): mitcad.exe
# and mitcad-cli.exe know, from their build, the link time stamp and the
# image size (PE header) of every OCCT DLL they were built with, and at
# start-up compare them with the DLLs they loaded
# (app/update/InstallationCheck.cpp). An update that could not replace
# files in use once left a new mitcad.exe with the previous release's OCCT.
#
# Included from the top-level CMakeLists.txt after find_package(OpenCASCADE):
#   mitcad_occt_build_stamp(<target>)
# gives a target the check's generated header (Windows; elsewhere nothing
# to do). The header is written at build time, after the DLLs, by this
# file as a script:
#   cmake -DLIST=<file of DLL paths> -DOUT=<header> -P cmake/OcctBuildStamp.cmake

# The four bytes at `offset` of `file` as a little-endian number "0x...", or
# "" when the file is shorter.
function(mitcad_stamp_u32 file offset out)
  file(READ "${file}" hex OFFSET ${offset} LIMIT 4 HEX)
  string(LENGTH "${hex}" length)
  if(NOT length EQUAL 8)
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${hex}" 0 2 b0)
  string(SUBSTRING "${hex}" 2 2 b1)
  string(SUBSTRING "${hex}" 4 2 b2)
  string(SUBSTRING "${hex}" 6 2 b3)
  set(${out} "0x${b3}${b2}${b1}${b0}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
  # One line per DLL: {"TKernel.dll", <TimeDateStamp>u, <SizeOfImage>u},
  # read where the PE format has them (the DOS header's e_lfanew at 60;
  # from the "PE\0\0" signature, the file header's TimeDateStamp at 8 and
  # the optional header's SizeOfImage at 24 + 56, the same in PE32 and
  # PE32+).
  file(STRINGS "${LIST}" dlls)
  list(REMOVE_DUPLICATES dlls)
  set(text "// Generated by cmake/OcctBuildStamp.cmake (mitcad#1454): the OCCT DLLs of this build.\n")
  foreach(dll IN LISTS dlls)
    if(NOT dll MATCHES "\\.[Dd][Ll][Ll]$" OR NOT EXISTS "${dll}")
      continue()
    endif()
    mitcad_stamp_u32("${dll}" 60 lfanew)
    if(lfanew STREQUAL "")
      continue()
    endif()
    math(EXPR pe "${lfanew}")
    file(READ "${dll}" signature OFFSET ${pe} LIMIT 4 HEX)
    if(NOT signature STREQUAL "50450000")
      message(WARNING "OcctBuildStamp: ${dll} is not a PE file; left out of the check")
      continue()
    endif()
    math(EXPR at "${pe} + 8")
    mitcad_stamp_u32("${dll}" ${at} stamp)
    math(EXPR at "${pe} + 80")
    mitcad_stamp_u32("${dll}" ${at} size)
    if(stamp STREQUAL "" OR size STREQUAL "")
      continue()
    endif()
    get_filename_component(name "${dll}" NAME)
    string(APPEND text "    {\"${name}\", ${stamp}u, ${size}u},\n")
  endforeach()
  set(old "")
  if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
  endif()
  # Unchanged stamps leave the header alone: nothing is compiled again.
  if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
  endif()
  return()
endif()

set(MITCAD_OCCT_STAMP_DIR "${CMAKE_BINARY_DIR}/generated/occt-stamp")
set(mitcad_occt_stamp_script "${CMAKE_CURRENT_LIST_FILE}")

function(mitcad_occt_build_stamp target)
  if(TARGET mitcad_occt_stamp)
    add_dependencies(${target} mitcad_occt_stamp)
    target_include_directories(${target} PRIVATE "${MITCAD_OCCT_STAMP_DIR}")
  endif()
endfunction()

if(WIN32)
  # The DLLs of OCCT's toolkits, as this configuration links them.
  set(mitcad_occt_dlls "")
  foreach(toolkit IN LISTS OpenCASCADE_LIBRARIES)
    if(TARGET ${toolkit})
      get_target_property(mitcad_toolkit_type ${toolkit} TYPE)
      if(mitcad_toolkit_type STREQUAL "SHARED_LIBRARY")
        list(APPEND mitcad_occt_dlls "$<TARGET_FILE:${toolkit}>")
      endif()
    endif()
  endforeach()
  set(mitcad_occt_stamp_list "${MITCAD_OCCT_STAMP_DIR}/dlls-$<CONFIG>.txt")
  set(mitcad_occt_stamp_header "${MITCAD_OCCT_STAMP_DIR}/OcctBuildStamp.inc")
  file(GENERATE OUTPUT "${mitcad_occt_stamp_list}" CONTENT "$<JOIN:${mitcad_occt_dlls},\n>\n")
  add_custom_command(OUTPUT "${mitcad_occt_stamp_header}"
    COMMAND "${CMAKE_COMMAND}" "-DLIST=${mitcad_occt_stamp_list}" "-DOUT=${mitcad_occt_stamp_header}"
            -P "${mitcad_occt_stamp_script}"
    DEPENDS ${mitcad_occt_dlls} "${mitcad_occt_stamp_list}" "${mitcad_occt_stamp_script}"
    COMMENT "Recording the OCCT DLLs' build stamp"
    VERBATIM)
  add_custom_target(mitcad_occt_stamp DEPENDS "${mitcad_occt_stamp_header}")
endif()
